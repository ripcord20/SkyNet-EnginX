<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %> - <%= appName %></title>
  <link rel="stylesheet" href="/css/mobile-shell.css?v=7">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    :root{--bg:#fff;--card:#fff;--ink:#1F3849;--muted:#7c93a0;--line:#e2eefb;--blue:#0ea5e9;--teal:#38bdf8;--green:#38bdf8;--amber:#f5a623;--red:#f2545b;--nav-h:70px;}
    body{font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',Roboto,sans-serif;background:#fff;color:var(--ink);padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 8px);-webkit-font-smoothing:antialiased;}
    .wrap{max-width:520px;margin:0 auto;}
    .head{padding:6px 20px 14px 20px;display:flex;align-items:center;justify-content:space-between;}
    .head .htitle{font-size:20px;font-weight:800;letter-spacing:-.3px;}
    .head .hsub{font-size:12.5px;color:#6b7a97;margin-top:2px;font-weight:500;}
    .refresh{width:42px;height:42px;border-radius:14px;background:#fff;border:1px solid #eef1f6;display:flex;align-items:center;justify-content:center;color:var(--blue);cursor:pointer;}
    .refresh svg{width:19px;height:19px;} .refresh.spin svg{animation:spin 1s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg);}}
    .content{padding:4px 16px 20px;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
    .anim{opacity:0;animation:fadeUp .45s cubic-bezier(.22,.61,.36,1) forwards;}
    .kpi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px;}
    .kpi{background:#fff;border:1px solid #eef1f6;border-radius:15px;padding:13px 10px;text-align:center;}
    .kpi-val{font-size:20px;font-weight:800;letter-spacing:-.5px;}
    .kpi-lbl{font-size:10.5px;color:var(--muted);margin-top:3px;font-weight:600;}
    /* Map mode toggle (Peta / Satelit) */
    .map-mode{position:absolute;top:12px;right:12px;z-index:2;display:flex;gap:0;background:rgba(255,255,255,.95);border-radius:10px;padding:3px;box-shadow:0 4px 14px -6px rgba(30,60,120,.35);}
    .mm-btn{border:none;background:none;font-family:inherit;font-size:11.5px;font-weight:700;color:#6b7a97;padding:6px 12px;border-radius:8px;cursor:pointer;transition:all .15s;}
    .mm-btn.sel{background:var(--blue);color:#fff;}
    /* Breakdown per tipe */
    .brk-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-bottom:16px;}
    .brk{background:#fff;border:1px solid #eef1f6;border-radius:13px;padding:11px 4px;text-align:center;cursor:pointer;transition:all .14s;}
    .brk:active{transform:scale(.95);}
    .brk.sel{border-color:var(--blue);box-shadow:0 5px 14px -8px rgba(14,165,233,.5);}
    .brk-dot{width:9px;height:9px;border-radius:50%;margin:0 auto 6px;}
    .brk-val{font-size:16px;font-weight:800;letter-spacing:-.4px;line-height:1;font-variant-numeric:tabular-nums;}
    .brk-lbl{font-size:9.5px;color:var(--muted);margin-top:3px;font-weight:700;}
    /* Peta */
    .map-wrap{position:relative;margin-bottom:14px;}
    #infMap{width:100%;height:380px;border-radius:18px;border:1px solid #eef1f6;overflow:hidden;z-index:1;}
    .map-legend{position:absolute;left:12px;bottom:12px;z-index:2;background:rgba(255,255,255,.95);border-radius:11px;padding:9px 11px;box-shadow:0 4px 14px -6px rgba(30,60,120,.3);display:flex;flex-direction:column;gap:5px;}
    .lg-item{display:flex;align-items:center;gap:7px;font-size:10.5px;font-weight:600;color:#3a4a68;}
    .lg-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
    .map-legend.on-sat{background:rgba(20,30,48,.82);}
    .map-legend.on-sat .lg-item{color:#eef2f8;}
    .leaflet-popup-content-wrapper{border-radius:12px;}
    .leaflet-popup-content{margin:11px 13px;font-family:inherit;}
    .mp-title{font-size:13px;font-weight:800;color:#1F3849;margin-bottom:3px;}
    .mp-meta{font-size:11px;color:#7c93a0;}
    .mp-badge{display:inline-block;margin-top:6px;font-size:9.5px;font-weight:800;padding:3px 9px;border-radius:100px;}
    .chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px;}
    .chips::-webkit-scrollbar{display:none;}
    .chip{flex-shrink:0;padding:8px 15px;border:1px solid #eef1f6;background:#fff;border-radius:100px;font-size:12.5px;font-weight:700;color:#5a6885;cursor:pointer;transition:all .12s;}
    .chip.sel{background:var(--blue);color:#fff;border-color:var(--blue);}
    .search-wrap{position:relative;margin-bottom:14px;}
    .search-wrap svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--muted);}
    .search-wrap input{width:100%;padding:13px 14px 13px 42px;border:1px solid #eef1f6;background:#fff;border-radius:15px;font-size:14px;font-family:inherit;outline:none;}
    .count-bar{font-size:12px;color:var(--muted);font-weight:600;margin:0 2px 10px;}
    .list{display:flex;flex-direction:column;gap:10px;}
    .ip{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid #eef1f6;border-radius:15px;padding:13px 15px;}
    .ip-ic{width:44px;height:44px;border-radius:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:800;font-size:11px;}
    .ip-ic svg{width:20px;height:20px;stroke-width:1.8;}
    .t-odp{background:#e0f2fe;color:#0ea5e9;} .t-odc{background:#e0f2fe;color:#0369a1;} .t-pop{background:#ede9ff;color:#6b4fd8;} .t-tower{background:#fef1db;color:#c67d0a;} .t-ont{background:#dcf7ec;color:#0f9d63;} .t-customer{background:#f0f3f9;color:#6b7a97;}
    .ip-body{flex:1;min-width:0;}
    .ip-name{font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .ip-meta{font-size:11.5px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .ip-badge{font-size:9.5px;font-weight:800;padding:4px 9px;border-radius:100px;flex-shrink:0;text-transform:uppercase;}
    .st-active{background:#dcf7ec;color:#0f9d63;} .st-inactive{background:#fde5e6;color:#d13b42;} .st-maintenance{background:#fef1db;color:#c67d0a;}
    .empty{padding:44px 16px;text-align:center;color:var(--muted);font-size:13px;}
    .empty svg{width:44px;height:44px;color:#c7d0e0;margin-bottom:12px;}
    .skel{background:linear-gradient(90deg,#eef1f6 25%,#f6f8fb 50%,#eef1f6 75%);background-size:200% 100%;animation:sh 1.3s infinite;border-radius:8px;}
    @keyframes sh{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
    .bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:300;background:#fff;border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);display:flex;}
    .bn-wrap{max-width:520px;margin:0 auto;width:100%;display:flex;height:var(--nav-h);}
    .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-decoration:none;color:var(--muted);font-size:10px;font-weight:600;}
    .bn-item svg{width:22px;height:22px;stroke-width:2;} .bn-item.active{color:var(--cyan,#0ea5e9);}
    .bn-fab{flex:0 0 auto;width:66px;display:flex;align-items:flex-start;justify-content:center;position:relative;}
    .bn-fab a,.bn-fab button{position:absolute;font-family:inherit;padding:0;cursor:pointer;top:-22px;width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;box-shadow:0 12px 26px -6px rgba(14,165,233,.6);border:4px solid #fff;transition:transform .14s;}
    .bn-fab a:active,.bn-fab button:active{transform:scale(.92);}
    .bn-fab svg{width:26px;height:26px;stroke-width:2.6;}
  </style>
</head>
<body>
  <%- include('../../partials/mobile-drawer', { active: active, appName: (typeof appName!=='undefined'?appName:'FLAYNET'), user: user }) %>
  <div class="wrap">
    <div class="head">
      <div><div class="htitle">Infrastruktur</div><div class="hsub" id="infSub">Titik jaringan</div></div>
      <div class="refresh" id="refreshBtn" onclick="loadInfra(true)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg></div>
    </div>
    <div class="content">
      <div class="kpi-grid anim" id="infStats">
        <div class="kpi"><div class="kpi-val" id="stTotal">–</div><div class="kpi-lbl">Total Titik</div></div>
        <div class="kpi"><div class="kpi-val" id="stActive" style="color:var(--green);">–</div><div class="kpi-lbl">Aktif</div></div>
        <div class="kpi"><div class="kpi-val" id="stIssue" style="color:var(--amber);">–</div><div class="kpi-lbl">Perlu Cek</div></div>
      </div>

      <!-- Peta -->
      <div id="mapWrap" class="map-wrap anim">
        <div id="infMap"></div>
        <div class="map-mode" id="mapMode">
          <button class="mm-btn sel" data-m="street" onclick="setMapMode('street')">Peta</button>
          <button class="mm-btn" data-m="satellite" onclick="setMapMode('satellite')">Satelit</button>
        </div>
        <div class="map-legend" id="mapLegend"></div>
      </div>

      <!-- Breakdown per tipe (selalu tampil, mengisi ruang) -->
      <div class="brk-grid anim" id="brkGrid"></div>

      <!-- Filter + daftar (selalu tampil di bawah peta) -->
      <div class="chips anim" id="typeChips">
        <div class="chip sel" data-t="">Semua</div>
        <div class="chip" data-t="pop">POP</div>
        <div class="chip" data-t="odc">ODC</div>
        <div class="chip" data-t="odp">ODP</div>
        <div class="chip" data-t="tower">Tower</div>
        <div class="chip" data-t="ont">ONT</div>
      </div>
      <div class="search-wrap anim">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="infSearch" placeholder="Cari nama titik…">
      </div>
      <div class="count-bar anim" id="countBar">–</div>
      <div class="list anim" id="infList">
        <div class="ip"><div class="skel" style="width:44px;height:44px;border-radius:13px;"></div><div class="ip-body"><div class="skel" style="width:140px;height:13px;"></div><div class="skel" style="width:100px;height:10px;margin-top:6px;"></div></div></div>
        <div class="ip"><div class="skel" style="width:44px;height:44px;border-radius:13px;"></div><div class="ip-body"><div class="skel" style="width:140px;height:13px;"></div><div class="skel" style="width:100px;height:10px;margin-top:6px;"></div></div></div>
      </div>
    </div>
  </div>
    <nav class="bottomnav">
    <div class="bn-wrap">
      <a class="bn-item" href="/mobile"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span><span>Beranda</span></a>
      <a class="bn-item" href="/mobile/customers"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span><span>Pelanggan</span></a>
      <div class="bn-fab"><button type="button" onclick="FabSheet.open()" aria-label="Tambah cepat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button></div>
      <a class="bn-item" href="/mobile/finance"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg></span><span>Laporan</span></a>
      <a class="bn-item" href="/mobile/monitoring"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></span><span>Monitor</span></a>
    </div>
  </nav>
  <script>
    function getToken(){ const ls=localStorage.getItem('token'); if(ls)return ls; const m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    async function api(url){ const t=getToken(); const headers=Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}); try{ const r=await fetch(url,{credentials:'include',headers}); if(r.status===401){location.href='/login';return null;} const x=await r.text(); try{return x?JSON.parse(x):null;}catch(_){return null;} }catch(e){return null;} }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    let _type='', _all=[];
    const TYPE_LABEL={odp:'ODP',odc:'ODC',pop:'POP',tower:'Tower',ont:'ONT',customer:'Pelanggan'};
    const TYPE_COLOR={odc:'#1d4ed8',odp:'#104396',pop:'#ef4444',tower:'#475569',ont:'#f97316',customer:'#f97316'};
    let _map=null, _markers=null, _mapReady=false, _tileStreet=null, _tileSat=null, _mapMode='street';

    function initMap(){
      if(_mapReady||typeof L==='undefined')return;
      _map=L.map('infMap',{zoomControl:true,attributionControl:false}).setView([-6.4,106.8],12);
      _tileStreet=L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19});
      // Satelit: pakai Google (domain mt0-3.google.com sudah diizinkan CSP).
      _tileSat=L.tileLayer('https://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}',{maxZoom:20,subdomains:['mt0','mt1','mt2','mt3']});
      _tileStreet.addTo(_map);
      _markers=L.layerGroup().addTo(_map);
      _mapReady=true;
      // legend
      const types=['pop','odc','odp','tower','ont'];
      document.getElementById('mapLegend').innerHTML=types.map(t=>'<div class="lg-item"><span class="lg-dot" style="background:'+TYPE_COLOR[t]+';"></span>'+TYPE_LABEL[t]+'</div>').join('');
    }
    function setMapMode(mode){
      _mapMode=mode;
      document.querySelectorAll('.mm-btn').forEach(b=>b.classList.toggle('sel',b.dataset.m===mode));
      if(!_mapReady)return;
      if(mode==='satellite'){ if(_map.hasLayer(_tileStreet))_map.removeLayer(_tileStreet); _tileSat.addTo(_map); document.getElementById('mapLegend').classList.add('on-sat'); }
      else { if(_map.hasLayer(_tileSat))_map.removeLayer(_tileSat); _tileStreet.addTo(_map); document.getElementById('mapLegend').classList.remove('on-sat'); }
    }
    function renderMap(){
      if(!_mapReady)return;
      _markers.clearLayers();
      const pts=_all.filter(p=>p.latitude&&p.longitude&&(!_type||(p.type||'').toLowerCase()===_type));
      const bounds=[];
      pts.forEach(function(p){
        const t=(p.type||'').toLowerCase(); const color=TYPE_COLOR[t]||'#64748b';
        const lat=parseFloat(p.latitude), lng=parseFloat(p.longitude);
        if(isNaN(lat)||isNaN(lng))return;
        const st=(p.status||'active').toLowerCase();
        const stCls=st==='active'?'st-active':st==='maintenance'?'st-maintenance':'st-inactive';
        const stLbl=st==='active'?'Aktif':st==='maintenance'?'Maintenance':'Nonaktif';
        const m=L.circleMarker([lat,lng],{radius:8,fillColor:color,color:'#fff',weight:2,fillOpacity:.95});
        m.bindPopup('<div class="mp-title">'+esc(p.name||'Titik')+'</div><div class="mp-meta">'+(TYPE_LABEL[t]||t.toUpperCase())+'</div><span class="mp-badge '+stCls+'">'+stLbl+'</span>');
        m.addTo(_markers); bounds.push([lat,lng]);
      });
      if(bounds.length){ try{ _map.fitBounds(bounds,{padding:[30,30],maxZoom:15}); }catch(e){} }
    }
    function typeIcon(t){
      if(t==='tower')return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21l7-16 7 16M8 13h8"/></svg>';
      if(t==='pop')return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/></svg>';
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M12 22v-6M4.93 10.93l1.41 1.41M2 18h2M20 18h2"/><circle cx="12" cy="12" r="3"/></svg>';
    }
    function ipCard(p){
      const t=(p.type||'').toLowerCase(); const st=(p.status||'active').toLowerCase();
      const meta=[p.address, (p.customer_count!=null?(p.customer_count+' pelanggan'):'')].filter(Boolean).join(' · ');
      const stCls=st==='active'?'st-active':st==='maintenance'?'st-maintenance':'st-inactive';
      const stLbl=st==='active'?'Aktif':st==='maintenance'?'Maintenance':'Nonaktif';
      return '<div class="ip"><div class="ip-ic t-'+esc(t)+'">'+typeIcon(t)+'</div>'+
        '<div class="ip-body"><div class="ip-name">'+esc(p.name||'Titik')+'</div><div class="ip-meta">'+(TYPE_LABEL[t]||t.toUpperCase())+(meta?(' · '+esc(meta)):'')+'</div></div>'+
        '<span class="ip-badge '+stCls+'">'+stLbl+'</span></div>';
    }
    function render(){
      let rows=_all;
      if(_type) rows=rows.filter(p=>(p.type||'').toLowerCase()===_type);
      const sv=document.getElementById('infSearch').value.trim().toLowerCase();
      if(sv) rows=rows.filter(p=>(p.name||'').toLowerCase().includes(sv));
      document.getElementById('countBar').textContent=rows.length+' titik';
      const list=document.getElementById('infList');
      if(rows.length){ list.innerHTML=rows.map(ipCard).join(''); }
      else{ list.innerHTML='<div class="empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M12 22v-6"/><circle cx="12" cy="12" r="3"/></svg><div>Tidak ada titik infrastruktur</div></div>'; }
    }
    // Breakdown jumlah per tipe (klik = filter, sinkron dengan chip)
    function renderBreakdown(){
      const types=['pop','odc','odp','tower','ont'];
      const counts={}; _all.forEach(function(p){ const t=(p.type||'').toLowerCase(); counts[t]=(counts[t]||0)+1; });
      document.getElementById('brkGrid').innerHTML=types.map(function(t){
        const sel=(_type===t)?' sel':'';
        return '<div class="brk'+sel+'" data-t="'+t+'" onclick="pickType(\''+t+'\')">'+
          '<div class="brk-dot" style="background:'+TYPE_COLOR[t]+';"></div>'+
          '<div class="brk-val">'+(counts[t]||0)+'</div>'+
          '<div class="brk-lbl">'+TYPE_LABEL[t]+'</div></div>';
      }).join('');
    }
    // Pilih tipe dari breakdown atau chip → sinkronkan keduanya + peta + daftar
    function pickType(t){
      _type=(_type===t)?'':t; // klik ulang = reset
      syncTypeUI();
      render(); renderMap();
    }
    function syncTypeUI(){
      document.querySelectorAll('#typeChips .chip').forEach(c=>c.classList.toggle('sel',(c.dataset.t||'')===_type));
      document.querySelectorAll('#brkGrid .brk').forEach(b=>b.classList.toggle('sel',(b.dataset.t||'')===_type));
    }
    async function loadInfra(manual){
      const btn=document.getElementById('refreshBtn'); if(manual)btn.classList.add('spin');
      initMap();
      const [pj,sj]=await Promise.all([api('/api/infrastructure/map'), api('/api/infrastructure/stats')]);
      _all=(pj&&pj.success)?(Array.isArray(pj.data)?pj.data:(pj.data&&pj.data.rows?pj.data.rows:[])):[];
      document.getElementById('infSub').textContent=_all.length+' titik jaringan';
      if(sj&&sj.success){
        const total=sj.total!=null?sj.total:_all.length;
        const active=(sj.byStatus&&sj.byStatus.active!=null)?sj.byStatus.active:_all.filter(p=>(p.status||'active')==='active').length;
        const issue=total-active;
        document.getElementById('stTotal').textContent=total;
        document.getElementById('stActive').textContent=active;
        document.getElementById('stIssue').textContent=issue<0?0:issue;
      } else {
        document.getElementById('stTotal').textContent=_all.length;
        const active=_all.filter(p=>(p.status||'active')==='active').length;
        document.getElementById('stActive').textContent=active;
        document.getElementById('stIssue').textContent=_all.length-active;
      }
      render(); renderMap(); renderBreakdown();
      if(manual)setTimeout(()=>btn.classList.remove('spin'),600);
    }
    document.getElementById('typeChips').addEventListener('click',function(e){ const c=e.target.closest('.chip'); if(!c)return; _type=c.dataset.t||''; syncTypeUI(); render(); renderMap(); });
    let _t=null; document.getElementById('infSearch').addEventListener('input',function(){ clearTimeout(_t); _t=setTimeout(render,200); });
    loadInfra();
  </script>
</body>
</html>
