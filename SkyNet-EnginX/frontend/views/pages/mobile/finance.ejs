  <script>
    function getToken(){ const ls=localStorage.getItem('token'); if(ls)return ls; const m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    async function api(url){ const t=getToken(); const headers=Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}); try{ const r=await fetch(url,{credentials:'include',headers}); if(r.status===401){location.href='/login';return null;} const x=await r.text(); try{return x?JSON.parse(x):null;}catch(_){return null;} }catch(e){return null;} }
    function fmtRpShort(n){ n=Number(n)||0; const neg=n<0; n=Math.abs(n); let s; if(n>=1000000)s='Rp '+(n/1000000).toFixed(1).replace('.0','')+'jt'; else if(n>=1000)s='Rp '+Math.round(n/1000)+'rb'; else s='Rp '+n.toLocaleString('id-ID'); return (neg?'-':'')+s; }
    const MONTHS=['','Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];

    // Chart dua garis: pemasukan (putih tebal + area) vs pengeluaran (merah muda).
    function drawSeries(income, expense){
      const svg=document.getElementById('revChart');
      const n=income.length;
      if(!n||n<2){ svg.innerHTML='<text x="160" y="60" text-anchor="middle" fill="rgba(255,255,255,.6)" font-size="11">Belum ada data</text>'; return; }
      const W=320,H=120,pad=6;
      const all=income.concat(expense);
      const max=Math.max.apply(null,all)||1, min=Math.min(0,Math.min.apply(null,all));
      const range=(max-min)||1;
      const xs=i=>pad+(i*(W-2*pad)/(n-1));
      const ys=v=>H-pad-((v-min)/range)*(H-2*pad-14);
      function path(arr){
        let d='M '+xs(0)+' '+ys(arr[0]);
        for(let i=1;i<n;i++){ const x0=xs(i-1),y0=ys(arr[i-1]),x1=xs(i),y1=ys(arr[i]); const cx=(x0+x1)/2; d+=' C '+cx+' '+y0+' '+cx+' '+y1+' '+x1+' '+y1; }
        return d;
      }
      const dIn=path(income), dEx=path(expense);
      const areaIn=dIn+' L '+xs(n-1)+' '+H+' L '+xs(0)+' '+H+' Z';
      svg.innerHTML=
        '<defs><linearGradient id="ag" x1="0" y1="0" x2="0" y2="1">'+
        '<stop offset="0%" stop-color="#ffffff" stop-opacity=".28"/>'+
        '<stop offset="100%" stop-color="#ffffff" stop-opacity="0"/></linearGradient></defs>'+
        '<path d="'+areaIn+'" fill="url(#ag)"/>'+
        '<path d="'+dEx+'" fill="none" stroke="#ff9ba0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1 0" opacity=".9"/>'+
        '<path d="'+dIn+'" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>'+
        '<circle cx="'+xs(n-1)+'" cy="'+ys(income[n-1])+'" r="4.5" fill="#ffffff" stroke="rgba(255,255,255,.4)" stroke-width="3"/>';
    }

    // ── Period state ──
    var _period='this_month';   // this_month | last_month | month | year
    var _pMonth=(new Date()).getMonth()+1;
    var _pYear=(new Date()).getFullYear();
    const MONTHS_FULL=['','Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

    function setupPickers(){
      const now=new Date(), curY=now.getFullYear();
      let mH=''; for(let m=1;m<=12;m++) mH+='<option value="'+m+'"'+(m===_pMonth?' selected':'')+'>'+MONTHS_FULL[m]+'</option>';
      let yH=''; for(let y=curY;y>=curY-4;y--) yH+='<option value="'+y+'"'+(y===_pYear?' selected':'')+'>'+y+'</option>';
      document.getElementById('pMonth').innerHTML=mH;
      document.getElementById('pYear').innerHTML=yH;
    }
    function setPeriod(p){
      _period=p;
      document.querySelectorAll('#periodSeg button').forEach(b=>b.classList.toggle('on',b.dataset.p===p));
      // 'month' & 'year' butuh pilih bulan/tahun; 'this_month'/'last_month' otomatis.
      const pick=document.getElementById('periodPick');
      const mSel=document.getElementById('pMonth');
      if(p==='month'){ pick.style.display='grid'; mSel.style.display=''; }
      else if(p==='year'){ pick.style.display='grid'; mSel.style.display='none'; }
      else { pick.style.display='none'; }
      // set bulan/tahun default utk this/last month
      const now=new Date();
      if(p==='this_month'){ _pMonth=now.getMonth()+1; _pYear=now.getFullYear(); }
      else if(p==='last_month'){ const d=new Date(now.getFullYear(),now.getMonth()-1,1); _pMonth=d.getMonth()+1; _pYear=d.getFullYear(); }
      setupPickers();
      loadFinance();
    }
    function onPickChange(){
      _pMonth=parseInt(document.getElementById('pMonth').value)||_pMonth;
      _pYear=parseInt(document.getElementById('pYear').value)||_pYear;
      loadFinance();
    }
    // Params periode utk endpoint yg mendukung month/year/period.
    function periodQS(){
      if(_period==='year') return '?period=year&year='+_pYear;
      return '?month='+_pMonth+'&year='+_pYear;
    }
    function periodLabel(){
      if(_period==='year') return 'Tahun '+_pYear;
      return MONTHS_FULL[_pMonth]+' '+_pYear;
    }

    function renderBreak(elId, totId, rows, keyName, palette){
      const box=document.getElementById(elId);
      const tot=rows.reduce((s,r)=>s+(r.amount||0),0);
      document.getElementById(totId).textContent=fmtRpShort(tot);
      if(!rows.length){ box.innerHTML='<div class="bd-empty">Belum ada data pada periode ini</div>'; return; }
      const max=Math.max.apply(null,rows.map(r=>r.amount))||1;
      box.innerHTML=rows.map(function(r,i){
        const name=(r[keyName]||'lainnya');
        const c=palette[i%palette.length];
        const w=Math.round((r.amount/max)*100);
        const initial=String(name).charAt(0).toUpperCase();
        return '<div class="bd-row">'
          +'<div class="bd-ic" style="background:'+c+'22;color:'+c+';">'+initial+'</div>'
          +'<div class="bd-info"><div class="bd-name">'+name+'</div>'
          +(r.cnt!=null?'<div class="bd-sub">'+r.cnt+' transaksi</div>':'')
          +'<div class="bd-mini"><i style="width:'+w+'%;background:'+c+';"></i></div></div>'
          +'<div class="bd-amt">'+fmtRpShort(r.amount)+'</div>'
          +'</div>';
      }).join('');
    }

    // Donut pengeluaran per kategori (SVG arcs).
    function drawCatDonut(cats){
      const card=document.getElementById('catCard');
      const svg=document.getElementById('catDonut');
      const legend=document.getElementById('catLegend');
      const total=cats.reduce((s,c)=>s+(c.amount||0),0);
      if(!cats.length||total<=0){ card.style.display='none'; return; }
      card.style.display='block';
      document.getElementById('catTot').textContent=fmtRpShort(total);
      const palette=['#f27272','#f0a63c','#e59866','#c05fb0','#38bdf8','#8296a0'];
      const top=cats.slice(0,5);
      const rest=cats.slice(5);
      if(rest.length){ top.push({name:'Lainnya',amount:rest.reduce((s,c)=>s+c.amount,0)}); }
      const R=48,C=60,circ=2*Math.PI*R;
      let off=0, arcs='';
      top.forEach(function(c,i){
        const frac=c.amount/total;
        const len=frac*circ;
        const col=palette[i%palette.length];
        arcs+='<circle cx="'+C+'" cy="'+C+'" r="'+R+'" fill="none" stroke="'+col+'" stroke-width="16" stroke-dasharray="'+len+' '+(circ-len)+'" stroke-dashoffset="'+(-off)+'"/>';
        off+=len;
      });
      svg.innerHTML=arcs;
      legend.innerHTML=top.map(function(c,i){
        const col=palette[i%palette.length];
        const pct=Math.round(c.amount/total*100);
        return '<div class="cat-leg"><span class="cd" style="background:'+col+';"></span><span class="cn">'+c.name+'</span><span class="cp">'+pct+'%</span></div>';
      }).join('');
    }

    // Skor kesehatan: 70% collection rate + 30% margin arus kas (net/inflow).
    function renderHealthScore(collPct, inflow, net){
      let margin = inflow>0 ? Math.max(0,Math.min(1, net/inflow)) : (net>=0?1:0);
      let score = Math.round(collPct*0.7 + margin*100*0.3);
      score = Math.max(0,Math.min(100,score));
      document.getElementById('hsScore').textContent=score;
      const circ=238.8;
      document.getElementById('hsArc').style.strokeDashoffset=circ-(circ*score/100);
      const tag = score>=80?'Sangat sehat 💪' : score>=60?'Cukup sehat' : score>=40?'Perlu perhatian' : 'Butuh perbaikan';
      document.getElementById('hsTag').textContent=tag;
    }

    // Grouped bar chart: pemasukan (mint) vs pengeluaran (charcoal) per bulan.
    function drawBars(inc, exp){
      const svg=document.getElementById('barsChart'); const n=inc.length;
      if(!svg||!n){ if(svg)svg.innerHTML=''; return; }
      const W=320,H=150,padB=16,padT=8;
      const max=Math.max.apply(null,inc.concat(exp))||1;
      const groupW=W/n, barW=Math.min(11,groupW/3.2), gap=3;
      const scale=v=>(v/max)*(H-padB-padT);
      let g='';
      for(let i=0;i<n;i++){
        const cx=i*groupW+groupW/2;
        const hIn=scale(inc[i]), hEx=scale(exp[i]);
        const x1=cx-barW-gap/2, x2=cx+gap/2;
        g+='<rect x="'+x1.toFixed(1)+'" y="'+(H-padB-hIn).toFixed(1)+'" width="'+barW+'" height="'+Math.max(1,hIn).toFixed(1)+'" rx="3" fill="#38bdf8"/>';
        g+='<rect x="'+x2.toFixed(1)+'" y="'+(H-padB-hEx).toFixed(1)+'" width="'+barW+'" height="'+Math.max(1,hEx).toFixed(1)+'" rx="3" fill="#1F3849"/>';
      }
      // baseline
      g+='<line x1="0" y1="'+(H-padB)+'" x2="'+W+'" y2="'+(H-padB)+'" stroke="#e2eefb" stroke-width="1"/>';
      svg.innerHTML=g;
    }

    // Muat bar chart untuk N bulan terakhir (default bulan ini). Selalu tampilkan
    // minimal beberapa batang agar chart terbaca meski periode 1 bulan.
    async function loadBars(months){
      const chartMonths=Math.max(months,3);
      const r=await api('/api/finance/monthly-series?months='+chartMonths);
      if(!r||!r.success||!Array.isArray(r.data)||!r.data.length) return;
      const all=r.data, inc=all.map(d=>d.income||0), exp=all.map(d=>d.expense||0);
      drawBars(inc, exp);
      document.getElementById('barsX').innerHTML=all.map(d=>'<span>'+(d.label||'')+'</span>').join('');
      // Total sesuai periode terpilih: N bulan terakhir dari deret.
      const slIn=inc.slice(-months), slEx=exp.slice(-months);
      document.getElementById('barsIn').textContent=fmtRpShort(slIn.reduce((a,b)=>a+b,0));
      document.getElementById('barsOut').textContent=fmtRpShort(slEx.reduce((a,b)=>a+b,0));
    }
    function onBarsPeriod(){ loadBars(parseInt(document.getElementById('barsPeriod').value)||1); }

    async function loadFinance(){
      document.getElementById('finPeriod').textContent='Ringkasan '+periodLabel();
      // Label kartu penerimaan ikut periode terpilih.
      const revLbl=document.getElementById('revLbl');
      if(revLbl) revLbl.textContent='Penerimaan '+(_period==='this_month'?'Bulan Ini':periodLabel());

      // Line chart kartu saldo: selalu tren 6 bulan (konteks).
      const ms=await api('/api/finance/monthly-series?months=6');
      if(ms&&ms.success&&Array.isArray(ms.data)&&ms.data.length){
        drawSeries(ms.data.map(d=>d.income||0), ms.data.map(d=>d.expense||0));
        document.getElementById('revLabels').innerHTML=ms.data.map(d=>'<span>'+(d.label||'')+'</span>').join('');
      }
      // Bar chart "Pemasukan vs Pengeluaran": ikut periode terpilih (default bulan ini).
      await loadBars(parseInt(document.getElementById('barsPeriod').value)||1);

      // Cashflow periode terpilih → nilai utama kartu + rincian in/out.
      const cf=await api('/api/finance/cashflow'+periodQS());
      var _cfNet=0, _cfIn=0, _cfOut=0;
      if(cf&&cf.success&&cf.data){
        const d=cf.data;
        _cfIn=d.inflow||0; _cfOut=d.outflow||0; _cfNet=_cfIn-_cfOut;
        document.getElementById('revVal').textContent=fmtRpShort(d.inflow||0);
        document.getElementById('kpiIncome').textContent=fmtRpShort(d.inflow||0);
        document.getElementById('kpiExpense').textContent=fmtRpShort(d.outflow||0);
        // Rincian pemasukan per metode
        renderBreak('inBreak','inTotal',(d.inflow_by_method||[]).map(m=>({name:m.method,amount:m.amount,cnt:m.cnt})),'name',['#38bdf8','#38bdf8','#0ea5e9','#3aa0d1','#8296a0']);
        // Rincian pengeluaran per kategori
        const cats=(d.outflow_by_category||[]).map(c=>({name:c.category,amount:c.amount,cnt:c.cnt}));
        renderBreak('outBreak','outTotal',cats,'name',['#f27272','#f0a63c','#e59866','#c05fb0','#8296a0']);
        drawCatDonut(cats);
      }

      // Stats umum (potensi & belum tertagih & collection rate) — basis keseluruhan.
      const bs=await api('/api/billing/stats');
      var _collPct=0;
      if(bs&&bs.success){
        const s=bs.data;
        document.getElementById('kpiPotensi').textContent=fmtRpShort(s.totalInvoiceValue||0);
        document.getElementById('kpiOutstanding').textContent=fmtRpShort(s.outstandingInvoiceValue||0);
        const paidVal=s.paidInvoiceValue||0, totalVal=s.totalInvoiceValue||0;
        const pct=totalVal>0?Math.round(paidVal/totalVal*100):0;
        _collPct=pct;
        document.getElementById('crPct').textContent=pct+'%';
        document.getElementById('crFill').style.width=Math.min(100,pct)+'%';
        document.getElementById('crPaid').textContent=fmtRpShort(paidVal);
        document.getElementById('crTarget').textContent=fmtRpShort(totalVal);
      }

      // Skor kesehatan keuangan: gabungan collection rate (70%) + margin arus kas (30%).
      renderHealthScore(_collPct, _cfIn, _cfNet);

      // Proyeksi penerimaan (bulan berjalan).
      const pj=await api('/api/finance/projection');
      if(pj&&pj.success&&pj.data){
        const d=pj.data;
        document.getElementById('projVal').textContent=fmtRpShort(d.projected_amount||0);
        document.getElementById('projPct').textContent=(d.pct_projected!=null?d.pct_projected:0)+'%';
        document.getElementById('projPaid').textContent=fmtRpShort(d.paid_amount||0);
        document.getElementById('projPipe').textContent=fmtRpShort(d.pipeline_amount||0);
        document.getElementById('projOver').textContent=fmtRpShort(d.overdue_amount||0);
        const tgt=d.target_amount||1;
        document.getElementById('projPaidBar').style.width=Math.min(100,Math.round((d.paid_amount||0)/tgt*100))+'%';
        document.getElementById('projPipeBar').style.width=Math.min(100,Math.round((d.pipeline_amount||0)/tgt*100))+'%';
      }

      // Aging piutang.
      const ag=await api('/api/finance/aging');
      if(ag&&ag.success&&ag.data&&ag.data.buckets){
        const b=ag.data.buckets; const order=['not_due','d1_30','d31_60','d60plus'];
        const colors={not_due:'#0ea5e9',d1_30:'#e0a341',d31_60:'#d1743a',d60plus:'#e2585f'};
        const tot=order.reduce((s,k)=>s+((b[k]&&b[k].amount)||0),0)||1;
        const has=order.some(k=>b[k]&&b[k].amount>0);
        if(has){
          document.getElementById('agingBars').innerHTML=order.map(function(k){
            const bk=b[k]||{amount:0,count:0,label:k}; const w=Math.round(bk.amount/tot*100);
            return '<div class="mb-row"><div class="mb-head"><span class="mb-name">'+bk.label+' <span style="color:#a8b6b3;font-weight:500;">('+bk.count+')</span></span><span class="mb-amt">'+fmtRpShort(bk.amount)+'</span></div><div class="mb-track"><div class="mb-fill" style="width:'+w+'%;background:'+colors[k]+';"></div></div></div>';
          }).join('');
        } else {
          document.getElementById('agingBars').innerHTML='<div style="padding:14px;text-align:center;color:#a8b6b3;font-size:12.5px;">Tidak ada tunggakan</div>';
        }
      }
    }

    setupPickers();
    loadFinance();
  </script>
