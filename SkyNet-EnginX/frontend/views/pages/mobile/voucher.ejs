<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %> - <%= appName %></title>
  <link rel="stylesheet" href="/css/mobile-shell.css?v=7">
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    :root{--bg:#eff8ff;--card:#fff;--ink:#1F3849;--muted:#7c93a0;--line:#e2eefb;--blue:#0ea5e9;--teal:#38bdf8;--green:#38bdf8;--amber:#f5a623;--red:#f2545b;--nav-h:70px;}
    body{font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 8px);-webkit-font-smoothing:antialiased;}
    .money{font-variant-numeric:tabular-nums;letter-spacing:-.3px;}
    .wrap{max-width:520px;margin:0 auto;}
    .head{padding:6px 20px 14px 20px;display:flex;align-items:center;justify-content:space-between;}
    .head .htitle{font-size:20px;font-weight:800;letter-spacing:-.3px;}
    .head .hsub{font-size:12.5px;color:#6b7a97;margin-top:2px;font-weight:500;}
    .refresh{width:42px;height:42px;border-radius:14px;background:#fff;display:flex;align-items:center;justify-content:center;color:var(--blue);cursor:pointer;box-shadow:0 5px 14px -8px rgba(30,60,120,.2);}
    .refresh svg{width:19px;height:19px;} .refresh.spin svg{animation:spin 1s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg);}}
    .content{padding:4px 16px 20px;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
    .anim{opacity:0;animation:fadeUp .5s cubic-bezier(.22,.61,.36,1) forwards;}
    .anim.d1{animation-delay:.05s;}.anim.d2{animation-delay:.14s;}.anim.d3{animation-delay:.22s;}
    .hero{background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:22px;padding:19px 20px;color:#fff;box-shadow:0 14px 30px -14px rgba(47,111,237,.6);margin-bottom:14px;}
    .hero-lbl{font-size:12px;opacity:.82;font-weight:500;}
    .hero-val{font-size:28px;font-weight:800;letter-spacing:-1px;margin-top:4px;}
    .hero-sub{font-size:12px;opacity:.85;margin-top:6px;}
    .kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;}
    .kpi{background:#fff;border-radius:16px;padding:15px;box-shadow:0 6px 16px -10px rgba(30,60,120,.16);}
    .kpi-ic{width:34px;height:34px;border-radius:11px;background:#f5f7fb;color:#3a4a68;display:flex;align-items:center;justify-content:center;margin-bottom:10px;}
    .kpi-ic svg{width:18px;height:18px;stroke-width:1.8;}
    .kpi-val{font-size:20px;font-weight:800;letter-spacing:-.5px;}
    .kpi-lbl{font-size:11.5px;color:var(--muted);margin-top:4px;font-weight:500;}
    .sec{font-size:14px;font-weight:800;margin:4px 2px 12px;letter-spacing:-.2px;}
    .list{display:flex;flex-direction:column;gap:10px;}
    .rs{display:flex;align-items:center;gap:12px;background:#fff;border-radius:15px;padding:13px 15px;box-shadow:0 5px 14px -9px rgba(30,60,120,.14);}
    .rs-rank{width:30px;height:30px;border-radius:9px;background:#f5f7fb;color:#3a4a68;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;}
    .rs-body{flex:1;min-width:0;} .rs-t{font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;} .rs-s{font-size:11.5px;color:var(--muted);margin-top:2px;}
    .rs-amt{font-size:13.5px;font-weight:800;color:var(--teal);flex-shrink:0;}
    .empty{padding:40px 16px;text-align:center;color:var(--muted);font-size:13px;}
    .skel{background:linear-gradient(90deg,#e7edf6 25%,#f2f6fb 50%,#e7edf6 75%);background-size:200% 100%;animation:sh 1.3s infinite;border-radius:8px;}
    @keyframes sh{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
    .bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:300;background:#fff;border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);display:flex;box-shadow:0 -6px 22px rgba(30,60,120,.07);}
    .bn-wrap{max-width:520px;margin:0 auto;width:100%;display:flex;height:var(--nav-h);}
    .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-decoration:none;color:var(--muted);font-size:10px;font-weight:600;}
    .bn-item svg{width:22px;height:22px;stroke-width:2;} .bn-item.active{color:var(--cyan,#0ea5e9);}
    .bn-fab{flex:0 0 auto;width:66px;display:flex;align-items:flex-start;justify-content:center;position:relative;}
    .bn-fab a,.bn-fab button{position:absolute;font-family:inherit;padding:0;cursor:pointer;top:-22px;width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;box-shadow:0 12px 26px -6px rgba(14,165,233,.6);border:4px solid #fff;transition:transform .14s;}
    .bn-fab a:active,.bn-fab button:active{transform:scale(.92);}
    .bn-fab svg{width:26px;height:26px;stroke-width:2.6;}
  </style>
</head>
<body>
  <%- include('../../partials/mobile-drawer', { active: active, appName: (typeof appName!=='undefined'?appName:'FLAYNET'), user: user }) %>
  <div class="wrap">
    <div class="head">
      <div><div class="htitle">Voucher</div><div class="hsub">Penjualan voucher & reseller</div></div>
      <div class="refresh" id="refreshBtn" onclick="loadVoucher(true)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg></div>
    </div>
    <div class="content">
      <div class="hero anim d1">
        <div class="hero-lbl">Total Pendapatan Voucher</div>
        <div class="hero-val money" id="vRevenue"><span class="skel" style="display:inline-block;width:120px;height:25px;background:rgba(255,255,255,.25);"></span></div>
        <div class="hero-sub" id="vRevSub">Memuat…</div>
      </div>
      <div class="kpi-grid anim d2">
        <div class="kpi"><div class="kpi-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 0 0-2 2v3a2 2 0 0 1 0 4v3a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3a2 2 0 0 1 0-4V7a2 2 0 0 0-2-2z"/></svg></div><div class="kpi-val" id="vVouchers">–</div><div class="kpi-lbl">Voucher terjual</div></div>
        <div class="kpi"><div class="kpi-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div class="kpi-val" id="vResellers">–</div><div class="kpi-lbl">Reseller</div></div>
        <div class="kpi"><div class="kpi-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="kpi-val money" id="vProfit" style="color:var(--green);">–</div><div class="kpi-lbl">Profit</div></div>
        <div class="kpi"><div class="kpi-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4"/><path d="M4 6v12c0 1.1.9 2 2 2h14v-4"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg></div><div class="kpi-val money" id="vTopup" style="color:var(--teal);">–</div><div class="kpi-lbl">Total top-up</div></div>
      </div>
      <div class="sec anim d3">Reseller Teratas</div>
      <div class="list anim d3" id="vRanking">
        <div class="rs"><div class="skel" style="width:30px;height:30px;border-radius:9px;"></div><div class="rs-body"><div class="skel" style="width:130px;height:13px;"></div><div class="skel" style="width:80px;height:10px;margin-top:6px;"></div></div></div>
        <div class="rs"><div class="skel" style="width:30px;height:30px;border-radius:9px;"></div><div class="rs-body"><div class="skel" style="width:130px;height:13px;"></div><div class="skel" style="width:80px;height:10px;margin-top:6px;"></div></div></div>
      </div>
    </div>
  </div>
    <nav class="bottomnav">
    <div class="bn-wrap">
      <a class="bn-item" href="/mobile"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span><span>Beranda</span></a>
      <a class="bn-item" href="/mobile/customers"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span><span>Pelanggan</span></a>
      <div class="bn-fab"><button type="button" onclick="FabSheet.open()" aria-label="Tambah cepat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button></div>
      <a class="bn-item" href="/mobile/finance"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg></span><span>Laporan</span></a>
      <a class="bn-item" href="/mobile/monitoring"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></span><span>Monitor</span></a>
    </div>
  </nav>
  <script>
    function getToken(){ const ls=localStorage.getItem('token'); if(ls)return ls; const m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    async function api(url){ const t=getToken(); const headers=Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}); try{ const r=await fetch(url,{credentials:'include',headers}); if(r.status===401){location.href='/login';return null;} const x=await r.text(); try{return x?JSON.parse(x):null;}catch(_){return null;} }catch(e){return null;} }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function fmtRpShort(n){ n=Number(n)||0; if(n>=1000000)return 'Rp '+(n/1000000).toFixed(1).replace('.0','')+'jt'; if(n>=1000)return 'Rp '+Math.round(n/1000)+'rb'; return 'Rp '+n.toLocaleString('id-ID'); }
    function rsCard(r,i){
      const nm=r.name||r.code||'Reseller';
      return '<div class="rs"><div class="rs-rank">'+(i+1)+'</div><div class="rs-body"><div class="rs-t">'+esc(nm)+'</div><div class="rs-s">'+(r.vouchers||0)+' voucher · '+esc(r.code||'')+'</div></div><div class="rs-amt">'+fmtRpShort(r.modal||0)+'</div></div>';
    }
    async function loadVoucher(manual){
      const btn=document.getElementById('refreshBtn'); if(manual)btn.classList.add('spin');
      const j=await api('/api/reseller-admin/report');
      if(j&&j.success&&j.data){
        const s=j.data.summary||{};
        document.getElementById('vRevenue').textContent=fmtRpShort(s.total_revenue||0);
        document.getElementById('vRevSub').textContent=(s.total_vouchers||0)+' voucher · profit '+fmtRpShort(s.total_profit||0);
        document.getElementById('vVouchers').textContent=(s.total_vouchers||0).toLocaleString('id-ID');
        document.getElementById('vResellers').textContent=s.reseller_count||0;
        document.getElementById('vProfit').textContent=fmtRpShort(s.total_profit||0);
        document.getElementById('vTopup').textContent=fmtRpShort(s.total_topup||0);
        const ranking=j.data.ranking||j.data.per_reseller||[];
        const list=document.getElementById('vRanking');
        if(ranking.length){ list.innerHTML=ranking.slice(0,10).map(rsCard).join(''); }
        else{ list.innerHTML='<div class="empty">Belum ada data reseller</div>'; }
      } else {
        document.getElementById('vRevenue').textContent='Rp 0';
        document.getElementById('vRevSub').textContent='Data tidak tersedia';
        document.getElementById('vRanking').innerHTML='<div class="empty">Modul voucher belum aktif atau tidak ada data</div>';
      }
      if(manual) setTimeout(()=>btn.classList.remove('spin'),600);
    }
    loadVoucher(false);
  </script>
</body>
</html>
