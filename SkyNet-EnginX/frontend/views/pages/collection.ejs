<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  <script src="/vendor/leaflet/leaflet.js"></script>
  <style>
    .coll-page { font-family:'DM Sans',sans-serif; }
    /* ── STAT CARDS ── */
    .coll-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:20px; }
    @media(max-width:1100px){ .coll-grid{ grid-template-columns:repeat(2,1fr); } }
    @media(max-width:560px){ .coll-grid{ grid-template-columns:1fr; } }
    .coll-card { position:relative; background:#fff; border:1px solid #eef2f9; border-radius:18px; padding:17px 19px; overflow:hidden; transition:box-shadow .18s,transform .18s,border-color .18s; cursor:pointer; }
    .coll-card:hover { box-shadow:0 12px 30px rgba(20,40,90,.1); transform:translateY(-3px); }
    .coll-card:active { transform:translateY(-1px); }
    .coll-card .lbl { font-size:11.5px; font-weight:600; color:#64748b; margin-bottom:12px; display:flex; align-items:center; gap:9px; }
    .coll-card .lbl .ic { width:34px; height:34px; border-radius:11px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .coll-card .lbl .ic svg { width:17px; height:17px; }
    .coll-card .val { font-size:27px; font-weight:800; color:#0d1b3e; letter-spacing:-.7px; line-height:1; }
    .coll-card .sub { font-size:11.5px; color:#94a3b8; margin-top:7px; }
    .coll-card .arrow { position:absolute; top:16px; right:16px; color:#cbd5e1; opacity:0; transform:translateX(-4px); transition:opacity .18s,transform .18s; }
    .coll-card:hover .arrow { opacity:1; transform:translateX(0); }
    .coll-card.blue { background:linear-gradient(160deg,#f5f9ff,#fff); border-color:#e3edfe; } .coll-card.blue:hover { border-color:#bfd7fe; } .coll-card.blue .val { color:#1d4ed8; } .coll-card.blue .ic { background:#1d4ed8; color:#fff; }
    .coll-card.teal { background:linear-gradient(160deg,#f1fdfb,#fff); border-color:#d7f3ee; } .coll-card.teal:hover { border-color:#a9e6dc; } .coll-card.teal .val { color:#0d9488; } .coll-card.teal .ic { background:#0d9488; color:#fff; }
    .coll-card.amber{ background:linear-gradient(160deg,#fffaf2,#fff); border-color:#f6e7cf; } .coll-card.amber:hover { border-color:#eccfa0; } .coll-card.amber .val{ color:#b45309; } .coll-card.amber .ic { background:#d98324; color:#fff; }
    .coll-card.red  { background:linear-gradient(160deg,#fff5f5,#fff); border-color:#f7d9d9; } .coll-card.red:hover { border-color:#f0b4b4; } .coll-card.red .val  { color:#dc2626; } .coll-card.red .ic { background:#dc2626; color:#fff; }

    /* ── Styled confirm dialog ── */
    .pc-overlay { display:none; position:fixed; inset:0; z-index:10001; background:rgba(13,27,62,.55); backdrop-filter:blur(3px); align-items:center; justify-content:center; padding:24px; font-family:'DM Sans',sans-serif; }
    .pc-overlay.open { display:flex; animation:pmFade .15s ease; }
    .pc-box { background:#fff; border-radius:18px; width:min(420px,94vw); padding:26px 24px 22px; text-align:center; box-shadow:0 26px 70px rgba(13,27,62,.4); animation:pmPop .18s cubic-bezier(.2,.9,.3,1.2); }
    .pc-icn { width:54px;height:54px;border-radius:16px;margin:0 auto 14px;display:flex;align-items:center;justify-content:center; }
    .pc-icn.ok { background:#e6faf7;color:#0d9488; } .pc-icn.warn { background:#fef2f2;color:#dc2626; }
    .pc-ttl { font-size:17px;font-weight:800;color:#0d1b3e;letter-spacing:-.3px;margin-bottom:6px; }
    .pc-msg { font-size:13.5px;color:#64748b;line-height:1.55; }
    .pc-field { text-align:left; margin-top:14px; }
    .pc-field-lbl { font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#94a3b8;display:block;margin-bottom:6px; }
    .pc-input { width:100%;box-sizing:border-box;padding:10px 12px;border:1.5px solid #e0e7f3;border-radius:10px;font-size:13px;font-family:inherit;resize:vertical;outline:none; }
    .pc-input:focus { border-color:#1d4ed8; }
    .pc-btns { display:flex;gap:10px;margin-top:20px; }
    .pc-btn { flex:1;padding:11px;border-radius:11px;font-family:inherit;font-size:13.5px;font-weight:700;cursor:pointer;border:none;transition:filter .15s; }
    .pc-cancel { background:#f1f5f9;color:#475569; } .pc-cancel:hover { filter:brightness(.97); }
    .pc-ok.is-ok { background:#0d9488;color:#fff; } .pc-ok.is-warn { background:#dc2626;color:#fff; }
    .pc-ok:hover { filter:brightness(.95); }

    /* ── Map ── */
    .map-legend { display:flex; flex-wrap:wrap; gap:14px; margin-bottom:12px; padding:10px 14px; background:#fff; border:1px solid #eef2f9; border-radius:12px; }
    .map-legend .lg { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:#475569; }
    .map-legend .lg .sw { width:12px; height:12px; border-radius:50%; box-shadow:0 0 0 2px #fff,0 0 0 3px rgba(0,0,0,.06); }
    .coll-pin { width:24px; height:24px; border-radius:50% 50% 50% 0; transform:rotate(-45deg); border:2px solid #fff; box-shadow:0 2px 6px rgba(0,0,0,.35); }
    .coll-pop { font-family:'DM Sans',sans-serif; min-width:200px; }
    .coll-pop h4 { font-size:14px; font-weight:800; color:#0d1b3e; margin:0 0 2px; }
    .coll-pop .cid { font-size:11px; color:#94a3b8; font-family:'DM Mono',monospace; margin-bottom:7px; }
    .coll-pop .r { display:flex; justify-content:space-between; gap:10px; font-size:12px; padding:2px 0; }
    .coll-pop .r span { color:#94a3b8; } .coll-pop .r b { color:#0d1b3e; }
    .coll-pop .addr { font-size:11.5px; color:#64748b; margin-top:6px; line-height:1.4; }
    .coll-pop .act { margin-top:9px; display:flex; gap:6px; }
    .coll-pop .act button { flex:1; padding:7px; border:none; border-radius:8px; font-family:inherit; font-size:12px; font-weight:700; cursor:pointer; }
    .coll-pop .act .b-move { background:#eff6ff; color:#1d4ed8; } .coll-pop .act .b-move:hover { background:#dbeafe; }

    /* ── Reassign modal ── */
    .ra-list { max-height:230px; overflow-y:auto; margin-top:6px; display:flex; flex-direction:column; gap:7px; }
    .ra-opt { display:flex; align-items:center; gap:11px; padding:11px 13px; border:1.5px solid #e8eef7; border-radius:12px; cursor:pointer; transition:all .14s; }
    .ra-opt:hover { border-color:#bfdbfe; background:#f6faff; }
    .ra-opt.sel { border-color:#1d4ed8; background:#eff6ff; }
    .ra-opt .av { width:34px; height:34px; border-radius:50%; background:#e6faf7; color:#0d9488; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px; flex-shrink:0; }
    .ra-opt .nm { font-weight:700; font-size:13.5px; color:#0d1b3e; }
    .ra-opt .meta { font-size:11.5px; color:#94a3b8; }
    .ra-opt .rd { margin-left:auto; width:18px; height:18px; border-radius:50%; border:2px solid #cbd5e1; flex-shrink:0; }
    .ra-opt.sel .rd { border-color:#1d4ed8; background:#1d4ed8; box-shadow:inset 0 0 0 3px #fff; }
    .ra-hist { margin-top:8px; border-top:1px solid #eef2f9; padding-top:12px; }
    .ra-hist h5 { font-size:12px; font-weight:700; color:#475569; margin:0 0 8px; }
    .ra-hist-row { display:flex; gap:10px; font-size:12px; padding:7px 0; border-bottom:1px dashed #eef2f9; }
    .ra-hist-row:last-child { border-bottom:none; }
    .ra-hist-dot { width:8px; height:8px; border-radius:50%; background:#1d4ed8; margin-top:5px; flex-shrink:0; }
    .ra-hist-row .t { color:#94a3b8; font-size:11px; }

    /* ── Setoran Kas list (admin) ── */
    .dep-list { display:flex; flex-direction:column; gap:10px; }
    .dep-card { display:flex; align-items:center; gap:13px; background:#fff; border:1px solid #eef2f9; border-radius:14px; padding:14px 16px; cursor:pointer; transition:box-shadow .16s,transform .16s,border-color .16s; }
    .dep-card:hover { box-shadow:0 8px 22px rgba(20,40,90,.08); transform:translateY(-2px); border-color:#dbe6f5; }
    .dep-ic { width:42px; height:42px; border-radius:12px; background:#eff6ff; color:#1d4ed8; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .dep-main { flex:1; min-width:0; }
    .dep-amt { font-size:16px; font-weight:800; color:#0d1b3e; }
    .dep-meta { font-size:12px; color:#94a3b8; margin-top:2px; }
    .dep-meta2 { font-size:11.5px; color:#64748b; margin-top:3px; }
    .dep-right { display:flex; align-items:center; gap:8px; flex-shrink:0; }
    .dep-chev { flex-shrink:0; }
    .dep-st { font-size:11px; font-weight:800; padding:4px 10px; border-radius:8px; white-space:nowrap; }
    .dep-st-wait { background:#fef3e2; color:#b45309; } .dep-st-ok { background:#e7f7ef; color:#0a9a5a; } .dep-st-no { background:#fee2e2; color:#dc2626; }
    .dep-empty { padding:48px 16px; text-align:center; color:#94a3b8; font-size:13px; display:flex; flex-direction:column; align-items:center; gap:12px; }
    @media(max-width:560px){ .dep-meta2 { display:none; } .dep-card { padding:12px 13px; gap:11px; } }
    /* ── TOOLBAR ── */
    .coll-toolbar { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:16px; }
    .coll-toolbar input, .coll-toolbar select {
      padding:9px 12px; border:1.5px solid #e0e7f3; border-radius:10px; font-size:13px;
      font-family:inherit; color:#0d1b3e; background:#fff; outline:none;
    }
    .coll-toolbar input:focus, .coll-toolbar select:focus { border-color:#1a6ef5; }
    .btn-c { display:inline-flex; align-items:center; gap:6px; padding:9px 15px; border-radius:10px;
      font-size:13px; font-weight:700; cursor:pointer; border:none; transition:filter .15s; }
    .btn-primary { background:#1a6ef5; color:#fff; }
    .btn-teal    { background:#0d9488; color:#fff; }
    .btn-ghost   { background:#fff; color:#0d1b3e; border:1.5px solid #e0e7f3; }
    .btn-c:hover { filter:brightness(.96); }
    /* ── TABLE ── */
    .coll-tablewrap { background:#fff; border:1px solid #e8eef7; border-radius:16px; overflow:hidden; }
    table.coll { width:100%; border-collapse:collapse; font-size:13px; }
    table.coll th { text-align:left; padding:12px 14px; background:#f7f9fc; color:#64748b; font-weight:700;
      font-size:11.5px; letter-spacing:.3px; text-transform:uppercase; border-bottom:1px solid #eef2f9; white-space:nowrap; }
    table.coll td { padding:12px 14px; border-bottom:1px solid #f1f5fb; color:#0d1b3e; vertical-align:middle; }
    table.coll tr:last-child td { border-bottom:none; }
    table.coll tbody tr.coll-row:hover td { background:#f6faff; }
    .badge { display:inline-flex; align-items:center; padding:3px 9px; border-radius:100px; font-size:11px; font-weight:700; white-space:nowrap; }
    .b-pending{ background:#f1f5f9; color:#64748b; } .b-assigned{ background:#dbeafe; color:#1d4ed8; }
    .b-inprogress{ background:#e0f2fe; color:#0369a1; } .b-paid{ background:#dcfce7; color:#16a34a; }
    .b-partial{ background:#fef9c3; color:#a16207; } .b-promise{ background:#fef3c7; color:#b45309; }
    .b-nothome{ background:#fae8ff; color:#a21caf; } .b-refused{ background:#fee2e2; color:#dc2626; }
    .b-termination{ background:#ffe4e6; color:#be123c; } .b-cancelled{ background:#f1f5f9; color:#94a3b8; }
    .chk { width:16px; height:16px; cursor:pointer; accent-color:#1a6ef5; }
    .money { font-family:'DM Mono',monospace; font-weight:500; }
    /* ── MODAL ── */
    .modal-overlay { position:fixed; inset:0; background:rgba(13,27,62,.45); display:none; align-items:center; justify-content:center; z-index:1000; padding:16px; }
    .modal-overlay.show { display:flex; }
    .modal-box { background:#fff; border-radius:18px; width:100%; max-width:440px; padding:24px; }
    .modal-box h3 { margin:0 0 4px; font-size:17px; font-weight:800; color:#0d1b3e; }
    .modal-box p.hint { margin:0 0 18px; font-size:12.5px; color:#94a3b8; }
    .modal-box label { display:block; font-size:12px; font-weight:600; color:#475569; margin:12px 0 5px; }
    .modal-box select, .modal-box input { width:100%; padding:10px 12px; border:1.5px solid #e0e7f3; border-radius:10px; font-size:13px; font-family:inherit; outline:none; box-sizing:border-box; }
    .modal-actions { display:flex; gap:10px; margin-top:20px; }
    .modal-actions .btn-c { flex:1; justify-content:center; }
    .pager { display:flex; gap:8px; align-items:center; justify-content:flex-end; padding:12px 14px; font-size:13px; color:#64748b; }
    .pager button { padding:6px 12px; border:1.5px solid #e0e7f3; border-radius:8px; background:#fff; cursor:pointer; font-size:13px; }
    .pager button:disabled { opacity:.45; cursor:not-allowed; }
    .empty { padding:48px 16px; text-align:center; color:#94a3b8; font-size:13px; }

    /* ── Tabs (seperti halaman Payments) ── */
    .coll-pills { display:inline-flex; gap:6px; background:#fff; border:1px solid #e8eef7; border-radius:13px; padding:5px; margin-bottom:18px; overflow-x:auto; max-width:100%; }
    .coll-tab-btn { display:inline-flex; align-items:center; gap:7px; padding:9px 16px; border:none; background:transparent; border-radius:9px; font-family:inherit; font-size:13px; font-weight:600; color:#64748b; cursor:pointer; white-space:nowrap; transition:background .15s,color .15s; }
    .coll-tab-btn:hover:not(.coll-tab-active) { background:#f4f8ff; color:#0d1b3e; }
    .coll-tab-active { background:#2563eb !important; color:#fff !important; }
    .coll-tab-active .tab-badge { background:rgba(255,255,255,.25) !important; color:#fff !important; }
    .coll-tab-icn { width:16px; height:16px; flex-shrink:0; }
    .tab-badge { display:none; margin-left:2px; background:#dc2626; color:#fff; font-size:10px; font-weight:800; padding:1px 7px; border-radius:9px; }
    .link-proof { padding:5px 11px; border:1px solid #e2e8f0; border-radius:8px; background:#fff; color:#1a6ef5; font-size:11.5px; font-weight:700; cursor:pointer; }
    .link-proof:hover { background:#eff6ff; border-color:#bfdbfe; }

    /* ── Detail Bukti Transfer Modal (mirror Payments) ── */
    .pm-overlay { display:none; position:fixed; inset:0; z-index:10000; background:rgba(13,27,62,.55); backdrop-filter:blur(3px); align-items:center; justify-content:center; padding:24px; font-family:'DM Sans',sans-serif; }
    .pm-overlay.open { display:flex; animation:pmFade .18s ease; }
    @keyframes pmFade { from{opacity:0} to{opacity:1} }
    .pm-box { background:#fff; border-radius:20px; width:min(860px,96vw); max-height:92vh; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 30px 80px rgba(13,27,62,.35); animation:pmPop .2s cubic-bezier(.2,.9,.3,1.2); }
    @keyframes pmPop { from{transform:scale(.95);opacity:0} to{transform:scale(1);opacity:1} }
    .pm-head { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:18px 22px; border-bottom:1px solid #e8eef7; background:linear-gradient(135deg,#f8faff,#eef4ff); }
    .pm-head-icn { width:38px;height:38px;border-radius:11px;background:#eff6ff;display:flex;align-items:center;justify-content:center;color:#1d4ed8;flex-shrink:0; }
    .pm-head-ttl { font-size:16px;font-weight:800;color:#0d1b3e;letter-spacing:-.3px; }
    .pm-head-sub { font-size:12px;color:#94a3b8;font-family:'DM Mono',monospace;margin-top:1px; }
    .pm-close { width:34px;height:34px;border-radius:10px;border:1px solid #e8eef7;background:#fff;color:#94a3b8;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;flex-shrink:0; }
    .pm-close:hover { background:#fee2e2;border-color:#fecaca;color:#dc2626; }
    .pm-body { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,1fr); gap:0; overflow:auto; }
    @media(max-width:680px){ .pm-body { grid-template-columns:1fr; } }
    .pm-img-col { padding:20px; border-right:1px solid #e8eef7; display:flex; flex-direction:column; }
    @media(max-width:680px){ .pm-img-col { border-right:none; border-bottom:1px solid #e8eef7; } }
    .pm-img-label, .pm-info-label { font-size:10.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#94a3b8;margin-bottom:10px; }
    .pm-img-frame { flex:1; min-height:240px; border-radius:14px; border:1px solid #e8eef7; background:#f4f8ff; overflow:auto; display:flex; align-items:center; justify-content:center; max-height:54vh; }
    .pm-img-frame img { display:block; max-width:100%; height:auto; }
    .pm-img-frame iframe { width:100%; height:54vh; border:none; }
    .pm-img-loading { color:#94a3b8; font-size:13px; padding:40px; }
    .pm-img-frame.is-empty { background:#f8faff; border-style:dashed; }
    .pm-img-empty { display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:36px 24px; gap:4px; }
    .pm-img-empty-icn { width:64px;height:64px;border-radius:18px;background:#eef2f9;color:#94a3b8;display:flex;align-items:center;justify-content:center;margin-bottom:10px; }
    .pm-img-empty-ttl { font-size:14px;font-weight:800;color:#475569; }
    .pm-img-empty-sub { font-size:12px;color:#94a3b8;line-height:1.5;max-width:240px; }
    .pm-img-open { margin-top:12px;display:inline-flex;align-items:center;justify-content:center;gap:6px;font-size:12px;font-weight:700;color:#1d4ed8;text-decoration:none;padding:9px;border-radius:10px;background:#eff6ff;border:1px solid #bfdbfe;transition:background .15s; }
    .pm-img-open:hover { background:#dbeafe; }
    .pm-info-col { padding:20px; display:flex; flex-direction:column; }
    .pm-amt-card { background:linear-gradient(135deg,#1d4ed8,#1e3a8a); border-radius:14px; padding:16px 18px; margin-bottom:16px; }
    .pm-amt-lbl { font-size:11px;font-weight:600;color:rgba(255,255,255,.7);letter-spacing:.04em; }
    .pm-amt-val { font-size:28px;font-weight:800;color:#fff;letter-spacing:-1px;line-height:1.1;margin-top:3px;font-family:'DM Mono',monospace; }
    .pm-rows { display:flex; flex-direction:column; }
    .pm-row { display:flex; align-items:flex-start; justify-content:space-between; gap:14px; padding:9px 0; border-bottom:1px dashed #eef2f9; }
    .pm-row:last-child { border-bottom:none; }
    .pm-row-k { font-size:12px;color:#94a3b8;font-weight:600;flex-shrink:0; }
    .pm-row-v { font-size:12.5px;color:#0d1b3e;font-weight:700;text-align:right;word-break:break-word; }
    .pm-st { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:7px;font-size:11.5px;font-weight:700;background:rgba(255,255,255,.2);color:#fff; }
    /* ── Mobile card transform ── */
    @media(max-width:820px){
      table.coll thead { display:none; }
      table.coll, table.coll tbody, table.coll tr, table.coll td { display:block; width:100%; }
      table.coll tr { border:1px solid #eef2f9; border-radius:12px; margin-bottom:10px; padding:6px 4px; }
      table.coll td { border:none; padding:7px 14px; display:flex; justify-content:space-between; align-items:center; gap:12px; }
      table.coll td::before { content:attr(data-label); font-size:11px; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.3px; }
      table.coll td.no-label::before { content:''; }
    }
  </style>
</head>
<body>
<div class="app-layout coll-page">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content">

      <!-- Header -->
      <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
        <div>
          <h1 style="font-size:22px;font-weight:800;color:#0d1b3e;margin:0 0 4px;">Collect Billing</h1>
          <p style="font-size:13px;color:#6b7fa8;margin:0;">Penagihan lapangan — generate tugas, tugaskan kolektor, pantau setoran kas</p>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="btn-c btn-ghost" onclick="openCollectors()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
            Kelola Kolektor
          </button>
          <button class="btn-c btn-ghost" onclick="openGenerate()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Generate Task
          </button>
