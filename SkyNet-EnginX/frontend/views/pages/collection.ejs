      <div style="display:flex;align-items:center;gap:11px;min-width:0;">
        <div class="pm-head-icn">
          <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
        </div>
        <div style="min-width:0;">
          <div class="pm-head-ttl" id="ddTitle">Detail Setoran</div>
          <div class="pm-head-sub" id="ddSub">—</div>
        </div>
      </div>
      <button class="pm-close" onclick="closeDepositDetail()" aria-label="Tutup">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="pm-body">
      <div class="pm-img-col">
        <div class="pm-img-label">Bukti Setor</div>
        <div class="pm-img-frame" id="ddImgFrame"><div class="pm-img-loading">Memuat…</div></div>
        <a id="ddImgOpen" href="#" target="_blank" rel="noopener" class="pm-img-open">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Buka gambar ukuran penuh
        </a>
      </div>
      <div class="pm-info-col">
        <div class="pm-info-label">Informasi Setoran</div>
        <div class="pm-amt-card">
          <div class="pm-amt-lbl">Jumlah Disetor</div>
          <div class="pm-amt-val" id="ddAmount">Rp 0</div>
          <div id="ddStatusWrap" style="margin-top:8px;"></div>
        </div>
        <div class="pm-rows">
          <div class="pm-row"><span class="pm-row-k">Ekspektasi (cash)</span><span class="pm-row-v" id="ddExpected">—</span></div>
          <div class="pm-row"><span class="pm-row-k">Selisih</span><span class="pm-row-v" id="ddVariance">—</span></div>
          <div class="pm-row"><span class="pm-row-k">Tanggal Setor</span><span class="pm-row-v" id="ddDate">—</span></div>
          <div class="pm-row"><span class="pm-row-k">Kolektor</span><span class="pm-row-v" id="ddCollector">—</span></div>
          <div class="pm-row"><span class="pm-row-k">Diverifikasi oleh</span><span class="pm-row-v" id="ddVerifier">—</span></div>
          <div class="pm-row" id="ddNoteRow" style="display:none;"><span class="pm-row-k">Catatan</span><span class="pm-row-v" id="ddNote">—</span></div>
          <div class="pm-row" id="ddRejectRow" style="display:none;"><span class="pm-row-k" style="color:#dc2626;">Alasan Tolak</span><span class="pm-row-v" id="ddReject" style="color:#dc2626;">—</span></div>
        </div>
        <div id="ddActions" style="display:none;gap:10px;margin-top:16px;"></div>
      </div>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
<script src="/js/collection-admin.js"></script>
</body>
</html>
