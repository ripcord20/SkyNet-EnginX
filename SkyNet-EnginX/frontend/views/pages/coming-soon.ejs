<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    body{background:#eef2f9;font-family:'DM Sans',sans-serif;}
    .cs-wrap{display:flex;align-items:center;justify-content:center;min-height:calc(100vh - 140px);padding:30px 16px;}
    .cs-card{background:#fff;border:1px solid #e0e7f3;border-radius:22px;max-width:520px;width:100%;
      padding:42px 34px 38px;text-align:center;box-shadow:0 18px 50px -22px rgba(13,27,62,.25);}
    .cs-ic{width:88px;height:88px;margin:0 auto 22px;border-radius:24px;
      background:linear-gradient(135deg,#2AABEE,#229ED9);display:flex;align-items:center;justify-content:center;
      box-shadow:0 14px 30px -10px rgba(34,158,217,.55);}
    .cs-badge{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:800;letter-spacing:.05em;
      text-transform:uppercase;color:#1565e0;background:#eef5ff;padding:5px 13px;border-radius:100px;margin-bottom:16px;}
    .cs-badge .dot{width:7px;height:7px;border-radius:50%;background:#1f8bff;animation:csPulse 1.4s ease-in-out infinite;}
    @keyframes csPulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.45;transform:scale(.7);}}
    .cs-title{font-size:24px;font-weight:800;color:#0d1b3e;letter-spacing:-.02em;margin-bottom:10px;}
    .cs-desc{font-size:14px;color:#6b7fa8;line-height:1.65;max-width:400px;margin:0 auto 26px;}
    .cs-btn{display:inline-flex;align-items:center;gap:8px;padding:11px 20px;border-radius:12px;font-size:13.5px;
      font-weight:700;text-decoration:none;font-family:inherit;background:linear-gradient(135deg,#1f8bff,#1565e0);
      color:#fff;box-shadow:0 6px 14px -4px rgba(31,122,255,.5);transition:transform .15s;}
    .cs-btn:hover{transform:translateY(-1px);}
  </style>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { active: active }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { user: user }) %>
    <main class="page-content">
      <div class="cs-wrap">
        <div class="cs-card">
          <div class="cs-ic">
            <svg width="40" height="40" fill="#fff" viewBox="0 0 24 24"><path d="M21.5 4.5L2.5 12.5l5.5 2 2 6 3-4 5 4z"/></svg>
          </div>
          <div class="cs-badge"><span class="dot"></span>Segera Hadir</div>
          <div class="cs-title"><%= pageTitle || title %></div>
          <div class="cs-desc"><%= pageDesc || 'Fitur ini sedang dalam pengembangan dan akan segera tersedia.' %></div>
          <a href="/telegram" class="cs-btn">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Kembali ke Telegram Center
          </a>
        </div>
      </div>
    </main>
  </div>
</div>
</body>
</html>
