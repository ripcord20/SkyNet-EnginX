    var DEPST={pending:['Menunggu Verifikasi','b-promise'],verified:['Terverifikasi','b-paid'],rejected:['Ditolak','b-refused']};
    var header='<div class="card" style="background:linear-gradient(135deg,#e0822e,#f4b73d);border:none;color:#fff;box-shadow:0 12px 30px rgba(224,130,46,.32);">'+
      '<div style="font-size:12.5px;opacity:.92;font-weight:600;">Cash di Tangan (belum disetor)</div>'+
