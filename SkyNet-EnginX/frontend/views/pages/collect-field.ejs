  function renderDepBreakdown(){
    var box=document.getElementById('depBreakdown');if(!box)return;
    var bd=depState.breakdown||[];
    if(!bd.length){
      box.innerHTML='<div class="dep-bd-empty">Belum ada pembayaran baru sejak setoran terverifikasi terakhir.</div>';
      return;
    }
    var sum=bd.reduce(function(a,p){return a+(Number(p.amount)||0);},0);
    var items=bd.map(function(p){
      return '<div class="dep-bd-row">'+
        '<div style="min-width:0;"><div class="dep-bd-name">'+esc(p.customer||p.invoice||('Pembayaran #'+p.id))+'</div>'+
        '<div class="dep-bd-meta">'+esc(p.invoice||'')+(p.date?(' · '+fmtDue(p.date)):'')+'</div></div>'+
        '<div class="dep-bd-amt money">'+rp(p.amount)+'</div>'+
      '</div>';
    }).join('');
    box.innerHTML='<div class="dep-bd-head"><span>Rincian kas ('+bd.length+' pembayaran)</span><b class="money">'+rp(sum)+'</b></div>'+
      '<div class="dep-bd-list">'+items+'</div>';
  }

