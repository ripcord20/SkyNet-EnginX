  function openDepositDetail(idx){
    var x=depState.list[idx];if(!x)return;
    var STLBL={pending:'Menunggu verifikasi',verified:'Terverifikasi',rejected:'Ditolak'};
    document.getElementById('ddStatusHint').textContent=STLBL[x.status]||x.status;
    document.getElementById('ddAmount').textContent=rp(x.deposited_amount);
    document.getElementById('ddExpected').textContent=rp(x.expected_amount);
    var diff=x.variance||0;
    var vEl=document.getElementById('ddVariance');
    if(diff===0){vEl.textContent='Cocok';vEl.style.color='#0a9a5a';}
    else{vEl.textContent=(diff<0?'-':'+')+'Rp'+Math.abs(diff).toLocaleString('id-ID');vEl.style.color=diff<0?'#d63a3f':'#0a9a5a';}
    document.getElementById('ddDate').textContent=fmtDue(x.deposit_date);
    var nr=document.getElementById('ddNoteRow');
    if(x.note){nr.style.display='flex';document.getElementById('ddNote').textContent=x.note;}else nr.style.display='none';
    var rr=document.getElementById('ddRejectRow');
    if(x.reject_reason){rr.style.display='flex';document.getElementById('ddReject').textContent=x.reject_reason;}else rr.style.display='none';
    // Bukti setor
