  // Ambil lokasi GPS untuk bukti audit saat catat bayar (best-effort).
  function captureGps(){
    var el=document.getElementById('payGps');
    if(el){el.className='pay-gps loading';el.innerHTML=gpsIcon()+'<span>Mengambil lokasi…</span>';}
    if(!navigator.geolocation){if(el){el.className='pay-gps off';el.innerHTML=gpsIcon()+'<span>GPS tidak didukung perangkat</span>';}return;}
    navigator.geolocation.getCurrentPosition(function(pos){
      payState.lat=pos.coords.latitude;payState.lng=pos.coords.longitude;
      if(el){el.className='pay-gps ok';el.innerHTML=gpsIcon()+'<span>Lokasi terekam ('+payState.lat.toFixed(5)+', '+payState.lng.toFixed(5)+')</span>';}
    },function(){
      payState.lat=null;payState.lng=null;
      if(el){el.className='pay-gps off';el.innerHTML=gpsIcon()+'<span>Lokasi tidak tersedia — izinkan akses lokasi</span><button type="button" class="pay-gps-retry" onclick="captureGps()">Coba lagi</button>';}
    },{enableHighAccuracy:true,timeout:8000,maximumAge:30000});
  }
  function gpsIcon(){return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>';}
