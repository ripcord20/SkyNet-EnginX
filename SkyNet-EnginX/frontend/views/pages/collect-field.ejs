    document.getElementById('pdTitle').textContent=partial?'Pembayaran Sebagian':'Pembayaran Lunas';
    document.getElementById('pdSub').textContent=(c.name||'-')+(inv.invoice_number?(' · '+inv.invoice_number):'');
    var paid=a.amount_collected!=null?a.amount_collected:a.amount_due;
    document.getElementById('pdAmount').textContent=rp(paid);
    document.getElementById('pdTotal').textContent=rp(inv.total!=null?inv.total:a.amount_due);
