    } else { pw.style.display='none'; }
    openSheet('depDetailSheet');
  }

  async function loadDepProof(frame,url){
    try{
      var t=getToken();
      var headers={'Accept':'image/*,application/pdf'};if(t)headers['Authorization']='Bearer '+t;
      var res=await fetch(url,{credentials:'include',headers:headers});
      var ct=(res.headers.get('content-type')||'').toLowerCase();
      if(!res.ok||ct.indexOf('application/json')>=0||ct.indexOf('text/')>=0){
        frame.innerHTML='<span style="color:var(--muted);font-size:12.5px;padding:24px;">Bukti tidak tersedia.</span>';return;
      }
      var blob=await res.blob();var obj=URL.createObjectURL(blob);frame._objUrl=obj;
      if(ct.indexOf('pdf')>=0)frame.innerHTML='<iframe src="'+obj+'" style="width:100%;height:300px;border:none;"></iframe>';
      else frame.innerHTML='<img src="'+obj+'" alt="Bukti setor" style="max-width:100%;display:block;">';
    }catch(e){frame.innerHTML='<span style="color:var(--muted);font-size:12.5px;padding:24px;">Gagal memuat bukti.</span>';}
  }

