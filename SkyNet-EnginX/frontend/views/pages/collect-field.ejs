  function onPayInput(){var a=state.current;if(!a)return;var amt=Number(document.getElementById('payAmount').value)||0;var total=Number(a.amount_due)||0;
    var note=document.getElementById('partialNote');
    if(amt>0&&amt<total){note.style.display='block';note.textContent='Pembayaran sebagian. Sisa Rp'+(total-amt).toLocaleString('id-ID')+' akan ditagih bulan depan.';}
    else note.style.display='none';}
  var _payBusy=false;
  async function submitPay(){
    if(_payBusy)return; // cegah double-submit (tap ganda)
    if(!state.current||!state.current.id){toast('Data tugas tidak ditemukan. Tutup & buka ulang.');return;}
    var amt=Number(document.getElementById('payAmount').value)||0;
    if(amt<=0){toast('Masukkan jumlah pembayaran');return;}
    var total=Number(state.current.amount_due)||0;
    // Validasi nominal: lebih besar dari tagihan -> minta konfirmasi.
    if(total>0 && amt>total){
      var ok=window.confirm('Nominal '+rp(amt)+' melebihi tagihan '+rp(total)+'. Lanjutkan?');
      if(!ok)return;
    }
    // Pembayaran sebagian: konfirmasi sisa carry-over.
    if(total>0 && amt<total){
      var sisa=total-amt;
      var ok2=window.confirm('Pembayaran sebagian '+rp(amt)+'. Sisa '+rp(sisa)+' akan ditagih bulan depan. Lanjutkan?');
      if(!ok2)return;
    }
    _payBusy=true;
    var btn=document.getElementById('paySubmit');btn.innerHTML='<span class="spinner"></span>';btn.disabled=true;
    try{
      var fd=new FormData();
      fd.append('assignment_id',String(state.current.id));
      fd.append('amount',String(amt));
      fd.append('payment_date',document.getElementById('payDate').value||'');
      fd.append('notes',document.getElementById('payNote').value||'');
      fd.append('send_wa',document.getElementById('paySendWa').checked?'1':'0');
      if(payState.lat!=null&&payState.lng!=null){fd.append('pay_lat',String(payState.lat));fd.append('pay_lng',String(payState.lng));}
      if(payState.photo)fd.append('proof',payState.photo);
      var d=await api('/api/field/pay',{method:'POST',body:fd,isForm:true});
      if(d&&d.success){
        closeSheet('paySheet');
        loadTasks();loadMe();
        var cust=state.current||{};
        var partial=d.data&&d.data.partial;
        var carry=(d.data&&d.data.carry_over)||0;
        showOk({amount:amt,
                custName:(cust.customer&&cust.customer.name)||'',
                invoice:(cust.invoice&&cust.invoice.invoice_number)||'',
                partial:partial,carry:carry,
                wa:document.getElementById('paySendWa').checked});
      }
      else toast((d&&d.message)||'Gagal mencatat pembayaran');
    }catch(e){
      toast('Terjadi kesalahan: '+(e&&e.message?e.message:'tidak diketahui'));
    }finally{
      btn.innerHTML='Catat Pembayaran';btn.disabled=false;_payBusy=false;
    }
  }

