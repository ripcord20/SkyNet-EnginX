      '<button class="btn" style="width:100%;background:#fff;color:#c96a12;padding:13px;border-radius:13px;font-size:14px;font-weight:700;" onclick="openDeposit()">'+
        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg> Setor Kas Sekarang</button>'+
    '</div>';
    var deposits=d.data.deposits||[];
    depState.list=deposits;
    var DEPDOT={pending:'#e08a00',verified:'#0a9a5a',rejected:'#d63a3f'};
    var rows=deposits.length?('<div class="dep-sec-title">Riwayat Setoran</div>'+deposits.map(function(x,idx){
      var st=DEPST[x.status]||['?','b-assigned'];
      var dot=DEPDOT[x.status]||'#94a3b8';
      var sub=fmtDue(x.deposit_date)+' · Ekspektasi '+rp(x.expected_amount);
      if(x.variance && x.variance!==0){
        sub+=' · <span style="color:'+(x.variance<0?'#d63a3f':'#0a9a5a')+';font-weight:600;">'+(x.variance<0?'-':'+')+'Rp'+Math.abs(x.variance).toLocaleString('id-ID')+'</span>';
      }
      return '<div class="dep-item" onclick="openDepositDetail('+idx+')">'+
        '<div class="dep-item-ic"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></div>'+
        '<div style="flex:1;min-width:0;"><div class="dep-item-amt money">'+rp(x.deposited_amount)+'</div>'+
        '<div class="dep-item-sub">'+sub+'</div></div>'+
        '<div class="dep-item-right"><span class="dep-dot-badge" style="color:'+dot+';"><span class="d" style="background:'+dot+';"></span>'+st[0]+'</span>'+
        '<svg class="dep-item-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c2cbdc" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></div>'+
      '</div>';
    }).join('')):'<div class="empty">Belum ada setoran.</div>';
    list.innerHTML=header+rows;
