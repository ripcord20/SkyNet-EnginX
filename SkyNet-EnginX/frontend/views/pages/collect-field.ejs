    else toast((d&&d.message)||'Gagal mengubah sandi');
  }
  var PF_MONTHS=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
  async function loadPerformance(){
    var box=document.getElementById('pfPerfBody');
    box.innerHTML='<div class="empty">Memuat…</div>';
    var d=await api('/api/field/performance');
    if(!d||!d.success){box.innerHTML='<div class="empty">Gagal memuat performa.</div>';return;}
    var t=d.data.totals||{};
    var schemeTxt=d.data.commission_type==='percent'?(d.data.commission_value+'% dari nominal')
      :d.data.commission_type==='none'?'Tanpa komisi'
      :('Rp'+(d.data.commission_value||0).toLocaleString('id-ID')+' / invoice lunas');
    var html='<div class="perf-hero"><div class="l">Total Berhasil Ditagih</div>'+
      '<div class="v money">'+rp(t.collected)+'</div>'+
      '<div style="font-size:11.5px;opacity:.85;margin-top:4px;">'+(t.paid_count||0)+' invoice lunas dari '+(t.total_task||0)+' tugas</div></div>'+
      '<div class="perf-grid">'+
        '<div class="perf-c rate"><div class="l">Success Rate</div><div class="v">'+(t.success_rate||0)+'%</div></div>'+
        '<div class="perf-c comm"><div class="l">Estimasi Komisi</div><div class="v money">'+rp(t.commission)+'</div></div>'+
        '<div class="perf-c cash"><div class="l">Cash di Tangan</div><div class="v money">'+rp(t.cash_on_hand)+'</div></div>'+
        '<div class="perf-c"><div class="l">Tugas Aktif</div><div class="v">'+(t.open_count||0)+'</div></div>'+
      '</div>'+
      '<div style="font-size:11.5px;color:var(--muted);margin:-4px 0 14px;">Skema komisi: '+esc(schemeTxt)+'</div>';
    var monthly=d.data.monthly||[];
    if(monthly.length){
      html+='<div class="perf-mtitle">Performa per Bulan</div>';
      html+=monthly.map(function(m){
        return '<div class="perf-row"><div><div class="m">'+(PF_MONTHS[m.month-1]||m.month)+' '+m.year+'</div>'+
          '<div class="sub">'+(m.paid_count||0)+' lunas · '+rp(m.collected)+'</div></div>'+
          '<div class="cm money">'+rp(m.commission)+'</div></div>';
      }).join('');
    }
    box.innerHTML=html;
  }

  /* ─── sheet ─── */
  function openSheet(id){document.getElementById(id).classList.add('show');document.body.style.overflow='hidden';document.body.classList.add('sheet-open');}
  function closeSheet(id){document.getElementById(id).classList.remove('show');document.body.style.overflow='';document.body.classList.remove('sheet-open');}
  document.querySelectorAll('.sheet-overlay').forEach(o=>o.addEventListener('click',e=>{if(e.target===o)closeSheet(o.id);}));

  document.getElementById('btnMenu').addEventListener('click',openDrawer);
  document.getElementById('btnLogout').addEventListener('click',doLogout);
  document.getElementById('hdrAvatar').addEventListener('click',openProfile);

  /* ─── Pull to refresh ─── */
  (function(){
    var ptr=document.getElementById('ptr');
    var startY=0, pulling=false, dist=0, THRESHOLD=70, refreshing=false;
    function atTop(){return (window.scrollY||window.pageYOffset||0)<=0;}
    function sheetOpen(){return document.body.classList.contains('sheet-open');}
    window.addEventListener('touchstart',function(e){
      if(refreshing||sheetOpen()||!atTop()){pulling=false;return;}
      startY=e.touches[0].clientY;pulling=true;dist=0;
    },{passive:true});
    window.addEventListener('touchmove',function(e){
      if(!pulling||refreshing)return;
      dist=e.touches[0].clientY-startY;
      if(dist>0){
        var pull=Math.min(dist*0.5,90);
        ptr.style.transform='translate(-50%,'+(pull-46)+'px)';
        ptr.classList.add('show');
        if(dist>=THRESHOLD)ptr.classList.add('spin');else ptr.classList.remove('spin');
      }
    },{passive:true});
    window.addEventListener('touchend',function(){
      if(!pulling||refreshing){pulling=false;return;}
      pulling=false;
      if(dist>=THRESHOLD){
        refreshing=true;
        ptr.classList.add('spin');ptr.style.transform='translate(-50%,14px)';
        Promise.resolve(refreshAll()).finally(function(){
          setTimeout(function(){
            ptr.classList.remove('show','spin');
            ptr.style.transform='translate(-50%,-46px)';
            refreshing=false;
          },500);
        });
      }else{
        ptr.classList.remove('show','spin');
        ptr.style.transform='translate(-50%,-46px)';
      }
    },{passive:true});
  })();

  /* init */
  loadMe();loadTasks();
  </script>
</body>
</html>
