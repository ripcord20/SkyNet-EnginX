// ── Detail pembayaran untuk invoice yang sudah lunas ─────────────
function renderPaidDetail(data) {
  const detail = document.getElementById('payPaidDetail');
  if (!detail) return;
  const payments = Array.isArray(data.payments) ? data.payments : [];
  // Ambil pembayaran terbaru (list sudah ORDER BY payment_date DESC dari backend).
  const last = payments.length ? payments[0] : null;
  if (!last) { detail.style.display = 'none'; return; }

  const setTxt = function (id, val) { const el = document.getElementById(id); if (el) el.textContent = val; };
  setTxt('paidOnDate', fmtDateInv(last.payment_date));
  setTxt('paidVia', last.method_label || '-');

  if (last.reference_number) {
    document.getElementById('paidRefRow').style.display = 'flex';
    setTxt('paidRef', last.reference_number);
  }

  const totalPaid = (typeof data.total_paid === 'number')
    ? data.total_paid
    : payments.reduce(function (s, p) { return s + (p.amount || 0); }, 0);
  setTxt('paidAmount', fmtRpInv(totalPaid || last.amount));

  detail.style.display = 'block';
}

// ── Render daftar Riwayat Tagihan (invoice history 1 tahun) ──
const INV_MONTHS = ['','Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
const INV_STATUS_STYLE = {
  paid:      { bg:'#dcfce7', color:'#15803d' },
  unpaid:    { bg:'#fef9c3', color:'#a16207' },
  overdue:   { bg:'#fee2e2', color:'#b91c1c' },
  cancelled: { bg:'#f1f5f9', color:'#64748b' }
};
function renderInvoiceHistory(history) {
  const card = document.getElementById('invHistoryCard');
  const list = document.getElementById('invHistoryList');
  const cnt  = document.getElementById('invHistoryCount');
  if (!card || !list) return;
  if (!history.length) { card.style.display = 'none'; return; }
  if (cnt) cnt.textContent = history.length + ' tagihan';

  const statusIcon = function (key) {
    if (key === 'paid')
      return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="8 12 11 15 16 9"/></svg>';
    if (key === 'overdue')
      return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
    if (key === 'cancelled')
      return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
    return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#a16207" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>';
  };

  const rows = history.map(function (h) {
    const st = INV_STATUS_STYLE[h.status] || INV_STATUS_STYLE.unpaid;
    const periode = (INV_MONTHS[h.period_month] || h.period_month) + ' ' + h.period_year;
    const isCur = h.is_current === true;
    const curBadge = isCur
      ? '<span class="ih-cur-badge">TAGIHAN INI</span>' : '';
    const viewBtn = '<button class="ih-detail-btn" onclick="pubOpenInvoice(\'' + h.token + '\')">Invoice</button>';
    const payBtn = (h.payable === true)
      ? '<button class="ih-pay-btn" onclick="pubGoPay(\'' + h.token + '\')">Bayar</button>'
      : '';
    const action = '<div class="ih-actions">' + payBtn + viewBtn + '</div>';
    return '<div class="ih-row' + (isCur ? ' is-current' : '') + '">' +
      '<div class="ih-c ih-c-inv" data-lbl="Invoice ID"><span class="ih-inv-num">' + (h.invoice_number || '-') + '</span>' + curBadge + '</div>' +
      '<div class="ih-c ih-c-status" data-lbl="Status"><span class="ih-status" style="color:' + st.color + ';">' + statusIcon(h.status) + ' ' + h.status_label + '</span></div>' +
      '<div class="ih-c ih-c-period" data-lbl="Periode">' + periode + '</div>' +
      '<div class="ih-c ih-c-amount" data-lbl="Jumlah">' + fmtRpInv(h.total) + '</div>' +
      '<div class="ih-c ih-c-action">' + action + '</div>' +
    '</div>';
  }).join('');

  list.innerHTML =
    '<div class="ih-table">' +
      '<div class="ih-head">' +
        '<div class="ih-c ih-c-inv">Invoice ID</div>' +
        '<div class="ih-c ih-c-status">Status</div>' +
        '<div class="ih-c ih-c-period">Periode</div>' +
        '<div class="ih-c ih-c-amount">Jumlah</div>' +
        '<div class="ih-c ih-c-action"></div>' +
      '</div>' +
      rows +
    '</div>';
  card.style.display = 'block';
}
// Var global menyimpan data invoice yang sedang dibuka (untuk modal default)
let PUB_CURRENT_DATA = null;

// Tombol "Bayar" di Riwayat Tagihan → buka halaman pembayaran publik untuk
// invoice periode tsb. Kalau token = invoice yang sedang dibuka, cukup scroll
// ke kartu pembayaran; selain itu navigasi ke /pub/invoice/<token>.
function pubGoPay(token) {
  if (!token) return;
  if (token === window.PUBLIC_TOKEN) {
    const card = document.getElementById('payActionCard');
    if (card && card.style.display !== 'none') {
      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
  }
  window.location.href = '/pub/invoice/' + encodeURIComponent(token);
}

// Buka tampilan invoice (modal) untuk invoice tertentu dari Riwayat Tagihan.
// Status PAID/UNPAID otomatis tercermin di header invoice (InvoiceRenderer).
async function pubOpenInvoice(token) {
  if (!token) return;
  const modal   = document.getElementById('invModal');
  const wrap    = document.getElementById('invoiceWrapModal');
  const loading = document.getElementById('invModalLoading');
  modal.style.display = 'flex';
  wrap.style.display = 'none';
  loading.style.display = 'block';
  document.body.style.overflow = 'hidden';
  try {
    let data;
    // Kalau token = invoice yang sedang dibuka, pakai data yang sudah ada (hemat request)
    if (PUB_CURRENT_DATA && token === window.PUBLIC_TOKEN) {
      data = PUB_CURRENT_DATA;
    } else {
      const r = await fetch('/api/pub/invoice/' + encodeURIComponent(token) + '/data');
      const j = await r.json();
      if (!j.success) {
        loading.innerHTML = '<p style="color:#dc2626;font-size:13px;">Gagal memuat invoice.</p>';
        return;
      }
      data = j.data;
    }
    InvoiceRenderer.render('#invoiceWrapModal', data, window.INVTPL);
    loading.style.display = 'none';
    wrap.style.display = 'block';
  } catch (e) {
    loading.innerHTML = '<p style="color:#dc2626;font-size:13px;">Error: ' + e.message + '</p>';
  }
}
function pubCloseInvoice() {
  document.getElementById('invModal').style.display = 'none';
  document.body.style.overflow = '';
}
function pubPrintInvoice() {
  // Print hanya area invoice modal
  document.body.classList.add('printing-modal');
  window.print();
  setTimeout(function () { document.body.classList.remove('printing-modal'); }, 500);
}

// ── Populate info box (Customer / Service / Invoice / Periode / Total) ──
function populatePayInfo(data) {
  const set = function (id, val) { const el = document.getElementById(id); if (el) el.textContent = val; };
  const periodeStr = (INV_MONTHS[data.period_month] || data.period_month || '') + ' ' + (data.period_year || '');
  set('payCustomerName', data.cust_name || '—');
  set('payServiceName',  data.pkg_name || '—');
  set('payInvNum',       data.invoice_number || '—');
  set('payPeriod',       periodeStr.trim() || '—');

  const subtotal = parseFloat(data.invoice_subtotal || 0);
  const tax      = parseFloat(data.invoice_tax || 0);
  const total    = parseFloat(data.invoice_total || data.amount || 0);
  if (tax > 0) {
    document.getElementById('payRowSubtotal').style.display = 'flex';
    document.getElementById('payRowTax').style.display = 'flex';
    set('paySubtotal', fmtRpInv(subtotal));
    const taxLbl = (data.tax_label || 'PPN') + (data.tax_rate ? ' (' + data.tax_rate + '%)' : '');
    set('payTaxLbl', taxLbl);
    set('payTax', fmtRpInv(tax));
  }
  set('payTotal', fmtRpInv(total));
}

