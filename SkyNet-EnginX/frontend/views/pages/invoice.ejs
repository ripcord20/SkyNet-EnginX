<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'Invoice' %> - <%= appName %></title>
<%
  // Template settings (defaults if not configured yet)
  const t = (typeof tpl === 'object' && tpl) ? tpl : {};
  const tplVars = {
    primary_color:    t.primary_color || '#1a6ef5',
    accent_color:     t.accent_color  || '#1d4ed8',
    text_color:       t.text_color    || '#0f172a',
    font_family:      t.font_family   || 'Inter',
    header_style:     t.header_style  || 'banner',
    show_logo:        t.show_logo,
    logo_url:         t.logo_url || '',
    company_name:     t.company_name    || '',
    company_tagline:  t.company_tagline || '',
    company_address:  t.company_address || '',
    company_phone:    t.company_phone   || '',
    company_email:    t.company_email   || '',
    show_subtotal:       t.show_subtotal,
    show_tax:            t.show_tax,
    show_due_date:       t.show_due_date,
    show_payment_method: t.show_payment_method,
    show_active_until:   t.show_active_until,
    show_bank_info:      t.show_bank_info,
    show_signature:      t.show_signature,
    invoice_label:           t.invoice_label || 'INVOICE',
    section_recipient_label: t.section_recipient_label || 'TAGIHAN UNTUK',
    section_detail_label:    t.section_detail_label    || 'DETAIL INVOICE',
    thank_you_text:          t.thank_you_text || '',
    footer_text:             t.footer_text    || ''
  };
%>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  * { box-sizing:border-box; margin:0; padding:0; }
  body {
    font-family: '<%= tplVars.font_family %>', -apple-system, BlinkMacSystemFont, sans-serif;
    background:#f0f4f8; color:#1e293b; min-height:100vh; padding:20px;
  }

  /* ── Action bar ── */
  .action-bar {
    max-width:780px; margin:0 auto 16px;
    display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;
  }
  .action-bar a, .action-bar button {
    display:inline-flex; align-items:center; gap:6px;
    padding:8px 16px; border-radius:8px; font-size:13px; font-weight:600;
    cursor:pointer; text-decoration:none; border:none; font-family:inherit; transition:all .15s;
  }
  .btn-back  { background:#fff; border:1px solid #e2e8f0; color:#64748b; }
  .btn-back:hover { background:#f1f5f9; }
  .btn-print { background: <%= tplVars.primary_color %>; color:#fff; }
  .btn-print:hover { filter: brightness(0.92); }
  .btn-wa    { background:#16a34a; color:#fff; }
  .btn-wa:hover { background:#15803d; }
  .btn-wa.sent { background:#64748b; cursor:default; opacity:.8; }

  /* ── Invoice card wrapper ── */
  .invoice-wrap {
    max-width:780px; margin:0 auto; background:#fff;
    border-radius:16px; overflow:hidden; box-shadow:0 4px 32px rgba(0,0,0,.10);
  }

  /* ── Loading & alert ── */
  .alert-box {
    max-width:780px; margin:0 auto 16px;
    padding:14px 18px; border-radius:10px; font-size:13px; font-weight:500;
    display:flex; align-items:center; gap:10px;
  }
  .alert-err { background:#fef2f2; color:#991b1b; border:1.5px solid #fca5a5; }

  .loading-state {
    max-width:780px; margin:0 auto; padding:80px 20px; text-align:center;
    background:#fff; border-radius:16px; color:#94a3b8;
  }
  .loading-state svg { width:40px; height:40px; margin:0 auto 12px; animation:invSpin 1s linear infinite; }
  @keyframes invSpin { to { transform:rotate(360deg); } }

  /* ── Print styles ── */
  /* ── Invoice viewer modal ── */
  .inv-modal-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px;}
  #invModal .invoice-wrap{max-width:none;margin:0;}

  @media print {
    body { padding:0; background:#fff; }
    .action-bar, #alertWrap, .preview-ribbon { display:none !important; }
    .invoice-wrap { max-width:none; box-shadow:none; border-radius:0; margin:0; }
    /* Saat print dari modal "Lihat Invoice": sembunyikan semua kecuali invoice modal */
    body.printing-modal > *:not(#invModal){ display:none !important; }
    body.printing-modal #invModal{ position:static !important; background:#fff !important; padding:0 !important; display:block !important; overflow:visible !important; }
    body.printing-modal #invModal .inv-modal-bar{ display:none !important; }
    body.printing-modal #invModal #invoiceWrapModal{ box-shadow:none; border-radius:0; }
  }
  /* ── Payment method card (identik portal pelanggan) ── */
  .pm-card{max-width:780px;margin:0 auto;background:#fff;border-radius:16px;box-shadow:0 4px 32px rgba(0,0,0,.10);padding:22px;}
  /* Di dalam panel publik (#payPanel flex-column), kartu harus selalu
     mengisi penuh lebar kolom — bukan menyusut mengikuti isi. Auto-margin
     pada flex item membatalkan stretch & membuat kartu mengecil saat
     metode transfer manual dihapus. Override di sini menjaga lebar konsisten. */
  #payPanel{width:100%;}
  #payPanel > .pm-card{max-width:none;width:100%;margin:0 0 16px;align-self:stretch;box-sizing:border-box;}
  .pm-card-title{font-size:17px;font-weight:800;margin-bottom:18px;color:#0f172a;}
  .pm-info-box{background:#f8fafc;border-radius:14px;padding:14px 16px;margin-bottom:16px;}
  .pm-info-row{display:flex;justify-content:space-between;margin-bottom:8px;font-size:12.5px;gap:12px;}
  .pm-info-row:last-child{margin-bottom:0;}
  .pm-info-row .lbl{color:#64748b;}
  .pm-info-row .val{font-weight:700;color:#0f172a;text-align:right;}
  .pm-info-total{border-top:1px dashed #e2e8f0;padding-top:10px;margin-top:4px;}
  .pm-info-total .val{font-size:16px;font-weight:800;color:#2563eb;}
  .pm-heading{font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.5px;margin:6px 0 10px;}
  .pm-group{border:1px solid #e2e8f0;border-radius:14px;margin-bottom:10px;overflow:hidden;background:#fff;}
  .pm-group-head{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;user-select:none;transition:background .15s;}
  .pm-group-head:hover{background:#f8fafc;}
  .pm-group-head.open{background:#eff6ff;}
  .pm-group-ico{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#2563eb,#1d4ed8);display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;}
  .pm-group-ico.is-ewallet{background:linear-gradient(135deg,#1d4ed8,#1e3a8a);}
  .pm-group-ico.is-qris{background:linear-gradient(135deg,#f59e0b,#d97706);}
  .pm-group-ico.is-gw-active{background:linear-gradient(135deg,#06b6d4,#0891b2);box-shadow:0 4px 12px rgba(6,182,212,.35);}
  .pm-gw-card{margin-bottom:14px;border:2px solid #06b6d4!important;background:linear-gradient(135deg,#ecfeff,#cffafe)!important;position:relative;overflow:hidden;}
  .pm-gw-card:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(6,182,212,.22);transition:all .2s;}
  .pm-gw-badge{display:inline-block;background:#06b6d4;color:#fff;font-size:9px;font-weight:800;padding:1px 7px;border-radius:8px;margin-left:5px;letter-spacing:.4px;vertical-align:1px;}
  .pm-gw-arrow{color:#0891b2;flex-shrink:0;}
  .pm-group-text{flex:1;min-width:0;}
  .pm-group-title{font-size:13px;font-weight:700;color:#0f172a;}
  .pm-group-sub{font-size:11px;color:#64748b;margin-top:2px;}
  .pm-group-count{padding:2px 8px;border-radius:20px;background:#e2e8f0;color:#64748b;font-size:10px;font-weight:700;}
  .pm-group-chev{color:#64748b;transition:transform .25s;flex-shrink:0;}
  .pm-group-head.open .pm-group-chev{transform:rotate(180deg);}
  .pm-group-body{max-height:0;overflow:hidden;transition:max-height .3s ease;}
  .pm-group-head.open + .pm-group-body{max-height:2000px;}
  .pm-group-inner{padding:4px 10px 10px;}
  .pm-divider{display:flex;align-items:center;gap:10px;margin:14px 2px 10px;color:#64748b;font-size:11px;font-weight:600;}
  .pm-divider::before,.pm-divider::after{content:'';flex:1;height:1px;background:#e2e8f0;}
  .pm-divider span{padding:0 4px;text-transform:uppercase;letter-spacing:.6px;}
  .pm-item{padding:12px;border-radius:11px;margin-bottom:8px;background:#f8fafc;border:1.5px solid transparent;transition:all .15s;}
  .pm-item:last-child{margin-bottom:0;}
  .pm-item-row{display:flex;align-items:center;gap:11px;}
  .pm-logo{width:40px;height:40px;border-radius:8px;background:#fff;border:1px solid #e2e8f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:800;font-size:10px;color:#0f172a;letter-spacing:.3px;text-align:center;line-height:1;padding:0 2px;overflow:hidden;}
  .pm-logo img{max-width:100%;max-height:100%;object-fit:contain;}
  .pm-detail{flex:1;min-width:0;}
  .pm-name{font-size:13px;font-weight:700;color:#0f172a;}
  .pm-number{font-size:14px;font-weight:700;color:#2563eb;letter-spacing:.5px;margin-top:3px;word-break:break-all;}
  .pm-owner{font-size:11px;color:#64748b;margin-top:2px;}
  .pm-copy-btn{padding:8px 12px;border-radius:9px;background:#2563eb;color:#fff;border:none;font-size:11px;font-weight:700;font-family:inherit;cursor:pointer;display:flex;align-items:center;gap:5px;flex-shrink:0;transition:all .15s;}
  .pm-copy-btn:hover{background:#1d4ed8;}
  .pm-copy-btn.copied{background:#10b981;}
  .pm-copy-btn svg{width:13px;height:13px;}
  .pm-qris-box{background:#fff;border-radius:12px;padding:16px;text-align:center;}
  .pm-qris-box img{max-width:220px;width:100%;height:auto;border-radius:8px;}
  .pm-qris-hint{font-size:11px;color:#64748b;margin-top:10px;line-height:1.5;}
  .pm-empty{text-align:center;padding:28px 20px;color:#64748b;font-size:12.5px;background:#f8fafc;border-radius:12px;margin-bottom:14px;}
  .pm-empty svg{width:36px;height:36px;margin:0 auto 10px;display:block;opacity:.5;}
  .pm-warn{background:#fffbeb;border:1px solid #fde68a;border-radius:12px;padding:11px 14px;margin-top:10px;margin-bottom:14px;display:flex;gap:10px;align-items:flex-start;}
  .pm-warn svg{width:16px;height:16px;color:#d97706;flex-shrink:0;margin-top:1px;}
  .pm-warn-text{font-size:11.5px;color:#78350f;line-height:1.55;}
  .pm-warn-text b{color:#92400e;}
  .pm-wa-btn{width:100%;padding:13px;border:none;border-radius:12px;background:linear-gradient(135deg,#25D366,#128C7E);color:#fff;font-size:14px;font-weight:700;font-family:inherit;cursor:pointer;transition:opacity .15s;display:flex;align-items:center;justify-content:center;gap:8px;}
  .pm-wa-btn:hover{opacity:.92;}
  .pm-wa-btn:disabled{opacity:.5;cursor:not-allowed;}
  .pm-wa-btn svg{width:18px;height:18px;}
  /* ── Riwayat Tagihan: tabel responsif (desktop) / kartu (mobile) ── */
  .ih-table{width:100%;}
  .ih-head{display:flex;align-items:center;padding:10px 8px;border-bottom:2px solid #f1f5f9;font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.4px;}
  .ih-row{display:flex;align-items:center;padding:14px 8px;border-bottom:1px solid #f1f5f9;transition:background .12s;}
  .ih-row:hover{background:#f8fafc;}
  .ih-row.is-current{background:#f8fafc;}
  .ih-c{padding:0 6px;min-width:0;}
  .ih-c-inv{flex:1.4;font-size:13px;font-weight:600;color:#0f172a;display:flex;align-items:center;flex-wrap:wrap;gap:6px;}
  .ih-c-status{flex:1.3;}
  .ih-c-period{flex:1;font-size:13px;color:#475569;}
  .ih-c-amount{flex:1;font-size:13px;font-weight:700;color:#0f172a;}
  .ih-c-action{flex:1.1;text-align:right;}
  .ih-inv-num{font-family:'DM Mono',monospace;font-size:12.5px;}
  .ih-cur-badge{font-size:9.5px;font-weight:700;color:#2563eb;background:#dbeafe;padding:2px 7px;border-radius:6px;}
  .ih-status{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:600;}
  .ih-actions{display:flex;gap:8px;justify-content:flex-end;align-items:center;}
  .ih-detail-btn{padding:7px 16px;border-radius:8px;background:#fff;color:#334155;border:1.5px solid #e2e8f0;font-size:12px;font-weight:700;font-family:inherit;cursor:pointer;transition:all .15s;}
  .ih-detail-btn:hover{background:#f8fafc;border-color:#cbd5e1;}
  .ih-pay-btn{padding:7px 16px;border-radius:8px;background:#16a34a;color:#fff;border:1.5px solid #16a34a;font-size:12px;font-weight:700;font-family:inherit;cursor:pointer;transition:background .15s;}
  .ih-pay-btn:hover{background:#15803d;border-color:#15803d;}
  .ih-detail-disabled{font-size:11.5px;color:#94a3b8;font-weight:600;}
  @media (max-width:640px){
    .ih-head{display:none;}
    .ih-row{flex-wrap:wrap;gap:4px 0;padding:14px 4px;}
    .ih-c{flex:none!important;width:100%;padding:1px 0;display:flex;justify-content:space-between;align-items:center;}
    .ih-c::before{content:attr(data-lbl);font-size:11px;color:#94a3b8;font-weight:600;}
    .ih-c-inv{order:1;}
    .ih-c-status{order:2;}
    .ih-c-period{order:3;}
    .ih-c-amount{order:4;}
    .ih-c-amount::before{content:'Jumlah';}
    .ih-c-action{order:5;width:100%;text-align:left;margin-top:8px;}
    .ih-c-action::before{content:'';}
    .ih-actions{width:100%;}
    .ih-detail-btn,.ih-pay-btn{flex:1;padding:11px;}
  }
</style>
</head>
<body>

<!-- Action bar -->
<div class="action-bar" id="actionBar" style="display:none;">
  <button type="button" class="btn-back" onclick="closeInvoiceWindow()" title="Tutup tab ini">
    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    Tutup
  </button>
  <div style="display:flex;gap:8px;">
    <button class="btn-wa" id="btnSendWa" onclick="sendInvoiceWa()">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
      <span id="btnSendWaText">Kirim via WA</span>
    </button>
    <button class="btn-print" onclick="window.print()">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Print / Save PDF
    </button>
  </div>
</div>

<div id="alertWrap"></div>

<!-- Loading -->
<div class="loading-state" id="invLoading">
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="#94a3b8" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
  <p>Memuat invoice...</p>
</div>

<!-- Invoice wrapper (rendered by shared renderer) -->
<div class="invoice-wrap" id="invoiceWrap" style="display:none;"></div>

<!-- ── PUBLIC PAYMENT PANEL (hanya muncul di public mode) ───────────── -->
<div id="payPanel" style="display:none;max-width:780px;margin:16px auto 0;flex-direction:column;">

  <!-- Header branding (judul di atas rincian tagihan) -->
  <div id="payBrandHeader" style="order:0;background:#fff;border-radius:16px;box-shadow:0 4px 32px rgba(0,0,0,.10);padding:20px 22px;margin-bottom:16px;display:flex;align-items:center;gap:16px;">
    <img id="payBrandLogoImg" src="" alt="logo" style="display:none;height:48px;max-width:240px;width:auto;object-fit:contain;flex-shrink:0;">
    <div id="payBrandText" style="min-width:0;flex:1;">
      <div id="payBrandName" style="font-size:18px;font-weight:800;color:#0f172a;line-height:1.2;">—</div>
      <div id="payBrandTagline" style="font-size:12.5px;color:#64748b;margin-top:3px;">Internet Service Provider</div>
    </div>
  </div>


  <!-- List pembayaran -->
  <div id="payHistoryCard" style="display:none;order:3;background:#fff;border-radius:16px;box-shadow:0 4px 32px rgba(0,0,0,.10);padding:20px 22px;margin-bottom:16px;">
    <div style="font-size:13px;font-weight:700;color:#0f172a;text-transform:uppercase;letter-spacing:.4px;margin-bottom:14px;display:flex;align-items:center;gap:8px;">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
      Riwayat Pembayaran
    </div>
    <div id="payHistoryList"></div>
  </div>

  <!-- Riwayat Tagihan (invoice history 1 tahun) -->
  <div id="invHistoryCard" style="display:none;order:2;background:#fff;border-radius:16px;box-shadow:0 4px 32px rgba(0,0,0,.10);padding:20px 22px;margin-bottom:16px;">
    <div style="font-size:13px;font-weight:700;color:#0f172a;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between;gap:8px;">
      <span style="display:flex;align-items:center;gap:8px;">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
        Riwayat Tagihan
      </span>
      <span id="invHistoryCount" style="font-size:11.5px;font-weight:600;color:#94a3b8;text-transform:none;letter-spacing:0;"></span>
    </div>
    <div id="invHistoryList" style="margin-top:8px;"></div>
  </div>

  <!-- ── Kartu Pembayaran (gaya identik portal pelanggan) ── -->
  <div id="payActionCard" class="pm-card" style="display:none;order:1;margin-bottom:16px;">
    <div class="pm-card-title">Rincian Tagihan</div>

    <!-- Info invoice -->
    <div class="pm-info-box">
      <div class="pm-info-row">
        <span class="lbl">Customer</span>
        <span class="val" id="payCustomerName">—</span>
      </div>
      <div class="pm-info-row">
        <span class="lbl">Service Package</span>
        <span class="val" id="payServiceName">—</span>
      </div>
      <div class="pm-info-row">
        <span class="lbl">Invoice</span>
        <span class="val" id="payInvNum">—</span>
      </div>
      <div class="pm-info-row">
        <span class="lbl">Periode</span>
        <span class="val" id="payPeriod">—</span>
      </div>
      <div class="pm-info-row" id="payRowSubtotal" style="display:none;">
        <span class="lbl">Subtotal</span>
        <span class="val" id="paySubtotal">Rp 0</span>
      </div>
      <div class="pm-info-row" id="payRowTax" style="display:none;">
        <span class="lbl" id="payTaxLbl">PPN</span>
        <span class="val" id="payTax" style="color:#0d9488;">Rp 0</span>
      </div>
      <div class="pm-info-row pm-info-total">
        <span class="lbl" style="font-size:13px;font-weight:700;color:#0f172a;">Total</span>
        <span class="val" id="payTotal">Rp 0</span>
      </div>
    </div>

    <div class="pm-heading" id="pmHeading">Transfer / Bayar ke:</div>

    <!-- Accordion groups diisi dari JS -->
    <div id="payAccordion"></div>

    <!-- Info footer -->
    <div class="pm-warn" id="pmWarn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div class="pm-warn-text">
        <b>Setelah transfer</b>, klik tombol <b>WhatsApp</b> di bawah untuk konfirmasi. Kirim bukti transfer agar pembayaran segera diverifikasi.
      </div>
    </div>

    <!-- WA confirm button -->
    <button class="pm-wa-btn" id="btnConfirmPay" onclick="pubConfirmManual()">
