function renderPaymentAccordion(cfg) {
  let methods = (cfg && Array.isArray(cfg.payment_accounts)) ? cfg.payment_accounts : [];
  methods = methods.filter(function (m) { return m && m.is_active !== false; });

  const banks    = methods.filter(function (m) { return m.type === 'bank'; });
  const ewallets = methods.filter(function (m) { return m.type === 'ewallet'; });
  const qrisList = methods.filter(function (m) { return m.type === 'qris'; });
  const gwActive = !!(cfg && cfg.gateway_enabled);

  const container = document.getElementById('payAccordion');
  let html = '';

  // GROUP 1: Bayar Online (gateway)
  if (gwActive) {
    html += '<div class="pm-group pm-gw-card" onclick="pubPayOnline()" style="cursor:pointer">' +
      '<div class="pm-group-head pm-gw-head" style="cursor:pointer">' +
        '<div class="pm-group-ico is-gw-active">' +
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>' +
        '</div>' +
        '<div class="pm-group-text">' +
          '<div class="pm-group-title">Bayar Online <span class="pm-gw-badge">Otomatis</span></div>' +
          '<div class="pm-group-sub">VA, QRIS, E-Wallet, Kartu Kredit · langsung lunas</div>' +
        '</div>' +
        '<svg class="pm-gw-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"/></svg>' +
      '</div>' +
    '</div>';
  }

  const hasManual = banks.length || ewallets.length || qrisList.length;
  if (hasManual) {
    if (gwActive) html += '<div class="pm-divider"><span>atau transfer manual</span></div>';
  } else if (!gwActive) {
    html += '<div class="pm-empty">' +
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>' +
      'Metode pembayaran belum tersedia.<br>Hubungi admin via WhatsApp untuk info pembayaran.' +
      '</div>';
  }

  if (banks.length) {
    html += pubBuildGroup({
      icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3"/></svg>',
      title: 'Transfer Bank', sub: 'BCA, BRI, Mandiri, SeaBank, dll',
      items: banks, labelMap: PM_BANK_LABELS, iconClass: ''
    });
  }
  if (ewallets.length) {
    html += pubBuildGroup({
      icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="13" rx="2"/><path d="M2 10h20M16 15h3"/></svg>',
      title: 'E-Wallet', sub: 'DANA, OVO, GoPay, ShopeePay',
      items: ewallets, labelMap: PM_EWALLET_LABELS, iconClass: 'is-ewallet'
    });
  }
  if (qrisList.length) html += pubBuildGroupQris(qrisList[0]);

  container.innerHTML = html;

  // Accordion toggle
  container.querySelectorAll('.pm-group-head:not(.pm-gw-head)').forEach(function (head) {
    head.addEventListener('click', function () {
      const wasOpen = head.classList.contains('open');
      container.querySelectorAll('.pm-group-head').forEach(function (h) { h.classList.remove('open'); });
      if (!wasOpen) head.classList.add('open');
    });
  });
  if (!gwActive) {
    const firstHead = container.querySelector('.pm-group-head:not(.pm-gw-head)');
    if (firstHead) firstHead.classList.add('open');
  }

  // WA confirm & warning hanya muncul kalau ada metode manual
  const btnWa = document.getElementById('btnConfirmPay');
  const warnEl = document.getElementById('pmWarn');
  if (btnWa)  btnWa.style.display  = hasManual ? 'flex' : 'none';
  if (warnEl) warnEl.style.display = hasManual ? 'flex' : 'none';
  const heading = document.getElementById('pmHeading');
  if (heading) heading.style.display = (gwActive || hasManual) ? 'block' : 'none';
}

function pubBuildGroup(opts) {
  let itemsHtml = '';
  opts.items.forEach(function (m) {
    const label = (opts.labelMap && opts.labelMap[(m.provider || '').toLowerCase()]) || (m.provider || '').toUpperCase() || '—';
    const logo  = m.logo_url
      ? '<img src="' + pubEscapeHtml(m.logo_url) + '" alt="' + pubEscapeHtml(label) + '" onerror="this.outerHTML=\'' + pubEscapeHtml(label) + '\'">'
      : pubEscapeHtml(label);
    const num   = m.account_number || '—';
    const owner = m.account_owner || '';
    itemsHtml +=
      '<div class="pm-item"><div class="pm-item-row">' +
        '<div class="pm-logo">' + logo + '</div>' +
        '<div class="pm-detail">' +
          '<div class="pm-name">' + pubEscapeHtml(label) + '</div>' +
          '<div class="pm-number">' + pubEscapeHtml(num) + '</div>' +
          (owner ? '<div class="pm-owner">a.n. ' + pubEscapeHtml(owner) + '</div>' : '') +
        '</div>' +
        '<button class="pm-copy-btn" onclick="pubCopyAccount(this, \'' + pubJsEsc(num) + '\')">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>' +
          '<span>Salin</span>' +
        '</button>' +
      '</div></div>';
  });
  return '<div class="pm-group">' +
    '<div class="pm-group-head">' +
      '<div class="pm-group-ico ' + (opts.iconClass || '') + '">' + opts.icon + '</div>' +
      '<div class="pm-group-text">' +
        '<div class="pm-group-title">' + pubEscapeHtml(opts.title) + '</div>' +
        '<div class="pm-group-sub">' + pubEscapeHtml(opts.sub) + '</div>' +
      '</div>' +
      '<span class="pm-group-count">' + opts.items.length + '</span>' +
      '<svg class="pm-group-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>' +
    '</div>' +
    '<div class="pm-group-body"><div class="pm-group-inner">' + itemsHtml + '</div></div>' +
  '</div>';
}

function pubBuildGroupQris(m) {
  const imgHtml = m && m.logo_url
    ? '<img src="' + pubEscapeHtml(m.logo_url) + '" alt="QRIS">'
    : '<div style="padding:40px 20px;color:#64748b;font-size:12px">QR code belum di-upload di admin</div>';
  const owner = m && m.account_owner ? m.account_owner : '';
  return '<div class="pm-group">' +
    '<div class="pm-group-head">' +
      '<div class="pm-group-ico is-qris">' +
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h2M14 17h5M14 20h3M17 14h4"/></svg>' +
      '</div>' +
      '<div class="pm-group-text">' +
        '<div class="pm-group-title">QRIS</div>' +
        '<div class="pm-group-sub">Scan pakai GoPay, OVO, DANA, m-banking</div>' +
      '</div>' +
      '<span class="pm-group-count">1</span>' +
      '<svg class="pm-group-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>' +
    '</div>' +
    '<div class="pm-group-body"><div class="pm-group-inner">' +
      '<div class="pm-qris-box">' + imgHtml +
        (owner ? '<div class="pm-owner" style="margin-top:10px">a.n. ' + pubEscapeHtml(owner) + '</div>' : '') +
        '<div class="pm-qris-hint">Scan QR di atas dengan aplikasi e-wallet atau m-banking Anda.</div>' +
      '</div>' +
    '</div></div>' +
  '</div>';
}

function pubCopyAccount(btn, number) {
  const clean = String(number).replace(/\s+/g, '');
  const span  = btn.querySelector('span');
  const orig  = span ? span.textContent : 'Salin';
  function done() {
    btn.classList.add('copied');
    if (span) span.textContent = 'Tersalin!';
    setTimeout(function () { btn.classList.remove('copied'); if (span) span.textContent = orig; }, 1800);
  }
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(clean).then(done).catch(function () { pubFallbackCopy(clean); done(); });
  } else { pubFallbackCopy(clean); done(); }
}
function pubFallbackCopy(text) {
  const ta = document.createElement('textarea');
  ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
  document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); } catch (e) {}
  document.body.removeChild(ta);
}

// ── Helper: set/reset loading state tombol konfirmasi WA ──
function setConfirmLoading(on) {
  const btn  = document.getElementById('btnConfirmPay');
  const icon = document.getElementById('btnConfirmIcon');
  const spin = document.getElementById('btnConfirmSpin');
  const txt  = document.getElementById('btnConfirmText');
  if (!btn) return;
  btn.disabled = !!on;
  if (icon) icon.style.display = on ? 'none' : '';
  if (spin) spin.style.display = on ? 'block' : 'none';
  if (txt)  txt.textContent = on ? 'Memproses...' : 'Konfirmasi via WhatsApp';
}

// ── Manual confirm (Konfirmasi via WhatsApp) ──
async function pubConfirmManual() {
  if (!window.PUBLIC_TOKEN) return;

  // Cek nomor WA perusahaan dulu — kalau belum diatur, beri feedback jelas
  // dan jangan memanggil server (tidak akan menghasilkan wa_url).
  const waNum = (PUB_PAY_CFG && PUB_PAY_CFG.company_whatsapp ? String(PUB_PAY_CFG.company_whatsapp) : '').replace(/[^0-9]/g, '');
  if (!waNum) {
    App.showToast('Nomor WhatsApp untuk konfirmasi belum diatur. Silakan hubungi admin.', 'warning');
    return;
  }

  setConfirmLoading(true);
  try {
    const r = await fetch('/pub/invoice/' + encodeURIComponent(window.PUBLIC_TOKEN) + '/pay', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mode: 'manual' })
    });
    const j = await r.json();
    if (!j.success) {
      if (j.code === 'ALREADY_PAID') {
        App.showToast('Tagihan ini sudah dibayar.', 'success');
        setTimeout(function () { window.location.reload(); }, 1200);
        return;
      }
      App.showToast(j.message || 'Gagal membuat konfirmasi', 'error');
      setConfirmLoading(false);
      return;
    }
    if (j.wa_url) {
      window.open(j.wa_url, '_blank');
      App.showToast('WhatsApp dibuka, kirim bukti transfer ya', 'success');
    } else {
      App.showToast(j.message || 'Nomor WhatsApp belum diatur. Silakan hubungi admin.', 'warning');
    }
  } catch (e) {
    App.showToast('Error: ' + e.message, 'error');
  } finally {
    setConfirmLoading(false);
  }
}

// Midtrans Snap loader (sama pola dgn portal)
let PUB_SNAP_LOADED = false;
function pubLoadSnap(clientKey, env) {
  return new Promise(function (resolve, reject) {
    if (window.snap) return resolve();
    if (PUB_SNAP_LOADED) {
      let tries = 0;
      const iv = setInterval(function () {
        if (window.snap) { clearInterval(iv); resolve(); }
        else if (++tries > 50) { clearInterval(iv); reject(new Error('Snap.js timeout')); }
      }, 100);
      return;
    }
    PUB_SNAP_LOADED = true;
    const s = document.createElement('script');
    s.src = (env === 'production')
      ? 'https://app.midtrans.com/snap/snap.js'
      : 'https://app.sandbox.midtrans.com/snap/snap.js';
    s.setAttribute('data-client-key', clientKey || '');
    s.onload = function () { resolve(); };
    s.onerror = function () { reject(new Error('Gagal load Snap.js')); };
    document.head.appendChild(s);
  });
}

// ── Bayar Online (gateway) ──
async function pubPayOnline() {
  if (!window.PUBLIC_TOKEN) return;
  const gwCard = document.querySelector('.pm-gw-card');
  if (gwCard) gwCard.style.opacity = '.6';
  try {
    const r = await fetch('/pub/invoice/' + encodeURIComponent(window.PUBLIC_TOKEN) + '/pay', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}'
    });
    const j = await r.json();
    if (!j.success) {
      if (j.code === 'TRIPAY_METHOD_REQUIRED') { if (gwCard) gwCard.style.opacity = ''; return pubOpenTripay(); }
      if (j.code === 'ALREADY_PAID') {
        App.showToast('Tagihan ini sudah dibayar.', 'success');
        setTimeout(function () { window.location.reload(); }, 1200);
        return;
      }
      App.showToast(j.message || 'Gagal membuat transaksi', 'error');
      if (gwCard) gwCard.style.opacity = '';
      return;
    }
    pubHandleGatewayResponse(j);
  } catch (e) {
    App.showToast('Error: ' + e.message, 'error');
    if (gwCard) gwCard.style.opacity = '';
  }
}

async function pubHandleGatewayResponse(j) {
  const finishUrl = '/pub/invoice/' + encodeURIComponent(window.PUBLIC_TOKEN);
  if (j.mode === 'midtrans' && j.snap_token) {
    try { await pubLoadSnap(j.client_key, j.env); }
    catch (e) {
      if (j.snap_url) { window.location.href = j.snap_url; return; }
      App.showToast('Gagal memuat Snap. Coba lagi.', 'error');
      const gwCard = document.querySelector('.pm-gw-card'); if (gwCard) gwCard.style.opacity = '';
      return;
    }
    window.snap.pay(j.snap_token, {
      onSuccess: function () { window.location.href = finishUrl; },
      onPending: function () { window.location.href = finishUrl; },
      onError:   function () { App.showToast('Pembayaran gagal.', 'error'); const g=document.querySelector('.pm-gw-card'); if(g)g.style.opacity=''; },
      onClose:   function () { App.showToast('Transaksi belum selesai. Anda bisa coba lagi kapan saja.', 'info'); const g=document.querySelector('.pm-gw-card'); if(g)g.style.opacity=''; }
    });
    return;
  }
  const url = j.invoice_url || j.payment_url;
  if (url) { window.location.href = url; return; }
  App.showToast('Respons gateway tidak dikenali', 'error');
  const gwCard = document.querySelector('.pm-gw-card'); if (gwCard) gwCard.style.opacity = '';
}

// ── Tripay channel picker (public) ──
function pubCloseTripay() { document.getElementById('pubTripayModal').style.display = 'none'; }
async function pubOpenTripay() {
  const modal = document.getElementById('pubTripayModal');
  const box = document.getElementById('pubTripayList');
  box.innerHTML = '<div style="padding:24px;text-align:center;color:#94a3b8;font-size:13px">Memuat channel…</div>';
  modal.style.display = 'flex';
  try {
    const r = await fetch('/pub/invoice/' + encodeURIComponent(window.PUBLIC_TOKEN) + '/tripay-channels');
    const j = await r.json();
    if (!j.success || !Array.isArray(j.channels) || !j.channels.length) {
      box.innerHTML = '<div style="padding:24px;text-align:center;color:#dc2626;font-size:13px">' + (j.message || 'Tidak ada channel tersedia') + '</div>';
      return;
    }
    const groups = {};
    j.channels.forEach(function (c) { (groups[c.group || 'Lainnya'] = groups[c.group || 'Lainnya'] || []).push(c); });
    let html = '';
    Object.keys(groups).forEach(function (g) {
      html += '<div style="font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.4px;margin:12px 2px 8px">' + g + '</div>';
      groups[g].forEach(function (c) {
        let feeTxt = '';
        if (c.fee_flat) feeTxt = 'Biaya Rp ' + Number(c.fee_flat).toLocaleString('id-ID');
        else if (c.fee_percent && c.fee_percent !== '0') feeTxt = 'Biaya ' + c.fee_percent + '%';
        html += '<div onclick="pubPayTripay(\'' + c.code + '\')" style="cursor:pointer;display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid #e5e7eb;border-radius:12px;margin-bottom:8px;transition:all .15s" ' +
          'onmouseover="this.style.borderColor=\'#2563eb\';this.style.background=\'#f8fafc\'" onmouseout="this.style.borderColor=\'#e5e7eb\';this.style.background=\'\'">' +
          (c.icon ? '<img src="' + c.icon + '" alt="" style="width:36px;height:24px;object-fit:contain"/>' : '<div style="width:36px;height:24px;background:#eef2ff;border-radius:6px"></div>') +
          '<div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:600;color:#1e293b">' + c.name + '</div>' +
          (feeTxt ? '<div style="font-size:11px;color:#94a3b8">' + feeTxt + '</div>' : '') + '</div>' +
          '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>' +
          '</div>';
      });
    });
    box.innerHTML = html;
  } catch (e) {
    box.innerHTML = '<div style="padding:24px;text-align:center;color:#dc2626;font-size:13px">Error: ' + e.message + '</div>';
  }
}
async function pubPayTripay(method) {
  if (!method) return;
  const box = document.getElementById('pubTripayList');
  if (box) box.style.opacity = '.5';
  try {
    const r = await fetch('/pub/invoice/' + encodeURIComponent(window.PUBLIC_TOKEN) + '/pay', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tripay_method: method })
    });
    const j = await r.json();
    if (!j.success) { App.showToast(j.message || 'Gagal membuat transaksi', 'error'); return; }
    if (j.payment_url) { window.location.href = j.payment_url; return; }
    App.showToast('Respons gateway tidak dikenali', 'error');
  } catch (e) {
    App.showToast('Error: ' + e.message, 'error');
  } finally {
    if (box) box.style.opacity = '';
  }
}

