const PM_EWALLET_LABELS = { dana:'DANA', ovo:'OVO', gopay:'GoPay', shopeepay:'ShopeePay', linkaja:'LinkAja' };

function pubEscapeHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
  });
}
function pubJsEsc(s) { return String(s == null ? '' : s).replace(/\\/g, '\\\\').replace(/'/g, "\\'"); }

