<%
// Di public mode (pelanggan buka dari link WA), JANGAN load app.js karena:
//   • app.js otomatis panggil App.init() di DOMContentLoaded
//   • App.init() panggil initSocket(), initNotifications(), dll yang
//     tergantung pada token admin di localStorage
//   • App.api() auto-redirect ke /login saat dapat 401 — kalau ada
//     handler manapun yang panggil App.api() tanpa cek mode, customer
//     yang BUKAN admin akan langsung di-redirect ke /login
// Sebagai gantinya, definisikan minimal shim `App` di public mode supaya
// code yang reference App.showToast tidak crash.
const _isPub = (typeof publicMode !== 'undefined' && publicMode);
%>
<% if (!_isPub) { %>
<script src="/js/app.js"></script>
<% } else { %>
<script>
// Minimal `App` shim untuk public mode — hanya support showToast (untuk
// fallback close-window). TIDAK ada App.api() supaya tidak ada path yang
// bisa trigger redirect ke /login. TIDAK ada App.init() supaya tidak ada
// socket.io / notification fetch yang attempt auth.
window.App = {
  showToast: function(message, type) {
    var colors = { info: '#3b82f6', warning: '#f59e0b', error: '#ef4444', success: '#22c55e' };
    var t = document.createElement('div');
    t.style.cssText = 'position:fixed;top:24px;right:24px;background:white;border-left:4px solid ' + (colors[type] || colors.info) + ';padding:14px 20px;border-radius:8px;box-shadow:0 8px 25px rgba(0,0,0,0.12);z-index:9999;font-size:13px;max-width:360px;';
    t.textContent = message;
    document.body.appendChild(t);
    setTimeout(function(){ t.style.opacity = '0'; t.style.transition = 'opacity 0.3s'; setTimeout(function(){ t.remove(); }, 300); }, 4000);
  }
};
</script>
<% } %>
<script src="/js/invoice-renderer.js"></script>
<script>
// Template settings di-inject dari server
window.INVTPL = <%- JSON.stringify(tplVars) %>;
console.log('[INVTPL] Template settings loaded:', window.INVTPL);

// Public mode flag — diset oleh server saat route `/pub/invoice/:token`
window.IS_PUBLIC_INVOICE = <%- (typeof publicMode !== 'undefined' && publicMode) ? 'true' : 'false' %>;
window.PUBLIC_TOKEN      = <%- (typeof publicToken !== 'undefined' && publicToken) ? JSON.stringify(publicToken) : 'null' %>;

// Support empat mode:
//   /invoice/123                       — payment view (admin auth)
//   /invoice/inv/456                   — invoice view (admin auth)
//   /pub/invoice/<token>               — public view (no auth, HMAC token)
//   /invoice-template/preview-print    — preview template dengan data dummy
const _pathParts = location.pathname.split('/').filter(Boolean);
const _isPublicMode   = window.IS_PUBLIC_INVOICE === true;
const _isInvMode      = _pathParts.includes('inv');
const _isPreviewMode  = _pathParts[0] === 'invoice-template' && _pathParts[1] === 'preview-print';
const _payId          = _pathParts[_pathParts.length - 1];

// ── Tombol Tutup ──
// Halaman invoice selalu dibuka di tab baru (window.open). Tombol Tutup
// memanggil window.close(). Beberapa browser block window.close() untuk
// tab yang tidak dibuka oleh script (mis. user manual refresh di tab) —
// dalam kasus itu kita fallback ke navigasi sederhana.
function closeInvoiceWindow() {
  try {
    window.close();
    // Jika 200ms tab masih ada, berarti browser block window.close().
    // Tampilkan info ke user.
    setTimeout(function(){
      if (!window.closed) {
        if (App && App.showToast) {
          App.showToast('Browser memblokir penutupan tab. Silakan tutup tab ini secara manual.', 'info');
        } else {
          alert('Silakan tutup tab ini secara manual.');
        }
      }
    }, 250);
  } catch (e) {
    /* ignore */
  }
}

async function loadInvoice() {
  let d;
  if (_isPreviewMode) {
    // Preview mode — pakai data dummy dari renderer
    d = { success: true, data: InvoiceRenderer.sampleData() };
  } else if (_isPublicMode) {
    // Public mode — fetch via /api/pub/invoice/<token>/data (no auth)
    try {
      const resp = await fetch('/api/pub/invoice/' + encodeURIComponent(window.PUBLIC_TOKEN) + '/data');
      d = await resp.json();
    } catch(e) {
      d = { success: false, message: e.message };
    }
  } else {
    const endpoint = _isInvMode
      ? '/invoices/' + _payId + '/invoice-data'
      : '/payments/' + _payId + '/invoice-data';
    d = await App.api(endpoint);
  }
  document.getElementById('invLoading').style.display = 'none';
  if (!d?.success) {
    document.getElementById('alertWrap').innerHTML =
      '<div class="alert-box alert-err">Invoice tidak ditemukan atau terjadi kesalahan.</div>';
    return;
  }

  // Fallback: kalau template belum punya company_name, pakai dari env (data.company)
  if (d.data.company && !window.INVTPL.company_name) {
    window.INVTPL.company_name = d.data.company.name || 'ISP Provider';
  }
  if (d.data.company && !window.INVTPL.company_tagline) {
    window.INVTPL.company_tagline = 'Internet Service Provider';
  }

  if (_isPublicMode) {
    // ── Public view (pelanggan dari link WA) ──
    // Tampilan invoice TIDAK ditampilkan di halaman utama; halaman ini fokus ke
    // pembayaran. Invoice bisa dilihat on-demand via tombol "Lihat Invoice" di
    // Riwayat Tagihan (dibuka sebagai modal). Action bar Print disembunyikan.
    PUB_CURRENT_DATA = d.data;
    document.getElementById('invoiceWrap').style.display = 'none';
    document.getElementById('actionBar').style.display = 'none';
    renderPublicPayPanel(d.data);
    return;
  }

  // Render dengan shared renderer — guaranteed identik dengan designer preview
  InvoiceRenderer.render('#invoiceWrap', d.data, window.INVTPL);
  document.getElementById('invoiceWrap').style.display = 'block';

  if (_isPreviewMode) {
    // Hide normal action bar; show preview ribbon
    const ribbon = document.createElement('div');
    ribbon.className = 'preview-ribbon';
    ribbon.style.cssText = 'max-width:780px;margin:0 auto 16px;background:#fef3c7;border:1.5px solid #fde68a;border-radius:10px;padding:11px 18px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;';
    ribbon.innerHTML =
      '<div style="display:flex;align-items:center;gap:9px;color:#92400e;font-size:13px;font-weight:600;">' +
        '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' +
        '<span>Preview Mode — data contoh, bukan tagihan asli</span>' +
      '</div>' +
      '<div style="display:flex;gap:8px;">' +
        '<button onclick="window.close()" style="padding:7px 13px;border-radius:8px;background:#fff;border:1.5px solid #fde68a;color:#92400e;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit;">Tutup</button>' +
        '<button onclick="window.print()" style="padding:7px 13px;border-radius:8px;background:' + (window.INVTPL.primary_color || '#1e40af') + ';border:none;color:#fff;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:6px;"><svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>Print / Save PDF</button>' +
      '</div>';
    document.body.insertBefore(ribbon, document.getElementById('invoiceWrap'));
  } else {
    document.getElementById('actionBar').style.display = 'flex';
  }
}

async function sendInvoiceWa() {
  if (_isPreviewMode || _isPublicMode) return;

  const btn = document.getElementById('btnSendWa');
  const txt = document.getElementById('btnSendWaText');
  if (btn.classList.contains('sent')) return;
  btn.disabled = true;
  txt.textContent = 'Mengirim...';
  try {
    // Endpoint berbeda untuk invoice mode vs payment mode.
    // Invoice mode (/invoice/inv/:id) — support semua status (UNPAID/OVERDUE/PAID),
    //   backend pilih template berdasarkan status.
    // Payment mode (/invoice/:paymentId) — pakai endpoint lama (payment-based).
    const endpoint = _isInvMode
      ? '/invoices/' + _payId + '/send-wa-invoice'
      : '/payments/' + _payId + '/send-wa-invoice';
    const d = await App.api(endpoint, { method:'POST', body:'{}' });
    if (d?.success) {
      btn.classList.add('sent');
      txt.textContent = '✓ Terkirim';
      if (d.message && App.showToast) App.showToast(d.message, 'success');
    } else {
      App.showToast(d?.message || 'Gagal kirim WA', 'error');
      txt.textContent = 'Kirim via WA';
    }
  } catch (e) {
    App.showToast(e.message || 'Error', 'error');
    txt.textContent = 'Kirim via WA';
  } finally {
    btn.disabled = false;
  }
}

// ════════════════════════════════════════════════════════════════
// PUBLIC PAYMENT — tombol Bayar & list pembayaran (tanpa login)
// ════════════════════════════════════════════════════════════════
const PUB_GW_META = { provider: null, env: 'sandbox' };

function fmtRpInv(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }
function fmtDateInv(s) {
  if (!s) return '-';
  try { return new Date(s + (String(s).length <= 10 ? 'T00:00:00' : '')).toLocaleDateString('id-ID', { day:'2-digit', month:'long', year:'numeric' }); }
  catch (e) { return s; }
}

function renderPublicPayPanel(data) {
  const panel = document.getElementById('payPanel');
  if (!panel) return;
  panel.style.display = 'flex';

  // ── Header & footer branding (nama perusahaan / alamat / CS) ──
  renderBrandHeaderFooter(data);

  // List pembayaran (untuk invoice yang dibuka)
  const payments = Array.isArray(data.payments) ? data.payments : [];
  if (payments.length) {
    const card = document.getElementById('payHistoryCard');
    const list = document.getElementById('payHistoryList');
    list.innerHTML = payments.map(function (p) {
      return '<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #f1f5f9;">' +
        '<div><div style="font-size:13px;font-weight:600;color:#0f172a;">' + (p.method_label || '-') + '</div>' +
        '<div style="font-size:11.5px;color:#94a3b8;">' + fmtDateInv(p.payment_date) + (p.reference_number ? ' • ' + p.reference_number : '') + '</div></div>' +
        '<div style="font-size:14px;font-weight:700;color:#16a34a;">' + fmtRpInv(p.amount) + '</div>' +
        '</div>';
    }).join('');
    card.style.display = 'block';
  }

  // Riwayat Tagihan 1 tahun (periode terdahulu)
  renderInvoiceHistory(Array.isArray(data.invoice_history) ? data.invoice_history : []);

  // Status pembayaran → tampilkan kartu pembayaran atau notice lunas.
  // payable & is_paid sudah dihitung robust di backend (status + sum payments).
  const cancelled = data.invoice_status === 'cancelled';
  if (data.payable === true) {
    populatePayInfo(data);
    PUB_PAY_CFG = data.payment_config || { gateway_enabled:false, gateway_provider:'midtrans', company_whatsapp:'', payment_accounts:[] };
    renderPaymentAccordion(PUB_PAY_CFG);
    document.getElementById('payActionCard').style.display = 'block';
    // Kalau bukti sudah diunggah & menunggu verifikasi admin, tampilkan state
    // "menunggu verifikasi" dan sembunyikan form upload (cegah dobel kirim).
    applyVerificationState(data.verification_status);
    // Polling status: jika pelanggan bayar via gateway di tab lain, atau admin
    // memverifikasi bukti, kartu LUNAS muncul otomatis tanpa refresh manual.
    startStatusPolling();
  } else if (data.is_paid === true) {
    renderPaidDetail(data);
    document.getElementById('payPaidCard').style.display = 'block';
  } else if (cancelled) {
    // Invoice dibatalkan — jangan tampilkan tombol bayar maupun notice lunas.
    const pc = document.getElementById('payPaidCard');
    pc.style.background = '#f8fafc';
    pc.style.border = '1.5px solid #e2e8f0';
    const titleEl = pc.querySelector('div > div:last-child');
    if (titleEl) { titleEl.textContent = 'Tagihan ini dibatalkan.'; titleEl.style.color = '#64748b'; }
    const detailEl = document.getElementById('payPaidDetail');
    if (detailEl) detailEl.style.display = 'none';
    const svg = pc.querySelector('svg'); if (svg) svg.style.stroke = '#94a3b8';
    pc.style.display = 'block';
  }
}

// ════════════════════════════════════════════════════════════════
// UPLOAD BUKTI PEMBAYARAN (jalur transfer manual)
// ════════════════════════════════════════════════════════════════
let PUB_PROOF_FILE = null;

// Tampilkan/sembunyikan UI sesuai verification_status.
function applyVerificationState(vs) {
  const idle    = document.getElementById('proofBox');
  const pending = document.getElementById('proofPendingCard');
  const confirmBtn = document.getElementById('btnConfirmPay');
  if (vs === 'submitted') {
    if (idle) idle.style.display = 'none';
    if (pending) pending.style.display = 'block';
    // Sembunyikan tombol WA juga supaya alur jelas: sudah kirim bukti.
    if (confirmBtn) confirmBtn.style.display = 'none';
  } else {
    if (idle) idle.style.display = 'block';
    if (pending) pending.style.display = 'none';
    if (confirmBtn) confirmBtn.style.display = '';
    if (vs === 'rejected') {
      setProofMsg('Bukti sebelumnya ditolak admin. Silakan unggah ulang bukti yang benar.', '#b45309');
    }
  }
}

function setProofMsg(html, color) {
  const m = document.getElementById('proofMsg');
  if (m) m.innerHTML = html ? '<span style="color:' + (color || '#64748b') + '">' + html + '</span>' : '';
}

function onProofSelected() {
  const inp = document.getElementById('proofFile');
  const btn = document.getElementById('proofUploadBtn');
  const label = document.getElementById('proofPickLabel');
  const f = inp && inp.files && inp.files[0];
  if (!f) { PUB_PROOF_FILE = null; if (btn) { btn.disabled = true; btn.style.opacity = '.5'; } return; }
  // Validasi sisi klien: ukuran & tipe
  const MAX = 5 * 1024 * 1024;
  if (f.size > MAX) { setProofMsg('Ukuran file melebihi 5 MB.', '#dc2626'); inp.value = ''; return; }
  const okType = /^image\//.test(f.type) || /pdf$/i.test(f.type) || /\.(jpe?g|png|webp|heic|heif|pdf)$/i.test(f.name);
  if (!okType) { setProofMsg('Format tidak didukung. Gunakan gambar atau PDF.', '#dc2626'); inp.value = ''; return; }
  PUB_PROOF_FILE = f;
  if (label) label.textContent = f.name.length > 28 ? (f.name.slice(0, 25) + '…') : f.name;
  if (btn) { btn.disabled = false; btn.style.opacity = '1'; }
  setProofMsg('');
}

async function uploadProof() {
  if (!window.PUBLIC_TOKEN || !PUB_PROOF_FILE) return;
  const btn = document.getElementById('proofUploadBtn');
  const pickBtn = document.getElementById('proofPickBtn');
  if (btn) { btn.disabled = true; btn.textContent = 'Mengirim…'; btn.style.opacity = '.7'; }
  if (pickBtn) pickBtn.disabled = true;
  setProofMsg('');
  try {
    const fd = new FormData();
    fd.append('proof', PUB_PROOF_FILE);
    const r = await fetch('/pub/invoice/' + encodeURIComponent(window.PUBLIC_TOKEN) + '/proof', {
      method: 'POST', body: fd
    });
    const j = await r.json();
    if (j && j.success) {
      App.showToast(j.message || 'Bukti terkirim. Menunggu verifikasi.', 'success');
      applyVerificationState('submitted');
    } else {
      setProofMsg((j && j.message) || 'Gagal mengirim bukti', '#dc2626');
      if (btn) { btn.disabled = false; btn.textContent = 'Kirim Bukti'; btn.style.opacity = '1'; }
      if (pickBtn) pickBtn.disabled = false;
    }
  } catch (e) {
    setProofMsg('Error: ' + (e.message || e), '#dc2626');
    if (btn) { btn.disabled = false; btn.textContent = 'Kirim Bukti'; btn.style.opacity = '1'; }
    if (pickBtn) pickBtn.disabled = false;
  }
}

// ════════════════════════════════════════════════════════════════
// POLLING STATUS — deteksi pembayaran (mis. via gateway di tab lain)
// dan tampilkan kartu LUNAS otomatis tanpa refresh manual.
// ════════════════════════════════════════════════════════════════
let PUB_STATUS_TIMER = null;
const PUB_POLL_INTERVAL_MS = 12000;

function startStatusPolling() {
  if (PUB_STATUS_TIMER || !window.PUBLIC_TOKEN) return;
  PUB_STATUS_TIMER = setInterval(pollInvoiceStatus, PUB_POLL_INTERVAL_MS);
  // Hemat resource: hentikan polling saat tab disembunyikan, lanjutkan +
  // cek sekali saat tab kembali aktif (supaya status langsung ter-update).
  document.addEventListener('visibilitychange', onVisibilityChange);
}

function stopStatusPolling() {
  if (PUB_STATUS_TIMER) { clearInterval(PUB_STATUS_TIMER); PUB_STATUS_TIMER = null; }
  document.removeEventListener('visibilitychange', onVisibilityChange);
}

function onVisibilityChange() {
  if (document.hidden) {
    if (PUB_STATUS_TIMER) { clearInterval(PUB_STATUS_TIMER); PUB_STATUS_TIMER = null; }
  } else if (!PUB_STATUS_TIMER && window.PUBLIC_TOKEN) {
    pollInvoiceStatus(); // cek segera saat kembali aktif
    PUB_STATUS_TIMER = setInterval(pollInvoiceStatus, PUB_POLL_INTERVAL_MS);
  }
}

async function pollInvoiceStatus() {
  if (!window.PUBLIC_TOKEN) return;
  try {
    const r = await fetch('/pub/invoice/' + encodeURIComponent(window.PUBLIC_TOKEN) + '/status');
    if (!r.ok) return;
    const j = await r.json();
    const st = j && j.success && j.data ? j.data.status : null;
    const vs = j && j.success && j.data ? j.data.verification_status : null;
    if (st === 'paid' || st === 'cancelled') {
      // Status berubah → hentikan polling lalu muat ulang data lengkap supaya
      // kartu LUNAS (dgn detail tanggal & metode) atau notice batal tampil.
      stopStatusPolling();
      await refreshPayPanel();
    } else if (vs) {
      // Sinkronkan tampilan kalau verifikasi berubah (mis. bukti ditolak admin,
      // atau diunggah dari perangkat lain).
      applyVerificationState(vs);
    }
  } catch (e) { /* diam: percobaan berikutnya akan mencoba lagi */ }
}

// Muat ulang data invoice & render ulang panel (tanpa reload halaman penuh).
async function refreshPayPanel() {
  try {
    const resp = await fetch('/api/pub/invoice/' + encodeURIComponent(window.PUBLIC_TOKEN) + '/data');
    const d = await resp.json();
    if (!d || !d.success) return;
    PUB_CURRENT_DATA = d.data;
    // Sembunyikan kartu pembayaran lama sebelum render ulang.
    const pc = document.getElementById('payActionCard');
    if (pc) pc.style.display = 'none';
    if (d.data.is_paid === true) {
      App.showToast('Pembayaran diterima. Terima kasih!', 'success');
    }
    renderPublicPayPanel(d.data);
  } catch (e) { /* abaikan */ }
}

