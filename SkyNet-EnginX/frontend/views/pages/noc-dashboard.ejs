        <style>
          .ts-toggle { display:inline-flex; background:var(--nc-border,#eef2f9); border-radius:8px; padding:2px; }
          .ts-tab { border:none; background:transparent; font-family:inherit; font-size:10.5px; font-weight:700; color:var(--nc-muted,#64748b); padding:4px 11px; border-radius:6px; cursor:pointer; transition:all .15s; }
          .ts-tab.active { background:#fff; color:var(--nc-accent,#1a6ef5); box-shadow:0 1px 3px rgba(0,0,0,.08); }
          .ts-wrap { min-height:120px; }
          .ts-content { display:flex; gap:24px; align-items:center; flex-wrap:wrap; }
          /* Donut container: kotak responsif. width = height (aspect-ratio 1)
             supaya donut selalu proporsional & tidak terpotong di layar sempit.
             Di mobile mengecil mengikuti lebar layar (min dari 220px / 70vw). */
          .ts-donut-col { position:relative; flex-shrink:0; width:220px; max-width:100%; aspect-ratio:1 / 1; display:flex; align-items:center; justify-content:center; margin:0 auto; }
          .ts-donut-col > div:first-child { width:100%; }
          /* Pastikan SVG donut mengisi kotak tanpa meluap/terpotong */
          .ts-donut-col .apexcharts-canvas { width:100% !important; margin:0 auto; }
          .ts-donut-col .apexcharts-svg { width:100% !important; height:auto !important; overflow:visible; }
          @media (max-width:640px){ .ts-donut-col{ width:min(220px, 70vw); } }
          .ts-donut-center { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; pointer-events:none; }
          .ts-dc-val { font-size:18px; font-weight:800; color:var(--nc-text,#0d1b3e); font-family:'DM Mono',monospace; line-height:1.1; }
          .ts-dc-lbl { font-size:10px; color:var(--nc-muted,#94a3b8); text-transform:uppercase; letter-spacing:.5px; margin-top:2px; }
          .ts-list { flex:1; min-width:240px; display:flex; flex-direction:column; gap:3px; }
          .ts-row { display:flex; align-items:center; gap:10px; padding:7px 6px; border-radius:8px; transition:background .15s; }
          .ts-row:hover { background:var(--nc-hover,#f7faff); }
          .ts-dot { width:10px; height:10px; border-radius:3px; flex-shrink:0; }
          .ts-name { flex:1; min-width:0; font-size:12.5px; font-weight:600; color:var(--nc-text,#0d1b3e); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
          .ts-cat { font-size:10px; color:var(--nc-muted,#94a3b8); }
          .ts-pct { font-size:12px; font-weight:800; color:var(--nc-text,#0d1b3e); font-family:'DM Mono',monospace; min-width:46px; text-align:right; }
          .ts-bytes { font-size:11px; color:var(--nc-muted,#94a3b8); font-family:'DM Mono',monospace; min-width:64px; text-align:right; }
