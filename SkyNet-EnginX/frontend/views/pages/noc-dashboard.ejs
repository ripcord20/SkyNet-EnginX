            <div id="ncPppOfflineList" style="max-height:340px;overflow-y:auto;padding:4px 0;">
              <div class="nc-empty">
                <div class="ic"><span class="nc-skel" style="width:20px;height:20px;border-radius:50%;"></span></div>
                <div class="t">Memuat user offline…</div>
              </div>
            </div>
          </div>

        </div>

        <style>
          /* PPPoE list item style */
          .nc-pu-item {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 12px;
            border-bottom: 1px solid var(--nc-border);
            font-size: 12px;
            transition: background .12s;
          }
          .nc-pu-item:last-child { border-bottom: none; }
          .nc-pu-item:hover { background: rgba(0,0,0,.025); }
          .nc-dark .nc-pu-item:hover { background: rgba(255,255,255,.04); }
          .nc-pu-dot {
            width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
            box-shadow: 0 0 0 2px currentColor; opacity: .25;
          }
          .nc-pu-dot.online {
            background: #10b981; color: #10b981;
            animation: ncPuPulseOnline 2s infinite;
          }
          .nc-pu-dot.offline {
            background: #ef4444; color: #ef4444;
            animation: ncPuPulseOffline 2.5s infinite;
          }
          @keyframes ncPuPulseOnline {
            0%,100% { box-shadow: 0 0 0 2px rgba(16,185,129,.25); }
            50%     { box-shadow: 0 0 0 4px rgba(16,185,129,.12); }
          }
          @keyframes ncPuPulseOffline {
            0%,100% { box-shadow: 0 0 0 2px rgba(239,68,68,.30); opacity: 1; }
            50%     { box-shadow: 0 0 0 5px rgba(239,68,68,.10); opacity: .6; }
          }
          .nc-pu-info {
            flex: 1; min-width: 0;
            display: flex; flex-direction: column;
            gap: 1px;
          }
          .nc-pu-name {
            font-weight: 600; color: var(--nc-text);
            font-size: 12px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
          }
          .nc-pu-sub {
            font-size: 10.5px;
            color: var(--nc-muted);
            font-weight: 500;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
          }
          .nc-pu-meta {
            font-size: 10.5px; color: var(--nc-muted);
            font-weight: 500;
            white-space: nowrap;
          }
          .nc-pu-uptime {
            font-size: 10.5px; color: #10b981; font-weight: 700;
            white-space: nowrap;
          }
          .nc-pu-empty {
            padding: 30px 14px; text-align: center;
            color: var(--nc-muted); font-size: 12px;
          }
          @media (max-width: 768px) {
            .nc-panels-grid-2 { grid-template-columns: 1fr !important; }
          }
        </style>

      </div><!-- /#ncDashboard -->

    </main>
  </div>
</div>

<script>
(function(){
  'use strict';

  // ─── Helpers ─────────────────────────────────────────
  const $ = (id) => document.getElementById(id);
  const fmtNum  = (n) => (Number(n)||0).toLocaleString('id-ID');
  const fmtBytes = (n) => {
    n = Number(n) || 0;
    if (n >= 1e9) return (n/1e9).toFixed(2) + ' GB';
    if (n >= 1e6) return (n/1e6).toFixed(1) + ' MB';
    if (n >= 1e3) return (n/1e3).toFixed(1) + ' KB';
    return n + ' B';
  };
  const escHtml = (s) => String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  const timeAgo = (d) => {
    if (!d) return '';
    const diff = Math.max(0, Date.now() - new Date(d).getTime());
    const s = Math.floor(diff/1000);
    if (s < 60)    return s + 'd lalu';
    if (s < 3600)  return Math.floor(s/60) + 'm lalu';
    if (s < 86400) return Math.floor(s/3600) + 'j lalu';
    return Math.floor(s/86400) + 'h lalu';
  };
  async function api(url) {
    try { const r = await fetch(url, { credentials:'same-origin' }); return await r.json(); }
    catch (_) { return null; }
  }

  // ─── State ───────────────────────────────────────────
  let selectedRouterId = null;
  let routers = [];

  // Monitor presets (per user, per router) untuk panel bandwidth dinamis
  let monitors = [];          // [{ id, name, router_id, ifaces, color, position }]
  let monitorCharts = {};     // monitorId -> ApexCharts instance (chart utama timeline)

  // Interface cache per router untuk dipakai di modal
  let modalIfaceCache = {};   // routerId -> [{name, type, comment, running, disabled}]
  let modalSelectedIfaces = new Set(); // working set saat modal dibuka
  let editingMonitorId = null;

  // ─── Theme toggle (sync dengan device-monitor key dm_theme) ───
  const html = document.documentElement;
  const themeBtn = $('ncThemeBtn');
  const themeIcon = $('ncThemeIcon');
  const SUN  = '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>';
  const MOON = '<path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>';

  function applyTheme(mode) {
    if (mode === 'dark') { html.classList.add('dark-mode');    themeIcon.innerHTML = SUN; }
    else                  { html.classList.remove('dark-mode'); themeIcon.innerHTML = MOON; }
    setTimeout(() => { try { updateAllChartsTheme(); } catch(_){} }, 50);
  }
  const savedTheme = localStorage.getItem('noc_theme') || localStorage.getItem('dm_theme') || 'light';
  applyTheme(savedTheme);
  themeBtn.addEventListener('click', () => {
    const next = html.classList.contains('dark-mode') ? 'light' : 'dark';
    localStorage.setItem('noc_theme', next);
    applyTheme(next);
  });
  function isDark() { return html.classList.contains('dark-mode'); }

  // ─── ApexCharts common factory ───────────────────────
  // PENTING: deep-merge `chart` properties supaya toolbar:{show:false} dan
  // setting default lain tidak hilang ketika caller pass `chart:{type:'area'}`.
  function commonChart(opts = {}) {
    const defaults = {
      chart: {
        toolbar:    { show:false },     // ← critical: hide zoom/pan icons
        zoom:       { enabled:false },
        animations: { enabled:true, speed:400, animateGradually:{ enabled:false } },
        foreColor:  isDark() ? '#8892a4' : '#64748b',
        fontFamily: 'DM Sans, sans-serif',
        sparkline:  { enabled:false },
      },
      grid: {
        borderColor: isDark() ? '#2a2d3e' : '#e2e8f0',
        strokeDashArray: 3,
        padding: { top:0, right:5, bottom:0, left:5 }
      },
      tooltip: { theme: isDark() ? 'dark' : 'light', x: { format:'HH:mm:ss' } },
      legend:  { show:false },
    };
    // Deep-merge khusus untuk `chart` (caller bisa override type/height tanpa
    // menghapus toolbar/zoom defaults). Property non-chart pakai shallow merge.
    const userChart = opts.chart || {};
    const merged = Object.assign({}, defaults, opts);
    merged.chart = Object.assign({}, defaults.chart, userChart);
    return merged;
  }

  // ─── Chart instances ─────────────────────────────────
  let chCpuGauge, chMemGauge, chPppoeSpark, chBwSpark;
  let chCpuTL, chMemTL, chPppoeTL;
  let chTicketStatus, chTicketPriority;

  // ─── Anti-overflow: re-flow semua chart saat viewport berubah ───
  // ApexCharts kadang mempertahankan lebar awal sehingga melebar keluar layar
  // di mobile / saat rotasi. windowResize() memaksa chart mengukur ulang
  // container-nya. Debounced supaya tidak spam saat resize beruntun.
  let _ncResizeT = null;
  function ncReflowCharts() {
    const all = [chCpuGauge, chMemGauge, chPppoeSpark, chBwSpark,
                 chCpuTL, chMemTL, chPppoeTL, chTicketStatus, chTicketPriority,
                 _tsDonutChart, ...Object.values(monitorCharts || {})];
    all.forEach(c => { if (c && typeof c.windowResize === 'function') { try { c.windowResize(); } catch(_){} } });
  }
  window.addEventListener('resize', function(){
    clearTimeout(_ncResizeT);
    _ncResizeT = setTimeout(ncReflowCharts, 180);
  });
  window.addEventListener('orientationchange', function(){
    setTimeout(ncReflowCharts, 300);
  });

  function initCharts() {
    // CPU Gauge
    chCpuGauge = new ApexCharts($('chartCpuGauge'), {
      chart:{ type:'radialBar', height:170, toolbar:{ show:false }, sparkline:{ enabled:false }, foreColor: isDark() ? '#8892a4' : '#64748b', fontFamily:'DM Sans, sans-serif', animations:{ enabled:true, speed:400 } },
      series: [0],
      colors: ['#22c55e'],
      plotOptions: {
        radialBar: {
          startAngle:-135, endAngle:135,
          hollow:{ size:'68%' },
          track:{ background: isDark() ? '#252937' : '#eef2f7', strokeWidth:'100%', margin:0 },
          dataLabels: {
            name:  { show:false },
            value: { show:true, offsetY:8, fontSize:'30px', fontWeight:800, fontFamily:'JetBrains Mono, monospace', color: isDark() ? '#ffffff' : '#1e293b', formatter:(v) => Number(v).toFixed(0) + '%' },
          }
        }
      },
      fill:   { type:'gradient', gradient:{ shade:'dark', type:'horizontal', shadeIntensity:0.4, gradientToColors:['#06b6d4'], stops:[0,100] } },
      stroke: { lineCap:'round' },
      labels: ['CPU'],
    });
    chCpuGauge.render();

    // Memory Gauge
    chMemGauge = new ApexCharts($('chartMemGauge'), {
      chart:{ type:'radialBar', height:170, toolbar:{ show:false }, sparkline:{ enabled:false }, foreColor: isDark() ? '#8892a4' : '#64748b', fontFamily:'DM Sans, sans-serif', animations:{ enabled:true, speed:400 } },
      series: [0],
      colors: ['#3b82f6'],
      plotOptions: {
        radialBar: {
          startAngle:-135, endAngle:135,
          hollow:{ size:'68%' },
          track:{ background: isDark() ? '#252937' : '#eef2f7', strokeWidth:'100%', margin:0 },
          dataLabels: {
            name:  { show:false },
            value: { show:true, offsetY:8, fontSize:'30px', fontWeight:800, fontFamily:'JetBrains Mono, monospace', color: isDark() ? '#ffffff' : '#1e293b', formatter:(v) => Number(v).toFixed(0) + '%' },
          }
        }
      },
      fill:   { type:'gradient', gradient:{ shade:'dark', type:'horizontal', shadeIntensity:0.4, gradientToColors:['#14b8a6'], stops:[0,100] } },
      stroke: { lineCap:'round' },
      labels: ['Memory'],
    });
    chMemGauge.render();

    // PPPoE sparkline
    chPppoeSpark = new ApexCharts($('chartPppoeSpark'), {
      ...commonChart({ chart:{ type:'area', height:54, sparkline:{ enabled:true } } }),
      series: [{ name:'PPPoE', data: [] }],
      colors: ['#3b82f6'],
      stroke: { curve:'smooth', width:2 },
      fill:   { type:'gradient', gradient:{ shadeIntensity:1, opacityFrom:0.5, opacityTo:0, stops:[0,100] } },
    });
    chPppoeSpark.render();

    // Bandwidth Now sparkline (RX + TX, dua series stacked, sparkline style)
    chBwSpark = new ApexCharts($('chartBwSpark'), {
      ...commonChart({ chart:{ type:'area', height:60, sparkline:{ enabled:true } } }),
      series: [
        { name:'RX', data: [] },
        { name:'TX', data: [] }
      ],
      colors: ['#3b82f6','#06b6d4'],
      stroke: { curve:'smooth', width:2 },
      fill:   { type:'gradient', gradient:{ shadeIntensity:1, opacityFrom:0.45, opacityTo:0, stops:[0,100] } },
      tooltip:{ enabled:true, theme: isDark() ? 'dark' : 'light', x:{ format:'HH:mm:ss' }, y:{ formatter:(v)=>Number(v).toFixed(2)+' Mbps' } },
    });
    chBwSpark.render();

    // CPU timeline
    chCpuTL = new ApexCharts($('chartCpuTL'), {
      ...commonChart({ chart:{ type:'area', height:160 } }),
      series: [{ name:'CPU %', data:[] }],
      colors: ['#f59e0b'],
      stroke: { curve:'smooth', width:2 },
      fill:   { type:'gradient', gradient:{ shadeIntensity:1, opacityFrom:0.45, opacityTo:0.05, stops:[0,100] } },
      dataLabels:{ enabled:false },
      xaxis: { type:'datetime', labels:{ datetimeUTC:false, style:{ fontSize:'10px' } } },
      yaxis: { min:0, max:100, labels:{ formatter:(v)=>v + '%', style:{ fontSize:'10px' } } },
    });
    chCpuTL.render();

    // Memory timeline
    chMemTL = new ApexCharts($('chartMemTL'), {
      ...commonChart({ chart:{ type:'area', height:160 } }),
      series: [{ name:'Memory %', data:[] }],
      colors: ['#14b8a6'],
      stroke: { curve:'smooth', width:2 },
      fill:   { type:'gradient', gradient:{ shadeIntensity:1, opacityFrom:0.45, opacityTo:0.05, stops:[0,100] } },
      dataLabels:{ enabled:false },
      xaxis: { type:'datetime', labels:{ datetimeUTC:false, style:{ fontSize:'10px' } } },
      yaxis: { min:0, max:100, labels:{ formatter:(v)=>v + '%', style:{ fontSize:'10px' } } },
    });
    chMemTL.render();

    // PPPoE timeline
    chPppoeTL = new ApexCharts($('chartPppoeTL'), {
      ...commonChart({ chart:{ type:'area', height:160 } }),
      series: [{ name:'PPPoE', data:[] }],
      colors: ['#3b82f6'],
      stroke: { curve:'smooth', width:2 },
      fill:   { type:'gradient', gradient:{ shadeIntensity:1, opacityFrom:0.45, opacityTo:0.05, stops:[0,100] } },
      dataLabels:{ enabled:false },
      xaxis: { type:'datetime', labels:{ datetimeUTC:false, style:{ fontSize:'10px' } } },
      yaxis: { labels:{ style:{ fontSize:'10px' } } },
    });
    chPppoeTL.render();

    // Ticket status donut — 5 status sesuai schema (open/in_progress/pending/resolved/closed)
    // Warna mengikuti halaman /tickets: open=cyan, in_progress=green, closed=orange.
    chTicketStatus = new ApexCharts($('chartTicketStatus'), {
      ...commonChart({ chart:{ type:'donut', height:240 } }),
      series: [0,0,0,0,0],
      labels: ['Open','In Progress','Pending','Resolved','Closed'],
      colors: ['#0891b2','#16a34a','#f59e0b','#3b82f6','#ea580c'],
      stroke: { width:2, colors:[isDark() ? '#1a1d27' : '#ffffff'] },
      plotOptions: {
        pie: {
          donut: {
            size:'70%',
            labels: {
              show:true,
              total: { show:true, label:'Total', fontSize:'11px', color: isDark() ? '#8892a4' : '#64748b', formatter:(w) => w.globals.series.reduce((a,b)=>a+b,0) },
              value: { fontSize:'22px', fontWeight:800, fontFamily:'JetBrains Mono, monospace' },
            }
          }
        }
      },
      dataLabels: { enabled:false },
      legend: { show:true, position:'bottom', fontSize:'10px', fontWeight:600, markers:{width:8,height:8,radius:99} },
    });
    chTicketStatus.render();

    // Ticket priority — 4 priority sesuai schema (low/medium/high/critical)
    chTicketPriority = new ApexCharts($('chartTicketPriority'), {
      ...commonChart({ chart:{ type:'bar', height:200 } }),
      series: [{ name:'Tiket', data:[0,0,0,0] }],
      plotOptions: {
        bar: { horizontal:true, borderRadius:5, barHeight:'62%', distributed:true, dataLabels:{ position:'top' } }
      },
      colors: ['#ef4444','#f97316','#eab308','#94a3b8'],
      xaxis: { categories:['Critical','High','Medium','Low'], labels:{ style:{ fontSize:'10px' } } },
      dataLabels: {
        enabled:true, textAnchor:'start', offsetX:6,
        formatter:(val) => fmtNum(val),
        style: { fontSize:'11px', fontWeight:700, colors:[isDark() ? '#e2e8f0' : '#1e293b'] },
      },
      tooltip: { x:{ formatter:(v,opts)=>opts.w.globals.labels[opts.dataPointIndex] } },
    });
    chTicketPriority.render();
  }

  function updateAllChartsTheme() {
    const dark = isDark();
    const upd = {
      chart:   { foreColor: dark ? '#8892a4' : '#64748b' },
      grid:    { borderColor: dark ? '#2a2d3e' : '#e2e8f0' },
      tooltip: { theme: dark ? 'dark' : 'light' },
    };
    [chCpuGauge, chMemGauge, chPppoeSpark, chBwSpark,
     chCpuTL, chMemTL, chPppoeTL,
     chTicketStatus, chTicketPriority].forEach(c => {
      try { c && c.updateOptions(upd, false, false); } catch(_) {}
    });
    // Update juga semua monitor chart yang sedang aktif
    Object.values(monitorCharts).forEach(c => {
      try { c && c.updateOptions(upd, false, false); } catch(_) {}
    });
    try { chTicketStatus.updateOptions({ stroke:{ colors:[dark ? '#1a1d27' : '#ffffff'] }}); } catch(_){}
    // Update gauge-specific: value color (untuk persentase di tengah ring)
    // dan track background — radialBar tidak ke-handle oleh `upd` di atas.
    const gaugeUpd = {
      plotOptions:{ radialBar:{
        track:{ background: dark ? '#252937' : '#eef2f7' },
        dataLabels:{
          value:{ color: dark ? '#ffffff' : '#1e293b' }
        }
      }}
    };
    try { chCpuGauge && chCpuGauge.updateOptions(gaugeUpd, false, false); } catch(_){}
    try { chMemGauge && chMemGauge.updateOptions(gaugeUpd, false, false); } catch(_){}
  }

  // ─── Loaders ─────────────────────────────────────────
  async function loadRouters() {
    const j = await api('/api/noc/routers');
    return (j && j.success) ? j.data : [];
  }
  async function loadOverview() {
    const j = await api('/api/noc/overview');
    return (j && j.success) ? j.data : null;
  }
  async function loadAlerts() {
    const j = await api('/api/noc/alerts?limit=15');
    return (j && j.success) ? j.data : [];
  }

  // Clear semua alert dari log NocAlertsService (in-memory). State router
  // online/offline TIDAK direset jadi alert tidak akan muncul ulang seketika.
  window.ncClearAlerts = async function () {
    if (!confirm('Hapus semua alert dari list?\n\nAlert akan tetap muncul lagi kalau ada perubahan status router.')) return;
    const btn = document.getElementById('ncAlertClear');
    if (btn) btn.disabled = true;
    try {
      const r = await fetch('/api/noc/alerts', { method:'DELETE', credentials:'same-origin' });
      const j = await r.json();
      if (!r.ok || !j.success) throw new Error(j.message || 'Failed');
      // Reload alert list — harusnya empty
      const alerts = await loadAlerts();
      renderAlerts(alerts);
    } catch (e) {
      alert('Gagal: ' + e.message);
    } finally {
      if (btn) btn.disabled = false;
    }
  };
  async function loadTicketStats() {
    const j = await api('/api/noc/ticket-stats');
    return (j && j.success) ? j.data : null;
  }
  // Reuse endpoint /api/genieacs/stats yang sudah live di halaman /genieacs.
  // Endpoint ini sudah handle filter junk device + 5-min last inform threshold.
  async function loadOntStats() {
    const j = await api('/api/genieacs/stats');
    return (j && j.success) ? j.data : null;
  }

  // ─── PPPoE Users (Active + Offline) ──────────────────────
  // Load 3 endpoint paralel:
  //   - /api/mikrotik/pppoe/active   → list session aktif (online)
  //   - /api/mikrotik/pppoe/secrets  → semua secret PPPoE (untuk derive offline)
  //   - /api/noc/pppoe-customer-map  → mapping {pppoe_username → customer name}
  // Device context via header X-Device-Id (kalau selectedRouterId ada).
  //
  // Customer map cache: refresh setiap 5 menit untuk hindari hit DB tiap
  // refresh interval (data jarang berubah, customer baru/edit jarang).
  let _pppoeCustMapCache = null;
  let _pppoeCustMapAt    = 0;
  async function loadPppoeUsers() {
    try {
      const headers = selectedRouterId ? { 'X-Device-Id': String(selectedRouterId) } : {};

      // Refresh customer map kalau cache > 5 menit atau belum ada
      const now = Date.now();
      const needCustMap = !_pppoeCustMapCache || (now - _pppoeCustMapAt) > 5 * 60 * 1000;

      const promises = [
        fetch('/api/mikrotik/pppoe/active',  { credentials:'same-origin', headers }).then(r => r.json()).catch(() => null),
        fetch('/api/mikrotik/pppoe/secrets', { credentials:'same-origin', headers }).then(r => r.json()).catch(() => null),
      ];
      if (needCustMap) {
        promises.push(
          fetch('/api/noc/pppoe-customer-map', { credentials:'same-origin' }).then(r => r.json()).catch(() => null)
        );
      }
      const results = await Promise.all(promises);
      const activeRes  = results[0];
      const secretsRes = results[1];
      if (needCustMap) {
        const mapRes = results[2];
        if (mapRes && mapRes.success && mapRes.data) {
          _pppoeCustMapCache = mapRes.data;
          _pppoeCustMapAt = now;
        }
      }

      return {
        active:  (activeRes  && activeRes.success)  ? (activeRes.data  || []) : [],
        secrets: (secretsRes && secretsRes.success) ? (secretsRes.data || []) : [],
        custMap: _pppoeCustMapCache || {},
      };
    } catch (_) {
      return { active: [], secrets: [], custMap: _pppoeCustMapCache || {} };
    }
  }
  async function loadRealtime(routerId) {
    const j = await api('/api/noc/router/' + routerId + '/realtime');
    return j;  // pass through {success, message, data}
  }
  // Loader untuk timeline ring buffer.
  // ifaces:  null/undefined → semua interface (untuk timeline CPU/Mem/PPPoE
  //                         yang tidak per-interface, atau bandwidth global)
  //          Array          → filter spesifik (untuk monitor cards)
  async function loadHistory(routerId, ifaces) {
    const q = (Array.isArray(ifaces) && ifaces.length)
      ? '&ifaces=' + encodeURIComponent(ifaces.join(','))
      : '';
    const j = await api('/api/noc/router/' + routerId + '/history?points=60' + q);
    return (j && j.success) ? j.data : null;
  }
  async function loadInterfaces(routerId) {
    if (modalIfaceCache[routerId]) return modalIfaceCache[routerId];
    const j = await api('/api/noc/router/' + routerId + '/interfaces');
    const arr = (j && j.success) ? j.data : [];
    modalIfaceCache[routerId] = arr;
    return arr;
  }

  // ─── Traffic Summary per Provider/Kategori (connection tracking) ──
  let _tsMode = 'provider';        // 'provider' | 'category'
  let _tsLastData = null;          // cache hasil terakhir utk re-render saat toggle
  let _tsDonutChart = null;

  // Opsi donut terpusat (dipakai mode provider/kategori & mode web) supaya
  // konsisten + responsif. TANPA sparkline:true agar tidak terpotong di mobile;
  // width 100% mengikuti container square .ts-donut-col, tinggi via responsive.
  function tsDonutOptions(series, labels, colors) {
    return {
      chart: {
        type: 'donut',
        width: '100%',
        height: 220,
        offsetY: 0,
        parentHeightOffset: 0,
        animations: { enabled: true },
      },
      series, labels, colors,
      stroke: { width: 2, colors: ['#fff'] },
      plotOptions: { pie: { donut: { size: '72%' }, expandOnClick: false } },
      dataLabels: { enabled: false },
      legend: { show: false },
      grid: { padding: { top: 0, right: 0, bottom: 0, left: 0 } },
      tooltip: { y: { formatter: (v) => fmtBytes(v) } },
      states: { hover: { filter: { type: 'lighten', value: 0.06 } } },
      responsive: [
        { breakpoint: 640, options: { chart: { height: 200 } } },
        { breakpoint: 380, options: { chart: { height: 180 } } },
      ],
    };
  }

  async function loadTrafficSummary(routerId) {
    const j = await api('/api/noc/router/' + routerId + '/traffic-summary');
    return j; // {success, available, providers, categories, totalConnections}
  }

  window.tsSetMode = function(mode) {
    _tsMode = mode;
    $('tsTabProvider').classList.toggle('active', mode === 'provider');
    $('tsTabCategory').classList.toggle('active', mode === 'category');
    const wTab = $('tsTabWeb'); if (wTab) wTab.classList.toggle('active', mode === 'web');
    if (_tsLastData) renderTrafficSummary(_tsLastData);
  };

  function renderTrafficSummary(j) {
    _tsLastData = j;
    const empty   = $('tsEmpty');
    const content = $('tsContent');
    const sub     = $('tsSub');
    const list    = $('tsList');
    if (!empty || !content) return;

    const fail = (msg) => {
      empty.textContent = msg;
      empty.style.display = '';
      content.style.display = 'none';
      if (sub) sub.textContent = '';
    };

    if (!j || !j.success) return fail('Gagal memuat summary traffic');
    if (!j.available)      return fail('Connection tracking tidak aktif di router ini');

    // ── Mode "Web": top domain dari DNS cache router ──
    if (_tsMode === 'web') {
      let web = (j.web || []).slice();
      if (!web.length) {
        return fail('Belum ada domain terdeteksi. Pastikan router jadi DNS server klien (allow-remote-requests=yes).');
      }
      // Palet warna untuk domain (tidak ada warna bawaan dari backend)
      const WEB_PALETTE = ['#1d4ed8','#0ea5e9','#ef4444','#f59e0b','#10b981','#6366f1','#ec4899','#14b8a6','#f97316','#8b5cf6','#22c55e','#eab308','#06b6d4','#dc2626','#3b82f6'];
      web = web.map((d, i) => ({ ...d, color: WEB_PALETTE[i % WEB_PALETTE.length] }));
      const webTotal = web.reduce((s, d) => s + (d.bytes || 0), 0);

      empty.style.display = 'none';
      content.style.display = 'flex';
      if (sub) sub.textContent = web.length + ' domain · ' + fmtBytes(webTotal) + ' termatch';
      $('tsTotalVal').textContent = fmtBytes(webTotal);

      const wLabels = web.map(d => d.domain);
      const wSeries = web.map(d => d.bytes || 0);
      const wColors = web.map(d => d.color);
      const webDonutOpts = tsDonutOptions(wSeries, wLabels, wColors);
      if (!_tsDonutChart) {
        _tsDonutChart = new ApexCharts($('tsDonut'), webDonutOpts);
        _tsDonutChart.render();
      } else {
        _tsDonutChart.updateOptions(webDonutOpts, true, true);
      }

      list.innerHTML = web.map(d => `
        <div class="ts-row">
          <span class="ts-dot" style="background:${d.color}"></span>
          <span class="ts-name">${escHtml(d.domain)}<span class="ts-cat"> · ${(d.connections||0).toLocaleString('id-ID')} koneksi</span></span>
          <span class="ts-pct">${(d.pct != null ? d.pct : 0)}%</span>
          <span class="ts-bytes">${fmtBytes(d.bytes || 0)}</span>
        </div>`).join('');
      return;
    }

    // Pilih dataset sesuai mode
    let rows = (_tsMode === 'category' ? j.categories : j.providers) || [];
    // Sembunyikan "Lainnya" (IP tak terklasifikasi) dari donut & list.
    rows = rows.filter(r => {
      const nm = _tsMode === 'category' ? r.category : r.name;
      return nm !== 'Lainnya';
    });
    if (!rows.length) return fail('Belum ada traffic provider terklasifikasi');

    // Hitung ulang persentase berbasis total traffic yang TERKLASIFIKASI saja
    // (tanpa "Lainnya"), supaya donut penuh & persen menjumlah ~100%.
    const classifiedTotal = rows.reduce((s, r) => s + (r.bytes || 0), 0);
    rows = rows.map(r => ({
      ...r,
      pct: classifiedTotal > 0 ? Math.round(((r.bytes || 0) / classifiedTotal) * 1000) / 10 : 0
    }));

    empty.style.display = 'none';
    content.style.display = 'flex';
    if (sub) sub.textContent = (j.totalConnections || 0).toLocaleString('id-ID') + ' koneksi · ' + fmtBytes(classifiedTotal) + ' terklasifikasi';

    // Center total — pakai total terklasifikasi agar konsisten dengan donut
    $('tsTotalVal').textContent = fmtBytes(classifiedTotal);

    const labels = rows.map(r => _tsMode === 'category' ? r.category : r.name);
    const series = rows.map(r => r.bytes || 0);
    const colors = rows.map(r => r.color || '#94a3b8');

    // Donut chart (ApexCharts) — buat sekali, lalu updateOptions.
    // Pakai opsi terpusat tsDonutOptions (responsif, tanpa sparkline) supaya
    // tidak terpotong di mobile dan konsisten dengan donut mode web.
    const donutOpts = tsDonutOptions(series, labels, colors);
    if (!_tsDonutChart) {
      _tsDonutChart = new ApexCharts($('tsDonut'), donutOpts);
      _tsDonutChart.render();
    } else {
      _tsDonutChart.updateOptions(donutOpts, true, true);
    }

    // List di bawah/samping donut
    list.innerHTML = rows.map(r => {
      const nm = _tsMode === 'category' ? r.category : r.name;
      const catLine = _tsMode === 'provider' && r.category
        ? `<span class="ts-cat"> · ${escHtml(r.category)}</span>` : '';
      return `
        <div class="ts-row">
          <span class="ts-dot" style="background:${r.color || '#94a3b8'}"></span>
          <span class="ts-name">${escHtml(nm)}${catLine}</span>
          <span class="ts-pct">${(r.pct != null ? r.pct : 0)}%</span>
          <span class="ts-bytes">${fmtBytes(r.bytes || 0)}</span>
        </div>`;
    }).join('');
  }

