<script>
  // Token: utamakan localStorage, fallback ke cookie (server meng-autentikasi
  // halaman via cookie, jadi bila localStorage kosong tapi cookie ada kita
  // pakai cookie — mencegah redirect-loop login↔dashboard).
  function getCookie(name){
    const m = document.cookie.match('(?:^|; )'+name.replace(/([.$?*|{}()\[\]\\\/\+^])/g,'\\$1')+'=([^;]*)');
    return m ? decodeURIComponent(m[1]) : null;
  }
  let TOKEN = localStorage.getItem('reseller_token') || getCookie('reseller_token');
  // Sinkronkan kembali agar localStorage & cookie konsisten.
  if(TOKEN){
    try{ if(!localStorage.getItem('reseller_token')) localStorage.setItem('reseller_token', TOKEN); }catch(_){}
  }
  let RESELLER = null, PACKAGES = [], SELECTED = null, LAST_VOUCHERS = [], LAST_TXID = null;
  let histPage = 1, histDone = false, histLoading = false;

  // ── API helper (cookie HttpOnly + Bearer bila ada; auto-redirect 401) ──
  async function api(path, opts = {}){
    const headers = Object.assign({ 'X-Requested-With':'XMLHttpRequest' }, opts.headers || {});
    // Hanya kirim Bearer bila token klien valid. Bila kosong, andalkan cookie
    // HttpOnly yang otomatis ikut pada request same-origin (hindari "Bearer null").
    if(TOKEN && TOKEN!=='null' && TOKEN!=='undefined') headers['Authorization']='Bearer '+TOKEN;
    opts.headers = headers;
    opts.credentials = 'same-origin';
    if(opts.body && typeof opts.body !== 'string'){
      opts.headers['Content-Type'] = 'application/json';
      opts.body = JSON.stringify(opts.body);
    }
    const r = await fetch('/reseller/api'+path, opts);
    if(r.status === 401){ logoutNoCall(); return Promise.reject(new Error('unauth')); }
    return r.json();
  }
  function logoutNoCall(){
    localStorage.removeItem('reseller_token'); localStorage.removeItem('reseller_info');
    document.cookie = 'reseller_token=;path=/reseller;max-age=0';
    window.location.href = '/reseller/login';
  }

  const fmtRp = n => 'Rp ' + Number(n||0).toLocaleString('id-ID');
  function toast(msg){ const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('show'),2400); }

  // ── Confirm modal (pengganti window.confirm) ──────────────────
  let _cfResolve=null;
  const CF_ICONS={
    danger:'<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>',
    warn:'<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>',
    info:'<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>'
  };
  // confirmDialog({title, message(html), okText, cancelText, tone:'danger'|'warn'|'info'}) → Promise<bool>
  function confirmDialog(opts={}){
    const tone=opts.tone||'danger';
    document.getElementById('cfTitle').textContent=opts.title||'Konfirmasi';
    document.getElementById('cfMsg').innerHTML=opts.message||'';
    const ic=document.getElementById('cfIcon'); ic.className='cf-ic '+tone; ic.innerHTML=CF_ICONS[tone]||CF_ICONS.danger;
    const ok=document.getElementById('cfOk');
    ok.textContent=opts.okText||'Ya, Lanjutkan';
    ok.className='btn '+(tone==='warn'?'btn-warn':tone==='info'?'btn-teal':'btn-danger');
    const cancel=document.getElementById('cfCancel');
    cancel.textContent=opts.cancelText||'Batal';
    cancel.className='btn btn-outline';
    document.getElementById('confirmModal').classList.add('show');
    return new Promise(res=>{ _cfResolve=res; });
  }
  function closeConfirm(val){
    document.getElementById('confirmModal').classList.remove('show');
    if(_cfResolve){ const r=_cfResolve; _cfResolve=null; r(!!val); }
  }

  // ── Result modal (status berhasil / gagal) — gaya sama dgn confirm ──
  const RS_ICONS={
    success:'<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>',
    error:'<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>'
  };
  // resultDialog({ok, title, message, okText}) → menampilkan status sukses/gagal.
  function resultDialog(opts={}){
    const ok=opts.ok!==false;
    const tone=ok?'success':'error';
    document.getElementById('rsTitle').textContent = opts.title || (ok?'Berhasil':'Gagal');
    document.getElementById('rsMsg').innerHTML = opts.message || '';
    const ic=document.getElementById('rsIcon'); ic.className='cf-ic '+tone; ic.innerHTML=RS_ICONS[tone];
    const btn=document.getElementById('rsOk');
    btn.textContent=opts.okText||'Selesai';
    btn.className='btn '+(ok?'btn-teal':'btn-danger');
    document.getElementById('resultStatusModal').classList.add('show');
  }
  function closeResult(){ document.getElementById('resultStatusModal').classList.remove('show'); }

  // ── Init ─────────────────────────────────────────────────────
  (async function init(){
    // Halaman ini HANYA tersaji bila server sudah meng-autentikasi via cookie
    // (cookie HttpOnly tidak terbaca JS). Maka JANGAN bounce ke login meski
    // TOKEN klien kosong — cukup andalkan cookie untuk request API.
    try{ sessionStorage.removeItem('rsl_redir'); }catch(_){}
    document.body.classList.add('has-botnav');

    // ── PWA (#13): daftarkan service worker + tangani prompt install ──
    if('serviceWorker' in navigator){
      navigator.serviceWorker.register('/sw-reseller.js', { scope:'/reseller' }).catch(()=>{});
    }
    await loadDashboard();
    await loadPackages();
    // default tanggal laporan: bulan ini
    const now=new Date(), first=new Date(now.getFullYear(),now.getMonth(),1);
    document.getElementById('repFrom').value = first.toISOString().slice(0,10);
    document.getElementById('repTo').value = now.toISOString().slice(0,10);
  })();

  async function loadDashboard(){
    try{
      const j = await api('/dashboard');
      if(!j.success) return;
      RESELLER = j.data.reseller;
      const s = j.data.stats;
      document.getElementById('resName').textContent = RESELLER.name;
      document.getElementById('avatar').textContent = (RESELLER.name||'R').charAt(0).toUpperCase();
      document.getElementById('balance').textContent = fmtRp(RESELLER.balance);
      document.getElementById('resCode').textContent = RESELLER.code;
      document.getElementById('deviceName').textContent = RESELLER.device_name || 'Router';
      document.getElementById('vToday').textContent = s.today.vouchers;
      document.getElementById('vMonth').textContent = s.month.vouchers;
      document.getElementById('setCode').textContent = RESELLER.code;
      document.getElementById('profName').textContent = RESELLER.name || '—';
      document.getElementById('profDevice').textContent = RESELLER.device_name || 'Router';
      document.getElementById('profAvatar').textContent = (RESELLER.name||'R').charAt(0).toUpperCase();
      // Drawer
      document.getElementById('dwName').textContent = RESELLER.name || 'Reseller';
      document.getElementById('dwCode').textContent = RESELLER.code || '—';
      document.getElementById('dwAvatar').textContent = (RESELLER.name||'R').charAt(0).toUpperCase();
      document.getElementById('dwBalance').textContent = fmtRp(RESELLER.balance);
      document.getElementById('dwFoot').textContent = RESELLER.brand_name || 'FLAYNET Reseller';
      document.getElementById('maxHint').textContent = 'Maksimal '+RESELLER.max_per_batch+' per generate';

      // Peringatan saldo menipis.
      const lb = j.data.low_balance || {};
      const warnEl = document.getElementById('lowBalanceWarn');
      if (warnEl) {
        if (lb.warn) {
          let msg;
          if ((lb.can_buy || 0) <= 0) {
            msg = 'Saldo tidak cukup untuk generate voucher termurah sekalipun. Segera isi saldo.';
          } else {
            msg = 'Saldo Anda hanya cukup untuk sekitar <b>' + lb.can_buy + '</b> voucher termurah lagi. Isi saldo agar penjualan tidak terganggu.';
          }
          document.getElementById('lowBalanceMsg').innerHTML = msg;
          warnEl.style.display = 'block';
        } else {
          warnEl.style.display = 'none';
        }
      }
    }catch(e){}
  }

  async function loadPackages(){
    try{
      const j = await api('/packages');
      PACKAGES = j.data || [];
      const grid = document.getElementById('pkgGrid');
      if(!PACKAGES.length){
        grid.innerHTML = '<div class="empty"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg><div>Belum ada paket voucher.<br>Hubungi admin untuk menambahkan paket.</div></div>';
        return;
      }
      grid.innerHTML = PACKAGES.map((p,i)=>`
        <div class="pkg" data-i="${i}" onclick="selectPkg(${i})">
          <div class="pkg-check"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div class="pkg-top">
            <div>
              <div class="pkg-name">${esc(p.name)}</div>
              ${p.duration_label?`<div class="pkg-dur"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>${esc(p.duration_label)}</div>`:''}
            </div>
            <div class="pkg-prices">
              <div class="pkg-cost">Modal <b>${fmtRp(p.cost_price)}</b></div>
              <div class="pkg-sell">${fmtRp(p.sell_price)}</div>
            </div>
          </div>
        </div>`).join('');

      // Preview paket di Home (tap → buka Generate dengan paket terpilih).
      const homeGrid = document.getElementById('pkgGridHome');
      if(homeGrid){
        homeGrid.innerHTML = PACKAGES.map((p,i)=>`
          <div class="pkg" onclick="goGenerateWith(${i})">
            <div class="pkg-top">
              <div>
                <div class="pkg-name">${esc(p.name)}</div>
                ${p.duration_label?`<div class="pkg-dur"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>${esc(p.duration_label)}</div>`:''}
              </div>
              <div class="pkg-prices">
                <div class="pkg-cost">Modal <b>${fmtRp(p.cost_price)}</b></div>
                <div class="pkg-sell">${fmtRp(p.sell_price)}</div>
              </div>
            </div>
          </div>`).join('');
