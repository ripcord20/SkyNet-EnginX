<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#1565e0">
  <link rel="manifest" href="/reseller-manifest.json">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Reseller">
  <link rel="apple-touch-icon" href="/img/reseller/icon-192.png">
  <title>Dashboard Reseller</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    :root{
      --bg:#f4f7fb;--card:#fff;--ink:#0f1b34;--muted:#8a95ad;--line:#eef1f7;
      --blue:#1f7aff;--blue-soft:#e8f1ff;--teal:#1f8bff;--teal-deep:#1565e0;
      --green:#16a34a;--amber:#e08a00;--red:#e5484d;
    }
    body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--ink);
      padding-bottom:40px;-webkit-font-smoothing:antialiased;}
    .money{font-family:'DM Sans',sans-serif;font-weight:600;}
    .wrap{max-width:520px;margin:0 auto;}

    /* Header */
    .head{padding:20px 18px 6px;display:flex;align-items:center;justify-content:space-between;gap:12px;}
    .head .greet{font-size:12.5px;color:var(--muted);font-weight:500;}
    .head h1{font-size:19px;font-weight:800;letter-spacing:-.4px;margin-top:1px;}
    .head .right{display:flex;align-items:center;gap:9px;}
    .avatar{width:38px;height:38px;border-radius:12px;background:var(--teal);color:#fff;
      display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;}
    .iconbtn{width:38px;height:38px;border-radius:12px;background:#fff;border:1px solid var(--line);
      display:flex;align-items:center;justify-content:center;cursor:pointer;color:#5a6781;}
    .iconbtn:active{transform:scale(.94);}

    /* ── Side drawer ── */
    .drawer-bg{position:fixed;inset:0;background:rgba(15,27,52,.45);backdrop-filter:blur(2px);
      opacity:0;visibility:hidden;transition:opacity .28s,visibility .28s;z-index:130;}
    .drawer-bg.show{opacity:1;visibility:visible;}
    .drawer{position:fixed;top:0;left:0;bottom:0;width:84%;max-width:330px;background:var(--bg);
      z-index:131;display:flex;flex-direction:column;transform:translateX(-105%);
      transition:transform .32s cubic-bezier(.3,.9,.3,1);box-shadow:0 0 40px rgba(15,27,52,.18);
      padding-top:env(safe-area-inset-top,0px);overflow-y:auto;}
    .drawer.show{transform:translateX(0);}
    .dw-head{display:flex;align-items:center;gap:12px;padding:20px 18px 16px;}
    .dw-avatar{width:46px;height:46px;flex-shrink:0;border-radius:14px;
      background:linear-gradient(135deg,#1f8bff,#1565e0);color:#fff;display:flex;align-items:center;
      justify-content:center;font-weight:800;font-size:18px;}
    .dw-name{font-size:16px;font-weight:800;letter-spacing:-.3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .dw-code{font-size:11.5px;color:var(--muted);margin-top:1px;}
    .dw-x{margin-left:auto;flex-shrink:0;width:34px;height:34px;border-radius:10px;border:none;
      background:#fff;border:1px solid var(--line);color:#5a6781;display:flex;align-items:center;justify-content:center;cursor:pointer;}
    .dw-balance{margin:0 16px 6px;background:linear-gradient(135deg,#1f8bff 0%,#1565e0 70%);border-radius:18px;
      padding:15px 17px;color:#fff;box-shadow:0 10px 24px rgba(31,122,255,.26);}
    .dw-bl{font-size:11.5px;font-weight:600;color:rgba(255,255,255,.85);}
    .dw-bv{font-size:24px;font-weight:800;letter-spacing:-.6px;margin:3px 0 11px;}
    .dw-topup{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.95);color:#1565e0;
      border:none;padding:8px 15px;border-radius:100px;font-family:inherit;font-size:12.5px;font-weight:800;cursor:pointer;}
    .dw-nav{padding:10px 12px 4px;flex:1;}
    .dw-sec{font-size:10.5px;font-weight:800;letter-spacing:.8px;color:var(--muted);padding:12px 10px 6px;}
    .dw-item{display:flex;align-items:center;gap:13px;width:100%;border:none;background:transparent;
      padding:12px 12px;border-radius:13px;font-family:inherit;font-size:14px;font-weight:600;color:var(--ink);
      cursor:pointer;text-align:left;transition:background .15s;}
    .dw-item:active{background:#e9edf4;}
    .dw-item svg{width:20px;height:20px;flex-shrink:0;color:#64718c;}
    .dw-item.dw-danger{color:#dc2626;} .dw-item.dw-danger svg{color:#dc2626;}
    .dw-foot{padding:14px 22px calc(20px + env(safe-area-inset-bottom,0px));font-size:11px;color:var(--muted);text-align:left;}

    /* Hero saldo */
    .hero{margin:10px 16px 0;background:linear-gradient(135deg,#1f8bff 0%,#1565e0 60%,#0e4fb8 100%);
      border-radius:24px;padding:22px 22px 20px;box-shadow:0 14px 34px rgba(31,122,255,.28);
      color:#fff;position:relative;overflow:hidden;}
    .hero::after{content:'';position:absolute;top:-50px;right:-30px;width:170px;height:170px;
      background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%);pointer-events:none;}
    .hero .cap{font-size:12.5px;color:rgba(255,255,255,.88);font-weight:600;display:flex;
      align-items:center;gap:7px;position:relative;}
    .hero .cap .dot{width:7px;height:7px;border-radius:50%;background:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.25);}
    .hero .big{font-size:33px;font-weight:800;letter-spacing:-1px;margin:8px 0 2px;position:relative;}
    .hero .meta{display:flex;align-items:center;gap:8px;font-size:12px;color:rgba(255,255,255,.85);position:relative;}
    .hero .pill{display:inline-flex;align-items:center;gap:4px;background:rgba(255,255,255,.22);
      color:#fff;font-weight:700;padding:3px 10px;border-radius:100px;font-size:11px;}
    .hero-split{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:18px;position:relative;}
    .mini{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.18);border-radius:16px;padding:13px 15px;}
    .mini .l{font-size:11px;color:rgba(255,255,255,.82);font-weight:600;margin-bottom:5px;}
    .mini .v{font-size:16px;font-weight:800;letter-spacing:-.4px;color:#fff;}

    /* Tabs */
    .tabs{display:flex;gap:4px;margin:18px 16px 6px;background:#e9edf4;padding:4px;border-radius:14px;}
    .tab{flex:1;text-align:center;padding:10px 4px;border-radius:11px;font-size:12.5px;font-weight:700;
      background:transparent;color:#7a869e;cursor:pointer;border:none;transition:all .18s;font-family:inherit;}
    .tab.active{background:#fff;color:var(--ink);box-shadow:0 2px 8px rgba(20,40,90,.1);}

    .pane{display:none;padding:8px 16px;}
    .pane.active{display:block;}

    /* Section title */
    .sec-title{font-size:12px;font-weight:700;color:#54607a;margin:14px 4px 10px;letter-spacing:.01em;}

    /* Package picker */
    .pkg-grid{display:flex;flex-direction:column;gap:10px;}
    .pkg{background:#fff;border:1.5px solid var(--line);border-radius:18px;padding:15px 16px;cursor:pointer;
      transition:border-color .15s,box-shadow .15s,transform .08s;position:relative;}
    .pkg:active{transform:scale(.992);}
    .pkg.sel{border-color:var(--teal);background:#f0f6ff;box-shadow:0 6px 18px rgba(31,122,255,.12);}
    .pkg-top{display:flex;align-items:center;justify-content:space-between;gap:12px;}
    .pkg-name{font-size:15px;font-weight:800;letter-spacing:-.2px;}
    .pkg-dur{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:var(--teal-deep);
      background:#e8f1ff;padding:3px 9px;border-radius:8px;margin-top:5px;}
    .pkg-prices{text-align:right;flex-shrink:0;}
    .pkg-cost{font-size:11px;color:var(--muted);font-weight:600;}
    .pkg-cost b{color:#54607a;font-family:'DM Sans',sans-serif;}
    .pkg-sell{font-size:17px;font-weight:800;letter-spacing:-.4px;color:var(--ink);margin-top:2px;}
    .pkg-check{position:absolute;top:12px;right:12px;width:22px;height:22px;border-radius:50%;
      background:var(--teal);display:none;align-items:center;justify-content:center;}
    .pkg.sel .pkg-check{display:flex;}

    /* Qty + generate */
    .gen-box{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;margin-top:14px;
      box-shadow:0 4px 16px rgba(20,40,90,.04);}
    .qty-row{display:flex;align-items:center;gap:12px;}
    .qty-label{flex:1;}
    .qty-label .t{font-size:13.5px;font-weight:700;}
    .qty-label .s{font-size:11.5px;color:var(--muted);margin-top:2px;}
    .stepper{display:flex;align-items:center;gap:0;border:1.5px solid var(--line);border-radius:13px;overflow:hidden;}
    .stepper button{width:42px;height:44px;border:none;background:#f3f5fa;color:#46506a;font-size:20px;
      font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;}
    .stepper button:active{background:#e7ebf3;}
    .stepper input{width:62px;height:44px;border:none;text-align:center;font-size:16px;font-weight:800;
      font-family:'DM Sans',sans-serif;outline:none;color:var(--ink);background:#fff;
      border-left:1px solid var(--line);border-right:1px solid var(--line);}
    .qty-chips{display:flex;gap:7px;margin-top:13px;flex-wrap:wrap;}
    .qty-chip{flex:1;min-width:56px;padding:9px 4px;border-radius:10px;border:1.5px solid var(--line);
      background:#fff;color:#54607a;font-size:13px;font-weight:700;cursor:pointer;font-family:'DM Sans',sans-serif;}
    .qty-chip:active{transform:scale(.97);}
    .total-row{display:flex;align-items:center;justify-content:space-between;margin-top:16px;
      padding-top:15px;border-top:1px dashed var(--line);}
    .total-row .l{font-size:13px;color:#54607a;font-weight:600;}
    .total-row .v{font-size:22px;font-weight:800;letter-spacing:-.6px;font-family:'DM Sans',sans-serif;}
    .total-row .v.over{color:var(--red);}

    .btn{width:100%;padding:15px;border:none;border-radius:14px;font-family:inherit;font-size:15px;
      font-weight:800;letter-spacing:-.2px;cursor:pointer;display:flex;align-items:center;justify-content:center;
      gap:9px;transition:filter .15s,transform .08s;margin-top:14px;}
    .btn:active{transform:scale(.985);}
    .btn:disabled{opacity:.55;cursor:not-allowed;}
    .btn-gen{background:linear-gradient(135deg,#2f6bff,#1d4fd0);color:#fff;box-shadow:0 10px 24px rgba(47,107,255,.3);}
    .btn-teal{background:linear-gradient(135deg,#1f8bff,#1565e0);color:#fff;box-shadow:0 10px 24px rgba(31,122,255,.3);}
    .btn-soft{background:#f3f5fa;color:#46506a;box-shadow:none;}
    .spinner{width:18px;height:18px;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;
      border-radius:50%;animation:spin .7s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg);}}

    /* History list */
    .tx{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);
      border-radius:16px;padding:13px 15px;margin-bottom:9px;cursor:pointer;
      transition:box-shadow .15s,transform .08s;}
    .tx:active{transform:scale(.992);}
    .tx-ic{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .tx-ic.purchase{background:#eaf1ff;color:#2456d6;}
    .tx-ic.topup{background:#e7f7ef;color:#0a9a5a;}
    .tx-ic.refund{background:#fef6e0;color:#a9760a;}
    .tx-ic.adjust{background:#f3f5fa;color:#54607a;}
    .tx-mid{flex:1;min-width:0;}
    .tx-desc{font-size:13.5px;font-weight:700;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .tx-sub{font-size:11.5px;color:var(--muted);margin-top:2px;}
    .tx-amt{font-size:14.5px;font-weight:800;font-family:'DM Sans',sans-serif;flex-shrink:0;text-align:right;}
    .tx-amt.plus{color:var(--green);}
    .tx-amt.minus{color:var(--ink);}
    .tx-bal{font-size:10.5px;color:var(--muted);margin-top:2px;font-family:'DM Sans',sans-serif;}

    /* Report */
    .rep-cards{display:grid;grid-template-columns:1fr 1fr;gap:11px;}
    .rep-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:15px;}
    .rep-card .l{font-size:11.5px;color:var(--muted);font-weight:600;}
    .rep-card .v{font-size:21px;font-weight:800;letter-spacing:-.5px;margin-top:5px;font-family:'DM Sans',sans-serif;}
    .rep-card.full{grid-column:1/-1;}
    .date-row{display:flex;gap:9px;margin-bottom:12px;}
    .date-row .f{flex:1;}
    .date-row label{display:block;font-size:11px;font-weight:700;color:#54607a;margin-bottom:5px;}
    .date-row input{width:100%;padding:10px 11px;border:1.5px solid var(--line);border-radius:11px;
      font-size:13px;font-family:inherit;outline:none;color:var(--ink);}
    .date-row input:focus{border-color:var(--teal);}
    .rep-pkg{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#fff;
      border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin-bottom:8px;}
    .rep-pkg .n{font-size:13.5px;font-weight:700;}
    .rep-pkg .c{font-size:11.5px;color:var(--muted);margin-top:2px;}
    .rep-pkg .m{font-size:14px;font-weight:800;font-family:'DM Sans',sans-serif;color:var(--teal-deep);}

    .empty{padding:48px 16px;text-align:center;color:var(--muted);font-size:13px;}
    .empty svg{color:#cdd5e3;margin-bottom:10px;}

    /* Result modal */
    .modal-bg{position:fixed;inset:0;background:rgba(15,27,52,.5);z-index:90;display:none;
      align-items:flex-end;justify-content:center;backdrop-filter:blur(2px);}
    .modal-bg.show{display:flex;}
    .modal{background:#fff;width:100%;max-width:520px;border-radius:24px 24px 0 0;
      padding:22px 20px 30px;animation:slideup .28s cubic-bezier(.2,.8,.25,1);max-height:88vh;overflow-y:auto;}
    @keyframes slideup{from{transform:translateY(100%);}to{transform:translateY(0);}}
    .modal-grip{width:40px;height:4px;background:#e1e6ef;border-radius:100px;margin:0 auto 16px;}
    .modal h3{font-size:18px;font-weight:800;letter-spacing:-.3px;display:flex;align-items:center;gap:9px;}
    .modal .ok-ic{width:30px;height:30px;border-radius:50%;background:#e7f7ef;color:#0a9a5a;
      display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .modal .msub{font-size:13px;color:var(--muted);margin:6px 0 16px;}
    .vc-list{display:flex;flex-direction:column;gap:8px;max-height:42vh;overflow-y:auto;margin-bottom:6px;}
    .vc{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#f7f9fc;
      border:1px solid var(--line);border-radius:12px;padding:11px 13px;}
    .vc-user{font-size:14px;font-weight:700;font-family:'DM Sans',sans-serif;letter-spacing:.3px;}
    .vc-pw{font-size:11.5px;color:var(--muted);margin-top:2px;font-family:'DM Sans',sans-serif;}
    .vc-copy{background:none;border:none;color:var(--blue);cursor:pointer;padding:6px;display:flex;}

    /* Toast */
    .toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);
      background:#0f1b34;color:#fff;padding:12px 18px;border-radius:13px;font-size:13px;font-weight:600;
      z-index:120;opacity:0;transition:opacity .25s,transform .25s;box-shadow:0 12px 30px rgba(0,0,0,.25);
      pointer-events:none;max-width:90%;text-align:center;}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
    .skel{background:linear-gradient(90deg,#eef1f7 25%,#f6f8fb 50%,#eef1f7 75%);background-size:200% 100%;
      animation:shine 1.3s infinite;border-radius:12px;}
    @keyframes shine{to{background-position:-200% 0;}}

    /* ── Confirm modal (pengganti window.confirm) ───────────────── */
    /* ── Confirm modal (centered alert) ─────────────────────────── */
    .cf-modal{max-width:380px;width:calc(100% - 40px);border-radius:22px;padding:30px 26px 24px;
      text-align:center;align-self:center;animation:cfPop .26s cubic-bezier(.2,.9,.3,1.1);}
    @keyframes cfPop{from{opacity:0;transform:translateY(8px) scale(.94);}to{opacity:1;transform:none;}}
    .cf-ic{width:58px;height:58px;border-radius:50%;display:flex;align-items:center;justify-content:center;
      margin:0 auto 16px;}
    .cf-ic.danger{background:#fdecec;color:#e5384d;}
    .cf-ic.warn{background:#fff3e6;color:#ea580c;}
    .cf-ic.info{background:#e8f1ff;color:#1565e0;}
    .cf-modal h3{font-size:19px;font-weight:800;letter-spacing:-.3px;color:var(--ink);justify-content:center;}
    .cf-modal .cf-msg{font-size:13px;line-height:1.6;color:#8a95ad;margin:8px auto 22px;max-width:300px;}
    .cf-modal .cf-msg b{color:#5a657c;font-weight:700;}
    .cf-actions{display:flex;flex-direction:column;gap:10px;}
    .cf-actions .btn{margin-top:0;padding:14px;font-size:14.5px;border-radius:13px;width:100%;}
    .btn-danger{background:#e5384d;color:#fff;box-shadow:0 8px 20px rgba(229,56,77,.26);}
    .btn-danger:hover{background:#d62b40;}
    .btn-warn{background:#ea580c;color:#fff;box-shadow:0 8px 20px rgba(234,88,12,.24);}
    .btn-warn:hover{background:#d54d08;}
    .cf-actions .btn-outline{background:#fff;color:#46506a;border:1.5px solid #e4e8f0;box-shadow:none;}
    .cf-actions .btn-outline:hover{background:#f7f9fc;border-color:#d3dae6;}
    .cf-ic.success{background:#e7f7ef;color:#0a9a5a;}
    .cf-ic.error{background:#fdecec;color:#e5384d;}

    /* ── Voucher detail modal ───────────────────────────────────── */
    .vd-modal{padding:20px 18px 26px;}
    .vd-head{display:flex;align-items:center;gap:12px;margin-bottom:16px;}
    .vd-ic{width:44px;height:44px;border-radius:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#e8f1ff;color:#1565e0;}
    .vd-ic.s-active{background:#e7f7ef;color:#0a9a5a;}
    .vd-ic.s-used{background:#fef6e0;color:#b9810b;}
    .vd-ic.s-expired{background:#fdeaea;color:#dc2626;}
    .vd-ic.s-unused{background:#eef1f7;color:#7a869e;}
    .vd-name{font-size:17px;font-weight:800;letter-spacing:-.3px;color:var(--ink);font-family:'DM Sans',sans-serif;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .vd-prof{font-size:12px;color:var(--muted);margin-top:2px;font-weight:600;}
    .vd-badge{font-size:10px;font-weight:800;padding:4px 10px;border-radius:8px;flex-shrink:0;letter-spacing:.3px;}
    .vd-badge.s-active{background:#e7f7ef;color:#0a9a5a;} .vd-badge.s-used{background:#fef6e0;color:#b9810b;}
    .vd-badge.s-expired{background:#fdeaea;color:#dc2626;} .vd-badge.s-unused{background:#f3f5fa;color:#7a869e;}
    .vd-card{background:#f9fafc;border:1px solid var(--line);border-radius:16px;padding:4px 14px;}
    .vd-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid #eef1f7;}
    .vd-row:last-child{border-bottom:none;}
    .vd-row .l{color:var(--muted);font-size:12.5px;font-weight:500;}
    .vd-row .v{font-weight:700;font-size:13px;text-align:right;color:var(--ink);font-family:'DM Sans',sans-serif;}
    .vd-row .v.hl{color:#1565e0;}
    .vd-row .v.mono{font-family:'DM Mono',monospace;letter-spacing:.3px;}
    .vd-acts{display:flex;gap:9px;margin-top:16px;}
    .vd-acts .btn{margin-top:0;flex:1;padding:13px;font-size:14px;border-radius:13px;}
    .vd-acts .btn-del{background:#fdecec;color:#e5384d;box-shadow:none;}
    .vd-acts .btn-del:hover{background:#fbdcdc;}
    .vd-close{margin-top:9px;}
    .vd-close.btn{margin-top:9px;padding:13px;font-size:14px;border-radius:13px;}

    /* ── Selection modal (cetak / hapus dengan pilihan) ─────────── */
    .sel-modal{max-width:540px;padding:20px 18px 16px;display:flex;flex-direction:column;max-height:90vh;}
    .sel-head{display:flex;align-items:center;gap:11px;}
    .sel-head .sel-ic{width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .sel-head .sel-ic.blue{background:#e8f1ff;color:#1565e0;}
    .sel-head .sel-ic.danger{background:#fdeaea;color:#dc2626;}
    .sel-head .sel-ic.warn{background:#fff3e0;color:#ea580c;}
    .sel-head .h{font-size:16px;font-weight:800;letter-spacing:-.3px;color:var(--ink);}
    .sel-head .s{font-size:11.5px;color:var(--muted);margin-top:2px;font-weight:600;}
    .sel-tools{display:flex;gap:8px;align-items:center;margin:13px 0 9px;}
    .sel-search{flex:1;position:relative;}
    .sel-search input{width:100%;padding:10px 12px 10px 34px;border:1.5px solid var(--line);border-radius:11px;
      font-size:13px;font-family:inherit;outline:none;background:#f7f9fc;color:var(--ink);}
    .sel-search input:focus{border-color:var(--teal);background:#fff;}
    .sel-search svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:var(--muted);}
    .sel-allbtn{flex-shrink:0;border:1.5px solid var(--line);background:#fff;color:#46506a;font-weight:700;
      font-size:12px;padding:10px 13px;border-radius:11px;cursor:pointer;white-space:nowrap;font-family:inherit;transition:.12s;}
    .sel-allbtn:hover{border-color:var(--teal);color:var(--teal-deep);}
    .sel-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 12px;
      background:#f7f9fc;border:1px solid var(--line);border-radius:11px;margin-bottom:9px;}
    .sel-bar .cinfo{font-size:12.5px;font-weight:700;color:var(--ink);}
    .sel-bar .cinfo .n{color:var(--teal-deep);}
    .sel-bar .lim{font-size:11px;color:var(--muted);font-weight:600;}
    .sel-list{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:6px;min-height:120px;
      max-height:48vh;margin-bottom:6px;padding-right:2px;}
    .sel-item{display:flex;align-items:center;gap:11px;padding:10px 12px;border:1.5px solid var(--line);
      border-radius:12px;cursor:pointer;transition:.12s;background:#fff;}
    .sel-item:hover{border-color:#cfd8e6;}
    .sel-item.on{border-color:var(--teal);background:#f0f6ff;}
    .sel-cbox{width:21px;height:21px;border-radius:7px;border:2px solid #cdd5e3;flex-shrink:0;
      display:flex;align-items:center;justify-content:center;transition:.12s;color:#fff;}
    .sel-item.on .sel-cbox{background:var(--teal);border-color:var(--teal);}
    .sel-cbox svg{opacity:0;transition:.12s;}
    .sel-item.on .sel-cbox svg{opacity:1;}
    .sel-item .si-mid{flex:1;min-width:0;}
    .sel-item .si-u{font-size:13.5px;font-weight:800;font-family:'DM Sans',sans-serif;letter-spacing:.3px;
      color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .sel-item .si-s{font-size:11px;color:var(--muted);margin-top:1px;}
    .sel-item .si-badge{font-size:9.5px;font-weight:800;padding:3px 8px;border-radius:7px;flex-shrink:0;}
    .sel-loadmore{text-align:center;padding:9px;font-size:12px;font-weight:700;color:var(--teal-deep);
      cursor:pointer;border:1.5px dashed var(--line);border-radius:11px;background:#fafbfd;}
    .sel-loadmore:hover{border-color:var(--teal);background:#f0f6ff;}
    .sel-empty{text-align:center;padding:34px 16px;color:var(--muted);font-size:12.5px;}
    .sel-foot{display:flex;gap:9px;padding-top:4px;}
    .sel-foot .btn{margin-top:0;padding:13px;font-size:14px;border-radius:13px;}

    /* ── Laporan: stat grid (display-only, tidak bisa diklik) ── */
    .stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;}
    .stat{position:relative;background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;overflow:hidden;cursor:default;
      transition:transform .2s cubic-bezier(.2,.8,.25,1),box-shadow .2s,border-color .2s;animation:statIn .42s cubic-bezier(.2,.8,.25,1) both;}
    .stat:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(20,40,90,.09);border-color:#e2e8f3;}
    @keyframes statIn{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:none;}}
    /* stagger masuk antar kartu */
    .stat-grid .stat:nth-child(1){animation-delay:.02s;} .stat-grid .stat:nth-child(2){animation-delay:.07s;}
    .stat-grid .stat:nth-child(3){animation-delay:.12s;} .stat-grid .stat:nth-child(4){animation-delay:.17s;}
    .stat-grid .stat:nth-child(5){animation-delay:.22s;} .stat-grid .stat:nth-child(6){animation-delay:.27s;}
    .stat .si{position:absolute;top:14px;right:14px;width:36px;height:36px;border-radius:12px;display:flex;align-items:center;justify-content:center;transition:transform .2s;}
    .stat:hover .si{transform:scale(1.08) rotate(-4deg);}
    .stat .si svg{width:18px;height:18px;}
    .stat .sl{font-size:11.5px;color:var(--muted);font-weight:600;line-height:1.2;padding-right:42px;}
    .stat .sv{font-size:22px;font-weight:800;letter-spacing:-.6px;margin-top:8px;font-family:'DM Sans',sans-serif;color:var(--ink);}
    .stat .ss{font-size:10.5px;color:var(--muted);margin-top:4px;line-height:1.3;}
    .stat.blue  .si{background:#eaf1ff;color:#2456d6;} .stat.blue  .sv{color:#2456d6;}
    .stat.green .si{background:#e7f7ef;color:#0a9a5a;} .stat.green .sv{color:#0a9a5a;}
    .stat.teal  .si{background:#e8f1ff;color:#1565e0;} .stat.teal  .sv{color:#1565e0;}
    .stat.amber .si{background:#fef6e0;color:#b9810b;} .stat.amber .sv{color:#b9810b;}
    .stat.slate .si{background:#eef1f7;color:#54607a;} .stat.slate .sv{color:#46506a;}
    /* Chart card masuk halus + tab pane transition */
    .chart-card{animation:chartFade .4s ease both;}
    @keyframes chartFade{from{opacity:0;}to{opacity:1;}}
    .pane.active{animation:paneIn .32s ease both;}
    @keyframes paneIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}
    @media (prefers-reduced-motion: reduce){
      .stat,.chart-card,.pane.active{animation:none!important;}
      .stat:hover{transform:none;}
    }

    /* ── Chart cards ── */
    .chart-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px 14px 8px;margin-bottom:13px;}
    .chart-card .ch-hd{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 4px 4px;}
    .chart-card .ch-t{font-size:13.5px;font-weight:800;letter-spacing:-.2px;}
    .chart-card .ch-s{font-size:11px;color:var(--muted);margin-top:1px;}
    .chart-legend{display:flex;flex-wrap:wrap;gap:10px;padding:6px 6px 2px;}
    .chart-legend .lg{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:600;color:#54607a;}
    .chart-legend .lg .sw{width:10px;height:10px;border-radius:3px;}

    /* Segmented range switch */
    .seg{display:inline-flex;background:#eef1f7;border-radius:10px;padding:3px;gap:2px;}
    .seg button{border:none;background:transparent;font-family:inherit;font-size:11.5px;font-weight:700;color:#7a869e;
      padding:6px 11px;border-radius:8px;cursor:pointer;transition:all .15s;}
    .seg button.on{background:#fff;color:var(--ink);box-shadow:0 1px 4px rgba(20,40,90,.12);}

    /* ── Voucher manager ── */
    .vfilter{display:flex;gap:7px;margin:2px 0 12px;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:2px;}
    .vchip{flex-shrink:0;display:inline-flex;align-items:center;gap:6px;border:1.5px solid var(--line);background:#fff;
      color:#54607a;font-size:12px;font-weight:700;padding:8px 13px;border-radius:100px;cursor:pointer;font-family:inherit;transition:all .15s;}
    .vchip.on{background:var(--ink);color:#fff;border-color:var(--ink);}
    .vchip .cnt{font-size:10.5px;background:rgba(0,0,0,.08);padding:1px 7px;border-radius:100px;font-family:'DM Sans',sans-serif;}
    .vchip.on .cnt{background:rgba(255,255,255,.2);}

    /* ── Tombol aksi massal (clean & minimal) ───────────────────── */
    .vbulk{display:flex;flex-wrap:wrap;gap:8px;margin:2px 0 12px;}
    .actbtn{display:inline-flex;align-items:center;gap:7px;padding:9px 13px;border-radius:11px;
      border:1px solid var(--line);background:#fff;color:#54607a;font-family:inherit;font-size:12.5px;
      font-weight:700;letter-spacing:-.1px;cursor:pointer;line-height:1;
      transition:border-color .15s,color .15s,background .15s,box-shadow .15s,transform .08s;}
    .actbtn svg{width:15px;height:15px;color:#9aa5bd;transition:color .15s;flex-shrink:0;}
    .actbtn:hover{border-color:#cfd8e6;background:#fbfcfe;box-shadow:0 3px 10px rgba(20,40,90,.05);}
    .actbtn:hover svg{color:#1565e0;}
    .actbtn:active{transform:scale(.97);}
    .actbtn.danger:hover{border-color:#f0c4c4;color:#dc2626;background:#fffafa;}
    .actbtn.danger:hover svg{color:#dc2626;}
    .vsearch{position:relative;margin-bottom:12px;}
    .vsearch input{width:100%;padding:12px 13px 12px 40px;border:1.5px solid var(--line);border-radius:13px;
      font-size:13.5px;font-family:inherit;outline:none;color:var(--ink);}
    .vsearch input:focus{border-color:var(--teal);}
    .vsearch svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted);}
    .vrow{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);border-radius:15px;
      padding:12px 13px;margin-bottom:9px;}
    .vrow .vdot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
    .vrow.s-active .vdot{background:#0a9a5a;box-shadow:0 0 0 3px rgba(10,154,90,.18);animation:vPulse 1.6s ease-in-out infinite;}
    @keyframes vPulse{0%,100%{box-shadow:0 0 0 3px rgba(10,154,90,.18);}50%{box-shadow:0 0 0 5px rgba(10,154,90,.08);}}
    .vrow.s-used .vdot{background:#b9810b;}
    .vrow.s-expired .vdot{background:#dc2626;}
    .vrow.s-unused .vdot{background:#c2cad8;}
    .vrow .vmid{flex:1;min-width:0;}
    .vrow .vu{font-size:14px;font-weight:800;font-family:'DM Sans',sans-serif;letter-spacing:.3px;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .vrow .vs{font-size:11px;color:var(--muted);margin-top:2px;}
    .vrow .vbadge{font-size:10px;font-weight:800;padding:3px 8px;border-radius:7px;flex-shrink:0;}
    .vbadge.b-active{background:#e7f7ef;color:#0a9a5a;} .vbadge.b-used{background:#fef6e0;color:#b9810b;}
    .vbadge.b-expired{background:#fdeaea;color:#dc2626;}
    .vbadge.b-unused{background:#f3f5fa;color:#7a869e;}
    .vrow .vact{display:flex;gap:5px;flex-shrink:0;}
    .vbtn{width:32px;height:32px;border-radius:9px;border:1px solid var(--line);background:#fff;display:flex;
      align-items:center;justify-content:center;cursor:pointer;color:#7a869e;transition:all .12s;}
    .vbtn:active{transform:scale(.9);}
    .vbtn.cut:hover{color:#b9810b;border-color:#b9810b;background:#fef6e0;}
    .vbtn.copy:hover{color:#1565e0;border-color:#1565e0;background:#e8f1ff;}

    /* ── Monitor user aktif ── */
    .mon-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
    .mon-sub{font-size:12px;color:var(--muted);margin-top:4px;display:flex;align-items:center;gap:6px;}
    .mon-sub .live{width:7px;height:7px;border-radius:50%;background:#0a9a5a;flex-shrink:0;box-shadow:0 0 0 3px rgba(10,154,90,.18);animation:vPulse 1.6s ease-in-out infinite;}
    .mon-refresh{width:38px;height:38px;border-radius:12px;border:1px solid var(--line);background:#fff;
      display:flex;align-items:center;justify-content:center;cursor:pointer;color:#5a6781;flex-shrink:0;transition:opacity .2s,transform .12s;}
    .mon-refresh:active{transform:scale(.92) rotate(-30deg);}
    .mon-sum{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px;margin-bottom:16px;}
    .ms-card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:13px 11px;display:flex;flex-direction:column;gap:10px;}
    .ms-ic{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;}
    .ms-ic svg{width:18px;height:18px;}
    .ms-ic.ms-users{background:#eaf1ff;color:#2456d6;}
    .ms-ic.ms-dl{background:#e7f7ef;color:#0a9a5a;}
    .ms-ic.ms-ul{background:#fef0ec;color:#e2622f;}
    .ms-n{font-size:14.5px;font-weight:800;font-family:'DM Sans',sans-serif;letter-spacing:-.4px;color:var(--ink);line-height:1.1;
      transition:color .25s;}
    .ms-t{font-size:9.5px;color:var(--muted);font-weight:600;margin-top:3px;text-transform:uppercase;letter-spacing:.3px;}

    /* Kartu user */
    .mon-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:15px;margin-bottom:12px;
      box-shadow:0 1px 3px rgba(20,40,90,.03);animation:statIn .35s cubic-bezier(.2,.8,.25,1) both;}
    .mc-top{display:flex;align-items:center;gap:9px;margin-bottom:13px;}
    .mc-dot{width:9px;height:9px;border-radius:50%;background:#0a9a5a;flex-shrink:0;box-shadow:0 0 0 3px rgba(10,154,90,.18);animation:vPulse 1.6s ease-in-out infinite;}
    .mc-name{font-size:15px;font-weight:800;font-family:'DM Sans',sans-serif;letter-spacing:.2px;color:var(--ink);flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .mc-prof{font-size:10.5px;font-weight:800;color:#1565e0;background:#e8f1ff;padding:4px 10px;border-radius:100px;flex-shrink:0;}
    /* Rate band: dua readout besar download/upload */
    .mc-rate{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:13px;}
    .mc-r{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:13px;}
    .mc-r.dl{background:#f0faf4;} .mc-r.ul{background:#fef3ef;}
    .mc-r .ri{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .mc-r .ri svg{width:16px;height:16px;}
    .mc-r.dl .ri{background:#0a9a5a;color:#fff;} .mc-r.ul .ri{background:#e2622f;color:#fff;}
    .mc-r .rl{font-size:10px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.3px;}
    .mc-r .rv{font-size:15px;font-weight:800;font-family:'DM Sans',sans-serif;letter-spacing:-.4px;margin-top:1px;transition:color .2s;}
    .mc-r.dl .rv{color:#0a9a5a;} .mc-r.ul .rv{color:#e2622f;}
    /* Grid info 2×2 */
    .mc-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 14px;}
    .mc-item .l{font-size:10px;color:var(--muted);font-weight:600;display:flex;align-items:center;gap:5px;margin-bottom:3px;text-transform:uppercase;letter-spacing:.2px;}
    .mc-item .l svg{width:13px;height:13px;color:#9aa4ba;flex-shrink:0;}
    .mc-item .v{font-size:14px;font-weight:800;font-family:'DM Sans',sans-serif;color:var(--ink);letter-spacing:-.3px;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:color .2s;}
    .mc-item .v.warn{color:#dc2626;} .mc-item .v.left{color:#2456d6;}
    .mc-item .v.dlt{color:#0a9a5a;} .mc-item .v.ult{color:#e2622f;}
    .mc-meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px;padding-top:13px;border-top:1px solid var(--line);}
    .mc-chip{font-size:10.5px;color:#5a6781;background:#f3f5fa;padding:5px 10px;border-radius:8px;display:inline-flex;align-items:center;gap:5px;font-weight:600;}
    .mc-chip svg{width:12px;height:12px;color:#9aa4ba;flex-shrink:0;}
    .mc-act{display:flex;gap:8px;margin-top:13px;}
    .mc-btn{flex:1;border:1px solid var(--line);background:#fff;border-radius:11px;padding:10px;font-family:inherit;
      font-size:12.5px;font-weight:700;color:#5a6781;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:all .12s;}
    .mc-btn svg{width:14px;height:14px;}
    .mc-btn.cut:hover{color:#dc2626;border-color:#dc2626;background:#fdeaea;}
    .mc-btn.copy:hover{color:#1565e0;border-color:#1565e0;background:#e8f1ff;}
    .mc-btn:active{transform:scale(.96);}
    .mon-card .empty{padding:40px 10px;}
    .vbtn.del:hover{color:#c0392f;border-color:#e5484d;background:#fdeaea;}
    /* ── Kartu statistik voucher (satu card, pemisah antar kolom) ── */
    .vstat-card{display:flex;background:#fff;border:1px solid var(--line);border-radius:18px;
      padding:6px 4px;margin-bottom:14px;box-shadow:0 2px 10px rgba(20,40,90,.04);overflow:hidden;}
    .vstat-card .vs-cell{flex:1;text-align:center;padding:11px 6px;position:relative;}
    .vstat-card .vs-cell + .vs-cell::before{content:'';position:absolute;left:0;top:18%;bottom:18%;width:1px;background:var(--line);}
    .vstat-card .vs-cell .n{font-size:22px;font-weight:800;font-family:'DM Sans',sans-serif;letter-spacing:-.6px;line-height:1;color:var(--vc,var(--ink));}
    .vstat-card .vs-cell .t{font-size:10px;color:var(--muted);font-weight:700;margin-top:6px;text-transform:uppercase;letter-spacing:.4px;}
    .vstat-card .c-total{--vc:#1565e0;} .vstat-card .c-used{--vc:#b9810b;}
    .vstat-card .c-online{--vc:#0a9a5a;} .vstat-card .c-unused{--vc:#7a869e;}

    /* ── Bottom nav (untuk WebView Android) ── */
    .botnav{position:fixed;left:0;right:0;bottom:0;z-index:80;background:#fff;
      border-top:1px solid var(--line);display:flex;justify-content:space-around;align-items:stretch;
      padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px));
      box-shadow:0 -4px 20px rgba(20,40,90,.06);width:100%;max-width:520px;margin:0 auto;
      transition:box-shadow .2s;}
    .botnav .bn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
      border:none;background:transparent;color:#9aa4ba;font-family:inherit;font-size:10.5px;font-weight:700;
      cursor:pointer;padding:7px 2px 5px;border-radius:12px;transition:color .18s,background .18s;position:relative;}
    .botnav .bn:hover{color:var(--teal-deep);background:rgba(31,122,255,.05);}
    .botnav .bn svg{width:22px;height:22px;stroke-width:2;transition:transform .2s cubic-bezier(.2,.8,.25,1);}
    .botnav .bn.on{color:var(--teal-deep);}
    .botnav .bn.on svg{transform:translateY(-2px) scale(1.06);}
    .botnav .bn.on::before{content:'';position:absolute;top:0;width:26px;height:3px;border-radius:0 0 4px 4px;
      background:var(--teal-deep);animation:bnPop .25s cubic-bezier(.2,.8,.25,1);}
    @keyframes bnPop{from{transform:scaleX(.3);opacity:0;}to{transform:scaleX(1);opacity:1;}}
    .botnav .bn .bn-badge{position:absolute;top:3px;right:50%;transform:translateX(16px);
      min-width:16px;height:16px;padding:0 4px;border-radius:100px;background:var(--red);color:#fff;
      font-size:9px;font-weight:800;display:none;align-items:center;justify-content:center;line-height:1;}
    .botnav .bn .bn-badge.show{display:flex;}
    body.has-botnav{padding-bottom:calc(80px + env(safe-area-inset-bottom,0px));}

    /* ── Home menu grid ── */
    .home-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:16px 12px;
      margin-bottom:20px;box-shadow:0 2px 10px rgba(20,40,90,.04);}
    .home-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px 8px;}
    .hm{display:flex;flex-direction:column;align-items:center;gap:8px;border:none;background:transparent;
      cursor:pointer;font-family:inherit;padding:4px 2px;border-radius:14px;transition:transform .12s;}
    .hm:active{transform:scale(.93);}
    .hm-ic{width:54px;height:54px;border-radius:17px;display:flex;align-items:center;justify-content:center;
      box-shadow:0 4px 12px rgba(20,40,90,.06);}
    .hm-ic svg{width:24px;height:24px;}
    .hm-t{font-size:11px;font-weight:700;color:#54607a;letter-spacing:-.1px;}
    .ic-gen{background:#e8f1ff;color:#1565e0;} .ic-vou{background:#eaf1ff;color:#2456d6;}
    .ic-mon{background:#e7f7ef;color:#0a9a5a;} .ic-his{background:#fef6e0;color:#b9810b;}
    .ic-rep{background:#f0ecff;color:#6366f1;} .ic-top{background:#e6f6fb;color:#0891b2;}
    .ic-tph{background:#fdeef0;color:#e5484d;} .ic-prof{background:#eef1f7;color:#54607a;}

    /* ── Center FAB di bottom nav ── */
    .botnav .bn-fab{position:relative;}
    .botnav .bn-fab .fab-circle{position:absolute;top:-26px;left:50%;transform:translateX(-50%);
      width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center;
      background:linear-gradient(135deg,#1f8bff,#1565e0);box-shadow:0 8px 20px rgba(31,122,255,.42);
      border:4px solid var(--bg);transition:transform .2s cubic-bezier(.2,.8,.25,1);}
    .botnav .bn-fab .fab-circle svg{width:26px;height:26px;stroke-width:2.6;color:#fff;transform:none;}
    .botnav .bn-fab:active .fab-circle{transform:translateX(-50%) scale(.92);}
    .botnav .bn-fab .fab-lbl{margin-top:30px;font-size:10.5px;font-weight:800;color:var(--teal-deep);}
    .botnav .bn-fab.on::before{display:none;}
    .botnav .bn-fab:hover{background:transparent;}
    /* Desktop/laptop: jangka nav rapi mengikuti kolom konten 520px, beri sudut & border */
    @media(min-width:521px){
      .botnav{left:50%;right:auto;transform:translateX(-50%);border:1px solid var(--line);border-bottom:none;
        border-radius:18px 18px 0 0;box-shadow:0 -8px 30px rgba(20,40,90,.1);}
    }
  </style>
  <script src="/vendor/apexcharts/apexcharts.min.js"></script>
</head>
<body>
<div class="wrap">

  <!-- Header -->
  <div class="head">
    <div style="display:flex;align-items:center;gap:11px;min-width:0">
      <button class="iconbtn" id="menuBtn" onclick="openDrawer()" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
      <h1 id="resName" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Reseller</h1>
    </div>
    <div class="right">
      <div class="avatar" id="avatar" onclick="openSettings()" role="button" tabindex="0" aria-label="Profil reseller" style="cursor:pointer">R</div>
    </div>
  </div>

  <!-- Hero saldo -->
  <div class="hero">
    <div class="cap" style="display:flex;align-items:center;justify-content:space-between">
      <span style="display:flex;align-items:center;gap:7px"><span class="dot"></span> Saldo Deposit</span>
      <button onclick="openTopup()" style="position:relative;z-index:2;display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.95);color:#1565e0;border:none;padding:7px 13px;border-radius:100px;font-family:inherit;font-size:12px;font-weight:800;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.12);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        Isi Saldo
      </button>
    </div>
    <div class="big money" id="balance">Rp —</div>
    <div class="meta">
      <span class="pill" id="devicePill">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M6 12h.01M12 12h.01"/></svg>
        <span id="deviceName">Router</span>
      </span>
      <span>Kode: <b id="resCode">—</b></span>
    </div>
    <div class="hero-split">
      <div class="mini"><div class="l">Voucher Hari Ini</div><div class="v" id="vToday">0</div></div>
      <div class="mini"><div class="l">Voucher Bulan Ini</div><div class="v" id="vMonth">0</div></div>
    </div>
  </div>

  <!-- Peringatan saldo menipis (muncul otomatis bila saldo rendah) -->
  <div id="lowBalanceWarn" style="display:none;margin:14px 16px 12px;background:#fff7ed;border:1px solid #fed7aa;border-radius:14px;padding:13px 15px;">
    <div style="display:flex;align-items:flex-start;gap:11px;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>
      <div style="flex:1;min-width:0">
        <div style="font-size:13px;font-weight:800;color:#9a3412">Saldo menipis</div>
        <div id="lowBalanceMsg" style="font-size:12px;color:#b45309;margin-top:2px;line-height:1.5">Saldo Anda hampir habis. Isi saldo agar bisa terus generate voucher.</div>
        <button onclick="openTopup()" style="margin-top:9px;background:#ea580c;color:#fff;border:none;border-radius:9px;padding:7px 14px;font-family:inherit;font-size:12px;font-weight:800;cursor:pointer">Isi Saldo Sekarang</button>
      </div>
    </div>
  </div>

  <!-- Tabs (disembunyikan: navigasi utama kini via bottom nav) -->
  <div class="tabs" style="display:none">
    <button class="tab active" data-tab="generate" onclick="switchTab('generate')">Generate</button>
    <button class="tab" data-tab="vouchers" onclick="switchTab('vouchers')">Voucher</button>
    <button class="tab" data-tab="history" onclick="switchTab('history')">Riwayat</button>
    <button class="tab" data-tab="report" onclick="switchTab('report')">Laporan</button>
  </div>

  <!-- TAB: Home (halaman awal) -->
  <div class="pane active" id="pane-home">
    <div class="sec-title">MENU</div>
    <div class="home-card">
      <div class="home-grid">
      <button class="hm" onclick="switchTab('generate')">
        <span class="hm-ic ic-gen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg></span>
        <span class="hm-t">Generate</span>
      </button>
      <button class="hm" onclick="switchTab('vouchers')">
        <span class="hm-ic ic-vou"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></span>
        <span class="hm-t">Voucher</span>
      </button>
      <button class="hm" onclick="switchTab('monitor')">
        <span class="hm-ic ic-mon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></span>
        <span class="hm-t">Monitor</span>
      </button>
      <button class="hm" onclick="switchTab('history')">
        <span class="hm-ic ic-his"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg></span>
        <span class="hm-t">Riwayat</span>
      </button>
      <button class="hm" onclick="switchTab('report')">
        <span class="hm-ic ic-rep"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9M13 17V5M8 17v-3"/></svg></span>
        <span class="hm-t">Laporan</span>
      </button>
      <button class="hm" onclick="openTopup()">
        <span class="hm-ic ic-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
        <span class="hm-t">Isi Saldo</span>
      </button>
      <button class="hm" onclick="closeDrawer();openTopup();showTopupHistory()">
        <span class="hm-ic ic-tph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><path d="M12 7v5l4 2"/></svg></span>
        <span class="hm-t">Top-up</span>
      </button>
      <button class="hm" onclick="openSettings()">
        <span class="hm-ic ic-prof"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/></svg></span>
        <span class="hm-t">Profil</span>
      </button>
      </div>
    </div>

    <div class="sec-title" style="display:flex;align-items:center;justify-content:space-between">
      <span>PAKET TERSEDIA</span>
      <a onclick="switchTab('generate')" style="color:var(--teal-deep);font-size:11.5px;font-weight:800;cursor:pointer;letter-spacing:0">Lihat Semua</a>
    </div>
    <div class="pkg-grid" id="pkgGridHome">
      <div class="skel" style="height:78px"></div>
      <div class="skel" style="height:78px"></div>
    </div>
  </div>

  <!-- TAB: Generate -->
  <div class="pane" id="pane-generate">
    <div class="sec-title">PILIH PAKET VOUCHER</div>
    <div class="pkg-grid" id="pkgGrid">
      <div class="skel" style="height:78px"></div>
      <div class="skel" style="height:78px"></div>
    </div>

    <div class="gen-box" id="genBox" style="display:none">
      <div class="qty-row">
        <div class="qty-label">
          <div class="t">Jumlah Voucher</div>
          <div class="s" id="maxHint">Maksimal — per generate</div>
        </div>
        <div class="stepper">
          <button onclick="stepQty(-1)" aria-label="Kurangi">−</button>
          <input id="qty" type="number" value="5" min="1" inputmode="numeric" oninput="recalc()">
          <button onclick="stepQty(1)" aria-label="Tambah">+</button>
        </div>
      </div>
      <div class="qty-chips">
        <button class="qty-chip" onclick="setQty(5)">5</button>
        <button class="qty-chip" onclick="setQty(10)">10</button>
        <button class="qty-chip" onclick="setQty(25)">25</button>
        <button class="qty-chip" onclick="setQty(50)">50</button>
      </div>
      <div class="total-row">
        <div class="l">Total potong saldo</div>
        <div class="v money" id="totalCost">Rp 0</div>
      </div>
      <button class="btn btn-gen" id="btnGen" onclick="doGenerate()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
        <span id="btnGenText">Generate Voucher</span>
      </button>
    </div>
  </div>

  <!-- TAB: Voucher (kelola user hotspot) -->
  <div class="pane" id="pane-vouchers">
    <div class="vstat-card">
      <div class="vs-cell c-total"><div class="n" id="vmTotal">—</div><div class="t">Total</div></div>
      <div class="vs-cell c-used"><div class="n" id="vmUsed">—</div><div class="t">Terpakai</div></div>
      <div class="vs-cell c-online"><div class="n" id="vmActive">—</div><div class="t">Online</div></div>
      <div class="vs-cell c-unused"><div class="n" id="vmUnused">—</div><div class="t">Belum</div></div>
    </div>
    <div class="vsearch">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="vQuery" type="text" placeholder="Cari username / profil voucher…" oninput="debouncedVouchers()">
    </div>
    <div class="vfilter" id="vFilter">
      <button class="vchip on" data-f="" onclick="setVFilter('')">Semua <span class="cnt" id="fcAll">0</span></button>
      <button class="vchip" data-f="active" onclick="setVFilter('active')">Online <span class="cnt" id="fcActive">0</span></button>
      <button class="vchip" data-f="used_all" onclick="setVFilter('used_all')">Terpakai <span class="cnt" id="fcUsed">0</span></button>
      <button class="vchip" data-f="expired" onclick="setVFilter('expired')">Expired <span class="cnt" id="fcExpired">0</span></button>
      <button class="vchip" data-f="unused" onclick="setVFilter('unused')">Belum <span class="cnt" id="fcUnused">0</span></button>
    </div>
    <div id="vBulkBar" class="vbulk">
      <button class="actbtn" onclick="openSelModal('print','unused')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        <span>Cetak Belum Dipakai</span>
      </button>
      <button class="actbtn danger" onclick="openSelModal('delete','expired')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        <span>Hapus Expired</span>
      </button>
      <button class="actbtn danger" onclick="openSelModal('delete','unused')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        <span>Hapus Belum Dipakai</span>
      </button>
    </div>
    <div id="vList"></div>
  </div>

  <!-- TAB: History -->
  <div class="pane" id="pane-history">
    <div class="sec-title">RIWAYAT TRANSAKSI</div>
    <div id="histList"></div>
    <div style="text-align:center;margin-top:8px;">
      <button class="btn btn-soft" id="histMore" style="display:none;width:auto;padding:11px 22px;margin:0 auto;" onclick="loadMoreHistory()">Muat lebih banyak</button>
    </div>
  </div>

  <!-- TAB: Report -->
  <div class="pane" id="pane-report">
    <div class="sec-title">PERIODE LAPORAN</div>
    <div class="date-row">
      <div class="f"><input type="date" id="repFrom"></div>
      <div class="f"><input type="date" id="repTo"></div>
    </div>
    <button class="btn btn-teal" style="margin-top:0" onclick="loadReport()">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
      Tampilkan Laporan
    </button>
    <div id="repBody" style="margin-top:16px"></div>
  </div>

  <!-- TAB: Monitor user hotspot aktif -->
  <div class="pane" id="pane-monitor">
    <div class="mon-head">
      <div>
        <div class="sec-title" style="margin:0">MONITOR USER AKTIF</div>
      </div>
      <button class="mon-refresh" id="monRefreshBtn" onclick="loadMonitor()" aria-label="Segarkan">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
      </button>
    </div>

    <!-- Ringkasan total -->
    <div class="mon-sum">
      <div class="ms-card">
        <div class="ms-ic ms-users"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg></div>
        <div><div class="ms-n" id="msUsers">0</div><div class="ms-t">User Online</div></div>
      </div>
      <div class="ms-card">
        <div class="ms-ic ms-dl"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M4 21h16"/></svg></div>
        <div><div class="ms-n" id="msDown">0 bps</div><div class="ms-t">Total Download</div></div>
      </div>
      <div class="ms-card">
        <div class="ms-ic ms-ul"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V9m0 0 4 4m-4-4-4 4"/><path d="M4 3h16"/></svg></div>
        <div><div class="ms-n" id="msUp">0 bps</div><div class="ms-t">Total Upload</div></div>
      </div>
    </div>

    <div id="monList"></div>
  </div>

</div>

<!-- Result modal -->
<div class="modal-bg" id="resultModal">
  <div class="modal">
    <div class="modal-grip"></div>
    <h3><span class="ok-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span> <span id="resTitle">Voucher dibuat</span></h3>
    <div class="msub" id="resSub"></div>
    <div class="vc-list" id="vcList"></div>
    <button class="btn btn-teal" onclick="printVouchers()" style="margin-top:14px">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Cetak Semua Voucher
    </button>
    <button class="btn btn-soft" onclick="closeModal()" style="margin-top:9px">Tutup</button>
  </div>
</div>

<!-- Voucher detail modal -->
<div class="modal-bg" id="vDetailModal">
  <div class="modal vd-modal">
    <div class="modal-grip"></div>
    <div class="vd-head">
      <div class="vd-ic" id="vdIcon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      </div>
      <div style="flex:1;min-width:0">
        <div class="vd-name" id="vdTitle">Detail Voucher</div>
        <div class="vd-prof" id="vdSub"></div>
      </div>
      <span class="vd-badge" id="vdBadge"></span>
    </div>
    <div id="vdBody"></div>
    <div id="vdActions"></div>
  </div>
</div>

<!-- Settings modal -->
<div class="modal-bg" id="settingsModal">
  <div class="modal">
    <div class="modal-grip"></div>
    <h3>Profil Reseller</h3>
    <div class="prof-card" style="display:flex;align-items:center;gap:12px;padding:14px;border:1.5px solid var(--line);border-radius:14px;margin-bottom:14px">
      <div class="avatar" id="profAvatar" style="width:46px;height:46px;font-size:18px">R</div>
      <div style="min-width:0">
        <div id="profName" style="font-weight:800;font-size:15px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">—</div>
        <div style="font-size:12.5px;color:var(--muted);margin-top:2px">Kode: <b id="setCode">—</b></div>
        <div style="font-size:12.5px;color:var(--muted);margin-top:1px">Router: <span id="profDevice">—</span></div>
      </div>
    </div>
    <div class="gen-box" style="margin-top:4px">
      <div class="qty-label" style="margin-bottom:12px"><div class="t">Ganti Password</div></div>
      <div style="margin-bottom:10px"><input id="oldPw" type="password" placeholder="Password lama" style="width:100%;padding:12px 13px;border:1.5px solid var(--line);border-radius:11px;font-size:14px;font-family:inherit;outline:none"></div>
      <div style="margin-bottom:4px"><input id="newPw" type="password" placeholder="Password baru (min. 6)" style="width:100%;padding:12px 13px;border:1.5px solid var(--line);border-radius:11px;font-size:14px;font-family:inherit;outline:none"></div>
      <button class="btn btn-teal" onclick="changePw()" style="margin-top:12px">Simpan Password</button>
    </div>
    <button class="btn btn-soft" onclick="closeModal()" style="margin-top:10px">Tutup</button>
    <button class="btn" onclick="doLogout()" style="margin-top:9px;background:#fdeaea;color:#c0392f;box-shadow:none">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
      Keluar
    </button>
  </div>
</div>

<!-- Topup modal -->
<div class="modal-bg" id="topupModal">
  <div class="modal">
    <div class="modal-grip"></div>
    <div id="topupStep1">
      <h3>Isi Saldo</h3>
      <div class="msub">Pilih nominal & metode pembayaran.</div>

      <div class="sec-title" style="margin-top:4px">NOMINAL</div>
      <div class="qty-chips" id="topupChips" style="margin-top:0"></div>
      <div class="gen-box" style="margin-top:12px;padding:14px">
        <label style="font-size:12.5px;font-weight:700;color:#54607a;display:block;margin-bottom:8px">Atau masukkan nominal</label>
        <div style="position:relative">
          <span style="position:absolute;left:14px;top:50%;transform:translateY(-50%);font-weight:700;color:#8a95ad;font-family:'DM Sans',sans-serif">Rp</span>
          <input id="topupAmount" type="number" inputmode="numeric" placeholder="50000" oninput="onTopupAmount()" style="width:100%;padding:13px 14px 13px 44px;border:1.5px solid var(--line);border-radius:13px;font-size:16px;font-weight:800;font-family:'DM Sans',sans-serif;outline:none;color:var(--ink)">
        </div>
        <div id="topupMinHint" style="font-size:11.5px;color:var(--muted);margin-top:7px"></div>
      </div>

      <!-- Promo / kode bonus (#10) -->
      <div style="margin-bottom:18px">
        <label style="font-size:12.5px;font-weight:700;color:#54607a;display:block;margin-bottom:8px">Kode Promo (opsional)</label>
        <div style="display:flex;gap:8px">
          <input id="promoCode" type="text" placeholder="mis. BONUS10" autocapitalize="characters" oninput="this.value=this.value.toUpperCase()" style="flex:1;padding:12px 14px;border:1.5px solid var(--line);border-radius:13px;font-size:14px;font-weight:700;font-family:'DM Sans',sans-serif;outline:none;color:var(--ink)">
          <button onclick="checkPromo()" style="flex-shrink:0;padding:0 18px;border:none;border-radius:13px;background:#1565e0;color:#fff;font-family:inherit;font-size:13px;font-weight:800;cursor:pointer">Cek</button>
        </div>
        <div id="promoMsg" style="font-size:12px;margin-top:8px;font-weight:600;display:none"></div>
      </div>

      <div class="sec-title">METODE PEMBAYARAN</div>
      <div id="topupMethods" style="display:flex;flex-direction:column;gap:10px"></div>

      <button class="btn btn-soft" onclick="showTopupHistory()" style="margin-top:14px">Riwayat Top-up</button>
      <button class="btn btn-soft" onclick="closeModal()" style="margin-top:9px">Tutup</button>
    </div>

    <!-- Manual/QRIS instruction + upload -->
    <div id="topupStep2" style="display:none">
      <h3 id="t2Title">Selesaikan Pembayaran</h3>
      <div class="msub" id="t2Sub"></div>
      <div id="t2Accounts" style="display:flex;flex-direction:column;gap:9px;margin-bottom:14px"></div>
      <div class="gen-box" style="padding:15px">
        <label style="font-size:12.5px;font-weight:700;color:#54607a;display:block;margin-bottom:8px">Unggah Bukti Transfer</label>
        <input id="proofFile" type="file" accept="image/*,application/pdf" style="width:100%;font-size:13px;font-family:inherit;margin-bottom:10px">
        <input id="proofNote" type="text" placeholder="Catatan (mis. nama pengirim, jam)" style="width:100%;padding:11px 13px;border:1.5px solid var(--line);border-radius:11px;font-size:13.5px;font-family:inherit;outline:none">
        <button class="btn btn-teal" id="btnUploadProof" onclick="uploadProof()" style="margin-top:12px">
          <span id="uploadText">Kirim Bukti</span>
        </button>
      </div>
      <button class="btn btn-soft" onclick="backToTopupStep1()" style="margin-top:10px">Kembali</button>
    </div>

    <!-- Status / waiting -->
    <div id="topupStep3" style="display:none;text-align:center;padding:14px 0">
      <div id="t3Icon" style="width:62px;height:62px;border-radius:50%;background:#fef6e0;color:#a9760a;display:flex;align-items:center;justify-content:center;margin:0 auto 16px">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      </div>
      <h3 id="t3Title" style="justify-content:center">Menunggu Verifikasi</h3>
      <div class="msub" id="t3Sub" style="text-align:center"></div>
      <button class="btn btn-teal" onclick="closeTopupDone()" style="margin-top:16px">Selesai</button>
    </div>

    <!-- History -->
    <div id="topupStep4" style="display:none">
      <h3>Riwayat Top-up</h3>
      <div class="msub">Daftar permintaan isi saldo Anda.</div>
      <div id="topupHistList" style="margin-top:8px;max-height:52vh;overflow-y:auto"></div>
      <button class="btn btn-soft" onclick="backToTopupStep1()" style="margin-top:12px">Kembali</button>
    </div>
  </div>
</div>

