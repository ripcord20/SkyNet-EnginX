    }).join('') : '<div class="empty" style="padding:16px">Belum ada rekening tujuan. Hubungi admin.</div>';
  }
  function copyText(t){ navigator.clipboard.writeText(t).then(()=>toast('Disalin')); }

  async function uploadProof(){
    if(!CURRENT_TOPUP) return;
    const f = document.getElementById('proofFile').files[0];
    if(!f){ toast('Pilih file bukti dulu'); return; }
    const btn=document.getElementById('btnUploadProof'), txt=document.getElementById('uploadText');
    btn.disabled=true; const old=txt.textContent; txt.textContent='Mengirim…';
    try{
      const fd=new FormData();
      fd.append('proof', f);
      fd.append('note', document.getElementById('proofNote').value||'');
      const _h={'X-Requested-With':'XMLHttpRequest'};
      if(TOKEN && TOKEN!=='null' && TOKEN!=='undefined') _h['Authorization']='Bearer '+TOKEN;
      const r = await fetch('/reseller/api/topup/'+CURRENT_TOPUP.id+'/proof', {
        method:'POST', headers:_h, credentials:'same-origin', body: fd
      });
      const j = await r.json();
      if(j.success){
        showTopupStep(3);
        document.getElementById('t3Title').textContent='Menunggu Verifikasi';
        document.getElementById('t3Sub').innerHTML='Bukti terkirim. Saldo akan ditambahkan setelah admin memverifikasi.';
      } else toast(j.message||'Gagal mengunggah');
    }catch(e){ toast('Terjadi kesalahan'); }
    finally{ btn.disabled=false; txt.textContent=old; }
  }

