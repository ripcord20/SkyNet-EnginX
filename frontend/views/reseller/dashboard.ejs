    document.getElementById('t2Sub').innerHTML = 'Transfer tepat <b>'+fmtRp(data.amount)+'</b> lalu unggah bukti. Ref: <b>'+esc(data.ref)+'</b>';
    const accts = (data.accounts||[]).filter(a=> method==='qris' ? a.type==='qris' : a.type!=='qris');
