        <div class="stat teal"><div class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="sl">Penjualan (Omzet)</div><div class="sv">${fmtRp(s.total_revenue)}</div><div class="ss">harga jual × terjual</div></div>
        <div class="stat green"><div class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg></div><div class="sl">Keuntungan</div><div class="sv">${fmtRp(s.total_profit)}</div><div class="ss">omzet − modal</div></div>
        <div class="stat slate"><div class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="sl">Modal Terpakai</div><div class="sv">${fmtRp(s.total_modal)}</div><div class="ss">terpotong dari saldo</div></div>
        <div class="stat amber"><div class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><div class="sl">Voucher Terpakai</div><div class="sv">${usedStr}</div><div class="ss">${u?((activeStr||0)+' online • '+expiredStr+' selesai'):'router tak terjangkau'}</div></div>
        <div class="stat slate"><div class="si"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5"/></svg></div><div class="sl">Belum Terpakai</div><div class="sv">${unusedStr}</div><div class="ss">${u?('dari '+u.total+' voucher'):'siap dijual'}</div></div>
      </div>`;

      // Chart cards
      html += `
      <div class="chart-card">
        <div class="ch-hd">
          <div><div class="ch-t">Tren Penjualan Voucher</div><div class="ch-s">jumlah voucher per hari</div></div>
          <div class="seg" id="chSeg">
            <button data-d="7"  onclick="setChartRange(7)">7H</button>
            <button data-d="14" class="on" onclick="setChartRange(14)">14H</button>
            <button data-d="30" onclick="setChartRange(30)">30H</button>
          </div>
        </div>
        <div id="chartSales" style="min-height:210px"></div>
      </div>
      <div class="chart-card">
        <div class="ch-hd"><div><div class="ch-t">Komposisi Paket</div><div class="ch-s">voucher terjual per paket</div></div></div>
        <div id="chartDonut" style="min-height:230px"></div>
      </div>`;

      // Rincian per paket (tabel ringkas, tampil omzet + untung)
      html += '<div class="sec-title">RINCIAN PER PAKET</div>';
      if(!j.data.per_package.length){
        html += '<div class="empty" style="padding:30px">Belum ada penjualan pada periode ini.</div>';
      } else {
        html += j.data.per_package.map(p=>`
          <div class="rep-pkg">
            <div><div class="n">${esc(p.package_name)}</div><div class="c">${p.vouchers} voucher • ${p.batches}x generate • untung ${fmtRp(p.profit)}</div></div>
            <div class="m">${fmtRp(p.revenue)}</div>
          </div>`).join('');
      }
      body.innerHTML = html;

      // Render chart setelah kartu ter-layout. Kartu kini hanya fade opacity
