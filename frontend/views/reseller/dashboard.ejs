  function setChartRange(d){
    _chartDays = d;
    document.querySelectorAll('#chSeg button').forEach(b=>b.classList.toggle('on', +b.dataset.d===d));
    renderCharts();
  }

  // Pastikan grafik ikut menyesuaikan saat ukuran layar berubah / rotasi
  let _chResizeTimer=null;
  window.addEventListener('resize', ()=>{
    clearTimeout(_chResizeTimer);
    _chResizeTimer=setTimeout(()=>{
      const pane=document.getElementById('pane-report');
      if(pane && pane.classList.contains('active')) renderCharts();
    },250);
  });

  // Pastikan library ApexCharts tersedia. Bila script di <head> gagal dimuat
  // (mis. CDN diblokir di WebView Android), coba muat ulang dari CDN cadangan.
  let _apexLoading=null;
  function ensureApex(){
    if(typeof ApexCharts!=='undefined') return Promise.resolve(true);
    if(_apexLoading) return _apexLoading;
    const cdns=[
      '/vendor/apexcharts/apexcharts.min.js',
      'https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.min.js',
      'https://unpkg.com/apexcharts@3.45.2/dist/apexcharts.min.js',
      'https://cdnjs.cloudflare.com/ajax/libs/apexcharts/3.45.2/apexcharts.min.js'
    ];
    _apexLoading=new Promise(resolve=>{
      let i=0;
      const tryNext=()=>{
        if(typeof ApexCharts!=='undefined') return resolve(true);
        if(i>=cdns.length) return resolve(false);
        const sc=document.createElement('script');
        sc.src=cdns[i++]; sc.async=true;
        sc.onload=()=>resolve(typeof ApexCharts!=='undefined');
        sc.onerror=tryNext;
        document.head.appendChild(sc);
      };
      tryNext();
    });
    return _apexLoading;
  }

  async function renderCharts(){
    let data;
    try{
      const j = await api('/chart?days='+_chartDays);
      if(!j.success) return;
      data = j.data;
    }catch(e){ return; }

    const apexReady = await ensureApex();
    const salesElPre = document.getElementById('chartSales');
    const donutElPre = document.getElementById('chartDonut');
    if(!apexReady){
      const msg='<div class="empty" style="padding:40px 10px;text-align:center">Grafik tidak dapat dimuat.<br>Periksa koneksi internet lalu coba lagi.</div>';
      if(salesElPre) salesElPre.innerHTML=msg;
      if(donutElPre) donutElPre.innerHTML='';
      return;
    }

    // Jaga-jaga: bila kontainer belum punya lebar (mis. tab baru aktif /
    // animasi belum selesai), ApexCharts akan render dengan lebar 0 → kosong.
    // Tunggu hingga lebar tersedia, maksimal ~1.5 detik.
    const hostEl = salesElPre || donutElPre;
    if(hostEl){
      let tries=0;
      while((hostEl.clientWidth||0) < 40 && tries < 15){
        await new Promise(r=>setTimeout(r,100));
        tries++;
      }
    }

    // ── Bar/area: tren penjualan ──
    const salesEl = document.getElementById('chartSales');
    if(salesEl){
      if(_chartSales){ try{_chartSales.destroy();}catch(_){} _chartSales=null; }
      const hasSales = Array.isArray(data.vouchers) && data.vouchers.some(v=>v>0);
      if(!hasSales){
        salesEl.innerHTML = '<div class="empty" style="padding:54px 10px;text-align:center">Belum ada penjualan pada periode ini.</div>';
      } else {
        salesEl.innerHTML = '';
        const labels = data.labels.map(d=>{ const dt=new Date(d+'T00:00:00'); return dt.toLocaleDateString('id-ID',{day:'2-digit',month:'short'}); });
        const opt = {
          chart:{ type:'bar', height:210, width:'100%', fontFamily:"'DM Sans',sans-serif", toolbar:{show:false}, animations:{enabled:true,speed:450} },
          series:[{ name:'Voucher', data:data.vouchers }],
          plotOptions:{ bar:{ borderRadius:6, columnWidth:'52%' } },
          dataLabels:{ enabled:false },
          colors:[CH_COLORS.blue],
          fill:{ type:'gradient', gradient:{ shade:'light', type:'vertical', gradientToColors:[CH_COLORS.teal], stops:[0,100], opacityFrom:1, opacityTo:.85 } },
          grid:{ borderColor:'#eef1f7', strokeDashArray:4, padding:{left:4,right:4} },
          xaxis:{ categories:labels, labels:{ style:{ colors:'#8a95ad', fontSize:'10px' }, rotate:0, hideOverlappingLabels:true }, axisBorder:{show:false}, axisTicks:{show:false} },
          yaxis:{ labels:{ style:{ colors:'#8a95ad', fontSize:'10px' }, formatter:v=>Math.round(v) } },
          tooltip:{ y:{ formatter:(v,o)=>{ const i=o.dataPointIndex; return v+' voucher • '+fmtRp((data.modal&&data.modal[i])||0); } } }
        };
        _chartSales = new ApexCharts(salesEl, opt);
        _chartSales.render()
          .then(()=>{ setTimeout(()=>{ try{ _chartSales && _chartSales.windowResize(); }catch(_){} }, 120); })
          .catch(()=>{ salesEl.innerHTML='<div class="empty" style="padding:40px 10px;text-align:center">Gagal menampilkan grafik.</div>'; });
      }
    }

    // ── Donut: komposisi paket ──
    const donutEl = document.getElementById('chartDonut');
    if(donutEl){
      if(_chartDonut){ try{_chartDonut.destroy();}catch(_){} _chartDonut=null; }
      const pkgs = (data.packages||[]).filter(p=>p.vouchers>0);
      if(!pkgs.length){
        donutEl.innerHTML = '<div class="empty" style="padding:54px 10px;text-align:center">Belum ada data paket pada periode ini.</div>';
      } else {
        donutEl.innerHTML = '';
        const opt = {
          chart:{ type:'donut', height:240, width:'100%', fontFamily:"'DM Sans',sans-serif" },
          series: pkgs.map(p=>p.vouchers),
          labels: pkgs.map(p=>p.name),
          colors: CH_COLORS.donut,
          legend:{ position:'bottom', fontSize:'12px', markers:{ radius:4 }, labels:{ colors:'#54607a' } },
          dataLabels:{ enabled:true, formatter:(v)=>Math.round(v)+'%', style:{ fontSize:'10px', fontWeight:700 } },
          stroke:{ width:2, colors:['#fff'] },
          plotOptions:{ pie:{ donut:{ size:'66%', labels:{ show:true,
            total:{ show:true, label:'Total Voucher', fontSize:'11px', color:'#8a95ad',
              formatter:(w)=>w.globals.seriesTotals.reduce((a,b)=>a+b,0) } } } } },
          tooltip:{ y:{ formatter:v=>v+' voucher' } }
        };
        _chartDonut = new ApexCharts(donutEl, opt);
        _chartDonut.render()
          .then(()=>{ setTimeout(()=>{ try{ _chartDonut && _chartDonut.windowResize(); }catch(_){} }, 120); })
          .catch(()=>{ donutEl.innerHTML='<div class="empty" style="padding:40px 10px;text-align:center">Gagal menampilkan grafik.</div>'; });
      }
    }
  }

  // ── Voucher manager (kelola user hotspot) ────────────────────
  let _vFilter='', _vTimer=null, VOUCHERS=[];
  function debouncedVouchers(){ clearTimeout(_vTimer); _vTimer=setTimeout(()=>loadVouchers(),300); }
  function setVFilter(f){
    _vFilter=f;
    document.querySelectorAll('#vFilter .vchip').forEach(c=>c.classList.toggle('on', (c.dataset.f||'')===f));
    renderVouchers();
  }
  async function loadVouchers(){
    const list=document.getElementById('vList');
    list.innerHTML='<div class="skel" style="height:62px;margin-bottom:9px"></div><div class="skel" style="height:62px;margin-bottom:9px"></div><div class="skel" style="height:62px"></div>';
    try{
      const q=document.getElementById('vQuery').value.trim();
      const j = await api('/vouchers'+(q?('?q='+encodeURIComponent(q)):''));
      if(!j.success){ list.innerHTML='<div class="empty">'+esc(j.message||'Gagal memuat voucher.')+'</div>'; return; }
      VOUCHERS = j.data||[];
      const c=j.counts||{total:0,used:0,unused:0,active:0,expired:0,used_total:0};
      const usedTotal = (c.used_total!=null) ? c.used_total : ((c.active||0)+(c.expired||0)+(c.used||0));
      document.getElementById('vmTotal').textContent=c.total;
      document.getElementById('vmActive').textContent=c.active;
      document.getElementById('vmUsed').textContent=usedTotal;
      document.getElementById('vmUnused').textContent=c.unused;
      document.getElementById('fcAll').textContent=c.total;
      document.getElementById('fcActive').textContent=c.active;
      document.getElementById('fcUsed').textContent=usedTotal;
      document.getElementById('fcExpired').textContent=c.expired||0;
      document.getElementById('fcUnused').textContent=c.unused;
      renderVouchers();
    }catch(e){ list.innerHTML='<div class="empty">Gagal memuat voucher dari router.</div>'; }
  }
  function fmtBytes(n){ n=Number(n)||0; if(n<1024) return n+' B'; if(n<1048576) return (n/1024).toFixed(1)+' KB'; if(n<1073741824) return (n/1048576).toFixed(1)+' MB'; return (n/1073741824).toFixed(2)+' GB'; }
  function fmtDurShort(sec){ sec=Number(sec)||0; if(sec<=0) return '0m'; const d=Math.floor(sec/86400),h=Math.floor((sec%86400)/3600),m=Math.floor((sec%3600)/60); const p=[]; if(d)p.push(d+'h'); if(h)p.push(h+'j'); if(m&&!d)p.push(m+'m'); return p.join(' ')||'<1m'; }
  // Ringkasan sisa untuk voucher (waktu &/atau kuota), dipakai di list & detail.
  function voucherRemain(v){
    const parts=[];
    if(v.time_left_sec!=null) parts.push('sisa waktu '+fmtDurShort(v.time_left_sec));
    if(v.quota_left_bytes!=null) parts.push('sisa kuota '+fmtBytes(v.quota_left_bytes));
    return parts.join(' • ');
  }
  const VBADGE={ active:{t:'ONLINE',c:'b-active'}, used:{t:'TERPAKAI',c:'b-used'}, expired:{t:'EXPIRED',c:'b-expired'}, unused:{t:'BELUM',c:'b-unused'} };
  function renderVouchers(){
    const list=document.getElementById('vList');
    let rows = VOUCHERS;
    if(_vFilter==='used_all') rows = rows.filter(v=>v.status==='active'||v.status==='used'||v.status==='expired');
    else if(_vFilter) rows = rows.filter(v=>v.status===_vFilter);
    if(!rows.length){
      list.innerHTML='<div class="empty"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg><div>'+(VOUCHERS.length?'Tidak ada voucher pada filter ini.':'Belum ada voucher.<br>Buat voucher di tab Generate.')+'</div></div>';
      return;
    }
    list.innerHTML = rows.map(v=>{
      const b=VBADGE[v.status]||VBADGE.unused;
      let sub;
      const remain = voucherRemain(v);
      if(v.status==='unused') sub='Profil '+esc(v.profile||'-')+' • belum dipakai';
      else if(v.status==='expired') sub='Profil '+esc(v.profile||'-')+' • masa aktif habis • '+fmtBytes(v.bytes_total);
      else {
        sub='Profil '+esc(v.profile||'-')+' • '+esc(v.uptime||'0s')+' • '+fmtBytes(v.bytes_total);
        if(remain) sub += ' • '+esc(remain);
      }
      const cut = v.status==='active'
        ? `<button class="vbtn cut" title="Putus sesi" onclick="event.stopPropagation();vAction('${esc(v.username)}','disconnect')"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><path d="M12 2v10"/></svg></button>`
        : '';
      return `<div class="vrow s-${v.status}" onclick="showVoucherDetail('${esc(v.username)}')" style="cursor:pointer">
        <span class="vdot"></span>
        <div class="vmid">
          <div class="vu">${esc(v.username)}</div>
          <div class="vs">${sub}</div>
        </div>
        <span class="vbadge ${b.c}">${b.t}</span>
        <div class="vact" onclick="event.stopPropagation()">
          <button class="vbtn copy" title="Salin voucher" onclick="copyVoucher('${esc(v.username)}','${esc(v.password||'')}')"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>
          ${cut}
          <button class="vbtn del" title="Hapus voucher" onclick="vAction('${esc(v.username)}','delete')"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
        </div>
      </div>`;
    }).join('');
  }
  function copyVoucher(username, password){
    const text = password ? ('Voucher: '+username+'\nSandi: '+password) : ('Voucher: '+username);
    const done = ()=>toast('Voucher disalin');
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(done).catch(()=>fallbackCopy(text,done));
    } else { fallbackCopy(text,done); }
  }
  function fallbackCopy(text, cb){
    try{
      const ta=document.createElement('textarea');
      ta.value=text; ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.focus(); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta);
      if(cb) cb();
    }catch(e){ toast('Gagal menyalin'); }
  }

  // ── Monitor user hotspot aktif ───────────────────────────────
  let _monTimer=null, _monPrev={}, _monCountdown=null, _monBusy=false;
  const MON_INTERVAL=4000; // poll tiap 4 detik

  function startMonitor(){
    if(_monTimer) return;
    loadMonitor();
    _monTimer=setInterval(loadMonitor, MON_INTERVAL);
    // countdown sisa waktu tiap detik (tanpa hit API)
    if(!_monCountdown) _monCountdown=setInterval(tickCountdown, 1000);
  }
  function stopMonitor(){
    if(_monTimer){ clearInterval(_monTimer); _monTimer=null; }
    if(_monCountdown){ clearInterval(_monCountdown); _monCountdown=null; }
    _monPrev={};
  }

  function fmtRate(bitsPerSec){
    const b=Number(bitsPerSec)||0;
    if(b<1000) return Math.round(b)+' bps';
    if(b<1e6) return (b/1e3).toFixed(1)+' Kbps';
    if(b<1e9) return (b/1e6).toFixed(2)+' Mbps';
    return (b/1e9).toFixed(2)+' Gbps';
  }
  function fmtDur(sec){
    sec=Math.max(0,Math.floor(Number(sec)||0));
    const d=Math.floor(sec/86400); sec-=d*86400;
    const h=Math.floor(sec/3600); sec-=h*3600;
    const m=Math.floor(sec/60); const s=sec-m*60;
    const p=n=>String(n).padStart(2,'0');
    if(d>0) return d+'h '+p(h)+':'+p(m)+':'+p(s);
    return p(h)+':'+p(m)+':'+p(s);
  }

  async function loadMonitor(){
    if(_monBusy) return; _monBusy=true;
    const btn=document.getElementById('monRefreshBtn');
    if(btn) btn.style.opacity='.5';
    try{
      const j=await api('/monitor');
      if(!j.success){ toast(j.message||'Gagal memuat data monitor'); return; }
      const list=j.data||[]; const now=Date.now();

      // Hitung kecepatan real-time dari selisih byte antar polling.
      // download = bytes_download (data KE user), upload = bytes_upload (DARI user).
      let totDl=0, totUl=0;
      list.forEach(u=>{
        const prev=_monPrev[u.username];
        u._dlRate=0; u._ulRate=0;
        if(prev){
          const dt=(now-prev.ts)/1000;
          if(dt>0.5){
            u._dlRate=Math.max(0,(u.bytes_download - prev.dl))*8/dt;
            u._ulRate=Math.max(0,(u.bytes_upload   - prev.ul))*8/dt;
          } else { u._dlRate=prev._dlRate||0; u._ulRate=prev._ulRate||0; }
        }
        totDl+=u._dlRate; totUl+=u._ulRate;
        // simpan snapshot baru + sisa waktu basis untuk countdown lokal
        _monPrev[u.username]={ dl:u.bytes_download, ul:u.bytes_upload, ts:now,
          _dlRate:u._dlRate, _ulRate:u._ulRate,
          left_sec:(u.left_sec==null?null:u.left_sec), left_ts:now };
      });
      // bersihkan snapshot user yang sudah offline
      const liveNames=new Set(list.map(u=>u.username));
      Object.keys(_monPrev).forEach(k=>{ if(!liveNames.has(k)) delete _monPrev[k]; });

      document.getElementById('msUsers').textContent=list.length;
      document.getElementById('msDown').textContent=fmtRate(totDl);
      document.getElementById('msUp').textContent=fmtRate(totUl);

      renderMonitor(list);
    }catch(e){
      toast('Terjadi kesalahan memuat data monitor');
    }finally{
      _monBusy=false; if(btn) btn.style.opacity='1';
    }
  }

  // Render daftar kartu monitor.
  // Kunci: kartu dibuat SEKALI per username, lalu polling berikutnya hanya
  // meng-update nilai teks (kecepatan, uptime, sisa waktu) tanpa membongkar
  // DOM — supaya angka berubah halus tanpa berkedip/loncat.
  function renderMonitor(list){
    const wrap=document.getElementById('monList');
    if(!list.length){
      wrap.innerHTML='<div class="empty"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg><div>Tidak ada user yang sedang online.</div></div>';
      return;
    }
    // Hapus placeholder kosong bila ada
    const emptyEl=wrap.querySelector('.empty'); if(emptyEl) wrap.innerHTML='';

    const seen=new Set();
    list.forEach(u=>{
      seen.add(u.username);
      let card=wrap.querySelector('.mon-card[data-u="'+cssEsc(u.username)+'"]');
      if(!card){ card=buildMonCard(u); wrap.appendChild(card); }
      updateMonCard(card,u);
    });
    // Buang kartu user yang sudah offline
    wrap.querySelectorAll('.mon-card').forEach(c=>{
      if(!seen.has(c.getAttribute('data-u'))) c.remove();
    });
  }

  function cssEsc(s){ return String(s).replace(/["\\]/g,'\\$&'); }

  // Buat kerangka kartu (struktur statis, nilai diisi updateMonCard).
  function buildMonCard(u){
    const c=document.createElement('div');
    c.className='mon-card';
    c.setAttribute('data-u',u.username);
    c.innerHTML=`
      <div class="mc-top">
        <span class="mc-dot"></span>
        <span class="mc-name">${esc(u.username)}</span>
        <span class="mc-prof" data-f="prof"></span>
      </div>
      <div class="mc-rate">
        <div class="mc-r dl">
          <span class="ri"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 5-5m-5 5-5-5"/><path d="M4 21h16"/></svg></span>
          <div><div class="rl">Download</div><div class="rv" data-f="dl">0 bps</div></div>
        </div>
        <div class="mc-r ul">
          <span class="ri"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V9m0 0 5 5m-5-5-5 5"/><path d="M4 3h16"/></svg></span>
          <div><div class="rl">Upload</div><div class="rv" data-f="ul">0 bps</div></div>
        </div>
      </div>
      <div class="mc-grid">
        <div class="mc-item">
          <div class="l"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>Paket</div>
          <div class="v" data-f="pkg">-</div>
        </div>
        <div class="mc-item">
          <div class="l"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Uptime</div>
          <div class="v" data-f="up">-</div>
        </div>
        <div class="mc-item">
          <div class="l"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>Sisa Waktu</div>
          <div class="v left" data-f="left">-</div>
        </div>
        <div class="mc-item">
          <div class="l"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 5-5m-5 5-5-5"/><path d="M4 21h16"/></svg>Total Download</div>
          <div class="v dlt" data-f="totIn">-</div>
        </div>
        <div class="mc-item">
          <div class="l"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V9m0 0 5 5m-5-5-5 5"/><path d="M4 3h16"/></svg>Total Upload</div>
          <div class="v ult" data-f="totOut">-</div>
        </div>
      </div>
      <div class="mc-meta">
        <span class="mc-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M22 9H2"/></svg><span data-f="ip"></span></span>
        <span class="mc-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/></svg><span data-f="mac"></span></span>
      </div>
      <div class="mc-act">
        <button class="mc-btn copy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Salin User</button>
        <button class="mc-btn cut"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><path d="M12 2v10"/></svg>Putus Sesi</button>
      </div>`;
    const uname=u.username;
    c.querySelector('.mc-btn.copy').addEventListener('click',()=>copyVoucher(uname,''));
    c.querySelector('.mc-btn.cut').addEventListener('click',()=>monDisconnect(uname));
    return c;
  }

  // Update nilai-nilai kartu yang berubah (dipanggil tiap polling).
  function updateMonCard(card,u){
    const set=(f,val)=>{ const el=card.querySelector('[data-f="'+f+'"]'); if(el && el.textContent!==val) el.textContent=val; };
    const prof=u.profile||'-';
    set('prof',prof);
    set('pkg',prof);
    set('dl',fmtRate(u._dlRate||0));
    set('ul',fmtRate(u._ulRate||0));
    set('up',u.uptime||'-');
    set('ip',u.address||'-');
    set('mac',u.mac||'-');
    set('totIn',fmtBytes(Number(u.bytes_download)||0));
    set('totOut',fmtBytes(Number(u.bytes_upload)||0));
    // Sisa waktu
    const leftEl=card.querySelector('[data-f="left"]');
    if(leftEl){
      if(u.left_sec==null){
        leftEl.textContent='∞ Unlimited';
        leftEl.className='v left';
        leftEl.removeAttribute('data-left');
      } else {
        leftEl.setAttribute('data-left',u.username);
        leftEl.textContent=fmtDur(u.left_sec);
        leftEl.className='v '+(u.left_sec<300?'warn':'left');
      }
    }
  }

  // Countdown sisa waktu lokal (update angka tanpa polling API).
  function tickCountdown(){
    const now=Date.now();
    document.querySelectorAll('[data-left]').forEach(el=>{
      const name=el.getAttribute('data-left');
      const p=_monPrev[name];
      if(!p || p.left_sec==null) return;
      const elapsed=(now-p.left_ts)/1000;
      const remain=Math.max(0,p.left_sec-elapsed);
      el.textContent=fmtDur(remain);
      el.classList.toggle('warn', remain<300);
      el.classList.toggle('left', remain>=300);
    });
  }

  async function monDisconnect(username){
    if(!await confirmDialog({ title:'Putuskan Sesi?', tone:'warn', okText:'Ya, Putuskan',
      message:'Sesi user <b>'+esc(username)+'</b> akan diputus dari router.' })) return;
    try{
      const j=await api('/vouchers/action',{ method:'POST', body:{ username, action:'disconnect' } });
      if(j.success){ toast(j.message||'Sesi diputus'); delete _monPrev[username]; loadMonitor(); }
      else toast(j.message||'Gagal');
    }catch(e){ toast('Terjadi kesalahan'); }
  }

  async function vAction(username, action){
    const labels={ delete:'Hapus voucher', disconnect:'Putus sesi', disable:'Nonaktifkan', enable:'Aktifkan' };
    if(action==='delete' && !await confirmDialog({ title:'Hapus Voucher?', tone:'danger', okText:'Ya, Hapus',
      message:'Voucher <b>'+esc(username)+'</b> akan dihapus dari router. Tindakan ini tidak bisa dibatalkan.' })) return;
    try{
      const j = await api('/vouchers/action',{ method:'POST', body:{ username, action } });
      if(action==='delete'){
        if(j.success){ loadVouchers(); resultDialog({ ok:true, title:'Voucher Dihapus', message:'Voucher <b>'+esc(username)+'</b> berhasil dihapus dari router.' }); }
        else resultDialog({ ok:false, title:'Gagal Menghapus', message:esc(j.message||'Voucher gagal dihapus. Coba lagi.') });
      } else {
        if(j.success){ toast(j.message||(labels[action]+' berhasil')); loadVouchers(); }
        else toast(j.message||'Gagal');
      }
    }catch(e){
      if(action==='delete') resultDialog({ ok:false, title:'Gagal Menghapus', message:'Terjadi kesalahan saat menghubungi router.' });
      else toast('Terjadi kesalahan');
    }
  }

  // Detail lengkap satu voucher (dari data yang sudah dimuat).
  const VSTATUS_LABEL={ active:'Online (sedang dipakai)', used:'Terpakai', expired:'Expired / habis', unused:'Belum dipakai' };
  const VD_BADGE={ active:'ONLINE', used:'TERPAKAI', expired:'EXPIRED', unused:'BELUM DIPAKAI' };
  function showVoucherDetail(username){
    const v=(VOUCHERS||[]).find(x=>x.username===username);
    if(!v){ toast('Data voucher tidak ditemukan'); return; }
    const st=v.status||'unused';

    // Header: nama, profil, badge & ikon sesuai status.
    document.getElementById('vdTitle').textContent='Voucher '+v.username;
    document.getElementById('vdSub').textContent='Profil '+(v.profile||'-');
    const badge=document.getElementById('vdBadge');
    badge.className='vd-badge s-'+st; badge.textContent=VD_BADGE[st]||st.toUpperCase();
    document.getElementById('vdIcon').className='vd-ic s-'+st;

    // Baris detail dalam kartu.
    const row=(label,val,cls)=>`<div class="vd-row"><span class="l">${esc(label)}</span><span class="v ${cls||''}">${val}</span></div>`;
    let rows='';
    rows+=row('Status', esc(VSTATUS_LABEL[st]||st));
    rows+=row('Username', esc(v.username), 'mono');
    if(v.password) rows+=row('Sandi', esc(v.password), 'mono');
    rows+=row('Profil', esc(v.profile||'-'));
    if(v.server) rows+=row('Server', esc(v.server));
    if(st!=='unused'){
      rows+=row('Waktu terpakai', esc(v.uptime||'0s'));
      rows+=row('Data terpakai', fmtBytes(v.bytes_total));
    }
    if(v.time_left_sec!=null) rows+=row('Sisa waktu', fmtDurShort(v.time_left_sec), 'hl');
    if(v.limit_uptime) rows+=row('Batas waktu', esc(v.limit_uptime));
    if(v.quota_left_bytes!=null) rows+=row('Sisa kuota', fmtBytes(v.quota_left_bytes), 'hl');
    if(v.limit_bytes_total>0) rows+=row('Batas kuota', fmtBytes(v.limit_bytes_total));
    document.getElementById('vdBody').innerHTML='<div class="vd-card">'+rows+'</div>';

    // Aksi cepat.
    const close="document.getElementById('vDetailModal').classList.remove('show')";
    let actions='<div class="vd-acts">';
    actions+=`<button class="btn btn-soft" onclick="copyVoucher('${esc(v.username)}','${esc(v.password||'')}')">Salin</button>`;
    if(st==='active') actions+=`<button class="btn btn-soft" onclick="${close};vAction('${esc(v.username)}','disconnect')">Putus Sesi</button>`;
    actions+=`<button class="btn btn-del" onclick="${close};vAction('${esc(v.username)}','delete')">Hapus</button>`;
    actions+='</div>';
    actions+=`<button class="btn btn-outline vd-close" onclick="${close}">Tutup</button>`;
    document.getElementById('vdActions').innerHTML=actions;

    document.getElementById('vDetailModal').classList.add('show');
  }

  // ── Selection modal: pilih voucher untuk cetak / hapus ────────
  // State modal pilihan voucher.
  const SEL_BADGE={ active:{t:'ONLINE',c:'b-active'}, used:{t:'TERPAKAI',c:'b-used'}, expired:{t:'EXPIRED',c:'b-expired'}, unused:{t:'BELUM',c:'b-unused'} };
  const SEL_RENDER_STEP=80;          // render bertahap agar ratusan/ribuan voucher tidak berat
  let _sel={ mode:'print', scope:'unused', pool:[], filtered:[], picked:new Set(), shown:0, q:'' };

  function _scopeLabel(s){ return ({expired:'Expired', unused:'Belum dipakai', active:'Online', used:'Terpakai'})[s]||s; }

  // Buka modal pilihan. mode: 'print' | 'delete'. scope menentukan voucher kandidat.
  function openSelModal(mode, scope){
    const pool=(VOUCHERS||[]).filter(v=>v.status===scope);
    if(!pool.length){
      toast(mode==='print' ? 'Tidak ada voucher untuk dicetak' : 'Tidak ada voucher '+_scopeLabel(scope));
      return;
    }
    _sel={ mode, scope, pool, filtered:pool.slice(), picked:new Set(pool.map(v=>v.username)), shown:0, q:'' };

    // Header & tombol aksi sesuai mode.
    const icon=document.getElementById('selIcon');
    const actBtn=document.getElementById('selAction');
    if(mode==='print'){
      icon.className='sel-ic blue';
      icon.innerHTML='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>';
      document.getElementById('selTitle').textContent='Cetak Voucher';
      actBtn.className='btn btn-teal';
    } else {
      const danger=scope==='expired';
      icon.className='sel-ic '+(danger?'danger':'warn');
      icon.innerHTML='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>';
      document.getElementById('selTitle').textContent='Hapus Voucher';
      actBtn.className='btn '+(danger?'btn-danger':'btn-warn');
    }
    document.getElementById('selSub').textContent=_scopeLabel(scope)+' • '+pool.length+' voucher';
    document.getElementById('selSearch').value='';
    document.getElementById('selModal').classList.add('show');
    selRenderList(true);
    selUpdateBar();
  }
  function closeSelModal(){ document.getElementById('selModal').classList.remove('show'); }

  function selOnSearch(){
    _sel.q=document.getElementById('selSearch').value.trim().toLowerCase();
    _sel.filtered = _sel.q
      ? _sel.pool.filter(v=>v.username.toLowerCase().includes(_sel.q) || (v.profile||'').toLowerCase().includes(_sel.q))
      : _sel.pool.slice();
    selRenderList(true);
    selUpdateBar();
  }

  // Render daftar voucher secara bertahap (chunk) agar ribuan item tetap ringan.
  function selRenderList(reset){
    const box=document.getElementById('selList');
    if(reset){ _sel.shown=0; box.innerHTML=''; }
    if(!_sel.filtered.length){
      box.innerHTML='<div class="sel-empty">Tidak ada voucher yang cocok.</div>';
      return;
    }
    const end=Math.min(_sel.shown+SEL_RENDER_STEP, _sel.filtered.length);
    const frag=[];
    for(let i=_sel.shown;i<end;i++){
      const v=_sel.filtered[i];
      const b=SEL_BADGE[v.status]||SEL_BADGE.unused;
      const on=_sel.picked.has(v.username);
      frag.push(`<div class="sel-item${on?' on':''}" data-u="${esc(v.username)}" onclick="selToggleItem('${esc(v.username)}',this)">
        <span class="sel-cbox"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
        <div class="si-mid">
          <div class="si-u">${esc(v.username)}</div>
          <div class="si-s">Profil ${esc(v.profile||'-')}</div>
        </div>
        <span class="si-badge ${b.c}">${b.t}</span>
      </div>`);
    }
    _sel.shown=end;
    // Hapus tombol "muat lebih" lama bila ada, lalu render chunk + tombol baru.
    const oldMore=box.querySelector('.sel-loadmore'); if(oldMore) oldMore.remove();
    box.insertAdjacentHTML('beforeend', frag.join(''));
    if(_sel.shown < _sel.filtered.length){
      const rest=_sel.filtered.length-_sel.shown;
      box.insertAdjacentHTML('beforeend',
        `<div class="sel-loadmore" onclick="selRenderList(false)">Tampilkan ${Math.min(SEL_RENDER_STEP,rest)} lagi (sisa ${rest})</div>`);
    }
  }

  function selToggleItem(username, el){
    if(_sel.picked.has(username)){ _sel.picked.delete(username); el.classList.remove('on'); }
    else { _sel.picked.add(username); el.classList.add('on'); }
    selUpdateBar();
  }

  // "Pilih semua" / "Hapus pilihan" — berlaku pada hasil filter saat ini.
  function selToggleAll(){
    const allPicked=_sel.filtered.every(v=>_sel.picked.has(v.username));
    if(allPicked) _sel.filtered.forEach(v=>_sel.picked.delete(v.username));
    else _sel.filtered.forEach(v=>_sel.picked.add(v.username));
    // Sinkronkan tampilan item yang sudah terender.
    document.querySelectorAll('#selList .sel-item').forEach(el=>{
      el.classList.toggle('on', _sel.picked.has(el.dataset.u));
    });
    selUpdateBar();
  }

  function selUpdateBar(){
    const n=_sel.picked.size;
    document.getElementById('selCount').textContent=n;
    const total=_sel.pool.length, fcount=_sel.filtered.length;
    document.getElementById('selLimInfo').textContent =
      (_sel.q ? (fcount+' cocok dari '+total) : ('Total '+total+' voucher'));
    const allPicked=_sel.filtered.length && _sel.filtered.every(v=>_sel.picked.has(v.username));
    document.getElementById('selAllBtn').textContent = allPicked ? 'Hapus pilihan' : 'Pilih semua';
    const actBtn=document.getElementById('selAction');
    actBtn.disabled = (n===0);
    actBtn.textContent = _sel.mode==='print' ? ('Cetak '+n+' Voucher') : ('Hapus '+n+' Voucher');
  }

  // Jalankan aksi atas voucher yang dipilih.
  async function selConfirm(){
    const usernames=[..._sel.picked];
    if(!usernames.length){ toast('Belum ada voucher dipilih'); return; }

    if(_sel.mode==='print'){
      // Simpan daftar pilihan untuk dibaca halaman cetak (POST tak praktis untuk window baru).
      try{
        sessionStorage.setItem('reseller_print_sel', JSON.stringify({
          usernames, label:_scopeLabel(_sel.scope)+' (terpilih)'
        }));
      }catch(_){}
      closeSelModal();
      window.open('/reseller/print-sel','_blank');
      return;
    }

    // mode delete → konfirmasi tegas lebih dulu.
    const danger=_sel.scope==='expired';
    const ok=await confirmDialog({
      title:'Hapus '+usernames.length+' Voucher?',
      tone: danger?'danger':'warn',
      okText:'Ya, Hapus '+usernames.length,
      message:'<b>'+usernames.length+'</b> voucher "'+esc(_scopeLabel(_sel.scope))+'" akan dihapus dari router. Tindakan ini tidak bisa dibatalkan.'
    });
    if(!ok) return;
    closeSelModal();
    toast('Menghapus '+usernames.length+' voucher…');
    try{
      const j=await api('/vouchers/bulk',{ method:'POST', body:{ action:'delete', usernames } });
      if(j.success){
        loadVouchers();
        const n=(j.deleted!=null?j.deleted:usernames.length);
        const failed=(j.failed||0);
        if(failed && n){
          resultDialog({ ok:true, title:'Sebagian Dihapus', message:'<b>'+n+'</b> voucher berhasil dihapus, <b>'+failed+'</b> gagal.' });
        } else if(!n && failed){
          resultDialog({ ok:false, title:'Gagal Menghapus', message:'Semua voucher gagal dihapus ('+failed+').' });
        } else {
          resultDialog({ ok:true, title:'Voucher Dihapus', message:'<b>'+n+'</b> voucher berhasil dihapus dari router.' });
        }
      } else {
        resultDialog({ ok:false, title:'Gagal Menghapus', message:esc(j.message||'Voucher gagal dihapus. Coba lagi.') });
      }
    }catch(e){
      resultDialog({ ok:false, title:'Gagal Menghapus', message:'Terjadi kesalahan saat menghubungi router.' });
    }
  }

