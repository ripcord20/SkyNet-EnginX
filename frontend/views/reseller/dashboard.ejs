        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2456d6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h12"/></svg></div></div>`);
      if(hasQris){
