  // Cek status sekali (dipakai setelah Snap onSuccess, lebih responsif).
  async function pollStatusOnce(id){
    try{
      const j = await api('/topup/'+id+'/status');
      if(j.success && j.data.status==='paid'){
        if(_pollTimer){ clearInterval(_pollTimer); _pollTimer=null; }
        _markTopupPaid(j.data);
      }
    }catch(e){}
  }
  function startPollStatus(id){
    if(_pollTimer) clearInterval(_pollTimer);
    let tries=0;
    _pollTimer = setInterval(async ()=>{
      tries++;
      if(tries>60){ clearInterval(_pollTimer); _pollTimer=null; return; } // stop ~5 menit
      try{
        const j = await api('/topup/'+id+'/status');
        if(j.success && j.data.status==='paid'){
          clearInterval(_pollTimer); _pollTimer=null;
          _markTopupPaid(j.data);
        }
      }catch(e){}
    }, 5000);
  }

  // Muat Snap.js Midtrans sekali (in-page popup, seperti portal customer).
  function loadMidtransSnap(clientKey, env){
    return new Promise((resolve, reject)=>{
      if(window.snap) return resolve();
      const existing = document.getElementById('midtrans-snap');
      if(existing){
        let tries=0;
        const iv=setInterval(()=>{
          if(window.snap){ clearInterval(iv); resolve(); }
          else if(++tries>50){ clearInterval(iv); reject(new Error('Snap.js timeout')); }
        },100);
        return;
      }
      const s=document.createElement('script');
      s.id='midtrans-snap';
      s.src = (env==='production')
        ? 'https://app.midtrans.com/snap/snap.js'
        : 'https://app.sandbox.midtrans.com/snap/snap.js';
      s.setAttribute('data-client-key', clientKey||'');
      s.onload = ()=>resolve();
      s.onerror = ()=>reject(new Error('Gagal load Snap.js'));
      document.head.appendChild(s);
    });
  }

  function closeTopupDone(){ if(_pollTimer){clearInterval(_pollTimer);_pollTimer=null;} closeModal(); loadDashboard(); }

