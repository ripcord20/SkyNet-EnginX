    pending:{t:'Menunggu',c:'#a9760a',b:'#fef6e0'},
    waiting_verification:{t:'Menunggu Verifikasi',c:'#a9760a',b:'#fef6e0'},
    paid:{t:'Lunas',c:'#0a9a5a',b:'#e7f7ef'},
    rejected:{t:'Ditolak',c:'#c0392f',b:'#fdeaea'},
    expired:{t:'Kedaluwarsa',c:'#8a95ad',b:'#f3f5fa'}
  };
  async function showTopupHistory(){
    showTopupStep(4);
    const list=document.getElementById('topupHistList');
    list.innerHTML='<div class="skel" style="height:60px"></div>';
    try{
      const j = await api('/topups?limit=30');
      const rows=j.data||[];
      if(!rows.length){ list.innerHTML='<div class="empty">Belum ada top-up.</div>'; return; }
      list.innerHTML = rows.map(t=>{
        const st=TOPUP_STATUS[t.status]||TOPUP_STATUS.pending;
        const ml = t.method==='gateway'?'Otomatis':(t.method==='qris'?'QRIS':'Manual');
        const d=new Date(t.created_at).toLocaleDateString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'});
        const resume = (t.status==='pending'&&t.method==='gateway'&&t.payment_url)?`<button class="vc-copy" onclick="window.open('${esc(t.payment_url)}','_blank')" title="Lanjut bayar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>`:'';
        // Tombol batalkan untuk top-up yang masih menunggu (belum lunas).
        const canCancel = (t.status==='pending'||t.status==='waiting_verification');
        const cancelBtn = canCancel?`<button class="vc-copy" onclick="cancelTopup(${t.id})" title="Batalkan"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c0392f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>`:'';
        return `<div class="tx" style="cursor:default">
          <div class="tx-ic topup"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg></div>
          <div class="tx-mid"><div class="tx-desc">${fmtRp(t.amount)} • ${ml}</div>
          <div class="tx-sub">${d} • <span style="color:${st.c};font-weight:700">${st.t}</span></div></div>
          ${resume}${cancelBtn}
        </div>`;
      }).join('');
    }catch(e){ list.innerHTML='<div class="empty">Gagal memuat.</div>'; }
  }

  async function cancelTopup(id){
    if(!await confirmDialog({ title:'Batalkan Top-up?', tone:'warn', okText:'Ya, Batalkan', cancelText:'Tidak',
      message:'Permintaan isi saldo ini akan dibatalkan. <b>Jika Anda sudah terlanjur membayar, jangan dibatalkan.</b>' })) return;
    try{
      const j = await api('/topup/'+id+'/cancel',{ method:'POST' });
      if(j.success){ toast(j.message||'Top-up dibatalkan'); showTopupHistory(); }
      else toast(j.message||'Gagal membatalkan');
    }catch(e){ toast('Terjadi kesalahan'); }
  }

  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
</script>
</body>
</html>
