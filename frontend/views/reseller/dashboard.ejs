  // Dari Home: buka tab Generate lalu pilih paket tertentu.
  function goGenerateWith(i){
    switchTab('generate');
    setTimeout(()=>selectPkg(i), 60);
  }

  function selectPkg(i){
    SELECTED = PACKAGES[i];
    document.querySelectorAll('.pkg').forEach(el=>el.classList.toggle('sel', +el.dataset.i===i));
    document.getElementById('genBox').style.display='block';
    setQty(5);
    document.getElementById('genBox').scrollIntoView({behavior:'smooth',block:'center'});
  }

  function stepQty(d){ const el=document.getElementById('qty'); setQty((parseInt(el.value)||0)+d); }
  function setQty(v){
    const max = RESELLER ? RESELLER.max_per_batch : 100;
    v = Math.max(1, Math.min(max, v||1));
    document.getElementById('qty').value = v; recalc();
  }
  function recalc(){
    if(!SELECTED) return;
    const qty = Math.max(0, parseInt(document.getElementById('qty').value)||0);
    const total = qty * SELECTED.cost_price;
    const el = document.getElementById('totalCost');
    el.textContent = fmtRp(total);
    const over = RESELLER && total > RESELLER.balance;
    el.classList.toggle('over', over);
    document.getElementById('btnGen').disabled = over || qty<1;
    document.getElementById('btnGenText').textContent = over ? 'Saldo tidak cukup' : 'Generate Voucher';
  }

  async function doGenerate(){
    if(!SELECTED) return;
    const qty = parseInt(document.getElementById('qty').value)||0;
    if(qty<1) return;
    const btn=document.getElementById('btnGen'), txt=document.getElementById('btnGenText');
    btn.disabled=true; const old=txt.innerHTML;
    txt.innerHTML='<span class="spinner"></span>'; txt.style.display='flex'; txt.style.alignItems='center';
    try{
      const j = await api('/generate', { method:'POST', body:{ package_id: SELECTED.id, count: qty } });
      if(!j.success){ toast(j.message||'Gagal generate'); }
      else{
        LAST_VOUCHERS = j.data.vouchers; LAST_TXID = j.data.transaction_id;
        document.getElementById('balance').textContent = fmtRp(j.data.balance);
        if(RESELLER) RESELLER.balance = j.data.balance;
        showResult(j.data);
        loadDashboard();
      }
    }catch(e){ toast('Terjadi kesalahan jaringan'); }
    finally{ txt.innerHTML=old; btn.disabled=false; recalc(); }
  }

  function showResult(d){
    document.getElementById('resTitle').textContent = d.created+' voucher dibuat';
    document.getElementById('resSub').textContent =
      d.package.name + ' • Harga jual '+fmtRp(d.package.sell_price)+' / voucher' +
      (d.failed>0 ? ' • '+d.failed+' gagal (saldo dikembalikan)' : '');
    document.getElementById('vcList').innerHTML = d.vouchers.map(v=>`
      <div class="vc">
        <div>
          <div class="vc-user">${esc(v.username)}</div>
          <div class="vc-pw">Sandi: ${esc(v.password)}</div>
        </div>
        <button class="vc-copy" onclick="copyVc('${esc(v.username)}','${esc(v.password)}')" aria-label="Salin">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
      </div>`).join('');
    document.getElementById('resultModal').classList.add('show');
  }
  function copyVc(u,p){ navigator.clipboard.writeText('User: '+u+'  Pass: '+p).then(()=>toast('Voucher disalin')); }
  function printVouchers(){ if(LAST_TXID) window.open('/reseller/print/'+LAST_TXID,'_blank'); }

  // ── History ──────────────────────────────────────────────────
  const TX_META = {
    purchase:{ic:'purchase',label:'Voucher',svg:'<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>'},
    topup:{ic:'topup',label:'Top-up',svg:'<path d="M12 5v14M5 12h14"/>'},
    refund:{ic:'refund',label:'Refund',svg:'<path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/>'},
    adjust:{ic:'adjust',label:'Penyesuaian',svg:'<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>'}
  };
  async function loadHistory(reset){
    if(histLoading) return; histLoading=true;
    if(reset){ histPage=1; histDone=false; document.getElementById('histList').innerHTML=''; }
    try{
      const j = await api('/history?page='+histPage+'&limit=15');
      const list=document.getElementById('histList');
      if(histPage===1 && (!j.data||!j.data.length)){
        list.innerHTML='<div class="empty"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg><div>Belum ada transaksi.</div></div>';
        histDone=true; document.getElementById('histMore').style.display='none'; histLoading=false; return;
      }
      list.insertAdjacentHTML('beforeend', j.data.map(tx=>{
        const m=TX_META[tx.type]||TX_META.adjust;
        const sign = tx.amount>=0?'plus':'minus';
        const amt = (tx.amount>=0?'+':'') + fmtRp(Math.abs(tx.amount));
        const d=new Date(tx.created_at);
        const date=d.toLocaleDateString('id-ID',{day:'2-digit',month:'short'})+' • '+d.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit'});
        const clickable = tx.type==='purchase' ? `onclick="openTx(${tx.id})"` : '';
        return `<div class="tx" ${clickable}>
          <div class="tx-ic ${m.ic}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${m.svg}</svg></div>
          <div class="tx-mid">
            <div class="tx-desc">${esc(tx.description||m.label)}</div>
            <div class="tx-sub">${date}${tx.voucher_count?(' • '+tx.voucher_count+' voucher'):''}</div>
          </div>
          <div style="text-align:right">
            <div class="tx-amt ${sign}">${amt}</div>
            <div class="tx-bal">Sisa ${fmtRp(tx.balance_after)}</div>
          </div>
        </div>`;
      }).join(''));
      if(j.pagination && histPage>=j.pagination.pages){ histDone=true; document.getElementById('histMore').style.display='none'; }
      else { document.getElementById('histMore').style.display='inline-flex'; }
    }catch(e){}
    finally{ histLoading=false; }
  }
  function loadMoreHistory(){ if(histDone) return; histPage++; loadHistory(false); }

