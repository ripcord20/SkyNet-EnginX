  async function chooseMethod(method, el){
    const amount = parseInt(document.getElementById('topupAmount').value)||0;
    if(!TOPUP_CFG || amount < TOPUP_CFG.min_topup){ toast('Minimal top-up '+fmtRp(TOPUP_CFG?TOPUP_CFG.min_topup:10000)); return; }
    document.querySelectorAll('#topupMethods .pkg').forEach(p=>p.classList.remove('sel'));
    if(el) el.classList.add('sel');

    try{
      const promoCode = (document.getElementById('promoCode')?.value || '').trim();
      const j = await api('/topup', { method:'POST', body:{ method, amount, promo_code: promoCode || undefined, tripay_method: method==='gateway'?(TOPUP_CFG.gateway_provider==='tripay'?'QRIS':undefined):undefined } });
      if(!j.success){ toast(j.message||'Gagal membuat top-up'); return; }
      CURRENT_TOPUP = j.data;
      if(method==='gateway'){
        // MIDTRANS → tampilkan Snap popup IN-PAGE (tetap di halaman ini).
        // Provider lain (tripay/duitku/xendit) tetap diarahkan ke URL bayar.
        if(j.data.mode==='midtrans' && j.data.snap_token){
          showTopupStep(3);
          document.getElementById('t3Title').textContent='Menunggu Pembayaran';
          document.getElementById('t3Sub').innerHTML='Selesaikan pembayaran pada jendela yang muncul.<br>Saldo akan masuk otomatis setelah lunas.';
          startPollStatus(j.data.id);
          try{
            await loadMidtransSnap(j.data.client_key, j.data.env);
            window.snap.pay(j.data.snap_token, {
              onSuccess: ()=>{ pollStatusOnce(j.data.id); },
              onPending: ()=>{ toast('Pembayaran tertunda, menunggu konfirmasi'); },
              onError:   ()=>{ toast('Pembayaran gagal / dibatalkan'); },
              onClose:   ()=>{ /* tetap di step 3, polling jalan terus */ }
            });
          }catch(e){
            // Fallback: kalau Snap.js gagal dimuat, buka URL bayar.
            toast('Membuka halaman pembayaran…');
            if(j.data.payment_url) window.open(j.data.payment_url, '_blank');
          }
        } else {
          // tripay / duitku / xendit → buka URL pembayaran provider.
          if(j.data.payment_url){ window.open(j.data.payment_url, '_blank'); }
          showTopupStep(3);
          document.getElementById('t3Title').textContent='Menunggu Pembayaran';
          document.getElementById('t3Sub').innerHTML='Selesaikan pembayaran di halaman yang terbuka.<br>Saldo akan masuk otomatis setelah lunas.';
          startPollStatus(j.data.id);
        }
      } else {
        // Manual / QRIS → tampilkan instruksi + upload
        renderManualInstructions(method, j.data);
        showTopupStep(2);
      }
    }catch(e){ toast('Terjadi kesalahan'); }
  }

  function renderManualInstructions(method, data){
