  // ── Report ───────────────────────────────────────────────────
  let _chartSales=null, _chartDonut=null, _chartDays=14;
  const CH_COLORS = { blue:'#2456d6', teal:'#1565e0', green:'#0a9a5a', amber:'#b9810b', donut:['#1565e0','#2456d6','#0a9a5a','#b9810b','#6366f1','#e5484d','#0891b2','#7a869e'] };

  async function loadReport(){
