      const j=await api('/topup/promo-check?code='+encodeURIComponent(code)+'&amount='+amount);
      if(j.success){ msg.style.color='#0a9a5a'; msg.textContent='✓ '+(j.message||'Promo berlaku'); }
      else { msg.style.color='#dc2626'; msg.textContent='✕ '+(j.message||'Promo tidak berlaku'); }
