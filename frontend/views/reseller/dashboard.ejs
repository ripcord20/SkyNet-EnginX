        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1565e0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></div></div>`);
    }
