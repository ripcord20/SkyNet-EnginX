<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#1565e0">
  <link rel="manifest" href="/reseller-manifest.json">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/img/reseller/icon-192.png">
  <title>Reseller Voucher — Masuk</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#f4f7fb;--card:#fff;--ink:#0f1b34;--muted:#8a95ad;--line:#eef1f7;
      --blue:#1f7aff;--teal:#1f8bff;--teal-deep:#1565e0;--red:#e5484d;
    }
    *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
    html,body{height:100%;}
    body{
      font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--ink);
      min-height:100dvh;display:flex;flex-direction:column;
      -webkit-font-smoothing:antialiased;
    }
    /* Bungkus utama — batasi lebar & jadikan kolom penuh tinggi layar */
    .wrap{width:100%;max-width:460px;margin:0 auto;flex:1;display:flex;flex-direction:column;min-height:100dvh;}
    /* Hero */
    .hero{
      position:relative;overflow:hidden;flex-shrink:0;
      background:linear-gradient(150deg,#1f8bff 0%,#1565e0 55%,#0e4fb8 100%);
      color:#fff;padding:52px 30px 64px;
    }
    .hero::after{content:'';position:absolute;top:-70px;right:-50px;width:240px;height:240px;
      background:radial-gradient(circle,rgba(255,255,255,.20),transparent 70%);pointer-events:none;z-index:1;}
    .hero::before{content:'';position:absolute;bottom:-90px;left:-60px;width:220px;height:220px;
      background:radial-gradient(circle,rgba(47,107,255,.28),transparent 70%);pointer-events:none;z-index:1;}
    /* Foto background tipis (sumber: setting halaman pendaftaran) */
    .hero-bg{position:absolute;inset:0;background-size:cover;background-position:center;
      opacity:.16;mix-blend-mode:luminosity;pointer-events:none;z-index:0;}
    .hero-bg::after{content:'';position:absolute;inset:0;
      background:linear-gradient(150deg,rgba(31,139,255,.55) 0%,rgba(21,101,224,.6) 55%,rgba(14,79,184,.62) 100%);}
    .brand{position:relative;z-index:2;}
    .brand .nm{font-size:16px;font-weight:800;letter-spacing:-.2px;}
    .brand .sub{font-size:11.5px;color:rgba(255,255,255,.82);font-weight:500;margin-top:2px;}
    .hero h1{position:relative;z-index:2;margin-top:30px;font-size:26px;font-weight:800;letter-spacing:-.7px;line-height:1.16;}
    .hero p{position:relative;z-index:2;margin-top:9px;font-size:13.5px;color:rgba(255,255,255,.86);font-weight:500;line-height:1.5;max-width:300px;}
    /* Sheet: tarik naik menimpa hero, isi sisa ruang, dorong footer ke bawah */
    .sheet{flex:1;margin-top:-36px;background:var(--bg);border-radius:28px 28px 0 0;
      position:relative;z-index:3;padding:28px 22px 0;display:flex;flex-direction:column;}
    .card{background:#fff;border:1px solid var(--line);border-radius:22px;
      padding:26px 22px;box-shadow:0 18px 44px rgba(20,40,90,.08);}
    .card h2{font-size:19px;font-weight:800;letter-spacing:-.3px;}
    .card .hint{font-size:12.5px;color:var(--muted);margin-top:5px;margin-bottom:22px;font-weight:500;}
    .field{margin-bottom:15px;}
    .field label{display:block;font-size:12.5px;font-weight:700;color:#54607a;margin-bottom:7px;}
    .inp-wrap{position:relative;}
    .inp-wrap svg.lead{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#b3bccf;pointer-events:none;}
    .inp-wrap input{width:100%;padding:14px 14px 14px 42px;border:1.5px solid var(--line);
      background:#fbfcfe;border-radius:13px;font-size:14.5px;font-family:inherit;outline:none;
      transition:border .15s,background .15s,box-shadow .15s;color:var(--ink);}
    .inp-wrap input:focus{border-color:var(--teal);background:#fff;box-shadow:0 0 0 4px rgba(31,139,255,.1);}
    .inp-wrap input::placeholder{color:#c3cad8;}
    .pw-toggle{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;
      border:none;padding:8px;cursor:pointer;color:#aeb7c9;display:flex;}
    .err{display:none;background:#fdeaea;color:#c0392f;border:1px solid #f5d2cf;
      border-radius:11px;padding:10px 13px;font-size:12.5px;font-weight:600;margin-bottom:14px;}
    .btn{width:100%;padding:15px;border:none;border-radius:14px;font-family:inherit;
      font-size:15px;font-weight:800;letter-spacing:-.2px;color:#fff;cursor:pointer;margin-top:4px;
      background:linear-gradient(135deg,#1f8bff,#1565e0);box-shadow:0 10px 24px rgba(31,122,255,.32);
      display:flex;align-items:center;justify-content:center;gap:9px;transition:filter .15s,transform .08s;}
    .btn:active{transform:scale(.985);}
    .btn:disabled{filter:saturate(.6) brightness(1.05);cursor:not-allowed;}
    .spinner{width:18px;height:18px;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;
      border-radius:50%;animation:spin .7s linear infinite;display:none;}
    @keyframes spin{to{transform:rotate(360deg);}}
    .note{text-align:center;font-size:12px;color:var(--muted);margin-top:20px;line-height:1.6;}
    .note b{color:#54607a;font-weight:700;}
    .wa-link{color:var(--teal-deep);font-weight:800;text-decoration:none;border-bottom:1.5px solid rgba(21,101,224,.3);padding-bottom:1px;transition:border-color .15s;}
    .wa-link:hover{border-color:var(--teal-deep);}
    /* ── Promo slideshow (gaya app provider besar) ── */
    .promo{margin:22px 0 4px;}
    .promo-head{display:flex;align-items:center;justify-content:space-between;margin:0 2px 11px;}
    .promo-head .pt{font-size:13px;font-weight:800;color:#54607a;letter-spacing:-.2px;display:flex;align-items:center;gap:7px;}
    .promo-head .pt svg{color:var(--teal-deep);}
    .promo-head .pall{font-size:11.5px;font-weight:700;color:var(--teal-deep);text-decoration:none;}
    .promo-track{display:flex;gap:13px;overflow-x:auto;scroll-snap-type:x mandatory;
      -webkit-overflow-scrolling:touch;padding:2px 2px 4px;scrollbar-width:none;}
    .promo-track::-webkit-scrollbar{display:none;}
    .slide{flex:0 0 100%;scroll-snap-align:center;position:relative;border-radius:20px;overflow:hidden;
      min-height:152px;padding:20px 19px;color:#fff;display:flex;flex-direction:column;justify-content:space-between;
      box-shadow:0 12px 30px rgba(20,40,90,.16);isolation:isolate;}
    .slide::after{content:'';position:absolute;inset:0;z-index:-1;}
    .slide .badge{align-self:flex-start;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
      background:rgba(255,255,255,.22);padding:4px 10px;border-radius:100px;backdrop-filter:blur(4px);}
    .slide h3{font-size:19px;font-weight:800;letter-spacing:-.5px;line-height:1.2;margin-top:10px;}
    .slide p{font-size:12px;color:rgba(255,255,255,.9);font-weight:500;line-height:1.45;margin-top:5px;max-width:230px;}
    .slide .cta{align-self:flex-start;margin-top:13px;display:inline-flex;align-items:center;gap:6px;
      background:#fff;color:#1565e0;font-size:12px;font-weight:800;padding:8px 14px;border-radius:100px;
      text-decoration:none;box-shadow:0 4px 12px rgba(0,0,0,.14);transition:transform .12s;}
    .slide .cta:active{transform:scale(.95);}
    .slide .pic{position:absolute;right:14px;bottom:12px;opacity:.9;z-index:-1;color:rgba(255,255,255,.5);}
    /* tema warna tiap slide */
    .slide.s-join{background:linear-gradient(135deg,#1f8bff,#1565e0 70%,#0e4fb8);}
    .slide.s-free{background:linear-gradient(135deg,#2f6bff,#1e3a8a);}
    .slide.s-bonus{background:linear-gradient(135deg,#f7971e,#d4571b);}
    .slide.s-join .cta{color:#1565e0;} .slide.s-free .cta{color:#1e40af;} .slide.s-bonus .cta{color:#c2410c;}
    .promo-dots{display:flex;justify-content:center;gap:6px;margin-top:12px;}
    .promo-dots .dot{width:7px;height:7px;border-radius:50%;background:#d3dae6;transition:all .25s;}
    .promo-dots .dot.on{width:20px;border-radius:100px;background:var(--teal-deep);}

    /* Footer copyright — menempel di dasar, mengisi ruang kosong dgn rapi */
    .copyright{margin-top:auto;padding:22px 16px calc(20px + env(safe-area-inset-bottom,0px));
      text-align:center;}
    .copyright .cdiv{width:38px;height:3px;border-radius:3px;background:var(--line);margin:0 auto 14px;}
    .copyright .cname{font-size:12.5px;font-weight:700;color:#54607a;}
    .copyright .cmeta{font-size:11px;color:var(--muted);margin-top:3px;line-height:1.5;}
  </style>
</head>
<body data-wa="<%= (typeof company !== 'undefined' && company.whatsapp) ? company.whatsapp : '' %>">
 <div class="wrap">
  <div class="hero">
    <% if (typeof company !== 'undefined' && company.bg) { %>
    <div class="hero-bg" style="background-image:url('<%= company.bg %>')"></div>
    <% } %>
    <div class="brand">
      <div class="nm" id="appName"><%= (typeof company !== 'undefined' && company.name) ? company.name : 'Reseller Voucher' %></div>
      <div class="sub">Portal Penjual Voucher Hotspot</div>
    </div>
    <h1>Jualan voucher<br>jadi lebih mudah.</h1>
    <p>Masuk untuk generate voucher, cek saldo, dan lihat laporan penjualan Anda.</p>
  </div>

  <div class="sheet">
    <div class="card">
      <h2>Masuk Akun Reseller</h2>
      <div class="hint">Gunakan kode reseller &amp; password dari admin.</div>

      <div class="err" id="errMsg"></div>

      <div class="field">
        <label for="inCode">Kode Reseller</label>
        <div class="inp-wrap">
          <svg class="lead" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <input id="inCode" type="text" placeholder="mis. WARUNG01" autocapitalize="characters" autocomplete="username">
        </div>
      </div>

      <div class="field">
        <label for="inPw">Password</label>
        <div class="inp-wrap">
          <svg class="lead" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <input id="inPw" type="password" placeholder="••••••••" autocomplete="current-password">
          <button class="pw-toggle" type="button" id="pwToggle" aria-label="Tampilkan password">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <button class="btn" id="btnLogin" onclick="doLogin()">
        <span id="btnText">Masuk</span>
        <span class="spinner" id="btnSpinner"></span>
      </button>

      <div class="note">
        Belum punya akun? <a href="#" class="wa-link" onclick="return waCS('Halo, saya ingin MENDAFTAR sebagai reseller voucher hotspot. Mohon bantuannya.')">Daftar via WhatsApp</a>
      </div>
    </div>

    <!-- Promo slideshow ala app provider -->
    <div class="promo">
      <div class="promo-track" id="promoTrack">
        <div class="slide s-join">
          
          <svg class="pic" width="78" height="78" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="badge">Program Reseller</span>
          <div>
            <h3>Gabung jadi Reseller!</h3>
            <p>Jual voucher hotspot, raih komisi tiap transaksi. Modal kecil, untung jalan terus.</p>
          </div>
          <a class="cta" href="#" onclick="return waCS('Halo, saya ingin mendaftar program RESELLER voucher hotspot. Mohon informasinya.')">Daftar Sekarang
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
        <div class="slide s-free">
          
          <svg class="pic" width="78" height="78" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
          <span class="badge">Promo Spesial</span>
          <div>
            <h3>Pasang WiFi GRATIS</h3>
            <p>Pemasangan internet rumah tanpa biaya instalasi. Periode terbatas — ajak pelanggan sekarang!</p>
          </div>
          <a class="cta" href="#" onclick="return waCS('Halo, saya tertarik dengan promo PASANG WIFI GRATIS. Mohon info pendaftaran & area layanan.')">Info Promo
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
        <div class="slide s-bonus">
          
          <svg class="pic" width="78" height="78" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
          <span class="badge">Bonus Deposit</span>
          <div>
            <h3>Top-up Dapat Bonus</h3>
            <p>Isi saldo deposit lebih banyak, dapat ekstra saldo. Makin besar deposit, makin cuan!</p>
          </div>
          <a class="cta" href="#" onclick="return waCS('Halo, saya ingin tahu detail promo BONUS TOP-UP / DEPOSIT untuk reseller.')">Lihat Detail
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
      <div class="promo-dots" id="promoDots">
        <span class="dot on"></span><span class="dot"></span><span class="dot"></span>
      </div>
    </div>

    <!-- Footer copyright (diisi dari data setting perusahaan) -->
    <div class="copyright">
      <div class="cdiv"></div>
      <div class="cname">&copy; <span id="cYear"></span> <%= (typeof company !== 'undefined' && company.name) ? company.name : 'FLAYNET' %></div>
      <div class="cmeta">
        <% if (typeof company !== 'undefined' && company.address) { %><%= company.address %><br><% } %>
        Hak cipta dilindungi.<% if (typeof company !== 'undefined' && company.phone) { %> &middot; <%= company.phone %><% } %>
      </div>
    </div>
  </div>
 </div>

<script>
  // Tahun copyright otomatis.
  document.getElementById('cYear').textContent = new Date().getFullYear();

  // ── Promo slideshow: auto-geser + sinkron titik indikator ──
  (function(){
    const track = document.getElementById('promoTrack');
    const dots  = Array.from(document.querySelectorAll('#promoDots .dot'));
    if(!track || !dots.length) return;
    let idx = 0, timer = null, paused = false;
    const count = track.children.length;
    function goTo(i){
      idx = (i + count) % count;
      const slide = track.children[idx];
      track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior:'smooth' });
      dots.forEach((d,k)=>d.classList.toggle('on', k===idx));
    }
    function next(){ goTo(idx+1); }
    function start(){ stop(); timer = setInterval(()=>{ if(!paused) next(); }, 4200); }
    function stop(){ if(timer){ clearInterval(timer); timer=null; } }
    let st;
    track.addEventListener('scroll', ()=>{
      clearTimeout(st);
      st = setTimeout(()=>{
        const i = Math.round(track.scrollLeft / track.clientWidth);
        if(i!==idx){ idx=Math.max(0,Math.min(count-1,i)); dots.forEach((d,k)=>d.classList.toggle('on', k===idx)); }
      }, 90);
    }, { passive:true });
    track.addEventListener('pointerdown', ()=>{ paused=true; });
    track.addEventListener('pointerup',   ()=>{ setTimeout(()=>paused=false, 2500); });
    dots.forEach((d,k)=>d.addEventListener('click', ()=>{ goTo(k); paused=true; setTimeout(()=>paused=false,2500); }));
    document.addEventListener('visibilitychange', ()=>{ paused = document.hidden; });
    start();
  })();

  // Hubungi CS via WhatsApp. Pesan bisa disesuaikan per tombol.
  function waCS(message){
    var raw = (document.body.getAttribute('data-wa')||'').replace(/[^0-9]/g,'');
    if(!raw){ alert('Nomor WhatsApp CS belum diatur di pengaturan aplikasi.'); return false; }
    if(raw.charAt(0)==='0') raw = '62'+raw.slice(1);          // 08xx → 628xx
    else if(raw.slice(0,2)!=='62' && raw.charAt(0)==='8') raw = '62'+raw; // 8xx → 628xx
    var url = 'https://wa.me/'+raw+'?text='+encodeURIComponent(message||'Halo, saya ingin bertanya.');
    window.open(url, '_blank');
    return false;
  }
  function contactAdmin(){ return waCS('Halo, saya tertarik dengan program reseller / promo Anda.'); }

  // Auto-login: restore cookie dari localStorage token kalau masih valid.
  (async function(){
    try{
      const t = localStorage.getItem('reseller_token');
      if(!t) return;
      // Loop-breaker: kalau baru saja dipantulkan dari dashboard, jangan balik lagi.
      if(sessionStorage.getItem('rsl_redir')){ sessionStorage.removeItem('rsl_redir'); return; }
      const r = await fetch('/reseller/api/auth/restore-cookie', {
        method:'POST',
        headers:{ 'Authorization':'Bearer '+t, 'X-Requested-With':'XMLHttpRequest' }
      });
      const j = await r.json();
      if(j.success && j.redirect){
        // Pastikan cookie klien ikut terpasang agar dashboard tidak memantul balik.
        document.cookie = 'reseller_token='+t+';path=/reseller;max-age=86400;SameSite=Lax';
        try{ sessionStorage.setItem('rsl_redir','1'); }catch(_){}
        window.location.replace(j.redirect);
      } else {
        localStorage.removeItem('reseller_token'); localStorage.removeItem('reseller_info');
        document.cookie = 'reseller_token=;path=/reseller;max-age=0';
      }
    }catch(_){ localStorage.removeItem('reseller_token'); }
  })();

  document.getElementById('pwToggle').addEventListener('click', function(){
    const inp = document.getElementById('inPw');
    inp.type = inp.type === 'password' ? 'text' : 'password';
  });
  document.getElementById('inCode').addEventListener('keydown', e=>{ if(e.key==='Enter') document.getElementById('inPw').focus(); });
  document.getElementById('inPw').addEventListener('keydown', e=>{ if(e.key==='Enter') doLogin(); });

  async function doLogin(){
    const code = document.getElementById('inCode').value.trim();
    const pw   = document.getElementById('inPw').value;
    const err  = document.getElementById('errMsg');
    const btn  = document.getElementById('btnLogin');
    const txt  = document.getElementById('btnText');
    const sp   = document.getElementById('btnSpinner');

    if(!code || !pw){
      err.textContent = 'Kode reseller dan password wajib diisi';
      err.style.display = 'block'; return;
    }
    err.style.display='none'; btn.disabled=true; txt.style.display='none'; sp.style.display='block';

    try{
      const r = await fetch('/reseller/api/auth/login', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ code, password: pw })
      });
      const j = await r.json();
      if(!j.success){
        err.textContent = j.message || 'Login gagal';
        err.style.display = 'block';
      } else {
        localStorage.setItem('reseller_token', j.token);
        localStorage.setItem('reseller_info', JSON.stringify(j.reseller));
        document.cookie = 'reseller_token='+j.token+';path=/reseller;max-age=86400;SameSite=Lax';
        window.location.href = '/reseller/dashboard';
      }
    }catch(e){
      err.textContent = 'Tidak dapat terhubung ke server';
      err.style.display = 'block';
    }finally{
      btn.disabled=false; txt.style.display=''; sp.style.display='none';
    }
  }
</script>
</body>
</html>
