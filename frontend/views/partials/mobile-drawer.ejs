  async function _mnotifLoad(){
    var body=document.getElementById('mNotifBody');
    var j=await _apiTop('/api/notifications?limit=15');
    _mnLoaded=true;
    var rows=[];
    if(j){ var d=j.data!=null?j.data:j; rows=Array.isArray(d)?d:(d&&d.rows?d.rows:[]); }
    if(!rows.length){
      body.innerHTML='<div class="mnotif-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg><div>Belum ada notifikasi</div></div>';
      return;
    }
    var html='';
    rows.forEach(function(n){
      var sev=(n.severity||n.type||'info');
      var cls=(sev==='critical'?'critical':(sev==='error'?'error':(sev==='warning'?'warning':'info')));
      var unread=!(n.is_read);
      var href=_mnMapUrl(n.action_url||n.link, n.type);
      html+='<a class="mnotif-item'+(unread?' unread':'')+'" href="'+_msEsc(href)+'" onclick="_mnMarkRead('+(n.id!=null?n.id:'null')+')">'
          + '<div class="mnotif-ic '+cls+'">'+_mnIcon(sev)+'</div>'
          + '<div style="min-width:0;flex:1;">'
          +   '<div class="mnotif-tt">'+_msEsc(n.title||'Notifikasi')+'</div>'
          +   (n.message?'<div class="mnotif-ms">'+_msEsc(n.message)+'</div>':'')
          +   '<div class="mnotif-tm">'+_msEsc(_mnTimeAgo(n.created_at||n.createdAt))+'</div>'
          + '</div></a>';
    });
    body.innerHTML=html;
  }
  // Petakan notifikasi → halaman mobile yang setara.
  // Prioritas: cocokkan berdasarkan TYPE dulu (andal, selalu ada), lalu URL,
  // baru fallback. Notif lama sering punya link kosong, jadi type yang menentukan.
  function _mnMapUrl(url, type){
    var t=(type||'').toLowerCase();
    // Berdasarkan tipe notif
    if(t.indexOf('wa')>=0 || t.indexOf('whatsapp')>=0 || t.indexOf('chat')>=0) return '/mobile/wa';
    if(t==='overdue' || t==='due_today' || t==='due_soon') return '/mobile/reminder';
    if(t.indexOf('invoice')>=0 || t.indexOf('billing')>=0 || t.indexOf('unpaid')>=0) return '/mobile/invoice';
    if(t.indexOf('payment')>=0 || t.indexOf('bayar')>=0) return '/mobile/payments';
    if(t.indexOf('ticket')>=0 || t.indexOf('tiket')>=0) return '/mobile/ticket';
    if(t.indexOf('ont')>=0 || t.indexOf('olt')>=0 || t.indexOf('device')>=0 || t.indexOf('snmp')>=0) return '/mobile/noc';
    if(t.indexOf('customer')>=0 || t.indexOf('registration')>=0 || t.indexOf('sales')>=0) return '/mobile/customers';
    // Berdasarkan URL (kalau ada)
    if(url){
      if(url.indexOf('/mobile/')===0) return url; // sudah mobile
      if(url.indexOf('wa')>=0 || url.indexOf('whatsapp')>=0) return '/mobile/wa';
      if(url.indexOf('billing')>=0 || url.indexOf('invoice')>=0) return '/mobile/invoice';
      if(url.indexOf('payment')>=0) return '/mobile/payments';
      if(url.indexOf('ticket')>=0) return '/mobile/ticket';
      if(url.indexOf('ont')>=0 || url.indexOf('olt')>=0 || url.indexOf('noc')>=0) return '/mobile/noc';
      if(url.indexOf('customer')>=0) return '/mobile/customers';
      if(url.indexOf('reminder')>=0) return '/mobile/reminder';
    }
    return '/mobile/reminder';
  }
  // Tandai satu notif dibaca saat diklik (best-effort, tak menghalangi navigasi).
  function _mnMarkRead(id){
    if(id==null) return;
    try{ var t=_tokenTop(); fetch('/api/notifications/'+id+'/read',{method:'PUT',credentials:'include',headers:Object.assign({'X-Requested-With':'XMLHttpRequest'}, t?{'Authorization':'Bearer '+t}:{})}); }catch(e){}
  }
