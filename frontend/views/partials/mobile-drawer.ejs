<%
  // Partial: mobile slide-in drawer sidebar.
  // Pemakaian: include partial ini di setiap halaman mobile dengan meneruskan
  // variabel active, appName, dan user. 'active' menandai menu yang sedang dibuka.
  var _act = (typeof active !== 'undefined') ? active : '';
  var _app = (typeof appName !== 'undefined' && appName) ? appName : 'FLAYNET';
  var _uname = (typeof user !== 'undefined' && user && user.name) ? user.name : 'Owner';
  var _uemail = (typeof user !== 'undefined' && user && user.email) ? user.email : '';
  var _uavatar = (typeof user !== 'undefined' && user && user.avatar) ? user.avatar : '';
  function _on(id){ return _act === id ? ' active' : ''; }
%>
<style>
  /* Hamburger lama (floating) dimatikan — diganti avatar di top nav sticky */
  .mdr-hamb{display:none !important;}

  /* ───────────────── TOP NAV STICKY (ala MyTelkomsel) ─────────────────
     Menempel di atas .wrap; karena .wrap yang men-scroll, sticky top:0
     membuat nav tetap di tempat saat konten digulung. */
  .mtop{
    position:sticky; top:0; z-index:240;
    display:flex; align-items:center; gap:10px;
    padding:calc(10px + env(safe-area-inset-top)) 14px 10px;
    background:rgba(255,255,255,.92);
    backdrop-filter:saturate(180%) blur(12px);
    -webkit-backdrop-filter:saturate(180%) blur(12px);
    border-bottom:1px solid #eef1f6;
  }
  /* Bayangan halus muncul saat konten mulai discroll (di-toggle via JS) */
  .mtop.scrolled{box-shadow:0 6px 18px -12px rgba(23,43,84,.28);}
  .mtop-hamb{
    width:40px;height:40px;border-radius:12px;flex-shrink:0;cursor:pointer;
    background:#eef1f6;border:none;display:flex;align-items:center;justify-content:center;color:#25324d;
  }
  .mtop-hamb svg{width:21px;height:21px;}
  .mtop-av{
    width:40px;height:40px;border-radius:50%;flex-shrink:0;cursor:pointer;text-decoration:none;
    background:linear-gradient(135deg,#2f6fed,#1e4fd6);color:#fff;border:none;
    display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;
    overflow:hidden;padding:0;font-family:inherit;
  }
  .mtop-av img{width:100%;height:100%;object-fit:cover;}
  .mtop-search{
    flex:1;min-width:0;height:40px;border-radius:100px;border:none;
    background:#eef1f6;display:flex;align-items:center;gap:8px;padding:0 14px;
    cursor:text;color:#94a0b8;font-size:13px;font-family:inherit;
  }
  .mtop-search svg{width:17px;height:17px;flex-shrink:0;color:#94a0b8;}
  .mtop-search span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .mtop-bell{
    width:40px;height:40px;border-radius:50%;flex-shrink:0;cursor:pointer;position:relative;
    background:#eef1f6;border:none;display:flex;align-items:center;justify-content:center;color:#3a4a68;
  }
  .mtop-bell svg{width:20px;height:20px;}
  .mtop-bell .dot{
    position:absolute;top:7px;right:8px;min-width:15px;height:15px;padding:0 4px;
    border-radius:100px;background:#f2545b;color:#fff;font-size:9px;font-weight:800;
    display:none;align-items:center;justify-content:center;line-height:1;border:1.5px solid #fff;
  }
  .mtop-bell .dot.show{display:flex;}

  /* ───────────── PANEL NOTIFIKASI (dropdown dari bell) ───────────── */
  .mnotif-overlay{position:fixed;inset:0;z-index:1000;background:rgba(15,27,74,.28);opacity:0;visibility:hidden;transition:opacity .2s;}
  .mnotif-overlay.open{opacity:1;visibility:visible;}
  .mnotif{
    position:fixed;z-index:1001;top:calc(58px + env(safe-area-inset-top));
    left:50%;transform:translateX(-50%) translateY(-8px);
    width:calc(100% - 24px);max-width:calc(var(--shell-max,480px) - 24px);
    background:#fff;border-radius:16px;box-shadow:0 18px 44px -12px rgba(23,43,84,.34);
    opacity:0;visibility:hidden;transition:opacity .2s, transform .2s, visibility .2s;
    display:flex;flex-direction:column;max-height:70vh;overflow:hidden;
  }
  .mnotif.open{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0);}
  .mnotif-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 10px;border-bottom:1px solid #eef1f6;}
  .mnotif-head span{font-size:14.5px;font-weight:800;color:#1a2b4a;}
  .mnotif-readall{border:none;background:none;color:#2f6fed;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit;padding:2px 4px;}
  .mnotif-body{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;}
  .mnotif-item{display:flex;gap:11px;padding:12px 16px;text-decoration:none;border-bottom:1px solid #f4f7fb;cursor:pointer;position:relative;}
  .mnotif-item:active{background:#f4f7fb;}
  .mnotif-item.unread{background:#f5f9ff;}
  .mnotif-ic{width:34px;height:34px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;}
  .mnotif-ic svg{width:17px;height:17px;}
  .mnotif-ic.info{background:#e2f0ff;color:#2f6fed;}
  .mnotif-ic.warning{background:#fdf1dc;color:#b9781a;}
  .mnotif-ic.error,.mnotif-ic.critical{background:#fde5e6;color:#d13b42;}
  .mnotif-tt{font-size:13px;font-weight:700;color:#1a2b4a;line-height:1.35;}
  .mnotif-ms{font-size:11.5px;color:#6b7a97;margin-top:2px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  .mnotif-tm{font-size:10.5px;color:#a7b0c4;margin-top:4px;}
  .mnotif-empty{padding:40px 24px;text-align:center;color:#94a0b8;font-size:12.5px;}
  .mnotif-empty svg{width:40px;height:40px;color:#d4dbe8;margin-bottom:10px;}
  .mnotif-foot{display:block;text-align:center;padding:12px;font-size:12.5px;font-weight:700;color:#2f6fed;text-decoration:none;border-top:1px solid #eef1f6;}
  .mnotif-foot:active{background:#f4f7fb;}
  .mnotif-spin{width:22px;height:22px;margin:28px auto;border:2.5px solid #e7edf6;border-top-color:#2f6fed;border-radius:50%;animation:mtopspin .8s linear infinite;}

  /* ───────────────── OVERLAY PENCARIAN GLOBAL ───────────────── */
  .msearch{
    position:fixed;top:0;bottom:0;left:50%;z-index:1000;background:#fff;
    width:100%;max-width:var(--shell-max,480px);
    opacity:0;visibility:hidden;
    transition:opacity .2s, transform .2s, visibility .2s;
    display:flex;flex-direction:column;
    transform:translateX(-50%) translateY(8px);
  }
  .msearch.open{opacity:1;visibility:visible;transform:translateX(-50%) translateY(0);}
  .msearch-bar{
    display:flex;align-items:center;gap:10px;
    padding:calc(10px + env(safe-area-inset-top)) 14px 12px;border-bottom:1px solid #eef1f6;
  }
  .msearch-back{width:38px;height:38px;flex-shrink:0;border:none;background:none;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#3a4a68;cursor:pointer;}
  .msearch-back svg{width:22px;height:22px;}
  .msearch-field{flex:1;display:flex;align-items:center;gap:8px;background:#eef1f6;border-radius:100px;padding:0 14px;height:42px;}
  .msearch-field svg{width:18px;height:18px;color:#94a0b8;flex-shrink:0;}
  .msearch-field input{flex:1;min-width:0;border:none;background:none;outline:none;font-size:14px;font-family:inherit;color:#1a2b4a;}
  .msearch-clear{border:none;background:none;color:#94a0b8;cursor:pointer;padding:4px;display:none;}
  .msearch-clear.show{display:block;}
  .msearch-body{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:8px 0 24px;}
  .msearch-sec{font-size:11px;font-weight:800;color:#b3bdd0;text-transform:uppercase;letter-spacing:.5px;padding:14px 18px 6px;}
  .msearch-item{display:flex;align-items:center;gap:12px;padding:11px 16px;text-decoration:none;cursor:pointer;}
  .msearch-item:active{background:#f4f7fb;}
  .msearch-ic{width:38px;height:38px;border-radius:11px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;}
  .msearch-ic.cust{background:#e2f0ff;color:#2f6fed;}
  .msearch-ic.pkg{background:#e6f7f4;color:#0e9a8b;}
  .msearch-ic.inv{background:#fdf1dc;color:#b9781a;}
  .msearch-tt{font-size:13.5px;font-weight:700;color:#1a2b4a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .msearch-ss{font-size:11.5px;color:#94a0b8;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .msearch-empty{padding:48px 24px;text-align:center;color:#94a0b8;font-size:13px;}
  .msearch-empty svg{width:44px;height:44px;color:#d4dbe8;margin-bottom:12px;}
  .msearch-hint{padding:20px 18px;color:#94a0b8;font-size:12.5px;line-height:1.6;}
  .msearch-spin{width:22px;height:22px;margin:32px auto;border:2.5px solid #e7edf6;border-top-color:#2f6fed;border-radius:50%;animation:mtopspin .8s linear infinite;}
  @keyframes mtopspin{to{transform:rotate(360deg);}}

  .mdr-hamb svg{width:22px;height:22px;}
  /* CATATAN: posisi (left/transform/max-width) drawer & overlay diatur di
     mobile-shell.css — SATU sumber kebenaran. Di sini hanya tampilan. */
  .mdr-overlay{
    position:fixed;top:0;bottom:0;
    z-index:998;background:rgba(15,27,74,.42);
    opacity:0;visibility:hidden;transition:opacity .28s;
  }
  .mdr-overlay.open{opacity:1;visibility:visible;}
  /* Posisi horizontal (left) diselaraskan ke shell di mobile-shell.css.
     TAPI keadaan tersembunyi/terbuka HARUS didefinisikan di sini juga, supaya
     drawer tetap tertutup meski mobile-shell.css gagal dimuat / masih versi
     cache lama. Tanpa ini, drawer tampil terbuka permanen & tak bisa ditutup. */
  .mdr{
    position:fixed;top:0;bottom:0;left:0;
    z-index:999;
    width:288px;max-width:82vw;
    background:#fff;
    transform:translateX(-100%);            /* default: TERSEMBUNYI */
    transition:transform .3s cubic-bezier(.4,0,.2,1);
    display:flex;flex-direction:column;
    box-shadow:8px 0 40px rgba(15,27,74,.18);
    visibility:hidden;                       /* jaring pengaman ekstra */
  }
  .mdr.open{
    transform:translateX(0);
    visibility:visible;
  }
  .mdr-head{padding:calc(18px + env(safe-area-inset-top)) 18px 16px;display:flex;align-items:center;gap:12px;border-bottom:1px solid #f0f3f9;flex-shrink:0;}
  .mdr-logo{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#36C9A8,#279694);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;flex-shrink:0;}
  .mdr-brand-t{font-size:15.5px;font-weight:800;color:#1F3849;letter-spacing:-.3px;line-height:1.2;}
  .mdr-brand-s{font-size:11px;color:#7c93a0;margin-top:2px;}
  /* Area menu: satu-satunya bagian yang scroll, sisanya tetap */
  .mdr-body{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding:10px 10px 16px;min-height:0;}
  .mdr-body::-webkit-scrollbar{width:0;}
  .mdr-group{font-size:10px;font-weight:800;color:#b3bdd0;text-transform:uppercase;letter-spacing:.7px;padding:14px 10px 6px;}
  .mdr-group:first-child{padding-top:4px;}
  .mdr-item{display:flex;align-items:center;gap:12px;padding:10.5px 10px;border-radius:11px;text-decoration:none;color:#3a4a68;font-size:13.5px;font-weight:600;transition:background .12s;cursor:pointer;}
  .mdr-item:active{background:#f0f3f9;}
  .mdr-item svg{width:20px;height:20px;stroke-width:1.9;flex-shrink:0;color:#5a6885;}
  .mdr-item.active{background:#e8f0ff;color:#2f6fed;}
  .mdr-item.active svg{color:#2f6fed;}
  .mdr-item .mdr-tag{margin-left:auto;font-size:9.5px;font-weight:700;background:#e8f0ff;color:#2f6fed;padding:2px 7px;border-radius:100px;}
  /* Footer selalu menempel di bawah, tak ikut scroll */
  .mdr-foot{border-top:1px solid #f0f3f9;padding:12px 14px calc(12px + env(safe-area-inset-bottom));flex-shrink:0;background:#fff;}
  .mdr-user{display:flex;align-items:center;gap:10px;margin-bottom:10px;min-width:0;}
  .mdr-uav{width:40px;height:40px;border-radius:50%;overflow:hidden;background:linear-gradient(135deg,#2f6fed,#1e4fd6);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;flex-shrink:0;}
  .mdr-uname{font-size:13.5px;font-weight:700;color:#1a2b4a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .mdr-uemail{font-size:11px;color:#94a0b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .mdr-logout{display:flex;align-items:center;gap:10px;width:100%;padding:11px 12px;border:none;background:none;border-radius:12px;color:#f2545b;font-size:13.5px;font-weight:700;cursor:pointer;font-family:inherit;}
  .mdr-logout svg{width:19px;height:19px;stroke-width:2;}
  .mdr-logout:active{background:#fde5e6;}

  /* ═════════════ FAB ACTION SHEET (menu tombol +) ═════════════ */
  .fabsheet-ov{position:fixed;inset:0;z-index:600;background:rgba(15,32,51,.42);opacity:0;pointer-events:none;transition:opacity .2s;}
  .fabsheet-ov.open{opacity:1;pointer-events:auto;}
  .fabsheet{position:fixed;left:50%;bottom:0;transform:translateX(-50%) translateY(100%);width:100%;max-width:480px;z-index:601;background:#fff;border-radius:22px 22px 0 0;padding:10px 16px calc(18px + env(safe-area-inset-bottom));box-shadow:0 -12px 40px -10px rgba(15,32,51,.3);transition:transform .26s cubic-bezier(.22,1,.36,1);}
  .fabsheet.open{transform:translateX(-50%) translateY(0);}
  .fabsheet-grip{width:40px;height:4px;border-radius:100px;background:#d9e1ec;margin:4px auto 12px;}
  .fabsheet-h{font-size:15px;font-weight:800;color:#1f3849;margin:0 4px 12px;letter-spacing:-.2px;}
  .fabsheet-item{display:flex;align-items:center;gap:14px;width:100%;padding:13px 12px;border:none;background:none;border-radius:14px;font-family:inherit;font-size:14px;font-weight:700;color:#1f3849;cursor:pointer;text-align:left;text-decoration:none;}
  .fabsheet-item:active{background:#f1f6ff;}
  .fabsheet-ic{width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#e0f2fe;color:#0284c7;}
  .fabsheet-ic svg{width:21px;height:21px;stroke-width:2;}
  .fabsheet-item .fabsheet-sub{display:block;font-size:11.5px;font-weight:500;color:#8296a8;margin-top:1px;}
  .fabsheet-item .fabsheet-tx{flex:1;min-width:0;}
  .fabsheet-chev{color:#c7d0e0;flex-shrink:0;}
  .fabsheet-chev svg{width:18px;height:18px;stroke-width:2.4;}

  /* Sub-sheet Generate Invoice */
  .gi-field{margin-bottom:13px;}
  .gi-lbl{display:block;font-size:11.5px;font-weight:700;color:#6b7a97;text-transform:uppercase;letter-spacing:.03em;margin-bottom:6px;}
  .gi-row{display:flex;gap:10px;}
  .gi-sel,.gi-inp{width:100%;padding:11px 13px;border:1.5px solid #e2e8f0;border-radius:12px;font-family:inherit;font-size:14px;color:#1f3849;background:#fff;outline:none;-webkit-appearance:none;appearance:none;}
  .gi-sel:focus,.gi-inp:focus{border-color:#0ea5e9;}
  .gi-scope{display:flex;gap:8px;margin-bottom:4px;}
  .gi-scope-opt{flex:1;padding:11px 8px;border:1.5px solid #e2e8f0;border-radius:12px;text-align:center;font-size:12.5px;font-weight:700;color:#6b7a97;cursor:pointer;background:#fff;transition:all .12s;}
  .gi-scope-opt.on{border-color:#0ea5e9;background:#e0f2fe;color:#0284c7;}
  .gi-picker{margin-top:10px;}
  .gi-search{width:100%;padding:10px 13px;border:1.5px solid #e2e8f0;border-radius:12px;font-family:inherit;font-size:13.5px;outline:none;margin-bottom:8px;}
  .gi-search:focus{border-color:#0ea5e9;}
  .gi-results{max-height:180px;overflow-y:auto;-webkit-overflow-scrolling:touch;}
  .gi-cust{display:flex;align-items:center;gap:10px;padding:9px 6px;border-radius:10px;cursor:pointer;}
  .gi-cust:active{background:#f1f6ff;}
  .gi-cust-chk{width:20px;height:20px;border-radius:6px;border:1.5px solid #cbd5e1;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;}
  .gi-cust.sel .gi-cust-chk{background:#0ea5e9;border-color:#0ea5e9;}
  .gi-cust-nm{font-size:13px;font-weight:600;color:#1f3849;line-height:1.25;}
  .gi-cust-cid{font-size:11px;color:#8296a8;}
  .gi-selcount{font-size:11.5px;color:#0284c7;font-weight:700;margin:8px 2px 0;}
  .gi-actions{display:flex;gap:10px;margin-top:16px;}
  .gi-btn{flex:1;padding:13px;border:none;border-radius:13px;font-family:inherit;font-size:14px;font-weight:800;cursor:pointer;}
  .gi-btn-cancel{background:#eef1f6;color:#5a6885;}
  .gi-btn-go{background:linear-gradient(135deg,#38bdf8,#0ea5e9);color:#fff;box-shadow:0 8px 18px -8px rgba(14,165,233,.6);}
  .gi-btn:disabled{opacity:.6;}
</style>

<!-- TOP NAV STICKY — akan dipindah ke dalam .wrap via JS agar sticky ke scroll container -->
<div class="mtop" id="mTop">
  <button class="mtop-hamb" onclick="mdrOpen()" aria-label="Menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <button class="mtop-search" onclick="msearchOpen()" aria-label="Cari">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <span>Cari pelanggan, invoice, paket…</span>
  </button>
  <button class="mtop-bell" id="mTopBell" onclick="mnotifToggle(event)" aria-label="Notifikasi">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
    <span class="dot" id="mTopBellDot">0</span>
  </button>
  <a class="mtop-av" id="mTopAv" href="/mobile/profile" aria-label="Profil"><% if (_uavatar) { %><img src="<%= _uavatar %>" alt="Profil" onerror="this.remove()"><% } else { %><%= _uname.charAt(0).toUpperCase() %><% } %></a>
</div>

<!-- PANEL NOTIFIKASI (dropdown) -->
<div class="mnotif-overlay" id="mNotifOverlay" onclick="mnotifClose()"></div>
<div class="mnotif" id="mNotif">
  <div class="mnotif-head">
    <span>Notifikasi</span>
    <button class="mnotif-readall" id="mNotifReadAll" onclick="mnotifReadAll()">Tandai dibaca</button>
  </div>
  <div class="mnotif-body" id="mNotifBody">
    <div class="mnotif-spin"></div>
  </div>
  <a class="mnotif-foot" href="/mobile/reminder">Lihat semua di Reminder →</a>
</div>

<!-- OVERLAY PENCARIAN GLOBAL -->
<div class="msearch" id="mSearch">
  <div class="msearch-bar">
    <button class="msearch-back" onclick="msearchClose()" aria-label="Kembali">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
    </button>
    <div class="msearch-field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="mSearchInput" placeholder="Cari pelanggan, invoice, paket…" autocomplete="off" oninput="msearchInput()">
      <button class="msearch-clear" id="mSearchClear" onclick="msearchClearText()" aria-label="Hapus">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
  <div class="msearch-body" id="mSearchBody">
    <div class="msearch-hint">Ketik untuk mencari pelanggan (nama / ID / no. HP), atau nama paket. Tap hasil untuk membuka detailnya.</div>
  </div>
</div>

<button class="mdr-hamb" onclick="mdrOpen()" aria-label="Menu" style="display:none">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
</button>

<div class="mdr-overlay" id="mdrOverlay" onclick="mdrClose()"></div>

<nav class="mdr" id="mdrPanel">
  <div class="mdr-head">
    <%
      // Ikuti pengaturan brand dari halaman Setting (Tampilan & Brand), sama
      // seperti sidebar desktop. brandMode: logo_only | name_logo | name_tagline | default.
      var _brandMode = locals.brandMode  || (locals.appSettings && locals.appSettings.brand_mode)  || 'name_tagline';
      var _brandName = locals.appName    || (locals.appSettings && locals.appSettings.app_name)    || _app;
      var _brandTag  = locals.appTagline || (locals.appSettings && locals.appSettings.app_tagline) || 'Panel Owner';
      var _brandLogo = locals.logoUrl    || (locals.appSettings && locals.appSettings.logo_url)    || '';
