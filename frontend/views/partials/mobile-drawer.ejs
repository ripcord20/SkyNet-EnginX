<!-- Sub-sheet: Generate Invoice -->
<div class="fabsheet-ov" id="giOv" onclick="FabSheet.closeGenerate()"></div>
<div class="fabsheet" id="giSheet" role="dialog" aria-label="Generate Invoice">
  <div class="fabsheet-grip"></div>
  <div class="fabsheet-h">Generate Invoice</div>
  <div class="gi-field">
    <span class="gi-lbl">Periode</span>
    <div class="gi-row">
      <select class="gi-sel" id="giMonth"></select>
      <select class="gi-sel" id="giYear"></select>
    </div>
  </div>
  <div class="gi-field">
    <span class="gi-lbl">Cakupan</span>
    <div class="gi-scope">
      <div class="gi-scope-opt on" id="giScopeAll" onclick="FabSheet.setScope('all')">Semua Pelanggan</div>
      <div class="gi-scope-opt" id="giScopeSel" onclick="FabSheet.setScope('selected')">Pilih Pelanggan</div>
    </div>
    <div class="gi-picker" id="giPicker" style="display:none;">
      <input type="text" class="gi-search" id="giSearch" placeholder="Cari nama / ID pelanggan…" oninput="FabSheet.searchCust()">
      <div class="gi-results" id="giResults"></div>
      <div class="gi-selcount" id="giSelCount"></div>
    </div>
  </div>
  <div class="gi-actions">
    <button class="gi-btn gi-btn-cancel" onclick="FabSheet.closeGenerate()">Batal</button>
    <button class="gi-btn gi-btn-go" id="giGoBtn" onclick="FabSheet.doGenerate()">Generate</button>
  </div>
</div>

<script>
  /* ═════════════ FAB ACTION SHEET (menu tombol +) ═════════════ */
  window.FabSheet = (function(){
    function _tok(){ var ls=localStorage.getItem('token'); if(ls)return ls; var m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    function _toast(msg, ok){
      try{ if(window.toast){ window.toast(msg, ok?'ok':'err'); return; } }catch(_){}
      try{ if(window.flynToast){ window.flynToast(msg); return; } }catch(_){}
      alert(msg);
    }
    var _scope='all', _sel={}, _searchTimer=null, _fmtRp=function(n){ return 'Rp '+Number(n||0).toLocaleString('id-ID'); };

    function open(){
      document.getElementById('fabOv').classList.add('open');
      document.getElementById('fabSheet').classList.add('open');
    }
    function close(){
      document.getElementById('fabOv').classList.remove('open');
      document.getElementById('fabSheet').classList.remove('open');
    }
    function _fillPeriods(){
      var mSel=document.getElementById('giMonth'), ySel=document.getElementById('giYear');
      if(mSel && !mSel._filled){
        var MN=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
        var now=new Date(), cm=now.getMonth(), cy=now.getFullYear();
        mSel.innerHTML=MN.map(function(m,i){ return '<option value="'+(i+1)+'"'+(i===cm?' selected':'')+'>'+m+'</option>'; }).join('');
        var yrs=''; for(var y=cy-1;y<=cy+1;y++){ yrs+='<option value="'+y+'"'+(y===cy?' selected':'')+'>'+y+'</option>'; }
        ySel.innerHTML=yrs;
        mSel._filled=true;
      }
    }
    var _giOnDone=null;
    function openGenerate(preset){
      close();
      _scope='all'; _sel={};
      _fillPeriods();
      setScope('all');
      // Pre-fill periode bila dipanggil dari halaman yg punya konteks bulan/tahun
      // (mis. halaman invoice yg sedang memfilter bulan tertentu).
      _giOnDone = (preset && typeof preset.onDone==='function') ? preset.onDone : null;
      if(preset && preset.month){ var mm=document.getElementById('giMonth'); if(mm) mm.value=String(parseInt(preset.month,10)); }
      if(preset && preset.year){
        var yy=document.getElementById('giYear');
        if(yy){
          var yv=String(parseInt(preset.year,10));
          // Tambahkan opsi tahun bila di luar rentang default (mis. lihat periode lama).
          if(!Array.prototype.some.call(yy.options, function(o){ return o.value===yv; })){
            var opt=document.createElement('option'); opt.value=yv; opt.textContent=yv; yy.appendChild(opt);
          }
          yy.value=yv;
        }
      }
      var s=document.getElementById('giSearch'); if(s) s.value='';
      var r=document.getElementById('giResults'); if(r) r.innerHTML='';
      _renderSelCount();
      setTimeout(function(){
        document.getElementById('giOv').classList.add('open');
        document.getElementById('giSheet').classList.add('open');
      }, 180);
    }
    function closeGenerate(){
      document.getElementById('giOv').classList.remove('open');
      document.getElementById('giSheet').classList.remove('open');
    }
    function setScope(sc){
      _scope=sc;
      document.getElementById('giScopeAll').classList.toggle('on', sc==='all');
      document.getElementById('giScopeSel').classList.toggle('on', sc==='selected');
      document.getElementById('giPicker').style.display = sc==='selected' ? 'block' : 'none';
    }
    function searchCust(){
      clearTimeout(_searchTimer);
      _searchTimer=setTimeout(_doSearch, 260);
    }
    async function _doSearch(){
      var q=(document.getElementById('giSearch').value||'').trim();
      var box=document.getElementById('giResults');
      if(!q){ box.innerHTML=''; return; }
      try{
        var t=_tok();
        var r=await fetch('/api/customers?search='+encodeURIComponent(q)+'&limit=15',{credentials:'include',headers:t?{'Authorization':'Bearer '+t}:{}});
        var j=await r.json();
        var list=(j&&(j.data||j.customers||j.rows))||[];
        if(!Array.isArray(list)) list=[];
        if(!list.length){ box.innerHTML='<div style="font-size:12px;color:#8296a8;padding:8px 6px;">Tidak ada hasil.</div>'; return; }
        box.innerHTML=list.map(function(c){
          var id=c.id, nm=c.name||'-', cid=c.customer_id||'';
          var on=!!_sel[id];
          return '<div class="gi-cust'+(on?' sel':'')+'" onclick="FabSheet.toggleCust('+id+',\''+String(nm).replace(/'/g,"\\'")+'\',\''+String(cid).replace(/'/g,"\\'")+'\')">'
            +'<span class="gi-cust-chk"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>'
            +'<div><div class="gi-cust-nm">'+_esc(nm)+'</div><div class="gi-cust-cid">'+_esc(cid)+'</div></div></div>';
        }).join('');
      }catch(e){ box.innerHTML='<div style="font-size:12px;color:#f2545b;padding:8px 6px;">Gagal memuat pelanggan.</div>'; }
    }
    function _esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
    function toggleCust(id, nm, cid){
      if(_sel[id]) delete _sel[id]; else _sel[id]={id:id,name:nm,customer_id:cid};
      _doSearch(); _renderSelCount();
    }
    function _renderSelCount(){
      var n=Object.keys(_sel).length;
      var el=document.getElementById('giSelCount');
      if(el) el.textContent = n ? (n+' pelanggan dipilih') : '';
    }
    async function doGenerate(){
      var btn=document.getElementById('giGoBtn');
      var month=parseInt(document.getElementById('giMonth').value,10);
      var year=parseInt(document.getElementById('giYear').value,10);
      var payload={ month:month, year:year };
      if(_scope==='selected'){
        var ids=Object.keys(_sel).map(Number).filter(Boolean);
        if(!ids.length){ _toast('Pilih minimal satu pelanggan dulu.', false); return; }
        payload.customer_ids=ids;
      }
      btn.disabled=true; btn.textContent='Generating…';
      try{
        var t=_tok();
        var r=await fetch('/api/billing/generate',{method:'POST',credentials:'include',headers:Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}),body:JSON.stringify(payload)});
        var j=await r.json();
        if(j&&j.success){
          var created=(j.data&&j.data.created)||0;
          _toast(j.message || ('Berhasil generate '+created+' invoice'), created>0);
          closeGenerate();
          // Refresh halaman pemanggil (mis. daftar invoice) bila ada callback.
          try{ if(_giOnDone) _giOnDone(created, {month:month, year:year}); }catch(_){}
        }else{
          _toast((j&&j.message)||'Gagal generate invoice', false);
        }
      }catch(e){ _toast('Gagal generate invoice: '+(e.message||e), false); }
      btn.disabled=false; btn.textContent='Generate';
    }

    // Auto-buka add-sheet bila halaman dibuka dgn ?add=1 (dari menu FAB).
    function _autoOpenAdd(){
      try{
        var p=new URLSearchParams(location.search);
        if(p.get('add')==='1'){
          // Halaman customers punya openAdd(); queue punya openAdd()/openCreate().
          setTimeout(function(){
            if(typeof window.openAdd==='function') window.openAdd();
            else if(typeof window.openCreate==='function') window.openCreate();
            else if(typeof window.openQueueAdd==='function') window.openQueueAdd();
          }, 350);
        }
        if(p.get('expense')==='1'){
          // Halaman keuangan punya openExpense() untuk sheet catat pengeluaran.
          setTimeout(function(){ if(typeof window.openExpense==='function') window.openExpense(); }, 350);
        }
      }catch(_){}
    }
    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', _autoOpenAdd);
    else _autoOpenAdd();

    return { open:open, close:close, openGenerate:openGenerate, closeGenerate:closeGenerate,
             setScope:setScope, searchCust:searchCust, toggleCust:toggleCust, doGenerate:doGenerate };
  })();

