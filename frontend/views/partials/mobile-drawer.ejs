  /* ══════════════════ NATIVE-FEEL: TOMBOL BACK ANDROID ══════════════════
     Kelola tombol back seperti app native:
     - Kalau ada overlay terbuka (search/notif/drawer/chat/modal) → tutup itu dulu.
     - Kalau di halaman utama (/mobile) → konfirmasi keluar (bukan langsung keluar).
     - Selain itu → mundur ke halaman sebelumnya seperti biasa.
     Pakai satu "back-guard" state di history agar back pertama tak langsung
     keluar app. */
  (function(){
    // Daftar penutup overlay, urut prioritas. Kembalikan true kalau menutup sesuatu.
    function closeTopOverlay(){
      var checks=[
        ['mSearch', function(){ if(typeof msearchClose==='function') msearchClose(); }],
        ['mNotif',  function(){ if(typeof mnotifClose==='function') mnotifClose(); }],
        ['chatScreen', function(){ if(typeof closeChat==='function') closeChat(); }],
        ['mediaOv', function(){ if(typeof chatCancelMedia==='function') chatCancelMedia(); }],
        ['delOv', function(){ if(typeof closeDeleteDevice==='function') closeDeleteDevice(); }],
        ['addOv', function(){ if(typeof closeAddDevice==='function') closeAddDevice(); }],
        ['qrOv', function(){ if(typeof qrClose==='function') qrClose(); }],
        ['lightbox', function(){ if(typeof closeLightbox==='function') closeLightbox(); }],
        ['dtOv', function(){ if(typeof closeDetail==='function') closeDetail(); }],
        ['adOv', function(){ if(typeof closeCreate==='function') closeCreate(); }],
        ['fmOv', function(){ if(typeof closeForm==='function') closeForm(); }],
        ['cfOv', function(){ if(typeof closeConfirm==='function') closeConfirm(); }],
        ['mdrPanel', function(){ if(typeof mdrClose==='function') mdrClose(); }]
      ];
      for(var i=0;i<checks.length;i++){
        var el=document.getElementById(checks[i][0]);
        if(el && el.classList.contains('open')){ try{ checks[i][1](); }catch(_){ } return true; }
      }
      // overlay generic .ov.open / .cf-overlay.open (per-halaman)
      var g=document.querySelector('.ov.open, .cf-overlay.open, .pn-overlay.open, .dm-overlay.open');
      if(g){ g.classList.remove('open'); return true; }
      return false;
    }

    // Apakah ini halaman "root" (tab utama bottom-nav) → back = konfirmasi keluar.
    function isRootPage(){
      var p=location.pathname.replace(/\/+$/,'');
      return ['/mobile','/mobile/customers','/mobile/payments','/mobile/finance','/mobile/monitoring'].indexOf(p)>=0;
    }

    var _exitToastAt=0;
    // Selalu ada satu state penyangga supaya back pertama ditangkap, bukan keluar app.
    try{ history.pushState({flynGuard:true}, ''); }catch(_){ }

    window.addEventListener('popstate', function(){
      // 1) Tutup overlay teratas kalau ada.
      if(closeTopOverlay()){
        try{ history.pushState({flynGuard:true}, ''); }catch(_){ }
        haptic(8);
        return;
      }
      // 2) Halaman root: konfirmasi keluar (tekan back 2x dlm 2 detik).
      if(isRootPage()){
        var now=Date.now();
        if(now-_exitToastAt < 2000){
          // Biarkan back benar-benar keluar app (jangan push guard lagi).
          if(window.Capacitor && Capacitor.Plugins && Capacitor.Plugins.App){
            try{ Capacitor.Plugins.App.exitApp(); return; }catch(_){ }
          }
          history.back();
          return;
        }
        _exitToastAt=now;
        _nativeToast('Tekan sekali lagi untuk keluar');
        try{ history.pushState({flynGuard:true}, ''); }catch(_){ }
        return;
      }
      // 3) Halaman non-root: mundur normal.
      if(document.referrer && document.referrer.indexOf(location.host)>=0){ history.back(); }
      else { location.href='/mobile'; }
    });
  })();

  // Toast ringan (dipakai back-exit) — mandiri, tak bergantung toast per-halaman.
  function _nativeToast(msg){
    var t=document.getElementById('flynNativeToast');
    if(!t){ t=document.createElement('div'); t.id='flynNativeToast';
      t.style.cssText='position:fixed;left:50%;transform:translateX(-50%);bottom:calc(80px + env(safe-area-inset-bottom));background:rgba(26,43,74,.94);color:#fff;padding:11px 20px;border-radius:100px;font-size:13px;font-weight:600;z-index:3000;opacity:0;transition:opacity .2s;pointer-events:none;max-width:80%;text-align:center;font-family:inherit;';
      document.body.appendChild(t);
    }
    t.textContent=msg; t.style.opacity='1';
    clearTimeout(t._to); t._to=setTimeout(function(){ t.style.opacity='0'; }, 1800);
  }

  /* ══════════════════ TOP NAV STICKY ══════════════════ */
  function _tokenTop(){ var ls=localStorage.getItem('token'); if(ls)return ls; var m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
  async function _apiTop(url){
