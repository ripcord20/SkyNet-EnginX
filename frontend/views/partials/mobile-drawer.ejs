  /* ══════════════════ OVERLAY PENCARIAN GLOBAL ══════════════════ */
  var _msTimer=null, _msSeq=0;
  function msearchOpen(){
    var ms=document.getElementById('mSearch'); ms.classList.add('open');
    document.body.style.overflow='hidden';
    setTimeout(function(){ var i=document.getElementById('mSearchInput'); if(i) i.focus(); }, 80);
  }
