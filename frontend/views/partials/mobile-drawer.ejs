      var t=_tokenTop();
      var r=await fetch(url,{credentials:'include',headers:Object.assign({'X-Requested-With':'XMLHttpRequest'}, t?{'Authorization':'Bearer '+t}:{})});
      if(!r.ok) return null;
      return await r.json();
    }catch(e){ return null; }
