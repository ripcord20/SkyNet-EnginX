  async function mdrLogout(){
    try{
      var t=(function(){ var ls=localStorage.getItem('token'); if(ls)return ls; var m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; })();
      await fetch('/api/auth/logout',{method:'POST',credentials:'include',headers:t?{'Authorization':'Bearer '+t}:{}});
    }catch(e){}
