        b.innerHTML='<span>Sebagian data gagal dimuat.</span><button style="background:#0ea5e9;color:#fff;border:none;padding:7px 14px;border-radius:9px;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;" onclick="location.reload()">Muat ulang</button>';
        document.body.appendChild(b);
