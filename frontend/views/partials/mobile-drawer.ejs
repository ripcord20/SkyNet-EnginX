  (function initTopNav(){
    var mtop=document.getElementById('mTop');
    var wrap=document.querySelector('.wrap');
    if(!mtop||!wrap) return;

    // Pindahkan top nav menjadi anak PERTAMA .wrap supaya sticky ke scroll container
    wrap.insertBefore(mtop, wrap.firstChild);

    // Sembunyikan .topbar lama milik halaman (mis. home) agar tidak dobel.
    // Hanya dijalankan di halaman yang memuat top nav global ini.
    try{
      wrap.querySelectorAll(':scope > .topbar').forEach(function(el){ el.style.display='none'; });
    }catch(_){
      // fallback untuk browser lawas tanpa :scope
      Array.prototype.forEach.call(wrap.children, function(el){
        if(el.classList && el.classList.contains('topbar')) el.style.display='none';
      });
    }

    // Bayangan muncul saat konten discroll
    wrap.addEventListener('scroll', function(){
      if(wrap.scrollTop>4) mtop.classList.add('scrolled'); else mtop.classList.remove('scrolled');
    }, {passive:true});

    // Avatar: pakai foto profil kalau ada, jika tidak inisial nama.
    // Cache-buster (?t=) mengikuti pola halaman profil agar foto baru langsung tampil.
    _apiTop('/api/auth/profile').then(function(j){
      var u=j&&(j.data||j.user||j);
      if(!u) return;
