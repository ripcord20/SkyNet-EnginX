  function msearchClearText(){
    var i=document.getElementById('mSearchInput'); i.value=''; i.focus();
    document.getElementById('mSearchClear').classList.remove('show');
    _msRenderHint();
  }
  function _msEsc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
  function _msRenderHint(){
    document.getElementById('mSearchBody').innerHTML='<div class="msearch-hint">Ketik untuk mencari pelanggan (nama / ID / no. HP), atau nama paket. Tap hasil untuk membuka detailnya.</div>';
  }
  function _msSpin(){ document.getElementById('mSearchBody').innerHTML='<div class="msearch-spin"></div>'; }

  function msearchInput(){
    var q=document.getElementById('mSearchInput').value.trim();
    document.getElementById('mSearchClear').classList.toggle('show', q.length>0);
    if(_msTimer) clearTimeout(_msTimer);
    if(!q){ _msRenderHint(); return; }
    if(q.length<2){ return; }
    _msSpin();
    _msTimer=setTimeout(function(){ _msDoSearch(q); }, 280);
  }

  async function _msDoSearch(q){
    var seq=++_msSeq;
    var enc=encodeURIComponent(q);
    var results=await Promise.all([
      _apiTop('/api/customers?search='+enc+'&limit=8'),
      _apiTop('/api/packages'),
      _apiTop('/api/billing/invoices?search='+enc+'&limit=6')
    ]);
    if(seq!==_msSeq) return; // hasil kadaluarsa (user sudah ketik lagi)

    var custRes=results[0], pkgRes=results[1], invRes=results[2];
    var custs=[];
    if(custRes){ var cd=custRes.data!=null?custRes.data:custRes; custs=Array.isArray(cd)?cd:(cd&&cd.rows?cd.rows:(cd&&cd.customers?cd.customers:[])); }
    var pkgs=[];
    if(pkgRes){ var pd=pkgRes.data!=null?pkgRes.data:pkgRes; var arr=Array.isArray(pd)?pd:(pd&&pd.rows?pd.rows:[]);
      var ql=q.toLowerCase();
      pkgs=arr.filter(function(p){ return (p.name||'').toLowerCase().indexOf(ql)>=0; }).slice(0,6);
    }
    var invs=[];
    if(invRes){ var ivd=invRes.data!=null?invRes.data:invRes; invs=Array.isArray(ivd)?ivd:(ivd&&ivd.rows?ivd.rows:[]); invs=invs.slice(0,6); }

    var html='';
    if(custs.length){
      html+='<div class="msearch-sec">Pelanggan</div>';
      custs.forEach(function(c){
        var nm=c.name||'Pelanggan';
        var sub=[c.customer_id,c.phone].filter(Boolean).join(' · ');
        html+='<a class="msearch-item" href="/mobile/customers?focus='+encodeURIComponent(c.id!=null?c.id:'')+'">'
            + '<div class="msearch-ic cust">'+_msEsc(nm.charAt(0).toUpperCase())+'</div>'
            + '<div style="min-width:0;"><div class="msearch-tt">'+_msEsc(nm)+'</div><div class="msearch-ss">'+_msEsc(sub||'—')+'</div></div></a>';
      });
    }
    if(invs.length){
      html+='<div class="msearch-sec">Invoice</div>';
      invs.forEach(function(iv){
        var no=iv.invoice_number||iv.number||('#'+(iv.id||''));
        var who=(iv.customer&&iv.customer.name)||iv.customer_name||'';
        var amt=(iv.total!=null?iv.total:(iv.amount!=null?iv.amount:null));
        var st=(iv.status||'').toLowerCase();
        var stTxt=st==='paid'?'Lunas':(st==='overdue'?'Lewat tempo':(st==='unpaid'?'Belum bayar':st));
        var sub=[who, amt!=null?('Rp'+Number(amt).toLocaleString('id-ID')):'', stTxt].filter(Boolean).join(' · ');
        html+='<a class="msearch-item" href="/mobile/invoice">'
            + '<div class="msearch-ic inv"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>'
            + '<div style="min-width:0;"><div class="msearch-tt">'+_msEsc(no)+'</div><div class="msearch-ss">'+_msEsc(sub||'—')+'</div></div></a>';
      });
    }
    if(pkgs.length){
      html+='<div class="msearch-sec">Paket</div>';
      pkgs.forEach(function(p){
        var price=(p.price!=null)?('Rp'+Number(p.price).toLocaleString('id-ID')):'';
        var spd=(p.speed_down!=null)?(p.speed_down+' Mbps'):(p.speed?(p.speed+' Mbps'):'');
        var sub=[spd,price].filter(Boolean).join(' · ');
        html+='<a class="msearch-item" href="/mobile/packages">'
            + '<div class="msearch-ic pkg">P</div>'
            + '<div style="min-width:0;"><div class="msearch-tt">'+_msEsc(p.name||'Paket')+'</div><div class="msearch-ss">'+_msEsc(sub||'—')+'</div></div></a>';
      });
    }
    if(!html){
      html='<div class="msearch-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><div>Tidak ada hasil untuk "'+_msEsc(q)+'"</div></div>';
    }
    document.getElementById('mSearchBody').innerHTML=html;
  }

  /* ── Scroll-lock global ───────────────────────────────────────────────
     Karena .wrap yang men-scroll (bukan body), kode lama yang mengunci scroll
     lewat document.body.style.overflow='hidden' (bottom sheet di customers/
     payments/hotspot) perlu ikut mengunci .wrap. Observer ini menyinkronkan
     overflow body → .wrap otomatis tanpa mengubah script tiap halaman. */
  (function(){
    var wrap = document.querySelector('.wrap');
    if(!wrap || !window.MutationObserver) return;
    var obs = new MutationObserver(function(){
      var ov = document.body.style.overflow;
      if(ov === 'hidden'){ if(wrap.style.overflow !== 'hidden') wrap.style.overflow='hidden'; }
      else { if(wrap.style.overflow === 'hidden') wrap.style.overflow=''; }
    });
    obs.observe(document.body, { attributes:true, attributeFilter:['style'] });
  })();

  /* ══════════════════ NATIVE-FEEL: HAPTIC ══════════════════
     Getar halus saat interaksi. Pakai Capacitor Haptics kalau ada (APK),
     fallback ke navigator.vibrate (WebView Android). Aman di web (no-op). */
  function haptic(ms){
    try{
      if(window.Capacitor && Capacitor.Plugins && Capacitor.Plugins.Haptics){
        var style = ms>=20?'Medium':(ms>=12?'Light':'Light');
        Capacitor.Plugins.Haptics.impact({ style: style });
        return;
      }
      if(navigator.vibrate){ navigator.vibrate(ms||10); }
    }catch(_){ }
  }
  // Getar otomatis di elemen interaktif umum (tombol, tab, item daftar, nav).
  document.addEventListener('click', function(e){
    var el=e.target.closest('button, .tab, .bn-item, .mdr-item, .conv, .svc, .kpi, a[href], .fab, .head-add, [data-haptic]');
    if(!el) return;
    if(el.hasAttribute('disabled')) return;
    haptic(el.matches('.fab, .send-btn, .btn-con, .send-btn') ? 16 : 9);
  }, true);

  /* ══════════════════ NATIVE-FEEL: RIPPLE ══════════════════
     Efek sentuh material pada tombol & item yang bisa ditekan. */
  (function(){
    var style=document.createElement('style');
    style.textContent=
      '.flyn-ripple-host{position:relative;overflow:hidden;}'+
      '.flyn-ripple{position:absolute;border-radius:50%;transform:scale(0);opacity:.35;'+
      'background:currentColor;pointer-events:none;animation:flynRipple .55s ease-out forwards;mix-blend-mode:multiply;}'+
      '@keyframes flynRipple{to{transform:scale(2.4);opacity:0;}}'+
      '@media (prefers-reduced-motion:reduce){.flyn-ripple{display:none;}}';
    document.head.appendChild(style);

    document.addEventListener('pointerdown', function(e){
      var el=e.target.closest('button, .tab, .bn-item, .mdr-item, .conv, .svc, .fab, .head-add, .add-dev-btn, .send-btn');
      if(!el || el.hasAttribute('disabled')) return;
      var rect=el.getBoundingClientRect();
      var size=Math.max(rect.width, rect.height);
      var host=el;
      if(!host.classList.contains('flyn-ripple-host')) host.classList.add('flyn-ripple-host');
      var r=document.createElement('span');
      r.className='flyn-ripple';
      r.style.width=r.style.height=size+'px';
      r.style.left=(e.clientX-rect.left-size/2)+'px';
      r.style.top=(e.clientY-rect.top-size/2)+'px';
      host.appendChild(r);
      setTimeout(function(){ if(r.parentNode) r.parentNode.removeChild(r); }, 560);
    }, true);
  })();

  /* ══════════════════ NATIVE-FEEL: TRANSISI HALAMAN ══════════════════
     Fade+slide halus saat masuk halaman & saat pindah via link internal,
     sehingga navigasi terasa seperti app native, bukan reload web. */
  (function(){
    var wrap=document.querySelector('.wrap');
    if(wrap){
      wrap.style.animation='flynPageIn .26s ease';
    }
    var st=document.createElement('style');
    st.textContent='@keyframes flynPageIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}'+
      '@keyframes flynPageOut{from{opacity:1;}to{opacity:0;transform:translateY(-6px);}}'+
      '@media (prefers-reduced-motion:reduce){.wrap{animation:none !important;}}';
    document.head.appendChild(st);

    // Intersepsi navigasi internal utk animasi keluar singkat (tanpa memblokir).
    document.addEventListener('click', function(e){
      var a=e.target.closest('a[href]');
      if(!a) return;
      if(a.hasAttribute('onclick')) return;                 // sudah dihandle JS halaman
      if(e.defaultPrevented) return;
      var href=a.getAttribute('href')||'';
      if(a.target==='_blank' || href.charAt(0)==='#' || /^(https?:|mailto:|tel:|javascript:)/i.test(href)) return;
      if(href.indexOf('/mobile')!==0) return;               // hanya antar halaman mobile
      if(a.hasAttribute('data-no-transition')) return;
      if(location.pathname===href){ e.preventDefault(); return; }
      e.preventDefault();
      // Kalau drawer terbuka, tutup dulu biar transisi bersih.
      if(typeof mdrClose==='function'){ try{ mdrClose(); }catch(_){ } }
      if(wrap) wrap.style.animation='flynPageOut .16s ease forwards';
      setTimeout(function(){ location.href=href; }, 140);
    }, true);
  })();

  /* ══════════════════ NATIVE-FEEL: SPLASH BRIDGE ══════════════════
     Splash native sesungguhnya diatur plugin Capacitor SplashScreen (di sisi
     APK). Di sini kita sembunyikan splash native begitu web siap, supaya tak
     ada layar putih kosong (flash) sebelum konten tampil. */
  (function(){
    function hideNativeSplash(){
      try{
        if(window.Capacitor && Capacitor.Plugins && Capacitor.Plugins.SplashScreen){
          Capacitor.Plugins.SplashScreen.hide();
        }
      }catch(_){ }
    }
    if(document.readyState==='complete') hideNativeSplash();
    else window.addEventListener('load', hideNativeSplash);
  })();

  /* ══════════════════ NATIVE-FEEL: STATUS BAR & VIEWPORT ══════════════════
     Set warna status bar APK agar serasi dengan header (bukan hitam default). */
  (function(){
    try{
      if(window.Capacitor && Capacitor.Plugins && Capacitor.Plugins.StatusBar){
        Capacitor.Plugins.StatusBar.setStyle({ style: 'DARK' });      // teks gelap
        Capacitor.Plugins.StatusBar.setBackgroundColor({ color: '#ffffff' });
        Capacitor.Plugins.StatusBar.setOverlaysWebView({ overlay: false });
      }
    }catch(_){ }
  })();
</script>
