      else { av.textContent=(u.name?u.name.charAt(0):'U').toUpperCase(); }
    });

    // Badge notifikasi (jumlah belum dibaca) — refresh awal + berkala
    _mnRefreshBadge();
    setInterval(function(){ if(document.visibilityState==='visible') _mnRefreshBadge(); }, 60000);
