<!-- Demo banner — tampil hanya untuk user demo -->
<% if (typeof user !== 'undefined' && user && user.role && user.role.name === 'demo') { %>
  <%- include('./demo-banner') %>
<% } %>
<% const isFinanceUser = (typeof user !== 'undefined') && user && user.role && user.role.name === 'finance'; %>
<% const isSalesUser = (typeof user !== 'undefined') && user && user.role && user.role.name === 'sales'; %>
<% const onSalesPage = (typeof active !== 'undefined') && active === 'sales-dashboard'; %>
<% const useSalesBottomNav = isSalesUser || onSalesPage; %>
<!-- Top Navigation Bar -->
<header class="topbar">
  <div class="topbar-left">
    <button class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="topbar-right">
    <div class="search-box" id="globalSearchWrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text" placeholder="Cari perangkat, user..." id="globalSearch" autocomplete="off">
      <div class="global-search-dropdown" id="globalSearchDropdown"></div>
    </div>
    <div class="topbar-actions">

      <!-- Notification Bell -->
      <div class="notif-wrap" id="notifWrap">
        <button class="topbar-btn notif-bell-btn" id="notificationBtn" onclick="toggleNotifPanel()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 01-3.46 0"/>
          </svg>
          <span class="notif-count-badge" id="notifCountBadge" style="display:none;">0</span>
        </button>

        <!-- Notification Panel -->
        <div class="notif-panel" id="notifPanel" style="display:none;">
          <div class="notif-panel-hdr">
            <div>
              <div style="font-size:14px;font-weight:700;color:#0d1b3e;">Notifikasi</div>
              <div style="font-size:11px;color:#94a3b8;" id="notifSubtitle">–</div>
            </div>
            <button onclick="markAllNotifRead()" style="font-size:11.5px;color:#1a6ef5;background:none;border:none;cursor:pointer;font-weight:600;padding:0;">Tandai semua</button>
          </div>
          <div class="notif-panel-tabs">
            <button class="notif-tab active" onclick="switchNotifTab('all',this)">Semua</button>
            <button class="notif-tab" onclick="switchNotifTab('unread',this)">Belum dibaca</button>
          </div>
          <div class="notif-panel-list" id="notifPanelList">
            <div class="notif-empty-state">
              <svg width="32" height="32" fill="none" stroke="#d1d5db" stroke-width="1.5" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
              <p>Tidak ada notifikasi</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</header>

<style>
@media(min-width:769px){ .sidebar-toggle { display:none !important; } }

/* Notification */
.notif-wrap { position:relative; }
.notif-bell-btn {
  position:relative; width:36px; height:36px; border-radius:10px;
  display:flex; align-items:center; justify-content:center;
  background:none; border:none; cursor:pointer; color:#64748b;
  transition:all .15s;
}
.notif-bell-btn:hover { background:#f4f8ff; color:#1a6ef5; }
.notif-count-badge {
  position:absolute; top:-2px; right:-2px;
  min-width:16px; height:16px; border-radius:99px;
  background:#ef4444; color:#fff; font-size:9.5px; font-weight:800;
  display:flex; align-items:center; justify-content:center;
  padding:0 4px; border:2px solid #fff; line-height:1;
}
.notif-panel {
  position:absolute; right:-8px; top:calc(100% + 10px);
  width:360px; background:#fff; border-radius:16px;
  box-shadow:0 8px 40px rgba(0,0,0,.14), 0 0 0 1px rgba(0,0,0,.06);
  z-index:9999; overflow:hidden;
  animation:notifSlide .2s ease;
}
@keyframes notifSlide{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}
.notif-panel-hdr {
  padding:14px 16px 10px; display:flex; align-items:flex-start;
  justify-content:space-between; border-bottom:1px solid #f1f5f9;
}
.notif-panel-tabs { display:flex; padding:0 16px; border-bottom:1px solid #f1f5f9; }
.notif-tab {
  padding:8px 12px; font-size:12px; font-weight:600; cursor:pointer;
  border:none; background:none; color:#94a3b8; border-bottom:2px solid transparent;
  transition:all .15s; margin-bottom:-1px;
}
.notif-tab.active { color:#1a6ef5; border-bottom-color:#1a6ef5; }
.notif-panel-list { max-height:380px; overflow-y:auto; }

/* ── Modern notification item ─────────────────────────────── */
.notif-item {
  display:flex; gap:11px; padding:12px 16px;
  border-bottom:1px solid #f1f5f9; cursor:pointer;
  transition:background .15s; position:relative;
}
.notif-item:last-child { border-bottom:none; }
.notif-item:hover { background:#f8faff; }
.notif-item.unread { background:#f8fbff; }

/* Icon container: rounded square dengan subtle background + outline icon */
.notif-icon {
  width:34px; height:34px; border-radius:10px; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  font-size:0; /* hide any text fallback */
  position:relative;
}
.notif-icon svg {
  width:16px; height:16px;
  stroke-width:2;
  fill:none;
  stroke-linecap:round;
  stroke-linejoin:round;
}
/* Color variants — soft pastel bg + saturated stroke */
.notif-icon.overdue  { background:#fef2f2; }
.notif-icon.overdue  svg { stroke:#dc2626; }
.notif-icon.warning  { background:#fffbeb; }
.notif-icon.warning  svg { stroke:#d97706; }
.notif-icon.due      { background:#fef9c3; }
.notif-icon.due      svg { stroke:#a16207; }
.notif-icon.critical { background:#fef2f2; }
.notif-icon.critical svg { stroke:#b91c1c; }
.notif-icon.wa       { background:#f0fdf4; }
.notif-icon.wa       svg { stroke:#16a34a; }
.notif-icon.payment  { background:#f0fdf4; }
.notif-icon.payment  svg { stroke:#16a34a; }
.notif-icon.info     { background:#eff6ff; }
.notif-icon.info     svg { stroke:#2563eb; }

.notif-body { flex:1; min-width:0; }
.notif-title-row {
  display:flex; align-items:flex-start; justify-content:space-between;
  gap:8px; margin-bottom:3px;
}
.notif-title {
  font-size:12.5px; font-weight:600; color:#0f172a;
  line-height:1.35; flex:1; min-width:0;
}
/* Unread indicator: dot kecil di pojok kanan title */
.notif-unread-dot {
  width:7px; height:7px; border-radius:50%;
  background:#1a6ef5; flex-shrink:0;
  margin-top:5px;
  box-shadow:0 0 0 2px rgba(26,110,245,.15);
}
.notif-msg {
  font-size:11.5px; color:#64748b; line-height:1.5;
  display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
  overflow:hidden;
}
.notif-time  {
  font-size:10.5px; color:#94a3b8; margin-top:4px;
  display:flex; align-items:center; gap:4px;
}
.notif-time::before {
  content:''; width:3px; height:3px; border-radius:50%;
  background:#cbd5e1; flex-shrink:0;
}
.notif-time:first-child::before { display:none; }

.notif-empty-state {
  display:flex; flex-direction:column; align-items:center;
  justify-content:center; padding:32px 16px; color:#94a3b8; gap:8px;
  font-size:13px;
}

/* ── Global Search Dropdown ─────────────────────────────────── */
#globalSearchWrap { position:relative; }
.global-search-dropdown {
  position:absolute; top:calc(100% + 6px); left:0; right:0;
  background:#fff; border-radius:12px;
  box-shadow:0 8px 32px rgba(0,0,0,.12), 0 0 0 1px rgba(0,0,0,.05);
  z-index:9999; max-height:480px; overflow-y:auto;
  display:none; padding:6px 0;
  animation:gsdFade .15s ease;
}
.global-search-dropdown.open { display:block; }
@keyframes gsdFade { from{opacity:0;transform:translateY(-4px)} to{opacity:1;transform:translateY(0)} }
.gsd-section {
  padding:8px 14px 4px;
  font-size:10px; font-weight:700;
  color:#94a3b8; text-transform:uppercase;
  letter-spacing:.5px;
}
.gsd-item {
  display:flex; align-items:center; gap:10px;
  padding:8px 14px; cursor:pointer;
  transition:background .12s;
  text-decoration:none; color:#0d1b3e;
}
.gsd-item:hover, .gsd-item.active { background:#f4f8ff; }
.gsd-icon {
  width:30px; height:30px; border-radius:8px;
  display:flex; align-items:center; justify-content:center;
  flex-shrink:0;
}
.gsd-icon.cust { background:#dbeafe; color:#1d4ed8; }
.gsd-icon.dev  { background:#fef3c7; color:#a16207; }
.gsd-icon.infra{ background:#dcfce7; color:#15803d; }
.gsd-body { flex:1; min-width:0; }
.gsd-title {
  font-size:13px; font-weight:600;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.gsd-sub {
  font-size:11px; color:#64748b;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.gsd-empty, .gsd-loading {
  padding:24px 16px; text-align:center;
  font-size:12px; color:#94a3b8;
}
.gsd-status {
  font-size:9px; font-weight:700;
  padding:1px 6px; border-radius:8px;
  text-transform:uppercase; letter-spacing:.3px;
  flex-shrink:0; margin-left:6px;
}
.gsd-status.active   { background:#dcfce7; color:#15803d; }
.gsd-status.inactive { background:#fee2e2; color:#b91c1c; }
.gsd-status.isolated { background:#fef3c7; color:#a16207; }
.gsd-status.online   { background:#dcfce7; color:#15803d; }
.gsd-status.offline  { background:#fee2e2; color:#b91c1c; }
@media (max-width: 600px) {
  .global-search-dropdown { max-height:360px; }
}
</style>

<div class="notification-dropdown" id="notifDropdown" style="display:none"></div>

<script>
// ── Notification Panel ─────────────────────────────────────────
// Beberapa halaman (Financial/NOC/Sales Dashboard) tidak memuat /js/app.js,
// jadi objek `App` tidak ada → panel notifikasi "gagal memuat". Pakai helper
// lokal `notifApi()` yang memilih App.api bila tersedia, atau fetch sendiri.
// Tidak menyentuh/menimpa window.App agar tidak bentrok dengan app.js.
async function notifApi(url, options = {}) {
  if (typeof window.App !== 'undefined' && typeof window.App.api === 'function') {
    return window.App.api(url, options);
  }
  const headers = { 'Content-Type':'application/json', 'Accept':'application/json', 'X-Requested-With':'XMLHttpRequest' };
  let token = null; try { token = localStorage.getItem('token'); } catch(_) {}
  if (token && token !== 'null') headers['Authorization'] = 'Bearer ' + token;
  if (options.headers) Object.assign(headers, options.headers);
  try {
    const res = await fetch('/api' + url, { ...options, headers, credentials:'include' });
    return await res.json();
  } catch (e) { return { success:false, message:'Network error' }; }
}

let _notifOpen   = false;
let _notifTab    = 'all';
let _notifItems  = [];

function toggleNotifPanel() {
  _notifOpen = !_notifOpen;
  const panel = document.getElementById('notifPanel');
  if (panel) panel.style.display = _notifOpen ? 'block' : 'none';
  if (_notifOpen) loadNotifPanel();
}

// Close on outside click
document.addEventListener('click', function(e) {
  const wrap = document.getElementById('notifWrap');
  if (wrap && !wrap.contains(e.target)) {
    _notifOpen = false;
    const p = document.getElementById('notifPanel');
    if (p) p.style.display = 'none';
  }
});

async function loadNotifPanel() {
  const list = document.getElementById('notifPanelList');
  if (!list) return;
  list.innerHTML = '<div style="padding:20px;text-align:center;color:#94a3b8;font-size:12px;">Memuat...</div>';

  const renderEmpty = (txt) => {
    list.innerHTML = '<div class="notif-empty-state"><svg width="32" height="32" fill="none" stroke="#d1d5db" stroke-width="1.5" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg><p>' + (txt || 'Tidak ada notifikasi') + '</p></div>';
  };

  const url = _notifTab === 'unread' ? '/notifications?unread=true&limit=30' : '/notifications?limit=30';
  let d;
  try {
    d = await notifApi(url);
  } catch (e) {
    renderEmpty('Gagal memuat notifikasi');
    return;
  }
  if (!d || d.success === false) { renderEmpty('Gagal memuat notifikasi'); return; }
  _notifItems = Array.isArray(d.data) ? d.data : [];

  updateNotifSubtitle();

  if (!_notifItems.length) { renderEmpty('Tidak ada notifikasi'); return; }

  list.innerHTML = _notifItems.map(n => {
    const icon = getNotifIcon(n.type, n.severity);
    const iconClass = getNotifIconClass(n.type, n.severity);
    const time = formatNotifTime(n.created_at);
    return `<div class="notif-item ${n.is_read ? '' : 'unread'}" onclick="readNotif(${n.id}, this)">
      <div class="notif-icon ${iconClass}">${icon}</div>
      <div class="notif-body">
        <div class="notif-title-row">
          <div class="notif-title">${escHtml(n.title)}</div>
          ${n.is_read ? '' : '<span class="notif-unread-dot" title="Belum dibaca"></span>'}
        </div>
        <div class="notif-msg">${escHtml(n.message)}</div>
        <div class="notif-time">${time}</div>
      </div>
    </div>`;
  }).join('');
}

function updateNotifSubtitle() {
  const unreadCount = _notifItems.filter(n => !n.is_read).length;
  const el = document.getElementById('notifSubtitle');
  if (el) el.textContent = unreadCount > 0 ? unreadCount + ' belum dibaca' : 'Semua sudah dibaca';
}

function getNotifIcon(type, severity) {
  // SVG inline icons — konsisten cross-browser, stroke-based, modern outline style
  const ICONS = {
    // Invoice & billing
    overdue:    '<svg viewBox="0 0 24 24"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>',
    due_today:  '<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><circle cx="12" cy="15" r="1.5" fill="currentColor"/></svg>',
    due_soon:   '<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>',
    payment:    '<svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>',
    // Operations
    isolir:     '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M4.93 4.93l14.14 14.14"/></svg>',
    restore:    '<svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 4v5h5"/></svg>',
    // WhatsApp / messaging
    wa_incoming:    '<svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>',
    wa_disconnected:'<svg viewBox="0 0 24 24"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>',
    // System
    critical:   '<svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
    warning:    '<svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
    info:       '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
  };

  // Map type ke icon — prioritas: type spesifik > severity > default
  if (type === 'overdue')         return ICONS.overdue;
  if (type === 'due_today')       return ICONS.due_today;
  if (type === 'due_soon')        return ICONS.due_soon;
  if (type === 'payment')         return ICONS.payment;
  if (type === 'isolir')          return ICONS.isolir;
  if (type === 'restore')         return ICONS.restore;
  if (type === 'wa_incoming')     return ICONS.wa_incoming;
  if (type === 'wa_disconnected') return ICONS.wa_disconnected;
  if (severity === 'critical')    return ICONS.critical;
  if (severity === 'warning')     return ICONS.warning;
  return ICONS.info;
}

function getNotifIconClass(type, severity) {
  // CSS class untuk background color icon container
  if (type === 'overdue')         return 'overdue';
  if (type === 'due_today')       return 'warning';
  if (type === 'due_soon')        return 'due';
  if (type === 'payment')         return 'payment';
  if (type === 'restore')         return 'payment';
  if (type === 'isolir')          return 'overdue';
  if (type === 'wa_incoming')     return 'wa';
  if (type === 'wa_disconnected') return 'warning';
  if (severity === 'critical')    return 'critical';
  if (severity === 'warning')     return 'warning';
  return 'info';
}

function formatNotifTime(dt) {
  if (!dt) return '';
  const now  = new Date();
  const d    = new Date(dt);
  const diff = Math.floor((now - d) / 1000);
  if (diff < 60)   return 'Baru saja';
  if (diff < 3600) return Math.floor(diff/60) + ' menit lalu';
  if (diff < 86400)return Math.floor(diff/3600) + ' jam lalu';
  return d.toLocaleDateString('id-ID', { day:'2-digit', month:'short' });
}

function escHtml(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

async function readNotif(id, el) {
  if (el && el.classList.contains('unread')) {
    el.classList.remove('unread');
    // Hapus unread dot dengan animasi fade-out
    const dot = el.querySelector('.notif-unread-dot');
    if (dot) {
      dot.style.transition = 'opacity .2s';
      dot.style.opacity = '0';
      setTimeout(() => dot.remove(), 200);
    }
    await notifApi('/notifications/' + id + '/read', { method:'PUT' });
    updateNotifCount();
  }
}

async function markAllNotifRead() {
  await notifApi('/notifications/read-all', { method:'PUT' });
  document.querySelectorAll('.notif-item.unread').forEach(el => {
    el.classList.remove('unread');
    const dot = el.querySelector('.notif-unread-dot');
    if (dot) dot.remove();
  });
  document.getElementById('notifCountBadge').style.display = 'none';
  const sub = document.getElementById('notifSubtitle');
  if (sub) sub.textContent = 'Semua sudah dibaca';
}

function switchNotifTab(tab, btn) {
  _notifTab = tab;
  document.querySelectorAll('.notif-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  loadNotifPanel();
}

async function updateNotifCount() {
  const d = await notifApi('/notifications/unread-count');
  const count = d?.data?.count || 0;
  const badge = document.getElementById('notifCountBadge');
  if (badge) {
    badge.textContent = count > 99 ? '99+' : count;
    badge.style.display = count > 0 ? 'flex' : 'none';
  }
}

// Init + socket listener
document.addEventListener('DOMContentLoaded', () => {
  updateNotifCount();
  setInterval(updateNotifCount, 30000); // refresh tiap 30 detik
  // Socket real-time ditangani oleh App.initSocket() (satu koneksi saja) agar
  // tidak ada toast/notif dobel. App akan memanggil window.updateNotifCount &
  // window.loadNotifPanel saat ada notifikasi baru.
});

// ── Global Search (Topbar) ──────────────────────────────────
//
// Search dengan debounce 250ms. Query paralel ke /customers, /devices,
// dan /infrastructure (kalau filter "all"). Hasil di-merge & ditampilkan
// di dropdown dengan kategori. Keyboard nav: arrow keys + Enter. 
(function() {
  const inputEl    = document.getElementById('globalSearch');
  const dropdownEl = document.getElementById('globalSearchDropdown');
  const wrapEl     = document.getElementById('globalSearchWrap');
  if (!inputEl || !dropdownEl) return;

  let debounceTimer = null;
  let lastQuery     = '';
  let resultItems   = []; // flat list untuk keyboard nav
  let activeIdx     = -1;
  let abortCtrl     = null;

  const ICONS = {
    cust:  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
    dev:   '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
    infra: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="1,6 1,22 8,18 16,22 23,18 23,2 16,6 8,2 1,6"/></svg>'
  };

  function escHtmlLocal(s) {
    return String(s == null ? '' : s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }

  function openDropdown()  { dropdownEl.classList.add('open'); }
  function closeDropdown() { dropdownEl.classList.remove('open'); activeIdx = -1; }

  // Cari pelanggan + device + infrastructure paralel
  async function performSearch(q) {
    if (abortCtrl) abortCtrl.abort();
    abortCtrl = new AbortController();
    const signal = abortCtrl.signal;

    const tok = localStorage.getItem('token');
    const hdr = { 'X-Requested-With':'XMLHttpRequest' };
    if (tok && tok !== 'null') hdr['Authorization'] = 'Bearer ' + tok;
    const opts = { headers: hdr, credentials: 'include', signal };

    const enc = encodeURIComponent(q);

    // Ketiga endpoint sudah dijaga authentication — fail silently kalau forbidden
    const [custRes, devRes, infraRes] = await Promise.all([
      fetch('/api/customers?search=' + enc + '&limit=5', opts).then(r=>r.json()).catch(()=>null),
      fetch('/api/devices?search='   + enc + '&limit=5', opts).then(r=>r.json()).catch(()=>null),
      fetch('/api/infrastructure?search=' + enc + '&limit=5', opts).then(r=>r.json()).catch(()=>null)
    ]);

    if (signal.aborted) return; // result obsolete

    const customers = (custRes?.data || custRes?.customers || []).slice(0, 5);
    const devices   = (devRes?.data   || []).slice(0, 5);
    // Infra: filter agar hanya match nama (search endpoint mungkin tidak filter)
    const infras    = (infraRes?.data || []).filter(i =>
      (i.name||'').toLowerCase().includes(q.toLowerCase()) ||
      (i.address||'').toLowerCase().includes(q.toLowerCase())
    ).slice(0, 5);

    renderResults(customers, devices, infras, q);
  }

  function renderResults(customers, devices, infras, q) {
    resultItems = [];
    let html = '';

    if (customers.length) {
      html += '<div class="gsd-section">Pelanggan</div>';
      customers.forEach(c => {
        const idx = resultItems.length;
        resultItems.push({ url: '/customers/profile/' + c.id });
        const stat = c.status === 'active' ? 'active' : c.status === 'isolated' ? 'isolated' : 'inactive';
        const sub = [c.customer_id, c.phone, c.package?.name].filter(Boolean).join(' · ');
        html += `<a class="gsd-item" data-idx="${idx}" href="/customers/profile/${c.id}">
          <div class="gsd-icon cust">${ICONS.cust}</div>
          <div class="gsd-body">
            <div class="gsd-title">${escHtmlLocal(c.name)}</div>
            <div class="gsd-sub">${escHtmlLocal(sub)}</div>
          </div>
          <span class="gsd-status ${stat}">${escHtmlLocal(c.status||'')}</span>
        </a>`;
      });
    }

    if (devices.length) {
      html += '<div class="gsd-section">Perangkat</div>';
      devices.forEach(d => {
        const idx = resultItems.length;
        resultItems.push({ url: '/devices' });  // halaman list device — anchor by ID
        const stat = d.status === 'online' ? 'online' : 'offline';
        const sub = [d.ip_address, d.type, d.brand].filter(Boolean).join(' · ');
        html += `<a class="gsd-item" data-idx="${idx}" href="/devices?focus=${d.id}">
          <div class="gsd-icon dev">${ICONS.dev}</div>
          <div class="gsd-body">
            <div class="gsd-title">${escHtmlLocal(d.name)}</div>
            <div class="gsd-sub">${escHtmlLocal(sub)}</div>
          </div>
          <span class="gsd-status ${stat}">${escHtmlLocal(d.status||'')}</span>
        </a>`;
      });
    }

    if (infras.length) {
      html += '<div class="gsd-section">Infrastruktur</div>';
      infras.forEach(i => {
        const idx = resultItems.length;
        resultItems.push({ url: '/infrastructure' });
        const sub = [i.type?.toUpperCase(), i.address, i.status].filter(Boolean).join(' · ');
        html += `<a class="gsd-item" data-idx="${idx}" href="/infrastructure?focus=${i.id}">
          <div class="gsd-icon infra">${ICONS.infra}</div>
          <div class="gsd-body">
            <div class="gsd-title">${escHtmlLocal(i.name)}</div>
            <div class="gsd-sub">${escHtmlLocal(sub)}</div>
          </div>
        </a>`;
      });
    }

    if (!html) {
      html = `<div class="gsd-empty">Tidak ada hasil untuk "${escHtmlLocal(q)}"</div>`;
    }

    dropdownEl.innerHTML = html;
    openDropdown();
  }

  function setActive(idx) {
    const items = dropdownEl.querySelectorAll('.gsd-item');
    if (!items.length) return;
    activeIdx = ((idx % items.length) + items.length) % items.length;
    items.forEach((el, i) => el.classList.toggle('active', i === activeIdx));
    items[activeIdx].scrollIntoView({ block: 'nearest' });
  }

  inputEl.addEventListener('input', () => {
    const q = inputEl.value.trim();
    clearTimeout(debounceTimer);
    if (!q) { closeDropdown(); lastQuery=''; return; }
    if (q === lastQuery) return;
    lastQuery = q;
    // Show loading state
    dropdownEl.innerHTML = '<div class="gsd-loading">Mencari...</div>';
    openDropdown();
    debounceTimer = setTimeout(() => performSearch(q), 250);
  });

  inputEl.addEventListener('focus', () => {
    if (inputEl.value.trim() && resultItems.length) openDropdown();
  });

  inputEl.addEventListener('keydown', (e) => {
    const items = dropdownEl.querySelectorAll('.gsd-item');
    if (!items.length) return;
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIdx + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIdx - 1); }
    else if (e.key === 'Enter') {
      e.preventDefault();
      const target = activeIdx >= 0 ? items[activeIdx] : items[0];
      if (target) window.location.href = target.getAttribute('href');
    } else if (e.key === 'Escape') {
      closeDropdown();
      inputEl.blur();
    }
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!wrapEl.contains(e.target)) closeDropdown();
  });
})();
</script>

