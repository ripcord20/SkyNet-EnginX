<script>
  // Auto-hide menu tidak relevan untuk user demo
  (function() {
    const hideSelectors = [
      'a[href="/broadcast"]',
      'a[href="/wa/reminder"]',
      'a[href="/wa/report"]',
      'a[href="/isolir"]',
      'a[href="/settings"]',
      'a[href="/settings/users"]',
