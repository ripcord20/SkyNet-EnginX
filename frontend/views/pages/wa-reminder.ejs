<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    :root{
      --et-bg:#eef2f9;--et-card:#fff;--et-border:#e0e7f3;
      --et-text:#0d1b3e;--et-muted:#6b7fa8;--et-blue:#1f8bff;--et-blue-deep:#1565e0;
    }
    body{background:var(--et-bg);font-family:'DM Sans',sans-serif;}
    .et-page{padding:0;max-width:none;margin:0;}
    .et-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:12px;}
    .et-title{font-size:22px;font-weight:800;color:var(--et-text);letter-spacing:-.01em;}
    .et-sub{font-size:13px;color:var(--et-muted);margin-top:3px;}
    .et-actions{display:flex;gap:10px;flex-wrap:wrap;}
    .et-btn{padding:9px 16px;border-radius:10px;font-size:13px;font-weight:700;border:none;cursor:pointer;
      display:inline-flex;align-items:center;gap:7px;font-family:inherit;transition:all .15s;}
    .et-btn-primary{background:linear-gradient(135deg,#1f8bff,#1565e0);color:#fff;box-shadow:0 4px 10px -2px rgba(31,122,255,.4);}
    .et-btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 14px -2px rgba(31,122,255,.5);}
    .et-btn-primary:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
    .et-btn-ghost{background:#fff;color:var(--et-text);border:1.5px solid var(--et-border);}
    .et-btn-ghost:hover{border-color:var(--et-blue);color:var(--et-blue);}
    .et-btn-teal{background:linear-gradient(135deg,#00c2f0,#0091b8);color:#fff;box-shadow:0 4px 10px -2px rgba(0,170,210,.4);}
    .et-btn-teal:hover{transform:translateY(-1px);}

    /* Stat strip (single row) */
    .rm-strip{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border-radius:16px;
      border:1px solid var(--et-border);overflow:hidden;margin-bottom:18px;}
    .rm-sc{padding:16px 18px 14px;border-right:1px solid var(--et-border);position:relative;overflow:hidden;}
    .rm-sc:last-child{border-right:none;}
    .rm-sc-lbl{font-size:11.5px;font-weight:600;color:var(--et-muted);margin-bottom:9px;letter-spacing:.1px;}
    .rm-sc-body{display:flex;align-items:flex-end;justify-content:space-between;gap:8px;}
    .rm-sc-val{font-size:27px;font-weight:800;color:#0f172a;letter-spacing:-1px;line-height:1;}
    .rm-sc-meta{display:flex;align-items:center;gap:5px;margin-top:7px;flex-wrap:wrap;}
    .rm-sc-pill{display:inline-flex;align-items:center;padding:1px 7px;border-radius:100px;font-size:10.5px;font-weight:700;}
    .rm-sc-sub{font-size:11px;color:#94a3b8;}
    .pill-blue{background:#dbeafe;color:#1d4ed8;}.pill-teal{background:#cffafe;color:#0e7490;}
    .pill-amber{background:#fef3c7;color:#b45309;}.pill-green{background:#dcfce7;color:#16a34a;}
    .rm-spark{flex-shrink:0;width:66px;height:34px;}.rm-spark svg{width:66px;height:34px;}
    .sp-line{stroke-width:1.8;fill:none;stroke-linecap:round;stroke-linejoin:round;}
    @media(max-width:760px){.rm-strip{grid-template-columns:repeat(2,1fr);}
      .rm-sc{border-bottom:1px solid var(--et-border);}
      .rm-sc:nth-child(odd){border-right:1px solid var(--et-border);}.rm-sc:nth-child(even){border-right:none;}
      .rm-sc:nth-last-child(-n+2){border-bottom:none;}}

    /* Layout: list | editor | preview */
    .et-grid{display:grid;grid-template-columns:300px 1fr 1fr;gap:18px;align-items:start;}
    @media (max-width:1280px){.et-grid{grid-template-columns:260px 1fr;}.et-preview-col{grid-column:1 / -1;}}
    @media (max-width:860px){.et-grid{grid-template-columns:1fr;}}

    .et-card{background:var(--et-card);border:1px solid var(--et-border);border-radius:16px;overflow:hidden;}
    .et-card-h{padding:13px 16px;border-bottom:1px solid var(--et-border);font-size:12px;font-weight:800;
      letter-spacing:.04em;text-transform:uppercase;color:var(--et-muted);display:flex;align-items:center;gap:8px;}
    .et-card-h .cnt{margin-left:auto;font-size:11px;font-weight:700;color:var(--et-blue-deep);background:#eef5ff;
      padding:2px 8px;border-radius:20px;letter-spacing:0;}

    /* Reminder list (left) */
    .et-list{display:flex;flex-direction:column;padding:8px;}
    .rm-grp-lbl{font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
      padding:11px 10px 5px;display:flex;align-items:center;gap:7px;}
    .rm-grp-lbl .dot{width:7px;height:7px;border-radius:50%;}
    .et-item{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:12px;cursor:pointer;
      border:1.5px solid transparent;transition:all .14s;text-align:left;background:none;font-family:inherit;width:100%;}
    .et-item:hover{background:#f4f8ff;}
    .et-item.active{background:#eef5ff;border-color:var(--et-blue);}
    .et-item-ic{width:42px;height:38px;border-radius:11px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
      font-size:13px;font-weight:800;}
    .et-item-b{flex:1;min-width:0;}
    .et-item-t{font-size:13px;font-weight:700;color:var(--et-text);line-height:1.25;display:block;}
    .et-item-d{font-size:11px;color:var(--et-muted);margin-top:3px;line-height:1.35;display:block;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .et-pill{display:inline-block;font-size:9.5px;font-weight:800;padding:2px 7px;border-radius:6px;margin-top:5px;letter-spacing:.03em;}
    .et-pill.on{background:#e7f7ef;color:#0a9a5a;}
    .et-pill.off{background:#f1f3f7;color:#8a95ad;}

    /* Editor (middle) */
    .et-editor{padding:16px;}
    .et-field{margin-bottom:15px;}
    .et-field:last-child{margin-bottom:0;}
    .et-label{display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700;
      color:#33415c;margin-bottom:7px;}
    .et-inp,.et-sel{width:100%;border:1.5px solid var(--et-border);border-radius:11px;padding:10px 13px;
      font-family:inherit;font-size:13.5px;color:var(--et-text);background:#f9fbfe;outline:none;transition:all .15s;}
    .et-inp:focus,.et-sel:focus{border-color:var(--et-blue);background:#fff;box-shadow:0 0 0 3.5px rgba(31,139,255,.1);}
    .et-hint{font-size:11px;color:var(--et-muted);margin-top:6px;line-height:1.5;}
    .et-day-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:11px;font-size:14px;font-weight:800;}
    .et-day-meta{font-size:11.5px;font-weight:600;color:var(--et-muted);margin-top:6px;}

    /* time input nice look */
    input[type=time].et-inp{font-family:'DM Mono',monospace;letter-spacing:.5px;}

    /* Toggle (same as email template) */
    .et-switch{position:relative;display:inline-flex;align-items:center;gap:9px;cursor:pointer;}
    .et-switch input{display:none;}
    .et-track{width:42px;height:24px;border-radius:13px;background:#cfd8e8;transition:all .18s;position:relative;flex-shrink:0;}
    .et-track::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;
      transition:all .18s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
    .et-switch input:checked + .et-track{background:linear-gradient(135deg,#22c55e,#16a34a);}
    .et-switch input:checked + .et-track::after{left:20px;}
    .et-switch-l{font-size:12.5px;font-weight:700;color:#33415c;}

    /* Empty template warning */
    .et-warn{margin-top:14px;padding:11px 13px;background:#fff8e6;border:1px solid #ffe2a8;border-radius:10px;
      font-size:11.5px;line-height:1.5;color:#92660a;}

    /* Preview — WhatsApp chat bubble (same as wa-templates) */
    .et-preview-col .et-card{position:sticky;top:14px;}
    .wa-cat-tag{padding:9px 16px;border-bottom:1px solid var(--et-border);background:#f9fbfe;display:flex;align-items:center;gap:8px;
      font-size:11.5px;font-weight:700;color:var(--et-muted);}
    .wa-chat{background:#e5ddd5;background-image:linear-gradient(rgba(229,221,213,.92),rgba(229,221,213,.92));padding:0;min-height:380px;}
    .wa-bar{background:#075E54;padding:11px 16px;display:flex;align-items:center;gap:11px;}
    .wa-av{width:38px;height:38px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;}
    .wa-meta{flex:1;min-width:0;}
    .wa-name{font-size:14px;font-weight:700;color:#fff;line-height:1.2;}
    .wa-status{font-size:11px;color:rgba(255,255,255,.75);margin-top:1px;}
    .wa-body{padding:18px 16px 24px;min-height:300px;display:flex;flex-direction:column;justify-content:flex-end;}
    .wa-bubble{align-self:flex-start;background:#fff;border-radius:0 9px 9px 9px;padding:8px 11px 6px;max-width:86%;
      box-shadow:0 1px 1px rgba(0,0,0,.13);position:relative;}
    .wa-bubble::before{content:'';position:absolute;top:0;left:-7px;width:0;height:0;border:7px solid transparent;border-top-color:#fff;border-right:0;}
    .wa-text{font-size:13.5px;line-height:1.5;color:#111b21;white-space:pre-wrap;word-break:break-word;}
    .wa-time{font-size:10px;color:#667781;text-align:right;margin-top:3px;}
    .wa-bold{font-weight:700;} .wa-italic{font-style:italic;} .wa-strike{text-decoration:line-through;}
    .wa-mono{font-family:'DM Mono',monospace;background:#f0f0f0;padding:1px 4px;border-radius:4px;font-size:12.5px;}
    .wa-empty{align-self:center;margin:auto;color:#54656f;font-size:13px;text-align:center;background:rgba(255,255,255,.6);padding:14px 18px;border-radius:10px;}

    /* History panel (below preview on wide screens it sits in preview col) */
    .rm-hist{margin-top:18px;}
    .rm-hist-sum{font-size:12px;color:var(--et-text);background:#f1f6ff;border:1px solid #dbe7ff;border-radius:9px;padding:9px 11px;margin:0 16px 12px;}
    .rm-hist-list{max-height:300px;overflow:auto;padding:0 16px 14px;font-size:12px;}
    .rm-hist-item{display:flex;gap:8px;padding:8px 0;border-bottom:1px solid #f0f4ff;}
    .rm-hist-item:last-child{border-bottom:none;}

    /* Mobile tabs */
    .et-mtabs{display:none;gap:6px;margin-bottom:14px;}
    .et-mtab{flex:1;padding:9px;border-radius:10px;border:1.5px solid var(--et-border);background:#fff;
      font-size:12.5px;font-weight:700;color:var(--et-muted);font-family:inherit;cursor:pointer;}
    .et-mtab.active{background:#eef5ff;border-color:var(--et-blue);color:var(--et-blue-deep);}
    @media (max-width:860px){
      .et-mtabs{display:flex;}
      .et-grid.m-edit .et-preview-col{display:none;}
      .et-grid.m-prev .et-editor-col,.et-grid.m-prev .et-list-col{display:none;}
      .et-page{padding:12px 12px 90px;}
    }

    /* spinner kecil */
    .et-spin-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.45);border-top-color:#fff;
      border-radius:50%;animation:etspin .7s linear infinite;display:inline-block;}
    @keyframes etspin{to{transform:rotate(360deg)}}

    /* ── Modal hasil (sukses/gagal) — animasi smooth (sama dgn email template) ── */
    .rm-overlay{position:fixed;inset:0;z-index:10001;background:rgba(13,27,62,.5);
      display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;animation:rmFade .25s ease forwards;}
    @keyframes rmFade{to{opacity:1;}}
    .rm-card{background:#fff;border-radius:22px;max-width:380px;width:100%;padding:34px 28px 26px;text-align:center;
      box-shadow:0 24px 60px rgba(13,27,62,.28);transform:translateY(16px) scale(.94);opacity:0;
      animation:rmPop .42s cubic-bezier(.21,1.02,.4,1) .06s forwards;}
    @keyframes rmPop{to{transform:translateY(0) scale(1);opacity:1;}}
    .rm-icon{width:78px;height:78px;margin:0 auto 18px;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative;}
    .rm-icon.ok{background:radial-gradient(circle at 50% 40%,#eafaf0,#d8f5e3);}
    .rm-icon.err{background:radial-gradient(circle at 50% 40%,#fdeeee,#fad9d9);}
    .rm-icon svg{width:46px;height:46px;}
    .rm-icon::after{content:'';position:absolute;width:78px;height:78px;border-radius:50%;animation:rmPulse 1.1s ease-out .25s;}
    .rm-icon.ok::after{background:rgba(22,163,74,.18);}
    .rm-icon.err::after{background:rgba(220,38,38,.16);}
    @keyframes rmPulse{0%{transform:scale(.6);opacity:.7;}100%{transform:scale(1.7);opacity:0;}}
    .rm-draw{stroke-dasharray:48;stroke-dashoffset:48;animation:rmDraw .5s cubic-bezier(.65,0,.45,1) .32s forwards;}
    @keyframes rmDraw{to{stroke-dashoffset:0;}}
    .rm-title{font-size:19px;font-weight:800;color:#0d1b3e;letter-spacing:-.2px;opacity:0;animation:rmUp .4s ease .28s forwards;}
    .rm-msg{font-size:13px;color:#64748b;line-height:1.55;margin-top:7px;opacity:0;animation:rmUp .4s ease .36s forwards;}
    .rm-ok{width:100%;justify-content:center;margin-top:22px;height:48px;opacity:0;animation:rmUp .4s ease .44s forwards;}
    @keyframes rmUp{from{transform:translateY(8px);opacity:0;}to{transform:translateY(0);opacity:1;}}
    .rm-actions{display:flex;gap:10px;margin-top:22px;opacity:0;animation:rmUp .4s ease .42s forwards;}
    .rm-actions .et-btn{flex:1;justify-content:center;height:46px;}
  </style>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { active: active }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { user: user }) %>
    <main class="page-content">
    <div class="et-page">

      <!-- Header -->
      <div class="et-hdr">
        <div>
          <div class="et-title">Automation Reminder</div>
          <div class="et-sub">Atur reminder WhatsApp otomatis jatuh tempo — template, jam kirim & status aktif, dengan preview langsung</div>
        </div>
        <div class="et-actions">
          <button class="et-btn et-btn-ghost" id="btnTestSend" onclick="openTestModal()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Test ke Nomor
          </button>
          <button class="et-btn et-btn-teal" id="btnRunNow" onclick="runReminderNow()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Jalankan Sekarang
          </button>
          <button class="et-btn et-btn-primary" id="btnSave" onclick="saveReminders()">
            <svg id="btnSaveIcon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span id="btnSaveLabel">Simpan Perubahan</span>
          </button>
        </div>
      </div>

      <!-- Stat strip -->
      <div class="rm-strip">
        <div class="rm-sc">
          <div class="rm-sc-lbl">Total Reminder</div>
          <div class="rm-sc-body">
            <div><div class="rm-sc-val" id="fcTotal">0</div>
              <div class="rm-sc-meta"><span class="rm-sc-pill pill-blue" id="xp-total">—</span><span class="rm-sc-sub" id="fcTotalSub">–</span></div>
            </div>
            <div class="rm-spark"><svg viewBox="0 0 66 34" preserveAspectRatio="none"><path class="sp-line" id="sp-total-line" d="" stroke="#2563eb"/><circle id="sp-total-dot" r="2.4" fill="#2563eb"/></svg></div>
          </div>
        </div>
        <div class="rm-sc">
          <div class="rm-sc-lbl">Dengan Template</div>
          <div class="rm-sc-body">
            <div><div class="rm-sc-val" id="fcWithTpl">0</div>
              <div class="rm-sc-meta"><span class="rm-sc-pill pill-teal" id="xp-withtpl">—</span><span class="rm-sc-sub">Siap kirim</span></div>
            </div>
            <div class="rm-spark"><svg viewBox="0 0 66 34" preserveAspectRatio="none"><path class="sp-line" id="sp-withtpl-line" d="" stroke="#0891b2"/><circle id="sp-withtpl-dot" r="2.4" fill="#0891b2"/></svg></div>
          </div>
        </div>
        <div class="rm-sc">
          <div class="rm-sc-lbl">Reminder Aktif</div>
          <div class="rm-sc-body">
            <div><div class="rm-sc-val" id="fcActive">0</div>
              <div class="rm-sc-meta"><span class="rm-sc-pill pill-green" id="xp-active">—</span><span class="rm-sc-sub">Berjalan otomatis</span></div>
            </div>
            <div class="rm-spark"><svg viewBox="0 0 66 34" preserveAspectRatio="none"><path class="sp-line" id="sp-active-line" d="" stroke="#16a34a"/><circle id="sp-active-dot" r="2.4" fill="#16a34a"/></svg></div>
          </div>
        </div>
        <div class="rm-sc">
          <div class="rm-sc-lbl">Terkirim Hari Ini</div>
          <div class="rm-sc-body">
            <div><div class="rm-sc-val" id="fcSentToday">0</div>
              <div class="rm-sc-meta"><span class="rm-sc-pill pill-amber" id="xp-sent">—</span><span class="rm-sc-sub" id="fcSentSub">0 gagal</span></div>
            </div>
            <div class="rm-spark"><svg viewBox="0 0 66 34" preserveAspectRatio="none"><path class="sp-line" id="sp-sent-line" d="" stroke="#d97706"/><circle id="sp-sent-dot" r="2.4" fill="#d97706"/></svg></div>
          </div>
        </div>
      </div>

      <!-- Mobile tab switch -->
      <div class="et-mtabs">
        <button type="button" class="et-mtab active" data-mtab="edit" onclick="mtab('edit')">Edit</button>
        <button type="button" class="et-mtab" data-mtab="prev" onclick="mtab('prev')">Preview</button>
      </div>

      <div class="et-grid m-edit" id="etGrid">
        <!-- LIST -->
        <div class="et-list-col">
          <div class="et-card">
            <div class="et-card-h">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
              Jadwal Reminder
              <span class="cnt" id="rmCount">0</span>
            </div>
            <div class="et-list" id="rmList">
              <div style="text-align:center;padding:40px 16px;color:#94a3b8;font-size:13px;">Memuat…</div>
            </div>
          </div>
        </div>

        <!-- EDITOR -->
        <div class="et-editor-col">
          <div class="et-card">
            <div class="et-card-h" id="etEditorTitle">Editor Reminder</div>
            <div class="et-editor" id="etEditor">
              <div style="text-align:center;padding:40px 10px;color:#94a3b8;font-size:13px;">Pilih reminder di sebelah kiri untuk mengatur.</div>
            </div>
          </div>
        </div>

        <!-- PREVIEW + HISTORY -->
        <div class="et-preview-col">
          <div class="et-card">
            <div class="et-card-h">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              Preview Langsung
            </div>
            <div class="wa-cat-tag" id="waCatTag">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span id="waCatLabel">Reminder Otomatis</span>
            </div>
            <div class="wa-chat">
              <div class="wa-bar">
                <div class="wa-av">
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                </div>
                <div class="wa-meta">
                  <div class="wa-name" id="waContactName">Pelanggan</div>
                  <div class="wa-status" id="waContactStatus">reminder otomatis</div>
                </div>
              </div>
              <div class="wa-body">
                <div class="wa-empty" id="waEmpty">Pilih template pada reminder untuk melihat preview pesan.</div>
                <div class="wa-bubble" id="waBubble" style="display:none;">
                  <div class="wa-text" id="waText"></div>
                  <div class="wa-time" id="waTime">00.00</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Riwayat pengiriman -->
          <div class="et-card rm-hist">
            <div class="et-card-h">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Riwayat Pengiriman
              <button onclick="loadReminderHistory()" title="Muat ulang" style="margin-left:auto;background:none;border:none;cursor:pointer;color:#1f8bff;font-size:11px;font-weight:800;letter-spacing:0;">↻ Refresh</button>
            </div>
            <div class="rm-hist-sum">Hari ini: <b id="remSent">0</b> terkirim · <b id="remFailed" style="color:#dc2626;">0</b> gagal</div>
            <div class="rm-hist-list" id="remHistList">
              <div style="text-align:center;color:#94a3b8;padding:18px;">Memuat…</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </main>
  </div>
</div>

<!-- Test Send Modal -->
<div id="testModal" style="display:none;position:fixed;inset:0;background:rgba(13,27,62,.5);z-index:10000;align-items:center;justify-content:center;padding:20px;">
  <div style="background:#fff;border-radius:18px;max-width:520px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 24px 48px rgba(0,0,0,.18);">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 22px 14px;border-bottom:1px solid #e8eaed;">
      <div>
        <div style="font-size:16px;font-weight:800;color:#0d1b3e;">Test Kirim Reminder</div>
        <div style="font-size:11.5px;color:#6b7fa8;margin-top:2px;">Uji render template ke nomor HP tertentu</div>
      </div>
      <button onclick="closeTestModal()" style="background:#f4f8ff;border:1.5px solid #e0e7f3;border-radius:8px;width:30px;height:30px;cursor:pointer;color:#6b7fa8;font-size:16px;">✕</button>
    </div>
    <div style="padding:18px 22px;">
      <div class="et-field">
        <div class="et-label">Nomor HP Tujuan *</div>
        <input id="testPhone" type="text" placeholder="628123456789" class="et-inp">
        <div class="et-hint">Format: 628xxx (tanpa +/spasi). Boleh nomor sendiri.</div>
      </div>
      <div class="et-field">
        <div class="et-label">Pilih Reminder *</div>
        <select id="testReminder" class="et-sel">
          <option value="">— Pilih reminder dengan template —</option>
        </select>
        <div class="et-hint">Hanya reminder yang sudah ada template yang bisa dipilih.</div>
      </div>
      <div style="background:#fefce8;border:1px solid #fde68a;border-radius:10px;padding:10px 12px;font-size:11.5px;color:#92400e;line-height:1.6;margin-bottom:14px;">
        Sistem akan ambil <b>1 invoice unpaid real</b> sebagai sample data. Kalau tidak ada, pakai data dummy. Pesan dikirim dengan prefix <code style="background:#fff;padding:1px 4px;border-radius:3px;">[TEST]</code>.
      </div>
      <div id="testResult" style="display:none;margin-bottom:12px;padding:10px 12px;border-radius:10px;font-size:12px;line-height:1.6;"></div>
      <div style="display:flex;gap:10px;">
        <button class="et-btn et-btn-ghost" style="flex:1;justify-content:center;" onclick="closeTestModal()">Batal</button>
        <button class="et-btn et-btn-primary" style="flex:2;justify-content:center;" id="btnTestSubmit" onclick="submitTestSend()">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          Kirim Test
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal hasil (sukses/gagal) -->
<div id="resultModal" class="rm-overlay" style="display:none;">
  <div class="rm-card" id="rmCard">
    <div class="rm-icon" id="rmIcon"></div>
    <div class="rm-title" id="rmTitle">Berhasil</div>
    <div class="rm-msg" id="rmMsg"></div>
    <button class="et-btn et-btn-primary rm-ok" onclick="closeResult()">Selesai</button>
  </div>
</div>

<script>window.__COMPANY = <%- JSON.stringify(appName || 'ISP') %>;</script>
<script src="https://cdn.jsdelivr.net/npm/socket.io-client@4.7.2/dist/socket.io.min.js"></script>
<script src="/js/app.js"></script>
<script src="/js/wa-reminder.js"></script>
</body>
</html>
