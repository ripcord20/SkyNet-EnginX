        '<div style="font-size:13px;color:#475569;">Total per bulan: <strong style="color:#1e3a8a;">' + fmtRp(monthlyTotal) + '</strong></div>' +
        '<div style="display:flex;gap:8px;">' +
          '<button onclick="finGenerateRecur()" style="border:1.5px solid #dbe3ef;background:#fff;color:#475569;border-radius:9px;padding:7px 12px;font-size:12.5px;font-weight:600;cursor:pointer;">Generate Bulan Ini</button>' +
