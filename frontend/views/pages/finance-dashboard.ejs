  // ═══════ MAIN INIT ═══════════════════════════════════════════
  (async function init(){
    // Run in parallel — but render KPI hanya setelah dua fetch utama selesai
    const [_, txRows, custStats, collectionData, channels, dueLists, insights, activity, received, projection] = await Promise.all([
      // gabung keuangan + payments (race tidak masalah, state di-set masing2)
      Promise.all([loadKeuangan(), loadPayments()]),
      loadTransactions('all'),
      loadCustomers(),
      loadCollection(),
      loadChannels(),
      loadDueLists(),
      loadInsights(),
      loadActivity(),
      loadReceived(),
      loadProjection(),
    ]);

    // Total pengeluaran berulang terjadwal/bulan (untuk proyeksi bila belum posting)
    state.recurringMonthly = await loadRecurringTotal();

    // Simpan pemasukan TERTAGIH periode terpilih (dari collection-stats, basis
    // periode invoice) agar kartu Pemasukan bisa memakainya bila ledger Keuangan
    // belum mencatat pembayaran tsb (mis. invoice Juli dibayar di akhir Juni).
    state.collectedRevenue = collectionData ? parseFloat(collectionData.total_collected || 0) : 0;

    renderKPI();
    renderBalance(custStats);
    renderCollection(collectionData);
    renderChannels(channels);
    renderReceived(received);
    renderProjection(projection);
    renderCashFlow();
    loadProfitLoss();   // laporan laba rugi periode berjalan
    loadCashFlow();     // arus kas (basis kas)
    loadAging();        // umur piutang (posisi saat ini)
    loadTaxReport();    // rekap PPN
    renderBudget();
    renderTransactions(txRows);
    renderDailyTx(_dtxDays);
    renderInsights(insights);
    renderActivity(activity);

    // Customer list section — default tab: unpaid_all
    renderTabCounts(dueLists);
    renderCustomerList(_currentBucket, dueLists);

    // Setup auto-reminder toggle (independent of other data)
    setupReminderToggle();
  })();

})();
</script>
</body>
</html>
