  // ═══════ PENGELUARAN BERULANG (recurring expense) ════════════
  let _recurCache = [];
  window.finOpenRecurring = async function(){
    let modal = document.getElementById('recurModal');
    if (!modal) { modal = _buildRecurModal(); document.body.appendChild(modal); }
    modal.style.display = 'flex';
    await _recurReload();
  };
  window.finCloseRecurring = function(){
    const m = document.getElementById('recurModal'); if (m) m.style.display = 'none';
  };
  async function _recurReload(){
    const body = document.getElementById('recurBody');
    if (body) body.innerHTML = '<div style="padding:24px;text-align:center;color:#94a3b8;">Memuat…</div>';
    const j = await api('/api/keuangan/recurring');
    _recurCache = (j && j.success) ? (j.data || []) : [];
    _recurRender(j && j.monthly_total || 0);
  }
  function _recurRender(monthlyTotal){
    const body = document.getElementById('recurBody'); if (!body) return;
    let rows = _recurCache.map(function(r){
      return '<tr style="border-bottom:1px solid #f1f5f9;">' +
        '<td style="padding:9px 8px;">' + (r.active ? '' : '<span style="color:#94a3b8;">⏸ </span>') + escHtml(r.name) +
          '<div style="font-size:11px;color:#94a3b8;">' + escHtml(r.category) + (r.party_name ? ' · ' + escHtml(r.party_name) : '') + '</div></td>' +
        '<td style="padding:9px 8px;text-align:right;font-weight:600;">' + fmtRp(r.amount) + '</td>' +
        '<td style="padding:9px 8px;text-align:center;color:#64748b;">tgl ' + r.day_of_month + '</td>' +
        '<td style="padding:9px 8px;text-align:center;">' + (r.active
          ? '<span style="font-size:11px;font-weight:700;color:#15803d;background:#dcfce7;padding:2px 8px;border-radius:10px;">Aktif</span>'
          : '<span style="font-size:11px;font-weight:700;color:#9ca3af;background:#f3f4f6;padding:2px 8px;border-radius:10px;">Nonaktif</span>') + '</td>' +
        '<td style="padding:9px 8px;text-align:right;white-space:nowrap;">' +
          '<button onclick="finEditRecur(' + r.id + ')" style="border:none;background:#eff4ff;color:#1d4ed8;border-radius:7px;padding:5px 10px;font-size:12px;font-weight:600;cursor:pointer;margin-right:5px;">Edit</button>' +
          '<button onclick="finDelRecur(' + r.id + ')" style="border:none;background:#fef2f2;color:#dc2626;border-radius:7px;padding:5px 10px;font-size:12px;font-weight:600;cursor:pointer;">Hapus</button>' +
