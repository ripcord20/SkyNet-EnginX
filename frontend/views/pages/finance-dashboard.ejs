  window.finEditRecur = function(id){
    const r = _recurCache.find(function(x){ return x.id === id; }) || { name:'', category:'Operasional', amount:'', day_of_month:1, party_name:'', active:true };
    const isNew = !id;
    const form = document.getElementById('recurForm');
