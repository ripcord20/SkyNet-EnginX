  // ─── COLLECTION RATE ───
  function renderCollection(d){
    if (!d) d = {};
    const total_inv     = parseInt(d.total_invoices    || 0);
    const total_billed  = parseFloat(d.total_billed    || 0);
    const paid_count    = parseInt(d.paid_count        || 0);
    const collected     = parseFloat(d.total_collected || 0);
    const unpaid_count  = parseInt(d.unpaid_count      || 0);
    const outstanding   = parseFloat(d.total_outstanding || 0);
    const paid_cust     = parseInt(d.paid_customers    || 0);
    const unpaid_cust   = parseInt(d.unpaid_customers  || 0);
    const rate          = parseFloat(d.collection_rate_amt || d.collection_rate || 0);

    // ── Circular progress ring ──
    const R = 58;
    const C = 2 * Math.PI * R;
    const fillLen = (Math.min(rate, 100) / 100) * C;
    const ring = document.getElementById('crRing');
    if (ring) {
      // Animate dari 0 ke target
      ring.setAttribute('stroke-dasharray', `0 ${C}`);
      // Trigger reflow lalu animate (CSS transition stroke-dasharray tidak jalan
      // di semua browser, jadi pakai requestAnimationFrame fade-in)
      let start = null;
      const dur = 900;
      function step(ts){
        if (!start) start = ts;
        const t = Math.min((ts - start) / dur, 1);
        const eased = 1 - Math.pow(1 - t, 3);  // easeOutCubic
        const cur = fillLen * eased;
        ring.setAttribute('stroke-dasharray', `${cur} ${C - cur}`);
        if (t < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    // ── Center text ──
    document.getElementById('crValue').textContent = rate.toFixed(1);

    // ── Breakdown ──
    document.getElementById('cbPaidCnt').textContent   = fmtNum(paid_count);
    document.getElementById('cbPaidAmt').textContent   = fmtRp(collected);
    document.getElementById('cbPaidCust').textContent  = fmtNum(paid_cust) + ' pelanggan sudah membayar';
    document.getElementById('cbUnpaidCnt').textContent = fmtNum(unpaid_count);
    document.getElementById('cbUnpaidAmt').textContent = fmtRp(outstanding);
    document.getElementById('cbUnpaidCust').textContent = fmtNum(unpaid_cust) + ' pelanggan belum membayar';

    // ── Bar fills (proportional to amount) ──
    const totalAmt = collected + outstanding;
    let paidPct   = totalAmt > 0 ? (collected   / totalAmt) * 100 : 0;
    let unpaidPct = totalAmt > 0 ? (outstanding / totalAmt) * 100 : 0;
    // Minimum visible width supaya bar tetap kelihatan kalau pct sangat kecil
    if (paidPct   > 0 && paidPct   < 4) paidPct   = 4;
    if (unpaidPct > 0 && unpaidPct < 4) unpaidPct = 4;
    // Delay supaya animasi width terlihat
    setTimeout(() => {
      document.getElementById('cbPaidFill').style.width   = paidPct + '%';
      document.getElementById('cbUnpaidFill').style.width = unpaidPct + '%';
    }, 80);

    // ── Footer strip ──
    document.getElementById('crTotalBilled').textContent = fmtRp(total_billed);
    document.getElementById('crTotalInv').textContent    = fmtNum(total_inv);

    // ── DUE-DATE BUCKETS ──
    const dd3Count  = parseInt(d.due_3days_count     || 0);
    const dd3Cust   = parseInt(d.due_3days_customers || 0);
    const dd3Amt    = parseFloat(d.due_3days_amount  || 0);
    const ddTCount  = parseInt(d.due_today_count     || 0);
    const ddTCust   = parseInt(d.due_today_customers || 0);
    const ddTAmt    = parseFloat(d.due_today_amount  || 0);
    const ddPCount  = parseInt(d.past_due_count      || 0);
    const ddPCust   = parseInt(d.past_due_customers  || 0);
    const ddPAmt    = parseFloat(d.past_due_amount   || 0);

    function setDD(prefix, cnt, cust, amt){
      const v = document.getElementById(prefix + 'Count');
      const c = document.getElementById(prefix + 'Cust');
      const a = document.getElementById(prefix + 'Amt');
      if (v) v.textContent = fmtNum(cnt) + (cnt === 1 ? ' invoice' : ' invoice');
      if (c) c.textContent = fmtNum(cust) + ' pelanggan';
      if (a) a.textContent = amt > 0 ? fmtRp(amt) : 'Rp 0';
    }
    setDD('dd3', dd3Count, dd3Cust, dd3Amt);
    setDD('ddT', ddTCount, ddTCust, ddTAmt);
    setDD('ddP', ddPCount, ddPCust, ddPAmt);

    // ── Edge case: tidak ada invoice pada periode ini ──
    // PENTING: jangan menimpa innerHTML .collect-wrap (itu menghapus elemen
    // ring/breakdown permanen, sehingga periode lain yg ada datanya ikut kosong).
    // Cukup tampilkan/sembunyikan placeholder & konten normal secara bergantian.
    const wrapEl  = document.querySelector('.collect-card .collect-wrap');
    const stripEl = document.getElementById('crStrip');
    const emptyEl = document.getElementById('crEmpty');
    if (total_inv === 0) {
      if (wrapEl)  wrapEl.style.display  = 'none';
      if (stripEl) stripEl.style.display = 'none';
      if (emptyEl) emptyEl.style.display = '';
    } else {
      if (wrapEl)  wrapEl.style.display  = '';
      if (stripEl) stripEl.style.display = '';
      if (emptyEl) emptyEl.style.display = 'none';
    }
  }

  // ─── PAYMENT CHANNELS ───
  // Mapping channel "tidak terdaftar" → ikon SVG default
  const CH_ICONS = {
    cash:     `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/></svg>`,
    transfer: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>`,
    qris:     `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h2v2M18 14h3M14 18h3M18 21h3"/></svg>`,
    dana:     `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M7 15a4 4 0 010-6"/><path d="M17 15a4 4 0 000-6"/></svg>`,
    ovo:      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="12" cy="12" r="3"/></svg>`,
    gopay:    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M7 12h10M12 7v10"/></svg>`,
    other:    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>`,
  };
  // Fallback color (server-side METHOD_COLOR map)
  const CH_COLORS = {
    cash:'#16a34a', transfer:'#1d4ed8', qris:'#d97706',
    dana:'#0ea5e9', ovo:'#1d4ed8',     gopay:'#16a34a',
    field_collection:'#0d9488', gateway:'#475569',
    tripay:'#2563eb', midtrans:'#1e3a8a', xendit:'#1d4ed8', duitku:'#0284c7',
    ewallet:'#0891b2', other:'#64748b',
  };

  function renderChannels(methods){
    const wrap = document.getElementById('channelWrap');
    if (!methods || !methods.length) {
      wrap.innerHTML = `
        <div class="empty">
          <div class="ic" style="background:rgba(37,99,235,.10);color:#2563eb;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 12h20"/></svg>
          </div>
          <div class="t">Belum ada pembayaran</div>
          <div>Channel pembayaran akan tampil setelah ada transaksi.</div>
        </div>
      `;
      return;
    }

    // Sort by total desc (sudah di-sort dari server, tapi defensive)
    methods = methods.slice().sort((a,b) => (b.total||0) - (a.total||0));
    const grandTotal = methods.reduce((s,m) => s + parseFloat(m.total||0), 0);
    const grandCount = methods.reduce((s,m) => s + parseInt(m.count||0), 0);

    const CH_LABELS = { cash:'Tunai', transfer:'Transfer', gopay:'GoPay', ovo:'OVO', dana:'DANA', qris:'QRIS', va:'Virtual Account', tripay:'Tripay', midtrans:'Midtrans', xendit:'Xendit', duitku:'Duitku', ewallet:'E-Wallet', other:'Lainnya', field_collection:'Cash Collect', gateway:'Payment Gateway' };
    let html = '<div class="ch-list">';
    methods.forEach(m => {
      const method = String(m.method || 'other').toLowerCase();
      const label  = CH_LABELS[method] || m.label || (method.charAt(0).toUpperCase() + method.slice(1));
      const color  = m.color || CH_COLORS[method] || '#6b7280';
      const total  = parseFloat(m.total || 0);
      const count  = parseInt(m.count || 0);
      const pct    = grandTotal > 0 ? (total / grandTotal) * 100 : 0;
      const icon   = CH_ICONS[method] || CH_ICONS.other;

      html += `
        <div class="ch-row">
          <div class="ch-icon" style="background:${color};">${icon}</div>
          <div class="ch-body">
            <div class="ch-top-row">
              <span class="ch-name">${escHtml(label)}</span>
              <span class="ch-amt">${fmtRp(total)}</span>
            </div>
            <div class="ch-bar">
              <div class="ch-fill" style="width:${Math.max(pct, pct > 0 ? 3 : 0)}%;background:${color};"></div>
            </div>
            <div class="ch-meta">
              <span class="pct">${pct.toFixed(1)}%</span>
              <span>${fmtNum(count)} transaksi</span>
            </div>
          </div>
        </div>
      `;
    });
    html += '</div>';

    // Total strip
    html += `
      <div class="ch-total">
        <span class="ch-total-lbl">Total: <strong style="color:#475569;">${fmtNum(grandCount)}</strong> transaksi via <strong style="color:#475569;">${methods.length}</strong> channel</span>
        <span class="ch-total-val">${fmtRp(grandTotal)}</span>
      </div>
    `;

    wrap.innerHTML = html;
  }

  // ═══════ PEMBAYARAN DITERIMA BULAN INI (per periode) ═══════════
  function renderReceived(data){
    const wrap = document.getElementById('receivedWrap');
    if (!wrap) return;
    const sub = document.getElementById('receivedSub');
    if (!data || !data.breakdown || !data.breakdown.length){
      wrap.innerHTML = `
        <div class="empty">
          <div class="ic" style="background:rgba(37,99,235,.10);color:#2563eb;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 12h20"/></svg>
          </div>
          <div class="t">Belum ada pembayaran diterima</div>
          <div>Pembayaran yang masuk pada periode ini akan dirinci di sini.</div>
        </div>`;
      return;
    }
    if (sub) sub.textContent = 'Berdasarkan tanggal bayar · ' + (data.period || '');

    const rows = data.breakdown.slice().sort((a,b)=>{
      if (b.period_year !== a.period_year) return b.period_year - a.period_year;
      return b.period_month - a.period_month;
    });
    const grand = data.total || 0;

    let html = '<div class="ch-list">';
    rows.forEach(r => {
      const pct = grand > 0 ? (r.amount / grand) * 100 : 0;
      // Posisi periode thd periode terpilih: past (tunggakan), current, future
      // (bayar di muka). Warna: current biru, tunggakan teal, bayar-di-muka ungu.
      const pos = r.position || (r.is_current ? 'current' : 'past');
      // Warna: current biru; tunggakan teal gelap; bayar-di-muka teal terang (cyan).
      // TIDAK memakai ungu/violet (sesuai design system).
      const color = pos === 'current' ? '#2563eb' : (pos === 'future' ? '#0891b2' : '#0d9488');
      const calIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>';
      let tag = '';
      if (pos === 'past') {
        tag = ' <span style="font-size:10px;font-weight:700;color:#0d9488;background:#f0fdfa;padding:1px 6px;border-radius:5px;margin-left:6px;">tunggakan</span>';
      } else if (pos === 'future') {
        tag = ' <span style="font-size:10px;font-weight:700;color:#0891b2;background:#ecfeff;padding:1px 6px;border-radius:5px;margin-left:6px;">bayar di muka</span>';
      }
      html += `
        <div class="ch-row">
          <div class="ch-icon" style="background:${color};">${calIcon}</div>
          <div class="ch-body">
            <div class="ch-top-row">
              <span class="ch-name">${escHtml(r.label)}${tag}</span>
              <span class="ch-amt">${fmtRp(r.amount)}</span>
            </div>
            <div class="ch-bar">
              <div class="ch-fill" style="width:${Math.max(pct, pct > 0 ? 3 : 0)}%;background:${color};"></div>
            </div>
            <div class="ch-meta">
              <span class="pct">${pct.toFixed(1)}%</span>
              <span>${fmtNum(r.count)} transaksi</span>
            </div>
          </div>
        </div>`;
    });
    html += '</div>';

    // Ringkasan: pisahkan tunggakan (periode lalu) & bayar di muka (periode depan).
    const past   = data.from_past_periods   || 0;
    const future = data.from_future_periods || 0;
    const notes = [];
    if (past > 0)   notes.push(`${fmtRp(past)} dari tunggakan periode lalu`);
    if (future > 0) notes.push(`${fmtRp(future)} bayar di muka (periode depan)`);
    const otherTxt = notes.length
      ? `<div style="font-size:11px;color:#64748b;margin-top:2px;padding:0 2px;">Termasuk ${notes.join(' & ')}</div>`
      : '';
    html += `
      <div class="ch-total">
        <span class="ch-total-lbl">Total diterima ${escHtml(data.period||'')}</span>
        <span class="ch-total-val">${fmtRp(grand)}</span>
      </div>${otherTxt}`;

    wrap.innerHTML = html;
  }

  function renderProjection(data){
    const wrap = document.getElementById('projWrap');
    if (!wrap) return;
    if (!data) { wrap.innerHTML = '<div class="empty"><div>Data tidak tersedia</div></div>'; return; }
    const sub = document.getElementById('projSub');
    if (sub) sub.textContent = 'Estimasi total yang akan masuk · ' + (data.period || '');

    const target   = data.target_amount    || 0;
    const paid     = data.paid_amount       || 0;
    const pipeline = data.pipeline_amount   || 0;   // belum lunas, masih dalam tempo
    const risk     = data.overdue_amount    || 0;   // belum lunas, lewat tempo
    const projected= data.projected_amount  || 0;   // paid + pipeline
    const pctPaid  = target > 0 ? (paid / target * 100) : 0;
    const pctPipe  = target > 0 ? (pipeline / target * 100) : 0;

    let html = '';
    // Hero: proyeksi realistis + persentase dari target
    html += `
      <div class="proj-hero">
        <div>
          <div class="proj-hero-val">${fmtRp(projected)}</div>
          <div class="proj-hero-lbl">Proyeksi masuk dari target ${fmtRp(target)}</div>
        </div>
        <span class="proj-hero-pct">${data.pct_projected || 0}% target</span>
      </div>`;
    // Stacked bar: sudah masuk (hijau) + masih dalam tempo (teal transparan)
    html += `
      <div class="proj-bar">
        <div class="proj-bar-paid" style="width:${Math.min(100, pctPaid)}%;"></div>
        <div class="proj-bar-pipe" style="width:${Math.min(100 - Math.min(100,pctPaid), pctPipe)}%;"></div>
      </div>`;
    // Legend rincian
    const legItem = (color, label, amt, cnt) => `
      <div class="proj-leg-item">
        <span class="proj-leg-l"><span class="proj-leg-dot" style="background:${color};"></span>${label}</span>
        <span style="text-align:right;">
          <span class="proj-leg-amt">${fmtRp(amt)}</span>
          <span class="proj-leg-cnt"> · ${fmtNum(cnt)} inv</span>
        </span>
      </div>`;
    html += '<div class="proj-legend">';
    html += legItem('#16a34a', 'Sudah diterima', paid, data.paid_count || 0);
    html += legItem('#0d9488', 'Belum bayar (dalam tempo)', pipeline, data.pipeline_count || 0);
    if (risk > 0) html += legItem('#dc2626', 'Belum bayar (lewat tempo)', risk, data.overdue_count || 0);
    html += '</div>';
    // Footer: sisa yang belum masuk
    const belum = target - paid;
    html += `
      <div class="proj-foot">
        <span class="proj-foot-lbl">Belum masuk (target − diterima)</span>
        <span class="proj-foot-val">${fmtRp(belum)}</span>
      </div>`;

    wrap.innerHTML = html;
  }

  function showToast(type, title, msg, dur){
    const stack = document.getElementById('toastStack');
    if (!stack) return;
    const icons = {
      success: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
      error:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',
      info:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
    };
    const el = document.createElement('div');
    el.className = 'toast ' + (type || 'info');
    el.innerHTML = `
      <div class="toast-icon">${icons[type] || icons.info}</div>
      <div class="toast-body">
        <div class="toast-title">${escHtml(title || '')}</div>
        <div class="toast-msg">${escHtml(msg || '')}</div>
      </div>`;
    stack.appendChild(el);
    requestAnimationFrame(() => el.classList.add('show'));
    setTimeout(() => {
      el.classList.remove('show');
      setTimeout(() => el.remove(), 320);
    }, dur || 4000);
  }

  // ═══════ INSIGHT BANNER ═════════════════════════════════════════
  // Render banner card per insight item. Sembunyikan wrapper kalau kosong.
  const INSIGHT_ICONS = {
    'alert-triangle': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><circle cx="12" cy="17" r=".5"/></svg>',
