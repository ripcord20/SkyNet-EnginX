    'wifi-off':       '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="1" y1="1" x2="23" y2="23"/><path d="M16.72 11.06A10.94 10.94 0 0119 12.55"/><path d="M5 12.55a10.94 10.94 0 015.17-2.39"/><path d="M10.71 5.05A16 16 0 0122.58 9"/><path d="M1.42 9a15.91 15.91 0 014.7-2.88"/><path d="M8.53 16.11a6 6 0 016.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>',
    'check-circle':   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
  };

  function renderInsights(items){
    const wrap = document.getElementById('insWrap');
    if (!items || !items.length) { wrap.style.display = 'none'; return; }
    const html = items.map(it => {
      const icon = INSIGHT_ICONS[it.icon] || INSIGHT_ICONS['check-circle'];
      const hasAction = !!it.action_url;
      const onclick = hasAction ? `onclick="location.href='${escHtml(it.action_url)}'"` : '';
      return `
        <div class="ins-card ${escHtml(it.severity || 'info')}${hasAction ? ' has-action' : ''}" ${onclick}>
          <div class="ins-icon">${icon}</div>
          <div class="ins-body">
            <div class="ins-title">${escHtml(it.title || '')}</div>
            <div class="ins-msg">${escHtml(it.message || '')}</div>
            ${hasAction ? `<span class="ins-action">${escHtml(it.action_label || 'Lihat detail')}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
            </span>` : ''}
          </div>
        </div>
      `;
    }).join('');
    wrap.innerHTML = html;
    wrap.style.display = 'grid';
  }

  // ═══════ ACTIVITY LOG ═══════════════════════════════════════════
  const ACT_ICONS = {
    'send_reminder':       '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.87 9.87 0 0 0 12.04 2z"/></svg>',
