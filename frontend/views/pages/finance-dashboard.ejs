<script>
(function(){
  // ═══════ UTILITIES ═══════════════════════════════════════════
  const fmtRp  = n => 'Rp ' + Number(n||0).toLocaleString('id-ID');
  function fmtRpCompact(n){
    n = Number(n||0); const abs = Math.abs(n);
    if (abs >= 1e9) return 'Rp ' + (n/1e9).toFixed(1).replace('.',',') + ' M';
    if (abs >= 1e6) return 'Rp ' + (n/1e6).toFixed(1).replace('.',',') + ' Jt';
    if (abs >= 1e3) return 'Rp ' + Math.round(n/1e3) + 'rb';
    return 'Rp ' + n.toLocaleString('id-ID');
  }
  const fmtNum = n => Number(n||0).toLocaleString('id-ID');
  function fmtDate(s){
    if(!s) return '–';
    const d = new Date(s); if (isNaN(d)) return '–';
    return d.toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'});
  }
  function escHtml(s){
    return String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function pad2(n){return String(n).padStart(2,'0');}

  // ═══════ PERIODE FILTER (Bulan/Tahun) ═══════════════════════
  // State periode yang dipilih user. Default = bulan & tahun berjalan.
  const finPeriod = { mode: 'month', month: new Date().getMonth() + 1, year: new Date().getFullYear() };
  // Query-string utk endpoint yang mendukung month/year.
  // Mode 'year' → kirim period=year (tanpa month) supaya backend agregasi setahun.
  function finPeriodQS(){
    if (finPeriod.mode === 'year') return '?period=year&year=' + finPeriod.year;
    return '?month=' + finPeriod.month + '&year=' + finPeriod.year;
  }
  // True kalau periode terpilih = bulan & tahun berjalan (mode bulanan).
  // Dipakai utk menentukan boleh-tidaknya fallback ke data payment bulan berjalan.
  function finPeriodIsCurrent(){
    const now = new Date();
    return finPeriod.mode === 'month'
        && finPeriod.year  === now.getFullYear()
        && finPeriod.month === now.getMonth() + 1;
  }
  // Dipanggil dari tombol Bulanan/Tahunan
  window.finSetMode = function(mode){
    finPeriod.mode = mode;
    document.getElementById('pmModeMonth').classList.toggle('active', mode === 'month');
    document.getElementById('pmModeYear').classList.toggle('active', mode === 'year');
    // Bulan disembunyikan di mode tahunan
    const m = document.getElementById('finPeriodMonth');
    if (m) m.style.display = (mode === 'year') ? 'none' : '';
    finReloadPeriod();
  };
  // Dipanggil saat dropdown berubah → muat ulang data yang period-aware
  window.finReloadPeriod = function(){
    const m = document.getElementById('finPeriodMonth');
    const y = document.getElementById('finPeriodYear');
    if (m) finPeriod.month = parseInt(m.value) || finPeriod.month;
    if (y) finPeriod.year  = parseInt(y.value) || finPeriod.year;
    finUpdateSubtitle();
    // Muat ulang ringkasan keuangan + statistik penagihan utk periode terpilih.
    // Pemasukan kartu memakai collection-stats (basis periode), jadi collection
    // HARUS memperbarui state.collectedRevenue lalu render ulang KPI.
    if (typeof loadKeuangan === 'function') loadKeuangan().then(function(){
      try{ renderKPI(); }catch(_){}
      try{ renderBalance(window._finCustStats || null); }catch(_){}
    });
    if (typeof loadCollection === 'function') loadCollection().then(function(d){
      try{
        state.collectedRevenue = d ? parseFloat(d.total_collected || 0) : 0;
        renderKPI();                               // pemasukan kini akurat
        renderBalance(window._finCustStats || null);
        if (d) renderCollection(d);
      }catch(_){}
    });
    if (typeof loadProfitLoss === 'function') loadProfitLoss();
    if (typeof loadCashFlow === 'function') loadCashFlow();
    if (typeof loadTaxReport === 'function') loadTaxReport();
    // Perbarui juga panel Pembayaran Diterima & Proyeksi sesuai periode terpilih.
    if (typeof loadReceived === 'function') loadReceived().then(function(d){ try{ renderReceived(d); }catch(_){} });
    if (typeof loadProjection === 'function') loadProjection().then(function(d){ try{ renderProjection(d); }catch(_){} });
  };
  function finUpdateSubtitle(){
    const M = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    var periodTxt = finPeriod.mode === 'year' ? ('Tahun ' + finPeriod.year) : (M[finPeriod.month - 1] + ' ' + finPeriod.year);
    var shortTxt  = finPeriodIsCurrent() ? 'Bulan Ini' : periodTxt;
    const sub = document.getElementById('finSub');
    if (sub) sub.textContent = 'Menampilkan data periode ' + periodTxt;
    // Label KPI mengikuti periode
    var il = document.getElementById('kIncomeLbl');  if (il) il.textContent = 'Pemasukan ' + shortTxt;
    var el = document.getElementById('kExpenseLbl'); if (el) el.textContent = 'Pengeluaran ' + shortTxt;
    var bl = document.getElementById('balLbl');      if (bl) bl.textContent = 'Net Cash Flow ' + shortTxt;
  }
  // Inisialisasi dropdown periode (isi tahun, set bulan/tahun aktif)
  (function initFinPeriod(){
    const y = document.getElementById('finPeriodYear');
    if (y) {
      const cy = new Date().getFullYear();
      for (let yy = cy + 1; yy >= cy - 5; yy--) {
        const o = document.createElement('option'); o.value = yy; o.textContent = yy;
        if (yy === finPeriod.year) o.selected = true; y.appendChild(o);
      }
    }
    const m = document.getElementById('finPeriodMonth');
    if (m) m.value = String(finPeriod.month);
    finUpdateSubtitle();
  })();

  // ═══════ SENSOR NILAI KEUANGAN (privasi) ════════════════════
  // Daftar ID elemen yang berisi nilai uang/sensitif → ditandai .fin-money.
  const FIN_MONEY_IDS = [
    'kIncome','kExpense','balValue','crValue','crTotalBilled','crTotalInv',
    'cbPaidAmt','cbUnpaidAmt','dtxSumIn','dtxSumOut','dtxSumNet','plNetBadge'
  ];
  // Tandai elemen sensitif (dipanggil saat init & setelah render ulang)
  window.finMarkMoney = function(){
    FIN_MONEY_IDS.forEach(function(id){
      const el = document.getElementById(id);
      if (el) el.classList.add('fin-money');
    });
    // Kartu laba rugi diisi dinamis → tandai tiap nilai Rp di dalamnya
    const pl = document.getElementById('plBody');
    if (pl) pl.querySelectorAll('span').forEach(function(s){
      if (/Rp\s|%/.test(s.textContent || '')) s.classList.add('fin-money');
    });
  };
  // Toggle on/off + simpan preferensi di localStorage
  window.finToggleMask = function(){
    const on = !document.body.classList.contains('finmask');
    _finSetMask(on);
    try { localStorage.setItem('finMask', on ? '1' : '0'); } catch(_){}
  };
  function _finSetMask(on){
    document.body.classList.toggle('finmask', on);
    const btn = document.getElementById('finMaskBtn');
    const lbl = document.getElementById('finMaskLbl');
    const icon = document.getElementById('finMaskIcon');
    if (btn) btn.classList.toggle('on', on);
    if (lbl) lbl.textContent = on ? 'Tampilkan' : 'Sembunyikan';
    if (icon) icon.innerHTML = on
      ? '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
      : '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>';
    if (on) finMarkMoney();   // pastikan elemen baru ikut tertandai
  }
  // Pulihkan preferensi saat halaman dibuka
  (function initFinMask(){
    let saved = '0';
    try { saved = localStorage.getItem('finMask') || '0'; } catch(_){}
    finMarkMoney();
    if (saved === '1') _finSetMask(true);
  })();

  // ═══════ LABA RUGI (Profit & Loss) ══════════════════════════
  async function loadProfitLoss(){
    const j = await api('/api/finance/profit-loss' + finPeriodQS());
    if (!j || !j.success) return;
    renderProfitLoss(j.data);
  }
  function renderProfitLoss(d){
    const body = document.getElementById('plBody'); if (!body) return;
    document.getElementById('plPeriod').textContent = d.period;
    const badge = document.getElementById('plNetBadge');
    if (badge) {
      const pos = d.net_profit >= 0;
      badge.innerHTML = '<span style="font-size:12px;font-weight:700;padding:4px 12px;border-radius:20px;background:' +
        (pos ? '#dcfce7;color:#15803d;' : '#fee2e2;color:#b91c1c;') + '">' +
        (pos ? 'Laba ' : 'Rugi ') + fmtRp(Math.abs(d.net_profit)) + '</span>';
    }
    function ln(label, val, opt){ opt = opt || {};
      return '<div style="display:flex;justify-content:space-between;align-items:center;padding:' + (opt.big?'10px':'7px') + ' 4px;' +
        (opt.top?'border-top:1px solid #eef2f9;':'') + (opt.strong?'font-weight:700;':'') + '">' +
        '<span style="color:' + (opt.muted?'#94a3b8':'#475569') + ';font-size:' + (opt.big?'14px':'13px') + ';">' + label + '</span>' +
        '<span class="fin-money ta-r" style="color:' + (opt.color || '#0f172a') + ';font-weight:' + (opt.strong?'800':'600') + ';font-size:' + (opt.big?'15px':'13px') + ';min-width:90px;text-align:right;display:inline-block;">' + val + '</span></div>';
    }
    body.innerHTML =
      ln('Pendapatan (Revenue)', fmtRp(d.revenue), { strong:true }) +
      ln('Biaya Langsung / COGS', '− ' + fmtRp(d.cogs), { muted:true }) +
      ln('Laba Kotor', fmtRp(d.gross_profit) + '  ·  ' + d.gross_margin + '%', { strong:true, top:true }) +
      ln('Biaya Operasional (Opex)', '− ' + fmtRp(d.opex), { muted:true }) +
      ln('Laba Bersih', fmtRp(d.net_profit) + '  ·  ' + d.net_margin + '%', { strong:true, big:true, top:true, color: d.net_profit >= 0 ? '#15803d' : '#dc2626' });
    if (typeof finMarkMoney === 'function') finMarkMoney();
  }

  // ═══════ ARUS KAS (Cash Flow) ═══════════════════════════════
  async function loadCashFlow(){
    const j = await api('/api/finance/cashflow' + finPeriodQS());
    if (!j || !j.success) return;
    renderCashFlowReport(j.data);
  }
  function renderCashFlowReport(d){
    const body = document.getElementById('cfBody'); if (!body) return;
    document.getElementById('cfPeriod').textContent = 'Periode ' + d.period + ' · basis periode invoice';
    const badge = document.getElementById('cfNetBadge');
    if (badge){
      const pos = d.net_cash >= 0;
      badge.innerHTML = '<span style="font-size:12px;font-weight:700;padding:4px 12px;border-radius:20px;background:' +
        (pos ? '#dcfce7;color:#15803d;' : '#fee2e2;color:#b91c1c;') + '">Net ' + fmtRp(d.net_cash) + '</span>';
    }
    function ln(label, val, opt){ opt = opt || {};
      return '<div style="display:flex;justify-content:space-between;padding:7px 4px;' + (opt.top?'border-top:1px solid #eef2f9;':'') + (opt.strong?'font-weight:700;':'') + '">' +
        '<span style="color:' + (opt.muted?'#94a3b8':'#475569') + ';font-size:13px;">' + label + '</span>' +
        '<span class="fin-money ta-r" style="color:' + (opt.color||'#0f172a') + ';font-weight:' + (opt.strong?'800':'600') + ';font-size:13px;min-width:90px;text-align:right;display:inline-block;">' + val + '</span></div>';
    }
    let methodRows = d.inflow_by_method.map(function(m){
      return ln('&nbsp;&nbsp;• ' + _methodLabel(m.method) + ' (' + m.cnt + '×)', fmtRp(m.amount), { muted:true });
    }).join('');
    let catRows = d.outflow_by_category.slice(0,6).map(function(c){
      return ln('&nbsp;&nbsp;• ' + escHtml(c.category) + ' (' + c.cnt + '×)', fmtRp(c.amount), { muted:true });
    }).join('');
    body.innerHTML =
      ln('Kas Masuk — Pembayaran (' + d.inflow_count + '×)', fmtRp(d.inflow), { strong:true }) +
      methodRows +
      (d.capital > 0 ? ln('Kas Masuk — Modal', fmtRp(d.capital), { strong:true }) : '') +
      ln('Total Kas Masuk', fmtRp(d.total_in), { strong:true, top:true, color:'#15803d' }) +
      ln('Kas Keluar — Pengeluaran (' + d.outflow_count + '×)', fmtRp(d.outflow), { strong:true, top:true }) +
      catRows +
      ln('Arus Kas Bersih', fmtRp(d.net_cash), { strong:true, top:true, color: d.net_cash >= 0 ? '#15803d' : '#dc2626' });
    if (typeof finMarkMoney === 'function') finMarkMoney();
  }
  function _methodLabel(m){
    const map = { cash:'Tunai', transfer:'Transfer', gopay:'GoPay', ovo:'OVO', dana:'DANA', qris:'QRIS', va:'Virtual Account', midtrans:'Midtrans', xendit:'Xendit', field_collection:'Cash Collect', gateway:'Payment Gateway' };
    return map[(m||'').toLowerCase()] || (m ? escHtml(m) : 'Lainnya');
  }

  // ═══════ AGING (Umur Piutang) ═══════════════════════════════
  let _agingData = null;
  async function loadAging(){
    const j = await api('/api/finance/aging');   // aging = posisi saat ini, tdk ikut periode
    if (!j || !j.success) return;
    _agingData = j.data;
    renderAging(j.data);
  }
  function renderAging(d){
    const body = document.getElementById('agBody'); if (!body) return;
    const badge = document.getElementById('agTotalBadge');
    if (badge) badge.innerHTML = '<span class="fin-money" style="font-size:12px;font-weight:700;padding:4px 12px;border-radius:20px;background:#fef3c7;color:#92400e;">Total ' + fmtRp(d.total_outstanding) + '</span>';
    const order = ['not_due','d1_30','d31_60','d60plus'];
    const colors = { not_due:'#64748b', d1_30:'#d97706', d31_60:'#ea580c', d60plus:'#dc2626' };
    let cards = order.map(function(k){
      const b = d.buckets[k];
      return '<div style="flex:1;min-width:120px;background:#f8fafc;border:1px solid #eef2f9;border-radius:11px;padding:12px 14px;">' +
        '<div style="font-size:11.5px;font-weight:700;color:' + colors[k] + ';margin-bottom:4px;">' + b.label + '</div>' +
        '<div class="fin-money" style="font-size:16px;font-weight:800;color:#0f172a;">' + fmtRp(b.amount) + '</div>' +
        '<div style="font-size:11px;color:#94a3b8;margin-top:2px;">' + b.count + ' invoice</div></div>';
    }).join('');
    // Daftar penunggak terparah (60+ dulu, lalu 31-60)
    const worst = [].concat(d.buckets.d60plus.items, d.buckets.d31_60.items).slice(0, 8);
    let list = '';
    if (worst.length){
      list = '<div style="margin-top:14px;"><div style="font-size:12px;font-weight:700;color:#475569;margin-bottom:8px;">Prioritas tagih (tunggakan terlama)</div>' +
        '<table style="width:100%;border-collapse:collapse;font-size:12.5px;"><tbody>' +
        worst.map(function(it){
          return '<tr style="border-bottom:1px solid #f1f5f9;">' +
            '<td style="padding:7px 4px;"><div style="font-weight:600;color:#0f172a;">' + escHtml(it.cust_name) + '</div>' +
              '<div style="font-size:11px;color:#94a3b8;">' + escHtml(it.cid||'') + ' · ' + escHtml(it.invoice_number) + '</div></td>' +
            '<td style="padding:7px 4px;text-align:center;"><span style="font-size:11px;font-weight:700;color:#dc2626;background:#fee2e2;padding:2px 8px;border-radius:10px;">' + it.days_overdue + ' hari</span></td>' +
            '<td class="fin-money ta-r" style="padding:7px 4px;text-align:right;font-weight:700;color:#0f172a;">' + fmtRp(it.total) + '</td></tr>';
        }).join('') + '</tbody></table></div>';
    } else {
      list = '<div style="margin-top:14px;padding:16px;text-align:center;color:#15803d;background:#f0fdf4;border-radius:11px;font-size:13px;">✓ Tidak ada tunggakan jatuh tempo. Semua pelanggan lancar.</div>';
    }
    body.innerHTML = '<div style="display:flex;gap:10px;flex-wrap:wrap;">' + cards + '</div>' + list;
    if (typeof finMarkMoney === 'function') finMarkMoney();
  }

  // ═══════ REKAP PPN (Pajak) ══════════════════════════════════
  async function loadTaxReport(){
    const j = await api('/api/finance/tax-report' + finPeriodQS());
    if (!j || !j.success) return;
    renderTaxReport(j.data);
  }
  function renderTaxReport(d){
    const body = document.getElementById('taxBody'); if (!body) return;
    document.getElementById('taxPeriod').textContent = 'Periode ' + d.period + ' · ' + d.invoice_with_tax + ' dari ' + d.invoice_count + ' invoice kena PPN';
    function ln(label, val, opt){ opt = opt || {};
      return '<div style="display:flex;justify-content:space-between;padding:7px 4px;' + (opt.top?'border-top:1px solid #eef2f9;':'') + '">' +
        '<span style="color:' + (opt.muted?'#94a3b8':'#475569') + ';font-size:13px;' + (opt.strong?'font-weight:700;':'') + '">' + label + '</span>' +
        '<span class="fin-money ta-r" style="color:' + (opt.color||'#0f172a') + ';font-weight:' + (opt.strong?'800':'600') + ';font-size:13px;min-width:90px;text-align:right;display:inline-block;">' + val + '</span></div>';
    }
    let monthlyTbl = '';
    if (d.mode === 'year' && d.monthly && d.monthly.length){
      const M = ['','Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
      monthlyTbl = '<div style="margin-top:12px;"><div style="font-size:12px;font-weight:700;color:#475569;margin-bottom:6px;">Rincian per bulan</div>' +
        '<table style="width:100%;border-collapse:collapse;font-size:12px;"><thead><tr style="color:#94a3b8;font-size:10.5px;text-transform:uppercase;">' +
        '<th style="text-align:left;padding:5px 4px;">Bulan</th><th style="text-align:right;padding:5px 4px;">DPP</th><th style="text-align:right;padding:5px 4px;">PPN</th></tr></thead><tbody>' +
        d.monthly.map(function(m){ return '<tr style="border-bottom:1px solid #f5f7fa;"><td style="padding:5px 4px;">' + M[m.month] + '</td>' +
          '<td class="fin-money ta-r" style="padding:5px 4px;text-align:right;">' + fmtRp(m.dpp) + '</td>' +
          '<td class="fin-money ta-r" style="padding:5px 4px;text-align:right;font-weight:600;">' + fmtRp(m.ppn) + '</td></tr>'; }).join('') +
        '</tbody></table></div>';
    }
    body.innerHTML =
      ln('DPP (Dasar Pengenaan Pajak)', fmtRp(d.dpp_total), { strong:true }) +
      ln('PPN Keluaran (total)', fmtRp(d.ppn_total), { strong:true, color:'#1d4ed8' }) +
      ln('&nbsp;&nbsp;• PPN sudah tertagih (lunas)', fmtRp(d.ppn_paid), { muted:true, top:true }) +
      ln('&nbsp;&nbsp;• PPN belum tertagih', fmtRp(d.ppn_unpaid), { muted:true }) +
      ln('Total Tagihan (DPP + PPN)', fmtRp(d.grand_total), { strong:true, top:true }) +
      // ── PPN yang harus disetor ──
      '<div style="margin-top:12px;padding:14px 16px;background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:12px;">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;">' +
          '<div><div style="font-size:13px;font-weight:800;color:#1e3a8a;">PPN Harus Disetor</div>' +
          '<div style="font-size:11px;color:#64748b;margin-top:2px;">PPN Keluaran − PPN Masukan (' + fmtRp(d.ppn_input || 0) + ')</div></div>' +
          '<div class="fin-money" style="font-size:20px;font-weight:800;color:#1d4ed8;">' + fmtRp(d.ppn_payable_accrual) + '</div>' +
        '</div>' +
        '<div style="display:flex;justify-content:space-between;margin-top:10px;padding-top:10px;border-top:1px dashed #bfdbfe;font-size:12px;">' +
          '<span style="color:#64748b;">Basis kas (hanya yang sudah dibayar)</span>' +
          '<span class="fin-money" style="font-weight:700;color:#0f172a;">' + fmtRp(d.ppn_payable_cash) + '</span>' +
        '</div>' +
      '</div>' +
      monthlyTbl +
      '<div style="margin-top:10px;font-size:11px;color:#94a3b8;line-height:1.5;">Catatan: PPN keluaran dihitung dari invoice terbit pada periode. PPN Masukan (dari pembelian) belum dicatat sehingga dianggap nol. Untuk SPT, pilih basis akrual atau kas sesuai kebijakan akuntansi Anda — bila ada PPN Masukan yang dapat dikreditkan, kurangi secara manual.</div>';
    if (typeof finMarkMoney === 'function') finMarkMoney();

    // Render rekap PNBP (BHP + USO) dari blok pnbp pada response yang sama.
    renderPnbpReport(d.pnbp, d.period);
  }

  function renderPnbpReport(p, period){
    const body = document.getElementById('pnbpBody'); if (!body) return;
    const pe = document.getElementById('pnbpPeriod');
    if (!p) {
      if (pe) pe.textContent = 'Belum ada data pemasukan pada periode ini';
      body.innerHTML = '<div style="padding:20px;text-align:center;color:#94a3b8;">Belum ada pemasukan tercatat di modul Keuangan untuk periode ini.</div>';
      return;
    }
    const r = p.rates || {};
    const pctTxt = function(n){ return (parseFloat(n)||0).toFixed(2).replace(/\.?0+$/,'').replace('.',',') + '%'; };
    const isOn = !!(p.enabled || r.enabled);
    if (pe) pe.innerHTML = 'Periode ' + (period||'') + ' · dasar dari pendapatan periode ini (basis tagihan) '
      + '<span style="display:inline-block;margin-left:6px;font-size:10px;font-weight:700;padding:1px 8px;border-radius:9px;background:' + (isOn?'#dcfce7':'#f1f5f9') + ';color:' + (isOn?'#15803d':'#94a3b8') + ';">' + (isOn?'AKTIF':'NONAKTIF') + '</span>';

    function ln(label, val, opt){ opt = opt || {};
      return '<div style="display:flex;justify-content:space-between;padding:7px 4px;' + (opt.top?'border-top:1px solid #eef2f9;':'') + '">' +
        '<span style="color:' + (opt.muted?'#94a3b8':'#475569') + ';font-size:13px;' + (opt.strong?'font-weight:700;':'') + '">' + label + '</span>' +
        '<span class="fin-money ta-r" style="color:' + (opt.color||'#0f172a') + ';font-weight:' + (opt.strong?'800':'600') + ';font-size:13px;min-width:90px;text-align:right;display:inline-block;">' + val + '</span></div>';
    }

    const baseNote = (parseFloat(r.telco_ratio)>=100)
      ? 'Dasar = 100% pendapatan kotor'
      : 'Dasar = ' + pctTxt(r.telco_ratio) + ' dari pendapatan kotor';

    body.innerHTML =
      ln('Pendapatan Kotor (dasar)', fmtRp(p.base), { strong:true }) +
      ln('BHP Telekomunikasi (' + pctTxt(r.bhp_percent) + ')', fmtRp(p.bhp), { color:'#1d4ed8', top:true }) +
      ln('Kontribusi KPU/USO (' + pctTxt(r.uso_percent) + ')', fmtRp(p.uso), { color:'#0e7490' }) +
      '<div style="margin-top:12px;padding:14px 16px;background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:12px;display:flex;justify-content:space-between;align-items:center;">' +
        '<div><div style="font-size:13px;font-weight:800;color:#1e3a8a;">Total PNBP</div>' +
        '<div style="font-size:11px;color:#64748b;margin-top:2px;">BHP ' + pctTxt(r.bhp_percent) + ' + USO ' + pctTxt(r.uso_percent) + ' = ' + pctTxt((parseFloat(r.bhp_percent||0)+parseFloat(r.uso_percent||0))) + '</div></div>' +
        '<div class="fin-money" style="font-size:20px;font-weight:800;color:#1d4ed8;">' + fmtRp(p.grand_total) + '</div>' +
      '</div>' +
      '<div style="margin-top:10px;font-size:11px;color:#94a3b8;line-height:1.5;">' + baseNote + '. PNBP wajib disetor ke negara: BHP Telekomunikasi (0,5%) + Kontribusi KPU/USO (1,25%) dari pendapatan kotor penyelenggaraan telekomunikasi. Persentase dapat diatur lewat tombol "Atur Persentase" (tersinkron dengan halaman Keuangan).</div>';
    if (typeof finMarkMoney === 'function') finMarkMoney();
  }

  // ═══════ PENGATURAN PNBP (BHP & USO) — sinkron dgn /keuangan ══════
  // Memakai endpoint yang sama (/api/keuangan/pnbp-settings) sehingga nilai
  // yang disimpan di sini otomatis berlaku di halaman Keuangan, dan sebaliknya.
  window.openPnbpSettings = async function(){
    const ov = document.getElementById('pnbpOverlay'); if (!ov) return;
    // Muat nilai terkini
    try {
      const r = await api('/api/keuangan/pnbp-settings');
      const d = (r && r.success) ? r.data : { bhp_percent:0.5, uso_percent:1.25, telco_ratio:100, enabled:false };
      document.getElementById('pnbpInBhp').value   = d.bhp_percent;
      document.getElementById('pnbpInUso').value   = d.uso_percent;
      document.getElementById('pnbpInRatio').value = d.telco_ratio;
      document.getElementById('pnbpInEnabled').checked = !!d.enabled;
      pnbpToggleVisual();
    } catch(_) {
      document.getElementById('pnbpInBhp').value   = 0.5;
      document.getElementById('pnbpInUso').value   = 1.25;
      document.getElementById('pnbpInRatio').value = 100;
      document.getElementById('pnbpInEnabled').checked = false;
      pnbpToggleVisual();
    }
    ov.classList.add('show');
  };

  window.pnbpToggleVisual = function(){
    const on = document.getElementById('pnbpInEnabled') && document.getElementById('pnbpInEnabled').checked;
    const track = document.getElementById('pnbpToggleTrack');
    const knob  = document.getElementById('pnbpToggleKnob');
    if (track) track.style.background = on ? '#1d4ed8' : '#cbd5e1';
    if (knob)  knob.style.transform   = on ? 'translateX(20px)' : 'translateX(0)';
  };

  window.closePnbpSettings = function(ev){
    if (ev && ev.target && ev.target.id !== 'pnbpOverlay' && ev.type === 'click') {
      // hanya tutup bila klik overlay / tombol batal
    }
    const ov = document.getElementById('pnbpOverlay'); if (ov) ov.classList.remove('show');
  };

  window.savePnbpSettings = async function(){
    const btn = document.getElementById('pnbpSaveBtn');
    const bhp   = parseFloat(document.getElementById('pnbpInBhp').value);
    const uso   = parseFloat(document.getElementById('pnbpInUso').value);
    const ratio = parseFloat(document.getElementById('pnbpInRatio').value);
    const enabled = !!(document.getElementById('pnbpInEnabled') && document.getElementById('pnbpInEnabled').checked);
    if (!Number.isFinite(bhp) || bhp < 0 || !Number.isFinite(uso) || uso < 0) {
      showToast('error', 'Nilai tidak valid', 'Persentase BHP & USO harus angka ≥ 0.');
      return;
    }
    const orig = btn.innerHTML;
    btn.disabled = true; btn.style.opacity = '.6'; btn.textContent = 'Menyimpan…';
    try {
      const r = await fetch('/api/keuangan/pnbp-settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          bhp_percent: bhp, uso_percent: uso, telco_ratio: ratio, enabled: enabled,
          month: finPeriod.month, year: finPeriod.year
        })
      });
      const j = await r.json();
      if (r.ok && j && j.success) {
        showToast('success', 'Pengaturan tersimpan', (j && j.message) || 'Persentase PNBP diperbarui.');
        closePnbpSettings();
        // PNBP aktif/nonaktif mempengaruhi pengeluaran → refresh laba rugi,
        // arus kas, ringkasan keuangan, dan rekap PNBP sekaligus.
        if (typeof finReloadPeriod === 'function') finReloadPeriod();
        else if (typeof loadTaxReport === 'function') loadTaxReport();
      } else {
        showToast('error', 'Gagal menyimpan', (j && j.message) || 'Coba lagi.');
      }
    } catch(e) {
      showToast('error', 'Gagal menyimpan', e.message || 'Jaringan bermasalah.');
    } finally {
      btn.disabled = false; btn.style.opacity = '1'; btn.innerHTML = orig;
    }
  };

  // ═══════ EXPORT LAPORAN (PDF / Excel) ════════════════════════
  window.finExport = function(fmt){
