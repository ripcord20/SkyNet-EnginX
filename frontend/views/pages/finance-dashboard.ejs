  // ─── Render pagination buttons ───
  // Pattern: « ‹ [1] 2 3 … 10 › »
  // - Selalu tampilkan tombol prev/next (« ‹ › »)
  // - Halaman 1 & terakhir selalu tampil
  // - Sekitar current page ±1 selalu tampil
  // - Pakai ellipsis (...) untuk yang lompat
  // - Kalau total halaman ≤ 7, tampilkan semua tanpa ellipsis
  function renderPagination(totalPages){
    const pager = document.getElementById('clPager');
    if (!pager) return;
    if (totalPages <= 1) { pager.innerHTML = ''; return; }

    const cur = _currentPage;
    const parts = [];

    // « Prev all
    parts.push(`<button class="cl-pager-btn icon" data-page="1" ${cur===1?'disabled':''} title="Halaman pertama" aria-label="Halaman pertama">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
    </button>`);
    // ‹ Prev
    parts.push(`<button class="cl-pager-btn icon" data-page="${cur-1}" ${cur===1?'disabled':''} title="Sebelumnya" aria-label="Sebelumnya">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>`);

    // Number buttons
    const pages = _computePageNumbers(cur, totalPages);
    pages.forEach(p => {
      if (p === '…') {
        parts.push('<span class="cl-pager-ellipsis">…</span>');
      } else {
        parts.push(`<button class="cl-pager-btn ${p===cur?'active':''}" data-page="${p}" aria-current="${p===cur?'page':'false'}">${p}</button>`);
      }
    });

    // › Next
    parts.push(`<button class="cl-pager-btn icon" data-page="${cur+1}" ${cur===totalPages?'disabled':''} title="Selanjutnya" aria-label="Selanjutnya">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>`);
    // » Next all
    parts.push(`<button class="cl-pager-btn icon" data-page="${totalPages}" ${cur===totalPages?'disabled':''} title="Halaman terakhir" aria-label="Halaman terakhir">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
    </button>`);

    pager.innerHTML = parts.join('');

    // Wire click handlers
    pager.querySelectorAll('.cl-pager-btn[data-page]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        const p = parseInt(btn.getAttribute('data-page'));
        if (Number.isFinite(p) && p !== _currentPage) {
          _currentPage = p;
          if (_dueListsCache) renderCustomerList(_currentBucket, _dueListsCache);
          // Scroll ke top section list (UX: setelah klik halaman, tidak perlu user scroll manual)
          const cardEl = document.querySelector('.cl-card');
          if (cardEl) cardEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  // Compute page numbers untuk pager dengan ellipsis
  // Hasil: array of number atau '…'
  // Contoh untuk current=5, total=20: [1, '…', 4, 5, 6, '…', 20]
  // Contoh untuk current=1, total=5:  [1, 2, 3, 4, 5]
  function _computePageNumbers(current, total){
    if (total <= 7) {
      // Tidak perlu ellipsis — return semua
      const arr = [];
      for (let i = 1; i <= total; i++) arr.push(i);
      return arr;
    }
    const pages = new Set();
    // Selalu: page 1, last, current, current±1
    pages.add(1); pages.add(total);
    pages.add(current);
    if (current > 1) pages.add(current - 1);
    if (current < total) pages.add(current + 1);
    // Kalau current dekat awal/akhir, perluas window
    if (current <= 3) { pages.add(2); pages.add(3); pages.add(4); }
    if (current >= total - 2) { pages.add(total - 3); pages.add(total - 2); pages.add(total - 1); }

    const sorted = Array.from(pages).filter(p => p >= 1 && p <= total).sort((a,b)=>a-b);
    const out = [];
    for (let i = 0; i < sorted.length; i++) {
      if (i > 0 && sorted[i] - sorted[i-1] > 1) out.push('…');
      out.push(sorted[i]);
    }
    return out;
  }

  // ─── Bind row-level action handlers ───
  function bindRowActions(body){
    // WA send
    body.querySelectorAll('.cl-wa-btn[data-inv]').forEach(btn => {
      btn.addEventListener('click', () => sendWAReminder(btn));
    });
    // Checkbox
    body.querySelectorAll('.cl-check').forEach(cb => {
      cb.addEventListener('change', () => {
        const id  = parseInt(cb.getAttribute('data-inv'));
        const row = cb.closest('.cl-row');
        if (cb.checked) {
          _selectedInv.add(id);
          row.classList.add('selected');
        } else {
          _selectedInv.delete(id);
          row.classList.remove('selected');
        }
        updateBulkBar();
      });
    });
    // Overflow popover toggle
    body.querySelectorAll('.cl-more').forEach(btn => {
      btn.addEventListener('click', (ev) => {
        ev.stopPropagation();
        const pop = btn.parentElement.querySelector('.cl-popover');
        // Close other popovers first
        body.querySelectorAll('.cl-popover.show').forEach(p => { if (p !== pop) p.classList.remove('show'); });
        pop.classList.toggle('show');
      });
    });
    // Popover items
    body.querySelectorAll('.cl-popover-item').forEach(item => {
      item.addEventListener('click', (ev) => {
        ev.stopPropagation();
        const act = item.getAttribute('data-act');
        // close popover
        item.closest('.cl-popover').classList.remove('show');
        if (act === 'mark-paid') {
          openMP({
            id:        parseInt(item.getAttribute('data-inv')),
            name:      item.getAttribute('data-name'),
            invoiceNo: item.getAttribute('data-inv-no'),
            amount:    parseFloat(item.getAttribute('data-amt') || 0),
          });
        } else if (act === 'copy-phone') {
          copyToClipboard(item.getAttribute('data-phone'));
        } else if (act === 'open-wa') {
          openWAManual(item.getAttribute('data-phone'));
        }
      });
    });
  }

  // Close popovers on outside click
  document.addEventListener('click', () => {
    document.querySelectorAll('.cl-popover.show').forEach(p => p.classList.remove('show'));
  });

  // ─── Bulk action bar ───
  function updateBulkBar(){
    const bar = document.getElementById('bulkBar');
    const cntEl = document.getElementById('bulkBarCnt');
    const sendCntEl = document.getElementById('bulkSendCnt');
    const n = _selectedInv.size;
    if (n === 0) { bar.style.display = 'none'; return; }
    cntEl.textContent = n;
    sendCntEl.textContent = n;
    bar.style.display = 'flex';
  }
  document.getElementById('bulkClearBtn')?.addEventListener('click', () => {
    _selectedInv.clear();
    if (_dueListsCache) renderCustomerList(_currentBucket, _dueListsCache);
  });
  document.getElementById('bulkSendBtn')?.addEventListener('click', () => {
    if (_selectedInv.size === 0) return;
    runBulkReminder(Array.from(_selectedInv));
  });

  // ─── Copy phone & open WA helpers ───
  async function copyToClipboard(text){
    if (!text) return;
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        // Fallback: textarea hack
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      showToast('success', 'Tersalin', text);
    } catch (e) {
      showToast('error', 'Gagal menyalin', e.message || 'Coba salin manual.');
    }
  }
  function openWAManual(phone){
    if (!phone) return;
    // Bersihkan format → digit saja, prefix 62
    let p = String(phone).replace(/\D/g, '');
    if (p.startsWith('0')) p = '62' + p.slice(1);
