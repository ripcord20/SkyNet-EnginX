    if (!_recurCache.length) rows = '<tr><td colspan="5" style="padding:24px;text-align:center;color:#94a3b8;">Belum ada pengeluaran berulang. Tambahkan mis. sewa kantor, gaji, bandwidth upstream.</td></tr>';
    body.innerHTML =
