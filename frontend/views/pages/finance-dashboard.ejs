        _fld('Jumlah (Rp)', '<input id="rcAmt" type="number" value="' + (r.amount || '') + '" placeholder="0" style="' + _inpCss() + '">') +
        _fld('Tanggal tiap bulan (1-28)', '<input id="rcDom" type="number" min="1" max="28" value="' + (r.day_of_month || 1) + '" style="' + _inpCss() + '">') +
        _fld('Penerima (opsional)', '<input id="rcParty" value="' + escHtml(r.party_name || '') + '" placeholder="vendor / karyawan" style="' + _inpCss() + '">') +
        _fld('Status', '<select id="rcActive" style="' + _inpCss() + '"><option value="1"' + (r.active ? ' selected' : '') + '>Aktif</option><option value="0"' + (!r.active ? ' selected' : '') + '>Nonaktif</option></select>') +
      '</div>' +
      '<div style="display:flex;gap:8px;justify-content:flex-end;">' +
        '<button onclick="document.getElementById(\'recurForm\').style.display=\'none\'" style="border:1.5px solid #dbe3ef;background:#fff;color:#475569;border-radius:9px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;">Batal</button>' +
        '<button onclick="finSaveRecur()" style="border:none;background:#1d4ed8;color:#fff;border-radius:9px;padding:8px 18px;font-size:13px;font-weight:600;cursor:pointer;">Simpan</button>' +
      '</div>';
