    const r = await fetch('/api/keuangan/recurring/generate', { method:'POST', credentials:'same-origin' });
    const j = await r.json().catch(function(){ return {}; });
    alert((j && j.message) || 'Selesai');
    if (j && j.success) { await _recurReload(); finReloadPeriod(); }
  };
