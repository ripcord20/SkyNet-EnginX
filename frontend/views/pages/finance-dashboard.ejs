  function _fld(label, inp){ return '<div><label style="display:block;font-size:11.5px;font-weight:600;color:#64748b;margin-bottom:4px;">' + label + '</label>' + inp + '</div>'; }
  function _inpCss(){ return 'width:100%;padding:8px 10px;border:1.5px solid #dbe3ef;border-radius:8px;font-size:13px;outline:none;box-sizing:border-box;'; }
  window.finSaveRecur = async function(){
    const id = document.getElementById('rcId').value;
    const payload = {
      name: document.getElementById('rcName').value.trim(),
      category: document.getElementById('rcCat').value.trim() || 'Operasional',
      amount: parseFloat(document.getElementById('rcAmt').value) || 0,
      day_of_month: parseInt(document.getElementById('rcDom').value) || 1,
      party_name: document.getElementById('rcParty').value.trim(),
      active: document.getElementById('rcActive').value === '1'
    };
    if (!payload.name || !payload.amount) { alert('Nama & jumlah wajib diisi'); return; }
    const url = id ? '/api/keuangan/recurring/' + id : '/api/keuangan/recurring';
    const method = id ? 'PUT' : 'POST';
    const r = await fetch(url, { method, credentials:'same-origin', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json().catch(function(){ return {}; });
    if (j && j.success) { document.getElementById('recurForm').style.display = 'none'; await _recurReload(); }
    else alert((j && j.message) || 'Gagal menyimpan');
  };
  window.finDelRecur = async function(id){
    if (!confirm('Hapus pengeluaran berulang ini?')) return;
    const r = await fetch('/api/keuangan/recurring/' + id, { method:'DELETE', credentials:'same-origin' });
    const j = await r.json().catch(function(){ return {}; });
    if (j && j.success) await _recurReload(); else alert((j && j.message) || 'Gagal');
  };
  window.finGenerateRecur = async function(){
