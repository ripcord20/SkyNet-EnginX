<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    :root{
      --et-bg:#eef2f9;--et-card:#fff;--et-border:#e0e7f3;
      --et-text:#0d1b3e;--et-muted:#6b7fa8;--et-blue:#1f8bff;--et-blue-deep:#1565e0;
      --tg:#229ED9;--tg-deep:#1a7fb0;
    }
    body{background:var(--et-bg);font-family:'DM Sans',sans-serif;}
    .et-page{padding:0;max-width:none;margin:0;}
    .et-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:12px;}
    .et-title{font-size:22px;font-weight:800;color:var(--et-text);letter-spacing:-.01em;display:flex;align-items:center;gap:10px;}
    .et-title .tg-logo{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,#2AABEE,#229ED9);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .et-sub{font-size:13px;color:var(--et-muted);margin-top:3px;}
    .et-actions{display:flex;gap:10px;flex-wrap:wrap;}
    .et-btn{padding:9px 16px;border-radius:10px;font-size:13px;font-weight:700;border:none;cursor:pointer;
      display:inline-flex;align-items:center;gap:7px;font-family:inherit;transition:all .15s;}
    .et-btn-primary{background:linear-gradient(135deg,#1f8bff,#1565e0);color:#fff;box-shadow:0 4px 10px -2px rgba(31,122,255,.4);}
    .et-btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 14px -2px rgba(31,122,255,.5);}
    .et-btn-primary:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
    .et-btn-ghost{background:#fff;color:var(--et-text);border:1.5px solid var(--et-border);}
    .et-btn-ghost:hover{border-color:var(--et-blue);color:var(--et-blue);}
    .et-btn-tg{background:linear-gradient(135deg,#2AABEE,#229ED9);color:#fff;box-shadow:0 4px 10px -2px rgba(34,158,217,.4);}
    .et-btn-tg:hover{transform:translateY(-1px);}

    /* Stat strip */
    .rm-strip{display:grid;grid-template-columns:repeat(5,1fr);background:#fff;border-radius:16px;
      border:1px solid var(--et-border);overflow:hidden;margin-bottom:18px;}
    .rm-sc{padding:16px 18px 14px;border-right:1px solid var(--et-border);position:relative;overflow:hidden;}
    .rm-sc:last-child{border-right:none;}
    .rm-sc-lbl{font-size:11.5px;font-weight:600;color:var(--et-muted);margin-bottom:9px;letter-spacing:.1px;white-space:nowrap;}
    .rm-sc-body{display:flex;align-items:flex-end;justify-content:space-between;gap:8px;}
    .rm-sc-val{font-size:26px;font-weight:800;color:#0f172a;letter-spacing:-1px;line-height:1;}
    .rm-sc-meta{display:flex;align-items:center;gap:5px;margin-top:7px;flex-wrap:wrap;}
    .rm-sc-pill{display:inline-flex;align-items:center;padding:1px 7px;border-radius:100px;font-size:10.5px;font-weight:700;white-space:nowrap;}
    .rm-sc-sub{font-size:11px;color:#94a3b8;}
    .pill-blue{background:#dbeafe;color:#1d4ed8;}.pill-teal{background:#cffafe;color:#0e7490;}
    .pill-amber{background:#fef3c7;color:#b45309;}.pill-green{background:#dcfce7;color:#16a34a;}
    .pill-grey{background:#f1f3f7;color:#64748b;}
    .rm-status-dot{width:9px;height:9px;border-radius:50%;display:inline-block;flex-shrink:0;}
    @media(max-width:1100px){.rm-strip{grid-template-columns:repeat(3,1fr);}
      .rm-sc{border-bottom:1px solid var(--et-border);}
      .rm-sc:nth-child(3n){border-right:none;}}
    @media(max-width:760px){.rm-strip{grid-template-columns:repeat(2,1fr);}
      .rm-sc{border-bottom:1px solid var(--et-border);}
      .rm-sc:nth-child(odd){border-right:1px solid var(--et-border);}.rm-sc:nth-child(even){border-right:none;}
      .rm-sc:nth-child(3n){border-right:1px solid var(--et-border);}
      .rm-sc:nth-last-child(-n+2){border-bottom:none;}}

    /* Connection panel */
    .tg-conn{background:#fff;border:1px solid var(--et-border);border-radius:16px;overflow:hidden;margin-bottom:18px;}
    .tg-conn-top{display:flex;align-items:center;gap:14px;padding:16px 18px;border-bottom:1px solid var(--et-border);
      background:linear-gradient(120deg,#f4fbff,#eef6ff);}
    .tg-conn-ic{width:46px;height:46px;border-radius:13px;background:linear-gradient(135deg,#2AABEE,#229ED9);
      display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 6px 14px -4px rgba(34,158,217,.5);}
    .tg-conn-meta{flex:1;min-width:0;}
    .tg-conn-name{font-size:15px;font-weight:800;color:var(--et-text);}
    .tg-conn-status{font-size:12px;color:var(--et-muted);margin-top:2px;display:flex;align-items:center;gap:6px;}
    .tg-master{margin-left:auto;}
    .tg-conn-body{padding:16px 18px;}
    .tg-grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    @media(max-width:680px){.tg-grid2{grid-template-columns:1fr;}}

    .et-field{margin-bottom:0;}
    .et-label{display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700;
      color:#33415c;margin-bottom:7px;}
    .et-inp,.et-sel{width:100%;border:1.5px solid var(--et-border);border-radius:11px;padding:10px 13px;
      font-family:inherit;font-size:13.5px;color:var(--et-text);background:#f9fbfe;outline:none;transition:all .15s;box-sizing:border-box;}
    .et-inp:focus,.et-sel:focus{border-color:var(--et-blue);background:#fff;box-shadow:0 0 0 3.5px rgba(31,139,255,.1);}
    .et-hint{font-size:11px;color:var(--et-muted);margin-top:6px;line-height:1.5;}
    .et-hint code{background:#eef2f9;padding:1px 5px;border-radius:4px;font-family:'DM Mono',monospace;font-size:11px;}

    /* Notif toggles + interval */
    .tg-sub-h{font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--et-muted);
      margin:20px 0 10px;display:flex;align-items:center;gap:8px;}
    .tg-notif-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    @media(max-width:680px){.tg-notif-grid{grid-template-columns:1fr;}}
    .tg-notif{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1.5px solid var(--et-border);
      border-radius:12px;cursor:pointer;transition:all .14s;background:#fcfdff;}
    .tg-notif:hover{border-color:#bcd6f5;}
    .tg-notif.on{border-color:var(--et-blue);background:#f4f9ff;}
    .tg-notif-ic{width:38px;height:38px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;}
    .tg-notif-tx{flex:1;min-width:0;}
    .tg-notif-t{font-size:13px;font-weight:700;color:var(--et-text);}
    .tg-notif-d{font-size:11px;color:var(--et-muted);margin-top:2px;line-height:1.4;}
    .tg-notif-d code{font-family:'DM Mono',monospace;background:#eef2f9;padding:0 4px;border-radius:4px;font-size:10.5px;color:#1a4d6e;}

    /* Toggle switch */
    .et-switch{position:relative;display:inline-flex;align-items:center;cursor:pointer;flex-shrink:0;}
    .et-switch input{display:none;}
    .et-track{width:42px;height:24px;border-radius:13px;background:#cfd8e8;transition:all .18s;position:relative;flex-shrink:0;}
    .et-track::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;
      transition:all .18s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
    .et-switch input:checked + .et-track{background:linear-gradient(135deg,#22c55e,#16a34a);}
    .et-switch input:checked + .et-track::after{left:20px;}
    .et-switch.sw-blue input:checked + .et-track{background:linear-gradient(135deg,#2AABEE,#229ED9);}

    /* Layout: template list | editor | preview */
    .et-grid{display:grid;grid-template-columns:290px 1fr 1fr;gap:18px;align-items:start;}
    @media (max-width:1280px){.et-grid{grid-template-columns:250px 1fr;}.et-preview-col{grid-column:1 / -1;}}
    @media (max-width:860px){.et-grid{grid-template-columns:1fr;}}

    .et-card{background:var(--et-card);border:1px solid var(--et-border);border-radius:16px;overflow:hidden;}
    .et-card-h{padding:13px 16px;border-bottom:1px solid var(--et-border);font-size:12px;font-weight:800;
      letter-spacing:.04em;text-transform:uppercase;color:var(--et-muted);display:flex;align-items:center;gap:8px;}
    .et-card-h .cnt{margin-left:auto;font-size:11px;font-weight:700;color:var(--et-blue-deep);background:#eef5ff;
      padding:2px 8px;border-radius:20px;letter-spacing:0;}

    /* Template list (left) */
    .et-list{display:flex;flex-direction:column;padding:8px;}
    .rm-grp-lbl{font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
      padding:11px 10px 5px;display:flex;align-items:center;gap:7px;color:var(--et-muted);}
    .rm-grp-lbl .dot{width:7px;height:7px;border-radius:50%;}
    .et-item{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:12px;cursor:pointer;
      border:1.5px solid transparent;transition:all .14s;text-align:left;background:none;font-family:inherit;width:100%;}
    .et-item:hover{background:#f4f8ff;}
    .et-item.active{background:#eef5ff;border-color:var(--et-blue);}
    .et-item-ic{width:40px;height:38px;border-radius:11px;flex-shrink:0;display:flex;align-items:center;justify-content:center;}
    .et-item-b{flex:1;min-width:0;}
    .et-item-t{font-size:13px;font-weight:700;color:var(--et-text);line-height:1.25;display:block;}
    .et-item-d{font-size:11px;color:var(--et-muted);margin-top:3px;line-height:1.35;display:block;
      white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .et-pill{display:inline-block;font-size:9.5px;font-weight:800;padding:2px 7px;border-radius:6px;margin-top:5px;letter-spacing:.03em;}
    .et-pill.custom{background:#e0f2fe;color:#0369a1;}
    .et-pill.default{background:#f1f3f7;color:#8a95ad;}

    /* Editor (middle) */
    .et-editor{padding:16px;}
    .et-ta{width:100%;border:1.5px solid var(--et-border);border-radius:11px;padding:12px 13px;
      font-family:'DM Mono',monospace;font-size:13px;color:var(--et-text);background:#f9fbfe;outline:none;
      transition:all .15s;line-height:1.6;resize:vertical;min-height:150px;box-sizing:border-box;}
    .et-ta:focus{border-color:var(--et-blue);background:#fff;box-shadow:0 0 0 3.5px rgba(31,139,255,.1);}
    .tg-ph-row{display:flex;flex-wrap:wrap;gap:7px;margin:6px 0 14px;}
    .tg-ph{font-family:'DM Mono',monospace;font-size:11.5px;font-weight:600;padding:4px 9px;border-radius:7px;
      background:#eef5ff;color:var(--et-blue-deep);border:1px solid #d9e6fb;cursor:pointer;transition:all .12s;user-select:none;}
    .tg-ph:hover{background:var(--et-blue);color:#fff;border-color:var(--et-blue);}
    .tg-tag-row{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px;}
    .tg-tag{font-family:'DM Mono',monospace;font-size:11px;padding:3px 8px;border-radius:6px;background:#fff7ed;
      color:#c2620c;border:1px solid #fde3c4;cursor:pointer;}
    .tg-tag:hover{background:#fde3c4;}
    .et-editor-foot{display:flex;align-items:center;gap:10px;margin-top:14px;flex-wrap:wrap;}
    .et-link-btn{background:none;border:none;color:var(--et-muted);font-family:inherit;font-size:12px;font-weight:700;
      cursor:pointer;display:inline-flex;align-items:center;gap:6px;padding:6px 4px;}
    .et-link-btn:hover{color:var(--et-blue);}

    /* Preview — Telegram chat bubble */
    .et-preview-col .et-card{position:sticky;top:14px;}
    .tg-chat{background:#cfd9e3;background-image:linear-gradient(rgba(207,217,227,.5),rgba(207,217,227,.5)),
      url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.18'%3E%3Ccircle cx='20' cy='20' r='2'/%3E%3C/g%3E%3C/svg%3E");
      min-height:380px;}
    .tg-bar{background:linear-gradient(135deg,#2AABEE,#229ED9);padding:11px 16px;display:flex;align-items:center;gap:11px;}
    .tg-av{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;}
    .tg-meta{flex:1;min-width:0;}
    .tg-name{font-size:14px;font-weight:700;color:#fff;line-height:1.2;}
    .tg-status{font-size:11px;color:rgba(255,255,255,.8);margin-top:1px;}
    .tg-body{padding:18px 14px 24px;min-height:300px;display:flex;flex-direction:column;justify-content:flex-end;}
    .tg-bubble{align-self:flex-start;background:#fff;border-radius:12px 12px 12px 4px;padding:9px 12px 7px;max-width:88%;
      box-shadow:0 1px 2px rgba(0,0,0,.14);position:relative;}
    .tg-text{font-size:13.5px;line-height:1.55;color:#0d1b2a;white-space:pre-wrap;word-break:break-word;}
    .tg-text b{font-weight:700;} .tg-text i{font-style:italic;}
    .tg-text code{font-family:'DM Mono',monospace;background:#eef2f6;padding:1px 5px;border-radius:4px;font-size:12.5px;color:#1a4d6e;}
    .tg-time{font-size:10.5px;color:#8aa0b0;text-align:right;margin-top:3px;}
    .tg-empty{align-self:center;margin:auto;color:#54656f;font-size:13px;text-align:center;background:rgba(255,255,255,.7);padding:14px 18px;border-radius:10px;}
    .tg-cat-tag{padding:9px 16px;border-bottom:1px solid var(--et-border);background:#f9fbfe;display:flex;align-items:center;gap:8px;
      font-size:11.5px;font-weight:700;color:var(--et-muted);}

    /* Quick send card */
    .tg-send{margin-top:18px;}
    .tg-send-body{padding:14px 16px;}

    /* Mobile tabs */
    .et-mtabs{display:none;gap:6px;margin-bottom:14px;}
    .et-mtab{flex:1;padding:9px;border-radius:10px;border:1.5px solid var(--et-border);background:#fff;
      font-size:12.5px;font-weight:700;color:var(--et-muted);font-family:inherit;cursor:pointer;}
    .et-mtab.active{background:#eef5ff;border-color:var(--et-blue);color:var(--et-blue-deep);}
    @media (max-width:860px){
      .et-mtabs{display:flex;}
      .et-grid.m-edit .et-preview-col{display:none;}
      .et-grid.m-prev .et-editor-col,.et-grid.m-prev .et-list-col{display:none;}
      .et-page{padding:12px 12px 90px;}
    }

    .et-spin-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.45);border-top-color:#fff;
      border-radius:50%;animation:etspin .7s linear infinite;display:inline-block;}
    @keyframes etspin{to{transform:rotate(360deg)}}

    /* Result modal (sukses/gagal) — identik wa-reminder */
    .rm-overlay{position:fixed;inset:0;z-index:10001;background:rgba(13,27,62,.5);
      display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;animation:rmFade .25s ease forwards;}
    @keyframes rmFade{to{opacity:1;}}
    .rm-card{background:#fff;border-radius:22px;max-width:380px;width:100%;padding:34px 28px 26px;text-align:center;
      box-shadow:0 24px 60px rgba(13,27,62,.28);transform:translateY(16px) scale(.94);opacity:0;
      animation:rmPop .42s cubic-bezier(.21,1.02,.4,1) .06s forwards;}
    @keyframes rmPop{to{transform:translateY(0) scale(1);opacity:1;}}
    .rm-icon{width:78px;height:78px;margin:0 auto 18px;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative;}
    .rm-icon.ok{background:radial-gradient(circle at 50% 40%,#eafaf0,#d8f5e3);}
    .rm-icon.err{background:radial-gradient(circle at 50% 40%,#fdeeee,#fad9d9);}
    .rm-icon svg{width:46px;height:46px;}
    .rm-icon::after{content:'';position:absolute;width:78px;height:78px;border-radius:50%;animation:rmPulse 1.1s ease-out .25s;}
    .rm-icon.ok::after{background:rgba(22,163,74,.18);}
    .rm-icon.err::after{background:rgba(220,38,38,.16);}
    @keyframes rmPulse{0%{transform:scale(.6);opacity:.7;}100%{transform:scale(1.7);opacity:0;}}
    .rm-draw{stroke-dasharray:48;stroke-dashoffset:48;animation:rmDraw .5s cubic-bezier(.65,0,.45,1) .32s forwards;}
    @keyframes rmDraw{to{stroke-dashoffset:0;}}
    .rm-title{font-size:19px;font-weight:800;color:#0d1b3e;letter-spacing:-.2px;opacity:0;animation:rmUp .4s ease .28s forwards;}
    .rm-msg{font-size:13px;color:#64748b;line-height:1.55;margin-top:7px;opacity:0;animation:rmUp .4s ease .36s forwards;}
    .rm-ok{width:100%;justify-content:center;margin-top:22px;height:48px;opacity:0;animation:rmUp .4s ease .44s forwards;}
    @keyframes rmUp{from{transform:translateY(8px);opacity:0;}to{transform:translateY(0);opacity:1;}}

    /* Test modal */
    .tm-overlay{position:fixed;inset:0;background:rgba(13,27,62,.5);z-index:10000;align-items:center;justify-content:center;padding:20px;}
    .tm-card{background:#fff;border-radius:18px;max-width:520px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 24px 48px rgba(0,0,0,.18);}
    .tm-h{display:flex;align-items:center;justify-content:space-between;padding:18px 22px 14px;border-bottom:1px solid #e8eaed;}
    .tm-x{background:#f4f8ff;border:1.5px solid #e0e7f3;border-radius:8px;width:30px;height:30px;cursor:pointer;color:#6b7fa8;font-size:16px;}
  </style>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { active: active }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { user: user }) %>
    <main class="page-content">
    <div class="et-page">

      <!-- Header -->
      <div class="et-hdr">
        <div>
          <div class="et-title">
            Telegram Center
          </div>
          <div class="et-sub">Kelola bot, notifikasi monitoring & template pesan Telegram — dengan preview langsung gaya Telegram</div>
        </div>
        <div class="et-actions">
          <button class="et-btn et-btn-ghost" id="btnRunChecks" onclick="runChecksNow()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Cek Monitoring
          </button>
          <button class="et-btn et-btn-tg" id="btnTest" onclick="testConnection()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Tes Koneksi
          </button>
          <button class="et-btn et-btn-primary" id="btnSave" onclick="saveAll()">
            <svg id="btnSaveIcon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span id="btnSaveLabel">Simpan Perubahan</span>
          </button>
        </div>
      </div>

      <!-- Stat strip -->
      <div class="rm-strip">
        <div class="rm-sc">
          <div class="rm-sc-lbl">Status Koneksi</div>
          <div class="rm-sc-body">
            <div><div class="rm-sc-val" id="scStatus" style="font-size:19px;">—</div>
              <div class="rm-sc-meta"><span class="rm-status-dot pill-grey" id="scStatusDot" style="background:#cbd5e1;"></span><span class="rm-sc-sub" id="scStatusSub">memuat…</span></div>
            </div>
          </div>
        </div>
        <div class="rm-sc">
          <div class="rm-sc-lbl">Notifikasi Aktif</div>
          <div class="rm-sc-body">
            <div><div class="rm-sc-val" id="scNotif">0</div>
              <div class="rm-sc-meta"><span class="rm-sc-pill pill-green" id="scNotifPill">0/4</span><span class="rm-sc-sub">jenis</span></div>
            </div>
          </div>
        </div>
        <div class="rm-sc">
          <div class="rm-sc-lbl">Template Custom</div>
          <div class="rm-sc-body">
            <div><div class="rm-sc-val" id="scTpl">0</div>
              <div class="rm-sc-meta"><span class="rm-sc-pill pill-teal" id="scTplPill">0/8</span><span class="rm-sc-sub">disesuaikan</span></div>
            </div>
          </div>
        </div>
        <div class="rm-sc">
          <div class="rm-sc-lbl">Aktivitas Bot</div>
          <div class="rm-sc-body">
            <div><div class="rm-sc-val" id="scBotToday">0</div>
              <div class="rm-sc-meta"><span class="rm-sc-pill pill-blue" id="scBotWeek">0 / 7 hari</span><span class="rm-sc-sub">aksi hari ini</span></div>
            </div>
          </div>
        </div>
