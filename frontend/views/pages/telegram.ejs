            Routing Notifikasi per Jenis <span style="font-weight:600;color:#94a3b8;font-size:11px;text-transform:none;letter-spacing:0;">(opsional)</span>
          </div>
          <div class="et-hint" style="max-width:560px;margin-bottom:10px;">Kirim tiap jenis ke grup berbeda. Kosongkan = ikut Chat ID utama. Mis. device/IP ke grup NOC, ONT/PPPoE ke grup teknisi.</div>
          <div class="tg-adv-grid" style="max-width:560px;">
            <div class="et-field"><div class="et-label">Chat Perangkat</div><input type="text" class="et-inp" id="tg-chat-device" placeholder="default" oninput="onAnyChange()"></div>
            <div class="et-field"><div class="et-label">Chat ONT</div><input type="text" class="et-inp" id="tg-chat-ont" placeholder="default" oninput="onAnyChange()"></div>
            <div class="et-field"><div class="et-label">Chat IP</div><input type="text" class="et-inp" id="tg-chat-ip" placeholder="default" oninput="onAnyChange()"></div>
            <div class="et-field"><div class="et-label">Chat PPPoE</div><input type="text" class="et-inp" id="tg-chat-pppoe" placeholder="default" oninput="onAnyChange()"></div>
          </div>

          <div class="tg-sub-h">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-4-5.7V5a2 2 0 10-4 0v.3C7.7 6.2 6 8.4 6 11v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 11-6 0v-1"/></svg>
            Notifikasi Event Bisnis
          </div>
          <div class="et-hint" style="max-width:560px;margin-bottom:10px;">Kirim notif kejadian operasional ke Telegram. Tujuan: Chat Event (di bawah) atau Chat ID utama.</div>
          <div class="tg-notif-grid">
            <label class="tg-notif" data-notif="payment">
              <span class="tg-notif-ic" style="background:rgba(13,148,136,.12);"><svg width="18" height="18" fill="none" stroke="#0d9488" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
              <span class="tg-notif-tx"><div class="tg-notif-t">Pembayaran Masuk</div><div class="tg-notif-d">Saat pelanggan bayar</div></span>
              <label class="et-switch sw-blue"><input type="checkbox" id="tg-evt-payment" onchange="onAnyChange();syncNotifCard(this)"><span class="et-track"></span></label>
            </label>
            <label class="tg-notif" data-notif="newcust">
              <span class="tg-notif-ic" style="background:rgba(26,110,245,.12);"><svg width="18" height="18" fill="none" stroke="#1a6ef5" stroke-width="2" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg></span>
              <span class="tg-notif-tx"><div class="tg-notif-t">Pelanggan Baru</div><div class="tg-notif-d">Saat registrasi/aktivasi</div></span>
              <label class="et-switch sw-blue"><input type="checkbox" id="tg-evt-newcust" onchange="onAnyChange();syncNotifCard(this)"><span class="et-track"></span></label>
            </label>
            <label class="tg-notif" data-notif="ticket">
              <span class="tg-notif-ic" style="background:rgba(13,148,136,.12);"><svg width="18" height="18" fill="none" stroke="#0d9488" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16a2 2 0 012 2v4a2 2 0 000 4v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4a2 2 0 000-4V6a2 2 0 012-2z"/><path d="M13 5v2M13 17v2M13 11v2"/></svg></span>
              <span class="tg-notif-tx"><div class="tg-notif-t">Tiket Baru</div><div class="tg-notif-d">Saat tiket dibuat</div></span>
              <label class="et-switch sw-blue"><input type="checkbox" id="tg-evt-ticket" onchange="onAnyChange();syncNotifCard(this)"><span class="et-track"></span></label>
            </label>
            <label class="tg-notif" data-notif="voucher">
              <span class="tg-notif-ic" style="background:rgba(26,110,245,.12);"><svg width="18" height="18" fill="none" stroke="#1a6ef5" stroke-width="2" viewBox="0 0 24 24"><path d="M2 9a3 3 0 010 6v2a2 2 0 002 2h16a2 2 0 002-2v-2a3 3 0 010-6V7a2 2 0 00-2-2H4a2 2 0 00-2 2z"/><path d="M9 5v14" stroke-dasharray="2 2"/></svg></span>
              <span class="tg-notif-tx"><div class="tg-notif-t">Voucher Terjual</div><div class="tg-notif-d">Saat voucher hotspot laku</div></span>
              <label class="et-switch sw-blue"><input type="checkbox" id="tg-evt-voucher" onchange="onAnyChange();syncNotifCard(this)"><span class="et-track"></span></label>
            </label>
          </div>
          <div class="et-field" style="max-width:560px;margin-top:14px;">
            <div class="et-label">Chat ID Event <span style="font-weight:600;color:#94a3b8;">(opsional)</span></div>
            <input type="text" class="et-inp" id="tg-chat-event" placeholder="Kosongkan = pakai Chat ID utama. Multi: pisah koma." oninput="onAnyChange()">
          </div>

          <div class="tg-sub-h">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
            Feed PPPoE Connect / Disconnect
          </div>
          <div class="et-hint" style="max-width:560px;margin-bottom:10px;">Kirim kartu setiap pelanggan PPPoE <b>login</b> &amp; <b>logout</b> — berisi Server, User, Paket, IP, MAC, dan total Active/Offline. Ini feed aktivitas (bukan alarm gangguan).</div>
          <div class="tg-notif-grid">
            <label class="tg-notif" data-notif="pppoe-feed">
              <span class="tg-notif-ic" style="background:rgba(26,110,245,.12);"><svg width="18" height="18" fill="none" stroke="#1a6ef5" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12.55a11 11 0 0114 0M8.5 16.05a6 6 0 017 0M2 8.82a15 15 0 0120 0M12 20h.01"/></svg></span>
              <span class="tg-notif-tx"><div class="tg-notif-t">Aktifkan Feed PPPoE</div><div class="tg-notif-d">Master on/off untuk feed connect &amp; disconnect</div></span>
              <button type="button" class="tg-test-btn" onclick="event.preventDefault();TG.testNotif('pppoe_feed')" title="Kirim contoh kartu PPPoE">Tes</button><label class="et-switch sw-blue"><input type="checkbox" id="tg-pppoe-feed" onchange="onAnyChange();syncNotifCard(this)"><span class="et-track"></span></label>
            </label>
            <label class="tg-notif" data-notif="pppoe-connect">
              <span class="tg-notif-ic" style="background:rgba(13,148,136,.12);"><svg width="18" height="18" fill="none" stroke="#0d9488" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
              <span class="tg-notif-tx"><div class="tg-notif-t">Laporkan CONNECT</div><div class="tg-notif-d">Saat pelanggan PPPoE login</div></span>
              <label class="et-switch sw-blue"><input type="checkbox" id="tg-pppoe-feed-connect" onchange="onAnyChange();syncNotifCard(this)"><span class="et-track"></span></label>
            </label>
            <label class="tg-notif" data-notif="pppoe-disconnect">
              <span class="tg-notif-ic" style="background:rgba(100,116,139,.14);"><svg width="18" height="18" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M11 18l-6-6 6-6"/></svg></span>
              <span class="tg-notif-tx"><div class="tg-notif-t">Laporkan DISCONNECT</div><div class="tg-notif-d">Saat pelanggan PPPoE logout</div></span>
              <label class="et-switch sw-blue"><input type="checkbox" id="tg-pppoe-feed-logout" onchange="onAnyChange();syncNotifCard(this)"><span class="et-track"></span></label>
            </label>
          </div>
          <div class="tg-notif-grid" style="margin-top:12px;">
            <div class="et-field">
              <label class="et-label">Batas kartu / siklus</label>
              <input type="number" min="1" max="200" class="et-inp" id="tg-pppoe-feed-max" placeholder="25" onchange="onAnyChange()">
              <div class="et-hint">Cegah banjir saat banyak pelanggan reconnect serempak. Default 25.</div>
            </div>
            <div class="et-field">
              <label class="et-label">Chat ID Feed PPPoE <span style="font-weight:600;color:#94a3b8;">(opsional)</span></label>
              <input type="text" class="et-inp" id="tg-chat-pppoe-feed" placeholder="Kosongkan = pakai Chat ID utama" oninput="onAnyChange()">
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile tab switch -->
      <div class="et-mtabs">
        <button type="button" class="et-mtab active" data-mtab="edit" onclick="mtab('edit')">Edit Template</button>
        <button type="button" class="et-mtab" data-mtab="prev" onclick="mtab('prev')">Preview</button>
      </div>

      <div class="et-grid m-edit" id="etGrid">
        <!-- TEMPLATE LIST -->
        <div class="et-list-col">
          <div class="et-card">
            <div class="et-card-h">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              Template Pesan
              <span class="cnt" id="tplCount">8</span>
            </div>
            <div class="et-list" id="tplList"></div>
          </div>
        </div>

        <!-- EDITOR -->
        <div class="et-editor-col">
          <div class="et-card">
            <div class="et-card-h" id="etEditorTitle">Editor Template</div>
            <div class="et-editor" id="etEditor">
              <div style="text-align:center;padding:40px 10px;color:#94a3b8;font-size:13px;">Pilih template di sebelah kiri untuk mengatur.</div>
            </div>
          </div>
        </div>

        <!-- PREVIEW + QUICK SEND -->
        <div class="et-preview-col">
          <div class="et-card">
            <div class="et-card-h">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              Preview Langsung
            </div>
            <div class="tg-cat-tag" id="tgCatTag">
              <span class="rm-status-dot" id="tgCatDot" style="background:#229ED9;"></span>
              <span id="tgCatLabel">Notifikasi Telegram</span>
            </div>
            <div class="tg-chat">
              <div class="tg-bar">
                <div class="tg-av">
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg>
                </div>
                <div class="tg-meta">
                  <div class="tg-name" id="tgBotName">Bot Monitoring</div>
                  <div class="tg-status">bot</div>
                </div>
              </div>
              <div class="tg-body">
                <div class="tg-empty" id="tgEmpty">Pilih template untuk melihat preview pesan.</div>
                <div class="tg-bubble" id="tgBubble" style="display:none;">
                  <div class="tg-text" id="tgText"></div>
                  <div class="tg-time" id="tgTime">00.00</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick send -->
          <div class="et-card tg-send">
            <div class="et-card-h">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              Kirim Pesan Cepat
            </div>
            <div class="tg-send-body">
              <textarea id="tgQuickText" class="et-ta" style="min-height:90px;" placeholder="Tulis pesan bebas… (mendukung &lt;b&gt;, &lt;i&gt;, &lt;code&gt;)">Tes pesan dari dashboard ISP.</textarea>
              <div class="et-hint" style="margin-bottom:12px;">Dikirim langsung ke semua Chat ID terdaftar. Cocok untuk pengumuman cepat.</div>
              <button class="et-btn et-btn-tg" style="width:100%;justify-content:center;" id="btnQuickSend" onclick="sendQuick()">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                Kirim ke Telegram
              </button>
            </div>
          </div>

          <!-- Riwayat notifikasi -->
          <div class="et-card tg-hist-card" style="margin-top:18px;">
            <div class="et-card-h">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Riwayat Notifikasi
              <button onclick="TG.refreshHistory()" title="Muat ulang" style="margin-left:auto;background:none;border:none;cursor:pointer;color:#229ED9;font-size:11px;font-weight:800;display:inline-flex;align-items:center;gap:4px;"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>Refresh</button>
            </div>
            <div class="tg-history" id="tg-history">
              <div class="tg-hist-empty">Memuat riwayat…</div>
            </div>
            <div class="tg-hist-foot" id="tg-hist-foot" style="display:none;">
              <span class="tg-hist-info" id="tg-hist-info"></span>
              <span class="tg-hist-pager" id="tg-hist-pager"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
    </main>
  </div>
</div>

<!-- Result modal -->
<div id="resultModal" class="rm-overlay" style="display:none;">
  <div class="rm-card">
    <div class="rm-icon" id="rmIcon"></div>
    <div class="rm-title" id="rmTitle">Berhasil</div>
    <div class="rm-msg" id="rmMsg"></div>
    <button class="et-btn et-btn-primary rm-ok" onclick="closeResult()">Selesai</button>
  </div>
</div>

<!-- Modal: tambah/edit perintah bot -->
<style>
.botcmd-overlay{position:fixed;inset:0;background:rgba(15,23,42,.45);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px;}
.botcmd-dialog{background:#fff;border-radius:16px;width:100%;max-width:560px;max-height:90vh;display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(0,0,0,.28);}
.botcmd-dlg-h{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e8edf5;font-size:15px;font-weight:800;color:#1e293b;}
.botcmd-x{background:none;border:none;font-size:24px;line-height:1;cursor:pointer;color:#94a3b8;}
.botcmd-x:hover{color:#dc2626;}
.botcmd-dlg-body{padding:18px 20px;overflow-y:auto;display:flex;flex-direction:column;gap:13px;}
.botcmd-dlg-foot{display:flex;justify-content:flex-end;gap:10px;padding:14px 20px;border-top:1px solid #e8edf5;}
.botcmd-row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:520px){.botcmd-row2{grid-template-columns:1fr;}}
.botcmd-check{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:#1e293b;cursor:pointer;}
.botcmd-note{font-size:11px;color:#1a4d6e;background:#eef5ff;border:1px solid #cfe0fb;border-radius:8px;padding:9px 11px;line-height:1.45;}
.botcmd-err{font-size:12px;color:#dc2626;background:rgba(220,38,38,.08);border:1px solid rgba(220,38,38,.25);border-radius:8px;padding:9px 11px;}
.bc-ph{cursor:pointer;background:#eef2f9;border-radius:4px;padding:1px 5px;font-size:10.5px;color:#1a4d6e;margin-right:3px;display:inline-block;margin-top:3px;}
.bc-ph:hover{background:#dbe6f7;}
.botcmd-dlg-body .et-label{display:block;font-size:12px;font-weight:700;color:#334155;margin-bottom:5px;}
.botcmd-dlg-body .et-inp,.botcmd-dlg-body .et-sel{width:100%;border:1.5px solid #e8edf5;border-radius:11px;padding:10px 13px;font-size:13px;font-family:inherit;box-sizing:border-box;background:#fff;}
.botcmd-dlg-body textarea.et-inp{resize:vertical;}
.botcmd-dlg-body .et-hint{font-size:10.5px;color:#94a3b8;margin-top:5px;line-height:1.45;}
.botcmd-dlg-foot .et-btn{padding:9px 18px;border-radius:10px;border:1.5px solid #e8edf5;background:#fff;font-size:13px;font-weight:700;cursor:pointer;color:#334155;}
.botcmd-dlg-foot .et-btn-primary{background:#1a6ef5;border-color:#1a6ef5;color:#fff;}
</style>
<div class="botcmd-overlay" id="botcmd-modal" style="display:none;">
  <div class="botcmd-dialog">
    <div class="botcmd-dlg-h">
      <span id="botcmd-dlg-title">Tambah Perintah</span>
      <button class="botcmd-x" onclick="BotCmd.close()">&times;</button>
    </div>
    <div class="botcmd-dlg-body">
      <div id="botcmd-sys-note" class="botcmd-note" style="display:none;">Perintah bawaan: keyword & fungsi tidak dapat diubah, tetapi alias, deskripsi, dan status aktif bisa diatur.</div>
      <div class="botcmd-row2">
        <div class="et-field">
          <label class="et-label">Keyword <span style="color:#94a3b8;font-weight:600;">(tanpa /)</span></label>
          <input type="text" class="et-inp" id="bc-keyword" placeholder="mis. tagihan" maxlength="40">
        </div>
        <div class="et-field">
          <label class="et-label">Alias <span style="color:#94a3b8;font-weight:600;">(opsional, pisah koma)</span></label>
          <input type="text" class="et-inp" id="bc-aliases" placeholder="mis. bill,invoice">
        </div>
      </div>
      <div class="et-field" id="bc-type-field">
        <label class="et-label">Tipe Perintah</label>
        <select class="et-inp et-sel" id="bc-type" onchange="BotCmd.onTypeChange()">
          <option value="reply">Balasan Statis (teks tetap)</option>
          <option value="data">Aksi Data (ambil data lalu balas)</option>
        </select>
      </div>
      <div class="et-field" id="bc-source-field" style="display:none;">
        <label class="et-label">Sumber Data</label>
        <select class="et-inp et-sel" id="bc-source" onchange="BotCmd.onSourceChange()"></select>
        <div class="et-hint" id="bc-source-hint"></div>
      </div>
      <div class="et-field">
        <label class="et-label">Deskripsi</label>
        <input type="text" class="et-inp" id="bc-desc" placeholder="Penjelasan singkat (tampil di /help)" maxlength="255">
      </div>
      <div class="et-field" id="bc-template-field">
        <label class="et-label">Format Balasan</label>
        <textarea class="et-inp" id="bc-template" rows="5" placeholder="Tulis balasan… mendukung <b>, <code>, dan placeholder."></textarea>
        <div class="et-hint" id="bc-placeholders"></div>
      </div>
      <div class="botcmd-row2">
        <label class="botcmd-check"><input type="checkbox" id="bc-control"> Butuh izin kontrol (eksekutif)</label>
        <label class="botcmd-check"><input type="checkbox" id="bc-enabled" checked> Aktif</label>
      </div>
      <div class="botcmd-err" id="bc-err" style="display:none;"></div>
    </div>
    <div class="botcmd-dlg-foot">
      <button class="et-btn" onclick="BotCmd.close()">Batal</button>
      <button class="et-btn et-btn-primary" id="bc-save" onclick="BotCmd.save()">Simpan</button>
    </div>
  </div>
</div>

<script>window.__COMPANY = <%- JSON.stringify(appName || 'ISP') %>;</script>
<script src="/js/app.js"></script>
<script src="/js/telegram-center.js"></script>
<script src="/js/bot-commands.js"></script>
</body>
</html>
