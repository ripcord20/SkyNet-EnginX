        <label class="ot-inline-check"><input type="checkbox" id="tfAuto" checked> Auto-refresh (3 dtk)</label>
        <span id="tfStamp" class="mut" style="font-size:11px"></span>
      </div>
      <div class="info-note" style="margin-top:10px">Angka adalah rate sesaat dari OLT (<code>show interface</code>). Download = arah ke pelanggan, Upload = dari pelanggan.</div>
    </div>
    <div class="ot-modal-foot"><div></div><div class="ot-modal-foot-r">
      <button class="btn btn-outline btn-sm" id="tfRefreshBtn" onclick="OltMgmt.refreshOnuTraffic()">Refresh</button>
      <button class="btn btn-blue btn-sm" onclick="OltMgmt.closeOnuTraffic()">Tutup</button>
    </div></div>
  </div>
</div>

<!-- Modal: VLAN per-ONU (service-port) -->
<div class="ot-modal-overlay" id="onuVlanModal">
  <div class="ot-modal-box wide">
    <div class="ot-modal-hdr">
      <h3 id="onuVlanTitle">VLAN ONU</h3>
      <button class="ot-modal-close" onclick="OltMgmt.closeOnuVlan()"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="ot-modal-body">
      <input type="hidden" id="onuVlanRef">
      <div id="onuVlanList" style="margin-bottom:16px">
        <div style="text-align:center;padding:24px;color:var(--faint)"><span class="spin"></span> Memuat service-port...</div>
      </div>
      <div style="border-top:1px solid #eef2f7;padding-top:14px">
        <div class="form-label" style="margin-bottom:10px">Tambah / Set Service-Port</div>
        <div class="form-row">
          <div class="form-group"><label class="form-label">SP</label><input type="number" id="spSp" class="form-control" value="1" min="1"></div>
          <div class="form-group"><label class="form-label">GEM</label><input type="number" id="spGem" class="form-control" value="1" min="1"></div>
          <div class="form-group"><label class="form-label">User VLAN</label><input type="number" id="spUserVlan" class="form-control" placeholder="100"></div>
          <div class="form-group"><label class="form-label">VLAN</label><input type="number" id="spVlan" class="form-control" placeholder="100"></div>
        </div>
        <button class="btn btn-green btn-sm" onclick="OltMgmt.saveOnuVlan()" style="width:100%;justify-content:center">Terapkan VLAN</button>
      </div>
    </div>
  </div>
</div>

<script src="/vendor/apexcharts/apexcharts.min.js"></script>
<script src="/js/app.js"></script>
<script src="/js/olt-management.js"></script>
</body>
</html>
