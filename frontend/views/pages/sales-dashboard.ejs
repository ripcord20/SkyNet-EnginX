<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.min.js"></script>
<script src="/vendor/leaflet/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
<script>
const ROLE = <%- JSON.stringify((user && user.role && (typeof user.role==='object'? user.role.name : user.role)) || '') %>;
const APP_NAME = <%- JSON.stringify(typeof appName !== 'undefined' ? appName : 'FLAYNET') %>;
const IS_ADMIN = ['admin','superadmin'].includes((ROLE||'').toLowerCase());
const IS_SALES = (ROLE||'').toLowerCase() === 'sales';
const IS_SUPERADMIN = (ROLE||'').toLowerCase() === 'superadmin';
let covMap, covMarker, packagesCache = [];

function toast(m,ok=true){const t=document.getElementById('toast');t.textContent=m;t.className='toast '+(ok?'ok':'err');t.style.display='block';setTimeout(()=>t.style.display='none',3000);}
function rupiah(n){return 'Rp'+Number(n||0).toLocaleString('id-ID');}
function rupiahShort(n){n=Number(n||0);if(n>=1e9)return 'Rp'+(n/1e9).toFixed(1)+'M';if(n>=1e6)return 'Rp'+(n/1e6).toFixed(1)+'jt';if(n>=1e3)return 'Rp'+(n/1e3).toFixed(0)+'rb';return 'Rp'+n;}
// Format tanggal defensif: coba beberapa kemungkinan nama field, fallback '-'
function fmtDate(obj){
  const raw = (obj && (obj.created_at ?? obj.createdAt ?? obj.created ?? obj.tanggal)) || null;
  if(!raw) return '-';
  const d = new Date(raw);
  return isNaN(d.getTime()) ? '-' : d.toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'});
}
function fmtDateVal(raw){
  if(!raw) return '-';
  const d = new Date(raw);
  return isNaN(d.getTime()) ? '-' : d.toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'});
}
function closeModal(id){document.getElementById(id).classList.remove('show');if(id==='commProofModal'){const f=document.getElementById('cpmImgFrame');if(f&&f._objUrl){URL.revokeObjectURL(f._objUrl);f._objUrl=null;}if(f)f.innerHTML='<div class="cpm-img-loading">Memuat gambar…</div>';}}
async function api(url,opt={}){const r=await fetch('/api'+url,{headers:{'Content-Type':'application/json'},credentials:'include',...opt});return r.json();}

const STATUS_LABEL={lead:'Lead',survey_request:'Survey Request',surveyed:'Surveyed',survey_rejected:'Survey Ditolak',approved:'Approved',installing:'Installing',activated:'Activated',cancelled:'Cancelled'};
const STATUS_CLASS={lead:'p-lead',survey_request:'p-survey',surveyed:'p-surveyed',survey_rejected:'p-rejected',approved:'p-approved',installing:'p-installing',activated:'p-activated',cancelled:'p-cancelled'};
const SUB={overview:'Ringkasan performa akuisisi pelanggan Anda',pipeline:'Kelola lead, survey, dan instalasi',customers:'Pelanggan yang berhasil diaktivasi',coverage:'Cek ketersediaan jaringan di titik pelanggan',potential:'Area dengan banyak calon pelanggan tapi belum ter-cover ODP',referral:'Bagikan link & pantau referral Anda',kpi:'Progress target bulanan & indikator kinerja',commission:'Riwayat & pembayaran komisi',leaderboard:'Peringkat performa tim sales',analytics:'Analisis tren registrasi, aktivasi & komisi',manage:'Pantau kinerja tim sales & atur komisi'};
const TITLE={overview:'Sales Dashboard',pipeline:'Pipeline Registrasi',customers:'Daftar Customer',coverage:'Coverage Checker',potential:'Area Potensi',referral:'Referral',kpi:'Target & KPI',commission:'Komisi',leaderboard:'Leaderboard',analytics:'Analytics',manage:'Manajemen Sales'};

function goSection(sec){
  document.querySelectorAll('.fx-section').forEach(s=>s.classList.toggle('on',s.dataset.section===sec));
  document.querySelectorAll('.fx-pill').forEach(p=>p.classList.toggle('on',p.dataset.go===sec));
  document.querySelectorAll('.sales-nav').forEach(n=>n.classList.toggle('active',n.dataset.salesNav===sec));
  const titleEl=document.getElementById('fxTitle');
  titleEl.innerHTML = sec==='overview' ? 'Sales Dashboard <span style="font-size:22px"></span>' : (TITLE[sec]||'Sales');
  document.getElementById('fxSub').textContent=SUB[sec]||'';
  if(sec==='coverage'){ if(!covMap) setTimeout(initCovMap,60); else ensureMapRendered(covMap); }
  if(sec==='commission') loadComm();
  if(sec==='pipeline') loadRegs();
  if(sec==='customers') loadCustomers();
  if(sec==='potential') setTimeout(loadPotential,60);
  if(sec==='referral') loadReferralStats();
  if(sec==='kpi') loadKpi();
  if(sec==='leaderboard') loadLeaderboard();
  if(sec==='analytics') loadAnalytics();
  if(sec==='manage'){ loadTeam(); loadManageComm(); populateSalesFilters(); }
  if(sec==='overview') ensureMapRendered(coverageMap);
  window.scrollTo({top:0,behavior:'smooth'});
}
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.sales-nav').forEach(a=>{a.addEventListener('click',e=>{e.preventDefault();goSection(a.dataset.salesNav);});});
  // Admin/owner: tampilkan pill Manajemen Sales + selalu tampilkan bar pills di desktop
  if(IS_ADMIN){
    const pill=document.getElementById('pillManage'); if(pill) pill.style.display='';
    const bar=document.getElementById('fxPills'); if(bar) bar.style.display='flex';
  }
  const h=(location.hash||'').replace('#','');if(h&&TITLE[h]) goSection(h);
});
function refreshAll(){loadStats();loadAnalytics();loadRecent();loadCoverageMap();if(IS_ADMIN){loadTeam();loadManageComm();}toast('Diperbarui');}

// ── Stats ──
async function loadStats(){
  const j=await api('/sales/stats');if(!j.success)return;const d=j.data;
  stComm.textContent=rupiahShort(d.commission_earned);
  stLeads.textContent=d.leads;
  document.getElementById('stSurvey').textContent=d.surveying;
  stAct.textContent=d.activated_month;
  stTotal.textContent=d.activated_total;
  if(d.commission_paid){document.getElementById('dComm').textContent='Dibayar: '+rupiahShort(d.commission_paid);}
  if(d.target&&d.target.monthly_target>0){
    document.getElementById('dAct').textContent=`Target ${d.target.achieved}/${d.target.monthly_target} (${d.target.percent}%)`;
  }
}

// Tambah base layers (Street / Satelit / Hybrid) + kontrol switcher
// ── Peta sebaran pelanggan: cluster + heatmap + overlay ODP ──
let _custDistMap=null, _custCluster=null, _custHeat=null, _custOdpLayer=null;
let _custLayerState={cluster:true, heat:false, odp:false};
function _custStatusColor(st){
  st=(st||'').toLowerCase();
  if(st==='active') return '#16a34a';
  if(st==='isolated') return '#ef4444';
  if(st==='suspended') return '#f59e0b';
  return '#64748b';
}
function _custDistIcon(color){
  return L.divIcon({
    className:'',
    html:`<div style="width:16px;height:16px;border-radius:50%;background:${color};border:2.5px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.4)"></div>`,
    iconSize:[16,16], iconAnchor:[8,8], popupAnchor:[0,-8]
  });
}
async function loadCustomerMap(){
  const _ce=x=>String(x==null?'':x).replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));
  const host=document.getElementById('anCustMap');
  if(!host || typeof L==='undefined') return;
  if(typeof L.markerClusterGroup!=='function'){
    host.innerHTML='<div class="empty" style="padding:30px">Komponen peta gagal dimuat.</div>'; return;
  }
  if(!_custDistMap){
    _custDistMap=L.map(host,{scrollWheelZoom:true}).setView([-2.5,118],5);
    addBaseLayers(_custDistMap);
  }
  setTimeout(()=>{ try{_custDistMap.invalidateSize();}catch(_){} },200);

  try{
    // Ambil titik pelanggan + ODP paralel
    const [jc, jo]=await Promise.all([
      api('/sales/customer-points'),
      api('/sales/coverage-points').catch(()=>({success:false})),
    ]);
    const pts=(jc&&jc.success)?(jc.data||[]):[];
    const odps=(jo&&jo.success)?(jo.data||[]):[];
    const cntEl=document.getElementById('anMapCount');
    if(cntEl) cntEl.textContent=pts.length+' titik';

    // ── Layer 1: Cluster titik pelanggan ──
    if(_custCluster){ _custDistMap.removeLayer(_custCluster); _custCluster=null; }
    _custCluster=L.markerClusterGroup({ maxClusterRadius:50, spiderfyOnMaxZoom:true, showCoverageOnHover:false });
    const bounds=[];
    pts.forEach(p=>{
      const color=_custStatusColor(p.status);
      const m=L.marker([p.latitude,p.longitude],{icon:_custDistIcon(color)});
      const area=[p.district,p.regency].filter(Boolean).join(', ');
      m.bindPopup(
        `<div style="font-family:'DM Sans',sans-serif;min-width:180px">`
        +`<div style="font-weight:800;color:#0d1b3e;font-size:13px">${_ce(p.name||'-')}</div>`
        +`<div style="font-size:11px;color:#64748b;margin:2px 0">${_ce(p.customer_id||'')}</div>`
        +`<div style="font-size:11.5px;color:#475569;margin-top:4px;line-height:1.4">${_ce(p.address||'-')}</div>`
        +(area?`<div style="font-size:11px;color:#94a3b8;margin-top:3px">${_ce(area)}</div>`:'')
        +`<div style="margin-top:6px"><span style="display:inline-block;padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:700;color:#fff;background:${color}">${_ce((p.status||'').toUpperCase())}</span></div>`
        +`<a href="/customers/profile/${p.id}" style="display:inline-block;margin-top:7px;font-size:11.5px;color:#2563eb;font-weight:600;text-decoration:none">Lihat detail →</a>`
        +`</div>`
      );
      _custCluster.addLayer(m);
      bounds.push([p.latitude,p.longitude]);
    });

    // ── Layer 2: Heatmap kepadatan ──
    if(_custHeat){ _custDistMap.removeLayer(_custHeat); _custHeat=null; }
    if(typeof L.heatLayer==='function' && pts.length){
      const heatData=pts.map(p=>[p.latitude,p.longitude,0.6]);
      _custHeat=L.heatLayer(heatData,{ radius:28, blur:20, maxZoom:16,
        gradient:{0.2:'#3b82f6',0.45:'#22d3ee',0.65:'#f59e0b',0.85:'#f97316',1.0:'#ef4444'} });
    }

    // ── Layer 3: Overlay ODP/ODC (titik + radius jangkauan) ──
    if(_custOdpLayer){ _custDistMap.removeLayer(_custOdpLayer); _custOdpLayer=null; }
    _custOdpLayer=L.layerGroup();
    odps.forEach(p=>{
      addOdpRadius(_custOdpLayer, p);
      const big=(p.type==='pop'||p.type==='tower');
      const mk=L.marker([p.latitude,p.longitude],{icon:dotIcon(odpColor(p.type), big?18:14)});
      mk.bindPopup(odpPopupHtml(p), {className:'cmp-wrap', maxWidth:280});
      _custOdpLayer.addLayer(mk);
    });

    // Terapkan state layer aktif
    custApplyLayers();
    if(bounds.length){ try{ _custDistMap.fitBounds(bounds,{padding:[40,40],maxZoom:15}); }catch(_){} }
  }catch(e){ console.warn('loadCustomerMap:',e.message); }
}

// Pasang/lepas layer sesuai _custLayerState
function custApplyLayers(){
  if(!_custDistMap) return;
  const set=(layer,on)=>{ if(!layer) return; if(on){ if(!_custDistMap.hasLayer(layer)) _custDistMap.addLayer(layer); } else { if(_custDistMap.hasLayer(layer)) _custDistMap.removeLayer(layer); } };
  set(_custCluster, _custLayerState.cluster);
  set(_custHeat,    _custLayerState.heat);
  set(_custOdpLayer,_custLayerState.odp);
}

function toggleCustLayer(key, btn){
  _custLayerState[key]=!_custLayerState[key];
  if(btn) btn.classList.toggle('on', _custLayerState[key]);
  custApplyLayers();
}


function addBaseLayers(map){
  const street=L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap'});
  const sat=L.tileLayer('https://mt{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}',{maxZoom:21,subdomains:'0123',attribution:'&copy; Google'});
  const labels=L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}{r}.png',{maxZoom:19,pane:'overlayPane'});
  const hybrid=L.layerGroup([sat,labels]);
  street.addTo(map); // default
  const layers={street,sat,hybrid};
  map._baseLayers=layers; map._activeBase='street';

  // Tombol toggle clean (Peta / Satelit) — bukan dropdown
  const Ctl=L.Control.extend({
    options:{position:'topright'},
    onAdd:function(){
      const div=L.DomUtil.create('div','map-toggle');
      div.innerHTML=`
        <button type="button" data-base="street" class="on">Peta</button>
        <button type="button" data-base="hybrid">Satelit</button>`;
      L.DomEvent.disableClickPropagation(div);
      div.querySelectorAll('button').forEach(b=>{
        b.addEventListener('click',()=>{
          const key=b.dataset.base;
          if(map._activeBase===key) return;
          Object.values(layers).forEach(l=>{ if(map.hasLayer(l)) map.removeLayer(l); });
          layers[key].addTo(map);
          map._activeBase=key;
          div.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x.dataset.base===key));
        });
      });
      return div;
    }
  });
  map.addControl(new Ctl());
}
// Pastikan peta benar-benar ter-render (tiles abu-abu = container belum di-layout).
// Panggil invalidateSize beberapa kali setelah section terlihat.
function ensureMapRendered(map){
  if(!map) return;
  [60,200,450,900].forEach(ms=>setTimeout(()=>{ try{ map.invalidateSize(); }catch(_){} }, ms));
}

// Warna per tipe titik infrastruktur
function odpColor(type){ return (type==='pop'||type==='tower') ? '#0891b2' : '#2563eb'; }
function odpIconSvg(type){
  if(type==='pop'||type==='tower') return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 20l7-16 7 16M8 14h8"/></svg>';
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="9" width="16" height="11" rx="2"/><path d="M8 9V6a4 4 0 018 0v3"/></svg>';
}
// Marker bulat custom (divIcon) — tidak bergantung file gambar Leaflet
function dotIcon(color,size){
  size=size||16;
  return L.divIcon({
    className:'', html:`<div style="width:${size}px;height:${size}px;border-radius:50%;background:${color};border:2.5px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.35)"></div>`,
    iconSize:[size,size], iconAnchor:[size/2,size/2]
  });
}
// Radius jangkauan ODP/ODC (default 250m). POP/Tower tidak diberi radius (skala beda).
const ODP_COVERAGE_RADIUS = 250; // meter
function addOdpRadius(layer, p, radius){
  if(p.type!=='odp' && p.type!=='odc') return; // hanya ODP/ODC
  const r = radius || ODP_COVERAGE_RADIUS;
  const circle = L.circle([p.latitude, p.longitude], {
    radius: r,
    color: '#2563eb', weight: 1.5, opacity: .55,
    fillColor: '#2563eb', fillOpacity: .08,
    interactive: false // klik tembus ke marker, tidak menghalangi
  });
  layer.addLayer(circle);
}
// Builder HTML popup ODP/ODC/POP — clean dgn header berwarna + bar port
function odpPopupHtml(p){
  const color=odpColor(p.type);
  const cap=p.capacity, used=p.used_ports||0, free=p.free_ports;
  let portRow='';
  if(cap!=null){
    const ratio=cap>0?Math.min(1,used/cap):0;
    const barColor=ratio>=0.9?'#f5365c':ratio>=0.6?'#f59e0b':'#16a34a';
    portRow=`<div class="sxpop-row"><span class="l">Port Terpakai</span><span class="v">${used} / ${cap}</span></div>
      <div class="sxpop-row"><span class="l">Sisa Port</span>
        <span style="display:flex;align-items:center;gap:8px"><span class="sxpop-bar"><i style="width:${ratio*100}%;background:${barColor}"></i></span><b class="v" style="color:${free>0?'#16a34a':'#f5365c'}">${free}</b></span></div>`;
  } else {
    portRow=`<div class="sxpop-row"><span class="l">Kapasitas Port</span><span class="v" style="color:#94a3b8">Belum diatur</span></div>`;
  }
  return `<div class="sxpop" id="pop_${p.id}">
    <div class="sxpop-head" style="background:${color}">
      <span class="hic">${odpIconSvg(p.type)}</span>
      <span class="ht"><b>${p.name}</b><span>${p.type}</span></span>
    </div>
    <div class="sxpop-body">
      <div class="sxpop-row"><span class="l">Status</span><span class="v" style="color:${p.status==='active'?'#16a34a':'#f59e0b'}">${p.status||'-'}</span></div>
      ${portRow}
      <div class="sxpop-addr" id="addr_${p.id}">Memuat alamat…</div>
    </div></div>`;
}
// Popup lead (calon pelanggan) — gaya sama dgn ODP popup
function leadPopupHtml(p,idx){
  const covered=!p.uncovered;
  const color=covered?'#16a34a':'#f5365c';
  const statusTxt=covered?'Ter-cover':'Belum ter-cover';
  const odpRow=p.nearest_odp_m!=null
    ? `<div class="sxpop-row"><span class="l">ODP Terdekat</span><span class="v" style="color:${p.nearest_odp_m<=250?'#16a34a':'#f59e0b'}">${p.nearest_odp_m} m</span></div>`
    : `<div class="sxpop-row"><span class="l">ODP Terdekat</span><span class="v" style="color:#94a3b8">—</span></div>`;
  return `<div class="sxpop" id="pop_lead${idx}">
    <div class="sxpop-head" style="background:${color}">
      <span class="hic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
      <span class="ht"><b>${p.name||'Calon Pelanggan'}</b><span>Lead</span></span>
    </div>
    <div class="sxpop-body">
      <div class="sxpop-row"><span class="l">Status Coverage</span><span class="v" style="color:${color}">${statusTxt}</span></div>
      ${odpRow}
      <div class="sxpop-addr" id="addr_lead${idx}">Memuat alamat…</div>
    </div></div>`;
}
// Popup hotspot (cluster calon pelanggan tanpa ODP)
function hotspotPopupHtml(c){
  return `<div class="sxpop">
    <div class="sxpop-head" style="background:#f5365c">
      <span class="hic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 017 7c0 5-7 13-7 13S5 14 5 9a7 7 0 017-7z"/><path d="M9 9h6M12 6v6"/></svg></span>
      <span class="ht"><b>Hotspot Area</b><span>Peluang ekspansi</span></span>
    </div>
    <div class="sxpop-body">
      <div class="sxpop-row"><span class="l">Calon Pelanggan</span><span class="v"><b>${c.count}</b> lead</span></div>
      <div class="sxpop-row"><span class="l">Rata-rata ke ODP</span><span class="v" style="color:#f59e0b">${c.avg_distance_m?c.avg_distance_m+' m':'—'}</span></div>
      <div class="sxpop-addr" style="color:#64748b">Kandidat lokasi ODP baru — banyak permintaan belum terjangkau jaringan.</div>
    </div></div>`;
}
// Reverse geocode (lazy) — isi alamat saat popup dibuka
const _addrCache={};
async function fillAddr(id,lat,lng){
  const el=document.getElementById('addr_'+id); if(!el)return;
  if(_addrCache[id]){el.textContent=_addrCache[id];return;}
  try{
    // zoom=18 + addressdetails → dapat nama jalan, bukan POI/landmark acak
    const r=await fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=18&addressdetails=1&accept-language=id&lat='+lat+'&lon='+lng,{headers:{'Accept':'application/json'}});
    const j=await r.json();
    const a=j.address||{};
    // Susun alamat dari komponen, prioritaskan nama JALAN (road) di depan.
    const road = a.road || a.pedestrian || a.residential || a.footway || a.path || '';
    const area = a.village || a.suburb || a.neighbourhood || a.hamlet || '';
    const kec  = a.subdistrict || a.city_district || a.municipality || a.county || '';
    const kota = a.city || a.town || a.regency || a.state_district || '';
    const parts = [road, area, kec, kota].filter(Boolean);
    // Buang duplikat berurutan (mis. area==kec)
    const uniq = parts.filter((p,i)=> i===0 || p.toLowerCase()!==parts[i-1].toLowerCase());
    let txt = uniq.join(', ');
    // Fallback bila komponen kosong: pakai display_name, atau koordinat
    if(!txt) txt = j.display_name || (lat.toFixed(5)+', '+lng.toFixed(5));
    _addrCache[id]=txt; el.textContent=txt;
