function previewProof(input){
  const f=input.files&&input.files[0]; if(!f)return;
  const img=document.getElementById('payProofImg'),empty=document.getElementById('payProofEmpty');
  const r=new FileReader();r.onload=e=>{img.src=e.target.result;img.style.display='block';empty.style.display='none';};r.readAsDataURL(f);
}
async function submitPay(id){
  const btn=document.getElementById('paySaveBtn');btn.disabled=true;btn.textContent='Menyimpan...';
  const fd=new FormData();
  fd.append('paid_at', val('payDate'));
  fd.append('payment_method', val('payMethod'));
  // Gabungkan rekening tujuan ke dalam keterangan agar tersimpan
  const rek=val('payRek').trim(), note=val('payNotes').trim();
  const combined=[rek?('Rekening: '+rek):'', note].filter(Boolean).join(' — ');
  fd.append('notes', combined);
  const pf=document.getElementById('payProof');
  if(pf&&pf.files&&pf.files[0]) fd.append('proof', pf.files[0]);
  let j;
  try{
    const r=await fetch('/api/sales/commissions/'+id+'/pay',{method:'POST',credentials:'include',body:fd});
    j=await r.json();
  }catch(e){ j={success:false,message:'Gagal mengirim'}; }
  btn.disabled=false;btn.textContent='Simpan Pembayaran';
  if(!j.success)return toast(j.message,false);
  toast('Pembayaran komisi tercatat');
  closeModal('payModal');loadManageComm();loadTeam();loadStats();loadHistory();if(typeof loadComm==='function')loadComm();
}

