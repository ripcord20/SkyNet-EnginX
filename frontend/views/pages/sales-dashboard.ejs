function toggleRegRow(cb){
  if(cb.checked) _regSel.add(cb.value); else _regSel.delete(cb.value);
  const boxes=[...document.querySelectorAll('.reg-row-chk:not([disabled])')];
  const all=document.getElementById('regCheckAll');
  if(all) all.checked = boxes.length>0 && boxes.every(b=>b.checked);
  syncRegBulkBar();
}

function toggleAllRegs(cb){
  document.querySelectorAll('.reg-row-chk:not([disabled])').forEach(b=>{
    b.checked=cb.checked;
    if(cb.checked) _regSel.add(b.value); else _regSel.delete(b.value);
  });
  syncRegBulkBar();
}

function clearRegSelection(){
  _regSel.clear();
  document.querySelectorAll('.reg-row-chk').forEach(b=>b.checked=false);
  const all=document.getElementById('regCheckAll'); if(all) all.checked=false;
  syncRegBulkBar();
