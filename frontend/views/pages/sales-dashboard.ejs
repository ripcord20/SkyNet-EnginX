// Susun alamat lengkap dari detail + wilayah terpilih
function composeAddr(){
  const selName=id=>{const el=document.getElementById(id);if(!el||!el.value)return '';const o=el.options[el.selectedIndex];return o?(o.getAttribute('data-name')||o.textContent):'';};
