  const months=Object.keys(byMonth).sort();
  const series=months.map(m=>byMonth[m]);
  miniSpark('spkCustTotal', series.length?series:[0,1], '#2563eb');
  miniSpark('spkCustNew',   series.length?series:[0,1], '#16a34a');
