// Mini sparkline ala referensi. data: array angka; color hex. Menggambar
// kurva halus + area + titik akhir + label persen di ujung.
function miniSpark(elId, data, color, pct){
  const host=document.getElementById(elId); if(!host) return;
  let d=(data||[]).filter(v=>typeof v==='number'&&!isNaN(v));
  if(d.length<2) d=[ (d[0]||0)*0.6, (d[0]||0) , (d[0]||1) ]; // fallback bentuk minimal
  const W=84,H=38,pad=6, n=d.length;
  const max=Math.max(...d), min=Math.min(...d), range=(max-min)||1;
  const xAt=i=> pad + (W-2*pad)*(i/(n-1));
  const yAt=v=> (H-pad) - (H-2*pad)*((v-min)/range);
  const pts=d.map((v,i)=>[xAt(i),yAt(v)]);
  let line=`M ${pts[0][0]} ${pts[0][1]}`;
  for(let i=0;i<pts.length-1;i++){
    const p0=pts[i-1]||pts[i],p1=pts[i],p2=pts[i+1],p3=pts[i+2]||p2;
    const c1x=p1[0]+(p2[0]-p0[0])/6,c1y=p1[1]+(p2[1]-p0[1])/6;
    const c2x=p2[0]-(p3[0]-p1[0])/6,c2y=p2[1]-(p3[1]-p1[1])/6;
    line+=` C ${c1x} ${c1y}, ${c2x} ${c2y}, ${p2[0]} ${p2[1]}`;
  }
  const end=pts[pts.length-1];
  const area=`${line} L ${end[0]} ${H-1} L ${pts[0][0]} ${H-1} Z`;
  const gid='sg'+elId;
  const pctTxt=(pct!=null)?`<text class="spark-pct" x="${end[0]}" y="${Math.max(9,end[1]-7)}" text-anchor="end" fill="${color}">${pct}</text>`:'';
  host.innerHTML=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">
    <defs><linearGradient id="${gid}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="${color}" stop-opacity="0.22"/><stop offset="100%" stop-color="${color}" stop-opacity="0"/></linearGradient></defs>
    <path class="spark-area" d="${area}" fill="url(#${gid})"/>
    <path class="spark-line" d="${line}" stroke="${color}"/>
    <circle class="spark-dot" cx="${end[0]}" cy="${end[1]}" r="2.8" fill="#fff" stroke="${color}"/>
    ${pctTxt}</svg>`;
}
// Set baris tren: dot+panah berwarna. dir: 'up'|'down'|'flat'. pct angka (opsional). lab teks.
function setTrend(elId, dir, pct, lab){
  const el=document.getElementById(elId); if(!el) return;
  el.className='delta '+dir;
  const arrow = dir==='up'
    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 15 12 9 18 15"/></svg>'
    : dir==='down'
    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>'
    : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="18" y2="12"/></svg>';
  const pctTxt = pct!=null ? `<span>${dir==='up'?'+':dir==='down'?'-':''}${Math.abs(pct)}%</span>` : '';
  el.innerHTML=`<span class="dot-ic">${arrow}</span>${pctTxt}<span class="lab">${lab||''}</span>`;
}

// ════════ AREA POTENSI ════════
let potentialMap, potLayer, _apData=null, _apOdp=[], _apFilter='all';
async function loadPotential(){
  if(!potentialMap){
    potentialMap=L.map('potentialMap',{scrollWheelZoom:true}).setView([-6.2,106.81],11);
    addBaseLayers(potentialMap);
    potLayer=L.layerGroup().addTo(potentialMap);
    ensureMapRendered(potentialMap);
  } else { ensureMapRendered(potentialMap); }
  const cp=await api('/sales/coverage-points');
  const j=await api('/sales/potential-areas');
  _apOdp = (cp.success?cp.data:[]) || [];
  if(!j.success){document.getElementById('potentialMeta').textContent='Gagal memuat data.';return;}
  _apData=j.data;
  document.getElementById('apTotal').textContent=_apData.total_leads;
  document.getElementById('apUncov').textContent=_apData.uncovered_leads;
  document.getElementById('apHot').textContent=(_apData.hotspots||[]).length;
  renderPotential(_apFilter);
  // tabel hotspot
  const tb=document.getElementById('hotspotBody');
  const d=_apData;
  if(!d.hotspots||!d.hotspots.length){tb.innerHTML='<tr><td colspan="5" class="empty">Belum ada hotspot. Butuh ≥2 lead berdekatan tanpa ODP.</td></tr>';}
  else tb.innerHTML=d.hotspots.map((c,i)=>`<tr>
    <td style="font-weight:700">${i+1}</td>
    <td class="mono">${c.lat.toFixed(4)}, ${c.lng.toFixed(4)}</td>
    <td><b>${c.count}</b> lead</td>
    <td>${c.avg_distance_m?c.avg_distance_m+' m':'-'}</td>
    <td><button class="btn btn-outline btn-sm" onclick="potentialMap.setView([${c.lat},${c.lng}],15)">Lihat di Peta</button></td></tr>`).join('');
}
// Render marker peta sesuai filter: 'all' | 'uncovered' | 'hotspot'
function renderPotential(filter){
  if(!potLayer||!_apData) return;
  _apFilter=filter;
  potLayer.clearLayers();
  // ODP konteks (selalu tampil) — popup kaya (sama dgn Coverage Checker)
  _apOdp.forEach(p=>{
    addOdpRadius(potLayer, p);
    const m=L.marker([p.latitude,p.longitude],{icon:dotIcon(odpColor(p.type),14)})
      .bindPopup(odpPopupHtml(p),{className:'sxpop-wrap',maxWidth:280,minWidth:248});
    m.on('popupopen',()=>fillAddr(p.id,parseFloat(p.latitude),parseFloat(p.longitude)));
    m.addTo(potLayer);
  });
  const pts=[];
  if(filter!=='hotspot'){
    (_apData.points||[]).forEach((p,idx)=>{
      if(filter==='uncovered' && !p.uncovered) return; // hanya yang belum ter-cover
      const col=p.uncovered?'#f5365c':'#16a34a';
      const m=L.circleMarker([p.lat,p.lng],{radius:6,color:'#fff',weight:1.5,fillColor:col,fillOpacity:.95})
        .bindPopup(leadPopupHtml(p,idx),{className:'sxpop-wrap',maxWidth:270,minWidth:240});
      m.on('popupopen',()=>fillAddr('lead'+idx,p.lat,p.lng));
      m.addTo(potLayer);
      pts.push([p.lat,p.lng]);
    });
  }
  // cluster hotspot (untuk 'all' & 'hotspot')
  if(filter!=='uncovered'){
    (_apData.clusters||[]).forEach(c=>{
      if(c.count<2)return;
      L.circle([c.lat,c.lng],{radius:300+c.count*120,color:'#f5365c',weight:1.5,fillColor:'#f5365c',fillOpacity:.16})
        .bindPopup(hotspotPopupHtml(c),{className:'sxpop-wrap',maxWidth:260,minWidth:230}).addTo(potLayer);
      if(filter==='hotspot') pts.push([c.lat,c.lng]);
    });
  }
  if(pts.length){try{potentialMap.fitBounds(pts,{padding:[50,50],maxZoom:14});}catch(_){}}
  const lbl={all:'Menampilkan semua lead & hotspot.',uncovered:'Hanya lead yang belum terjangkau ODP.',hotspot:'Hanya area hotspot (cluster ≥2 lead).'}[filter];
  document.getElementById('potentialMeta').innerHTML=`<b>${_apData.uncovered_leads}</b> dari ${_apData.total_leads} lead belum terjangkau ODP. ${(_apData.hotspots||[]).length} area hotspot. <span style="color:var(--d-blue1,#1a6ef5)">${lbl}</span>`;
}
// Klik stat card Area Potensi → set active + filter peta
function pickApFilter(el,filter){
  document.querySelectorAll('#apStatCards .scard').forEach(c=>c.classList.remove('active'));
  el.classList.add('active');
  renderPotential(filter);
}

// ════════ TARGET & KPI ════════
let _kpiGaugeChart=null, _kpiTrendChart=null;
async function loadKpi(){
  const j=await api('/sales/kpi');if(!j.success)return;const d=j.data;
  const pct=Math.min(100,d.percent||0);
  const set=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v;};
  set('kAch',d.achieved);set('kRem',d.remaining);set('kLead',d.leads_month);set('kConv',d.conversion_rate+'%');
  // tren baris ikon
  setTrend&&setTrend('dAch', d.achieved>0?'up':'flat', null, 'aktivasi bulan ini');
  setTrend&&setTrend('dRem', d.remaining>0?'down':'up', null, d.remaining>0?'menuju target':'target tercapai');
  setTrend&&setTrend('dLead', d.leads_month>0?'up':'flat', null, 'registrasi masuk');
  setTrend&&setTrend('dConv', d.conversion_rate>=50?'up':'flat', null, 'lead → aktif');

  document.getElementById('kpiGaugeInfo').innerHTML=d.monthly_target>0
    ? `<b>${d.achieved}</b> / ${d.monthly_target} aktivasi`
    : '<span style="color:var(--muted)">Target belum diatur admin</span>';

  // Gauge radialBar (ApexCharts) — fallback SVG bila Apex tak tersedia
  renderKpiGauge(pct, d.target_reached);

  const bc=document.getElementById('bonusCard');
  if(d.target_bonus>0){
    bc.style.display='';
    const band=document.getElementById('bonusBand');
    band.classList.toggle('reached', !!d.target_reached);
    document.getElementById('bonusInfo').innerHTML=d.target_reached
      ? `Target tercapai! Bonus <b>${rupiah(d.target_bonus)}</b> aktif bulan ini.`
      : `Capai target bulan ini untuk dapat bonus <b>${rupiah(d.target_bonus)}</b>.`;
  } else bc.style.display='none';

  const tr=d.trend||[];
  renderTrendLine(tr.map(t=>t.label), tr.map(t=>t.value), 'kpiTrend');
}

function renderKpiGauge(pct, reached){
  const host=document.getElementById('kpiGauge'); if(!host) return;
  const color = reached||pct>=100 ? '#16a34a' : '#2563eb';
  if(typeof ApexCharts!=='undefined'){
    host.innerHTML='';
    if(_kpiGaugeChart){ try{_kpiGaugeChart.destroy();}catch(_){} _kpiGaugeChart=null; }
    _kpiGaugeChart=new ApexCharts(host,{
      chart:{type:'radialBar',height:260,sparkline:{enabled:false},fontFamily:'inherit'},
      series:[pct], colors:[color],
      plotOptions:{radialBar:{startAngle:-135,endAngle:135,hollow:{size:'62%'},
        track:{background:'#eef2f9',strokeWidth:'100%'},
        dataLabels:{name:{offsetY:22,color:'#64748b',fontSize:'13px',fontWeight:600},
          value:{offsetY:-12,color:'#0f172a',fontSize:'40px',fontWeight:800,formatter:v=>Math.round(v)+'%'}}}},
      fill:{type:'gradient',gradient:{shade:'light',type:'horizontal',gradientToColors:[reached||pct>=100?'#22c55e':'#60a5fa'],stops:[0,100]}},
      stroke:{lineCap:'round'},
      labels:['tercapai']
    });
    _kpiGaugeChart.render();
  } else {
    // fallback SVG half-gauge
    const R=88,C=Math.PI*R,filled=C*(pct/100);
    host.innerHTML=`<svg viewBox="0 0 220 132" width="220" height="132">
      <path d="M22 110 A88 88 0 0 1 198 110" fill="none" stroke="#eef2f9" stroke-width="18" stroke-linecap="round"/>
      <path d="M22 110 A88 88 0 0 1 198 110" fill="none" stroke="${color}" stroke-width="18" stroke-linecap="round" stroke-dasharray="${filled} ${C-filled}"/>
      <text x="110" y="92" text-anchor="middle" font-size="34" font-weight="800" fill="#0f172a">${pct}%</text>
      <text x="110" y="112" text-anchor="middle" font-size="12" fill="#64748b" font-weight="600">tercapai</text></svg>`;
  }
}

// Tren aktivasi — ApexCharts area (fallback SVG bila Apex tak tersedia)
function renderTrendLine(labels, values, elId){
  const host=document.getElementById(elId); if(!host) return;
  if(typeof ApexCharts!=='undefined'){
    host.innerHTML='';
    if(_kpiTrendChart){ try{_kpiTrendChart.destroy();}catch(_){} _kpiTrendChart=null; }
    _kpiTrendChart=new ApexCharts(host,{
      chart:{type:'area',height:300,fontFamily:'inherit',toolbar:{show:false},zoom:{enabled:false}},
      series:[{name:'Aktivasi',data:values}],
      colors:['#2563eb'],
      dataLabels:{enabled:true,formatter:v=>v>0?v:'',offsetY:-4,style:{fontSize:'11px',fontWeight:700,colors:['#1e3a8a']},background:{enabled:false}},
      stroke:{curve:'smooth',width:3},
      fill:{type:'gradient',gradient:{shadeIntensity:1,opacityFrom:0.35,opacityTo:0.02,stops:[0,100]}},
      markers:{size:5,colors:['#fff'],strokeColors:'#2563eb',strokeWidth:2.5,hover:{size:7}},
      xaxis:{categories:labels,labels:{style:{colors:'#64748b',fontWeight:600}},axisBorder:{show:false},axisTicks:{show:false}},
      yaxis:{min:0,forceNiceScale:true,labels:{style:{colors:'#94a3b8'},formatter:v=>Math.round(v)}},
      grid:{borderColor:'#eef2f8',strokeDashArray:0,xaxis:{lines:{show:false}}},
      tooltip:{y:{formatter:v=>v+' aktivasi'}}
    });
    _kpiTrendChart.render();
    return;
  }
  // ── Fallback SVG (Apex tak tersedia) ──
  const W=820, H=240, padL=40, padR=20, padT=18, padB=34;
  const cw=W-padL-padR, ch=H-padT-padB, n=labels.length;
  const niceMax=Math.max(5, Math.ceil(Math.max(1,...values)/5)*5);
  const xAt=i=> n<=1 ? padL+cw/2 : padL + cw*(i/(n-1));
  const yAt=v=> padT + ch - ch*(v/niceMax);
  let grid='';
  for(let g=0; g<=5; g++){const v=Math.round(niceMax*g/5), y=padT+ch-(ch*g/5);
    grid+=`<line x1="${padL}" y1="${y}" x2="${W-padR}" y2="${y}" stroke="#eef2f8"/><text x="${padL-10}" y="${y+4}" text-anchor="end" font-size="11" fill="#94a3b8">${v}</text>`;}
  let xlbl=''; labels.forEach((lb,i)=>{ xlbl+=`<text x="${xAt(i)}" y="${H-10}" text-anchor="middle" font-size="12" fill="#64748b" font-weight="600">${lb}</text>`; });
  const pts=values.map((v,i)=>[xAt(i), yAt(v)]);
  let line=pts.length===1?`M ${pts[0][0]} ${pts[0][1]} L ${pts[0][0]} ${pts[0][1]}`:`M ${pts[0][0]} ${pts[0][1]}`;
  for(let i=0;i<pts.length-1;i++){const p0=pts[i-1]||pts[i],p1=pts[i],p2=pts[i+1],p3=pts[i+2]||p2;
    const c1x=p1[0]+(p2[0]-p0[0])/6,c1y=p1[1]+(p2[1]-p0[1])/6,c2x=p2[0]-(p3[0]-p1[0])/6,c2y=p2[1]-(p3[1]-p1[1])/6;
    line+=` C ${c1x} ${c1y}, ${c2x} ${c2y}, ${p2[0]} ${p2[1]}`;}
  const area=`${line} L ${pts[pts.length-1][0]} ${padT+ch} L ${pts[0][0]} ${padT+ch} Z`;
  let dots=''; pts.forEach((p,i)=>{dots+=`<circle cx="${p[0]}" cy="${p[1]}" r="4.5" fill="#fff" stroke="#2563eb" stroke-width="2.5"/>`;if(values[i]>0)dots+=`<text x="${p[0]}" y="${p[1]-12}" text-anchor="middle" font-size="11" font-weight="700" fill="#1e3a8a">${values[i]}</text>`;});
  host.innerHTML=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet"><defs><linearGradient id="kpiArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#2563eb" stop-opacity="0.22"/><stop offset="100%" stop-color="#2563eb" stop-opacity="0"/></linearGradient></defs>${grid}<path d="${area}" fill="url(#kpiArea)"/><path d="${line}" fill="none" stroke="#2563eb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>${dots}${xlbl}</svg>`;
}

// ════════ LEADERBOARD ════════
async function loadLeaderboard(){
  const j=await api('/sales/team');const tb=document.getElementById('lbBody');if(!tb)return;
  const podium=document.getElementById('lbPodium');
  if(!j.success){tb.innerHTML='<tr><td colspan="5" class="empty">Hanya admin yang dapat melihat seluruh tim. Data Anda tampil di Dashboard.</td></tr>';if(podium)podium.innerHTML='';return;}
  if(!j.data.length){tb.innerHTML='<tr><td colspan="5" class="empty">Belum ada sales.</td></tr>';return;}
  const rows=[...j.data].sort((a,b)=>(b.total_activated||0)-(a.total_activated||0));
  const maxAct=Math.max(1,...rows.map(r=>r.total_activated||0));
  // podium 3 besar
  if(podium){
    const top=rows.slice(0,3);
    podium.innerHTML='<div style="display:flex;gap:12px;justify-content:center;align-items:flex-end;padding:10px 0 18px">'+
      top.map((u,i)=>{const h=[96,76,60][i],med=['🥇','🥈','🥉'][i],bg=['#fef9c3','#f1f5f9','#fde9d9'][i];
        return `<div style="text-align:center"><div style="font-size:24px">${med}</div>
          <div style="width:84px;height:${h}px;background:${bg};border-radius:12px 12px 0 0;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;padding:8px;border:1px solid var(--border)">
          <b style="font-size:18px">${u.total_activated}</b><span style="font-size:10px;color:var(--muted)">aktivasi</span></div>
          <div style="font-size:12px;font-weight:600;margin-top:6px;max-width:84px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${u.name}</div></div>`;
      }).join('')+'</div>';
  }
  tb.innerHTML=rows.map((u,i)=>{
    const medal=i===0?'🥇':i===1?'🥈':i===2?'🥉':(i+1);
    const w=Math.round((u.total_activated||0)/maxAct*100);
    return `<tr><td style="font-weight:700">${medal}</td>
      <td><b>${u.name}</b></td>
      <td><b>${u.total_activated}</b></td>
      <td class="mono">${rupiah(u.commission_earned)}</td>
      <td><span class="sxpop-bar" style="max-width:120px"><i style="width:${w}%;background:#2563eb"></i></span></td></tr>`;
  }).join('');
}

