function renderBar(labels,reg,act,elId){
  elId=elId||'barChart';
  const W=560,H=260,padL=36,padB=28,padT=10,padR=8;
  const cw=W-padL-padR,ch=H-padT-padB;
  const max=Math.max(1,...reg,...act);
  const niceMax=Math.ceil(max/5)*5||5;
  const n=labels.length,group=cw/n,bw=Math.min(16,group/3.2);
  let bars='',grid='',xlbl='';
  for(let g=0;g<=5;g++){const v=Math.round(niceMax*g/5);const y=padT+ch-(ch*g/5);
    grid+=`<line x1="${padL}" y1="${y}" x2="${W-padR}" y2="${y}" stroke="#eef2f8"/>`;
    grid+=`<text x="${padL-6}" y="${y+3}" text-anchor="end" font-size="9" fill="#94a3b8">${v}</text>`;}
  labels.forEach((lb,i)=>{
    const cx=padL+group*i+group/2;
    const h1=ch*(reg[i]/niceMax),h2=ch*(act[i]/niceMax);
    bars+=`<rect x="${cx-bw-2}" y="${padT+ch-h1}" width="${bw}" height="${h1}" rx="4" fill="#93c5fd"/>`;
    bars+=`<rect x="${cx+2}" y="${padT+ch-h2}" width="${bw}" height="${h2}" rx="4" fill="#2563eb"/>`;
    xlbl+=`<text x="${cx}" y="${H-9}" text-anchor="middle" font-size="10" fill="#64748b" font-weight="600">${lb}</text>`;
  });
  const el=document.getElementById(elId);if(el)el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" width="100%" preserveAspectRatio="xMidYMid meet">${grid}${bars}${xlbl}</svg>`;
}
function renderHeatmap(hm,elId){
  elId=elId||'heatmap';const host=document.getElementById(elId);if(!host)return;
  if(!hm){host.innerHTML='<div class="empty">Tidak ada data.</div>';return;}
  const {day_labels,bucket_labels,matrix}=hm;
  let max=1;matrix.forEach(r=>r.forEach(v=>{if(v>max)max=v;}));
  let html='<div class="heat">';
  html+='<div class="heat-row"><div class="heat-lbl"></div>'+day_labels.map(d=>`<div class="heat-col">${d}</div>`).join('')+'</div>';
  bucket_labels.forEach((b,bi)=>{
    html+=`<div class="heat-row"><div class="heat-lbl">${b}</div>`;
    day_labels.forEach((d,di)=>{
      const v=matrix[di][bi];const ratio=v/max;
      const bg=v===0?'#eef2f9':`rgba(37,99,235,${0.18+ratio*0.82})`;
      const col=ratio>0.5?'#fff':'#1e3a8a';
      html+=`<div class="heat-cell" style="background:${bg};color:${v?col:'transparent'}">${v||''}</div>`;
    });
    html+='</div>';
  });
  html+='</div>';
  host.innerHTML=html;
}
function renderDonut(sc,elId,legendId){
  elId=elId||'donut';legendId=legendId||'donutLegend';
  const segs=[
    {k:'Lead',v:sc.lead||0,c:'#93c5fd'},
    {k:'Survey',v:(sc.survey_request||0)+(sc.surveyed||0),c:'#fbbf24'},
    {k:'Instalasi',v:(sc.approved||0)+(sc.installing||0),c:'#0891b2'},
    {k:'Aktif',v:sc.activated||0,c:'#2563eb'},
  ];
  const total=segs.reduce((a,s)=>a+s.v,0);
  const R=70,SW=22,C=2*Math.PI*R,cx=90,cy=90;
  let off=0,arcs='';
  if(total===0){arcs=`<circle cx="${cx}" cy="${cy}" r="${R}" fill="none" stroke="#eef2f9" stroke-width="${SW}"/>`;}
  else segs.forEach(s=>{
    if(!s.v)return;const len=C*(s.v/total);
    arcs+=`<circle cx="${cx}" cy="${cy}" r="${R}" fill="none" stroke="${s.c}" stroke-width="${SW}" stroke-dasharray="${len} ${C-len}" stroke-dashoffset="${-off}" transform="rotate(-90 ${cx} ${cy})" stroke-linecap="butt"/>`;
    off+=len;
  });
  const el=document.getElementById(elId);
  if(el)el.innerHTML=`<svg viewBox="0 0 180 180" width="180" height="180">${arcs}
    <text x="90" y="84" text-anchor="middle" font-size="12" fill="#64748b" font-weight="600">Total Lead</text>
    <text x="90" y="106" text-anchor="middle" font-size="26" fill="#0f172a" font-weight="800">${total}</text></svg>`;
  const lg=document.getElementById(legendId);
  if(lg)lg.innerHTML=segs.map(s=>`<div class="gl-row"><div class="l"><span class="dot" style="background:${s.c}"></span>${s.k}</div><div class="v">${s.v}</div></div>`).join('');
}

