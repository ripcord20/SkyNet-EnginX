const COMM_METHOD_LABEL={transfer:'Transfer Bank',transfer_bank:'Transfer Bank',cash:'Tunai',tunai:'Tunai',ewallet:'E-Wallet',qris:'QRIS'};
function openCommProof(arg){
  const c = (typeof arg === 'object' && arg) ? arg : _histRows[arg];
  if(!c)return;
  const setTx=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v;};
  setTx('cpmReg', c.registration?.reg_number || ('Komisi #'+(c.id||'')) );
  setTx('cpmAmount', rupiah(c.amount));
  setTx('cpmSales', c.sales?.name || '—');
  setTx('cpmRegName', c.registration?.name || '—');
  setTx('cpmRegNo', c.registration?.reg_number || '—');
  setTx('cpmMethod', COMM_METHOD_LABEL[(c.payment_method||'').toLowerCase()] || c.payment_method || '—');
  setTx('cpmPaidAt', c.paid_at?fmtDateVal(c.paid_at):'—');
  setTx('cpmPaidBy', c.paidBy?.name || '—');
  setTx('cpmEarnedAt', c.earned_at?fmtDateVal(c.earned_at):'—');
  const noteRow=document.getElementById('cpmNoteRow');
  if(noteRow){ if(c.notes){noteRow.style.display='flex';setTx('cpmNote',c.notes);} else noteRow.style.display='none'; }

  const frame=document.getElementById('cpmImgFrame');
  const openLink=document.getElementById('cpmImgOpen');
  loadCommProofImage(frame, openLink, c.payment_proof);

  document.getElementById('commProofModal').classList.add('show');
}

