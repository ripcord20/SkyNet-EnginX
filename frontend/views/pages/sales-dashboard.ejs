function _commEmptyState(msg){
  return `<div class="cpm-img-empty">
    <div class="cpm-img-empty-icn"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M4 6h16v12a2 2 0 01-2 2H6a2 2 0 01-2-2V6z"/><line x1="3" y1="3" x2="21" y2="21" stroke-linecap="round"/></svg></div>
    <div class="cpm-img-empty-ttl">Bukti tidak tersedia</div>
    <div class="cpm-img-empty-sub">${(msg||'File bukti tidak ditemukan.').replace(/</g,'&lt;')}</div>
  </div>`;
}

async function loadCommProofImage(frame, openLink, url){
  if(!frame)return;
  if(frame._objUrl){URL.revokeObjectURL(frame._objUrl);frame._objUrl=null;}
  frame.classList.remove('is-empty');
  if(!url){ frame.classList.add('is-empty'); frame.innerHTML=_commEmptyState('Tidak ada file bukti untuk pembayaran ini.'); if(openLink)openLink.style.display='none'; return; }
  frame.innerHTML='<div class="cpm-img-loading">Memuat gambar…</div>';
  if(openLink){openLink.style.display='inline-flex';openLink.href=url;}
  try{
    const res=await fetch(url);
    const ct=(res.headers.get('content-type')||'').toLowerCase();
    if(!res.ok || ct.includes('application/json') || ct.includes('text/')){
      let msg='File bukti tidak ditemukan di server.';
      try{const t=await res.json();if(t&&t.message)msg=t.message;}catch(_){}
      frame.classList.add('is-empty'); frame.innerHTML=_commEmptyState(msg);
      if(openLink)openLink.style.display='none'; return;
    }
    const blob=await res.blob();
    const obj=URL.createObjectURL(blob); frame._objUrl=obj;
    if(openLink)openLink.href=obj;
    if(ct.includes('pdf')) frame.innerHTML=`<iframe src="${obj}"></iframe>`;
    else frame.innerHTML=`<img src="${obj}" alt="Bukti pembayaran komisi">`;
  }catch(e){
    frame.classList.add('is-empty'); frame.innerHTML=_commEmptyState('Gagal memuat bukti. Periksa koneksi atau coba lagi.');
    if(openLink)openLink.style.display='none';
  }
}

