async function restoreReg(id,btn){
  btn.disabled=true; btn.textContent='...';
  const j=await api('/sales/registrations/'+id+'/restore',{method:'POST'});
  toast(j.message,!!j.success);
  if(j.success){
    const tr=btn.closest('tr');
    tr.style.transition='opacity .25s'; tr.style.opacity='0';
    setTimeout(()=>tr.remove(),260);
    loadRegs();
  } else { btn.disabled=false; btn.textContent='Pulihkan'; }
}

