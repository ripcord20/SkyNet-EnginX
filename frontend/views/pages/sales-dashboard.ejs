async function loadTeam(){
  if(!IS_ADMIN)return;
  const j=await api('/sales/team');const tb=document.getElementById('teamBody');if(!tb)return;
  if(!j.success||!j.data.length){tb.innerHTML='<tr><td colspan="9" class="empty">Belum ada user sales. Klik "Tambah Sales" untuk membuat akun sales pertama.</td></tr>';
    mTeam.textContent='0';mAct.textContent='0';mEarned.textContent='Rp0';mPaid.textContent='Rp0';return;}
  // ranking by aktivasi desc
  const rows=[...j.data].sort((a,b)=>(b.total_activated||0)-(a.total_activated||0));
  let totAct=0,totEarn=0,totPaid=0;
  rows.forEach(u=>{totAct+=u.total_activated||0;totEarn+=u.commission_earned||0;totPaid+=u.commission_paid||0;});
  mTeam.textContent=rows.length;mAct.textContent=totAct;
  mEarned.textContent=rupiahShort(totEarn);mPaid.textContent=rupiahShort(totPaid);
  // Sparkline + tren (distribusi antar-sales sebagai bentuk visual)
  const actSeries=rows.map(u=>u.total_activated||0);
  const earnSeries=rows.map(u=>u.commission_earned||0);
  const paidSeries=rows.map(u=>u.commission_paid||0);
  const payoutPct=totEarn+totPaid>0?Math.round(totPaid/(totEarn+totPaid)*100):0;
  miniSpark('spkTeam',  rows.map((_,i)=>i+1), '#2563eb');
  miniSpark('spkAct',   actSeries.length?actSeries:[0,1], '#16a34a');
  miniSpark('spkEarned',earnSeries.length?earnSeries:[0,1], '#f59e0b');
  miniSpark('spkPaid',  paidSeries.length?paidSeries:[0,1], '#2563eb', payoutPct+'%');
  setTrend('dTeam','flat',null,`${rows.length} akun aktif`);
  setTrend('dAct', totAct>0?'up':'flat', null, 'pelanggan aktif');
  setTrend('dEarned', totEarn>0?'up':'flat', null, 'belum dibayar');
  setTrend('dPaid', 'up', payoutPct, 'dari total komisi');
  tb.innerHTML=rows.map((u,i)=>{
    const medal=i===0?'🥇':i===1?'🥈':i===2?'🥉':(i+1);
    const area=u.profile.region?`<span class="pill p-surveyed">${u.profile.region}</span>`:'<span style="color:var(--muted2)">—</span>';
    const inactive=u.profile.is_active===false?' <span class="pill p-cancelled">nonaktif</span>':'';
    return `<tr>
      <td style="font-weight:700">${medal}</td>
      <td><b>${u.name}</b>${inactive}<br><span style="color:var(--muted);font-size:12px">${u.email||''}</span></td>
      <td>${area}</td>
      <td class="mono">${u.profile.referral_code}</td>
      <td><b>${u.total_activated}</b></td>
      <td class="mono">${rupiah(u.commission_earned)}</td>
      <td class="mono" style="color:var(--muted)">${rupiah(u.commission_paid)}</td>
      <td>${u.profile.monthly_target||0}</td>
      <td style="white-space:nowrap"><button class="btn btn-outline btn-sm" onclick='editTeam(${JSON.stringify(u).replace(/'/g,"&#39;")})'>Atur</button> <button class="btn btn-outline btn-sm" onclick="printSlip(${u.id},'${(u.name||'').replace(/'/g,"&#39;")}')">Slip</button></td>
    </tr>`;
  }).join('');
}
