async function loadComm(){
  const j=await api('/sales/commissions');const tb=document.getElementById('commBody');if(!tb)return;
  const showChk=IS_ADMIN;
  document.getElementById('payBulkBtn').style.display=showChk?'':'none';
  document.getElementById('thChk').style.display=showChk?'':'none';
  const thAct=document.getElementById('thAct'); if(thAct) thAct.style.display=showChk?'':'none';
  if(!j.success||!j.data.length){tb.innerHTML='<tr><td colspan="8" class="empty">Belum ada komisi.</td></tr>';return;}
  _commCache=_commCache||{};
  const pillClass={earned:'p-earned',approved:'p-approved',paid:'p-paid',pending:'p-lead',void:'p-cancelled'};
  tb.innerHTML=j.data.map(c=>{ _commCache[c.id]=c;
    // tombol aksi (admin): earned→Setujui, approved→Bayar, paid→(kosong)
    let act='';
    if(showChk){
      if(c.status==='earned') act=`<button class="btn btn-blue btn-sm" onclick="approveOne(${c.id})">Setujui</button>`;
      else if(c.status==='approved') act=`<button class="btn btn-green btn-sm" onclick="openPayModal(${c.id})">Bayar</button>`;
      else if(c.status==='paid'&&c.payment_proof) act=`<button type="button" class="btn btn-outline btn-sm" onclick="openCommProofById(${c.id})">Bukti</button>`;
    }
    const sub=c.status==='paid'&&c.paidBy?`<br><span style="color:var(--muted2);font-size:10.5px">oleh ${c.paidBy.name}${c.paid_at?' · '+fmtDateVal(c.paid_at):''}</span>`
            :c.status==='approved'&&c.approvedBy?`<br><span style="color:var(--muted2);font-size:10.5px">disetujui ${c.approvedBy.name}</span>`:'';
    return `<tr>
    <td style="${showChk?'':'display:none'}">${c.status==='approved'?`<input type="checkbox" class="commChk" value="${c.id}">`:''}</td>
    <td>${c.sales?c.sales.name:'-'}</td>
    <td>${c.registration?c.registration.name:'-'}<br><span style="color:var(--muted);font-size:11px">${c.registration?c.registration.reg_number:''}</span></td>
    <td style="font-size:12px;color:var(--muted)">${c.scheme_detail||c.scheme}</td>
    <td class="mono"><b>${rupiah(c.amount)}</b></td>
    <td><span class="pill ${pillClass[c.status]||'p-earned'}">${c.status}</span>${sub}</td>
    <td style="font-size:12px;color:var(--muted)">${fmtDateVal(c.earned_at)}</td>
    <td style="${showChk?'':'display:none'}">${act}</td></tr>`;}).join('');
}
async function payBulk(){
  const ids=[...document.querySelectorAll('.commChk:checked')].map(c=>parseInt(c.value));
  if(!ids.length)return toast('Pilih komisi (yang sudah disetujui) dulu',false);
  if(!confirm(`Tandai ${ids.length} komisi sebagai dibayar?`))return;
