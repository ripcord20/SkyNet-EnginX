// ── Coverage Checker map ──
let covOdpLayer;
function initCovMap(){
  covMap=L.map('covMap',{scrollWheelZoom:true}).setView([-6.2,106.81],12);
  addBaseLayers(covMap);
  covOdpLayer=L.layerGroup().addTo(covMap);
  covMap.on('click',e=>{covLat.value=e.latlng.lat.toFixed(6);covLng.value=e.latlng.lng.toFixed(6);setCovMarker(e.latlng.lat,e.latlng.lng);});
  ensureMapRendered(covMap);
  loadCovOdp();
}
// Tampilkan marker ODP aktual di peta Coverage Checker
async function loadCovOdp(){
  const j=await api('/sales/coverage-points');
  if(!covOdpLayer)return;
  covOdpLayer.clearLayers();
  if(!j.success)return;
  j.data.forEach(p=>{
    addOdpRadius(covOdpLayer, p);
    const m=L.marker([p.latitude,p.longitude],{icon:dotIcon(odpColor(p.type),p.type==='pop'||p.type==='tower'?17:14)})
      .bindPopup(odpPopupHtml(p),{className:'sxpop-wrap',maxWidth:280,minWidth:248});
    m.on('popupopen',()=>fillAddr(p.id,p.latitude,p.longitude));
    m.addTo(covOdpLayer);
  });
}
function setCovMarker(lat,lng){
  if(covMarker)covMarker.setLatLng([lat,lng]);
  else covMarker=L.circleMarker([lat,lng],{radius:9,color:'#fff',weight:3,fillColor:'#f5365c',fillOpacity:1}).addTo(covMap);
}
async function runCov(){
  const lat=parseFloat(covLat.value),lng=parseFloat(covLng.value);
  if(isNaN(lat)||isNaN(lng))return toast('Masukkan koordinat',false);
  setCovMarker(lat,lng);covMap.setView([lat,lng],15);
  const j=await api('/sales/coverage-check',{method:'POST',body:JSON.stringify({latitude:lat,longitude:lng})});
  if(!j.success)return toast(j.message,false);
  const d=j.data;const res=document.getElementById('covRes');
  res.className='cov-res show '+d.coverage_status;res.innerHTML=d.message;
  let html='<table><thead class="thead-soft"><tr><th>ODP/ODC</th><th>Jarak</th><th>Est. Kabel</th><th>Port (terpakai/total)</th><th>Sisa</th></tr></thead><tbody>';
  (d.odps||[]).forEach(o=>{
    const portCell = o.capacity!=null ? `${o.used_ports||0} / ${o.capacity}` : '<span style="color:#94a3b8">Belum diatur</span>';
    const sisaCell = o.free_ports==null ? '<span style="color:#94a3b8">—</span>'
      : `<b style="color:${o.free_ports>0?'#16a34a':'#f5365c'}">${o.free_ports}</b>`;
    html+=`<tr><td>${o.name} <span class="pill p-lead">${o.type}</span></td><td>${o.distance} m</td><td>${o.cable_estimate} m</td><td>${portCell}</td><td>${sisaCell}</td></tr>`;
  });
  html+='</tbody></table>';
  if(d.nearest_pop)html+=`<div style="margin-top:10px;font-size:13px;color:var(--muted)">POP terdekat: <b>${d.nearest_pop.name}</b> (${d.nearest_pop.distance} m)</div>`;
  document.getElementById('covDetail').innerHTML=(d.odps&&d.odps.length)?html:'<div class="empty">Tidak ada ODP/ODC dalam jangkauan.</div>';
}

// ════════ Map helpers: pencarian alamat (geocoding) + deteksi GPS ════════
// target: 'coverage' (peta dashboard) atau 'cov' (Coverage Checker)
function _mapFor(target){ return target==='cov' ? covMap : coverageMap; }
function _focus(target,lat,lng,zoom){
  const m=_mapFor(target); if(!m)return;
  m.setView([lat,lng],zoom||16);
  if(target==='cov'){ covLat.value=lat.toFixed(6); covLng.value=lng.toFixed(6); setCovMarker(lat,lng); }
  else { dropMeMarker(lat,lng); }
}
function dropMeMarker(lat,lng){
  if(!coverageMap)return;
  if(coverageMeMarker) coverageMeMarker.setLatLng([lat,lng]);
  else coverageMeMarker=L.circleMarker([lat,lng],{radius:9,color:'#fff',weight:3,fillColor:'#f5365c',fillOpacity:1}).addTo(coverageMap).bindPopup('Lokasi Anda');
  coverageMeMarker.openPopup();
}
// ── Autocomplete pencarian alamat (Nominatim) ──
const _ac={ coverage:{t:null,items:[],idx:-1}, cov:{t:null,items:[],idx:-1} };
function suggest(target){
  const inp=document.getElementById(target==='cov'?'covSearch':'coverageSearch');
  const q=(inp.value||'').trim();
  const st=_ac[target];
  clearTimeout(st.t);
  if(q.length<3){ hideAc(target); return; }
  // debounce 350ms (Nominatim minta jangan spam)
  st.t=setTimeout(()=>fetchSuggest(target,q),350);
}
async function fetchSuggest(target,q){
  const spin=document.getElementById('spin_'+target); spin.classList.add('on');
  try{
    const r=await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&addressdetails=1&limit=6&countrycodes=id&q='+encodeURIComponent(q),{headers:{'Accept':'application/json'}});
    const arr=await r.json();
    _ac[target].items=Array.isArray(arr)?arr:[];
    _ac[target].idx=-1;
    renderAc(target);
  }catch(e){ _ac[target].items=[]; renderAc(target); }
  finally{ spin.classList.remove('on'); }
}
function renderAc(target){
  const box=document.getElementById('ac_'+target);
  const items=_ac[target].items;
  if(!items.length){ box.innerHTML='<div class="ac-empty">Alamat tidak ditemukan</div>'; box.classList.add('show'); return; }
  box.innerHTML=items.map((it,i)=>{
    const name=it.name || (it.display_name||'').split(',')[0];
    const sub=(it.display_name||'').replace(name+', ','');
    return `<div class="ac-item${i===_ac[target].idx?' active':''}" onmousedown="pickAc('${target}',${i})">
      <span class="pin"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
      <span class="txt"><span class="ttl">${name}</span><span class="sub">${sub}</span></span></div>`;
  }).join('');
  box.classList.add('show');
}
function hideAc(target){ const box=document.getElementById('ac_'+target); if(box){box.classList.remove('show');box.innerHTML='';} _ac[target].idx=-1; }
function pickAc(target,i){
  const it=_ac[target].items[i]; if(!it)return;
  const inp=document.getElementById(target==='cov'?'covSearch':'coverageSearch');
  inp.value=(it.display_name||'').split(',').slice(0,2).join(', ');
  hideAc(target);
  _focus(target,parseFloat(it.lat),parseFloat(it.lon),16);
}
// Navigasi keyboard: panah atas/bawah, Enter pilih, Esc tutup
function acKey(e,target){
  const st=_ac[target];
  if(e.key==='ArrowDown'){ e.preventDefault(); st.idx=Math.min(st.idx+1,st.items.length-1); renderAc(target); }
  else if(e.key==='ArrowUp'){ e.preventDefault(); st.idx=Math.max(st.idx-1,0); renderAc(target); }
  else if(e.key==='Enter'){ e.preventDefault(); if(st.idx>=0) pickAc(target,st.idx); else if(st.items.length) pickAc(target,0); }
  else if(e.key==='Escape'){ hideAc(target); }
}
// Tutup dropdown saat klik di luar
document.addEventListener('click',e=>{
  ['coverage','cov'].forEach(t=>{
    const wrap=document.getElementById('ac_'+t);
    const inp=document.getElementById(t==='cov'?'covSearch':'coverageSearch');
    if(wrap&&inp&&!wrap.contains(e.target)&&e.target!==inp) hideAc(t);
  });
});
// Deteksi lokasi GPS perangkat
function locateOn(target){
  if(!navigator.geolocation)return toast('Browser tidak mendukung GPS',false);
  toast('Mendeteksi lokasi...');
  navigator.geolocation.getCurrentPosition(
    p=>{ _focus(target,p.coords.latitude,p.coords.longitude,17); toast('Lokasi terdeteksi'); },
    err=>{ toast(err.code===1?'Izin lokasi ditolak':'Gagal mendapatkan lokasi',false); },
    {enableHighAccuracy:true,timeout:8000}
  );
}

