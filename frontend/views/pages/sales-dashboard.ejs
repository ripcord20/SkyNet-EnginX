// Geocode maju: cari koordinat dari nama wilayah terpilih → pindahkan peta+pin.
// Dipanggil saat dropdown wilayah berubah. Pakai level paling spesifik yg dipilih.
let _fwdGeoTimer=null;
function moveMapToWilayah(){
  const selName=id=>{const el=document.getElementById(id);if(!el||!el.value)return '';const o=el.options[el.selectedIndex];return o?(o.getAttribute('data-name')||o.textContent):'';};
  const desa=selName('rgDesa'), kec=selName('rgKec'), kab=selName('rgKab'), prov=selName('rgProv');
  if(!prov && !kab) return; // belum cukup data
  // query dari spesifik → umum (Nominatim lebih akurat dgn konteks lengkap)
  const q=[desa,kec,kab,prov,'Indonesia'].filter(Boolean).join(', ');
  clearTimeout(_fwdGeoTimer);
  _fwdGeoTimer=setTimeout(async()=>{
    try{
      const hint=document.getElementById('rgGeoHint');
      if(hint) hint.textContent='Mencari lokasi wilayah…';
      const r=await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&accept-language=id&countrycodes=id&q='+encodeURIComponent(q));
      const arr=await r.json();
      if(arr && arr.length){
        const lat=parseFloat(arr[0].lat), lng=parseFloat(arr[0].lon);
        // zoom menyesuaikan level: desa lebih dekat, provinsi lebih jauh
        const zoom=desa?15:kec?13:kab?12:10;
        if(rgMap) rgMap.setView([lat,lng],zoom);
        setRegMarkerOnly(lat,lng); // taruh pin tanpa menimpa alamat
        if(hint) hint.textContent='Peta menuju wilayah. Geser pin ke titik tepat rumah.';
      } else if(hint){ hint.textContent='Wilayah tak ditemukan di peta. Pilih manual.'; }
    }catch(_){}
  },500);
}
// Taruh/g geser pin + isi koordinat + cek coverage, TANPA reverse-geocode alamat
function setRegMarkerOnly(lat,lng){
  lat=+(+lat).toFixed(6); lng=+(+lng).toFixed(6);
  document.getElementById('rgLat').value=lat;
  document.getElementById('rgLng').value=lng;
  if(rgMap){
    if(rgMarker) rgMarker.setLatLng([lat,lng]);
    else rgMarker=L.marker([lat,lng],{draggable:true,icon:regPinIcon()}).addTo(rgMap)
      .on('dragend',ev=>{const p=ev.target.getLatLng();setRegPoint(p.lat,p.lng,false);});
  }
  checkRegCoverage(lat,lng);
}
function initRegMap(){
  const host=document.getElementById('rgMap'); if(!host) return;
  if(!rgMap){
    rgMap=L.map(host,{scrollWheelZoom:true}).setView([-6.2,106.81],12);
    addBaseLayers(rgMap);
    // ODP context + radius supaya sales tahu posisi jaringan
    api('/sales/coverage-points').then(j=>{
      if(j&&j.success) j.data.forEach(p=>{
        addOdpRadius(rgMap,p);
        L.circleMarker([p.latitude,p.longitude],{radius:4,color:'#fff',weight:1,fillColor:odpColor(p.type),fillOpacity:.85})
          .bindPopup(`<b>${p.name}</b> · ${(p.type||'').toUpperCase()}`).addTo(rgMap);
      });
    });
    rgMap.on('click',e=>setRegPoint(e.latlng.lat,e.latlng.lng,true));
  }
  ensureMapRendered(rgMap);
}
// Set titik (dari klik peta / GPS / input). reverse=true → update alamat juga.
function setRegPoint(lat,lng,doReverse){
  lat=+(+lat).toFixed(6); lng=+(+lng).toFixed(6);
  document.getElementById('rgLat').value=lat;
  document.getElementById('rgLng').value=lng;
  if(rgMap){
    if(rgMarker) rgMarker.setLatLng([lat,lng]);
    else rgMarker=L.marker([lat,lng],{draggable:true,icon:regPinIcon()}).addTo(rgMap)
      .on('dragend',ev=>{const p=ev.target.getLatLng();setRegPoint(p.lat,p.lng,true);});
    rgMap.panTo([lat,lng]);
  }
  document.getElementById('rgGeoHint').textContent='Pin diatur. Geser untuk menyesuaikan.';
  checkRegCoverage(lat,lng);
  if(doReverse) reverseRegAddress(lat,lng);
}
// Input manual koordinat → debounce → set titik
function onRegCoordInput(){
  const lat=parseFloat(document.getElementById('rgLat').value);
  const lng=parseFloat(document.getElementById('rgLng').value);
  if(isNaN(lat)||isNaN(lng)) return;
  if(lat<-90||lat>90||lng<-180||lng>180) return;
  clearTimeout(_rgCovTimer);
  _rgCovTimer=setTimeout(()=>{
    if(rgMap){
      if(rgMarker) rgMarker.setLatLng([lat,lng]); else rgMarker=L.marker([lat,lng],{draggable:true,icon:regPinIcon()}).addTo(rgMap).on('dragend',ev=>{const p=ev.target.getLatLng();setRegPoint(p.lat,p.lng,true);});
      rgMap.setView([lat,lng],15);
    }
    checkRegCoverage(lat,lng);
    reverseRegAddress(lat,lng);
  },600);
}
function regUseMyLocation(){
  if(!navigator.geolocation) return toast('Browser tidak mendukung geolokasi',false);
  document.getElementById('rgGeoHint').textContent='Mengambil lokasi...';
  navigator.geolocation.getCurrentPosition(
    pos=>{ if(rgMap) rgMap.setView([pos.coords.latitude,pos.coords.longitude],16); setRegPoint(pos.coords.latitude,pos.coords.longitude,true); },
    ()=>{ document.getElementById('rgGeoHint').textContent='Gagal mengambil lokasi. Pilih manual di peta.'; toast('Gagal mengambil lokasi',false); },
    {enableHighAccuracy:true,timeout:8000}
  );
}
// Cek coverage otomatis berdasarkan koordinat
async function checkRegCoverage(lat,lng){
  const box=document.getElementById('rgCoverage'); if(!box) return;
  box.style.display='flex'; box.className='reg-cov load';
  box.innerHTML='<span class="ic">…</span><span>Mengecek ketersediaan jaringan…</span>';
  try{
    const j=await api('/sales/coverage-check',{method:'POST',body:JSON.stringify({latitude:lat,longitude:lng})});
    if(j.success && j.data){
      const d=j.data;
      const odp=d.usable_odp||d.nearest_odp;
      const fmtDist=m=>{ if(m==null)return null; m=Math.round(m); return m>=1000?(m/1000).toFixed(m>=10000?0:1)+' km':m+' m'; };
      const dist=odp?fmtDist(odp.distance):null;
      if(d.coverage_status==='available'){
        box.className='reg-cov ok';
        box.innerHTML=`<span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:13px;height:13px"><polyline points="20 6 9 17 4 12"/></svg></span><span>Tercover! ODP <b>${odp?odp.name:'-'}</b> ± ${dist}${odp&&odp.free_ports!=null?` · ${odp.free_ports} port kosong`:''}.</span>`;
      } else if(d.coverage_status==='unknown'){
        box.className='reg-cov load';
        box.innerHTML=`<span class="ic">!</span><span>Perlu survey — ODP terdekat <b>${odp?odp.name:'-'}</b> ± ${dist} (agak jauh / port penuh).</span>`;
      } else {
        box.className='reg-cov no';
        box.innerHTML=`<span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="width:13px;height:13px"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span><span>Belum tercover${dist!=null?` — ODP terdekat ± ${dist}`:''}. Tetap bisa didaftarkan sebagai lead.</span>`;
      }
    } else { box.style.display='none'; }
  }catch(e){ box.style.display='none'; }
}
// Reverse-geocode → isi alamat otomatis HANYA bila benar-benar kosong &
// belum ada wilayah dipilih (agar tidak bentrok dgn dropdown wilayah).
async function reverseRegAddress(lat,lng){
  const addrEl=document.getElementById('rgAddr');
  const hasWilayah=document.getElementById('rgProv').value||document.getElementById('rgJalan').value.trim();
  if(addrEl.value.trim()||hasWilayah) return; // jangan timpa isian manual/komposisi
  clearTimeout(_rgAddrTimer);
  _rgAddrTimer=setTimeout(async()=>{
    try{
      const r=await fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=18&addressdetails=1&accept-language=id&lat='+lat+'&lon='+lng);
      const j=await r.json();
      const a=j.address||{};
      const road=a.road||a.pedestrian||a.residential||'';
      const num=a.house_number?(' No. '+a.house_number):'';
      const area=a.village||a.suburb||a.neighbourhood||a.hamlet||'';
      const kec=a.subdistrict||a.city_district||a.municipality||a.county||'';
      const kota=a.city||a.town||a.regency||'';
      const parts=[(road?road+num:''),area,kec,kota].filter(Boolean);
      const uniq=parts.filter((p,i)=>i===0||p.toLowerCase()!==parts[i-1].toLowerCase());
      const txt=uniq.join(', ')||j.display_name||'';
      if(txt && !addrEl.value.trim()) addrEl.value=txt;
    }catch(_){}
  },500);
}
