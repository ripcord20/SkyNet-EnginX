// HAPUS REGISTRASI (soft delete)
// ═══════════════════════════════════════════════════════════════
// Data dipindah ke Trash, tidak dihapus permanen. Admin bisa memulihkan
// lewat tombol Trash di header pipeline.

function _escHtml(t){return String(t==null?'':t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

/**
 * Dialog konfirmasi kustom. Mengembalikan Promise:
 *   - mode biasa  : true / false
 *   - needReason  : string alasan / null kalau dibatalkan
 */
function regConfirm(opt){
  return new Promise(resolve=>{
    const need=!!opt.needReason;
    const el=document.createElement('div');
    el.className='regcf '+(opt.tone||'danger');
    el.innerHTML=`
      <div class="regcf-bd"></div>
      <div class="regcf-cd" role="dialog" aria-modal="true">
        <div class="regcf-bdy">
          <div class="regcf-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></div>
          <h4 class="regcf-ti">${opt.title||'Hapus Registrasi?'}</h4>
          <p class="regcf-ms">${opt.message||''}</p>
          ${opt.note?`<div class="regcf-nt">${opt.note}</div>`:''}
          ${need?`<textarea class="regcf-in" rows="2" placeholder="Alasan penghapusan (wajib)"></textarea>`:''}
        </div>
        <div class="regcf-ft">
          <button class="regcf-b c" data-a="c">Batal</button>
          <button class="regcf-b k" data-a="k">${opt.okText||'Ya, Hapus'}</button>
        </div>
      </div>`;
    document.body.appendChild(el);
    const ta=el.querySelector('.regcf-in');
    let done=false;
    const fin=v=>{
      if(done)return; done=true;
      el.classList.remove('show');
      document.removeEventListener('keydown',onKey);
      setTimeout(()=>el.remove(),240);
      resolve(v);
    };
    const ok=()=>{
      if(need){
        const v=(ta.value||'').trim();
        // Alasan wajib untuk data sensitif — beri umpan balik visual,
        // jangan diam-diam menolak.
        if(!v){ ta.style.borderColor='#dc2626'; ta.focus(); return; }
        return fin(v);
      }
      fin(true);
    };
    const onKey=e=>{
      if(e.key==='Escape'){e.preventDefault();fin(need?null:false);}
      else if(e.key==='Enter'&&!e.shiftKey&&!need){e.preventDefault();ok();}
    };
    el.querySelector('[data-a=k]').onclick=ok;
    el.querySelector('[data-a=c]').onclick=()=>fin(need?null:false);
    el.querySelector('.regcf-bd').onclick=()=>fin(need?null:false);
    document.addEventListener('keydown',onKey);
    requestAnimationFrame(()=>{
      el.offsetHeight; el.classList.add('show');
      setTimeout(()=>{ (ta||el.querySelector('[data-a=k]')).focus(); },180);
    });
  });
}

/** Susun ringkasan dampak jadi HTML yang bisa dibaca operator. */
function _impactNote(d){
  const im=d.impact||{}; const li=[];
  if(im.customer) li.push(`Terhubung ke customer <b>${_escHtml(im.customer.name)}</b> (${_escHtml(im.customer.customer_id||'-')}) — data pelanggan <b>tidak ikut terhapus</b> dan layanannya tetap berjalan.`);
  if(im.workOrder) li.push(`Punya Work Order instalasi (WO #${im.workOrder.id}) — WO tidak ikut terhapus.`);
  if(im.commissions) li.push(`Ada <b>${im.commissions} catatan komisi</b> terkait. Komisi tidak ikut terhapus, tapi tautannya ke registrasi ini akan menggantung.`);
  li.push('Data dipindah ke <b>Trash</b>, bukan dihapus permanen — bisa dipulihkan admin kapan saja.');
  return li.map(t=>`<div style="margin-bottom:6px">• ${t}</div>`).join('');
}

async function deleteReg(id, regNo, status){
  // Ambil dampak dari server dulu supaya peringatannya faktual,
  // bukan sekadar "yakin ingin menghapus?".
  let d=null;
  try{
    const j=await api('/sales/registrations/'+id+'/delete-impact');
    if(!j.success) return toast(j.message,false);
    d=j.data;
  }catch(e){ return toast('Gagal memeriksa data: '+e.message,false); }

  const isProtected=d.protected;
  const ans=await regConfirm({
    tone: isProtected?'danger':'warn',
    title: isProtected?'Hapus Registrasi Aktif?':'Hapus Registrasi?',
    message: `<b>${_escHtml(d.reg_number||('#'+id))}</b> — ${_escHtml(d.name||'')}`,
    note: _impactNote(d),
    okText: isProtected?'Ya, Hapus Permanen dari Pipeline':'Ya, Hapus',
    needReason: isProtected,   // status activated wajib beralasan
  });
  if(ans===false||ans===null) return;

  const body=(typeof ans==='string')?JSON.stringify({reason:ans}):'{}';
  const j=await api('/sales/registrations/'+id,{method:'DELETE',body});
  toast(j.message, !!j.success);
  if(j.success) loadRegs();
}

async function bulkDeleteRegs(){
  const ids=[..._regSel].map(Number);
  if(!ids.length) return toast('Belum ada registrasi dipilih',false);

  // Periksa apakah ada yang berstatus activated di antara pilihan —
  // kalau ada, alasan jadi wajib untuk seluruh batch.
  const rows=[...document.querySelectorAll('.reg-row-chk:checked')].map(b=>b.closest('tr'));
  const hasActivated=rows.some(tr=>/Activated/i.test(tr.querySelector('.pill')?.textContent||''));

  const ans=await regConfirm({
    tone:'danger',
    title:`Hapus ${ids.length} Registrasi?`,
    message:`<b>${ids.length} registrasi</b> akan dipindah ke Trash.`,
    note:(hasActivated
        ?'<div style="margin-bottom:6px">• Ada registrasi berstatus <b>Activated</b> di pilihan Anda. Data pelanggan dan komisinya <b>tidak ikut terhapus</b>.</div>'
        :'')
      +'<div style="margin-bottom:6px">• Baris yang tidak boleh Anda hapus akan dilewati otomatis dan dilaporkan.</div>'
      +'<div>• Semua bisa dipulihkan lewat <b>Trash</b>.</div>',
    okText:`Ya, Hapus ${ids.length} Data`,
    needReason:hasActivated,
  });
  if(ans===false||ans===null) return;

  const payload={ids}; if(typeof ans==='string') payload.reason=ans;
  const j=await api('/sales/registrations/bulk-delete',{method:'POST',body:JSON.stringify(payload)});
  toast(j.message, !!j.success);

  // Tampilkan detail kegagalan supaya user tahu mana yang tidak terhapus
  if(j.data&&j.data.errors&&j.data.errors.length){
    console.warn('[bulk-delete] dilewati:',j.data.errors);
    const first=j.data.errors.slice(0,3).map(e=>`${e.reg_number||('#'+e.id)}: ${e.message}`).join('\n');
    setTimeout(()=>alert('Sebagian dilewati:\n\n'+first+(j.data.errors.length>3?`\n\n…dan ${j.data.errors.length-3} lainnya`:'')),400);
  }
  loadRegs();
}

