  coverageLayer.clearLayers();
  if(!j.success||!j.data.length){document.getElementById('coverageMeta').textContent='Belum ada titik infrastruktur dengan koordinat.';return;}
  const pts=[];
  j.data.forEach(p=>{
    addOdpRadius(coverageLayer, p);
    const m=L.marker([p.latitude,p.longitude],{icon:dotIcon(odpColor(p.type),p.type==='pop'||p.type==='tower'?18:15)})
      .bindPopup(odpPopupHtml(p),{className:'sxpop-wrap',maxWidth:280,minWidth:248});
    m.on('popupopen',()=>fillAddr(p.id,p.latitude,p.longitude));
    coverageLayer.addLayer(m); pts.push([p.latitude,p.longitude]);
  });
  if(pts.length){ try{ coverageMap.fitBounds(pts,{padding:[40,40],maxZoom:15}); }catch(_){} }
  const odp=j.data.filter(p=>p.type==='odp'||p.type==='odc').length;
  const pop=j.data.filter(p=>p.type==='pop'||p.type==='tower').length;
  const freeTot=j.data.reduce((a,p)=>a+(p.free_ports||0),0);
  document.getElementById('coverageMeta').innerHTML=`${odp} ODP/ODC · ${pop} POP/Tower · <b>${freeTot}</b> port kosong tersedia`;
}

