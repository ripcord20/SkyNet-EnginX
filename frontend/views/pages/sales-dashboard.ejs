<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sales Dashboard' %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
  <style>
    :root{
      --s-blue:#2563eb; --s-blue-d:#1d4ed8; --s-blue3:#1e3a8a; --s-sky:#0891b2;
      --s-slate:#334155; --s-green:#16a34a; --s-red:#e11d48; --s-amber:#d97706;
      --border:#e9eef6; --text:#0f172a; --muted:#64748b; --muted2:#94a3b8; --bg:#f1f5f9;
    }
    *{box-sizing:border-box;}
    .fx{font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg);}
    .fx .mono{font-family:'DM Mono',monospace;}

    /* Header */
    .fx-hdr{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px;}
    .fx-hdr h1{font-size:26px;font-weight:800;color:var(--text);margin:0;letter-spacing:-.6px;display:flex;align-items:center;gap:8px;}
    .fx-hdr p{font-size:13px;color:var(--muted);margin:3px 0 0;}
    .fx-hdr-r{display:flex;gap:9px;align-items:center;flex-wrap:wrap;}

    .btn{display:inline-flex;align-items:center;gap:6px;padding:10px 16px;border-radius:11px;font-size:13px;font-weight:600;cursor:pointer;border:1.5px solid;transition:all .15s;font-family:inherit;}
    .btn svg{width:15px;height:15px;}
    .btn-outline{background:#fff;border-color:var(--border);color:#374151;}
    .btn-outline:hover{background:#f8fafc;}
    .btn-blue{background:var(--s-blue);border-color:var(--s-blue);color:#fff;}
    .btn-blue:hover{background:var(--s-blue-d);}
    .btn-green{background:var(--s-green);border-color:var(--s-green);color:#fff;}
    .btn-sm{padding:7px 13px;font-size:12px;border-radius:9px;}
    .btn-ghost{background:#eef2f9;border-color:transparent;color:var(--text);}
    .icon-btn{width:40px;height:40px;border-radius:50%;border:1.5px solid var(--border);background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted);}
    .icon-btn svg{width:18px;height:18px;}

    .fx-section{display:none;} .fx-section.on{display:block;animation:fade .25s ease;}
    @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

    .fx-pills{display:none;gap:6px;background:#fff;border:1px solid var(--border);border-radius:13px;padding:5px;margin-bottom:18px;overflow-x:auto;}
    .fx-pill{padding:9px 15px;border:none;background:transparent;border-radius:9px;font-family:inherit;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;white-space:nowrap;}
    .fx-pill.on{background:var(--s-blue);color:#fff;}

    /* ── Stat cards (Flowdex style) ── */
    .stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:16px;}
    .scard{background:#fff;border:1px solid #eef1f6;border-radius:18px;padding:18px 20px;position:relative;transition:box-shadow .2s ease,transform .2s ease,background .25s ease,border-color .25s ease;box-shadow:0 1px 2px rgba(15,40,90,.04);}
    .scard:hover{box-shadow:0 10px 30px rgba(15,40,90,.08);transform:translateY(-1px);}
    .scard.clickable{cursor:pointer;}
    /* Active (klik) — background biru gradient, teks putih */
    .scard.active{background:linear-gradient(135deg,#2563eb,#1d4ed8 60%,#1e3a8a);border-color:transparent;box-shadow:0 12px 30px rgba(37,99,235,.30);}
    .scard.active .lbl,.scard.active .val{color:#fff!important;}
    .scard.active .lbl{color:rgba(255,255,255,.9)!important;}
    .scard.active .lbl .sub{color:rgba(255,255,255,.6)!important;}
    .scard.active .delta .lab{color:rgba(255,255,255,.78)!important;}
    .scard.active .delta.up,.scard.active .delta.down,.scard.active .delta.flat{color:#fff!important;}
    .scard.active .spark-line{stroke:#fff!important;} .scard.active .spark-area{fill:rgba(255,255,255,.18)!important;}
    .scard.active .spark-dot{fill:#fff!important;stroke:#2563eb!important;}
    .scard.active .dot-ic{background:rgba(255,255,255,.25)!important;}
    .scard .top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;}
    .scard .lbl{font-size:13px;color:#0f172a;font-weight:700;}
    .scard .lbl .sub{color:#9aa7bd;font-weight:500;}
    .scard .dots{color:var(--muted2);cursor:pointer;font-size:18px;line-height:1;}
    .scard .val{font-size:30px;font-weight:800;letter-spacing:-1px;color:var(--text);margin-top:12px;line-height:1;}
    .scard .val.money{font-size:24px;}
    /* baris tren: dot status + panah + persen + teks */
    .scard .delta{font-size:12px;font-weight:600;margin-top:12px;display:flex;align-items:center;gap:6px;}
    .scard .delta .dot-ic{width:18px;height:18px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;}
    .scard .delta .dot-ic svg{width:11px;height:11px;}
    .scard .delta .lab{color:#9aa7bd;font-weight:500;}
    .delta.up{color:#16a34a;} .delta.up .dot-ic{background:#dcfce7;color:#16a34a;}
    .delta.down{color:#e11d48;} .delta.down .dot-ic{background:#ffe4e6;color:#e11d48;}
    .delta.flat{color:#64748b;} .delta.flat .dot-ic{background:#eef2f7;color:#64748b;}
    .delta svg{width:14px;height:14px;}
    /* mini sparkline kanan-atas */
    .scard .spark{position:absolute;top:16px;right:18px;width:84px;height:38px;pointer-events:none;}
    .scard .spark svg{width:100%;height:100%;display:block;overflow:visible;}
    .spark-line{fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;}
    .spark-dot{stroke-width:2;}
    .spark-pct{font-size:10px;font-weight:700;}
    /* Highlight (blue gradient) — kartu pertama */
    .scard.hl{background:linear-gradient(150deg,#2563eb,#1d4ed8 55%,#1e3a8a);border-color:transparent;color:#fff;}
    .scard.hl .lbl{color:rgba(255,255,255,.9);} .scard.hl .lbl .sub{color:rgba(255,255,255,.6);}
    .scard.hl .val{color:#fff;}
    .scard.hl .dots{color:rgba(255,255,255,.7);}
    .scard.hl .delta{color:#fff;} .scard.hl .delta .lab{color:rgba(255,255,255,.8);}
    .scard.hl .spark-line{stroke:#fff;} .scard.hl .spark-area{fill:rgba(255,255,255,.18);} .scard.hl .spark-dot{fill:#fff;stroke:#2563eb;}

    /* Cards / layout */
    .grid-2{display:grid;grid-template-columns:1.5fr 1fr;gap:16px;margin-bottom:16px;}
    .grid-2b{display:grid;grid-template-columns:1fr 1.6fr;gap:16px;margin-bottom:16px;}
    .card{background:#fff;border:1px solid var(--border);border-radius:20px;padding:22px;margin-bottom:16px;}
    .card-h{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
    .card-h .t{font-size:16px;font-weight:700;color:var(--text);}
    .card-h .t small{display:block;font-size:12px;color:var(--muted);font-weight:400;margin-top:3px;}
    .link{font-size:13px;color:var(--s-blue);font-weight:600;text-decoration:none;cursor:pointer;}
    .legend{display:flex;gap:14px;align-items:center;}
    .legend span{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);font-weight:500;}
    .dot{width:9px;height:9px;border-radius:50%;display:inline-block;}
    .ring{width:11px;height:11px;border-radius:50%;display:inline-block;border:1.5px solid #2563eb;background:rgba(37,99,235,.12);}
    /* Area terbanyak — bar list */
    .area-bars{display:flex;flex-direction:column;gap:11px;padding:4px 0;}
    .area-row{display:flex;align-items:center;gap:11px;}
    .area-rank{width:22px;height:22px;border-radius:7px;background:#eef2f9;color:#475569;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .area-row:nth-child(1) .area-rank{background:#2563eb;color:#fff;}
    .area-row:nth-child(2) .area-rank{background:#60a5fa;color:#fff;}
    .area-row:nth-child(3) .area-rank{background:#93c5fd;color:#0f172a;}
    .area-name{flex:0 0 130px;font-size:12.5px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .area-track{flex:1;height:9px;background:#eef2f8;border-radius:100px;overflow:hidden;}
    .area-fill{display:block;height:100%;background:linear-gradient(90deg,#2563eb,#60a5fa);border-radius:100px;transition:width .5s cubic-bezier(.16,1,.3,1);}
    .area-cnt{flex:0 0 auto;font-size:13px;font-weight:800;color:var(--text);min-width:22px;text-align:right;}
    .an-list th,.an-list td{padding:9px 10px;}

    /* Bar chart (SVG) */
    .chart-wrap{width:100%;overflow:hidden;}
    /* Toggle peta/satelit — tombol bersih (bukan dropdown) */
    .map-toggle{display:flex;gap:0;background:#fff;border:1px solid var(--border);border-radius:10px;overflow:hidden;box-shadow:0 2px 8px rgba(15,40,90,.12);}
    .map-layers{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;}
    .ml-btn{display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border:1.5px solid var(--border);border-radius:9px;background:#fff;font-family:var(--font);font-size:12px;font-weight:600;color:var(--muted);cursor:pointer;transition:all .15s ease;}
    .ml-btn:hover{border-color:#cdd9ee;color:var(--text);}
    .ml-btn.on{border-color:#2563eb;background:#eff4ff;color:#1d4ed8;}
    .ml-btn .ml-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;}
    .map-toggle button{border:none;background:#fff;font-family:var(--font);font-size:12px;font-weight:600;color:var(--muted);padding:7px 14px;cursor:pointer;transition:background .18s ease,color .18s ease;}
    .map-toggle button:hover{background:#f1f5fb;color:var(--text);}
    .map-toggle button.on{background:#2563eb;color:#fff;}
    /* Modal pembayaran komisi */
    .pay-info{background:#f8fafc;border:1px solid #eef1f6;border-radius:14px;padding:14px 16px;margin-bottom:16px;}
    .pay-info-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:5px 0;font-size:13px;color:var(--muted);}
    .pay-info-row b{color:var(--text);font-weight:700;text-align:right;}
    .upload-drop{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;border:1.6px dashed #cbd6e8;border-radius:13px;padding:20px;cursor:pointer;background:#fbfdff;transition:border-color .2s ease,background .2s ease;text-align:center;}
    .upload-drop:hover{border-color:#2563eb;background:#f1f6ff;}
    .upload-drop span{font-size:12.5px;color:var(--muted);font-weight:500;}
    /* ── Registrasi modal redesign ── */
    .reg-modal{max-width:620px;}
    .reg-sec{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:20px 0 12px;padding-bottom:8px;border-bottom:1px solid #eef1f6;}
    .reg-sec:first-of-type{margin-top:6px;}
    .reg-sec-t{font-size:12px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:#2563eb;}
    .reg-sec-hint{font-size:11.5px;color:var(--muted2);font-weight:500;}
    .reg-modal .field label i{color:#e11d48;font-style:normal;font-weight:700;}
    .reg-loc-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;}
    .reg-loc-hint{font-size:11.5px;color:var(--muted2);}
    .reg-map{height:230px;border-radius:14px;overflow:hidden;border:1px solid var(--border);background:#eef2f7;}
    .reg-cov{margin-top:10px;border-radius:12px;padding:11px 14px;font-size:13px;font-weight:600;display:flex;align-items:center;gap:9px;}
    .reg-cov .ic{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;}
    .reg-cov.ok{background:#ecfdf5;border:1px solid #bbf7d0;color:#15803d;} .reg-cov.ok .ic{background:#16a34a;}
    .reg-cov.no{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;} .reg-cov.no .ic{background:#ef4444;}
    .reg-cov.load{background:#f1f5fb;border:1px solid var(--border);color:var(--muted);} .reg-cov.load .ic{background:#94a3b8;}
    .reg-submit{width:100%;justify-content:center;margin-top:18px;padding:13px;font-size:14.5px;}
    @media(max-width:600px){
      .reg-modal .row{flex-direction:column;gap:0;}
      .reg-map{height:200px;}
    }
    /* Target & KPI — chart tren tinggi tetap & rapi (gaya clean) */
    #kpiTrend{height:240px;}
    #kpiTrend svg{display:block;width:100%;height:100%;}
    .kpi-gauge-card{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:240px;}
    .kpi-gauge-sub{font-size:13px;color:var(--muted);font-weight:600;margin-top:6px;text-align:center;}
    /* KPI redesign layout */
    .kpi-top{display:grid;grid-template-columns:1fr 1.5fr;gap:16px;margin-bottom:16px;}
    .kpi-gauge-wrap{display:flex;flex-direction:column;}
    .kpi-stats{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-content:start;}
    .kpi-bonus-cell{display:flex;align-items:center;background:linear-gradient(135deg,#eff5ff,#f5f9ff)!important;border:1px solid #dbe7ff!important;}
    @media(max-width:900px){ .kpi-top{grid-template-columns:1fr;} }
    .bonus-band{background:linear-gradient(135deg,#eff5ff,#f5f9ff);border:1px solid #dbe7ff;border-radius:16px;padding:16px 18px;display:flex;align-items:center;gap:12px;}
    .bonus-band .ic{width:38px;height:38px;border-radius:11px;background:#2563eb;color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .bonus-band.reached .ic{background:#16a34a;}
    .bonus-band .tx{font-size:13.5px;font-weight:600;color:#1e3a5f;line-height:1.4;}

    /* Heatmap */
    .heat{display:grid;gap:6px;}
    .heat-row{display:grid;grid-template-columns:54px repeat(7,1fr);gap:6px;align-items:center;}
    .heat-cell{height:30px;border-radius:8px;background:#eef2f9;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:600;color:transparent;}
    .heat-lbl{font-size:11px;color:var(--muted);font-weight:600;}
    .heat-col{font-size:11px;color:var(--muted);font-weight:600;text-align:center;}

    /* Gauge / donut */
    .gauge-wrap{display:flex;flex-direction:column;align-items:center;}
    .gauge-legend{width:100%;margin-top:16px;display:flex;flex-direction:column;gap:10px;}
    .gl-row{display:flex;align-items:center;justify-content:space-between;font-size:13px;}
    .gl-row .l{display:flex;align-items:center;gap:8px;color:var(--text);font-weight:500;}
    .gl-row .v{font-weight:700;}

    /* CTA referral */
    .cta{background:linear-gradient(135deg,#2563eb,#1d4ed8 60%,#1e3a8a);color:#fff;border-radius:20px;padding:22px;position:relative;overflow:hidden;}
    .cta::after{content:'';position:absolute;right:-40px;bottom:-50px;width:170px;height:170px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.22),transparent 70%);}
    .cta h3{font-size:16px;font-weight:700;margin:0 0 4px;position:relative;}
    .cta p{font-size:12.5px;opacity:.85;margin:0 0 14px;position:relative;}
    .cta-link{display:flex;gap:8px;flex-wrap:wrap;position:relative;}
    .cta-link input{flex:1;min-width:150px;border:none;border-radius:11px;padding:11px 13px;font-family:'DM Mono',monospace;font-size:12.5px;background:rgba(255,255,255,.18);color:#fff;}
    .cta-link input::placeholder{color:rgba(255,255,255,.6);}
    .cta-btn{border:none;border-radius:11px;padding:11px 15px;font-family:inherit;font-weight:700;font-size:12.5px;cursor:pointer;background:#fff;color:var(--s-blue-d);}
    .cta-btn.wa{background:#25d366;color:#fff;}

    /* Tables */
    table{width:100%;border-collapse:collapse;}
    th{text-align:left;font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.4px;padding:11px 12px;border-bottom:1px solid var(--border);white-space:nowrap;}
    td{padding:13px 12px;font-size:13px;color:var(--text);border-bottom:1px solid #f1f5fb;font-weight:500;}
    tr:hover td{background:#fafcff;}
    .thead-soft th{background:#f8fafc;border-bottom:1px solid var(--border);}
    .thead-soft th:first-child{border-radius:10px 0 0 10px;} .thead-soft th:last-child{border-radius:0 10px 10px 0;}

    .pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600;}
    .p-lead{background:#e8f0ff;color:#2563eb;} .p-survey{background:#fff4e0;color:#b45309;}
    .p-surveyed{background:#e0f2fe;color:#0369a1;} .p-rejected{background:#ffe9ee;color:#be123c;}
    .p-approved{background:#dcfce7;color:#15803d;} .p-installing{background:#e0f5ff;color:#0891b2;}
    .p-activated{background:#e1faf1;color:#047857;} .p-cancelled{background:#f1f5f9;color:#64748b;}
    .p-earned{background:#fff4e0;color:#b45309;} .p-paid{background:#e1faf1;color:#047857;}

    .field{margin-bottom:14px;}
    .field label{display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;color:var(--text);}
    .field input,.field select,.field textarea{width:100%;padding:11px 13px;border:1.5px solid var(--border);border-radius:11px;font-family:inherit;font-size:13.5px;font-weight:400;background:#fff;}
    .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--s-blue);}
    .field textarea{resize:vertical;min-height:70px;}
    .row{display:flex;gap:12px;flex-wrap:wrap;}.row>*{flex:1;min-width:150px;}

    .cov-res{border-radius:13px;padding:14px;margin-top:12px;font-size:13.5px;font-weight:600;display:none;}
    .cov-res.show{display:block;}
    .cov-res.available{background:#e1faf1;color:#047857;border:1px solid #a7f3d0;}
    .cov-res.not_covered{background:#ffe9ee;color:#be123c;border:1px solid #fecaca;}
    .cov-res.unknown{background:#fff4e0;color:#b45309;border:1px solid #fde68a;}
    .map{height:420px;border-radius:14px;overflow:hidden;border:1px solid var(--border);}
    /* Desktop: peta lebih tinggi agar tidak terlihat gepeng */
    @media(min-width:1100px){
      .map{height:480px;}
      #coverageMap{height:520px!important;}
      #potentialMap{height:560px!important;}
      #covMap{height:480px!important;}
    }
    @media(max-width:768px){
      .map{height:300px;}
      #coverageMap,#potentialMap,#covMap{height:300px!important;}
    }
    /* ── Popup peta clean (ala infrastructure) ── */
    .sxpop-wrap .leaflet-popup-content-wrapper{padding:0!important;border-radius:14px!important;overflow:hidden;box-shadow:0 10px 36px rgba(13,27,62,.24)!important;border:none!important;}
    .sxpop-wrap .leaflet-popup-content{margin:0!important;width:auto!important;}
    .sxpop-wrap .leaflet-popup-tip{background:#fff;}
    .sxpop-wrap .leaflet-popup-close-button{color:rgba(255,255,255,.85)!important;font-size:20px!important;top:9px!important;right:11px!important;z-index:10;width:auto!important;height:auto!important;}
    .sxpop-wrap .leaflet-popup-close-button:hover{color:#fff!important;}
    .sxpop{font-family:'Plus Jakarta Sans',sans-serif;width:248px;}
    .sxpop-head{color:#fff;padding:13px 15px;display:flex;align-items:center;gap:9px;position:relative;}
    .sxpop-head .hic{width:30px;height:30px;border-radius:9px;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .sxpop-head .hic svg{width:16px;height:16px;}
    .sxpop-head .ht{min-width:0;}
    .sxpop-head .ht b{font-size:14px;font-weight:700;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .sxpop-head .ht span{font-size:11px;opacity:.85;font-weight:500;text-transform:uppercase;letter-spacing:.4px;}
    .sxpop-body{background:#fff;padding:4px 0;}
    .sxpop-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 15px;border-bottom:1px solid #f1f5f9;font-size:12.5px;}
    .sxpop-row:last-child{border-bottom:none;}
    .sxpop-row .l{color:#94a3b8;font-weight:500;flex-shrink:0;}
    .sxpop-row .v{color:#1e293b;font-weight:700;text-align:right;}
    .sxpop-bar{height:6px;border-radius:4px;background:#eef2f9;overflow:hidden;flex:1;max-width:90px;}
    .sxpop-bar i{display:block;height:100%;border-radius:4px;}
    .sxpop-addr{padding:9px 15px;font-size:11.5px;color:#64748b;font-weight:500;line-height:1.5;border-top:1px solid #f1f5f9;background:#fafcff;}
    .map-toolbar{display:flex;gap:10px;margin-bottom:10px;flex-wrap:wrap;}
    .map-searchwrap{flex:1;min-width:200px;position:relative;}
    .map-search{display:flex;align-items:center;gap:9px;background:#fff;border:1.5px solid var(--border);border-radius:11px;padding:0 13px;}
    .map-search:focus-within{border-color:var(--s-blue);}
    .map-search svg{width:16px;height:16px;color:var(--muted2);flex-shrink:0;}
    .map-search input{flex:1;border:none;outline:none;padding:11px 0;font-family:inherit;font-size:13.5px;font-weight:400;background:transparent;color:var(--text);}
    .map-spin{width:15px;height:15px;border:2px solid var(--border);border-top-color:var(--s-blue);border-radius:50%;display:none;flex-shrink:0;animation:spin .7s linear infinite;}
    .map-spin.on{display:block;}
    @keyframes spin{to{transform:rotate(360deg);}}
    .ac-list{position:absolute;top:calc(100% + 6px);left:0;right:0;background:#fff;border:1px solid var(--border);border-radius:13px;box-shadow:0 14px 40px rgba(13,27,62,.16);z-index:1200;overflow:hidden;display:none;max-height:300px;overflow-y:auto;}
    .ac-list.show{display:block;}
    .ac-item{display:flex;align-items:flex-start;gap:10px;padding:11px 14px;cursor:pointer;border-bottom:1px solid #f1f5fb;transition:background .12s;}
    .ac-item:last-child{border-bottom:none;}
    .ac-item:hover,.ac-item.active{background:#eff5ff;}
    .ac-item .pin{width:30px;height:30px;border-radius:8px;background:#e8f0ff;color:var(--s-blue);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .ac-item .pin svg{width:15px;height:15px;}
    .ac-item .txt{min-width:0;}
    .ac-item .ttl{font-size:13.5px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .ac-item .sub{font-size:11.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px;}
    .ac-empty{padding:14px;font-size:12.5px;color:var(--muted);text-align:center;}
    .map-gps{display:inline-flex;align-items:center;gap:7px;background:#fff;border:1.5px solid var(--border);border-radius:11px;padding:0 15px;font-family:inherit;font-size:13px;font-weight:600;color:var(--s-blue);cursor:pointer;transition:.15s;white-space:nowrap;}
    .map-gps:hover{background:#eff5ff;border-color:var(--s-blue);}
    .map-gps svg{width:16px;height:16px;}
    @media(max-width:560px){ .map-gps span{display:none;} .map-gps{padding:0 12px;} }

    .sxmodal{position:fixed;inset:0;width:100vw;height:100vh;background:rgba(13,27,62,.5);display:none;z-index:99999;align-items:center;justify-content:center;padding:24px 16px;overflow-y:auto;backdrop-filter:blur(3px);}
    .sxmodal.show{display:flex;}
    .sxmodal-box{background:#fff;border-radius:20px;width:100%;max-width:560px;max-height:90vh;overflow-y:auto;padding:26px;animation:fade .2s ease;box-shadow:0 24px 60px rgba(13,27,62,.28);margin:auto;}
    .sxmodal-h{font-size:18px;font-weight:800;letter-spacing:-.3px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;}
    .sxmodal-h .x{cursor:pointer;color:var(--muted);font-size:26px;line-height:1;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:9px;transition:.15s;}
    .sxmodal-h .x:hover{background:#f1f5f9;color:var(--text);}
    .msec-title{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin:18px 0 12px;padding-bottom:7px;border-bottom:1px solid var(--border);}
    .msec-title:first-of-type{margin-top:0;}
    /* Upload boxes */
    .upbox{border:1.5px dashed var(--border);border-radius:13px;background:#f8fafc;cursor:pointer;overflow:hidden;transition:.15s;min-height:96px;display:flex;align-items:center;justify-content:center;position:relative;}
    .upbox:hover{border-color:var(--blue);background:#f0f6ff;}
    .upbox.filled{border-style:solid;border-color:var(--blue);}
    .up-inner{display:flex;flex-direction:column;align-items:center;gap:7px;color:var(--muted);font-size:12.5px;font-weight:600;padding:14px;}
    .up-inner svg{width:26px;height:26px;}
    .upbox img{width:100%;height:96px;object-fit:cover;display:block;}
    .up-badge{position:absolute;top:6px;right:6px;background:var(--green);color:#fff;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:13px;}
    .ph-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:6px;}
    .ph-thumb{border:1px solid var(--border);border-radius:11px;overflow:hidden;background:#f8fafc;}
    .ph-thumb img{width:100%;height:90px;object-fit:cover;display:block;cursor:pointer;}
    .ph-thumb .cap{font-size:11px;color:var(--muted);font-weight:600;text-align:center;padding:5px;}
    .ph-empty{border:1.5px dashed var(--border);border-radius:11px;height:120px;display:flex;align-items:center;justify-content:center;color:var(--muted2);font-size:12px;font-weight:500;background:#f8fafc;cursor:pointer;flex-direction:column;gap:6px;}
    .ph-empty svg{width:24px;height:24px;}
    .dt-name{font-size:18px;font-weight:800;color:var(--text);letter-spacing:-.3px;}
    .dt-sub{font-size:13px;color:var(--muted);font-weight:500;margin-top:2px;}
    .dt-row{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid #f1f5fb;font-size:13.5px;}
    .dt-row:last-child{border-bottom:none;}
    .dt-k{color:var(--muted);font-weight:500;flex-shrink:0;}
    .dt-v{color:var(--text);font-weight:600;text-align:right;}

    /* Detail modal — header + hero (clean) */
    #detBox{ padding:0 !important; overflow:hidden !important; }
    .dt-head{ display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 22px;border-bottom:1px solid var(--border);background:linear-gradient(135deg,#f8faff,#eef4ff); }
    .dt-head-icn{ width:38px;height:38px;border-radius:11px;background:#eff6ff;display:flex;align-items:center;justify-content:center;color:var(--s-blue-d);flex-shrink:0; }
    .dt-head-ttl{ font-size:16px;font-weight:800;color:var(--text);letter-spacing:-.3px; }
    .dt-head-sub{ font-size:12px;color:var(--muted);font-family:'DM Mono',ui-monospace,monospace;margin-top:1px; }
    .dt-close{ width:34px;height:34px;border-radius:10px;border:1px solid var(--border);background:#fff;color:var(--muted);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s;flex-shrink:0; }
    .dt-close:hover{ background:#fee2e2;border-color:#fecaca;color:#dc2626; }
    .dt-pad{ padding:20px 22px 22px; }
    .dt-hero{ background:linear-gradient(135deg,var(--s-blue-d),var(--s-blue3));border-radius:14px;padding:16px 18px;margin-bottom:6px; }
    .dt-hero-name{ font-size:18px;font-weight:800;color:#fff;letter-spacing:-.3px;line-height:1.2; }
    .dt-hero-sub{ font-size:12.5px;color:rgba(255,255,255,.8);font-weight:500;margin-top:2px; }
    .dt-hero .pill{ background:rgba(255,255,255,.22)!important;color:#fff!important; }
    #custDetModal .sxmodal-box.cust-box{ padding:0 !important; overflow:hidden !important; max-width:480px !important; }
    .cust-map-btn{ display:inline-flex;align-items:center;gap:7px;width:100%;justify-content:center;box-sizing:border-box;padding:11px;border-radius:11px;background:#eff6ff;border:1px solid #bfdbfe;color:var(--s-blue-d);font-size:13px;font-weight:700;text-decoration:none;transition:background .15s; }
    .cust-map-btn:hover{ background:#dbeafe; }
    .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);padding:13px 22px;border-radius:13px;font-size:13.5px;font-weight:600;z-index:10000;display:none;box-shadow:0 10px 34px rgba(0,0,0,.2);}
    .toast.ok{background:var(--s-green);color:#fff;} .toast.err{background:var(--s-red);color:#fff;}
    .empty{text-align:center;color:var(--muted);padding:38px;font-size:13.5px;font-weight:500;}

    @media(max-width:1100px){ .stat-grid{grid-template-columns:repeat(2,1fr);} .grid-2,.grid-2b{grid-template-columns:1fr;} }
    @media(max-width:768px){
      .fx-pills{display:flex;}
      .fx-hdr h1{font-size:21px;}
      /* Stat cards: 1 kolom penuh di mobile agar sparkline & teks tidak tabrakan */
      .stat-grid{grid-template-columns:1fr!important;gap:12px;}
      .scard{padding:16px 18px;}
      .scard .val{font-size:26px;} .scard .val.money{font-size:22px;}
      .scard .spark{width:72px;height:34px;top:14px;right:16px;}
      /* Grid 2-kolom → tumpuk */
      .grid-2,.grid-2b{grid-template-columns:1fr!important;}
      .rep-grid{grid-template-columns:1fr 1fr!important;}
      .rep-summary{grid-template-columns:1fr 1fr!important;}
      .mfilter{flex-wrap:wrap;}
      .mfilter select,.mfilter input{flex:1 1 auto;min-width:0;}
      /* Card header: judul + tombol menumpuk rapi */
      .card{padding:16px;border-radius:16px;}
      .card-h{flex-direction:column;align-items:stretch;gap:10px;margin-bottom:14px;}
      .card-h .btn,.card-h .btn-sm{width:100%;justify-content:center;}
      .card-h .mfilter{width:100%;}
      /* Tabel: bisa di-scroll horizontal, padding lebih rapat */
      table{font-size:12.5px;}
      th,td{padding:9px 10px!important;white-space:nowrap;}
      .heat-row{grid-template-columns:42px repeat(7,1fr);gap:4px;}
      /* Sub-tabs scrollable */
      .mtabs{margin-bottom:14px;-webkit-overflow-scrolling:touch;}
      .mtab{padding:9px 14px;font-size:13px;}
      /* Maps lebih pendek */
      .map{height:300px!important;}
      /* Modal: hampir full width */
      .sxmodal-box{width:calc(100vw - 24px)!important;max-width:none!important;max-height:88vh;overflow-y:auto;}
      .row{flex-direction:column;gap:0;}
      .legend{font-size:11px;flex-wrap:wrap;}
      #lbPodium{overflow-x:auto;}
    }
    @media(max-width:420px){
      .rep-grid,.rep-summary{grid-template-columns:1fr!important;}
      .fx-hdr h1{font-size:19px;}
      .scard .val{font-size:24px;}
    }

    /* ── Manajemen: sub-tabs ── */
    .mtabs{display:flex;gap:6px;background:#fff;border:1px solid var(--border);border-radius:14px;padding:6px;margin-bottom:16px;overflow-x:auto;}
    .mtab{flex:0 0 auto;border:none;background:transparent;color:var(--muted);font-family:var(--font);font-weight:600;font-size:13.5px;padding:9px 18px;border-radius:10px;cursor:pointer;white-space:nowrap;transition:background .2s ease,color .2s ease;}
    .mtab:hover{background:#f1f5fb;color:var(--text);}
    .mtab.on{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.25);}
    .mpanel{display:none;animation:fadeUp .4s cubic-bezier(.16,1,.3,1);}
    .mpanel.on{display:block;}

    /* ── Filter bar ── */
    .mfilter{display:flex;align-items:center;gap:8px;font-size:13px;}
    .mfilter select,.mfilter input{padding:8px 11px;border:1.5px solid var(--border);border-radius:10px;font-family:var(--font);font-size:13px;background:#fff;}
    .mfilter .muted{color:var(--muted);}
    .hsum{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;}
    .hsum .chip{background:#f1f5fb;border-radius:10px;padding:8px 14px;font-size:13px;font-weight:600;color:var(--text);}
    .hsum .chip b{color:var(--d-blue1,#1a6ef5);}

    /* ── Laporan ── */
    .rep-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px;}
    .rep-actions{display:flex;gap:8px;flex-wrap:wrap;}
    .rep-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;}
    .rep-stat{background:#fff;border:1px solid var(--border);border-radius:14px;padding:14px 16px;}
    .rep-stat .l{font-size:11.5px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.3px;}
    .rep-stat .v{font-size:20px;font-weight:800;margin-top:4px;}

    /* ── Print: hanya area laporan ── */
    @media print{
      body *{visibility:hidden!important;}
      #printArea,#printArea *{visibility:visible!important;}
      #printArea{position:absolute;left:0;top:0;width:100%;padding:0;}
      .no-print{display:none!important;}
      @page{margin:14mm;}
    }

    /* ── Detail Bukti Komisi Modal ── */
    .cpm-box{ max-width:840px !important; padding:0 !important; overflow:hidden !important; }
    .cpm-head{ display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 22px;border-bottom:1px solid var(--border);background:linear-gradient(135deg,#f8faff,#eef4ff); }
    .cpm-head-icn{ width:38px;height:38px;border-radius:11px;background:#eff6ff;display:flex;align-items:center;justify-content:center;color:var(--s-blue-d);flex-shrink:0; }
    .cpm-head-ttl{ font-size:16px;font-weight:800;color:var(--text);letter-spacing:-.3px; }
    .cpm-head-sub{ font-size:12px;color:var(--muted);font-family:'DM Mono',ui-monospace,monospace;margin-top:1px; }
    .cpm-close{ width:34px;height:34px;border-radius:10px;border:1px solid var(--border);background:#fff;color:var(--muted);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.15s;flex-shrink:0; }
    .cpm-close:hover{ background:#fee2e2;border-color:#fecaca;color:#dc2626; }
    .cpm-body{ display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);max-height:78vh;overflow:auto; }
    .cpm-img-col{ padding:20px;border-right:1px solid var(--border);display:flex;flex-direction:column; }
    .cpm-info-col{ padding:20px;display:flex;flex-direction:column; }
    .cpm-label{ font-size:10.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin-bottom:10px; }
    .cpm-img-frame{ flex:1;min-height:240px;max-height:56vh;border-radius:14px;border:1px solid var(--border);background:#f4f8ff;overflow:auto;display:flex;align-items:center;justify-content:center; }
    .cpm-img-frame.is-empty{ background:#f8faff;border-style:dashed; }
    .cpm-img-frame img{ display:block;max-width:100%;height:auto; }
    .cpm-img-frame iframe{ width:100%;height:56vh;border:none; }
    .cpm-img-loading{ color:var(--muted2);font-size:13px;padding:40px; }
    .cpm-img-empty{ display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:36px 24px;gap:4px; }
    .cpm-img-empty-icn{ width:64px;height:64px;border-radius:18px;background:#eef2f9;color:var(--muted2);display:flex;align-items:center;justify-content:center;margin-bottom:10px; }
    .cpm-img-empty-ttl{ font-size:14px;font-weight:800;color:#475569; }
    .cpm-img-empty-sub{ font-size:12px;color:var(--muted2);line-height:1.5;max-width:240px; }
    .cpm-img-open{ margin-top:12px;display:inline-flex;align-items:center;justify-content:center;gap:6px;font-size:12px;font-weight:700;color:var(--s-blue-d);text-decoration:none;padding:9px;border-radius:10px;background:#eff6ff;border:1px solid #bfdbfe;transition:background .15s; }
    .cpm-img-open:hover{ background:#dbeafe; }
    .cpm-amt-card{ background:linear-gradient(135deg,var(--s-blue-d),var(--s-blue3));border-radius:14px;padding:16px 18px;margin-bottom:16px; }
    .cpm-amt-lbl{ font-size:11px;font-weight:600;color:rgba(255,255,255,.7);letter-spacing:.04em; }
    .cpm-amt-val{ font-size:27px;font-weight:800;color:#fff;letter-spacing:-1px;line-height:1.1;margin-top:3px;font-family:'DM Mono',ui-monospace,monospace; }
    .cpm-st{ display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:7px;font-size:11.5px;font-weight:700;background:rgba(255,255,255,.2);color:#fff; }
    .cpm-rows{ display:flex;flex-direction:column; }
    .cpm-row{ display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px dashed #eef2f9; }
    .cpm-row:last-child{ border-bottom:none; }
    .cpm-k{ font-size:12px;color:var(--muted);font-weight:600;flex-shrink:0; }
    .cpm-v{ font-size:12.5px;color:var(--text);font-weight:700;text-align:right;word-break:break-word; }
    @media(max-width:680px){
      .cpm-body{ grid-template-columns:1fr; }
      .cpm-img-col{ border-right:none;border-bottom:1px solid var(--border); }
    }

  /* ══════════ HAPUS REGISTRASI ══════════════════════════════════ */
  .reg-chk{width:16px;height:16px;cursor:pointer;accent-color:#2563eb;vertical-align:middle}
  .reg-chk:disabled{cursor:not-allowed;opacity:.35}

  /* Toolbar aksi massal — slide turun saat ada yang dipilih */
  .reg-bulkbar{display:none;align-items:center;gap:10px;padding:11px 16px;margin:0 0 2px;
    background:#eff6ff;border-top:1px solid #bfdbfe;border-bottom:1px solid #bfdbfe;
    font-size:13px;color:#1e40af;animation:regBarIn .26s cubic-bezier(.16,1,.3,1)}
  .reg-bulkbar.show{display:flex}
  .reg-bulkbar .cnt b{font-weight:800}
  @keyframes regBarIn{from{opacity:0;transform:translateY(-7px)}to{opacity:1;transform:none}}

  .reg-btn-del{background:#dc2626;border:1.5px solid #dc2626;color:#fff;display:inline-flex;align-items:center;gap:6px}
  .reg-btn-del:hover{background:#b91c1c;border-color:#b91c1c}

  /* Tombol hapus per baris — samar sampai baris di-hover, supaya tidak
     mendominasi dan tidak mudah terklik tak sengaja */
  .reg-btn-del-ico{width:32px;height:32px;padding:0;display:inline-flex;align-items:center;justify-content:center;
    border:1px solid #e8edf5;background:#fff;color:#94a3b8;border-radius:9px;cursor:pointer;
    transition:all .15s;opacity:.55}
  .reg-btn-del-ico svg{width:15px;height:15px}
  tr:hover .reg-btn-del-ico{opacity:1}
  .reg-btn-del-ico:hover{background:#fef2f2;border-color:#fecaca;color:#dc2626;transform:translateY(-1px);
    box-shadow:0 3px 8px rgba(220,38,38,.16)}

  /* ── Dialog konfirmasi ── */
  .regcf{position:fixed;inset:0;z-index:10000;display:flex;align-items:center;justify-content:center;padding:18px;
    opacity:0;pointer-events:none;transition:opacity .22s cubic-bezier(.4,0,.2,1)}
  .regcf.show{opacity:1;pointer-events:auto}
  .regcf-bd{position:absolute;inset:0;background:rgba(15,23,42,.6);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
  .regcf-cd{position:relative;background:#fff;border-radius:20px;width:100%;max-width:470px;
    box-shadow:0 24px 64px rgba(15,23,42,.28);overflow:hidden;
    transform:translateY(16px) scale(.94);opacity:0;
    transition:transform .32s cubic-bezier(.16,1,.3,1),opacity .24s ease}
  .regcf.show .regcf-cd{transform:none;opacity:1}
  .regcf-bdy{padding:30px 28px 22px;text-align:center}
  .regcf-ic{width:58px;height:58px;border-radius:50%;background:var(--rgc-l);display:flex;align-items:center;justify-content:center;
    margin:0 auto 18px;position:relative;transform:scale(.5);opacity:0;
    transition:transform .42s cubic-bezier(.34,1.56,.64,1) .06s,opacity .3s ease .06s}
  .regcf.show .regcf-ic{transform:none;opacity:1}
  .regcf-ic svg{width:27px;height:27px;stroke:var(--rgc);fill:none}
  .regcf-ic::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:2px solid var(--rgc);opacity:0}
  .regcf.show .regcf-ic::after{animation:regRing .9s cubic-bezier(.4,0,.2,1) .22s}
  @keyframes regRing{0%{transform:scale(.85);opacity:.5}100%{transform:scale(1.25);opacity:0}}
  .regcf-ti{font-size:18px;font-weight:800;color:#0f172a;margin:0 0 9px;letter-spacing:-.01em;
    transform:translateY(8px);opacity:0;transition:transform .34s cubic-bezier(.16,1,.3,1) .1s,opacity .3s ease .1s}
  .regcf.show .regcf-ti{transform:none;opacity:1}
  .regcf-ms{font-size:13.5px;line-height:1.65;color:#64748b;margin:0;
    transform:translateY(8px);opacity:0;transition:transform .34s cubic-bezier(.16,1,.3,1) .14s,opacity .3s ease .14s}
  .regcf.show .regcf-ms{transform:none;opacity:1}
  .regcf-ms b{color:#334155;font-weight:800}
  .regcf-nt{margin-top:15px;padding:12px 14px;border-radius:11px;background:var(--rgc-l);border:1px solid var(--rgc-b);
    font-size:12.5px;line-height:1.6;color:var(--rgc-t);text-align:left;
    transform:translateY(8px);opacity:0;transition:transform .34s cubic-bezier(.16,1,.3,1) .18s,opacity .3s ease .18s}
  .regcf.show .regcf-nt{transform:none;opacity:1}
  .regcf-nt b{font-weight:800}
  .regcf-in{width:100%;margin-top:14px;padding:11px 14px;border:1.5px solid #e2e8f0;border-radius:11px;
    font-size:13px;font-family:inherit;color:#0f172a;resize:vertical;
    transform:translateY(8px);opacity:0;
    transition:transform .34s cubic-bezier(.16,1,.3,1) .18s,opacity .3s ease .18s,border-color .18s,box-shadow .18s}
  .regcf.show .regcf-in{transform:none;opacity:1}
  .regcf-in:focus{outline:none;border-color:var(--rgc);box-shadow:0 0 0 3.5px var(--rgc-l)}
  .regcf-ft{display:flex;gap:10px;padding:8px 28px 26px;
    transform:translateY(8px);opacity:0;transition:transform .34s cubic-bezier(.16,1,.3,1) .22s,opacity .3s ease .22s}
  .regcf.show .regcf-ft{transform:none;opacity:1}
  .regcf-b{flex:1;padding:12px 18px;border-radius:12px;font-size:13.5px;font-weight:700;cursor:pointer;
    border:1.5px solid;font-family:inherit;transition:transform .14s,box-shadow .18s,background .16s}
  .regcf-b:active{transform:scale(.975)}
  .regcf-b.c{background:#fff;border-color:#e2e8f0;color:#475569}
  .regcf-b.c:hover{background:#f8fafc;border-color:#cbd5e1}
  .regcf-b.k{background:var(--rgc);border-color:var(--rgc);color:#fff;box-shadow:0 2px 10px var(--rgc-s)}
  .regcf-b.k:hover{filter:brightness(.93);box-shadow:0 4px 16px var(--rgc-s)}
  .regcf.danger{--rgc:#dc2626;--rgc-l:#fef2f2;--rgc-b:#fecaca;--rgc-t:#991b1b;--rgc-s:rgba(220,38,38,.32)}
  .regcf.warn{--rgc:#d97706;--rgc-l:#fffbeb;--rgc-b:#fde68a;--rgc-t:#92400e;--rgc-s:rgba(217,119,6,.32)}
  .regcf.info{--rgc:#2563eb;--rgc-l:#eff6ff;--rgc-b:#bfdbfe;--rgc-t:#1e40af;--rgc-s:rgba(37,99,235,.32)}
  @media(max-width:520px){.regcf-ft{flex-direction:column-reverse}.regcf-bdy{padding:26px 22px 18px}}
  @media(prefers-reduced-motion:reduce){
    .regcf,.regcf-cd,.regcf-ic,.regcf-ti,.regcf-ms,.regcf-nt,.regcf-in,.regcf-ft{transition-duration:.01ms!important}
    .regcf.show .regcf-ic::after{animation:none}
    .reg-bulkbar{animation:none}
  }

  </style>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content fx">

      <div class="fx-hdr">
        <div>
          <h1 id="fxTitle">Sales Dashboard <span style="font-size:22px"></span></h1>
          <p id="fxSub">Ringkasan performa akuisisi pelanggan Anda</p>
        </div>
        <div class="fx-hdr-r">
          <button class="btn btn-blue" onclick="openRegModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Registrasi Baru</button>
          <button class="icon-btn" onclick="refreshAll()" title="Refresh"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg></button>
        </div>
      </div>

      <div class="fx-pills" id="fxPills">
        <button class="fx-pill on" data-go="overview" onclick="goSection('overview')">Dashboard</button>
        <button class="fx-pill" data-go="pipeline" onclick="goSection('pipeline')">Pipeline</button>
        <button class="fx-pill" data-go="customers" onclick="goSection('customers')">Customer</button>
        <button class="fx-pill" data-go="coverage" onclick="goSection('coverage')">Coverage</button>
        <button class="fx-pill" data-go="potential" onclick="goSection('potential')">Area Potensi</button>
        <button class="fx-pill" data-go="referral" onclick="goSection('referral')">Referral</button>
        <button class="fx-pill" data-go="kpi" onclick="goSection('kpi')">Target & KPI</button>
        <button class="fx-pill" data-go="commission" onclick="goSection('commission')">Komisi</button>
        <button class="fx-pill" data-go="leaderboard" onclick="goSection('leaderboard')">Leaderboard</button>
        <button class="fx-pill" data-go="analytics" onclick="goSection('analytics')">Analytics</button>
        <button class="fx-pill" data-go="manage" onclick="goSection('manage')" id="pillManage" style="display:none">Manajemen</button>
      </div>

      <!-- ════════════════ OVERVIEW ════════════════ -->
      <section class="fx-section on" data-section="overview">

        <!-- Stat band (gaya admin: blue gradient summary-cards) -->
        <div class="summary-cards">
          <div class="summary-card">
            <div class="sc-label">Komisi<br>Earned</div>
            <div class="sc-value mono" id="stComm">–</div>
            <div class="sc-sub" id="dComm">Siap dibayar</div>
          </div>
          <div class="summary-card">
            <div class="sc-label">Leads<br>Baru</div>
            <div class="sc-value" id="stLeads">0</div>
            <div class="sc-sub">Menunggu diproses</div>
          </div>
          <div class="summary-card">
            <div class="sc-label">Proses<br>Survey</div>
            <div class="sc-value" id="stSurvey">0</div>
            <div class="sc-sub">Survey berlangsung</div>
          </div>
          <div class="summary-card">
            <div class="sc-label">Aktif<br>Bulan Ini</div>
            <div class="sc-value" id="stAct">0</div>
            <div class="sc-sub" id="dAct">Pelanggan baru</div>
          </div>
          <div class="summary-card">
            <div class="sc-label">Total<br>Pelanggan</div>
            <div class="sc-value" id="stTotal">0</div>
            <div class="sc-sub">Akumulasi aktivasi</div>
          </div>
        </div>

        <!-- Coverage map (marker ODP biru) -->
        <div class="card">
          <div class="card-h">
            <div class="t">Area Coverage<small>Sebaran ODP/ODC/POP dari data infrastruktur</small></div>
            <div class="legend">
              <span><i class="dot" style="background:#2563eb"></i>ODP/ODC</span>
              <span><i class="dot" style="background:#0891b2"></i>POP/Tower</span>
              <span><i class="ring"></i>Radius 250m</span>
            </div>
          </div>
          <div class="map-toolbar">
            <div class="map-searchwrap">
              <div class="map-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                <input id="coverageSearch" autocomplete="off" placeholder="Cari alamat / tempat..."
                  oninput="suggest('coverage')" onkeydown="acKey(event,'coverage')">
                <span class="map-spin" id="spin_coverage"></span>
              </div>
              <div class="ac-list" id="ac_coverage"></div>
            </div>
            <button class="map-gps" onclick="locateOn('coverage')" title="Lokasi saya"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg><span>Lokasi Saya</span></button>
          </div>
          <div class="map" id="coverageMap" style="height:460px"></div>
          <div id="coverageMeta" style="font-size:12.5px;color:var(--muted);margin-top:10px;font-weight:500"></div>
        </div>

        <!-- Bar chart + heatmap -->
        <div class="grid-2">
          <div class="card">
            <div class="card-h">
              <div class="t">Registrasi & Aktivasi<small>7 hari terakhir</small></div>
              <div class="legend">
                <span><i class="dot" style="background:#93c5fd"></i>Registrasi</span>
                <span><i class="dot" style="background:#2563eb"></i>Aktivasi</span>
              </div>
            </div>
            <div class="chart-wrap" id="barChart"><div class="empty">Memuat...</div></div>
          </div>
          <div class="card">
            <div class="card-h"><div class="t">Aktivitas Registrasi<small>Kapan lead paling banyak masuk</small></div></div>
            <div id="heatmap"><div class="empty">Memuat...</div></div>
          </div>
        </div>

        <!-- Donut + recent + CTA -->
        <div class="grid-2b">
          <div class="card">
            <div class="card-h"><div class="t">Status Pipeline</div></div>
            <div class="gauge-wrap">
              <div id="donut"><div class="empty">Memuat...</div></div>
              <div class="gauge-legend" id="donutLegend"></div>
            </div>
          </div>
          <div>
            <div class="cta" id="ctaCard" style="display:none">
              <h3>Link Registrasi Anda</h3>
              <p>Bagikan ke calon pelanggan. Setiap aktivasi = komisi untuk Anda.</p>
              <div class="cta-link">
                <input type="text" id="refLink" readonly>
                <button class="cta-btn" onclick="copyLink()">Salin</button>
                <button class="cta-btn wa" onclick="shareWA()">WA</button>
              </div>
            </div>
            <div class="card" style="margin-top:16px;margin-bottom:0">
              <div class="card-h"><div class="t">Registrasi Terbaru</div><a class="link" onclick="goSection('pipeline')">Lihat semua →</a></div>
              <div style="overflow-x:auto"><table>
                <thead class="thead-soft"><tr><th>No. Reg</th><th>Pelanggan</th><th>Status</th><th>Tanggal</th></tr></thead>
                <tbody id="recentBody"><tr><td colspan="4" class="empty">Memuat...</td></tr></tbody>
              </table></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ════════════════ PIPELINE ════════════════ -->
      <section class="fx-section" data-section="pipeline">
        <div class="card">
          <div class="card-h">
            <div class="t">Pipeline Registrasi & Work Order</div>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
              <button id="btnRegTrash" class="btn btn-outline btn-sm" onclick="openRegTrash()" style="display:none">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                Trash
              </button>
              <select id="fltStatus" class="btn btn-outline" onchange="loadRegs()" style="padding:9px 12px">
                <option value="">Semua Status</option>
                <option value="lead">Lead</option><option value="survey_request">Survey Request</option>
                <option value="surveyed">Surveyed</option><option value="approved">Approved</option>
                <option value="installing">Installing</option><option value="activated">Activated</option>
                <option value="survey_rejected">Survey Ditolak</option>
              </select>
            </div>
          </div>

          <!-- Toolbar aksi massal — muncul hanya saat ada baris terpilih -->
          <div id="regBulkBar" class="reg-bulkbar">
            <span class="cnt"><b id="regSelCount">0</b> registrasi dipilih</span>
            <div style="flex:1"></div>
            <button class="btn btn-outline btn-sm" onclick="clearRegSelection()">Batal Pilih</button>
            <button class="btn btn-sm reg-btn-del" onclick="bulkDeleteRegs()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
              Hapus Terpilih
            </button>
          </div>

          <div style="overflow-x:auto"><table>
            <thead class="thead-soft"><tr>
              <th style="width:38px;text-align:center"><input type="checkbox" id="regCheckAll" onchange="toggleAllRegs(this)" class="reg-chk"></th>
              <th>No. Reg</th><th>Pelanggan</th><th>Paket</th><th>Coverage</th><th>Status</th><th>Tanggal</th><th></th>
            </tr></thead>
            <tbody id="regBody"><tr><td colspan="8" class="empty">Memuat...</td></tr></tbody>
          </table></div>
        </div>
      </section>

      <!-- ════════════════ DAFTAR CUSTOMER ════════════════ -->
      <section class="fx-section" data-section="customers">
        <div class="stat-grid" id="custStatCards" style="grid-template-columns:repeat(3,1fr)">
          <div class="scard clickable active" data-cf="all" onclick="pickCustFilter(this,'all')">
            <div class="top"><span class="lbl">Total Customer <span class="sub">/ semua</span></span></div>
            <div class="spark" id="spkCustTotal"></div>
            <div class="val" id="custTotal">–</div>
            <div class="delta flat" id="dCustTotal"><span class="dot-ic"></span><span class="lab">pelanggan aktif</span></div>
          </div>
          <div class="scard clickable" data-cf="new" onclick="pickCustFilter(this,'new')">
            <div class="top"><span class="lbl">New Customer <span class="sub">/ bulan ini</span></span></div>
            <div class="spark" id="spkCustNew"></div>
            <div class="val" id="custNew">–</div>
            <div class="delta flat" id="dCustNew"><span class="dot-ic"></span><span class="lab">aktivasi bulan ini</span></div>
          </div>
          <div class="scard clickable" data-cf="active" onclick="pickCustFilter(this,'active')">
            <div class="top"><span class="lbl">Status Aktif <span class="sub">/ layanan</span></span></div>
            <div class="spark" id="spkCustActive"></div>
            <div class="val" id="custActive">–</div>
            <div class="delta flat" id="dCustActive"><span class="dot-ic"></span><span class="lab">layanan berjalan</span></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h"><div class="t">Daftar Customer<small>Pelanggan yang berhasil didaftarkan & diaktivasi</small></div>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
              <input type="text" id="custSearch" placeholder="Cari nama / telp / alamat..." oninput="filterCustomers()" style="padding:9px 12px;border:1.5px solid var(--border);border-radius:10px;font-size:13px;min-width:200px">
              <button class="btn btn-blue btn-sm" onclick="openRegModal()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" style="width:14px;height:14px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> New Customer</button>
            </div>
          </div>
          <div style="overflow-x:auto"><table>
            <thead class="thead-soft"><tr><th>Customer</th><th>Kontak</th><th>Paket</th><th>Alamat / Area</th><th>Status</th><th>Tgl Aktivasi</th><th></th></tr></thead>
            <tbody id="custBody"><tr><td colspan="7" class="empty">Memuat...</td></tr></tbody>
          </table></div>
        </div>
      </section>

      <!-- ════════════════ COVERAGE ════════════════ -->
      <section class="fx-section" data-section="coverage">
        <div class="card">
          <div class="card-h"><div class="t">Coverage Checker<small>Cek ketersediaan jaringan di titik pelanggan</small></div>
            <div class="legend"><span><i class="dot" style="background:#2563eb"></i>ODP/ODC</span><span><i class="dot" style="background:#0891b2"></i>POP/Tower</span><span><i class="ring"></i>Radius 250m</span><span><i class="dot" style="background:#f5365c"></i>Titik dicek</span></div>
          </div>
          <div class="row" style="margin-bottom:12px">
            <div class="field" style="margin-bottom:0"><label>Latitude</label><input id="covLat" placeholder="-6.20" inputmode="decimal"></div>
            <div class="field" style="margin-bottom:0"><label>Longitude</label><input id="covLng" placeholder="106.81" inputmode="decimal"></div>
            <div style="display:flex;align-items:flex-end"><button class="btn btn-blue" onclick="runCov()">Cek Coverage</button></div>
          </div>
          <div class="map-toolbar">
            <div class="map-searchwrap">
              <div class="map-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                <input id="covSearch" autocomplete="off" placeholder="Cari alamat / tempat..."
                  oninput="suggest('cov')" onkeydown="acKey(event,'cov')">
                <span class="map-spin" id="spin_cov"></span>
              </div>
              <div class="ac-list" id="ac_cov"></div>
            </div>
            <button class="map-gps" onclick="locateOn('cov')" title="Lokasi saya"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg><span>Lokasi Saya</span></button>
          </div>
          <div class="map" id="covMap"></div>
          <div class="cov-res" id="covRes"></div>
          <div id="covDetail" style="margin-top:14px;overflow-x:auto"></div>
        </div>
      </section>

      <!-- ════════════════ COMMISSION ════════════════ -->
      <section class="fx-section" data-section="commission">
        <div class="card">
          <div class="card-h"><div class="t">Riwayat Komisi</div>
            <button class="btn btn-green btn-sm" id="payBulkBtn" onclick="payBulk()" style="display:none">Bayar Terpilih</button>
          </div>
          <div style="overflow-x:auto"><table>
            <thead class="thead-soft"><tr><th id="thChk" style="width:30px"></th><th>Sales</th><th>Registrasi</th><th>Skema</th><th>Nominal</th><th>Status</th><th>Tanggal</th><th id="thAct"></th></tr></thead>
            <tbody id="commBody"><tr><td colspan="8" class="empty">Memuat...</td></tr></tbody>
          </table></div>
        </div>
      </section>

      <!-- ════════════════ AREA POTENSI ════════════════ -->
      <section class="fx-section" data-section="potential">
        <div class="stat-grid" id="apStatCards" style="grid-template-columns:repeat(3,1fr)">
          <div class="scard clickable active" data-apf="all" onclick="pickApFilter(this,'all')"><div class="top"><span class="lbl">Total Lead Berkoordinat</span></div><div class="val" id="apTotal">–</div><div class="delta flat"><span class="dot-ic"></span><span class="lab">punya titik lokasi</span></div></div>
          <div class="scard clickable" data-apf="uncovered" onclick="pickApFilter(this,'uncovered')"><div class="top"><span class="lbl">Belum Ter-cover ODP</span></div><div class="val" id="apUncov">–</div><div class="delta flat"><span class="dot-ic"></span><span class="lab">peluang ekspansi</span></div></div>
          <div class="scard clickable" data-apf="hotspot" onclick="pickApFilter(this,'hotspot')"><div class="top"><span class="lbl">Hotspot Area</span></div><div class="val" id="apHot">–</div><div class="delta flat"><span class="dot-ic"></span><span class="lab">cluster ≥2 lead</span></div></div>
        </div>
        <div class="card">
          <div class="card-h"><div class="t">Peta Area Potensi<small>Lingkaran = cluster calon pelanggan tanpa ODP terdekat. Makin besar & merah = makin banyak permintaan, kandidat ODP baru.</small></div>
            <div class="legend"><span><i class="dot" style="background:#f5365c"></i>Belum ter-cover</span><span><i class="dot" style="background:#16a34a"></i>Ter-cover</span><span><i class="dot" style="background:#2563eb"></i>ODP</span><span><i class="ring"></i>Radius 250m</span></div>
          </div>
          <div class="map" id="potentialMap" style="height:500px"></div>
          <div id="potentialMeta" style="font-size:12.5px;color:var(--muted);margin-top:10px;font-weight:500"></div>
        </div>
        <div class="card">
          <div class="card-h"><div class="t">Hotspot Teratas<small>Area dengan calon pelanggan terbanyak yang belum terjangkau</small></div></div>
          <div style="overflow-x:auto"><table>
            <thead class="thead-soft"><tr><th>#</th><th>Titik Tengah (lat, lng)</th><th>Jumlah Lead</th><th>Rata-rata Jarak ke ODP</th><th></th></tr></thead>
            <tbody id="hotspotBody"><tr><td colspan="5" class="empty">Memuat...</td></tr></tbody>
          </table></div>
        </div>
      </section>

      <!-- ════════════════ REFERRAL ════════════════ -->
      <section class="fx-section" data-section="referral">
        <div class="cta" id="ctaCardR" style="display:none;margin-bottom:16px">
          <h3>Link Registrasi Anda</h3>
          <p>Bagikan ke calon pelanggan. Setiap aktivasi dari link ini = komisi untuk Anda.</p>
          <div class="cta-link">
            <input type="text" id="refLinkR" readonly>
            <button class="cta-btn" onclick="copyLinkR()">Salin</button>
            <button class="cta-btn wa" onclick="shareWAR()">WA</button>
          </div>
        </div>
        <div class="stat-grid" style="grid-template-columns:repeat(3,1fr)">
          <div class="scard"><div class="top"><span class="lbl">Total Registrasi via Link</span></div><div class="val" id="refTotal">–</div><div class="delta flat"><span class="lab">dari referral Anda</span></div></div>
          <div class="scard"><div class="top"><span class="lbl">Teraktivasi</span></div><div class="val" id="refAct">–</div><div class="delta flat"><span class="lab">jadi pelanggan</span></div></div>
          <div class="scard"><div class="top"><span class="lbl">Konversi</span></div><div class="val" id="refConv">–</div><div class="delta flat"><span class="lab">registrasi → aktif</span></div></div>
        </div>
        <div class="card" id="refQrCard" style="display:none">
          <div class="card-h"><div class="t">QR Code<small>Scan untuk membuka form pendaftaran</small></div></div>
          <div style="display:flex;justify-content:center;padding:10px"><img id="refQr" alt="QR" style="width:200px;height:200px;border-radius:12px;border:1px solid var(--border)"></div>
        </div>

        <!-- Daftar link referral semua sales + statistik -->
        <div class="card" id="refLinksCard">
          <div class="card-h"><div class="t" id="refLinksTitle">Link Referral Sales<small>Link tiap sales & jumlah pendaftar dari masing-masing link</small></div></div>
          <div style="overflow-x:auto"><table>
            <thead class="thead-soft"><tr><th>Sales</th><th>Link Referral</th><th>Pendaftar</th><th>Bulan Ini</th><th>Teraktivasi</th><th>Konversi</th><th></th></tr></thead>
            <tbody id="refLinksBody"><tr><td colspan="7" class="empty">Memuat...</td></tr></tbody>
          </table></div>
        </div>
      </section>

      <!-- ════════════════ TARGET & KPI ════════════════ -->
      <section class="fx-section" data-section="kpi">
        <div class="kpi-top">
          <div class="card kpi-gauge-wrap">
            <div class="card-h"><div class="t">Target Bulan Ini<small>Progress aktivasi menuju target</small></div></div>
            <div id="kpiGauge" style="min-height:240px"><div class="empty">Memuat...</div></div>
            <div id="kpiGaugeInfo" class="kpi-gauge-sub"></div>
          </div>
          <div class="kpi-stats">
            <div class="scard"><div class="top"><span class="lbl">Capaian <span class="sub">/ aktivasi</span></span></div><div class="val" id="kAch">–</div><div class="delta flat" id="dAch"><span class="dot-ic"></span><span class="lab">aktivasi bulan ini</span></div></div>
            <div class="scard"><div class="top"><span class="lbl">Sisa Target</span></div><div class="val" id="kRem">–</div><div class="delta flat" id="dRem"><span class="dot-ic"></span><span class="lab">menuju target</span></div></div>
            <div class="scard"><div class="top"><span class="lbl">Lead Bulan Ini</span></div><div class="val" id="kLead">–</div><div class="delta flat" id="dLead"><span class="dot-ic"></span><span class="lab">registrasi masuk</span></div></div>
            <div class="scard"><div class="top"><span class="lbl">Konversi</span></div><div class="val" id="kConv">–</div><div class="delta flat" id="dConv"><span class="dot-ic"></span><span class="lab">lead → aktif</span></div></div>
            <div class="scard kpi-bonus-cell" id="bonusCard" style="display:none;grid-column:1 / -1">
              <div class="bonus-band" id="bonusBand" style="margin:0;background:transparent;border:none;padding:0">
                <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="8" r="6"/><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/></svg></div>
                <div class="tx" id="bonusInfo"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-h"><div class="t">Tren Aktivasi 6 Bulan<small>Jumlah pelanggan teraktivasi per bulan</small></div></div>
          <div id="kpiTrend" style="min-height:300px"><div class="empty">Memuat...</div></div>
        </div>
      </section>

      <!-- ════════════════ LEADERBOARD ════════════════ -->
      <section class="fx-section" data-section="leaderboard">
        <div class="card">
          <div class="card-h"><div class="t">Leaderboard Sales<small>Peringkat berdasarkan jumlah aktivasi pelanggan</small></div></div>
          <div id="lbPodium" style="margin-bottom:8px"></div>
          <div style="overflow-x:auto"><table>
            <thead class="thead-soft"><tr><th>#</th><th>Sales</th><th>Aktivasi</th><th>Komisi Earned</th><th>Progres</th></tr></thead>
            <tbody id="lbBody"><tr><td colspan="5" class="empty">Memuat...</td></tr></tbody>
          </table></div>
        </div>
      </section>

      <!-- ════════════════ ANALYTICS ════════════════ -->
      <section class="fx-section" data-section="analytics">
        <div class="grid-2">
          <div class="card">
            <div class="card-h"><div class="t">Registrasi & Aktivasi<small>7 hari terakhir</small></div>
              <div class="legend"><span><i class="dot" style="background:#93c5fd"></i>Registrasi</span><span><i class="dot" style="background:#2563eb"></i>Aktivasi</span></div></div>
            <div class="chart-wrap" id="anBar"><div class="empty">Memuat...</div></div>
          </div>
          <div class="card">
            <div class="card-h"><div class="t">Status Pipeline</div></div>
            <div class="gauge-wrap"><div id="anDonut"><div class="empty">Memuat...</div></div><div class="gauge-legend" id="anDonutLegend"></div></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h"><div class="t">Aktivitas Registrasi<small>Kapan lead paling banyak masuk (hari × jam)</small></div></div>
          <div id="anHeat"><div class="empty">Memuat...</div></div>
        </div>

        <!-- Peta sebaran pelanggan (clustering + heatmap + ODP) -->
        <div class="card">
          <div class="card-h">
            <div class="t">Sebaran Pelanggan<small>Peta titik lokasi seluruh pelanggan</small></div>
            <span class="pill p-activated" id="anMapCount">0 titik</span>
          </div>
          <div class="map-layers" id="anMapLayers">
            <button type="button" class="ml-btn on" data-layer="cluster" onclick="toggleCustLayer('cluster',this)">
              <span class="ml-dot" style="background:#16a34a"></span>Titik Pelanggan
            </button>
            <button type="button" class="ml-btn" data-layer="heat" onclick="toggleCustLayer('heat',this)">
              <span class="ml-dot" style="background:linear-gradient(90deg,#3b82f6,#f59e0b,#ef4444)"></span>Heatmap Kepadatan
            </button>
            <button type="button" class="ml-btn" data-layer="odp" onclick="toggleCustLayer('odp',this)">
              <span class="ml-dot" style="background:#2563eb"></span>Titik ODP/ODC
            </button>
          </div>
          <div id="anCustMap" style="width:100%;height:420px;border-radius:14px;overflow:hidden;border:1px solid var(--border);z-index:0"></div>
          <div style="font-size:11.5px;color:var(--muted2);margin-top:8px;line-height:1.5">
            Aktifkan <b>Heatmap</b> untuk melihat area dengan permintaan tinggi (warna makin merah = makin padat). Aktifkan <b>ODP/ODC</b> untuk melihat jangkauan jaringan — pelanggan jauh dari lingkaran ODP = peluang ekspansi.
          </div>
        </div>

        <!-- Insight lokasi: area terbanyak / belum tercover / activated -->
        <div class="grid-2">
          <div class="card">
            <div class="card-h"><div class="t">Area Pemasangan Terbanyak<small>Berdasarkan alamat registrasi</small></div></div>
            <div id="anTopAreas"><div class="empty">Memuat...</div></div>
          </div>
          <div class="card">
            <div class="card-h"><div class="t">Belum Tercover <small>Permintaan di luar jangkauan ODP</small></div>
              <span class="pill p-cancelled" id="anUncovCount">0</span></div>
            <div style="max-height:340px;overflow-y:auto"><table class="an-list">
              <thead class="thead-soft"><tr><th>Pelanggan</th><th>Alamat</th><th></th></tr></thead>
              <tbody id="anUncovBody"><tr><td colspan="3" class="empty">Memuat...</td></tr></tbody>
            </table></div>
          </div>
        </div>
        <div class="card">
          <div class="card-h"><div class="t">Pelanggan Teraktivasi<small>Registrasi yang sudah jadi pelanggan aktif</small></div>
            <span class="pill p-activated" id="anActCount">0</span></div>
          <div style="max-height:360px;overflow-y:auto"><table class="an-list">
            <thead class="thead-soft"><tr><th>Pelanggan</th><th>Alamat</th><th>Tgl Aktivasi</th><th></th></tr></thead>
            <tbody id="anActBody"><tr><td colspan="4" class="empty">Memuat...</td></tr></tbody>
          </table></div>
        </div>
      </section>

      <!-- ════════════════ MANAJEMEN SALES (admin/owner) ════════════════ -->
      <section class="fx-section" data-section="manage">
        <!-- Ringkasan tim -->
        <div class="stat-grid" id="mStatCards" style="grid-template-columns:repeat(4,1fr)">
          <div class="scard clickable active" data-stat="team" onclick="pickStat(this,'team')">
            <div class="top"><span class="lbl">Total Sales <span class="sub">/ tim</span></span></div>
            <div class="spark" id="spkTeam"></div>
            <div class="val" id="mTeam">–</div>
            <div class="delta flat" id="dTeam"><span class="dot-ic"></span><span class="lab">akun aktif</span></div>
          </div>
          <div class="scard clickable" data-stat="team" onclick="pickStat(this,'team')">
            <div class="top"><span class="lbl">Aktivasi <span class="sub">/ semua</span></span></div>
            <div class="spark" id="spkAct"></div>
            <div class="val" id="mAct">–</div>
            <div class="delta flat" id="dAct"><span class="dot-ic"></span><span class="lab">pelanggan aktif</span></div>
          </div>
          <div class="scard clickable" data-stat="pay" onclick="pickStat(this,'pay')">
            <div class="top"><span class="lbl">Komisi Earned <span class="sub">/ pending</span></span></div>
            <div class="spark" id="spkEarned"></div>
            <div class="val money mono" id="mEarned">–</div>
            <div class="delta flat" id="dEarned"><span class="dot-ic"></span><span class="lab">belum dibayar</span></div>
          </div>
          <div class="scard clickable" data-stat="history" onclick="pickStat(this,'history')">
            <div class="top"><span class="lbl">Komisi Dibayar <span class="sub">/ total</span></span></div>
            <div class="spark" id="spkPaid"></div>
            <div class="val money mono" id="mPaid">–</div>
            <div class="delta flat" id="dPaid"><span class="dot-ic"></span><span class="lab">total payout</span></div>
          </div>
        </div>

        <!-- Sub-navigasi Manajemen -->
        <div class="mtabs" id="mTabs">
          <button class="mtab on" data-mtab="team" onclick="goManageTab('team')">Tim Sales</button>
          <button class="mtab" data-mtab="pay" onclick="goManageTab('pay')">Pembayaran</button>
          <button class="mtab" data-mtab="history" onclick="goManageTab('history')">Riwayat</button>
          <button class="mtab" data-mtab="report" onclick="goManageTab('report')">Laporan</button>
        </div>

        <!-- TIM SALES -->
        <div class="mpanel on" data-mpanel="team">
          <div class="card">
            <div class="card-h"><div class="t">Kinerja & Manajemen Sales<small>Pantau performa, atur target & skema komisi tiap sales</small></div>
              <button class="btn btn-blue btn-sm" onclick="openAddSales()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" style="width:14px;height:14px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Tambah Sales</button>
            </div>
            <div style="overflow-x:auto"><table>
              <thead class="thead-soft"><tr><th>#</th><th>Sales</th><th>Area</th><th>Kode Referral</th><th>Aktivasi</th><th>Komisi Earned</th><th>Komisi Dibayar</th><th>Target/bln</th><th></th></tr></thead>
              <tbody id="teamBody"><tr><td colspan="9" class="empty">Memuat...</td></tr></tbody>
            </table></div>
          </div>
        </div>

        <!-- PEMBAYARAN -->
        <div class="mpanel" data-mpanel="pay">
          <div class="card">
            <div class="card-h"><div class="t">Menunggu Persetujuan<small>Komisi earned — perlu disetujui sebelum dibayar</small></div>
              <button class="btn btn-blue btn-sm" id="mApproveBulkBtn" onclick="approveBulkManage()">Setujui Terpilih</button>
            </div>
            <div style="overflow-x:auto"><table>
              <thead class="thead-soft"><tr><th style="width:30px"><input type="checkbox" id="mApvCheckAll" onclick="toggleAllApv(this)"></th><th>Sales</th><th>Registrasi</th><th>Skema</th><th>Nominal</th><th>Tanggal Earned</th><th></th></tr></thead>
              <tbody id="mApvBody"><tr><td colspan="7" class="empty">Memuat...</td></tr></tbody>
            </table></div>
          </div>
          <div class="card">
            <div class="card-h"><div class="t">Siap Dibayar<small>Komisi sudah disetujui — siap dibayarkan</small></div>
              <button class="btn btn-green btn-sm" id="mPayBulkBtn" onclick="payBulkManage()">Bayar Terpilih</button>
            </div>
            <div style="overflow-x:auto"><table>
              <thead class="thead-soft"><tr><th style="width:30px"><input type="checkbox" id="mCheckAll" onclick="toggleAllComm(this)"></th><th>Sales</th><th>Registrasi</th><th>Nominal</th><th>Disetujui oleh</th><th>Tgl Setuju</th><th></th></tr></thead>
              <tbody id="mCommBody"><tr><td colspan="7" class="empty">Memuat...</td></tr></tbody>
            </table></div>
          </div>
        </div>

        <!-- RIWAYAT PEMBAYARAN -->
        <div class="mpanel" data-mpanel="history">
          <div class="card">
            <div class="card-h"><div class="t">Riwayat Pembayaran Komisi<small>Komisi yang sudah dibayarkan ke sales</small></div>
              <div class="mfilter">
                <select id="hSales" onchange="loadHistory()"><option value="">Semua Sales</option></select>
                <input type="date" id="hFrom" onchange="loadHistory()">
                <span class="muted">s/d</span>
                <input type="date" id="hTo" onchange="loadHistory()">
              </div>
            </div>
            <div class="hsum" id="hSummary"></div>
            <div style="overflow-x:auto"><table>
              <thead class="thead-soft"><tr><th>Tgl Bayar</th><th>Sales</th><th>Registrasi</th><th>Nominal</th><th>Metode</th><th>Dibayar oleh</th><th>Bukti</th><th>Tgl Earned</th></tr></thead>
              <tbody id="histBody"><tr><td colspan="6" class="empty">Memuat...</td></tr></tbody>
            </table></div>
          </div>
        </div>

        <!-- LAPORAN -->
        <div class="mpanel" data-mpanel="report">
          <div class="card report-config">
            <div class="card-h"><div class="t">Laporan Komisi<small>Buat & cetak laporan komisi sesuai kebutuhan</small></div></div>
            <div class="rep-grid">
              <div class="field"><label>Sales</label><select id="rpSales"><option value="">Semua Sales</option></select></div>
              <div class="field"><label>Status</label><select id="rpStatus"><option value="all">Semua</option><option value="earned">Earned (belum dibayar)</option><option value="paid">Sudah dibayar</option></select></div>
              <div class="field"><label>Dari Tanggal</label><input type="date" id="rpFrom"></div>
              <div class="field"><label>Sampai Tanggal</label><input type="date" id="rpTo"></div>
            </div>
            <div class="rep-actions">
              <button class="btn btn-blue btn-sm" onclick="generateReport()">Tampilkan Laporan</button>
              <button class="btn btn-outline btn-sm" onclick="printReport()" id="rpPrintBtn" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg> Print / PDF</button>
              <button class="btn btn-outline btn-sm" onclick="exportReportCSV()" id="rpCsvBtn" disabled>Export CSV</button>
            </div>
          </div>
          <div id="reportResult"></div>
        </div>
      </section>

    </main>
  </div>
</div>

