<div class="sxmodal" id="regModal">
  <div class="sxmodal-box reg-modal">
    <div class="sxmodal-h"><span>Registrasi Pelanggan Baru</span><span class="x" onclick="closeModal('regModal')">&times;</span></div>

    <div class="reg-sec"><span class="reg-sec-t">Data Pelanggan</span></div>
    <div class="row">
      <div class="field"><label>Nama <i>*</i></label><input id="rgName" placeholder="Nama lengkap"></div>
      <div class="field"><label>No. WhatsApp <i>*</i></label><input id="rgPhone" placeholder="08xxxxxxxxxx" inputmode="tel"></div>
    </div>
    <div class="row">
      <div class="field"><label>Email</label><input id="rgEmail" placeholder="email@contoh.com" inputmode="email"></div>
      <div class="field"><label>No. KTP</label><input id="rgKtp" placeholder="16 digit" inputmode="numeric"></div>
    </div>
    <div class="row">
      <div class="field"><label>Provinsi</label><select id="rgProv" onchange="onProvChange()"><option value="">— pilih provinsi —</option></select></div>
      <div class="field"><label>Kabupaten / Kota</label><select id="rgKab" onchange="onKabChange()" disabled><option value="">— pilih —</option></select></div>
    </div>
    <div class="row">
      <div class="field"><label>Kecamatan</label><select id="rgKec" onchange="onKecChange()" disabled><option value="">— pilih —</option></select></div>
      <div class="field"><label>Desa / Kelurahan</label><select id="rgDesa" onchange="onDesaChange()" disabled><option value="">— pilih —</option></select></div>
    </div>
    <div class="row">
      <div class="field"><label>Nama Jalan</label><input id="rgJalan" placeholder="Jl. ..." oninput="composeAddr()"></div>
      <div class="field"><label>No. Rumah</label><input id="rgNoRumah" placeholder="No." oninput="composeAddr()"></div>
    </div>
    <div class="row">
      <div class="field"><label>RT</label><input id="rgRt" placeholder="001" inputmode="numeric" oninput="composeAddr()"></div>
      <div class="field"><label>RW</label><input id="rgRw" placeholder="002" inputmode="numeric" oninput="composeAddr()"></div>
    </div>
    <div class="field"><label>Alamat Lengkap <i>*</i> <span style="font-weight:400;color:var(--muted2);font-size:11px">(otomatis tersusun, bisa diedit)</span></label><textarea id="rgAddr" placeholder="Alamat lengkap pemasangan"></textarea></div>

    <div class="reg-sec"><span class="reg-sec-t">Titik Lokasi</span><span class="reg-sec-hint">Isi koordinat / pilih di peta — alamat & coverage terisi otomatis</span></div>
    <div class="row">
      <div class="field"><label>Latitude</label><input id="rgLat" placeholder="-6.20" inputmode="decimal" oninput="onRegCoordInput()"></div>
      <div class="field"><label>Longitude</label><input id="rgLng" placeholder="106.81" inputmode="decimal" oninput="onRegCoordInput()"></div>
    </div>
    <div class="reg-loc-actions">
      <button type="button" class="btn btn-outline btn-sm" onclick="regUseMyLocation()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg> Lokasi Saya</button>
      <span class="reg-loc-hint" id="rgGeoHint">Klik / geser pin di peta untuk menentukan titik.</span>
    </div>
    <div id="rgMap" class="reg-map"></div>
    <div id="rgCoverage" class="reg-cov" style="display:none"></div>

    <div class="reg-sec"><span class="reg-sec-t">Paket & Catatan</span></div>
