// Set id registrasi yang sedang dipilih untuk aksi massal.
const _regSel = new Set();

/**
 * Tentukan apakah user boleh menghapus satu registrasi.
 * Mencerminkan aturan di backend (canDeleteRegistration) supaya tombol
 * yang pasti ditolak server tidak usah ditampilkan sejak awal.
 * Backend tetap memvalidasi ulang — ini murni demi UX.
 */
function canDeleteReg(r){
  if(IS_SUPERADMIN) return true;
  if(IS_ADMIN)      return r.status!=='activated';
  if(IS_SALES)      return !['installing','activated'].includes(r.status);
  return false;
}

