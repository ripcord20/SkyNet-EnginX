let _custData=[], _custFilter='all', _custShown=[];
async function loadCustomers(){
  const j=await api('/sales/customers');const tb=document.getElementById('custBody');if(!tb)return;
  if(!j.success){tb.innerHTML='<tr><td colspan="7" class="empty">Gagal memuat.</td></tr>';return;}
