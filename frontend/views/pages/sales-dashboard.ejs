let coverageMap, coverageLayer, coverageMeMarker;
async function loadCoverageMap(){
  if(!coverageMap){
    coverageMap=L.map('coverageMap',{scrollWheelZoom:true}).setView([-6.2,106.81],12);
    addBaseLayers(coverageMap);
    coverageLayer=L.layerGroup().addTo(coverageMap);
    ensureMapRendered(coverageMap);
  }
