<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %> - <%= appName %></title>
  <link rel="stylesheet" href="/css/mobile-shell.css?v=7">
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    :root{
      --bg:#eff8ff; --card:#ffffff; --ink:#1F3849; --muted:#7c93a0; --line:#e2eefb;
      --blue:#0ea5e9; --blue-deep:#0284c7; --blue-soft:#e0f2fe; --teal:#38bdf8; --teal-soft:#e0f2fe;
      --green:#38bdf8; --green-soft:#dcf7ec; --amber:#f5a623; --red:#f2545b; --nav-h:70px;
    }
    body{font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);
      padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 8px);-webkit-font-smoothing:antialiased;}
    .money{font-variant-numeric:tabular-nums;letter-spacing:-.3px;}
    .wrap{max-width:520px;margin:0 auto;}
    .head{padding:6px 20px 14px 20px;display:flex;align-items:center;justify-content:space-between;}
    .head .htitle{font-size:20px;font-weight:800;letter-spacing:-.3px;}
    .head .hsub{font-size:12.5px;color:#6b7a97;margin-top:2px;font-weight:500;}
    .content{padding:4px 16px 20px;}

    .hero{background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:22px;padding:19px 20px;color:#fff;box-shadow:0 14px 30px -14px rgba(47,111,237,.6);margin-bottom:14px;overflow:hidden;}
    .hero-lbl{font-size:12px;opacity:.82;font-weight:500;}
    .hero-val{font-size:28px;font-weight:800;letter-spacing:-1px;margin-top:4px;}
    /* bar chart mingguan */
    .bars{display:flex;align-items:flex-end;gap:7px;height:64px;margin-top:16px;}
    .bar-col{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px;height:100%;}
    .bar-track{flex:1;min-height:0;display:flex;align-items:flex-end;width:100%;justify-content:center;overflow:hidden;}
    .bar{width:70%;max-width:20px;min-width:8px;background:rgba(255,255,255,.35);border-radius:5px 5px 3px 3px;transition:height .5s;min-height:4px;max-height:44px;}
    .bar.hi{background:#fff;}
    /* Tren 30 hari */
    .trend-card{background:#fff;border:1px solid #eef1f6;border-radius:16px;padding:15px 16px;margin-bottom:14px;box-shadow:0 8px 20px -15px rgba(30,60,120,.26);}
    .tc-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;}
    .tc-title{font-size:12.5px;font-weight:800;color:#3a4a68;}
    .tc-range{display:flex;gap:4px;}
    .tc-range button{font-family:inherit;font-size:10.5px;font-weight:700;padding:4px 10px;border:none;border-radius:100px;background:#f1f5fb;color:#6b7a97;cursor:pointer;}
    .tc-range button.on{background:var(--blue);color:#fff;}
    .tc-sum{display:flex;gap:16px;margin-bottom:12px;}
    .tc-sum .tcs{font-size:10.5px;color:var(--muted);font-weight:600;}
    .tc-sum .tcs b{display:block;font-size:15px;color:#3a4a68;font-weight:800;letter-spacing:-.4px;margin-top:2px;font-variant-numeric:tabular-nums;}
    .trend-chart{width:100%;height:130px;display:block;overflow:visible;}
    .bar-lbl{font-size:8.5px;opacity:.75;flex-shrink:0;}

    .mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px;}
    .mini{background:#fff;border-radius:16px;padding:14px 15px;box-shadow:0 6px 16px -10px rgba(30,60,120,.14);}
    .mini-val{font-size:20px;font-weight:800;letter-spacing:-.4px;}
    .mini-lbl{font-size:11px;color:var(--muted);margin-top:3px;font-weight:500;}

    .sec{font-size:14px;font-weight:800;margin:4px 2px 12px;letter-spacing:-.2px;}
    .list{display:flex;flex-direction:column;gap:10px;}
    .tx{display:flex;align-items:center;gap:13px;background:#fff;border-radius:16px;padding:13px 15px;box-shadow:0 5px 14px -9px rgba(30,60,120,.14);}
    .tx-ic{width:42px;height:42px;border-radius:13px;background:var(--green-soft);color:var(--green);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;flex-shrink:0;}
    .tx-body{flex:1;min-width:0;}
    .tx-t{font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .tx-s{font-size:11.5px;color:var(--muted);margin-top:2px;}
    .tx-r{text-align:right;flex-shrink:0;}
    .tx-amt{font-size:14.5px;font-weight:800;color:var(--green);letter-spacing:-.3px;}
    .tx-mth{font-size:10px;color:var(--muted);margin-top:2px;}

    .empty{padding:36px 16px;text-align:center;color:var(--muted);font-size:13px;}
    .skel{background:linear-gradient(90deg,#e7edf6 25%,#f2f6fb 50%,#e7edf6 75%);background-size:200% 100%;animation:sh 1.3s infinite;border-radius:8px;}
    @keyframes sh{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
    .load-more{width:100%;padding:13px;margin-top:12px;border:none;background:#fff;border-radius:14px;font-size:13px;font-weight:700;color:var(--blue);cursor:pointer;font-family:inherit;box-shadow:0 5px 14px -9px rgba(30,60,120,.14);}

    .bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:300;background:#fff;border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);display:flex;box-shadow:0 -6px 22px rgba(30,60,120,.07);}
    .fab{position:fixed;z-index:305;bottom:calc(var(--nav-h,66px) + env(safe-area-inset-bottom) + 16px);right:calc(50% - (var(--shell-max,480px) / 2) + 18px);width:56px;height:56px;border-radius:18px;border:none;background:linear-gradient(135deg,#38bdf8,#0369a1);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 12px 26px -8px rgba(56,189,248,.6);cursor:pointer;transition:transform .12s;}
    .fab:active{transform:scale(.92);}
    .fab svg{width:26px;height:26px;}
    @media (max-width:519.98px){ .fab{right:18px;} }
    .tx{cursor:pointer;transition:transform .1s;}
    .tx:active{transform:scale(.98);}
    /* Detail pembayaran */
    .pd-overlay{position:fixed;inset:0;z-index:600;background:rgba(15,27,74,.5);opacity:0;visibility:hidden;transition:opacity .28s;}
    .pd-overlay.open{opacity:1;visibility:visible;}
    .pd-sheet{position:fixed;bottom:0;z-index:601;background:#f4f7fb;border-radius:26px 26px 0 0;transition:transform .34s cubic-bezier(.22,.61,.36,1);max-height:88vh;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding-bottom:calc(20px + env(safe-area-inset-bottom));}
    /* Header sheet: handle + tombol tutup sebagai baris flex sticky — BUKAN
       position:absolute, agar tidak pernah salah posisi/terpotong. */
    .pd-top{position:sticky;top:0;z-index:6;background:#f4f7fb;padding:8px 12px 6px;display:flex;align-items:center;justify-content:flex-end;border-radius:26px 26px 0 0;}
    .pd-grab{position:absolute;left:50%;transform:translateX(-50%);top:10px;width:38px;height:4px;border-radius:100px;background:#cfd8e6;}
    .pd-close{position:relative;z-index:7;width:36px;height:36px;border-radius:12px;border:none;background:#fff;color:#3a4a68;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 3px 10px -4px rgba(30,60,120,.3);flex-shrink:0;}
    .pd-close svg{width:18px;height:18px;}
    .pd-close:active{background:#e2eefb;}
    .pd-hero{text-align:center;padding:14px 20px 18px;}
    .pd-amt{font-size:32px;font-weight:800;letter-spacing:-1px;color:#0f9d63;}
    .pd-amt-lbl{font-size:12px;color:#7c93a0;font-weight:600;margin-top:2px;}
    .pd-name{font-size:16px;font-weight:800;margin-top:12px;}
    .pd-cid{font-size:12px;color:#7c93a0;margin-top:2px;}
    .pd-sec{font-size:12px;font-weight:800;color:#7c93a0;text-transform:uppercase;letter-spacing:.4px;margin:16px 18px 8px;}
    .pd-card{background:#fff;margin:0 16px;border-radius:16px;padding:4px 16px;}
    .pd-row{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #f2f5fa;font-size:13.5px;}
    .pd-row:last-child{border-bottom:none;}
    .pd-k{color:#6b7a97;} .pd-v{font-weight:700;color:#1F3849;text-align:right;}
    .pd-actions{display:flex;gap:10px;padding:16px;}
    .pd-btn{flex:1;padding:13px;border-radius:13px;font-family:inherit;font-size:13.5px;font-weight:700;cursor:pointer;border:none;display:flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;}
    .pd-btn svg{width:16px;height:16px;}
    .pd-wa{background:linear-gradient(135deg,#25d366,#1fae54);color:#fff;}
    .pd-print{background:#e2eefb;color:#3a4a68;}
    .pd-del{width:100%;padding:13px;border-radius:13px;border:1.5px solid #fbd5d7;background:#fff5f5;color:#d13b42;font-family:inherit;font-size:13.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;}
    .pd-del svg{width:16px;height:16px;}
    .pd-del-hint{font-size:11px;color:#7c93a0;line-height:1.5;margin-top:9px;padding:0 2px;}
    .pd-del-hint b{color:#d13b42;font-weight:700;}
    /* Confirm modal */
    .cf-overlay{position:fixed;inset:0;z-index:700;background:rgba(15,27,74,.55);opacity:0;visibility:hidden;transition:opacity .2s;display:flex;align-items:center;justify-content:center;padding:24px;}
    .cf-overlay.open{opacity:1;visibility:visible;}
    .cf-box{background:#fff;border-radius:20px;max-width:340px;width:100%;padding:22px 20px;text-align:center;transform:scale(.92);transition:transform .2s;}
    .cf-overlay.open .cf-box{transform:scale(1);}
    .cf-ic{width:52px;height:52px;border-radius:50%;background:#fde5e6;color:#d13b42;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;}
    .cf-ic svg{width:26px;height:26px;}
    .cf-title{font-size:16.5px;font-weight:800;}
    .cf-msg{font-size:13px;color:#6b7a97;line-height:1.55;margin-top:8px;}
    .cf-actions{display:flex;gap:10px;margin-top:20px;}
    .cf-actions button{flex:1;padding:13px;border-radius:12px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;border:none;}
    .cf-cancel{background:#f0f3f9;color:#5a6885;}
    .cf-confirm{background:linear-gradient(135deg,#f2545b,#d13b42);color:#fff;}
    .cf-confirm:disabled{opacity:.6;}
    .toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 16px);background:#1F3849;color:#fff;padding:12px 20px;border-radius:13px;font-size:13px;font-weight:600;z-index:800;opacity:0;transition:opacity .25s;pointer-events:none;max-width:88vw;text-align:center;}
    .toast.show{opacity:1;} .toast.ok{background:#12946f;} .toast.err{background:#d13b42;}
    /* Catat pembayaran sheet (iframe) */
    .pn-overlay{position:fixed;inset:0;z-index:650;background:rgba(15,27,74,.5);opacity:0;visibility:hidden;transition:opacity .25s;}
    .pn-overlay.open{opacity:1;visibility:visible;}
    .pn-sheet{position:fixed;bottom:0;z-index:651;height:94vh;height:94svh;max-height:calc(100svh - 8px);background:#eff8ff;border-radius:22px 22px 0 0;transition:transform .32s cubic-bezier(.22,.61,.36,1);overflow:hidden;}
    .pn-sheet.open{transform:translateX(-50%) translateY(0);}
    .pn-sheet iframe{width:100%;height:100%;border:none;display:block;}
    .bn-wrap{max-width:520px;margin:0 auto;width:100%;display:flex;height:var(--nav-h);}
    .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-decoration:none;color:var(--muted);font-size:10px;font-weight:600;cursor:pointer;}
    .bn-item svg{width:22px;height:22px;stroke-width:2;}
    .bn-item.active{color:var(--cyan,#0ea5e9);}
    .bn-fab{flex:0 0 auto;width:66px;display:flex;align-items:flex-start;justify-content:center;position:relative;}
    .bn-fab a,.bn-fab button{position:absolute;font-family:inherit;padding:0;cursor:pointer;top:-22px;width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;box-shadow:0 12px 26px -6px rgba(14,165,233,.6);border:4px solid #fff;transition:transform .14s;}
    .bn-fab a:active,.bn-fab button:active{transform:scale(.92);}
    .bn-fab svg{width:26px;height:26px;stroke-width:2.6;}
  </style>
</head>
<body>
  <%- include('../../partials/mobile-drawer', { active: active, appName: (typeof appName!=='undefined'?appName:'FLAYNET'), user: user }) %>
  <div class="wrap">
    <div class="head">
      <div>
        <div class="htitle">Pembayaran</div>
        <div class="hsub">Riwayat & catat pembayaran</div>
      </div>
    </div>

    <div class="content">
      <div class="hero">
        <div class="hero-lbl">Penerimaan Bulan Ini</div>
        <div class="hero-val money" id="payRevenue"><span class="skel" style="display:inline-block;width:120px;height:25px;background:rgba(255,255,255,.25);"></span></div>
        <div class="bars" id="weekBars"></div>
      </div>

      <div class="mini-grid">
        <div class="mini"><div class="mini-val money" id="payPaidCnt">–</div><div class="mini-lbl">Invoice lunas</div></div>
        <div class="mini"><div class="mini-val money" id="payUnpaidCnt" style="color:var(--amber);">–</div><div class="mini-lbl">Belum bayar</div></div>
      </div>

      <div class="trend-card">
        <div class="tc-head">
          <span class="tc-title">Tren Pemasukan</span>
          <div class="tc-range" id="tcRange">
            <button data-d="7">7h</button>
            <button data-d="14">14h</button>
            <button data-d="30" class="on">30h</button>
          </div>
        </div>
        <div class="tc-sum">
          <div class="tcs">Total masuk<b id="tcTotal">–</b></div>
          <div class="tcs">Transaksi<b id="tcCount">–</b></div>
          <div class="tcs">Rata-rata/hari<b id="tcAvg">–</b></div>
        </div>
        <svg class="trend-chart" id="trendChart" viewBox="0 0 320 130" preserveAspectRatio="none"></svg>
      </div>

      <div class="sec">Pembayaran Terbaru</div>
      <div class="list" id="payList">
        <div class="tx"><div class="skel" style="width:42px;height:42px;border-radius:13px;"></div><div class="tx-body"><div class="skel" style="width:130px;height:13px;"></div><div class="skel" style="width:90px;height:10px;margin-top:6px;"></div></div></div>
        <div class="tx"><div class="skel" style="width:42px;height:42px;border-radius:13px;"></div><div class="tx-body"><div class="skel" style="width:130px;height:13px;"></div><div class="skel" style="width:90px;height:10px;margin-top:6px;"></div></div></div>
      </div>
    </div>
  </div>

    <nav class="bottomnav">
    <div class="bn-wrap">
      <a class="bn-item" href="/mobile"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span><span>Beranda</span></a>
      <a class="bn-item" href="/mobile/customers"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span><span>Pelanggan</span></a>
      <div class="bn-fab"><button type="button" onclick="FabSheet.open()" aria-label="Tambah cepat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button></div>
      <a class="bn-item" href="/mobile/finance"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg></span><span>Laporan</span></a>
      <a class="bn-item" href="/mobile/monitoring"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></span><span>Monitor</span></a>
    </div>
  </nav>

  <!-- FAB Catat Pembayaran -->
  <button class="fab" onclick="openPayNew()" aria-label="Catat Pembayaran">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
  </button>

  <!-- Detail pembayaran (bottom sheet) -->
  <div class="pd-overlay" id="pdOverlay" onclick="closePayDetail()"></div>
  <div class="pd-sheet" id="pdSheet">
    <div class="pd-top">
      <div class="pd-grab"></div>
      <button class="pd-close" onclick="closePayDetail()" aria-label="Tutup"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div id="pdContent"></div>
  </div>
  <!-- Konfirmasi hapus -->
  <div class="cf-overlay" id="cfOverlay">
    <div class="cf-box">
      <div class="cf-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></div>
      <div class="cf-title">Hapus Pembayaran?</div>
      <div class="cf-msg">Status invoice periode ini akan kembali menjadi <b>belum bayar</b> dan jatuh tempo dikembalikan seperti semula. Tindakan ini tidak bisa dibatalkan.</div>
      <div class="cf-actions">
        <button class="cf-cancel" onclick="closeConfirm()">Batal</button>
        <button class="cf-confirm" id="cfConfirmBtn" onclick="doDeletePayment()">Ya, Hapus</button>
      </div>
    </div>
  </div>
  <!-- Catat pembayaran (pop-up sheet berisi form) -->
  <div class="pn-overlay" id="pnOverlay" onclick="closePayNew()"></div>
  <div class="pn-sheet" id="pnSheet">
    <iframe id="pnFrame" title="Catat Pembayaran" src="about:blank" loading="lazy"></iframe>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    function getToken(){ const ls=localStorage.getItem('token'); if(ls)return ls; const m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    async function api(url){ const t=getToken(); const headers=Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}); try{ const r=await fetch(url,{credentials:'include',headers}); if(r.status===401){location.href='/login';return null;} const x=await r.text(); try{return x?JSON.parse(x):null;}catch(_){return null;} }catch(e){return null;} }
    function fmtRp(n){ n=Number(n)||0; return 'Rp '+n.toLocaleString('id-ID'); }
    function fmtRpShort(n){ n=Number(n)||0; if(n>=1000000)return 'Rp '+(n/1000000).toFixed(1).replace('.0','')+'jt'; if(n>=1000)return 'Rp '+Math.round(n/1000)+'rb'; return 'Rp '+n.toLocaleString('id-ID'); }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function fmtDate(s){ if(!s)return''; const d=new Date(s); if(isNaN(d))return String(s).slice(0,10); return d.toLocaleDateString('id-ID',{day:'numeric',month:'short'}); }
    const MONTHS=['','Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
    const DAYS=['Min','Sen','Sel','Rab','Kam','Jum','Sab'];
    let _page=1,_loading=false,_allRows=[],_payById={};

    function renderWeekBars(rows){
      // Agregasi 7 hari terakhir dari tanggal bayar
      const today=new Date(); const buckets=[0,0,0,0,0,0,0]; const labels=[];
      for(let i=6;i>=0;i--){ const d=new Date(today); d.setDate(d.getDate()-i); labels.push(DAYS[d.getDay()]); }
      const startTs=new Date(today); startTs.setDate(startTs.getDate()-6); startTs.setHours(0,0,0,0);
      rows.forEach(p=>{ const dt=new Date(p.payment_date||p.created_at); if(isNaN(dt))return; const diff=Math.floor((dt-startTs)/86400000); if(diff>=0&&diff<7) buckets[diff]+=(p.amount||p.total||0); });
      const max=Math.max.apply(null,buckets)||1;
      const el=document.getElementById('weekBars');
      el.innerHTML=buckets.map((v,i)=>{ const h=Math.max(4,Math.round(v/max*44)); const hi=(i===6); return '<div class="bar-col"><div class="bar-track"><div class="bar'+(hi?' hi':'')+'" style="height:'+h+'px;"></div></div><div class="bar-lbl">'+labels[i]+'</div></div>'; }).join('');
    }

    async function loadStats(){
      const bs=await api('/api/billing/stats');
      if(bs&&bs.success){ const s=bs.data;
        document.getElementById('payRevenue').textContent=fmtRp(s.revenueThisMonth||0);
        document.getElementById('payPaidCnt').textContent=s.paidThisMonth||0;
        document.getElementById('payUnpaidCnt').textContent=s.unpaid||0;
      }
    }

    // ── Tren pemasukan (area chart) ──
    var _trendDays=30;
    async function loadTrend(){
      const j=await api('/api/billing/daily-transactions?days='+_trendDays);
      if(!(j&&j.success&&j.data)){ return; }
      const days=j.data.days||[]; const tot=j.data.totals||{};
      document.getElementById('tcTotal').textContent=fmtRpShort(tot.income||0);
      document.getElementById('tcCount').textContent=(tot.income_count||0);
      const avg=days.length?Math.round((tot.income||0)/days.length):0;
      document.getElementById('tcAvg').textContent=fmtRpShort(avg);
      drawTrend(days);
    }
    function drawTrend(days){
      const svg=document.getElementById('trendChart'); if(!svg)return;
      const W=320,H=130,padL=6,padR=6,padT=12,padB=20;
      const plotW=W-padL-padR, plotH=H-padT-padB;
      if(!days.length){ svg.innerHTML='<text x="160" y="70" text-anchor="middle" fill="#b3bdd0" font-size="11">Belum ada data</text>'; return; }
      const vals=days.map(d=>Number(d.income)||0);
      const n=vals.length, max=Math.max.apply(null,vals)||1;
      const xs=i=>padL+(n>1?(i*plotW/(n-1)):plotW/2);
      const ys=v=>padT+plotH*(1-v/max);
      let d='M '+xs(0)+' '+ys(vals[0]);
      for(let i=1;i<n;i++){ const x0=xs(i-1),y0=ys(vals[i-1]),x1=xs(i),y1=ys(vals[i]),cx=(x0+x1)/2; d+=' C '+cx+' '+y0+' '+cx+' '+y1+' '+x1+' '+y1; }
      const area=d+' L '+xs(n-1)+' '+(padT+plotH)+' L '+xs(0)+' '+(padT+plotH)+' Z';
      // titik puncak
      let maxIdx=0; vals.forEach((v,i)=>{ if(v>vals[maxIdx])maxIdx=i; });
      const lastX=xs(n-1), lastY=ys(vals[n-1]);
      // label tanggal (awal, tengah, akhir)
      let tl=''; [0,Math.floor(n/2),n-1].forEach(function(ii){ const l=days[ii]&&days[ii].label; if(l){ tl+='<text x="'+xs(ii)+'" y="'+(H-5)+'" text-anchor="middle" font-size="8" fill="#b3bdd0">'+esc(l)+'</text>'; } });
      svg.innerHTML=
        '<defs><linearGradient id="tg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0ea5e9" stop-opacity=".26"/><stop offset="100%" stop-color="#0ea5e9" stop-opacity="0"/></linearGradient></defs>'+
        '<path d="'+area+'" fill="url(#tg)"/>'+
        '<path d="'+d+'" fill="none" stroke="#0ea5e9" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"/>'+
        (vals[maxIdx]>0?'<circle cx="'+xs(maxIdx).toFixed(1)+'" cy="'+ys(vals[maxIdx]).toFixed(1)+'" r="2.4" fill="#f5a623"/>':'')+
        '<circle cx="'+lastX.toFixed(1)+'" cy="'+lastY.toFixed(1)+'" r="4.5" fill="#0ea5e9" opacity=".18"/>'+
        '<circle cx="'+lastX.toFixed(1)+'" cy="'+lastY.toFixed(1)+'" r="2.7" fill="#0ea5e9"/>'+tl;
    }
    document.getElementById('tcRange').addEventListener('click',function(e){ const b=e.target.closest('button'); if(!b)return; this.querySelectorAll('button').forEach(x=>x.classList.remove('on')); b.classList.add('on'); _trendDays=parseInt(b.dataset.d)||30; loadTrend(); });
    function payCard(p){
      const nm=p.cust_name||p.customer_name||(p.customer&&p.customer.name)||p.name||'Pelanggan';
      const amt=p.amount||p.total||0; const when=p.payment_date||p.created_at||'';
      const method=p.method_label||p.payment_method||p.method||''; const pm=p.period_month,py=p.period_year;
      const periodTxt=(pm&&py)?(MONTHS[pm]+' '+py):'';
      const init=(nm[0]||'?').toUpperCase(); const sub=[fmtDate(when),method].filter(Boolean).join(' · ');
      if(p.id!=null) _payById[p.id]=p;
      return '<div class="tx" onclick="openPayDetail('+(p.id!=null?p.id:'null')+')"><div class="tx-ic">'+esc(init)+'</div><div class="tx-body"><div class="tx-t">'+esc(nm)+'</div><div class="tx-s">'+esc(sub)+'</div></div><div class="tx-r"><div class="tx-amt">+'+fmtRpShort(amt)+'</div>'+(periodTxt?'<div class="tx-mth">'+esc(periodTxt)+'</div>':'')+'</div></div>';
    }
    async function loadPayments(reset){
      if(_loading)return; _loading=true; if(reset){_page=1;_allRows=[];}
      const j=await api('/api/payments/list?page='+_page+'&limit=20');
      const list=document.getElementById('payList');
      const rows=(j&&j.success)?(Array.isArray(j.data)?j.data:(j.data&&j.data.rows?j.data.rows:[])):[];
      _allRows=_allRows.concat(rows);
      if(reset) list.innerHTML='';
      const old=document.getElementById('loadMoreBtn'); if(old)old.remove();
      if(rows.length){
        list.insertAdjacentHTML('beforeend', rows.map(payCard).join(''));
        renderWeekBars(_allRows);
        if(rows.length>=20){ const b=document.createElement('button'); b.id='loadMoreBtn'; b.className='load-more'; b.textContent='Muat lebih banyak'; b.onclick=function(){_page++;loadPayments(false);}; list.parentNode.appendChild(b); }
      } else if(reset){ list.innerHTML='<div class="empty">Belum ada pembayaran</div>'; renderWeekBars([]); }
      _loading=false;
    }
    // ── Detail pembayaran ──
    function openPayDetail(id){
      const p=_payById[id]; if(!p)return;
      const nm=p.cust_name||p.customer_name||'Pelanggan';
      const amt=p.amount||p.total||0;
      const when=p.payment_date||p.created_at||'';
      const method=p.method_label||p.payment_method||'–';
      const periodTxt=(p.period_month&&p.period_year)?(MONTHS[p.period_month]+' '+p.period_year):'–';
      const phone=(p.cust_phone||p.customer_phone||'').replace(/[^0-9]/g,'');
      const waPhone=phone.replace(/^0/,'62');
      function fmtLong(s){ if(!s)return'–'; const d=new Date(s); if(isNaN(d))return String(s).slice(0,10); return d.toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}); }
      function row(k,v){ return '<div class="pd-row"><span class="pd-k">'+k+'</span><span class="pd-v">'+v+'</span></div>'; }
      let html='';
      html+='<div class="pd-hero"><div class="pd-amt">+'+fmtRp(amt)+'</div><div class="pd-amt-lbl">Pembayaran diterima</div><div class="pd-name">'+esc(nm)+'</div><div class="pd-cid">'+esc(p.cid||p.customer_id||'')+'</div></div>';
      html+='<div class="pd-sec">Detail Pembayaran</div><div class="pd-card">';
      html+=row('Tanggal bayar', fmtLong(when));
      html+=row('Metode', esc(method));
      html+=row('Nominal', fmtRp(amt));
      if(p.reference_number) html+=row('No. Referensi', esc(p.reference_number));
      html+='</div>';
      html+='<div class="pd-sec">Invoice</div><div class="pd-card">';
      html+=row('No. Invoice', esc(p.invoice_number||'–'));
      html+=row('Periode', esc(periodTxt));
      if(p.invoice_total) html+=row('Total invoice', fmtRp(p.invoice_total));
      html+='</div>';
      if(p.notes){ html+='<div class="pd-sec">Catatan</div><div class="pd-card"><div class="pd-row" style="border:none;"><span class="pd-v" style="text-align:left;font-weight:500;color:#5a6885;">'+esc(p.notes)+'</span></div></div>'; }
      // Aksi kirim bukti
      html+='<div class="pd-actions">';
      if(waPhone){
        const msg='Halo '+nm+', pembayaran Anda sebesar '+fmtRp(amt)+' untuk '+(p.invoice_number||'tagihan')+' periode '+periodTxt+' telah kami terima. Terima kasih.';
        html+='<a class="pd-btn pd-wa" href="https://wa.me/'+waPhone+'?text='+encodeURIComponent(msg)+'" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51-.17-.01-.37-.01-.57-.01-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.07 4.49 2.98 1.29 2.98.86 3.52.81.54-.05 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z"/></svg>Kirim Bukti via WA</a>';
      }
      html+='</div>';
      // Tombol hapus pembayaran (reversal — invoice kembali unpaid, jatuh tempo mundur)
      html+='<div style="padding:0 16px;"><button class="pd-del" onclick="confirmDeletePayment('+id+')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>Hapus Pembayaran</button>'+
        '<div class="pd-del-hint">Menghapus pembayaran akan mengembalikan status invoice periode ini menjadi <b>belum bayar</b> dan jatuh tempo kembali seperti semula.</div></div>';
      document.getElementById('pdContent').innerHTML=html;
      document.getElementById('pdOverlay').classList.add('open');
      document.getElementById('pdSheet').classList.add('open');
      document.body.style.overflow='hidden';
    }
    function closePayDetail(){ document.getElementById('pdOverlay').classList.remove('open'); document.getElementById('pdSheet').classList.remove('open'); document.body.style.overflow=''; }

    function toast(m,t){ const el=document.getElementById('toast'); el.textContent=m; el.className='toast show'+(t?' '+t:''); setTimeout(()=>el.classList.remove('show'),2800); }
    let _delId=null;
    function confirmDeletePayment(id){ _delId=id; document.getElementById('cfOverlay').classList.add('open'); }
    function closeConfirm(){ document.getElementById('cfOverlay').classList.remove('open'); _delId=null; }
    async function doDeletePayment(){
      if(_delId==null)return;
      const btn=document.getElementById('cfConfirmBtn'); btn.disabled=true; btn.textContent='Menghapus…';
      const t=getToken();
      let ok=false,msg='';
      try{
        const r=await fetch('/api/payments/'+_delId,{method:'DELETE',credentials:'include',headers:t?{'Authorization':'Bearer '+t}:{}});
        const d=await r.json().catch(()=>null);
        ok=(r.ok && d && d.success!==false); msg=(d&&d.message)||'';
        if(r.status===403){ msg='Anda tidak punya akses menghapus pembayaran'; }
      }catch(e){ msg=e.message; }
      btn.disabled=false; btn.textContent='Ya, Hapus';
      if(ok){
        closeConfirm(); closePayDetail();
        toast('Pembayaran dihapus, invoice kembali belum bayar','ok');
        loadStats(); loadTrend(); loadPayments(true);
      } else {
        toast(msg||'Gagal menghapus pembayaran','err');
        btn.disabled=false;
      }
    }
    (function(){ const cf=document.getElementById('cfOverlay'); if(cf){ cf.addEventListener('click',function(e){ if(e.target===this)closeConfirm(); }); } })();

    // ── Catat pembayaran (pop-up) ──
    let _pnLoaded=false;
    function openPayNew(){
      const fr=document.getElementById('pnFrame');
      if(!_pnLoaded){ fr.src='/mobile/payment-new'; _pnLoaded=true; }
      document.getElementById('pnOverlay').classList.add('open');
      document.getElementById('pnSheet').classList.add('open');
      document.body.style.overflow='hidden';
    }
    function closePayNew(){
      document.getElementById('pnOverlay').classList.remove('open');
      document.getElementById('pnSheet').classList.remove('open');
      document.body.style.overflow='';
    }
    window.addEventListener('message',function(e){
      const d=e.data||{};
      if(d.type==='payment-saved'){ loadStats(); loadTrend(); loadPayments(true); }
      else if(d.type==='close-payment-sheet'){ closePayNew(); loadStats(); loadTrend(); loadPayments(true); }
    });

    loadStats(); loadTrend(); loadPayments(true);
  </script>
</body>
</html>
