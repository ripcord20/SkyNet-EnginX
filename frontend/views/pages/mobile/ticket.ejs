  <div class="lightbox" id="lightbox" onclick="if(event.target===this)closeLightbox()">
    <button class="lb-close" onclick="closeLightbox()">&times;</button>
    <img src="" alt="foto tiket">
  </div>

  <div class="toast" id="toast"></div>

  <script>
    function getToken(){ try{ return localStorage.getItem('token')||localStorage.getItem('authToken')||''; }catch(_){ return ''; } }
    async function api(url, opts={}){
      const t=getToken();
      const headers=Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}, opts.headers||{});
      try{
        const r=await fetch(url,{credentials:'include',headers,...opts});
        if(r.status===401){ location.href='/login?next=/mobile/ticket'; return null; }
        const x=await r.text(); try{ return x?JSON.parse(x):null; }catch(_){ return null; }
      }catch(e){ return null; }
    }
    function toast(msg,kind){ const t=document.getElementById('toast'); t.textContent=msg; t.className='toast show'+(kind?(' '+kind):''); setTimeout(()=>t.className='toast',2200); }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    var STATUS_LBL={open:'Open',in_progress:'Dikerjakan',pending:'Pending',resolved:'Selesai',closed:'Ditutup'};
    var STATUS_CLS={open:'b-open',in_progress:'b-progress',pending:'b-pending',resolved:'b-resolved',closed:'b-closed'};
    var PRIO_LBL={low:'Rendah',medium:'Sedang',high:'Tinggi',critical:'Kritis'};
    var PRIO_CLS={low:'p-low',medium:'p-medium',high:'p-high',critical:'p-critical'};
    var TYPE_LBL={gangguan:'Gangguan',request:'Request',installation:'Instalasi',maintenance:'Maintenance'};

    var _filter='';
    var _search='';
    var _searchT=null;
    var _all=[];

    function fmtDate(s){
      if(!s) return '–';
      const d=new Date(s); if(isNaN(d)) return '–';
      const now=new Date(); const diff=(now-d)/1000;
      if(diff<60) return 'baru saja';
      if(diff<3600) return Math.floor(diff/60)+' mnt lalu';
      if(diff<86400) return Math.floor(diff/3600)+' jam lalu';
      if(diff<604800) return Math.floor(diff/86400)+' hr lalu';
      return d.toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'});
    }

    async function loadStats(){
      const r=await api('/api/tickets/stats');
      const d=(r&&r.success&&r.data)?r.data:{};
      document.getElementById('stTotal').textContent    = d.total!=null?d.total:'0';
      document.getElementById('stProgress').textContent = d.in_progress!=null?d.in_progress:'0';
      document.getElementById('stOverdue').textContent  = d.overdue!=null?d.overdue:'0';
      document.getElementById('stResolved').textContent = d.resolved!=null?d.resolved:'0';
    }

    async function loadList(){
      const qs=new URLSearchParams(); qs.set('limit','50');
      if(_filter) qs.set('status',_filter);
      if(_search) qs.set('search',_search);
      const r=await api('/api/tickets?'+qs.toString());
      _all=(r&&r.success&&Array.isArray(r.data))?r.data:[];
      renderList();
      document.getElementById('tkUpdated').textContent=_all.length+' tiket'+(_filter?(' · '+(STATUS_LBL[_filter]||_filter)):'');
    }

    function renderList(){
      const box=document.getElementById('tkList');
      if(!_all.length){
        box.innerHTML='<div class="empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><div class="empty-t">Belum ada tiket</div><div class="empty-s">'+(_search||_filter?'Coba ubah filter atau kata kunci.':'Tekan tombol + untuk membuat tiket.')+'</div></div>';
        return;
      }
      box.innerHTML=_all.map(t=>{
        const cust=t.customer?('<span class="tk-cust"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>'+esc(t.customer.name)+'</span><span class="dot"></span>'):'';
        return '<div class="tk" onclick="openDetail('+t.id+')">'
          +'<div class="tk-top">'
          +'<span class="tk-no">'+esc(t.ticket_number||('#'+t.id))+'</span>'
          +'<div class="tk-badges"><span class="badge '+(PRIO_CLS[t.priority]||'p-medium')+'">'+(PRIO_LBL[t.priority]||t.priority)+'</span>'
          +'<span class="badge '+(STATUS_CLS[t.status]||'b-open')+'">'+(STATUS_LBL[t.status]||t.status)+'</span></div>'
          +'</div>'
          +'<div class="tk-title">'+esc(t.title)+'</div>'
          +'<div class="tk-meta">'+cust
          +'<span class="tk-type">'+typeIcon(t.type)+(TYPE_LBL[t.type]||t.type)+'</span>'
          +'<span class="dot"></span><span>'+fmtDate(t.created_at)+'</span></div>'
          +'</div>';
      }).join('');
    }

    function typeIcon(tp){
      if(tp==='gangguan') return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
      if(tp==='installation') return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>';
      if(tp==='maintenance') return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>';
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>';
    }

    function setFilter(el,st){
      _filter=st;
      document.querySelectorAll('.chip').forEach(c=>c.classList.remove('on'));
      el.classList.add('on');
      loadList();
    }
    function onSearch(){
      clearTimeout(_searchT);
      _searchT=setTimeout(()=>{ _search=document.getElementById('tkSearch').value.trim(); loadList(); }, 350);
    }

    async function loadAll(spin){
      if(spin){ const b=document.getElementById('refreshBtn'); b.classList.add('spin'); setTimeout(()=>b.classList.remove('spin'),900); }
      document.getElementById('tkList').innerHTML=Array(4).fill('<div class="tk-skel"><div class="skel" style="width:40%;height:12px;margin-bottom:10px;"></div><div class="skel" style="width:80%;height:15px;margin-bottom:8px;"></div><div class="skel" style="width:55%;height:11px;"></div></div>').join('');
      await Promise.all([loadStats(), loadList()]);
    }

    /* ── Detail ── */
    var _curTicket=null;
    var _technicians=null;

    async function loadTechnicians(){
      if(_technicians) return _technicians;
      const r=await api('/api/users?limit=100');
      const rows=(r&&r.success&&Array.isArray(r.data))?r.data:(r&&Array.isArray(r.data&&r.data.rows)?r.data.rows:(Array.isArray(r)?r:[]));
      _technicians=Array.isArray(rows)?rows:[];
      return _technicians;
    }

    async function openDetail(id){
      document.getElementById('dtBody').innerHTML='<div style="padding:30px 0;text-align:center;color:#7c93a0;">Memuat…</div>';
      document.getElementById('dtOv').classList.add('open');
      document.getElementById('dtSheet').classList.add('open');
      document.body.style.overflow='hidden';
      const [r]=await Promise.all([api('/api/tickets/'+id), loadTechnicians().catch(()=>[])]);
      const t=(r&&r.success&&r.data)?r.data:null;
      if(!t){ document.getElementById('dtBody').innerHTML='<div style="padding:30px 0;text-align:center;color:#d13b42;">Gagal memuat tiket</div>'; return; }
      _curTicket=t;
      renderDetail(t);
    }

    function renderDetail(t){
      const cust=t.customer?('<div class="dt-row"><span class="dt-k">Pelanggan</span><span class="dt-v">'+esc(t.customer.name)+'</span></div>'
        +(t.customer.phone?'<div class="dt-row"><span class="dt-k">Telepon</span><span class="dt-v">'+esc(t.customer.phone)+'</span></div>':'')):'';

      // Dropdown teknisi
      const techOpts=['<option value="">— Belum ditugaskan —</option>']
        .concat((_technicians||[]).map(u=>'<option value="'+u.id+'"'+(t.assigned_to==u.id?' selected':'')+'>'+esc(u.name)+'</option>')).join('');

      // Tombol status kontekstual
      const statusBtns=[];
      if(t.status!=='in_progress' && t.status!=='resolved' && t.status!=='closed') statusBtns.push('<button class="act act-primary" onclick="setStatus(\'in_progress\')">Kerjakan</button>');
      if(t.status!=='pending' && t.status!=='resolved' && t.status!=='closed') statusBtns.push('<button class="act act-hold" onclick="setStatus(\'pending\')">Tunda</button>');
      if(t.status!=='resolved' && t.status!=='closed') statusBtns.push('<button class="act act-ok" onclick="setStatus(\'resolved\')">Selesaikan</button>');
      if(t.status==='resolved') statusBtns.push('<button class="act act-close" onclick="setStatus(\'closed\')">Tutup Tiket</button>');
      if(t.status==='closed'||t.status==='resolved') statusBtns.push('<button class="act act-primary" onclick="setStatus(\'open\')">Buka Lagi</button>');

      document.getElementById('dtBody').innerHTML=
        '<div class="dt-hero">'
        +'<div style="display:flex;gap:6px;"><span class="badge '+(PRIO_CLS[t.priority]||'p-medium')+'">'+(PRIO_LBL[t.priority]||t.priority)+'</span>'
        +'<span class="badge '+(STATUS_CLS[t.status]||'b-open')+'">'+(STATUS_LBL[t.status]||t.status)+'</span></div>'
        +'<div class="dt-title">'+esc(t.title)+'</div>'
        +(t.description?'<div class="dt-desc">'+esc(t.description)+'</div>':'<div class="dt-desc" style="color:#a8b2c4;">Tidak ada deskripsi.</div>')
        +'</div>'

        +'<div class="dt-sec">Informasi</div>'
        +'<div class="dt-row"><span class="dt-k">No. Tiket</span><span class="dt-v">'+esc(t.ticket_number||('#'+t.id))+'</span></div>'
        +'<div class="dt-row"><span class="dt-k">Tipe</span><span class="dt-v">'+(TYPE_LBL[t.type]||t.type)+'</span></div>'
        +cust
        +'<div class="dt-row"><span class="dt-k">Dibuat</span><span class="dt-v">'+fmtDate(t.created_at)+'</span></div>'

        +'<div class="dt-sec">Teknisi</div>'
        +'<select class="assign-sel" id="assignSel" onchange="assignTech(this.value)">'+techOpts+'</select>'

        +'<div class="dt-sec">Ubah Status</div>'
        +'<div class="dt-actions" style="flex-wrap:wrap;">'+statusBtns.join('')+'</div>'

        +'<div class="dt-sec">Aktivitas ('+((t.timelines||[]).length)+')</div>'
        +'<div class="tl" id="tlBox">'+renderTimeline(t.timelines||[])+'</div>'

        // Composer
        +'<div class="composer">'
        +'<textarea id="cmpText" placeholder="Tulis komentar atau update…" oninput="autoGrow(this)"></textarea>'
        +'<div class="cmp-prev" id="cmpPrev"></div>'
        +'<div class="cmp-bar">'
        +'<button class="cmp-attach" onclick="document.getElementById(\'cmpFile\').click()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg></button>'
        +'<input type="file" id="cmpFile" accept="image/*" multiple style="display:none;" onchange="onPickFiles(this.files)">'
        +'<button class="cmp-send" id="cmpSend" onclick="submitComment()">Kirim Update</button>'
        +'</div>'
        +'</div>';
    }

    function renderTimeline(list){
      if(!list.length) return '<div style="font-size:12.5px;color:#a8b2c4;padding:8px 0 4px 4px;">Belum ada aktivitas.</div>';
      return list.map(renderTlItem).join('');
    }
    function renderTlItem(tl){
      const type=tl.type||'comment';
      const who=(tl.user&&tl.user.name)||'Sistem';
      const initial=who.charAt(0).toUpperCase();
      const avInner = type==='status_change'?'&#8597;' : type==='assignment'?'&#8594;' : type==='system'?'&#9881;'
        : type==='photo'?'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>'
        : initial;
      let content;
      if(type==='status_change'){
        content='<div class="tl-change"><span class="badge '+(STATUS_CLS[tl.old_value]||'b-open')+'">'+(STATUS_LBL[tl.old_value]||tl.old_value)+'</span> &#8594; <span class="badge '+(STATUS_CLS[tl.new_value]||'b-open')+'">'+(STATUS_LBL[tl.new_value]||tl.new_value)+'</span></div>';
      } else {
        content=(tl.content?'<div class="tl-text">'+esc(tl.content)+'</div>':'');
        const atts=Array.isArray(tl.attachments)?tl.attachments:[];
        const imgs=atts.filter(a=>a&&(/\.(jpe?g|png|gif|webp)$/i.test(a.url||'')|| (a.mimetype||'').startsWith('image/')));
        if(imgs.length){
          content+='<div class="tl-photos">'+imgs.map(a=>'<img src="'+esc(a.url)+'" onclick="openLightbox(\''+esc(a.url)+'\')" alt="foto">').join('')+'</div>';
        }
      }
      const tagLbl={comment:'Komentar',status_change:'Status',assignment:'Tugaskan',photo:'Foto',system:'Sistem'}[type]||type;
      const showTag=(type!=='comment');
      return '<div class="tl-item">'
        +'<div class="tl-av tl-'+type+'">'+avInner+'</div>'
        +'<div class="tl-card">'
        +'<div class="tl-head"><span class="tl-who">'+esc(who)+'</span><span class="tl-time">'+fmtDate(tl.created_at)+'</span>'
        +(showTag?'<span class="tl-tag">'+tagLbl+'</span>':'')+'</div>'
        +content
        +'</div></div>';
    }

    function autoGrow(el){ el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,140)+'px'; }

    function closeDetail(){
      document.getElementById('dtOv').classList.remove('open');
      document.getElementById('dtSheet').classList.remove('open');
      document.body.style.overflow='';
      _cmpFiles=[]; _curTicket=null;
    }

    async function setStatus(st){
      if(!_curTicket) return;
      const r=await api('/api/tickets/'+_curTicket.id,{method:'PUT',body:JSON.stringify({status:st})});
      if(r&&r.success){ toast('Status diperbarui','ok'); await reloadDetail(); loadStats(); loadList(); }
      else { toast((r&&r.message)||'Gagal memperbarui','err'); }
    }

    async function assignTech(uid){
      if(!_curTicket) return;
      const r=await api('/api/tickets/'+_curTicket.id,{method:'PUT',body:JSON.stringify({assigned_to:uid||null})});
      if(r&&r.success){ toast(uid?'Teknisi ditugaskan':'Penugasan dilepas','ok'); await reloadDetail(); loadList(); }
      else { toast((r&&r.message)||'Gagal menugaskan','err'); }
    }

    async function reloadDetail(){
      if(!_curTicket) return;
      const r=await api('/api/tickets/'+_curTicket.id);
      const t=(r&&r.success&&r.data)?r.data:null;
      if(t){ _curTicket=t; renderDetail(t); }
    }

    /* Composer: foto + komentar */
    var _cmpFiles=[];
    function onPickFiles(files){
      for(const f of files){ if(_cmpFiles.length<6) _cmpFiles.push(f); }
      renderCmpPrev();
    }
    function renderCmpPrev(){
      const box=document.getElementById('cmpPrev'); if(!box) return;
      box.innerHTML=_cmpFiles.map((f,i)=>{
        const url=URL.createObjectURL(f);
        return '<div class="pv"><img src="'+url+'"><button onclick="rmCmpFile('+i+')">&times;</button></div>';
      }).join('');
    }
    function rmCmpFile(i){ _cmpFiles.splice(i,1); renderCmpPrev(); }

    async function submitComment(){
      if(!_curTicket) return;
      const text=(document.getElementById('cmpText').value||'').trim();
      if(!text && !_cmpFiles.length){ toast('Tulis komentar atau lampirkan foto','err'); return; }
      const btn=document.getElementById('cmpSend'); btn.disabled=true; btn.textContent='Mengirim…';

      const fd=new FormData();
      fd.append('content', text);
      fd.append('type', 'comment');
      _cmpFiles.forEach(f=>fd.append('attachments', f));

      // FormData: jangan set Content-Type manual (biar browser set boundary)
      const t=getToken();
      let ok=false, msg='';
      try{
        const r=await fetch('/api/tickets/'+_curTicket.id+'/timeline',{
          method:'POST', credentials:'include',
          headers: t?{'Authorization':'Bearer '+t}:{},
          body: fd
        });
        if(r.status===401){ location.href='/login?next=/mobile/ticket'; return; }
        const j=await r.json().catch(()=>null);
        ok=j&&j.success; msg=(j&&j.message)||'';
      }catch(e){ msg=e.message; }

      btn.disabled=false; btn.textContent='Kirim Update';
      if(ok){
        document.getElementById('cmpText').value='';
        _cmpFiles=[]; renderCmpPrev();
        toast('Update terkirim','ok');
        await reloadDetail(); loadStats(); loadList();
      } else {
        toast(msg||'Gagal mengirim update','err');
      }
    }

    /* Lightbox */
    function openLightbox(url){
      let lb=document.getElementById('lightbox');
      lb.querySelector('img').src=url;
      lb.classList.add('open');
    }
    function closeLightbox(){ document.getElementById('lightbox').classList.remove('open'); }

    /* ── Create ── */
    var _pickedCust=null;
    var _custT=null;
    function openCreate(){
      document.getElementById('fTitle').value='';
      document.getElementById('fDesc').value='';
      document.getElementById('fType').value='gangguan';
      document.getElementById('fPriority').value='medium';
      document.getElementById('fCustSearch').value='';
      document.getElementById('custResults').innerHTML='';
      document.getElementById('custPicked').style.display='none';
      _pickedCust=null;
      document.getElementById('adOv').classList.add('open');
      document.getElementById('adSheet').classList.add('open');
      document.body.style.overflow='hidden';
    }
    function closeCreate(){
      document.getElementById('adOv').classList.remove('open');
      document.getElementById('adSheet').classList.remove('open');
      document.body.style.overflow='';
    }
    function onCustSearch(){
      clearTimeout(_custT);
      const q=document.getElementById('fCustSearch').value.trim();
      if(q.length<2){ document.getElementById('custResults').innerHTML=''; return; }
      _custT=setTimeout(async()=>{
        const r=await api('/api/tickets/customers/search?q='+encodeURIComponent(q));
        const rows=(r&&r.success&&Array.isArray(r.data))?r.data:(Array.isArray(r)?r:[]);
        const box=document.getElementById('custResults');
        if(!rows.length){ box.innerHTML='<div style="font-size:12.5px;color:#7c93a0;padding:6px 2px;">Tidak ditemukan</div>'; return; }
        box.innerHTML=rows.slice(0,6).map(c=>'<div onclick="pickCust('+c.id+',\''+esc(c.name).replace(/'/g,"&#39;")+'\')" style="padding:11px 13px;background:#fff;border:1px solid #e6ebf4;border-radius:11px;margin-bottom:7px;font-size:13px;font-weight:600;cursor:pointer;">'+esc(c.name)+(c.phone?'<span style="color:#7c93a0;font-weight:500;"> · '+esc(c.phone)+'</span>':'')+'</div>').join('');
      }, 300);
    }
    function pickCust(id,name){
      _pickedCust=id;
      document.getElementById('fCustSearch').value='';
      document.getElementById('custResults').innerHTML='';
      const box=document.getElementById('custPicked');
      box.style.display='block';
      box.innerHTML='<div style="display:flex;align-items:center;gap:9px;padding:11px 13px;background:#e7effe;border-radius:11px;font-size:13px;font-weight:700;color:#0ea5e9;"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>'+name+'<button onclick="clearCust()" style="margin-left:auto;background:none;border:none;color:#0ea5e9;cursor:pointer;font-size:16px;line-height:1;">&times;</button></div>';
    }
    function clearCust(){ _pickedCust=null; document.getElementById('custPicked').style.display='none'; }

    var _saving=false;
    async function submitCreate(){
      if(_saving) return;
      const title=document.getElementById('fTitle').value.trim();
      if(!title){ toast('Judul wajib diisi','err'); return; }
      _saving=true;
      const btn=document.getElementById('fSave'); btn.disabled=true; btn.textContent='Menyimpan…';
      const body={
        title:title,
        type:document.getElementById('fType').value,
        priority:document.getElementById('fPriority').value,
        description:document.getElementById('fDesc').value.trim()||null,
        customer_id:_pickedCust||null
      };
      const r=await api('/api/tickets',{method:'POST',body:JSON.stringify(body)});
      _saving=false; btn.disabled=false; btn.textContent='Simpan Tiket';
      if(r&&r.success){ toast('Tiket dibuat','ok'); closeCreate(); loadAll(); }
      else { toast((r&&r.message)||'Gagal membuat tiket','err'); }
    }

    loadAll();
  </script>
</body>
</html>
