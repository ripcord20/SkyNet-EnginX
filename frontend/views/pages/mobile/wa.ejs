  <script src="/socket.io/socket.io.js"></script>
  <script>
    function getToken(){ const ls=localStorage.getItem('token'); if(ls)return ls; const m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    async function api(url,method,body){
      const t=getToken();
      const headers=Object.assign({'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'}, t?{'Authorization':'Bearer '+t}:{});
      try{
        const opt={credentials:'include',headers,method:method||'GET'};
        if(body) opt.body=JSON.stringify(body);
        const r=await fetch(url,opt);
        if(r.status===401){ location.href='/login?next=/mobile/wa'; return null; }
        const x=await r.text(); try{return x?JSON.parse(x):null;}catch(_){return null;}
      }catch(e){ return null; }
    }
    function toast(m,type){ const t=document.getElementById('toast'); t.textContent=m; t.className='toast show'+(type?(' '+type):''); setTimeout(()=>t.classList.remove('show'),2600); }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    var SESSIONS=[];

    function switchTab(p){
      document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active', b.dataset.p===p));
      document.getElementById('paneDev').classList.toggle('show', p==='dev');
      document.getElementById('paneChat').classList.toggle('show', p==='chat');
      document.getElementById('paneSend').classList.toggle('show', p==='send');
      document.getElementById('paneRem').classList.toggle('show', p==='rem');
      if(p==='chat' && !_convLoadedOnce){ loadConversations(); }
    }

    function statusOf(s){
      var st=(s.runtime_status||s.status||'disconnected').toLowerCase();
      if(st==='connected') return {cls:'on', label:'Terhubung'};
      // 'connecting' pada WAHA sering berarti sedang dipulihkan otomatis
      if(st==='connecting'||st==='qr'){
        var isWaha=(s.provider||'').toLowerCase()==='waha';
        return {cls:'wait', label: isWaha ? 'Memulihkan…' : 'Menunggu'};
      }
      return {cls:'off', label:'Terputus'};
    }
    function provLabel(p){ p=(p||'baileys').toLowerCase(); return p==='fonnte'?'Fonnte':(p==='waha'?'WAHA':'Baileys'); }

    function renderDevices(){
      var list=document.getElementById('devList');
      if(!SESSIONS.length){
        list.innerHTML='<div class="empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg><div>Belum ada device WhatsApp.<br>Tambah device dengan tombol + di atas.</div></div>';
        return;
      }
      list.innerHTML=SESSIONS.map(function(s){
        var st=statusOf(s);
        var connected=st.cls==='on';
        var healing=(st.cls==='wait');
        var phone=s.phone_number?('+'+String(s.phone_number).replace(/[^0-9]/g,'')):'Belum tertaut';
        var prov=(s.provider||'baileys').toLowerCase();
        // Baileys DAN WAHA sama-sama butuh scan QR. Hanya Fonnte yang tidak
        // (cukup verifikasi token). Sebelumnya WAHA dianggap tanpa QR → QR tak
        // pernah muncul, jadi koneksi tak pernah selesai.
        var needsQr = (prov==='baileys' || prov==='waha');
        var staleTag = s.status_stale ? '<span class="tag" style="background:#fdf1dc;color:#b9781a;">status terakhir</span>' : '';
        var sid=esc(s.session_id);
        var nameEsc=esc(s.name||'Device').replace(/'/g,'&#39;');

        var connBtn;
        if(connected){
          connBtn='<button class="btn btn-dis" onclick="doDisconnect(\''+sid+'\')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>Putuskan</button>';
        } else if(healing){
          connBtn='<button class="btn btn-con" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>Memulihkan…</button>';
        } else {
          connBtn='<button class="btn btn-con" onclick="doConnect(\''+sid+'\','+(needsQr?'true':'false')+')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>'+(needsQr?'Hubungkan (QR)':'Hubungkan')+'</button>';
        }
        // Tombol hapus device (selalu tersedia)
        var delBtn='<button class="btn btn-del" onclick="askDeleteDevice(\''+sid+'\',\''+nameEsc+'\')" aria-label="Hapus device"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>';

        return '<div class="dev">'
          + '<div class="dev-top">'
