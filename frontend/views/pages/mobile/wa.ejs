    /* ── Connect / Disconnect ── */
    var _qrTimer=null, _qrSession=null;
    async function doConnect(sid, needsQr){
      toast('Menghubungkan…');
      var j=await api('/api/wa/sessions/'+encodeURIComponent(sid)+'/connect','POST',{});

      // Gagal menghubungi gateway (mis. container WAHA mati) → tampilkan
      // pesan diagnostik dari server apa adanya, jangan buka QR sia-sia.
      if(!(j&&j.success)){
        toast((j&&j.message)||'Gagal menghubungkan','err');
        setTimeout(function(){ loadSessions(); loadStats(); }, 600);
        return;
      }

      if(!needsQr){
        // Fonnte: hasil langsung, tanpa QR
        toast(j.message||'Device terhubung','ok');
        setTimeout(function(){ loadSessions(); loadStats(); }, 800);
        return;
      }

      // Sudah terhubung (auth lama masih valid) → tak perlu QR
      if(/sudah terhubung/i.test(j.message||'')){
        toast(j.message,'ok');
        setTimeout(function(){ loadSessions(); loadStats(); }, 600);
        return;
      }

      // Baileys & WAHA: buka modal QR + polling
      _qrSession=sid;
      document.getElementById('qrWrap').innerHTML='<div class="qr-spin"></div>';
      document.getElementById('qrTitle').textContent='Scan QR WhatsApp';
      document.getElementById('qrOv').classList.add('open');
      document.body.style.overflow='hidden';
      pollQr();
    }
    var _qrTries=0;
    async function pollQr(){
      if(!_qrSession) return;
      var j=await api('/api/wa/sessions/'+encodeURIComponent(_qrSession)+'/qr');
      var d=(j&&j.data)||{};

      // Berhasil tertaut
      if(d.status==='connected'){
        qrClose(); toast('Device berhasil terhubung','ok');
        loadSessions(); loadStats(); return;
      }

      // QR sudah siap → tampilkan
      if(d.qr_image){
        document.getElementById('qrWrap').innerHTML='<img src="'+d.qr_image+'" alt="QR WhatsApp">';
        document.getElementById('qrTitle').textContent='Scan QR WhatsApp';
      } else if(d.qr_pending || d.status==='connecting'){
        // WAHA/Baileys butuh ~5-15 dtk menyiapkan QR — tampilkan progres, jangan
        // biarkan user menatap layar kosong.
        document.getElementById('qrTitle').textContent='Menyiapkan QR…';
      } else if(d.status==='disconnected' && _qrTries>4){
        // Gateway menolak/tidak menyiapkan QR setelah beberapa kali → berhenti.
        qrClose();
        toast((d.error ? ('Gagal: '+d.error) : 'Gateway tidak menyiapkan QR. Cek apakah container WAHA jalan.'),'err');
        loadSessions(); return;
      }

      // Batas waktu ~2 menit (48 x 2,5 dtk) supaya tidak polling selamanya.
      if(++_qrTries > 48){
        qrClose();
        toast('Waktu scan QR habis. Coba hubungkan lagi.','err');
        loadSessions(); return;
      }
      _qrTimer=setTimeout(pollQr, 2500);
    }
    function qrClose(){
      if(_qrTimer){ clearTimeout(_qrTimer); _qrTimer=null; }
      _qrSession=null; _qrTries=0;
      document.getElementById('qrOv').classList.remove('open');
      document.body.style.overflow='';
    }
    async function doDisconnect(sid){
      toast('Memutuskan…');
      var j=await api('/api/wa/sessions/'+encodeURIComponent(sid)+'/disconnect','POST',{});
      if(j&&j.success){ toast('Device diputuskan','ok'); } else { toast((j&&j.message)||'Gagal memutuskan','err'); }
      setTimeout(function(){ loadSessions(); loadStats(); }, 600);
