    /* ══════════════ CHAT: DAFTAR PERCAKAPAN ══════════════ */
    var CONVS=[], MSGS=[], _convLoadedOnce=false, _picCache={}, _activeContact=null;

    function digits(s){ return String(s||'').replace(/[^0-9]/g,''); }
    function last9(s){ return digits(s).slice(-9); }

    async function loadConversations(){
      var sid=document.getElementById('chatSession').value;
      var listEl=document.getElementById('convList');
      if(!sid){ listEl.innerHTML='<div class="chat-empty" style="margin:30px auto;">Pilih device dulu untuk melihat percakapan.</div>'; return; }
      _convLoadedOnce=true;
      listEl.innerHTML='<div class="conv"><div class="skel" style="width:46px;height:46px;border-radius:50%;"></div><div style="flex:1;"><div class="skel" style="width:120px;height:13px;"></div><div class="skel" style="width:180px;height:10px;margin-top:7px;"></div></div></div>';
      var j=await api('/api/wa/conversations?session_id='+encodeURIComponent(sid));
      MSGS=(j&&j.success&&Array.isArray(j.data))?j.data:[];
      // Kelompokkan pesan per kontak (last9)
      var map={};
      MSGS.forEach(function(m){
        var contactRaw=(m.direction==='inbound'?m.from_number:m.to_number)||'';
        var key=last9(contactRaw); if(!key) return;
        if(!map[key]){ map[key]={key:key, number:digits(contactRaw), name:null, customer:null, last:m, count:0}; }
        var g=map[key];
        var mt=parseDate(_ts(m)), gt=parseDate(_ts(g.last));
        if(mt && (!gt || mt>gt)) g.last=m;
        if(m.customer) g.customer=m.customer;
        if(!g.name && m.push_name && m.direction==='inbound') g.name=m.push_name;
        g.count++;
      });
      CONVS=Object.keys(map).map(function(k){ return map[k]; })
        .sort(function(a,b){ return (parseDate(_ts(b.last))||0)-(parseDate(_ts(a.last))||0); });
      renderConversations();
    }

    function _convTime(ts){
      var d=parseDate(ts); if(!d) return '';
      var t=new Date(); var y=new Date(); y.setDate(t.getDate()-1);
      if(d.toDateString()===t.toDateString()) return d.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit'});
      if(d.toDateString()===y.toDateString()) return 'Kemarin';
      var diff=(t-d)/86400000;
      if(diff<7) return d.toLocaleDateString('id-ID',{weekday:'short'});
      return d.toLocaleDateString('id-ID',{day:'2-digit',month:'2-digit',year:'2-digit'});
    }
    function renderConversations(){
      var q=(document.getElementById('convSearch').value||'').trim().toLowerCase();
      var rows=CONVS;
      if(q){ rows=CONVS.filter(function(c){
        var nm=(c.customer&&c.customer.name)||c.name||c.number;
        return (nm+' '+c.number).toLowerCase().indexOf(q)>=0;
      }); }
      var el=document.getElementById('convList');
      if(!rows.length){
        el.innerHTML='<div class="conv-empty">'+(q?'Tidak ada hasil':'Belum ada percakapan di device ini')+'</div>';
        return;
      }
      el.innerHTML=rows.map(function(c){
        var nm=(c.customer&&c.customer.name)||c.name||('+'+c.number);
        var lastTxt=_preview(c.last);
        var tm=_convTime(_ts(c.last));
        var init=(nm.charAt(0)||'?').toUpperCase();
        var badge=(c.customer)?'<span class="conv-badge">'+esc(c.customer.customer_id||'Pelanggan')+'</span>':'';
        return '<div class="conv" onclick="openChat(\''+c.key+'\')">'
          + '<div class="conv-av" data-num="'+esc(c.number)+'">'+esc(init)+'</div>'
          + '<div class="conv-main"><div class="conv-top"><span class="conv-nm">'+esc(nm)+'</span><span class="conv-tm">'+esc(tm)+'</span></div>'
          + '<div class="conv-bottom"><span class="conv-last">'+esc(lastTxt)+'</span>'+badge+'</div></div></div>';
      }).join('');
      loadConvPics();
    }
    function _preview(m){
      if(!m) return '';
      var t=(m.message_type||'text');
      var pfx=(m.direction==='outbound'?'Anda: ':'');
      if(t==='image'||/\.(jpg|jpeg|png|webp|gif)($|\?)/i.test(m.media_url||'')) return pfx+'📷 Foto';
      if(t==='video'||/\.(mp4|3gp|mov)($|\?)/i.test(m.media_url||'')) return pfx+'🎥 Video';
      if(t==='audio') return pfx+'🎙️ Audio';
      if(t==='document') return pfx+'📄 Dokumen';
      return pfx+(m.message||'');
    }
    // Muat foto profil untuk avatar di daftar chat. Dijalankan bertahap
    // (staggered) supaya tidak menembak puluhan request sekaligus yang bisa
    // lambat / kena rate-limit WhatsApp. Hasilnya di-cache per nomor.
    var _picQueue=[], _picBusy=false;
    async function loadConvPics(){
      var sid=document.getElementById('chatSession').value; if(!sid) return;
      var avs=document.querySelectorAll('.conv-av[data-num]');
      Array.prototype.forEach.call(avs, function(av){
        var num=av.getAttribute('data-num'); if(!num) return;
        if(_picCache[num]===false) return;                 // sudah dicek, tak ada foto
        if(_picCache[num]){ av.innerHTML='<img src="'+_picCache[num]+'" onerror="this.remove()">'; return; }
        _picQueue.push({num:num});                          // antre untuk di-fetch
      });
      _drainPicQueue(sid);
    }
    async function _drainPicQueue(sid){
      if(_picBusy) return; _picBusy=true;
      while(_picQueue.length){
        var item=_picQueue.shift(); var num=item.num;
        if(_picCache[num]!==undefined){ _applyConvPic(num); continue; }
        try{
          var j=await api('/api/wa/profile-picture?session_id='+encodeURIComponent(sid)+'&number='+encodeURIComponent(num));
          if(j&&j.success&&j.url){
            _picCache[num]='/api/wa/profile-picture-img?session_id='+encodeURIComponent(sid)+'&number='+encodeURIComponent(num);
          } else { _picCache[num]=false; }
        }catch(e){ _picCache[num]=false; }
        _applyConvPic(num);
        await new Promise(function(r){ setTimeout(r,180); });  // jeda antar request
      }
      _picBusy=false;
    }
    function _applyConvPic(num){
      if(!_picCache[num]) return;
      var els=document.querySelectorAll('.conv-av[data-num="'+num+'"]');
      Array.prototype.forEach.call(els, function(el){
        if(el.querySelector('img')) return;
        el.innerHTML='<img src="'+_picCache[num]+'" onerror="this.remove()">';
      });
    }

    /* ══════════════ CHAT: THREAD ══════════════ */
    function openChat(key){
      var conv=CONVS.find(function(c){ return c.key===key; });
      if(!conv) return;
      _activeContact=conv;
      var nm=(conv.customer&&conv.customer.name)||conv.name||('+'+conv.number);
      document.getElementById('chatHdNm').textContent=nm;
      document.getElementById('chatHdSub').textContent='+'+conv.number+(conv.customer&&conv.customer.package&&conv.customer.package.name?(' · '+conv.customer.package.name):'');
      var av=document.getElementById('chatHdAv'); av.textContent=(nm.charAt(0)||'?').toUpperCase();
      // thread pesan utk kontak ini (urут naik)
      var thread=MSGS.filter(function(m){
        var contactRaw=(m.direction==='inbound'?m.from_number:m.to_number)||'';
        return last9(contactRaw)===key;
      }).sort(function(a,b){ return (parseDate(_ts(a))||0)-(parseDate(_ts(b))||0); });
      renderThread(thread);
      var scr=document.getElementById('chatScreen'); scr.classList.add('open'); document.body.style.overflow='hidden';
      // foto profil di header
      loadHeaderPic(conv.number, av);
    }
    function closeChat(){ document.getElementById('chatScreen').classList.remove('open'); document.body.style.overflow=''; _activeContact=null; closeAttachMenu(); }

    function renderThread(thread){
      var body=document.getElementById('chatBody');
      if(!thread.length){ body.innerHTML='<div class="chat-empty">Belum ada pesan. Mulai percakapan di bawah.</div>'; return; }
      var html=''; var lastDay='';
      thread.forEach(function(m){
        var day=_day(_ts(m));
        if(day && day!==lastDay){ html+='<div class="chat-daydiv">'+esc(day)+'</div>'; lastDay=day; }
        html+=bubble(m);
      });
      body.innerHTML=html;
      body.scrollTop=body.scrollHeight;
    }
    function bubble(m){
      var out=(m.direction==='outbound');
      var media='';
      var url=m.media_url||'';
      var t=(m.message_type||'text');
      var isImg=(t==='image')||/\.(jpg|jpeg|png|webp|gif)($|\?)/i.test(url);
      var isVid=(t==='video')||/\.(mp4|3gp|mov)($|\?)/i.test(url);
      if(url && isImg){ media='<div class="bub-media"><img src="'+esc(url)+'" onclick="showLightbox(\''+esc(url).replace(/'/g,'')+'\')" loading="lazy" alt="Foto"></div>'; }
      else if(url && isVid){ media='<div class="bub-media"><video src="'+esc(url)+'" controls style="width:100%;max-width:230px;border-radius:9px;"></video></div>'; }
      else if(url && t==='document'){ media='<a href="'+esc(url)+'" target="_blank" style="display:block;font-size:12px;color:#0ea5e9;margin-bottom:4px;">📄 Buka dokumen</a>'; }
      var txt=m.message?('<div class="bub-txt">'+esc(m.message).replace(/\n/g,'<br>')+'</div>'):'';
      var ck='';
      if(out){
        var mark=(m.status==='read')?'<span class="ck read">✓✓</span>':(m.status==='delivered')?'<span class="ck">✓✓</span>':(m.status==='failed')?'<span class="ck fail">✕</span>':(m.status==='pending')?'<span class="ck">🕐</span>':'<span class="ck">✓</span>';
        ck=mark;
      }
      return '<div class="bub '+(out?'out':'in')+'">'+media+txt+'<div class="bub-time">'+esc(_clock(_ts(m)))+ck+'</div></div>';
    }

    async function loadHeaderPic(number, avEl){
      var sid=document.getElementById('chatSession').value;
      if(_picCache[number]===false) return;
      if(_picCache[number]){ avEl.innerHTML='<img src="'+_picCache[number]+'">'; return; }
      try{
        var j=await api('/api/wa/profile-picture?session_id='+encodeURIComponent(sid)+'&number='+encodeURIComponent(number));
        if(j&&j.success&&j.url){
          var proxied='/api/wa/profile-picture-img?session_id='+encodeURIComponent(sid)+'&number='+encodeURIComponent(number);
          _picCache[number]=proxied;
          avEl.innerHTML='<img src="'+proxied+'" onerror="this.remove()">';
        } else { _picCache[number]=false; }
      }catch(e){ _picCache[number]=false; }
    }

    function chatAutoGrow(el){ el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,100)+'px'; }

    async function chatSend(){
      if(!_activeContact) return;
      var txt=document.getElementById('chatText').value.trim();
      if(!txt) return;
      var sid=document.getElementById('chatSession').value;
      var to=_activeContact.number;
      var btn=document.getElementById('chatSendBtn'); btn.disabled=true;
      // optimistic bubble
      var tmp={direction:'outbound', message:txt, created_at:new Date().toISOString(), status:'pending', message_type:'text'};
      _appendBubble(tmp);
      document.getElementById('chatText').value=''; chatAutoGrow(document.getElementById('chatText'));
      var j=await api('/api/wa/send','POST',{session_id:sid, to:to, message:txt});
      btn.disabled=false;
      if(!(j&&j.success)){ toast((j&&j.message)||'Gagal mengirim','err'); }
      else { loadStats(); _scheduleConvRefresh(); }
    }
    function _appendBubble(m){
      var body=document.getElementById('chatBody');
      var empty=body.querySelector('.chat-empty'); if(empty) body.innerHTML='';
      body.insertAdjacentHTML('beforeend', bubble(m));
      body.scrollTop=body.scrollHeight;
    }

    /* ── Kirim media ── */
    var _pendingFile=null;
    function toggleAttachMenu(){ document.getElementById('attachMenu').classList.toggle('open'); }
    function closeAttachMenu(){ document.getElementById('attachMenu').classList.remove('open'); }
    function chatOpenPicker(kind){
      closeAttachMenu();
      var id = kind==='camera'?'fileCamera':kind==='gallery'?'fileGallery':kind==='video'?'fileVideo':'fileDocument';
      var el=document.getElementById(id);
      if(el){ el.value=''; el.click(); }
    }
    function chatPickFile(input){
      var f=input.files&&input.files[0]; if(!f) return;
      // Batas 64MB — samakan dengan backend (WA Web)
      if(f.size>64*1024*1024){ toast('Ukuran file maksimal 64MB','err'); input.value=''; return; }
      _pendingFile=f;
      var prev=document.getElementById('mediaPrev');
      var type=f.type||'';
      if(/^image\//.test(type)){
        prev.innerHTML='<img src="'+URL.createObjectURL(f)+'" alt="preview">';
      } else if(/^video\//.test(type)){
        prev.innerHTML='<video src="'+URL.createObjectURL(f)+'" controls playsinline style="width:100%;height:100%;object-fit:contain;background:#000;"></video>';
      } else {
        var kb=f.size>1048576?((f.size/1048576).toFixed(1)+' MB'):Math.max(1,Math.round(f.size/1024))+' KB';
        prev.innerHTML='<div class="file-ic"><div style="font-size:38px;">📄</div><div style="font-weight:700;margin-top:6px;word-break:break-all;">'+esc(f.name)+'</div><div style="color:#7c93a0;margin-top:2px;">'+kb+'</div></div>';
      }
      document.getElementById('mediaCaption').value='';
      document.getElementById('mediaOv').classList.add('open'); document.body.style.overflow='hidden';
      input.value='';
    }
    function chatCancelMedia(){ _pendingFile=null; document.getElementById('mediaOv').classList.remove('open'); document.body.style.overflow=''; }
    async function chatSendMedia(){
      if(!_pendingFile){ toast('Tidak ada file dipilih','err'); return; }
      if(!_activeContact){ toast('Buka percakapan dulu','err'); return; }
      var sid=document.getElementById('chatSession').value;
      if(!sid){ toast('Device tidak terpilih','err'); return; }
      var cap=document.getElementById('mediaCaption').value.trim();
      var btn=document.getElementById('mediaSendBtn'); btn.disabled=true; btn.textContent='Mengirim…';
      var fd=new FormData();
      fd.append('file',_pendingFile); fd.append('session_id',sid); fd.append('to',_activeContact.number); if(cap) fd.append('caption',cap);
      var t=getToken();
      var fileType=_pendingFile.type||'';
      var objUrl=URL.createObjectURL(_pendingFile);
      try{
        var r=await fetch('/api/wa/send-media',{method:'POST',credentials:'include',headers:Object.assign({'X-Requested-With':'XMLHttpRequest'}, t?{'Authorization':'Bearer '+t}:{}),body:fd});
        if(r.status===401){ location.href='/login?next=/mobile/wa'; return; }
        var txt=await r.text(); var j=null; try{ j=txt?JSON.parse(txt):null; }catch(_){}
        if(r.ok&&j&&j.success){
          toast('Media terkirim','ok');
          var mt=/^image\//.test(fileType)?'image':(/^video\//.test(fileType)?'video':'document');
          _appendBubble({direction:'outbound',message:cap,media_url:objUrl,message_type:mt,created_at:new Date().toISOString(),status:'sent'});
          loadStats(); _scheduleConvRefresh();
          chatCancelMedia();
        } else {
          var msg=(j&&j.message)?j.message:('Gagal mengirim media'+(r.status?(' ('+r.status+')'):''));
          toast(msg,'err');
        }
      }catch(e){ toast('Gagal mengirim media: '+(e&&e.message?e.message:'jaringan'),'err'); }
      btn.disabled=false; btn.textContent='Kirim';
    }

    function showLightbox(url){ document.getElementById('lightboxImg').src=url; document.getElementById('lightbox').classList.add('open'); }

    /* ── util waktu ── */
    // Parser tanggal tahan-banting (ISO, MySQL "YYYY-MM-DD HH:mm:ss", offset).
    // WebView sering gagal parse format MySQL dengan spasi → hasilkan Invalid Date.
    function parseDate(val){
      if(!val) return null;
      if(val instanceof Date) return isNaN(val)?null:val;
      if(typeof val==='number') return new Date(val);
      var s=String(val).trim();
      var d=new Date(s); if(!isNaN(d)) return d;
      d=new Date(s.replace(' ','T')); if(!isNaN(d)) return d;
      d=new Date(s.replace(' ','T').replace(/(\+\d{2})(\d{2})$/,'$1:$2')); if(!isNaN(d)) return d;
      return null;
    }
    function _ts(m){ return (m && (m.created_at || m.createdAt || m.sent_at)) || null; }
    function _clock(ts){ var d=parseDate(ts); return d?d.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit'}):''; }
    function _day(ts){
      var d=parseDate(ts); if(!d) return '';
      var t=new Date(); var y=new Date(); y.setDate(t.getDate()-1);
      if(d.toDateString()===t.toDateString()) return 'Hari ini';
      if(d.toDateString()===y.toDateString()) return 'Kemarin';
      return d.toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'});
    }

    document.getElementById('addOv').addEventListener('click',function(e){ if(e.target===this) closeAddDevice(); });
    document.getElementById('delOv').addEventListener('click',function(e){ if(e.target===this) closeDeleteDevice(); });
    document.getElementById('mediaOv').addEventListener('click',function(e){ if(e.target===this) chatCancelMedia(); });
    document.getElementById('chatBody').addEventListener('click',function(){ closeAttachMenu(); });

    /* ══════════════ REALTIME (socket.io) ══════════════ */
    var _wsock=null, _refreshTimer=null;
    function _currentSid(){ return document.getElementById('chatSession').value || ''; }

    function setupSocket(){
      if(typeof io==='undefined') return; // socket.io client tak termuat
      try{
        _wsock = io({ auth:{ token:getToken() } });
      }catch(e){ return; }

      _wsock.onAny(function(event, data){
        var sid=_currentSid();

        // Status koneksi device berubah → segarkan daftar device + stats
        if(event.indexOf('wa:status:')===0){ loadSessions(); loadStats(); return; }
        // QR (kalau modal QR sedang terbuka utk session ini)
        if(_qrSession && event==='wa:qr:'+_qrSession && data && data.qrImage){
          document.getElementById('qrWrap').innerHTML='<img src="'+data.qrImage+'" alt="QR WhatsApp">';
          return;
        }
        if(event==='wa:session:deleted'){ loadSessions(); loadStats(); return; }
        // Rekonsiliasi: cron menaikkan pesan pending lama → sent. Segarkan thread
        // supaya jam pending berubah jadi centang tanpa perlu reload.
        if(event==='wa:reconciled'){ if(sid) _scheduleConvRefresh(); return; }

        if(!sid) return;
        if(event==='wa:message:'+sid){ loadStats(); _scheduleConvRefresh(); return; }
        if(event==='wa:ack:'+sid){ _scheduleConvRefresh(); return; }
      });
    }

    function _scheduleConvRefresh(){
      if(_refreshTimer) clearTimeout(_refreshTimer);
      _refreshTimer=setTimeout(function(){ _refreshConversationsRealtime(); }, 500);
    }
    async function _refreshConversationsRealtime(){
      var sid=_currentSid(); if(!sid) return;
      var j=await api('/api/wa/conversations?session_id='+encodeURIComponent(sid));
      if(!(j&&j.success&&Array.isArray(j.data))) return;
      MSGS=j.data;
      var map={};
      MSGS.forEach(function(m){
        var contactRaw=(m.direction==='inbound'?m.from_number:m.to_number)||'';
        var key=last9(contactRaw); if(!key) return;
        if(!map[key]){ map[key]={key:key, number:digits(contactRaw), name:null, customer:null, last:m, count:0}; }
        var g=map[key];
        var mt=parseDate(_ts(m)), gt=parseDate(_ts(g.last));
        if(mt && (!gt || mt>gt)) g.last=m;
        if(m.customer) g.customer=m.customer;
        if(!g.name && m.push_name && m.direction==='inbound') g.name=m.push_name;
        g.count++;
      });
      CONVS=Object.keys(map).map(function(k){ return map[k]; })
        .sort(function(a,b){ return (parseDate(_ts(b.last))||0)-(parseDate(_ts(a.last))||0); });
      renderConversations();
      if(_activeContact){
        var key=_activeContact.key;
        var thread=MSGS.filter(function(m){ var cr=(m.direction==='inbound'?m.from_number:m.to_number)||''; return last9(cr)===key; })
          .sort(function(a,b){ return (parseDate(_ts(a))||0)-(parseDate(_ts(b))||0); });
        var body=document.getElementById('chatBody');
        var atBottom=(body.scrollHeight-body.scrollTop-body.clientHeight)<90;
        renderThread(thread);
        if(atBottom) body.scrollTop=body.scrollHeight;
      }
    }

    setupSocket();
    loadStats(); loadSessions();

    /* Segarkan status saat halaman kembali aktif (user balik dari app lain).
       Tanpa ini, status yang tampil bisa basi setelah app lama di-background. */
    document.addEventListener('visibilitychange', function(){
      if(document.visibilityState==='visible'){ loadSessions(); loadStats(); }
    });

    /* Jaring pengaman: poll status ringan tiap 60 dtk kalau halaman terlihat.
       Socket sudah menangani sebagian besar update; ini hanya cadangan bila
       koneksi socket sempat putus. */
    setInterval(function(){
      if(document.visibilityState==='visible') loadSessions();
    }, 60000);
  </script>
</body>
</html>
