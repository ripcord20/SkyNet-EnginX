<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %> - <%= appName %></title>
  <link rel="stylesheet" href="/css/mobile-shell.css?v=7">
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    :root{--bg:#eff8ff;--card:#fff;--ink:#1F3849;--muted:#7c93a0;--line:#e2eefb;--blue:#0ea5e9;--teal:#38bdf8;--green:#38bdf8;--amber:#f5a623;--red:#f2545b;--nav-h:70px;}
    body{font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 8px);-webkit-font-smoothing:antialiased;}
    .wrap{max-width:520px;margin:0 auto;}
    .head{padding:6px 20px 14px 20px;display:flex;align-items:center;justify-content:space-between;}
    .head .htitle{font-size:20px;font-weight:800;letter-spacing:-.3px;}
    .head .hsub{font-size:12.5px;color:#6b7a97;margin-top:2px;font-weight:500;}
    .refresh{width:42px;height:42px;border-radius:14px;background:#fff;display:flex;align-items:center;justify-content:center;color:var(--blue);cursor:pointer;box-shadow:0 5px 14px -8px rgba(30,60,120,.2);}
    .refresh svg{width:19px;height:19px;} .refresh.spin svg{animation:spin 1s linear infinite;}
    @keyframes spin{to{transform:rotate(360deg);}}
    .content{padding:4px 16px 20px;}
    @keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
    .anim{opacity:0;animation:fadeUp .45s cubic-bezier(.22,.61,.36,1) forwards;}
    .dev-sel{width:100%;padding:13px 14px;border:none;background:#fff;border-radius:14px;font-size:14px;font-weight:600;font-family:inherit;color:var(--ink);outline:none;box-shadow:0 5px 14px -9px rgba(30,60,120,.16);margin-bottom:12px;}
    .toolbar{display:flex;gap:10px;margin-bottom:14px;}
    .search-wrap{position:relative;flex:1;}
    .search-wrap svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);width:17px;height:17px;color:var(--muted);}
    .search-wrap input{width:100%;padding:12px 12px 12px 38px;border:none;background:#fff;border-radius:13px;font-size:13.5px;font-family:inherit;outline:none;box-shadow:0 5px 14px -9px rgba(30,60,120,.16);}
    .add-btn{width:46px;border:none;border-radius:13px;background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 8px 18px -8px rgba(47,111,237,.5);flex-shrink:0;}
    .add-btn svg{width:22px;height:22px;stroke-width:2.5;}
    .count-bar{font-size:12px;color:var(--muted);font-weight:600;margin:0 2px 10px;}
    .list{display:flex;flex-direction:column;gap:10px;}
    .bd{background:#fff;border-radius:15px;padding:13px 15px;box-shadow:0 5px 14px -9px rgba(30,60,120,.14);}
    .bd-top{display:flex;align-items:center;gap:11px;}
    .bd-ic{width:40px;height:40px;border-radius:12px;background:#f5f7fb;color:#3a4a68;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .bd-ic svg{width:19px;height:19px;stroke-width:1.8;}
    .bd-body{flex:1;min-width:0;}
    .bd-mac{font-size:13.5px;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .bd-addr{font-size:11.5px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .bd-type{font-size:10px;font-weight:800;padding:3px 9px;border-radius:100px;flex-shrink:0;}
    .t-bypassed{background:#dcf7ec;color:#0f9d63;} .t-blocked{background:#fde5e6;color:#d13b42;} .t-regular{background:#e0f2fe;color:#0ea5e9;}
    .bd-foot{display:flex;align-items:center;gap:8px;margin-top:12px;padding-top:11px;border-top:1px solid #f2f5fa;}
    .bd-cust{display:flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;color:#0ea5e9;margin-top:9px;padding:7px 10px;background:#f2f6ff;border-radius:10px;}
    .bd-cust svg{width:14px;height:14px;flex-shrink:0;}
    .bd-status{flex:1;font-size:11.5px;font-weight:700;display:flex;align-items:center;gap:6px;}
    .bd-status .dot{width:8px;height:8px;border-radius:50%;}
    .s-on{color:#0f9d63;} .s-on .dot{background:#38bdf8;} .s-off{color:#7c93a0;} .s-off .dot{background:#c7d0e0;}
    .bd-act{display:flex;gap:7px;}
    .act-btn{width:36px;height:36px;border-radius:10px;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform .1s;}
    .act-btn:active{transform:scale(.9);} .act-btn svg{width:17px;height:17px;stroke-width:2;} .act-btn:disabled{opacity:.5;}
    .act-toggle{background:#eef4ff;color:#0ea5e9;} .act-del{background:#fde5e6;color:#d13b42;}
    .empty{padding:44px 16px;text-align:center;color:var(--muted);font-size:13px;}
    .empty svg{width:44px;height:44px;color:#c7d0e0;margin-bottom:12px;}
    .skel{background:linear-gradient(90deg,#e7edf6 25%,#f2f6fb 50%,#e7edf6 75%);background-size:200% 100%;animation:sh 1.3s infinite;border-radius:8px;}
    @keyframes sh{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
    .bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:300;background:#fff;border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);display:flex;box-shadow:0 -6px 22px rgba(30,60,120,.07);}
    .bn-wrap{max-width:520px;margin:0 auto;width:100%;display:flex;height:var(--nav-h);}
    .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-decoration:none;color:var(--muted);font-size:10px;font-weight:600;}
    .bn-item svg{width:22px;height:22px;stroke-width:2;} .bn-item.active{color:var(--cyan,#0ea5e9);}
    .bn-fab{flex:0 0 auto;width:66px;display:flex;align-items:flex-start;justify-content:center;position:relative;}
    .bn-fab a,.bn-fab button{position:absolute;font-family:inherit;padding:0;cursor:pointer;top:-22px;width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;box-shadow:0 12px 26px -6px rgba(14,165,233,.6);border:4px solid #fff;transition:transform .14s;}
    .bn-fab a:active,.bn-fab button:active{transform:scale(.92);}
    .bn-fab svg{width:26px;height:26px;stroke-width:2.6;}
    .toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 16px);background:#1F3849;color:#fff;padding:12px 20px;border-radius:13px;font-size:13px;font-weight:600;z-index:700;opacity:0;transition:opacity .25s;max-width:90vw;text-align:center;pointer-events:none;}
    .toast.show{opacity:1;} .toast.ok{background:#12946f;} .toast.err{background:#d13b42;}
    /* Bottom sheet add + confirm */
    .sh-overlay{position:fixed;inset:0;z-index:600;background:rgba(15,27,74,.5);opacity:0;visibility:hidden;transition:opacity .28s;}
    .sh-overlay.open{opacity:1;visibility:visible;}
    .sheet{position:fixed;left:0;right:0;bottom:0;z-index:601;max-width:520px;margin:0 auto;background:#f4f7fb;border-radius:26px 26px 0 0;transform:translateY(100%);transition:transform .34s cubic-bezier(.22,.61,.36,1);max-height:90vh;overflow-y:auto;padding-bottom:calc(20px + env(safe-area-inset-bottom));}
    .sheet.open{transform:translateY(0);}
    .sh-grab{width:40px;height:5px;border-radius:3px;background:#d3dbe8;margin:10px auto 6px;}
    .sh-title{font-size:17px;font-weight:800;padding:6px 20px 16px;}
    .sh-body{padding:0 18px;}
    .fld-lbl{font-size:12.5px;font-weight:700;color:#5a6885;margin:14px 2px 7px;}
    .fld-lbl:first-child{margin-top:2px;}
    .fld input,.fld select{width:100%;padding:13px 14px;border:none;background:#fff;border-radius:14px;font-size:14.5px;font-family:inherit;outline:none;box-shadow:0 4px 12px -8px rgba(30,60,120,.16);}
    .type-seg{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
    .type-opt{padding:12px 4px;border:1.5px solid var(--line);background:#fff;border-radius:12px;text-align:center;font-size:12px;font-weight:700;color:#5a6885;cursor:pointer;}
    .type-opt.sel{border-color:var(--blue);background:#e0f2fe;color:var(--blue);}
    .sh-submit{width:100%;margin-top:20px;padding:15px;border:none;border-radius:15px;background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#fff;font-family:inherit;font-size:15px;font-weight:800;cursor:pointer;box-shadow:0 12px 26px -8px rgba(47,111,237,.5);}
    .sh-submit:disabled{opacity:.5;}
    .cf{padding:6px 20px 20px;text-align:center;}
    .cf-ic{width:58px;height:58px;border-radius:17px;background:#fde5e6;color:#d13b42;display:flex;align-items:center;justify-content:center;margin:8px auto 14px;}
    .cf-ic svg{width:28px;height:28px;}
    .cf h3{font-size:17px;font-weight:800;margin-bottom:8px;} .cf p{font-size:13px;color:#5a6885;margin-bottom:18px;line-height:1.5;word-break:break-all;}
    .cf-btns{display:flex;gap:10px;} .cf-btns button{flex:1;padding:13px;border-radius:13px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;border:none;}
    .cf-cancel{background:#f0f3f9;color:#5a6885;} .cf-del{background:linear-gradient(135deg,#f2545b,#d13b42);color:#fff;}
    /* Delete dialog (center, benar-benar hidden by default) */
    .del-overlay{position:fixed;inset:0;z-index:650;background:rgba(15,27,74,.5);opacity:0;visibility:hidden;transition:opacity .22s;display:flex;align-items:center;justify-content:center;padding:24px;}
    .del-overlay.open{opacity:1;visibility:visible;}
    .del-dialog{background:#fff;border-radius:22px;max-width:340px;width:100%;transform:scale(.9);transition:transform .22s;}
    .del-overlay.open .del-dialog{transform:scale(1);}
  </style>
</head>
<body>
  <%- include('../../partials/mobile-drawer', { active: active, appName: (typeof appName!=='undefined'?appName:'FLAYNET'), user: user }) %>
  <div class="wrap">
    <div class="head">
      <div><div class="htitle">Hotspot Binding</div><div class="hsub" id="bdSub">Management IP binding hotspot</div></div>
      <div class="refresh" id="refreshBtn" onclick="loadBindings(true)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg></div>
    </div>
    <div class="content">
      <select class="dev-sel anim" id="devSel" onchange="onDeviceChange()">
        <option value="">Memuat perangkat…</option>
      </select>
      <div class="toolbar anim">
        <div class="search-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="bdSearch" placeholder="Cari MAC / IP / komentar…">
        </div>
        <button class="add-btn" onclick="openAdd()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg></button>
      </div>
      <div class="count-bar" id="countBar">–</div>
      <div class="list" id="bdList">
        <div class="bd"><div class="bd-top"><div class="skel" style="width:40px;height:40px;border-radius:12px;"></div><div class="bd-body"><div class="skel" style="width:150px;height:13px;"></div><div class="skel" style="width:100px;height:10px;margin-top:6px;"></div></div></div></div>
        <div class="bd"><div class="bd-top"><div class="skel" style="width:40px;height:40px;border-radius:12px;"></div><div class="bd-body"><div class="skel" style="width:150px;height:13px;"></div><div class="skel" style="width:100px;height:10px;margin-top:6px;"></div></div></div></div>
      </div>
    </div>
  </div>

  <!-- Add binding sheet -->
  <div class="sh-overlay" id="addOverlay" onclick="closeAdd()"></div>
  <div class="sheet" id="addSheet">
    <div class="sh-grab"></div>
    <div class="sh-title">Tambah Binding</div>
    <div class="sh-body">
      <div class="fld-lbl">Tipe binding</div>
      <div class="type-seg" id="typeSeg">
        <div class="type-opt sel" data-t="bypassed">Bypassed</div>
        <div class="type-opt" data-t="regular">Regular</div>
        <div class="type-opt" data-t="blocked">Blocked</div>
      </div>
      <div class="fld-lbl">MAC Address</div>
      <div class="fld"><input type="text" id="inMac" placeholder="AA:BB:CC:DD:EE:FF" autocapitalize="characters"></div>
      <div class="fld-lbl">IP Address (opsional)</div>
      <div class="fld"><input type="text" id="inAddr" inputmode="decimal" placeholder="mis. 192.168.1.50"></div>
      <div class="fld-lbl">Komentar (opsional)</div>
      <div class="fld"><input type="text" id="inComment" placeholder="mis. Warkop Pak Budi"></div>
      <button class="sh-submit" id="addSubmit" onclick="submitAdd()">Simpan Binding</button>
    </div>
  </div>

  <!-- Delete confirm dialog -->
  <div class="del-overlay" id="delOverlay" onclick="closeDel()">
    <div class="del-dialog" id="delDialog" onclick="event.stopPropagation()">
      <div class="cf">
        <div class="cf-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></div>
        <h3>Hapus Binding?</h3>
        <p id="delText">—</p>
        <div class="cf-btns">
          <button class="cf-cancel" onclick="closeDel()">Batal</button>
          <button class="cf-del" id="delOk" onclick="doDelete()">Hapus</button>
        </div>
      </div>
    </div>
  </div>

    <nav class="bottomnav">
    <div class="bn-wrap">
      <a class="bn-item" href="/mobile"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span><span>Beranda</span></a>
      <a class="bn-item" href="/mobile/customers"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span><span>Pelanggan</span></a>
      <div class="bn-fab"><button type="button" onclick="FabSheet.open()" aria-label="Tambah cepat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button></div>
      <a class="bn-item" href="/mobile/finance"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg></span><span>Laporan</span></a>
      <a class="bn-item" href="/mobile/monitoring"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></span><span>Monitor</span></a>
    </div>
  </nav>
  <div class="toast" id="toast"></div>

  <script>
    function getToken(){ const ls=localStorage.getItem('token'); if(ls)return ls; const m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    async function api(url,opts){ opts=opts||{}; const t=getToken(); const headers=Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}, opts.headers||{}); try{ const r=await fetch(url,Object.assign({credentials:'include',headers},opts)); if(r.status===401){location.href='/login';return null;} const x=await r.text(); let d=null; try{d=x?JSON.parse(x):null;}catch(_){}; return {status:r.status,data:d}; }catch(e){return {status:0,data:null};} }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function toast(m,t){ const el=document.getElementById('toast'); el.textContent=m; el.className='toast show'+(t?' '+t:''); setTimeout(()=>el.classList.remove('show'),2600); }

    let _device='', _bindings=[], _addType='bypassed', _delId=null, _delLabel='', _custIndex={};

    function qs(){ return _device?('?device_id='+encodeURIComponent(_device)):''; }

    // Bangun index customer berdasarkan MAC & IP untuk mencocokkan binding ↔ pelanggan CRM
    async function buildCustomerIndex(){
      const r=await api('/api/tools/hotspot/customers');
      const rows=(r.data&&r.data.success)?(Array.isArray(r.data.data)?r.data.data:[]):[];
      _custIndex={};
      rows.forEach(c=>{
        const mac=(c.mac_address||'').toUpperCase().trim();
        const ip=(c.static_ip||'').trim();
        if(mac) _custIndex['mac:'+mac]=c;
        if(ip) _custIndex['ip:'+ip]=c;
      });
    }
    function matchCustomer(b){
      const mac=(b.macAddress||'').toUpperCase().trim();
      const ip=(b.address||'').trim();
      return (mac&&_custIndex['mac:'+mac]) || (ip&&_custIndex['ip:'+ip]) || null;
    }

    async function loadDevices(){
      const r=await api('/api/devices/mikrotik-list');
      const sel=document.getElementById('devSel');
      const rows=(r.data&&r.data.success)?(Array.isArray(r.data.data)?r.data.data:(r.data.data&&r.data.data.rows?r.data.data.rows:[])):(Array.isArray(r.data)?r.data:[]);
      if(rows.length){
        sel.innerHTML=rows.map(d=>'<option value="'+d.id+'">'+esc(d.name||('Router #'+d.id))+'</option>').join('');
        _device=rows[0].id; sel.value=_device;
        await buildCustomerIndex();
        loadBindings();
      } else { sel.innerHTML='<option value="">Tidak ada perangkat MikroTik</option>'; document.getElementById('bdList').innerHTML='<div class="empty">Tidak ada perangkat MikroTik terdaftar</div>'; }
    }
    function onDeviceChange(){ _device=document.getElementById('devSel').value; loadBindings(); }

    function typeBadge(t){ t=(t||'regular').toLowerCase(); const cls=t==='bypassed'?'t-bypassed':t==='blocked'?'t-blocked':'t-regular'; return '<span class="bd-type '+cls+'">'+t+'</span>'; }
    function bdCard(b){
      const mac=b.macAddress||b['mac-address']||'—';
      const addr=[b.address, b.toAddress].filter(Boolean).join(' → ')||(b.comment||'Tanpa IP');
      const disabled=(b.disabled===true||b.disabled==='true');
      const label=mac!=='—'?mac:(b.address||b.id);
      const cust=matchCustomer(b);
      const custLine=cust?('<div class="bd-cust"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>'+esc(cust.name||'')+(cust.customer_id?(' · '+esc(cust.customer_id)):'')+'</div>'):'';
      return '<div class="bd" data-id="'+esc(b.id)+'">'+
        '<div class="bd-top">'+
          '<div class="bd-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3v4M8 3v4M2 11h20"/></svg></div>'+
          '<div class="bd-body"><div class="bd-mac">'+esc(mac)+'</div><div class="bd-addr">'+esc(addr)+(b.comment?(' · '+esc(b.comment)):'')+'</div></div>'+
          typeBadge(b.type)+
        '</div>'+
        custLine+
        '<div class="bd-foot">'+
          '<div class="bd-status '+(disabled?'s-off':'s-on')+'"><span class="dot"></span>'+(disabled?'Nonaktif':'Aktif')+'</div>'+
          '<div class="bd-act">'+
            '<button class="act-btn act-toggle" onclick="toggleBinding(\''+esc(b.id)+'\','+(!disabled)+',this)" title="'+(disabled?'Aktifkan':'Nonaktifkan')+'">'+
              (disabled?'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>')+
            '</button>'+
            '<button class="act-btn act-del" onclick="askDelete(\''+esc(b.id)+'\',\''+esc(label)+'\')" title="Hapus"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button>'+
          '</div>'+
        '</div>'+
      '</div>';
    }
    function renderBindings(filter){
      let rows=_bindings;
      if(filter){ const v=filter.toLowerCase(); rows=rows.filter(b=>((b.macAddress||'')+' '+(b.address||'')+' '+(b.comment||'')).toLowerCase().includes(v)); }
      const list=document.getElementById('bdList');
      document.getElementById('countBar').textContent=rows.length+' binding';
      if(rows.length){ list.innerHTML=rows.map(bdCard).join(''); }
      else{ list.innerHTML='<div class="empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3v4M8 3v4M2 11h20"/></svg><div>Belum ada IP binding</div></div>'; }
    }
    async function loadBindings(manual){
      if(!_device){ return; }
      const btn=document.getElementById('refreshBtn'); if(manual)btn.classList.add('spin');
      document.getElementById('bdList').innerHTML='<div class="bd"><div class="bd-top"><div class="skel" style="width:40px;height:40px;border-radius:12px;"></div><div class="bd-body"><div class="skel" style="width:150px;height:13px;"></div><div class="skel" style="width:100px;height:10px;margin-top:6px;"></div></div></div></div>';
      const r=await api('/api/tools/hotspot/bindings'+qs());
      _bindings=(r.data&&r.data.success)?(Array.isArray(r.data.data)?r.data.data:[]):[];
      renderBindings(document.getElementById('bdSearch').value.trim());
      if(manual) setTimeout(()=>btn.classList.remove('spin'),600);
    }

    let _st=null;
    document.getElementById('bdSearch').addEventListener('input',function(){ clearTimeout(_st); const v=this.value.trim(); _st=setTimeout(()=>renderBindings(v),200); });

    // Toggle enable/disable
    async function toggleBinding(id,disable,btn){
      btn.disabled=true;
      const r=await api('/api/tools/hotspot/bindings/'+encodeURIComponent(id)+'/toggle',{method:'POST',body:JSON.stringify({device_id:_device,disabled:disable})});
      if(r.data&&r.data.success){ toast(disable?'Binding dinonaktifkan':'Binding diaktifkan','ok'); loadBindings(); }
      else{ toast((r.data&&r.data.message)||'Gagal mengubah status','err'); btn.disabled=false; }
    }

    // Delete
    function askDelete(id,label){ _delId=id; _delLabel=label; document.getElementById('delText').textContent='Binding "'+label+'" akan dihapus dari router. Tindakan ini tidak bisa dibatalkan.'; document.getElementById('delOverlay').classList.add('open'); }
    function closeDel(){ document.getElementById('delOverlay').classList.remove('open'); }
    async function doDelete(){
      if(!_delId)return; const ok=document.getElementById('delOk'); ok.disabled=true; ok.textContent='Menghapus…';
      const r=await api('/api/tools/hotspot/bindings/'+encodeURIComponent(_delId)+qs(),{method:'DELETE'});
      ok.disabled=false; ok.textContent='Hapus'; closeDel();
      if(r.data&&r.data.success){ toast('Binding dihapus','ok'); loadBindings(); }
      else{ toast((r.data&&r.data.message)||'Gagal menghapus','err'); }
    }

    // Add
    function openAdd(){ document.getElementById('addOverlay').classList.add('open'); document.getElementById('addSheet').classList.add('open'); document.body.style.overflow='hidden'; }
    function closeAdd(){ document.getElementById('addOverlay').classList.remove('open'); document.getElementById('addSheet').classList.remove('open'); document.body.style.overflow=''; }
    document.getElementById('typeSeg').addEventListener('click',function(e){ const o=e.target.closest('.type-opt'); if(!o)return; this.querySelectorAll('.type-opt').forEach(x=>x.classList.remove('sel')); o.classList.add('sel'); _addType=o.dataset.t; });
    async function submitAdd(){
      const mac=document.getElementById('inMac').value.trim();
      const addr=document.getElementById('inAddr').value.trim();
      if(!mac&&!addr){ toast('Isi MAC address atau IP address','err'); return; }
      const btn=document.getElementById('addSubmit'); btn.disabled=true; btn.textContent='Menyimpan…';
      const body={ device_id:_device, mac_address:mac||undefined, address:addr||undefined, type:_addType, comment:document.getElementById('inComment').value.trim()||undefined };
      const r=await api('/api/tools/hotspot/bindings',{method:'POST',body:JSON.stringify(body)});
      btn.disabled=false; btn.textContent='Simpan Binding';
      if(r.data&&r.data.success){ toast('Binding ditambahkan','ok'); document.getElementById('inMac').value=''; document.getElementById('inAddr').value=''; document.getElementById('inComment').value=''; closeAdd(); loadBindings(); }
      else{ toast((r.data&&r.data.message)||'Gagal menambah binding','err'); }
    }

    loadDevices();
  </script>
</body>
</html>
