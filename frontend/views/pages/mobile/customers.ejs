      _afMap=L.map('afMap',{zoomControl:true,attributionControl:false}).setView(AF_DEFAULT,13);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(_afMap);
      _afMarker=L.marker(AF_DEFAULT,{draggable:true}).addTo(_afMap);
      _afMarker.on('dragend',function(){ const p=_afMarker.getLatLng(); setLatLng(p.lat,p.lng); });
      _afMap.on('click',function(e){ _afMarker.setLatLng(e.latlng); setLatLng(e.latlng.lat,e.latlng.lng); });
      _mapInit=true;
      setTimeout(()=>{ if(_afMap)_afMap.invalidateSize(); },200);
