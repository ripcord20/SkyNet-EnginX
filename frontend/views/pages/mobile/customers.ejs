    function renderComposition(d){
      const items=[
        {k:'Aktif',    v:Number(d.active)||0,    col:'#0f9d63'},
        {k:'Isolir',   v:Number(d.isolated)||0,  col:'#f5a623'},
        {k:'Suspend',  v:Number(d.suspended)||0, col:'#8b7cf6'},
        {k:'Nonaktif', v:Number(d.inactive)||0,  col:'#94a0b8'}
      ];
      const tot=items.reduce((a,b)=>a+b.v,0);
      // Donut multi-segmen
      const el=document.getElementById('compDonut');
      const R=48, C=2*Math.PI*R;
      let segs='', acc=0;
      items.forEach(function(it){
        if(it.v<=0)return;
        const frac=tot>0?it.v/tot:0;
        const len=frac*C, gap=C-len;
        const offset=-acc*C;
        segs+='<circle cx="60" cy="60" r="'+R+'" fill="none" stroke="'+it.col+'" stroke-width="12" '+
          'stroke-dasharray="'+len.toFixed(2)+' '+gap.toFixed(2)+'" stroke-dashoffset="'+offset.toFixed(2)+'" stroke-linecap="butt"/>';
        acc+=frac;
      });
      el.innerHTML='<svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="'+R+'" fill="none" stroke="#eef2f7" stroke-width="12"/>'+segs+'</svg>'+
        '<div class="comp-center"><div class="cc-tot">'+tot+'</div><div class="cc-cap">Total</div></div>';
      // Legend
      document.getElementById('compLegend').innerHTML=items.map(function(it){
        const pct=tot>0?Math.round(it.v/tot*100):0;
        return '<div class="lg-row"><span class="lg-dot" style="background:'+it.col+';"></span>'+
          '<span class="lg-name">'+it.k+'</span><span class="lg-val">'+it.v+'</span><span class="lg-pct">'+pct+'%</span></div>';
      }).join('');
    }

    // ── Chart pertumbuhan pelanggan ──
    async function loadGrowth(){
      const j=await api('/api/dashboard/customer-growth?months=12');
      if(!(j&&j.success&&j.data)){ return; }
      const rows=j.data.monthly_data||[];
      const sum=j.data.summary||{};
      const gr=Number(sum.growth_rate)||0;
      const badge=document.getElementById('growthBadge');
      badge.textContent=(gr>0?'▲ +':(gr<0?'▼ ':''))+gr+'%';
      badge.className='cc-badge'+(gr>0?' up':(gr<0?' down':''));
      drawGrowth(rows);
    }
    function drawGrowth(rows){
      const svg=document.getElementById('growthChart'); if(!svg)return;
      const W=320,H=150,padL=8,padR=8,padT=12,padB=22;
      const plotW=W-padL-padR, plotH=H-padT-padB;
      if(!rows.length){ svg.innerHTML='<text x="160" y="75" text-anchor="middle" fill="#b3bdd0" font-size="11">Belum ada data</text>'; return; }
      const cum=rows.map(r=>Number(r.cumulative_total)||0);
      const nw=rows.map(r=>Number(r.new_customers)||0);
      const n=rows.length;
      const maxC=Math.max.apply(null,cum)||1, maxN=Math.max.apply(null,nw)||1;
      const xs=i=>padL+(n>1?(i*plotW/(n-1)):plotW/2);
      const ysC=v=>padT+plotH*(1-v/maxC);
      // bar pelanggan baru (background)
      const bw=Math.max(4,Math.min(20,plotW/n*0.5));
      let bars='';
      nw.forEach(function(v,i){ const bh=(v/maxN)*(plotH*0.55); const x=xs(i)-bw/2; const y=padT+plotH-bh;
        bars+='<rect x="'+x.toFixed(1)+'" y="'+y.toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+bh.toFixed(1)+'" rx="2" fill="#e0f2fe"/>'; });
      // garis kumulatif (smooth)
      let d='M '+xs(0)+' '+ysC(cum[0]);
      for(let i=1;i<n;i++){ const x0=xs(i-1),y0=ysC(cum[i-1]),x1=xs(i),y1=ysC(cum[i]),cx=(x0+x1)/2;
        d+=' C '+cx+' '+y0+' '+cx+' '+y1+' '+x1+' '+y1; }
      const area=d+' L '+xs(n-1)+' '+(padT+plotH)+' L '+xs(0)+' '+(padT+plotH)+' Z';
      const lastX=xs(n-1), lastY=ysC(cum[n-1]);
      // label bulan (3 titik)
      let tl=''; const idxs=[0,Math.floor(n/2),n-1];
      idxs.forEach(function(ii){ const m=rows[ii]&&rows[ii].month; if(m){ const mm=m.split('-'); const lbl=mm[1]+'/'+mm[0].slice(2); tl+='<text x="'+xs(ii)+'" y="'+(H-6)+'" text-anchor="middle" font-size="8" fill="#b3bdd0">'+lbl+'</text>'; } });
      svg.innerHTML=
        '<defs><linearGradient id="gg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0ea5e9" stop-opacity=".26"/><stop offset="100%" stop-color="#0ea5e9" stop-opacity="0"/></linearGradient></defs>'+
        bars+
        '<path d="'+area+'" fill="url(#gg)"/>'+
        '<path d="'+d+'" fill="none" stroke="#0ea5e9" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>'+
        '<circle cx="'+lastX.toFixed(1)+'" cy="'+lastY.toFixed(1)+'" r="4.5" fill="#0ea5e9" opacity=".18"/>'+
        '<circle cx="'+lastX.toFixed(1)+'" cy="'+lastY.toFixed(1)+'" r="2.8" fill="#0ea5e9"/>'+
        tl;
    }


