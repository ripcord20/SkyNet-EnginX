<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %> - <%= appName %></title>
  <link rel="stylesheet" href="/css/mobile-shell.css?v=7">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    :root{
      --bg:#eff8ff; --card:#ffffff; --ink:#1F3849; --muted:#7c93a0; --line:#e2eefb;
      --blue:#0ea5e9; --blue-soft:#e0f2fe; --teal:#38bdf8; --green:#38bdf8; --amber:#f5a623; --red:#f2545b; --nav-h:70px;
    }
    body{font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);
      padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 8px);-webkit-font-smoothing:antialiased;}
    .wrap{max-width:520px;margin:0 auto;}
    .head{padding:6px 20px 14px 20px;}
    .head .htitle{font-size:20px;font-weight:800;letter-spacing:-.3px;}
    .head .hsub{font-size:12.5px;color:#6b7a97;margin-top:2px;font-weight:500;}
    .content{padding:4px 16px 20px;}

    .cst-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-bottom:14px;}
    .cst{background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:12px 6px;text-align:center;}
    .cst-click{cursor:pointer;transition:transform .12s,box-shadow .12s;}
    .cst-click:active{transform:scale(.96);}
    .cst.cst-sel{border-color:var(--blue);box-shadow:0 6px 16px -10px rgba(14,165,233,.5);}
    .cst-val{font-size:19px;font-weight:800;letter-spacing:-.5px;font-variant-numeric:tabular-nums;}
    .cst-lbl{font-size:10px;color:var(--muted);margin-top:3px;font-weight:600;}
    .search-wrap{position:relative;margin-bottom:13px;}
    .search-wrap svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:var(--muted);}
    .search-wrap input{width:100%;padding:13px 14px 13px 42px;border:none;background:#fff;border-radius:15px;font-size:14px;font-family:inherit;outline:none;box-shadow:0 5px 14px -9px rgba(30,60,120,.16);}

    .chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px;}
    .chips::-webkit-scrollbar{display:none;}
    .chip{flex-shrink:0;padding:8px 15px;border:none;background:#fff;border-radius:100px;font-size:12.5px;font-weight:700;color:#5a6885;cursor:pointer;transition:all .12s;box-shadow:0 4px 10px -7px rgba(30,60,120,.2);}
    .chip.sel{background:var(--blue);color:#fff;}
    .chip-overdue{color:#d13b42;}
    .chip-overdue.sel{background:#f2545b;color:#fff;}

    /* Overdue-specific card meta */
    .cust-due{display:flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#d13b42;margin-top:4px;}
    .cust-due svg{width:12px;height:12px;stroke-width:2.2;flex-shrink:0;}
    .badge.b-overdue{background:#fde5e6;color:#d13b42;}

    /* ── Analitik / charts ── */
    .an-wrap-static{margin-bottom:2px;}
    .rev-card{border-radius:18px;padding:17px 18px;margin-bottom:12px;color:#fff;background:linear-gradient(135deg,#0ea5e9,#0284c7);box-shadow:0 12px 26px -14px rgba(14,120,200,.5);position:relative;overflow:hidden;}
    .rev-top{font-size:11.5px;font-weight:700;opacity:.95;margin-bottom:9px;display:flex;align-items:center;gap:7px;}
    .rev-top svg{width:16px;height:16px;}
    .rev-val{font-size:27px;font-weight:800;letter-spacing:-.8px;line-height:1;}
    .rev-sub{font-size:11px;opacity:.85;margin-top:8px;font-weight:500;}
    .chart-card{background:#fff;border:1px solid #eef1f6;border-radius:16px;padding:15px 16px;margin-bottom:12px;box-shadow:0 8px 20px -15px rgba(30,60,120,.26);}
    .cc-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
    .cc-title{font-size:12.5px;font-weight:800;color:#3a4a68;}
    .cc-badge{font-size:10px;font-weight:800;padding:4px 9px;border-radius:100px;background:#e0f2fe;color:#0284c7;}
    .cc-badge.up{background:#dcf7ec;color:#0f9d63;}
    .cc-badge.down{background:#fde5e6;color:#d13b42;}
    .growth-chart{width:100%;height:150px;display:block;overflow:visible;}
    /* Donut komposisi */
    .comp-main{display:flex;align-items:center;gap:18px;}
    .comp-donut{position:relative;width:120px;height:120px;flex-shrink:0;}
    .comp-donut svg{width:120px;height:120px;transform:rotate(-90deg);}
    .comp-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
    .comp-center .cc-tot{font-size:25px;font-weight:800;letter-spacing:-.6px;line-height:1;}
    .comp-center .cc-cap{font-size:9.5px;color:var(--muted);font-weight:700;margin-top:2px;text-transform:uppercase;letter-spacing:.3px;}
    .comp-legend{flex:1;min-width:0;display:flex;flex-direction:column;gap:9px;}
    .lg-row{display:flex;align-items:center;gap:9px;font-size:12px;}
    .lg-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0;}
    .lg-name{color:#5a6885;font-weight:600;}
    .lg-val{margin-left:auto;font-weight:800;color:#3a4a68;font-variant-numeric:tabular-nums;}
    .lg-pct{color:var(--muted);font-weight:600;font-size:10.5px;min-width:34px;text-align:right;}

    .list{display:flex;flex-direction:column;gap:10px;}
    .cust{display:flex;align-items:center;gap:13px;background:#fff;border-radius:16px;padding:13px 15px;cursor:pointer;transition:transform .1s;box-shadow:0 5px 14px -9px rgba(30,60,120,.14);}
    .cust:active{transform:scale(.98);}
    .cust-av{width:44px;height:44px;border-radius:14px;background:#f5f7fb;color:#3a4a68;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;flex-shrink:0;}
    .cust-body{flex:1;min-width:0;}
    .cust-name{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .cust-meta{font-size:11.5px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .badge{display:inline-block;padding:4px 10px;border-radius:100px;font-size:10px;font-weight:800;flex-shrink:0;}
    .b-active{background:#dcf7ec;color:#0f9d63;}
    .b-isolir{background:#fde5e6;color:#d13b42;}
    .b-suspend{background:#fef1db;color:#c67d0a;}
    .b-inactive{background:#e2eefb;color:#6b7a97;}

    .empty{padding:44px 16px;text-align:center;color:var(--muted);font-size:13px;}
    .skel{background:linear-gradient(90deg,#e7edf6 25%,#f2f6fb 50%,#e7edf6 75%);background-size:200% 100%;animation:sh 1.3s infinite;border-radius:8px;}
    @keyframes sh{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
    .load-more{width:100%;padding:13px;margin-top:12px;border:none;background:#fff;border-radius:14px;font-size:13px;font-weight:700;color:var(--blue);cursor:pointer;font-family:inherit;box-shadow:0 5px 14px -9px rgba(30,60,120,.14);}

    .bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:300;background:#fff;border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);display:flex;box-shadow:0 -6px 22px rgba(30,60,120,.07);}
    /* FAB */
    .fab{position:fixed;z-index:305;bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 16px);right:calc(50% - (var(--shell-max,480px) / 2) + 18px);width:54px;height:54px;border-radius:18px;border:none;background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 12px 26px -8px rgba(47,111,237,.55);cursor:pointer;transition:transform .12s;}
    .fab:active{transform:scale(.92);} .fab svg{width:26px;height:26px;}
    @media (max-width:519.98px){ .fab{right:18px;} }
    /* Add sheet */
    .add-overlay{position:fixed;top:0;bottom:0;z-index:340;background:rgba(15,27,74,.5);opacity:0;visibility:hidden;transition:opacity .25s;}
    .add-overlay.open{opacity:1;visibility:visible;}
    /* Tinggi sheet: pakai dvh (dynamic viewport) supaya memperhitungkan address
       bar browser mobile — dengan `vh`, Safari iOS mengabaikan address bar
       sehingga bagian ATAS sheet (handle + judul) terdorong ke belakang address
       bar dan judul terlihat terpotong. `svh` dipakai sebagai batas aman.
       Padding-top header memakai safe-area untuk perangkat ber-notch. */
    .add-sheet{
      position:fixed;z-index:341;bottom:0;
      height:88vh;                 /* fallback browser lama */
      height:88svh;                /* aman: viewport terkecil (address bar tampil) */
      max-height:calc(100svh - 10px);
      background:#fff;border-radius:24px 24px 0 0;
      transition:transform .3s cubic-bezier(.22,.61,.36,1);
      display:flex;flex-direction:column;overflow:hidden;
    }
    .as-handle{width:38px;height:4px;border-radius:100px;background:#dbe2ec;margin:10px auto 4px;flex-shrink:0;}
    .as-head{display:flex;align-items:center;justify-content:space-between;padding:6px 20px 12px;border-bottom:1px solid #f0f3f8;flex-shrink:0;background:#fff;}
    .as-head h3{font-size:17px;font-weight:800;}
    .as-close{width:34px;height:34px;border-radius:10px;border:none;background:#f4f6fa;color:#5a6885;display:flex;align-items:center;justify-content:center;cursor:pointer;} .as-close svg{width:18px;height:18px;}
    .as-body{flex:1;overflow-y:auto;padding:16px 20px;}
    .as-sec{font-size:12px;font-weight:800;color:var(--blue);text-transform:uppercase;letter-spacing:.4px;margin:16px 0 10px;} .as-sec:first-child{margin-top:0;}
    .as-lbl{display:block;font-size:12px;font-weight:600;color:#5a6885;margin-bottom:6px;} .as-lbl .req{color:var(--red);}
    .as-in{width:100%;padding:12px 13px;border:1px solid #e6ebf3;background:#fbfcfe;border-radius:12px;font-size:14px;font-family:inherit;color:var(--ink);outline:none;margin-bottom:13px;transition:border .12s;}
    .as-in:focus{border-color:var(--blue);background:#fff;}
    textarea.as-in{resize:vertical;}
    .as-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    .as-hint{font-size:11.5px;color:#7c93a0;line-height:1.5;margin:-4px 0 12px;}
    .as-geo{width:100%;padding:11px;border:1px dashed #bcd0f7;background:#f2f6ff;color:var(--blue);border-radius:12px;font-family:inherit;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:6px;} .as-geo svg{width:16px;height:16px;}
    .as-maphint{font-size:11px;color:var(--muted);margin-bottom:9px;}
    .af-map{width:100%;height:200px;border-radius:14px;border:1px solid #e6ebf3;overflow:hidden;margin-bottom:12px;z-index:1;}
    .af-map .leaflet-control-attribution{display:none;}
    .as-check{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:600;color:#3a4a68;cursor:pointer;padding:9px 0;}
    .as-check input{display:none;}
    .as-cbox{width:22px;height:22px;border-radius:7px;border:2px solid #cdd6e4;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .12s;}
    .as-check input:checked + .as-cbox{background:var(--blue);border-color:var(--blue);}
    .as-check input:checked + .as-cbox::after{content:'';width:5px;height:9px;border:solid #fff;border-width:0 2.5px 2.5px 0;transform:rotate(45deg);margin-top:-2px;}
    .as-foot{display:flex;gap:10px;padding:14px 20px calc(16px + env(safe-area-inset-bottom));border-top:1px solid #f0f3f8;flex-shrink:0;}
    .as-foot button{flex:1;padding:14px;border-radius:13px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;border:none;}
    .as-cancel{flex:0 0 90px;background:#f0f3f9;color:#5a6885;}
    .as-save{background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#fff;}
    .as-save:disabled{opacity:.6;}
    .toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 16px);background:#1F3849;color:#fff;padding:12px 20px;border-radius:13px;font-size:13px;font-weight:600;z-index:400;opacity:0;transition:opacity .25s;pointer-events:none;max-width:88vw;text-align:center;}
    .toast.show{opacity:1;} .toast.ok{background:#12946f;} .toast.err{background:#d13b42;}
    .bn-wrap{max-width:520px;margin:0 auto;width:100%;display:flex;height:var(--nav-h);}
    .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-decoration:none;color:var(--muted);font-size:10px;font-weight:600;cursor:pointer;}
    .bn-item svg{width:22px;height:22px;stroke-width:2;}
    .bn-item.active{color:var(--cyan,#0ea5e9);}
    .bn-fab{flex:0 0 auto;width:66px;display:flex;align-items:flex-start;justify-content:center;position:relative;}
    .bn-fab a,.bn-fab button{position:absolute;font-family:inherit;padding:0;cursor:pointer;top:-22px;width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;box-shadow:0 12px 26px -6px rgba(14,165,233,.6);border:4px solid #fff;transition:transform .14s;}
    .bn-fab a:active,.bn-fab button:active{transform:scale(.92);}
    .bn-fab svg{width:26px;height:26px;stroke-width:2.6;}

    /* Detail modal (bottom sheet) */
    /* CATATAN: posisi (left/transform/max-width) overlay & sheet diatur di
       mobile-shell.css — SATU sumber kebenaran. Di sini hanya tampilan. */
    .dm-overlay{position:fixed;top:0;bottom:0;z-index:600;background:rgba(15,27,74,.5);opacity:0;visibility:hidden;transition:opacity .28s;}
    .dm-overlay.open{opacity:1;visibility:visible;}
    .dm-sheet{position:fixed;bottom:0;z-index:601;background:#f4f7fb;border-radius:26px 26px 0 0;transition:transform .34s cubic-bezier(.22,.61,.36,1);max-height:88vh;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;padding-bottom:calc(20px + env(safe-area-inset-bottom));}
    /* Header sheet: handle + tombol tutup. Dibuat sebagai baris flex yang
       menempel (sticky) di atas sheet — BUKAN position:absolute, agar tidak
       pernah salah posisi karena containing-block/transform pada sheet. */
    .dm-top{position:sticky;top:0;z-index:6;background:#f4f7fb;padding:8px 12px 6px;display:flex;align-items:center;justify-content:flex-end;border-radius:26px 26px 0 0;}
    .dm-grab{position:absolute;left:50%;transform:translateX(-50%);top:10px;width:40px;height:5px;border-radius:3px;background:#d3dbe8;}
    .dm-close{position:relative;z-index:7;width:36px;height:36px;border-radius:12px;border:none;background:#fff;color:#3a4a68;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 3px 10px -4px rgba(30,60,120,.3);flex-shrink:0;}
    .dm-close svg{width:18px;height:18px;}
    .dm-close:active{background:#e2eefb;}
    .dm-live{display:flex;align-items:center;gap:5px;font-size:9.5px;font-weight:800;color:#f2545b;letter-spacing:.5px;}
    .dm-ld{width:7px;height:7px;border-radius:50%;background:#f2545b;animation:dmpulse 1.4s infinite;}
    @keyframes dmpulse{0%,100%{opacity:1;}50%{opacity:.3;}}
    .dm-rt-legend{display:flex;gap:16px;margin-bottom:8px;}
    .dm-rt-legend span{font-size:11px;color:#7c93a0;display:flex;align-items:center;gap:5px;}
    .dm-rt-legend i{width:9px;height:9px;border-radius:2px;display:inline-block;}
    .dm-rt-legend b{color:#1F3849;font-size:12px;font-variant-numeric:tabular-nums;}
    .dm-rt-chart{width:100%;height:120px;display:block;overflow:visible;}
    .dm-rt-empty{font-size:12px;color:#7c93a0;text-align:center;padding:24px 8px;}
    .dm-map{width:100%;height:180px;z-index:1;}
    .dm-map-link{display:block;text-align:center;padding:11px;font-size:12.5px;font-weight:700;color:#0ea5e9;text-decoration:none;border-top:1px solid #f0f3f8;}
    .dm-hero{padding:14px 20px 18px;display:flex;align-items:center;gap:14px;}
    .dm-av{width:56px;height:56px;border-radius:17px;background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:22px;flex-shrink:0;}
    .dm-name{font-size:18px;font-weight:800;letter-spacing:-.3px;}
    .dm-cid{font-size:12.5px;color:var(--muted);margin-top:2px;}
    .dm-body{padding:0 16px;}
    .dm-card{background:#fff;border-radius:16px;padding:4px 16px;margin-bottom:12px;box-shadow:0 5px 14px -10px rgba(30,60,120,.14);}
    .dm-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #f2f5fa;}
    .dm-row:last-child{border-bottom:none;}
    .dm-k{font-size:12.5px;color:var(--muted);font-weight:500;flex-shrink:0;}
    .dm-v{font-size:13.5px;font-weight:700;text-align:right;word-break:break-word;}
    .dm-sec{font-size:12px;font-weight:800;color:#8a95ad;text-transform:uppercase;letter-spacing:.5px;margin:4px 4px 8px;}
    .dm-actions{display:flex;gap:10px;padding:6px 16px 4px;flex-wrap:wrap;}
    .dm-actions .dm-btn{flex:1 1 calc(50% - 5px);min-width:calc(50% - 5px);}
    .dm-btn{padding:13px 8px;border-radius:14px;font-family:inherit;font-size:13px;font-weight:700;cursor:pointer;border:none;display:flex;align-items:center;justify-content:center;gap:6px;text-decoration:none;white-space:nowrap;}
    .dm-btn svg{width:16px;height:16px;stroke-width:2;flex-shrink:0;}
    .dm-btn-edit{background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#fff;}
    .dm-btn svg{width:17px;height:17px;stroke-width:2;}
    .dm-btn-pay{background:linear-gradient(135deg,#38bdf8,#0369a1);color:#fff;}
    .dm-btn-wa{background:#fff;color:#1fa855;box-shadow:0 4px 12px -8px rgba(30,60,120,.2);}
    .dm-btn-isolir{background:#fdecec;color:#d13b42;}
    .dm-btn-restore{background:#dcf7ec;color:#0f9d63;}
    /* Riwayat pembayaran */
    .dm-pay-load{padding:16px;text-align:center;color:#9aa7bd;font-size:12.5px;}
    /* Ringkasan pembayaran */
    .pay-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:12px;}
    .ps-box{background:#fff;border:1px solid #eef1f6;border-radius:13px;padding:12px 6px;text-align:center;box-shadow:0 5px 14px -11px rgba(30,60,120,.16);}
    .ps-box.warn{background:#fff6f6;border-color:#fbdcdc;}
    .ps-val{font-size:18px;font-weight:800;letter-spacing:-.4px;color:#1a2b4a;font-variant-numeric:tabular-nums;}
    .ps-box.warn .ps-val{color:#d13b42;}
    .ps-val.ps-rp{font-size:14px;}
    .ps-lbl{font-size:9.5px;color:#8a95ad;margin-top:3px;font-weight:700;}
    /* Header dalam kartu */
    .pay-head{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;padding:10px 0 8px;border-bottom:1px solid #f1f4f9;margin-bottom:2px;}
    .pay-head-red{color:#d13b42;} .pay-head-green{color:#0f9d63;}
    .pay-row{display:flex;align-items:center;gap:11px;padding:11px 0;border-bottom:1px solid #f4f7fb;}
    .pay-row:last-child{border-bottom:none;}
    .pay-ic{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .pay-ic svg{width:16px;height:16px;stroke-width:2.4;}
    .pay-ic.paid{background:#dcf7ec;color:#0f9d63;} .pay-ic.ov{background:#fdecec;color:#d13b42;} .pay-ic.un{background:#fef1db;color:#c67d0a;}
    .pay-per{font-size:13px;font-weight:700;color:#1a2b4a;}
    .pay-sub{font-size:11px;color:#7c93a0;margin-top:2px;} .pay-sub.red{color:#d13b42;font-weight:700;}
    .pay-amt{font-size:13px;font-weight:800;color:#1a2b4a;flex-shrink:0;font-variant-numeric:tabular-nums;} .pay-amt.green{color:#0f9d63;}
    .dm-pay-row{display:flex;align-items:center;gap:11px;padding:10px 0;border-bottom:1px solid #f4f7fb;}
    .dm-pay-row:last-child{border-bottom:none;}
    .dm-pay-ic{width:30px;height:30px;border-radius:9px;background:#dcf7ec;color:#0f9d63;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .dm-pay-ic svg{width:15px;height:15px;stroke-width:2.5;}
    .dm-pay-amt{font-size:13.5px;font-weight:800;color:#1a2b4a;}
    .dm-pay-sub{font-size:11px;color:#7c93a0;margin-top:2px;}
    .dm-badge{display:inline-block;padding:4px 11px;border-radius:100px;font-size:11px;font-weight:800;}
    .dm-skel{padding:40px;text-align:center;color:var(--muted);font-size:13px;}
  </style>
</head>
<body>
  <%- include('../../partials/mobile-drawer', { active: active, appName: (typeof appName!=='undefined'?appName:'FLAYNET'), user: user }) %>
  <div class="wrap">
    <div class="head">
      <div class="htitle">Pelanggan</div>
      <div class="hsub" id="custCount">Memuat…</div>
    </div>
    <div class="content">
      <div class="cst-grid" id="custStats">
        <div class="cst cst-click" onclick="applyFilter('')"><div class="cst-val" id="csTotal">–</div><div class="cst-lbl">Total</div></div>
        <div class="cst cst-click" onclick="applyFilter('active')"><div class="cst-val" id="csActive" style="color:var(--green);">–</div><div class="cst-lbl">Aktif</div></div>
        <div class="cst cst-click" onclick="applyFilter('isolated')"><div class="cst-val" id="csIsolir" style="color:var(--amber);">–</div><div class="cst-lbl">Isolir</div></div>
        <div class="cst cst-click" onclick="applyFilter('overdue')"><div class="cst-val" id="csOverdue" style="color:var(--red);">–</div><div class="cst-lbl">Nunggak</div></div>
      </div>

      <div class="an-wrap-static">
        <div class="rev-card">
          <div class="rev-top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>Estimasi Pendapatan Bulanan</div>
          <div class="rev-val" id="revVal">–</div>
          <div class="rev-sub" id="revSub">dari pelanggan aktif</div>
        </div>

        <div class="chart-card">
          <div class="cc-head">
            <span class="cc-title">Pertumbuhan Pelanggan</span>
            <span class="cc-badge" id="growthBadge">–</span>
          </div>
          <svg class="growth-chart" id="growthChart" viewBox="0 0 320 150" preserveAspectRatio="none"></svg>
        </div>

        <div class="chart-card">
          <div class="cc-head"><span class="cc-title">Komposisi Status</span></div>
          <div class="comp-main">
            <div class="comp-donut" id="compDonut"></div>
            <div class="comp-legend" id="compLegend"></div>
          </div>
        </div>
      </div>

      <div class="search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchInput" placeholder="Cari nama, CID, atau nomor…">
      </div>
      <div class="chips" id="filterChips">
        <div class="chip sel" data-status="">Semua</div>
        <div class="chip" data-status="active">Aktif</div>
        <div class="chip" data-status="isolated">Isolir</div>
        <div class="chip" data-status="suspended">Suspend</div>
        <div class="chip" data-status="inactive">Nonaktif</div>
        <div class="chip chip-overdue" data-status="overdue">Nunggak</div>
      </div>
      <div class="list" id="custList">
        <div class="cust"><div class="skel" style="width:44px;height:44px;border-radius:14px;"></div><div class="cust-body"><div class="skel" style="width:140px;height:14px;"></div><div class="skel" style="width:100px;height:11px;margin-top:6px;"></div></div></div>
        <div class="cust"><div class="skel" style="width:44px;height:44px;border-radius:14px;"></div><div class="cust-body"><div class="skel" style="width:140px;height:14px;"></div><div class="skel" style="width:100px;height:11px;margin-top:6px;"></div></div></div>
        <div class="cust"><div class="skel" style="width:44px;height:44px;border-radius:14px;"></div><div class="cust-body"><div class="skel" style="width:140px;height:14px;"></div><div class="skel" style="width:100px;height:11px;margin-top:6px;"></div></div></div>
      </div>
    </div>
  </div>

  <button class="fab" onclick="openAdd()" aria-label="Tambah pelanggan">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
  </button>

    <nav class="bottomnav">
    <div class="bn-wrap">
      <a class="bn-item" href="/mobile"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span><span>Beranda</span></a>
      <a class="bn-item" href="/mobile/customers"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span><span>Pelanggan</span></a>
      <div class="bn-fab"><button type="button" onclick="FabSheet.open()" aria-label="Tambah cepat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button></div>
      <a class="bn-item" href="/mobile/finance"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg></span><span>Laporan</span></a>
      <a class="bn-item" href="/mobile/monitoring"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></span><span>Monitor</span></a>
    </div>
  </nav>

  <!-- Detail pelanggan (bottom sheet) -->
  <div class="dm-overlay" id="dmOverlay" onclick="closeDetail()"></div>
  <div class="dm-sheet" id="dmSheet">
    <div class="dm-top">
      <div class="dm-grab"></div>
      <button class="dm-close" onclick="closeDetail()" aria-label="Tutup">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="dmContent"><div class="dm-skel">Memuat detail…</div></div>
  </div>

  <script>
    function getToken(){ const ls=localStorage.getItem('token'); if(ls)return ls; const m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    async function api(url){ const t=getToken(); const headers=Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}); try{ const r=await fetch(url,{credentials:'include',headers}); if(r.status===401){location.href='/login';return null;} const x=await r.text(); try{return x?JSON.parse(x):null;}catch(_){return null;} }catch(e){return null;} }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    let _status='',_search='',_page=1,_loading=false; const PAGE_SIZE=20;
    function statusBadge(st){ st=(st||'').toLowerCase(); if(st==='active')return '<span class="badge b-active">Aktif</span>'; if(st==='isolated'||st==='isolir')return '<span class="badge b-isolir">Isolir</span>'; if(st==='suspended')return '<span class="badge b-suspend">Suspend</span>'; return '<span class="badge b-inactive">Nonaktif</span>'; }
    function fmtRpShort(n){ n=Number(n)||0; if(n>=1000000)return 'Rp '+(n/1000000).toFixed(n%1000000?1:0).replace('.0','')+'jt'; if(n>=1000)return 'Rp '+Math.round(n/1000)+'rb'; return 'Rp '+n.toLocaleString('id-ID'); }
    function overdueDays(dueStr){
      if(!dueStr)return 0;
      const due=new Date(dueStr+'T00:00:00'); if(isNaN(due))return 0;
      const today=new Date(); today.setHours(0,0,0,0);
      return Math.max(0, Math.round((today-due)/86400000));
    }
    function custCard(c){
      const nm=c.name||'Pelanggan'; const cid=c.customer_id||c.cid||('#'+(c.id||'')); const pkg=(c.package&&c.package.name)||c.package_name||'';
      const init=(nm[0]||'?').toUpperCase(); const meta=[cid,pkg].filter(Boolean).join(' · ');
      const isOverdue=(c.latest_invoice_status==='overdue');
      let extra='', badge=statusBadge(c.status);
      if(isOverdue){
        const days=overdueDays(c.latest_due_date);
        const inv=c.latest_invoice||{};
        const amt=(inv.total!=null?inv.total:(inv.amount!=null?inv.amount:null)) ?? ((c.package&&c.package.price)||c.package_price||0);
        const parts=[];
        if(days>0)parts.push('Telat '+days+' hari');
        if(amt)parts.push(fmtRpShort(amt));
        extra='<div class="cust-due"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'+esc(parts.join(' · ')||'Menunggak')+'</div>';
        badge='<span class="badge b-overdue">Nunggak</span>';
      }
      return '<div class="cust" onclick="openDetail('+c.id+')"><div class="cust-av">'+esc(init)+'</div><div class="cust-body"><div class="cust-name">'+esc(nm)+'</div><div class="cust-meta">'+esc(meta)+'</div>'+extra+'</div>'+badge+'</div>';
    }
    async function loadCustomers(reset){
      if(_loading)return; _loading=true; if(reset){_page=1;}
      const qs=new URLSearchParams(); qs.set('page',_page); qs.set('limit',PAGE_SIZE);
      if(_status)qs.set('status',_status); if(_search)qs.set('search',_search);
      const j=await api('/api/customers?'+qs.toString());
      const list=document.getElementById('custList');
      const rows=(j&&j.success)?(j.data&&j.data.rows?j.data.rows:(Array.isArray(j.data)?j.data:[])):[];
      const total=(j&&j.data&&(j.data.total!=null))?j.data.total:null;
      if(reset)list.innerHTML='';
      const old=document.getElementById('loadMoreBtn'); if(old)old.remove();
      if(rows.length){
        list.insertAdjacentHTML('beforeend', rows.map(custCard).join(''));
        if(total!=null)document.getElementById('custCount').textContent=total+' pelanggan';
        if(rows.length>=PAGE_SIZE){ const b=document.createElement('button'); b.id='loadMoreBtn'; b.className='load-more'; b.textContent='Muat lebih banyak'; b.onclick=function(){_page++;loadCustomers(false);}; list.parentNode.appendChild(b); }
      } else if(reset){
        var lbl={active:'Aktif',isolated:'Isolir',suspended:'Suspend',inactive:'Nonaktif',overdue:'Nunggak'}[_status]||'';
        var msg = _search ? ('Tidak ada hasil untuk "'+_search+'"')
                : (_status==='overdue' ? 'Tidak ada pelanggan yang menunggak 🎉'
                : (lbl ? ('Belum ada pelanggan berstatus '+lbl) : 'Tidak ada pelanggan ditemukan'));
        list.innerHTML='<div class="empty">'+msg+'</div>';
        document.getElementById('custCount').textContent='0 pelanggan';
      }
      _loading=false;
    }

    // Sinkronkan status filter di chip + highlight KPI, lalu muat ulang.
    function syncFilterUI(){
      document.querySelectorAll('#filterChips .chip').forEach(function(c){
        c.classList.toggle('sel', (c.dataset.status||'')===_status);
      });
      const map={'':0,'active':1,'isolated':2,'overdue':3};
      const cards=document.querySelectorAll('#custStats .cst');
      cards.forEach(c=>c.classList.remove('cst-sel'));
      if(map[_status]!=null && cards[map[_status]]) cards[map[_status]].classList.add('cst-sel');
    }
    function applyFilter(status){ _status=status||''; syncFilterUI(); loadCustomers(true); }

    document.getElementById('filterChips').addEventListener('click',function(e){ const chip=e.target.closest('.chip'); if(!chip)return; _status=chip.dataset.status||''; syncFilterUI(); loadCustomers(true); });
    let _t=null; document.getElementById('searchInput').addEventListener('input',function(){ clearTimeout(_t); const v=this.value.trim(); _t=setTimeout(()=>{_search=v;loadCustomers(true);},350); });

    // ── Detail pelanggan (popup) ──
    function fmtRp(n){ n=Number(n)||0; return 'Rp '+n.toLocaleString('id-ID'); }
    function fmtDateLong(s){ if(!s)return'–'; const d=new Date(s); if(isNaN(d))return String(s).slice(0,10); return d.toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}); }
    function stBadgeBig(st){ st=(st||'').toLowerCase(); const map={active:['Aktif','#dcf7ec','#0f9d63'],isolated:['Isolir','#fde5e6','#d13b42'],isolir:['Isolir','#fde5e6','#d13b42'],suspended:['Suspend','#fef1db','#c67d0a']}; const v=map[st]||['Nonaktif','#e2eefb','#6b7a97']; return '<span class="dm-badge" style="background:'+v[1]+';color:'+v[2]+';">'+v[0]+'</span>'; }

    function openDetail(id){
      document.getElementById('dmContent').innerHTML='<div class="dm-skel">Memuat detail…</div>';
      document.getElementById('dmOverlay').classList.add('open');
      document.getElementById('dmSheet').classList.add('open');
      document.body.style.overflow='hidden';
      loadDetail(id);
    }
    function closeDetail(){
      document.getElementById('dmOverlay').classList.remove('open');
      document.getElementById('dmSheet').classList.remove('open');
      document.body.style.overflow='';
      stopDetailTraffic();
    }
    async function loadDetail(id){
      const j=await api('/api/customers/'+id);
      if(!j||!j.success||!j.data){ document.getElementById('dmContent').innerHTML='<div class="dm-skel">Gagal memuat detail pelanggan</div>'; return; }
      const c=j.data;
      const nm=c.name||'Pelanggan'; const init=(nm[0]||'?').toUpperCase();
      const pkg=(c.package&&c.package.name)||c.package_name||'–';
      const price=(c.package&&c.package.price)||c.price||0;
      const conn=(c.connection_type||'').toUpperCase();
      const ipInfo=c.static_ip||c.pppoe_username||'–';
      const dueDate=c.latest_due_date||c.due_date;
      const dueStatus=c.latest_invoice_status||c.status;
      const phone=(c.phone||'').replace(/[^0-9]/g,'');
      const waPhone=phone.replace(/^0/,'62');

      // hitung masa aktif dari due_date (jika ada)
      let aktifSampai='–';
      if(dueDate){ aktifSampai=fmtDateLong(dueDate); }

      function row(k,v){ return '<div class="dm-row"><span class="dm-k">'+k+'</span><span class="dm-v">'+v+'</span></div>'; }

      let html='';
      html+='<div class="dm-hero"><div class="dm-av">'+esc(init)+'</div><div style="min-width:0;"><div class="dm-name">'+esc(nm)+'</div><div class="dm-cid">'+esc(c.customer_id||('#'+c.id))+'</div><div style="margin-top:6px;">'+stBadgeBig(c.status)+'</div></div></div>';

      html+='<div class="dm-body">';

      // Kontak
      html+='<div class="dm-sec">Kontak</div><div class="dm-card">';
      html+=row('Telepon', esc(c.phone||'–'));
      if(c.email) html+=row('Email', esc(c.email));
      if(c.address) html+=row('Alamat', esc(c.address));
      const wilayah=[c.village,c.district,c.regency,c.province].filter(Boolean).join(', ');
      if(wilayah) html+=row('Wilayah', esc(wilayah));
      html+='</div>';

      // Peta lokasi
      const lat=parseFloat(c.latitude), lng=parseFloat(c.longitude);
      if(!isNaN(lat)&&!isNaN(lng)&&lat!==0&&lng!==0){
        html+='<div class="dm-sec">Lokasi</div><div class="dm-card" style="padding:0;overflow:hidden;"><div id="dmMap" class="dm-map"></div><a class="dm-map-link" href="https://www.google.com/maps?q='+lat+','+lng+'" target="_blank" rel="noopener">Buka di Google Maps →</a></div>';
      }

      // Layanan
      html+='<div class="dm-sec">Layanan</div><div class="dm-card">';
      html+=row('Paket', esc(pkg));
      if(price) html+=row('Harga', fmtRp(price));
      if(conn) html+=row('Koneksi', esc(conn));
      html+=row('IP / PPPoE', esc(ipInfo));
      if(c.mikrotik&&c.mikrotik.name) html+=row('Router', esc(c.mikrotik.name));
      html+='</div>';

      // Tagihan / masa aktif
      html+='<div class="dm-sec">Tagihan & Aktivasi</div><div class="dm-card">';
      const installDate=c.installation_date||c.created_at;
      if(installDate) html+=row('Tgl. Aktivasi / Instalasi', fmtDateLong(installDate));
      html+=row('Aktif sampai', '<span style="color:#0f9d63;">'+aktifSampai+'</span>');
      html+=row('Status tagihan', stBadgeBig(dueStatus==='active'?'active':dueStatus));
      html+='</div>';

      // Riwayat pembayaran (diisi async)
      html+=renderPaymentSection(c);

      // Real-time traffic (paling bawah)
      html+='<div class="dm-sec">Traffic Real-time</div>';
      html+='<div class="dm-card" style="padding:14px 15px;">'+
        '<div class="dm-rt-legend"><span><i style="background:#0ea5e9;"></i>Download <b id="dmRxVal">–</b></span><span><i style="background:#38bdf8;"></i>Upload <b id="dmTxVal">–</b></span></div>'+
        '<svg class="dm-rt-chart" id="dmRtChart" viewBox="0 0 320 110" preserveAspectRatio="xMidYMid meet"></svg>'+
        '<div class="dm-rt-empty" id="dmRtEmpty" style="display:none;">Data traffic tidak tersedia (pelanggan mungkin offline)</div>'+
      '</div>';
      html+='</div>';

      // Actions
      html+='<div class="dm-actions">';
      html+='<button class="dm-btn dm-btn-edit" onclick="openEdit('+c.id+')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>Edit</button>';
      html+='<a class="dm-btn dm-btn-pay" href="/mobile/payment-new"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>Catat Bayar</a>';
      if(waPhone) html+='<a class="dm-btn dm-btn-wa" href="https://wa.me/'+waPhone+'" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>WhatsApp</a>';
      // Aksi isolir / aktifkan (toggle berdasarkan status)
      const isIso=(c.status==='isolated'||c.status==='isolir');
      if(isIso){
        html+='<button class="dm-btn dm-btn-restore" onclick="doIsolirToggle('+c.id+',false,\''+esc(nm).replace(/\x27/g,"")+'\')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>Aktifkan</button>';
      } else {
        html+='<button class="dm-btn dm-btn-isolir" onclick="doIsolirToggle('+c.id+',true,\''+esc(nm).replace(/\x27/g,"")+'\')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>Isolir</button>';
      }
      html+='</div>';

      document.getElementById('dmContent').innerHTML=html;

      // Init peta lokasi
      if(!isNaN(lat)&&!isNaN(lng)&&lat!==0&&lng!==0){
        setTimeout(function(){
          if(typeof L==='undefined')return;
          try{
            const m=L.map('dmMap',{zoomControl:false,attributionControl:false,dragging:true}).setView([lat,lng],16);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(m);
            L.marker([lat,lng]).addTo(m);
            setTimeout(()=>m.invalidateSize(),150);
          }catch(e){}
        },300);
      }

      // Mulai polling traffic real-time untuk pelanggan ini
      startDetailTraffic(c.id, c.status);
    }

    // Nama bulan Indonesia
    const _BLN=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
    function periodeLabel(m,y){ if(!m||!y)return ''; return (_BLN[(m-1)%12]||m)+' '+y; }

    // ── Bagian pembayaran (dari c.invoices yang sudah di-fetch) ──
    function renderPaymentSection(c){
      const invs=Array.isArray(c.invoices)?c.invoices.slice():[];
      if(!invs.length){
        return '<div class="dm-sec">Riwayat Pembayaran</div><div class="dm-card"><div class="dm-pay-load">Belum ada data tagihan</div></div>';
      }
      // Pisahkan lunas vs belum (unpaid/overdue)
      const unpaid=invs.filter(function(i){ return i.status==='unpaid'||i.status==='overdue'; });
      const paid=invs.filter(function(i){ return i.status==='paid'; });
      const today=new Date(); today.setHours(0,0,0,0);
      // Total tunggakan
      let totalNunggak=0; unpaid.forEach(function(i){ totalNunggak+=Number(i.total!=null?i.total:i.amount)||0; });

      let h='<div class="dm-sec">Tagihan & Pembayaran</div>';

      // Ringkasan
      h+='<div class="pay-summary">';
      h+='<div class="ps-box'+(unpaid.length?' warn':'')+'"><div class="ps-val">'+unpaid.length+'</div><div class="ps-lbl">Tunggakan</div></div>';
      h+='<div class="ps-box"><div class="ps-val">'+paid.length+'</div><div class="ps-lbl">Lunas</div></div>';
      h+='<div class="ps-box"><div class="ps-val ps-rp">'+fmtRpShort(totalNunggak)+'</div><div class="ps-lbl">Nilai nunggak</div></div>';
      h+='</div>';

      // Daftar tunggakan (kalau ada)
      if(unpaid.length){
        h+='<div class="dm-card" style="margin-bottom:12px;">';
        h+='<div class="pay-head pay-head-red">Belum Dibayar</div>';
        unpaid.sort(function(a,b){ return (a.period_year*12+a.period_month)-(b.period_year*12+b.period_month); });
        unpaid.forEach(function(i){
          const amt=Number(i.total!=null?i.total:i.amount)||0;
          const dd=i.due_date?new Date(i.due_date+'T00:00:00'):null;
          const isOv=(dd&&dd<today)||i.status==='overdue';
          let days=''; if(dd){ const dif=Math.round((today-dd)/86400000); if(dif>0)days='Telat '+dif+' hari'; else if(dif===0)days='Jatuh tempo hari ini'; else days='Tempo '+fmtDateLong(i.due_date); }
          h+='<div class="pay-row">'
            + '<div class="pay-ic '+(isOv?'ov':'un')+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>'
            + '<div style="flex:1;min-width:0;"><div class="pay-per">'+esc(periodeLabel(i.period_month,i.period_year)||i.invoice_number||'Invoice')+'</div>'
            +   '<div class="pay-sub '+(isOv?'red':'')+'">'+esc(days||(isOv?'Lewat tempo':'Belum bayar'))+'</div></div>'
            + '<div class="pay-amt">'+fmtRp(amt)+'</div></div>';
        });
        h+='</div>';
      }

      // Riwayat lunas
      h+='<div class="dm-card">';
      h+='<div class="pay-head pay-head-green">Sudah Lunas</div>';
      if(paid.length){
        paid.sort(function(a,b){ return new Date(b.paid_date||b.due_date||0)-new Date(a.paid_date||a.due_date||0); });
        paid.forEach(function(i){
          const amt=Number(i.total!=null?i.total:i.amount)||0;
          const pd=i.paid_date?fmtDateLong(i.paid_date):'';
          h+='<div class="pay-row">'
            + '<div class="pay-ic paid"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>'
            + '<div style="flex:1;min-width:0;"><div class="pay-per">'+esc(periodeLabel(i.period_month,i.period_year)||i.invoice_number||'Invoice')+'</div>'
            +   '<div class="pay-sub">'+(pd?('Dibayar '+esc(pd)):'Lunas')+'</div></div>'
            + '<div class="pay-amt green">'+fmtRp(amt)+'</div></div>';
        });
      } else {
        h+='<div class="dm-pay-load">Belum ada pembayaran lunas</div>';
      }
      h+='</div>';
      return h;
    }

