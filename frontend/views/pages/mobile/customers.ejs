    /* Jatuh tempo otomatis = tanggal aktivasi + 1 bulan (tanggal sama).
       Meniru onActivationDateChange() di desktop: hanya auto-isi saat MODE
       TAMBAH dan jatuh tempo belum diisi — supaya tidak menimpa isian manual
       admin atau data lama saat edit. */
    function onActivationDateChange(){
      const actEl=document.getElementById('afInstallDate');
      const dueEl=document.getElementById('afDueDate');
      if(!actEl||!dueEl) return;
      if(_editId) return;                 // saat edit, jangan ganggu data yang ada
      if(!actEl.value) return;
      if(dueEl.value) return;             // sudah diisi manual → hormati

      const act=new Date(actEl.value);
      if(isNaN(act.getTime())) return;
      // Tanggal sama, bulan depan. Clamp bila bulan berikutnya lebih pendek
      // (mis. aktivasi 31 Jan → jatuh tempo 28/29 Feb).
      const day=act.getDate();
      const target=new Date(act.getFullYear(), act.getMonth()+1, 1);
      const lastDay=new Date(target.getFullYear(), target.getMonth()+1, 0).getDate();
      target.setDate(Math.min(day, lastDay));
      const y=target.getFullYear();
      const m=String(target.getMonth()+1).padStart(2,'0');
      const d=String(target.getDate()).padStart(2,'0');
      dueEl.value=y+'-'+m+'-'+d;
    }

    // Isi default tanggal aktivasi = hari ini, lalu hitung jatuh tempo.
    function setDefaultDates(){
      const actEl=document.getElementById('afInstallDate');
      const dueEl=document.getElementById('afDueDate');
      if(!actEl||!dueEl) return;
      const t=new Date();
      actEl.value=t.getFullYear()+'-'+String(t.getMonth()+1).padStart(2,'0')+'-'+String(t.getDate()).padStart(2,'0');
      dueEl.value='';
      onActivationDateChange();
    }
    async function onRouterChange(){
      const dev=document.getElementById('afRouter').value;
      const sel=document.getElementById('afPppoeProfile');
      if(!dev){ sel.innerHTML='<option value="">Pilih router dulu…</option>'; sel.disabled=true; return; }
      sel.innerHTML='<option value="">Memuat profil…</option>'; sel.disabled=true;
      const j=await api('/api/mikrotik/pppoe/profiles?device_id='+encodeURIComponent(dev));
      const rows=(j&&j.success)?(Array.isArray(j.data)?j.data:[]):[];
      if(rows.length){ sel.innerHTML='<option value="">Pilih profil…</option>'+rows.map(p=>{ const nm=p.name||p; return '<option value="'+esc(nm)+'">'+esc(nm)+(p.rateLimit?(' ('+esc(p.rateLimit)+')'):'')+'</option>'; }).join(''); sel.disabled=false; }
      else{ sel.innerHTML='<option value="">Tidak ada profil</option>'; sel.disabled=true; }
    }
    function getMyLocation(){
      const lbl=document.getElementById('geoLbl');
      if(!navigator.geolocation){ toast('Geolocation tidak didukung','err'); return; }
      lbl.textContent='Mengambil lokasi…';
      navigator.geolocation.getCurrentPosition(function(pos){
        const lat=pos.coords.latitude, lng=pos.coords.longitude;
        setLatLng(lat,lng);
        if(_afMap){ _afMarker.setLatLng([lat,lng]); _afMap.setView([lat,lng],16); }
        lbl.textContent='Lokasi terisi ✓';
        setTimeout(()=>lbl.textContent='Ambil lokasi saya',2000);
      },function(){ lbl.textContent='Ambil lokasi saya'; toast('Gagal mengambil lokasi','err'); },{enableHighAccuracy:true,timeout:10000});
    }
    function fmtRp(n){ return 'Rp '+Math.round(Number(n)||0).toLocaleString('id-ID'); }
    // ID pelanggan yang sedang diedit. null = mode tambah.
    var _editId = null;

    async function saveCustomer(){
      const name=document.getElementById('afName').value.trim();
      if(!name){ toast('Nama wajib diisi','err'); document.getElementById('afName').focus(); return; }
      const connType=document.getElementById('afConnType').value;
      const body={
        name:name,
        phone:document.getElementById('afPhone').value.trim()||null,
        email:document.getElementById('afEmail').value.trim()||null,
        address:document.getElementById('afAddress').value.trim()||null,
        province:selName('afProvince')||null,
        regency:selName('afRegency')||null,
        district:selName('afDistrict')||null,
        village:selName('afVillage')||null,
        latitude:document.getElementById('afLat').value.trim()||null,
        longitude:document.getElementById('afLng').value.trim()||null,
        package_id:document.getElementById('afPackage').value||null,
        installation_date:document.getElementById('afInstallDate').value||null,
        due_date:document.getElementById('afDueDate').value||null,
        connection_type:connType||null,
        router_id:document.getElementById('afRouter').value||null,
        device_id:document.getElementById('afRouter').value||null,
        static_ip:document.getElementById('afStaticIp').value.trim()||null,
        mac_address:document.getElementById('afMac').value.trim()||null,
        notes:document.getElementById('afNotes').value.trim()||null
      };
      // Field PPPoE hanya dikirim kalau tipe koneksi memang PPPoE.
      // Mencegah pppoe_username ikut tersimpan (seolah PPPoE dibuat) saat
      // pelanggan sebenarnya bukan tipe PPPoE.
      if(connType==='pppoe'){
        body.pppoe_username=document.getElementById('afPppoeUser').value.trim()||null;
        body.pppoe_password=document.getElementById('afPppoePass').value.trim()||null;
        body.pppoe_profile=document.getElementById('afPppoeProfile').value||null;
      }
      // Status hanya dikirim saat edit (di form tambah, default 'active' dari server)
      if(_editId){
        var stEl=document.getElementById('afStatus');
        if(stEl && stEl.value) body.status=stEl.value;
      } else {
        body.send_wa_welcome=document.getElementById('afSendWa').checked;
        body.send_email_welcome=document.getElementById('afSendEmail').checked;
      }

      const btn=document.getElementById('afSave');
      const isEdit=!!_editId;
      btn.disabled=true; btn.textContent='Menyimpan…';
      const t=getToken();
      let ok=false, msg='';
      try{
        const url=isEdit ? ('/api/customers/'+encodeURIComponent(_editId)) : '/api/customers';
        const r=await fetch(url,{
          method: isEdit ? 'PUT' : 'POST',
          credentials:'include',
          headers:Object.assign({'Content-Type':'application/json'},t?{'Authorization':'Bearer '+t}:{}),
          body:JSON.stringify(body)
        });
        const d=await r.json().catch(()=>null);
        ok=(r.ok && d && d.success); msg=(d&&d.message)||'';
      }catch(e){ msg=e.message; }
      btn.disabled=false; btn.textContent = isEdit ? 'Simpan Perubahan' : 'Simpan Pelanggan';
      if(ok){
        toast(isEdit?'Perubahan tersimpan':'Pelanggan berhasil ditambahkan','ok');
        closeAdd(); clearAddForm(); _editId=null;
        loadCustStats(); loadGrowth(); loadCustomers(true);
      }
      else{ toast(msg||(isEdit?'Gagal menyimpan perubahan':'Gagal menambahkan pelanggan'),'err'); }
    }

    /* ── Mode EDIT: buka form yang sama, lalu isi dengan data pelanggan ── */
    async function openEdit(id){
      const d=await api('/api/customers/'+encodeURIComponent(id));
      const c=(d&&d.data)?d.data:null;
      if(!c){ toast('Gagal memuat data pelanggan','err'); return; }
      closeDetail();
      _editId=id;

      // Siapkan form (memuat provinsi, paket, router, dst) lalu isi nilainya.
      await openAdd(true);

      document.getElementById('asTitle').textContent='Edit Pelanggan';
      document.getElementById('afSave').textContent='Simpan Perubahan';

      document.getElementById('afName').value=c.name||'';
      document.getElementById('afPhone').value=c.phone||'';
      document.getElementById('afEmail').value=c.email||'';
      document.getElementById('afAddress').value=c.address||'';
      document.getElementById('afLat').value=(c.latitude!=null?c.latitude:'');
      document.getElementById('afLng').value=(c.longitude!=null?c.longitude:'');
      document.getElementById('afStaticIp').value=c.static_ip||'';
      document.getElementById('afMac').value=c.mac_address||'';
      document.getElementById('afNotes').value=c.notes||'';
      document.getElementById('afPppoeUser').value=c.pppoe_username||'';
      document.getElementById('afPppoePass').value=c.pppoe_password||'';
      // Tanggal aktivasi & jatuh tempo (DATEONLY dari server → potong ke YYYY-MM-DD)
      var d10=function(v){ return v?String(v).slice(0,10):''; };
      var idEl=document.getElementById('afInstallDate'); if(idEl) idEl.value=d10(c.installation_date);
      var ddEl=document.getElementById('afDueDate');     if(ddEl) ddEl.value=d10(c.due_date);
      var dhEl=document.getElementById('afDueHint');     if(dhEl) dhEl.textContent='Ubah jatuh tempo bila perlu. Mengubahnya memengaruhi status & reminder pelanggan.';

      // Status (hanya ada di mode edit)
      var stWrap=document.getElementById('afStatusWrap');
      if(stWrap){ stWrap.style.display='block'; document.getElementById('afStatus').value=(c.status||'active'); }
      // Sembunyikan opsi notifikasi selamat datang saat edit
      var nWrap=document.getElementById('afNotifWrap'); if(nWrap) nWrap.style.display='none';

      if(c.package_id) document.getElementById('afPackage').value=String(c.package_id);
      if(c.connection_type){ document.getElementById('afConnType').value=c.connection_type; onConnTypeChange(); }

      // Router → lalu profil PPPoE (butuh router terpilih dulu)
      var rid=c.router_id||c.device_id;
      if(rid){
        var rEl=document.getElementById('afRouter');
        rEl.value=String(rid);
        try{ await onRouterChange(); }catch(_){ }
        if(c.pppoe_profile){
          var pEl=document.getElementById('afPppoeProfile');
          if(pEl) pEl.value=c.pppoe_profile;
        }
      }

      // Alamat berjenjang: pilih provinsi → kabupaten → kecamatan → kelurahan
      try{ await presetArea(c); }catch(_){ }

      // Peta: arahkan ke titik pelanggan kalau ada
      if(c.latitude && c.longitude && _afMap && _afMarker){
        var ll=[parseFloat(c.latitude), parseFloat(c.longitude)];
        if(!isNaN(ll[0]) && !isNaN(ll[1])){ _afMarker.setLatLng(ll); _afMap.setView(ll,16); }
      }
    }

    // Set dropdown area berjenjang sesuai nama yang tersimpan di pelanggan.
    async function presetArea(c){
      function pickByName(selId, name){
        if(!name) return false;
        var el=document.getElementById(selId); if(!el) return false;
        var opts=el.options;
        for(var i=0;i<opts.length;i++){
          if((opts[i].textContent||'').trim().toLowerCase()===String(name).trim().toLowerCase()){
            el.value=opts[i].value; return true;
          }
        }
        return false;
      }
      if(pickByName('afProvince', c.province)){
        await onProvinceChange();
        if(pickByName('afRegency', c.regency)){
          await onRegencyChange();
          if(pickByName('afDistrict', c.district)){
            await onDistrictChange();
            pickByName('afVillage', c.village);
          }
        }
      }
    }
    function clearAddForm(){ ['afName','afPhone','afEmail','afAddress','afLat','afLng','afPppoeUser','afPppoePass','afStaticIp','afMac','afNotes','afInstallDate','afDueDate'].forEach(id=>{const el=document.getElementById(id);if(el)el.value='';}); const _dh=document.getElementById('afDueHint'); if(_dh)_dh.textContent='Jatuh tempo otomatis 1 bulan setelah tanggal aktivasi. Bisa diubah manual.'; document.getElementById('afSendWa').checked=false; document.getElementById('afSendEmail').checked=false; 
      ['afRegency','afDistrict','afVillage'].forEach(id=>{const el=document.getElementById(id);if(el){el.innerHTML='<option value="">-</option>';el.disabled=true;}}); const pv=document.getElementById('afProvince'); if(pv)pv.value='';
      const pp=document.getElementById('afPppoeProfile'); if(pp){pp.innerHTML='<option value="">Pilih router dulu…</option>';pp.disabled=true;} const rr=document.getElementById('afRouter'); if(rr)rr.value='';
      if(_afMap&&_afMarker){ _afMarker.setLatLng(AF_DEFAULT); _afMap.setView(AF_DEFAULT,13); }
      const gh=document.getElementById('afGeoHint'); if(gh)gh.textContent='';
    }

    loadCustStats();
    loadGrowth();
    loadCustomers(true);

    // Buka detail langsung bila datang dari pencarian global (?focus=ID)
    (function(){
      try{ const f=new URLSearchParams(location.search).get('focus'); if(f&&/^\d+$/.test(f)){ setTimeout(function(){ openDetail(parseInt(f)); }, 400); } }catch(_){}
    })();
  </script>
  <div class="toast" id="toast"></div>
  <!-- Tambah pelanggan (bottom sheet) -->
  <div class="add-overlay" id="addOverlay" onclick="closeAdd()"></div>
  <div class="add-sheet" id="addSheet">
    <div class="as-handle"></div>
    <div class="as-head"><h3 id="asTitle">Tambah Pelanggan</h3><button class="as-close" onclick="closeAdd()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div>
    <div class="as-body">
      <div class="as-sec">Data Pelanggan</div>
      <label class="as-lbl">Nama <span class="req">*</span></label>
      <input class="as-in" id="afName" placeholder="Nama lengkap pelanggan">
      <div class="as-row">
        <div><label class="as-lbl">No. HP / WhatsApp</label><input class="as-in" id="afPhone" inputmode="numeric" placeholder="08xxxx"></div>
        <div><label class="as-lbl">Email</label><input class="as-in" id="afEmail" placeholder="email@contoh.com"></div>
      </div>
      <div id="afStatusWrap" style="display:none;">
        <label class="as-lbl">Status Pelanggan</label>
        <select class="as-in" id="afStatus">
          <option value="active">Aktif</option>
          <option value="isolated">Isolir</option>
          <option value="suspended">Suspend</option>
          <option value="inactive">Nonaktif</option>
        </select>
      </div>

      <div class="as-sec">Alamat</div>
      <label class="as-lbl">Provinsi</label>
      <select class="as-in" id="afProvince" onchange="onProvinceChange()"><option value="">Pilih provinsi…</option></select>
      <label class="as-lbl">Kabupaten / Kota</label>
      <select class="as-in" id="afRegency" onchange="onRegencyChange()" disabled><option value="">Pilih kabupaten/kota…</option></select>
      <label class="as-lbl">Kecamatan</label>
      <select class="as-in" id="afDistrict" onchange="onDistrictChange()" disabled><option value="">Pilih kecamatan…</option></select>
      <label class="as-lbl">Kelurahan / Desa</label>
      <select class="as-in" id="afVillage" onchange="onVillageChange()" disabled><option value="">Pilih kelurahan/desa…</option></select>
      <label class="as-lbl">Alamat Lengkap (jalan, RT/RW, no. rumah)</label>
      <textarea class="as-in" id="afAddress" rows="2" placeholder="Contoh: Jl. Merdeka No. 12 RT 01/RW 02"></textarea>

      <div class="as-sec">Titik Lokasi (Maps)</div>
      <div class="as-maphint">Ketuk pada peta atau geser marker untuk menentukan titik lokasi</div>
      <div id="afMap" class="af-map"></div>
      <div id="afGeoHint" class="as-maphint" style="margin-top:-4px;margin-bottom:10px;"></div>
      <div class="as-row">
        <div><label class="as-lbl">Latitude</label><input class="as-in" id="afLat" inputmode="decimal" placeholder="-6.xxxx" onchange="onLatLngInput()"></div>
        <div><label class="as-lbl">Longitude</label><input class="as-in" id="afLng" inputmode="decimal" placeholder="106.xxxx" onchange="onLatLngInput()"></div>
      </div>
      <button class="as-geo" onclick="getMyLocation()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a8 8 0 0 0-8 8c0 5.4 8 12 8 12s8-6.6 8-12a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/></svg><span id="geoLbl">Ambil lokasi saya</span></button>

      <div class="as-sec">Langganan & Jaringan</div>
      <label class="as-lbl">Paket</label>
      <select class="as-in" id="afPackage"><option value="">Pilih paket…</option></select>

      <div class="as-row">
        <div>
          <label class="as-lbl">Tanggal Aktivasi</label>
          <input type="date" class="as-in" id="afInstallDate" onchange="onActivationDateChange()">
        </div>
        <div>
          <label class="as-lbl">Jatuh Tempo</label>
          <input type="date" class="as-in" id="afDueDate">
        </div>
      </div>
      <div class="as-hint" id="afDueHint">Jatuh tempo otomatis 1 bulan setelah tanggal aktivasi. Bisa diubah manual.</div>

      <label class="as-lbl">Tipe Koneksi</label>
      <select class="as-in" id="afConnType" onchange="onConnTypeChange()">
        <option value="pppoe">PPPoE</option>
        <option value="static">IP Static</option>
        <option value="hotspot">Hotspot</option>
      </select>
      <label class="as-lbl">Router / MikroTik</label>
      <select class="as-in" id="afRouter" onchange="onRouterChange()"><option value="">Pilih router…</option></select>

      <div id="pppoeFields">
        <label class="as-lbl">Profil PPPoE</label>
        <select class="as-in" id="afPppoeProfile" disabled><option value="">Pilih router dulu…</option></select>
        <div class="as-row">
          <div><label class="as-lbl">PPPoE Username</label><input class="as-in" id="afPppoeUser" placeholder="username"></div>
          <div><label class="as-lbl">PPPoE Password</label><input class="as-in" id="afPppoePass" placeholder="password"></div>
        </div>
      </div>
      <div class="as-row">
        <div><label class="as-lbl">IP Static</label><input class="as-in" id="afStaticIp" inputmode="decimal" placeholder="10.10.x.x"></div>
        <div><label class="as-lbl">MAC Address</label><input class="as-in" id="afMac" placeholder="AA:BB:CC:.."></div>
      </div>
      <label class="as-lbl">Catatan</label>
      <textarea class="as-in" id="afNotes" rows="2" placeholder="Catatan opsional"></textarea>

      <div id="afNotifWrap">
        <div class="as-sec">Notifikasi</div>
        <label class="as-check"><input type="checkbox" id="afSendWa"><span class="as-cbox"></span>Kirim notifikasi selamat datang via WhatsApp</label>
        <label class="as-check"><input type="checkbox" id="afSendEmail"><span class="as-cbox"></span>Kirim notifikasi selamat datang via Email</label>
      </div>
    </div>
    <div class="as-foot">
      <button class="as-cancel" onclick="closeAdd()">Batal</button>
      <button class="as-save" id="afSave" onclick="saveCustomer()">Simpan Pelanggan</button>
    </div>
  </div>
</body>
</html>
