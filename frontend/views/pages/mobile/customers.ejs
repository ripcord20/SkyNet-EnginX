    // ── Traffic real-time detail pelanggan ──
    let _dmRx=[], _dmTx=[], _dmTrafficTimer=null; const DMPTS=30;
    function fmtbps(bits){ bits=Number(bits)||0; if(bits>=1e9)return (bits/1e9).toFixed(2)+' Gbps'; if(bits>=1e6)return (bits/1e6).toFixed(2)+' Mbps'; if(bits>=1e3)return (bits/1e3).toFixed(1)+' Kbps'; return Math.round(bits)+' bps'; }
    function stopDetailTraffic(){ if(_dmTrafficTimer){ clearInterval(_dmTrafficTimer); _dmTrafficTimer=null; } _dmRx=[]; _dmTx=[]; }
    function drawDmRt(){
      const svg=document.getElementById('dmRtChart'); if(!svg)return;
      const W=320,H=110,padT=8,padB=8,padL=4,padR=4;
      if(_dmRx.length<2){ svg.innerHTML=''; return; }
      const all=_dmRx.concat(_dmTx); let max=Math.max.apply(null,all); if(max<=0)max=1; max*=1.15;
      const n=_dmRx.length;
      const xs=i=>padL+(i*(W-padL-padR)/(DMPTS-1));
      const ys=v=>padT+(H-padT-padB)*(1-v/max);
      let grid=''; for(let i=1;i<4;i++){ const y=padT+(H-padT-padB)*i/4; grid+='<line x1="'+padL+'" y1="'+y+'" x2="'+(W-padR)+'" y2="'+y+'" stroke="#f0f3f8" stroke-width="1" stroke-dasharray="3 4"/>'; }
      function path(arr){ let d='M '+xs(DMPTS-n)+' '+ys(arr[0]); for(let i=1;i<n;i++){ const x0=xs(DMPTS-n+i-1),y0=ys(arr[i-1]),x1=xs(DMPTS-n+i),y1=ys(arr[i]);const cx=(x0+x1)/2; d+=' C '+cx+' '+y0+' '+cx+' '+y1+' '+x1+' '+y1;} return d; }
      const rxP=path(_dmRx), txP=path(_dmTx);
      const rxArea=rxP+' L '+xs(DMPTS-1)+' '+(H-padB)+' L '+xs(DMPTS-n)+' '+(H-padB)+' Z';
      svg.innerHTML=grid+'<defs><linearGradient id="dmg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0ea5e9" stop-opacity=".24"/><stop offset="100%" stop-color="#0ea5e9" stop-opacity="0"/></linearGradient></defs>'+
        '<path d="'+rxArea+'" fill="url(#dmg)"/>'+
        '<path d="'+txP+'" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>'+
        '<path d="'+rxP+'" fill="none" stroke="#0ea5e9" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>';
    }
    async function pollDetailTraffic(custId){
      const j=await api('/api/mikrotik/customer-traffic');
      const rows=(j&&j.success)?(Array.isArray(j.data)?j.data:[]):[];
      const me=rows.find(r=>r.id===custId||r.customer_id===custId);
      const emptyEl=document.getElementById('dmRtEmpty'); const chartEl=document.getElementById('dmRtChart');
      if(!me){ if(emptyEl)emptyEl.style.display='block'; if(chartEl)chartEl.style.display='none'; return; }
      if(emptyEl)emptyEl.style.display='none'; if(chartEl)chartEl.style.display='block';
      const rx=Number(me.rateDown||0), tx=Number(me.rateUp||0);
      _dmRx.push(rx); _dmTx.push(tx); if(_dmRx.length>DMPTS)_dmRx.shift(); if(_dmTx.length>DMPTS)_dmTx.shift();
      const rv=document.getElementById('dmRxVal'), tv=document.getElementById('dmTxVal');
      if(rv)rv.textContent=fmtbps(rx); if(tv)tv.textContent=fmtbps(tx);
      drawDmRt();
    }
    function startDetailTraffic(custId, status){
      stopDetailTraffic();
      pollDetailTraffic(custId);
      _dmTrafficTimer=setInterval(()=>pollDetailTraffic(custId), 2000);
    }
