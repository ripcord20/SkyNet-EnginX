    async function geocodeWilayah(force){
      const latEl=document.getElementById('afLat'), lngEl=document.getElementById('afLng');
      // jangan timpa kalau sudah ada koordinat & bukan paksa
      if(!force && (latEl.value.trim()||lngEl.value.trim())) return;
      const desa=selName('afVillage'), kec=selName('afDistrict'), kab=selName('afRegency'), prov=selName('afProvince');
      if(!prov && !kab) return;
      const hint=document.getElementById('afGeoHint');
      if(hint){ hint.textContent='Mencari titik lokasi…'; hint.style.color='#7c93a0'; }
      const q=[desa,kec,kab,prov,'Indonesia'].filter(Boolean).join(', ');
      try{
        const r=await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&accept-language=id&countrycodes=id&q='+encodeURIComponent(q),{headers:{'Accept':'application/json'}});
        const arr=await r.json();
        if(arr && arr.length){
          const lat=+arr[0].lat, lng=+arr[0].lon;
          setLatLng(lat,lng);
          if(_afMap && _afMarker){ _afMarker.setLatLng([lat,lng]); _afMap.setView([lat,lng],15); }
          if(hint){ hint.textContent='✓ Titik di '+(desa||kec||kab||prov)+'. Geser marker untuk presisi rumah.'; hint.style.color='#0f9d63'; }
        } else if(hint){ hint.textContent='Wilayah tak ditemukan di peta. Isi koordinat manual.'; hint.style.color='#c67d0a'; }
      }catch(e){ if(hint){ hint.textContent='Gagal mengambil titik (cek koneksi).'; hint.style.color='#c67d0a'; } }
    }
