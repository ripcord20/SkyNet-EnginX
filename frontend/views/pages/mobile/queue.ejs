      <a class="bn-item" href="/mobile/monitoring"><span class="bn-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></span><span>Monitor</span></a>
    </div>
  </nav>

  <div class="toast" id="toast"></div>

  <script>
    function getToken(){ try{ return localStorage.getItem('token')||localStorage.getItem('authToken')||''; }catch(_){ return ''; } }
    async function api(url, opts={}){
      const t=getToken();
      const headers=Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}, opts.headers||{});
      try{
        const r=await fetch(url,{credentials:'include',headers,...opts});
        if(r.status===401){ location.href='/login?next=/mobile/queue'; return null; }
        const x=await r.text(); try{ return x?JSON.parse(x):null; }catch(_){ return null; }
      }catch(e){ return null; }
    }
    function toast(msg,kind){ const t=document.getElementById('toast'); t.textContent=msg; t.className='toast show'+(kind?(' '+kind):''); setTimeout(()=>t.className='toast',2200); }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    // Format bit rate → human
    function fmtRate(bps){
      bps=Number(bps)||0;
      if(bps>=1e9) return (bps/1e9).toFixed(2)+' Gbps';
      if(bps>=1e6) return (bps/1e6).toFixed(1)+' Mbps';
      if(bps>=1e3) return (bps/1e3).toFixed(0)+' Kbps';
      return bps+' bps';
    }
    // Parse MikroTik limit ("10M","512k","1G") → bps
    function parseLimit(s){
      if(!s) return 0;
      s=String(s).trim();
      const m=s.match(/^([\d.]+)\s*([kKmMgG]?)/); if(!m) return 0;
      let v=parseFloat(m[1]); const u=(m[2]||'').toLowerCase();
      if(u==='k') v*=1e3; else if(u==='m') v*=1e6; else if(u==='g') v*=1e9;
      return v;
    }

    var _dev='';
    var _filter='';
    var _search='';
    var _searchT=null;
    var _queues=[];
    var _statsMap={};
    var _totalRx=[], _totalTx=[], _TOTMAX=30;
    var _pollTimer=null;
    var POLL=3000;
    var _delId=null, _delName='';

    function devQS(base){ return base + (_dev?((base.indexOf('?')>=0?'&':'?')+'device_id='+encodeURIComponent(_dev)):''); }

    async function loadDevices(){
      const r=await api('/api/devices/mikrotik-list');
      const rows=(r&&r.success&&Array.isArray(r.data))?r.data:(Array.isArray(r)?r:[]);
      const sel=document.getElementById('devSel');
      sel.innerHTML='<option value="">Router otomatis</option>'+rows.map(d=>'<option value="'+d.id+'">'+esc(d.name||('Router #'+d.id))+'</option>').join('');
    }

    function onDevChange(){ _dev=document.getElementById('devSel').value; _totalRx=[]; _totalTx=[]; var c=document.getElementById('rtqChart'); if(c) c.innerHTML=''; loadAll(true); }

    async function loadQueues(){
      const r=await api(devQS('/api/mikrotik/queues'));
      _queues=(r&&r.success&&Array.isArray(r.data))?r.data:[];
      render();
      document.getElementById('qUpdated').textContent=_queues.length+' queue';
    }

    async function loadStats(){
      const r=await api(devQS('/api/mikrotik/queues/stats'));
      const rows=(r&&r.success&&Array.isArray(r.data))?r.data:[];
      _statsMap={};
      rows.forEach(s=>{ _statsMap[s.id]={rateIn:s.rateIn,rateOut:s.rateOut,bytesIn:s.bytesIn,bytesOut:s.bytesOut}; });
      applyStats();
    }

    function applyStats(){
      let totalDl=0, totalUl=0;
      _queues.forEach(q=>{
        const s=_statsMap[q.id];
        const dl=s?Number(s.rateIn)||0:0;
        const ul=s?Number(s.rateOut)||0:0;
        if(!q.disabled){ totalDl+=dl; totalUl+=ul; }
        const dlEl=document.getElementById('dl-'+q.id);
        const ulEl=document.getElementById('ul-'+q.id);
        if(dlEl) dlEl.textContent=fmtRate(dl);
        if(ulEl) ulEl.textContent=fmtRate(ul);
        const [mUp,mDown]=String(q.maxLimit||'0/0').split('/');
        const limDl=parseLimit(mDown), limUl=parseLimit(mUp);
        const dlBar=document.getElementById('dlbar-'+q.id);
        const ulBar=document.getElementById('ulbar-'+q.id);
        if(dlBar) dlBar.style.width=(limDl>0?Math.min(100,(dl/limDl)*100):0)+'%';
        if(ulBar) ulBar.style.width=(limUl>0?Math.min(100,(ul/limUl)*100):0)+'%';
      });
      document.getElementById('stTraffic').textContent='↓'+fmtRate(totalDl).replace(' ','')+' ↑'+fmtRate(totalUl).replace(' ','');
      // real-time total traffic chart
      _totalRx.push(totalDl); _totalTx.push(totalUl);
      if(_totalRx.length>_TOTMAX){ _totalRx.shift(); _totalTx.shift(); }
      var rtqDl=document.getElementById('rtqDl'), rtqUl=document.getElementById('rtqUl');
      if(rtqDl) rtqDl.textContent=fmtRate(totalDl);
      if(rtqUl) rtqUl.textContent=fmtRate(totalUl);
      drawTotalChart();
      // detail chart live
      if(_detailId){ pushDetailPoint(); }
    }

    function drawTotalChart(){
      var svg=document.getElementById('rtqChart'); if(!svg) return;
      var W=320,H=120,pad=4,n=_totalRx.length;
      if(n<2){ svg.innerHTML='<text x="160" y="62" text-anchor="middle" fill="#c3cddd" font-size="11" font-family="inherit">Menunggu data…</text>'; return; }
      var all=_totalRx.concat(_totalTx), max=Math.max.apply(null,all); if(max<=0)max=1;
      var xs=function(i){ return pad+(i*(W-2*pad)/(_TOTMAX-1)); };
      var ys=function(v){ return H-pad-(v/max)*(H-2*pad); };
      var start=_TOTMAX-n;
      function path(arr){
        var d='M '+xs(start).toFixed(1)+' '+ys(arr[0]).toFixed(1);
        for(var i=1;i<n;i++){ var x0=xs(start+i-1),y0=ys(arr[i-1]),x1=xs(start+i),y1=ys(arr[i]),cx=(x0+x1)/2;
          d+=' C '+cx.toFixed(1)+' '+y0.toFixed(1)+' '+cx.toFixed(1)+' '+y1.toFixed(1)+' '+x1.toFixed(1)+' '+y1.toFixed(1); }
        return d;
      }
      var rxP=path(_totalRx), txP=path(_totalTx);
      var rxArea=rxP+' L '+xs(start+n-1).toFixed(1)+' '+H+' L '+xs(start).toFixed(1)+' '+H+' Z';
      var lx=xs(start+n-1), ly=ys(_totalRx[n-1]);
      svg.innerHTML=
        '<defs><linearGradient id="rtqg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0ea5e9" stop-opacity=".24"/><stop offset="100%" stop-color="#0ea5e9" stop-opacity="0"/></linearGradient></defs>'
        +'<path d="'+rxArea+'" fill="url(#rtqg)"/>'
        +'<path d="'+rxP+'" fill="none" stroke="#0ea5e9" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>'
        +'<path d="'+txP+'" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>'
        +'<circle cx="'+lx.toFixed(1)+'" cy="'+ly.toFixed(1)+'" r="2.6" fill="#0ea5e9"/>';
    }

    function filtered(){
      return _queues.filter(q=>{
        const mS=!_search || (q.name||'').toLowerCase().includes(_search) || (q.target||'').toLowerCase().includes(_search) || (q.comment||'').toLowerCase().includes(_search);
        const mF=!_filter || (_filter==='active'&&!q.disabled) || (_filter==='disabled'&&q.disabled);
        return mS&&mF;
      });
    }

    function render(){
      const box=document.getElementById('qList');
      const list=filtered();
      if(!list.length){
        box.innerHTML='<div class="empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg><div class="empty-t">'+(_queues.length?'Tidak ada yang cocok':'Belum ada queue')+'</div><div class="empty-s">'+(_queues.length?'Coba ubah filter atau kata kunci.':'Tekan tombol + untuk membuat queue.')+'</div></div>';
        return;
      }
      box.innerHTML=list.map(q=>{
        const [mUp,mDown]=String(q.maxLimit||'0/0').split('/');
        const nameEsc=esc(q.name).replace(/'/g,'&#39;');
        return '<div class="q'+(q.disabled?' off':'')+'">'
          +'<div class="q-top">'
          +'<div class="q-name" onclick="openDetail(\''+esc(q.id)+'\')">'+esc(q.name)+'</div>'
          +'<span class="q-pill '+(q.disabled?'pill-off':'pill-on')+'"><span class="sd"></span>'+(q.disabled?'Nonaktif':'Aktif')+'</span>'
          +'</div>'
          +'<div class="q-target">'+esc(q.target||'-')+'</div>'
          +'<div class="q-traf">'
          +'<div class="tf tf-dl"><div class="tf-h"><i></i>Download</div><div class="tf-val" id="dl-'+q.id+'">–</div><div class="tf-lim">limit '+esc(mDown||'∞')+'</div><div class="tf-bar"><div class="tf-fill" id="dlbar-'+q.id+'" style="width:0%"></div></div></div>'
          +'<div class="tf tf-ul"><div class="tf-h"><i></i>Upload</div><div class="tf-val" id="ul-'+q.id+'">–</div><div class="tf-lim">limit '+esc(mUp||'∞')+'</div><div class="tf-bar"><div class="tf-fill" id="ulbar-'+q.id+'" style="width:0%"></div></div></div>'
          +'</div>'
          +'<div class="q-actions">'
          +'<button class="qa qa-edit" onclick="openEdit(\''+esc(q.id)+'\')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>Edit</button>'
          +'<button class="qa '+(q.disabled?'qa-on':'qa-toggle')+'" onclick="toggleQueue(\''+esc(q.id)+'\','+(q.disabled?'true':'false')+')">'
          +(q.disabled?'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>Aktifkan':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>Nonaktif')+'</button>'
          +'<button class="qa qa-del" onclick="askDelete(\''+esc(q.id)+'\',\''+nameEsc+'\')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></button>'
          +'</div>'
          +'</div>';
      }).join('');
      applyStats();
      document.getElementById('stTotal').textContent=_queues.length;
      document.getElementById('stActive').textContent=_queues.filter(q=>!q.disabled).length;
    }

    function setFilter(el,f){ _filter=f; document.querySelectorAll('.chip').forEach(c=>c.classList.remove('on')); el.classList.add('on'); render(); }
    function onSearch(){ clearTimeout(_searchT); _searchT=setTimeout(()=>{ _search=document.getElementById('qSearch').value.trim().toLowerCase(); render(); }, 250); }

    async function loadAll(spin){
      if(spin){ const b=document.getElementById('refreshBtn'); b.classList.add('spin'); setTimeout(()=>b.classList.remove('spin'),900); }
      document.getElementById('qList').innerHTML=Array(3).fill('<div class="q-skel"><div class="skel" style="width:45%;height:14px;margin-bottom:12px;"></div><div class="skel" style="width:70%;height:11px;margin-bottom:12px;"></div><div class="skel" style="width:100%;height:52px;"></div></div>').join('');
      await loadQueues();
      await loadStats();
      startPoll();
    }
    function startPoll(){ stopPoll(); _pollTimer=setInterval(()=>{ if(document.visibilityState==='visible') loadStats(); }, POLL); }
    function stopPoll(){ if(_pollTimer){ clearInterval(_pollTimer); _pollTimer=null; } }
    document.addEventListener('visibilitychange', ()=>{ if(document.visibilityState==='visible'){ loadStats(); } });

    /* ── Toggle enable/disable ── */
    async function toggleQueue(id, isDisabled){
      const act=isDisabled?'enable':'disable';
      const r=await api(devQS('/api/mikrotik/queues/'+id+'/'+act),{method:'POST',body:'{}'});
      if(r&&r.success){ toast(isDisabled?'Queue diaktifkan':'Queue dinonaktifkan','ok'); loadQueues().then(loadStats); }
      else { toast((r&&r.message)||'Gagal mengubah status','err'); }
    }

    /* ── Delete ── */
    function askDelete(id,name){ _delId=id; _delName=name; document.getElementById('cfName').textContent=name; document.getElementById('cfOv').classList.add('open'); document.body.style.overflow='hidden'; }
    function closeConfirm(){ _delId=null; document.getElementById('cfOv').classList.remove('open'); document.body.style.overflow=''; }
    async function doDelete(){
      if(!_delId) return;
      const btn=document.getElementById('cfOk'); btn.disabled=true; btn.textContent='Menghapus…';
      const r=await api(devQS('/api/mikrotik/queues/'+_delId),{method:'DELETE'});
      btn.disabled=false; btn.textContent='Hapus';
      closeConfirm();
      if(r&&r.success){ toast('Queue dihapus','ok'); loadQueues().then(loadStats); }
      else { toast((r&&r.message)||'Gagal menghapus','err'); }
    }

    /* ── Form (create / edit) ── */
    var _editId=null;

    // Isi dropdown Parent dari queue yang ada (value = nama queue), kecuali
    // queue itu sendiri saat edit (queue tak bisa jadi parent dirinya).
    function populateParents(selectedParent, excludeName){
      const sel=document.getElementById('qParent'); if(!sel) return;
      const cur=(selectedParent&&selectedParent!=='none')?selectedParent:'none';
      let html='<option value="none">— Tanpa Parent (top-level) —</option>';
      (_queues||[]).forEach(q=>{
        if(excludeName && q.name===excludeName) return;
        const s=(q.name===cur)?' selected':'';
        html+='<option value="'+esc(q.name).replace(/"/g,'&quot;')+'"'+s+'>'+esc(q.name)+'</option>';
      });
      sel.innerHTML=html; sel.value=cur;
    }

    function openCreate(){
      _editId=null;
      document.getElementById('fmTitle').textContent='Queue Baru';
      document.getElementById('qName').value='';
      document.getElementById('qTarget').value='';
      document.getElementById('qMaxUp').value='10M';
      document.getElementById('qMaxDown').value='20M';
      document.getElementById('qPriority').value='8';
      document.getElementById('qDisabled').value='false';
      document.getElementById('qComment').value='';
      document.getElementById('qName').disabled=false;
      populateParents('none', null);
      openFormSheet();
    }
    function openEdit(id){
      const q=_queues.find(x=>String(x.id)===String(id)); if(!q) return;
      _editId=id;
      document.getElementById('fmTitle').textContent='Edit Queue';
      const [mUp,mDown]=String(q.maxLimit||'10M/10M').split('/');
      document.getElementById('qName').value=q.name||'';
      document.getElementById('qTarget').value=q.target||'';
      document.getElementById('qMaxUp').value=mUp||'10M';
      document.getElementById('qMaxDown').value=mDown||'10M';
      document.getElementById('qPriority').value=q.priority||'8';
      document.getElementById('qDisabled').value=q.disabled?'true':'false';
      document.getElementById('qComment').value=q.comment||'';
      populateParents(q.parent, q.name);
      openFormSheet();
    }
    function openFormSheet(){ document.getElementById('fmOv').classList.add('open'); document.getElementById('fmSheet').classList.add('open'); document.body.style.overflow='hidden'; }
    function closeForm(){ document.getElementById('fmOv').classList.remove('open'); document.getElementById('fmSheet').classList.remove('open'); document.body.style.overflow=''; }

    async function submitForm(){
      const name=document.getElementById('qName').value.trim();
      const target=document.getElementById('qTarget').value.trim();
      if(!name){ toast('Nama wajib diisi','err'); return; }
      if(!target){ toast('Target wajib diisi','err'); return; }
      const payload={
        name:name, target:target,
        maxLimit:(document.getElementById('qMaxUp').value.trim()||'0')+'/'+(document.getElementById('qMaxDown').value.trim()||'0'),
        priority:document.getElementById('qPriority').value,
        disabled:document.getElementById('qDisabled').value==='true',
        comment:document.getElementById('qComment').value.trim(),
        parent:(document.getElementById('qParent')||{}).value||'none'
      };
      const btn=document.getElementById('qSave'); btn.disabled=true; btn.textContent='Menyimpan…';
      const url=_editId?devQS('/api/mikrotik/queues/'+_editId):devQS('/api/mikrotik/queues');
      const r=await api(url,{method:_editId?'PUT':'POST',body:JSON.stringify(payload)});
      btn.disabled=false; btn.textContent='Simpan Queue';
      if(r&&r.success){ toast('Queue disimpan','ok'); closeForm(); loadQueues().then(loadStats); }
      else { toast((r&&r.message)||'Gagal menyimpan queue','err'); }
    }

    /* ── Detail + live chart ── */
    var _detailId=null;
    var _chartRx=[], _chartTx=[], _chartMax=60;
    function openDetail(id){
      const q=_queues.find(x=>String(x.id)===String(id)); if(!q) return;
      _detailId=id; _chartRx=[]; _chartTx=[];
      const [mUp,mDown]=String(q.maxLimit||'0/0').split('/');
      document.getElementById('dtBody').innerHTML=
        '<div class="dt-chartcard">'
        +'<div class="dt-legend"><span><i style="background:#0ea5e9;"></i>Download <b id="dtDl">–</b></span><span><i style="background:#38bdf8;"></i>Upload <b id="dtUl">–</b></span></div>'
        +'<svg class="dt-chart" id="dtChart" viewBox="0 0 320 130" preserveAspectRatio="none"></svg>'
        +'</div>'
        +'<div class="dt-sec">Konfigurasi</div>'
        +'<div class="dt-row"><span class="dt-k">Nama</span><span class="dt-v">'+esc(q.name)+'</span></div>'
        +'<div class="dt-row"><span class="dt-k">Target</span><span class="dt-v">'+esc(q.target||'-')+'</span></div>'
        +'<div class="dt-row"><span class="dt-k">Max Upload</span><span class="dt-v">'+esc(mUp||'∞')+'</span></div>'
        +'<div class="dt-row"><span class="dt-k">Max Download</span><span class="dt-v">'+esc(mDown||'∞')+'</span></div>'
        +'<div class="dt-row"><span class="dt-k">Prioritas</span><span class="dt-v">'+esc(q.priority||'8')+'</span></div>'
        +((q.parent&&q.parent!=='none')?'<div class="dt-row"><span class="dt-k">Parent</span><span class="dt-v">'+esc(q.parent)+'</span></div>':'')
        +'<div class="dt-row"><span class="dt-k">Status</span><span class="dt-v" style="color:'+(q.disabled?'#788599':'#0f9d63')+';">'+(q.disabled?'Nonaktif':'Aktif')+'</span></div>'
        +(q.comment?'<div class="dt-row"><span class="dt-k">Komentar</span><span class="dt-v">'+esc(q.comment)+'</span></div>':'')
        +'<div class="q-actions" style="margin-top:16px;">'
        +'<button class="qa qa-edit" onclick="closeDetail();openEdit(\''+esc(q.id)+'\')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>Edit</button>'
        +'<button class="qa '+(q.disabled?'qa-on':'qa-toggle')+'" onclick="toggleQueue(\''+esc(q.id)+'\','+(q.disabled?'true':'false')+');closeDetail();">'+(q.disabled?'Aktifkan':'Nonaktif')+'</button>'
        +'</div>';
      document.getElementById('dtOv').classList.add('open');
      document.getElementById('dtSheet').classList.add('open');
      document.body.style.overflow='hidden';
    }
    function closeDetail(){ _detailId=null; document.getElementById('dtOv').classList.remove('open'); document.getElementById('dtSheet').classList.remove('open'); document.body.style.overflow=''; }

    function pushDetailPoint(){
      const s=_statsMap[_detailId]; if(!s) return;
      const rx=Number(s.rateIn)||0, tx=Number(s.rateOut)||0;
      _chartRx.push(rx); _chartTx.push(tx);
      if(_chartRx.length>_chartMax){ _chartRx.shift(); _chartTx.shift(); }
      const dl=document.getElementById('dtDl'), ul=document.getElementById('dtUl');
      if(dl) dl.textContent=fmtRate(rx);
      if(ul) ul.textContent=fmtRate(tx);
      drawChart();
    }
    function drawChart(){
      const svg=document.getElementById('dtChart'); if(!svg) return;
      const W=320,H=130,n=_chartRx.length;
      if(n<2){ svg.innerHTML='<text x="160" y="68" text-anchor="middle" fill="#a8b2c4" font-size="11" font-family="inherit">Menunggu data…</text>'; return; }
      const peak=Math.max(1,...(_chartRx),...(_chartTx));
      const pts=(arr)=>arr.map((v,i)=>((i/(n-1))*W).toFixed(1)+','+(H-(v/peak)*(H-10)-4).toFixed(1)).join(' ');
      const area=(arr)=>'0,'+H+' '+pts(arr)+' '+W+','+H;
      svg.innerHTML=
        '<polygon points="'+area(_chartRx)+'" fill="rgba(47,111,237,.12)"/>'
        +'<polyline points="'+pts(_chartRx)+'" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-linejoin="round"/>'
        +'<polyline points="'+pts(_chartTx)+'" fill="none" stroke="#38bdf8" stroke-width="2" stroke-linejoin="round"/>';
    }

    /* init */
    (async function(){
      await loadDevices();
      await loadAll();
    })();
  </script>
</body>
</html>
