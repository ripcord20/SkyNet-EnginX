<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= title %> - <%= appName %></title>
  <link rel="stylesheet" href="/css/mobile-shell.css?v=7">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    :root{
      --bg:#eff8ff; --card:#ffffff; --ink:#1F3849; --muted:#7c93a0; --line:#e2eefb;
      --blue:#0ea5e9; --blue-deep:#0284c7; --blue-soft:#e0f2fe; --teal:#38bdf8; --teal-soft:#e0f2fe;
      --green:#38bdf8; --green-soft:#e0f2fe; --amber:#f0a63c; --amber-soft:#fdf0dc; --red:#f27272; --red-soft:#fde4e4;
      --dark:#1F3849; --dark2:#101C31; --charcoal:#1F3849; --prussian:#101C31; --mint:#38bdf8; --cyan:#0ea5e9;
      --nav-h:70px;
    }
    body{font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--ink);
      padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 8px);-webkit-font-smoothing:antialiased;}
    .money{font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.3px;}
    .wrap{max-width:520px;margin:0 auto;}

    /* Header */
    /* Top bar: hamburger — judul — avatar */
    .topbar{display:flex;align-items:center;justify-content:space-between;padding:calc(14px + env(safe-area-inset-top)) 18px 6px;gap:12px;}
    .tb-hamb{width:40px;height:40px;border-radius:12px;background:#fff;border:1px solid #eef1f6;display:flex;align-items:center;justify-content:center;color:#25324d;cursor:pointer;flex-shrink:0;}
    .tb-hamb svg{width:21px;height:21px;stroke-width:2.2;}
    .tb-hamb:active{background:#f4f6fa;}
    .tb-title{font-size:16px;font-weight:800;letter-spacing:-.2px;color:#1a2b4a;}
    .tb-avatar{width:40px;height:40px;border-radius:50%;overflow:hidden;background:linear-gradient(135deg,#2f6fed,#1e4fd6);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;flex-shrink:0;text-decoration:none;cursor:pointer;}
    /* Beranda: sapaan tak perlu clearance sebesar judul halaman lain.
       Override aturan global .wrap .head (70px) agar tak terlalu renggang. */
    .head{padding:14px 20px 14px;display:flex;align-items:center;justify-content:space-between;gap:12px;}
    .wrap .head{ padding-top:14px !important; }
    /* Home pakai hamburger di topbar, sembunyikan yang floating dari partial */
    .mdr-hamb{display:none !important;}
    .greet{font-size:13px;color:#7a8f88;font-weight:500;}
    .who{font-size:21px;font-weight:800;letter-spacing:-.4px;margin-top:1px;color:var(--ink);}
    .avatar{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#0ea5e9);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px;flex-shrink:0;box-shadow:0 8px 18px -6px rgba(14,165,233,.5);}

    .content{padding:2px 16px 20px;}

    /* Hero — kartu Total Balance gelap (gaya FlowMint) */
    .hero{background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:26px;padding:22px;color:#fff;box-shadow:0 18px 38px -16px rgba(2,132,199,.6);margin-bottom:16px;position:relative;overflow:hidden;}
    .hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;position:relative;z-index:1;}
    .hero-lbl{font-size:12.5px;color:rgba(255,255,255,.8);font-weight:500;display:flex;align-items:center;gap:7px;}
    .eye-btn{background:rgba(255,255,255,.18);border:none;width:24px;height:24px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;color:#fff;cursor:pointer;padding:0;flex-shrink:0;}
    .eye-btn svg{width:14px;height:14px;}
    .eye-btn:active{background:rgba(255,255,255,.32);}
    .hero-val{font-size:33px;font-weight:800;letter-spacing:-1.2px;margin-top:6px;color:#fff;}
    .hero-val .cents{font-size:20px;color:rgba(255,255,255,.6);font-weight:700;}
    .hero-sub{font-size:12px;color:rgba(255,255,255,.92);margin-top:8px;font-weight:600;display:flex;align-items:center;gap:5px;}
    .hero-coin{width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .hero-coin svg{width:22px;height:22px;color:#fff;}
    .hero-spark{margin-top:16px;position:relative;z-index:1;}
    .hero-spark svg{width:100%;height:56px;display:block;}
    /* Donut lama (collection) dipindah ke kartu terpisah — sembunyikan di hero */
    .donut{position:relative;width:96px;height:96px;flex-shrink:0;display:none;}
    .donut svg{transform:rotate(-90deg);}
    .donut-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
    .donut-pct{font-size:19px;font-weight:800;line-height:1;}
    .donut-cap{font-size:8.5px;opacity:.8;margin-top:2px;text-transform:uppercase;letter-spacing:.5px;}
    .hero-legend{display:none;}
    .hl-item{flex:1;}
    .hl-dot{display:inline-block;width:8px;height:8px;border-radius:3px;margin-right:5px;}
    .hl-lbl{font-size:10.5px;opacity:.8;}
    .hl-val{font-size:14px;font-weight:800;margin-top:3px;}

    /* Cash flow insight card (gaya FlowMint) */
    .cf-card{background:#fff;border-radius:22px;padding:18px;margin-bottom:16px;box-shadow:0 10px 26px -18px rgba(15,47,42,.3);border:1px solid #e9f1ee;}
    .cf-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
    .cf-title{font-size:14px;font-weight:800;}
    .cf-badge{font-size:11px;font-weight:700;color:var(--muted);background:#f1f6f4;padding:5px 11px;border-radius:100px;}
    .cf-sel{font-size:11.5px;font-weight:600;color:#5a6b72;background:#f1f5f6;border:1px solid #e2eaea;border-radius:100px;padding:6px 30px 6px 13px;font-family:inherit;cursor:pointer;outline:none;appearance:none;-webkit-appearance:none;background-image:url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='12'%20height='12'%20viewBox='0%200%2012%2012'%3E%3Cpath%20d='M2.5%204.5L6%208l3.5-3.5'%20fill='none'%20stroke='%237c8a90'%20stroke-width='1.6'%20stroke-linecap='round'%20stroke-linejoin='round'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 11px center;}
    .cf-stats{display:flex;gap:8px;margin-bottom:6px;}
    .cf-stat{flex:1;}
    .cf-stat .k{font-size:10.5px;color:var(--muted);font-weight:600;display:flex;align-items:center;gap:5px;}
    .cf-stat .k i{width:7px;height:7px;border-radius:50%;}
    .cf-stat .v{font-size:16px;font-weight:800;margin-top:4px;letter-spacing:-.4px;}
    .cf-chart{width:100%;height:96px;margin-top:8px;}
    .cf-xlabels{display:flex;justify-content:space-between;margin-top:6px;font-size:9.5px;color:var(--muted);}

    /* AI insight strip */
    .ai-strip{display:flex;align-items:center;gap:12px;background:linear-gradient(100deg,#e0f2fe,#eff8ff);border-radius:18px;padding:14px 16px;margin-bottom:18px;}
    .ai-slider{margin-bottom:18px;}
    .ai-slider .ai-strip{margin-bottom:9px;min-height:58px;}
    .ai-txt{transition:opacity .3s ease;}
    .ai-txt.fading{opacity:0;}
    .ai-dots{display:flex;justify-content:center;gap:6px;}
    .ai-dots .dot{width:6px;height:6px;border-radius:50%;background:#c3d6d1;transition:all .25s;cursor:pointer;}
    .ai-dots .dot.on{width:18px;border-radius:100px;background:var(--cyan,#0ea5e9);}
    .ai-ic{width:34px;height:34px;border-radius:11px;background:#38bdf8;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 6px 14px -5px rgba(14,165,233,.6);}
    .ai-ic svg{width:18px;height:18px;color:#fff;}
    .ai-txt{flex:1;font-size:12.5px;color:#0284c7;line-height:1.45;font-weight:500;}
    .ai-txt b{font-weight:800;}

    /* Section title */
    .sec{display:flex;align-items:center;justify-content:space-between;margin:6px 2px 12px;}
    .sec h3{font-size:14px;font-weight:800;letter-spacing:-.2px;}
    .sec a{font-size:12px;color:var(--blue);font-weight:700;text-decoration:none;}

    /* Card putih membungkus section menu (gaya referensi) */
    .menu-card{background:#fff;border:1px solid #eef1f6;border-radius:20px;padding:16px 14px 18px;margin-bottom:16px;box-shadow:0 8px 20px -14px rgba(30,60,120,.16);}
    .menu-head{margin:2px 4px 14px;display:flex;align-items:center;justify-content:space-between;}
    .menu-head h3{font-size:14px;font-weight:800;letter-spacing:-.2px;}
    .menu-toggle{display:flex;align-items:center;gap:3px;background:none;border:none;font-family:inherit;font-size:12.5px;font-weight:700;color:var(--blue);cursor:pointer;padding:4px 2px;}
    .menu-toggle svg{width:15px;height:15px;transition:transform .25s;}
    .menu-toggle.open svg{transform:rotate(180deg);}
    /* Services grid — ikon kotak outline (gaya referensi) */
    .services{display:grid;grid-template-columns:repeat(4,1fr);gap:14px 10px;margin-bottom:0;}
    /* Tampilkan hanya 8 menu; sisanya disembunyikan sampai tombol "Semua" ditekan. */
    .services .svc-more{display:none;}
    .services.expanded .svc-more{display:flex;}
    .svc{background:transparent;display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:var(--ink);transition:transform .12s;cursor:pointer;}
    .svc:active{transform:scale(.94);}
    .svc-ic{width:100%;aspect-ratio:1;max-width:60px;border-radius:15px;border:1.5px solid #e9edf4;background:#fbfcfe;display:flex;align-items:center;justify-content:center;color:#3a4a68;transition:all .15s;}
    .svc-ic svg{width:23px;height:23px;stroke-width:1.7;}
    .svc:active .svc-ic{border-color:var(--blue);color:var(--blue);background:#f2f6ff;}
    .svc-lbl{font-size:11px;font-weight:600;color:#5a6885;text-align:center;line-height:1.15;min-height:2.3em;display:flex;align-items:flex-start;justify-content:center;}

    /* Stat mini cards */
    .stat-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:22px;}
    .stat{background:#fff;border-radius:18px;padding:15px 16px;box-shadow:0 6px 16px -8px rgba(30,60,120,.12);}
    .stat-ic{width:36px;height:36px;border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;background:#f5f7fb;color:#3a4a68;}
    .stat-ic svg{width:19px;height:19px;stroke-width:1.8;}
    .stat-val{font-size:22px;font-weight:800;letter-spacing:-.5px;line-height:1;}
    .stat-lbl{font-size:11.5px;color:var(--muted);margin-top:5px;font-weight:500;}

    /* Pertumbuhan Pelanggan */
    .grow-card{background:#fff;border-radius:22px;padding:18px 18px 16px;margin-bottom:22px;box-shadow:0 10px 26px -18px rgba(15,47,42,.3);border:1px solid #e9f1ee;}
    .grow-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px;}
    .grow-title{font-size:15px;font-weight:800;color:#1f3849;letter-spacing:-.3px;margin:0;}
    .grow-sub{font-size:11.5px;color:var(--muted);margin-top:2px;font-weight:500;}
    .grow-badge{flex-shrink:0;font-size:12.5px;font-weight:800;color:#0284c7;background:#e0f2fe;padding:6px 12px;border-radius:100px;white-space:nowrap;}
    .grow-chart{width:100%;height:110px;display:block;}
    .grow-xlabels{display:flex;justify-content:space-between;margin-top:6px;padding:0 2px;}
    .grow-xlabels span{font-size:9.5px;color:#aab6c4;font-weight:600;flex:1;text-align:center;}
    .grow-stats{display:flex;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid #eef3f7;}
    .grow-stat{flex:1;text-align:center;}
    .grow-stat .gs-val{font-size:17px;font-weight:800;color:#1f3849;letter-spacing:-.4px;line-height:1;}
    .grow-stat .gs-lbl{font-size:10px;color:var(--muted);margin-top:5px;font-weight:600;}
    .grow-list-head{display:flex;align-items:center;justify-content:space-between;margin:16px 0 8px;padding-top:14px;border-top:1px solid #eef3f7;}
    .grow-list-head span{font-size:12.5px;font-weight:800;color:#1f3849;}
    .grow-list-toggle{border:none;background:none;color:#0ea5e9;font-size:11.5px;font-weight:700;cursor:pointer;font-family:inherit;padding:2px 4px;}
    .grow-list{display:flex;flex-direction:column;gap:8px;}
    .grow-list.collapsed{display:none;}
    .gl-item{display:flex;align-items:center;gap:11px;padding:10px 11px;background:#f7fafd;border-radius:13px;border:1px solid #eef3f7;}
    .gl-av{width:34px;height:34px;border-radius:10px;background:#e0f2fe;color:#0284c7;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;}
    .gl-body{flex:1;min-width:0;}
    .gl-name{font-size:13px;font-weight:700;color:#1f3849;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .gl-meta{font-size:10.5px;color:#8296a8;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .gl-pkg{display:inline-block;font-size:10px;font-weight:700;color:#0284c7;background:#e0f2fe;padding:2px 8px;border-radius:100px;margin-top:4px;}
    .gl-date{font-size:10px;color:#aab6c4;flex-shrink:0;text-align:right;font-weight:600;line-height:1.35;}
    .gl-empty{font-size:12px;color:#8296a8;text-align:center;padding:16px 8px;}
    .gl-loading{font-size:12px;color:#aab6c4;text-align:center;padding:14px 8px;}

    /* Transaction list */
    .list{display:flex;flex-direction:column;gap:10px;}
    .tx{display:flex;align-items:center;gap:13px;background:#fff;border-radius:16px;padding:13px 15px;box-shadow:0 5px 14px -8px rgba(30,60,120,.12);}
    .tx-ic{width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;flex-shrink:0;}
    .tx-body{flex:1;min-width:0;}
    .tx-t{font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .tx-s{font-size:11.5px;color:var(--muted);margin-top:2px;}
    .tx-amt{font-size:14.5px;font-weight:800;letter-spacing:-.3px;flex-shrink:0;}

    .empty{padding:36px 16px;text-align:center;color:var(--muted);font-size:13px;}
    /* Need Attention */
    .na-filter{display:flex;gap:7px;margin-bottom:10px;}
    .na-chip{padding:6px 14px;border:1px solid #eef1f6;background:#fff;border-radius:100px;font-family:inherit;font-size:12px;font-weight:700;color:#6b7a97;cursor:pointer;transition:all .12s;}
    .na-chip.sel{background:var(--blue);color:#fff;border-color:var(--blue);}
    .na-count{background:#fde5e6;color:#d13b42;font-size:11px;font-weight:800;padding:3px 10px;border-radius:100px;}
    .na{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:12px 14px;}
    .na-ic{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .na-ic svg{width:18px;height:18px;stroke-width:1.9;}
    .na-danger{background:#fde5e6;color:#d13b42;} .na-warning{background:#fef1db;color:#c67d0a;} .na-info{background:#e8f0ff;color:#2f6fed;} .na-success{background:#dcf7ec;color:#0f9d63;}
    .na-body{flex:1;min-width:0;}
    .na-t{font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .na-s{font-size:11.5px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .na-time{font-size:10.5px;color:#b3bdd0;flex-shrink:0;font-weight:600;}
    .skel{background:linear-gradient(90deg,#e7edf6 25%,#f2f6fb 50%,#e7edf6 75%);background-size:200% 100%;animation:sh 1.3s infinite;border-radius:8px;}
    @keyframes sh{0%{background-position:200% 0;}100%{background-position:-200% 0;}}

    /* FAB */
    .fab{position:fixed;right:calc(50% - 260px + 20px);bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 18px);z-index:350;background:linear-gradient(135deg,#38bdf8,#0369a1);color:#fff;border:none;border-radius:100px;padding:14px 20px;font-family:inherit;font-size:13.5px;font-weight:700;display:flex;align-items:center;gap:8px;box-shadow:0 12px 26px -8px rgba(56,189,248,.6);cursor:pointer;}
    .fab svg{width:18px;height:18px;}
    @media(max-width:560px){.fab{right:20px;}}

    /* Bottom nav */
    .bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:300;background:#fff;border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom);display:flex;box-shadow:0 -6px 22px rgba(31,56,73,.08);}
    .bn-wrap{max-width:520px;margin:0 auto;width:100%;display:flex;height:var(--nav-h);align-items:stretch;}
    .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-decoration:none;color:var(--muted);font-size:10px;font-weight:600;transition:color .12s;cursor:pointer;}
    .bn-item svg{width:22px;height:22px;stroke-width:2;}
    .bn-item.active{color:var(--cyan,#0ea5e9);}
    /* Tombol tengah menonjol (gaya FlowMint) */
    .bn-fab{flex:0 0 auto;width:66px;display:flex;align-items:flex-start;justify-content:center;position:relative;}
    .bn-fab a,.bn-fab button{position:absolute;font-family:inherit;padding:0;cursor:pointer;top:-22px;width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#0ea5e9);display:flex;align-items:center;justify-content:center;color:#fff;text-decoration:none;box-shadow:0 12px 26px -6px rgba(14,165,233,.6);border:4px solid #fff;transition:transform .14s;}
    .bn-fab a:active,.bn-fab button:active{transform:scale(.92);}
    .bn-fab svg{width:26px;height:26px;stroke-width:2.6;}

    .toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--nav-h) + env(safe-area-inset-bottom) + 16px);background:#1a2b4a;color:#fff;padding:12px 20px;border-radius:13px;font-size:13px;font-weight:600;z-index:400;opacity:0;transition:opacity .25s;max-width:90vw;text-align:center;pointer-events:none;}
    .toast.show{opacity:1;}

    /* Animasi masuk (ease) saat halaman diload */
    @keyframes fadeUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
    .anim{opacity:0;animation:fadeUp .55s cubic-bezier(.22,.61,.36,1) forwards;}
    .anim.d1{animation-delay:.05s;} .anim.d2{animation-delay:.13s;}
    .anim.d3{animation-delay:.21s;} .anim.d4{animation-delay:.29s;}
    /* Stagger untuk item menu */
    .services .svc{opacity:0;animation:fadeUp .5s cubic-bezier(.22,.61,.36,1) forwards;}
    .services .svc:nth-child(1){animation-delay:.14s;} .services .svc:nth-child(2){animation-delay:.18s;}
    .services .svc:nth-child(3){animation-delay:.22s;} .services .svc:nth-child(4){animation-delay:.26s;}
    .services .svc:nth-child(5){animation-delay:.30s;} .services .svc:nth-child(6){animation-delay:.34s;}
    .services .svc:nth-child(7){animation-delay:.38s;} .services .svc:nth-child(8){animation-delay:.42s;}
    .services .svc:nth-child(9){animation-delay:.46s;} .services .svc:nth-child(10){animation-delay:.50s;}
    .services .svc:nth-child(11){animation-delay:.54s;} .services .svc:nth-child(12){animation-delay:.58s;}
    .services .svc:nth-child(13){animation-delay:.62s;} .services .svc:nth-child(14){animation-delay:.66s;}
    /* Jaring pengaman: tile ke-15+ (kalau menu ditambah lagi) tetap tampil. */
    .services .svc:nth-child(n+15){animation-delay:.70s;}
    @media(prefers-reduced-motion:reduce){.anim,.services .svc{animation:none;opacity:1;}}
  </style>
</head>
<body>
  <%- include('../../partials/mobile-drawer', { active: active, appName: (typeof appName!=='undefined'?appName:'FLAYNET'), user: user }) %>
  <div class="wrap">
    <div class="topbar">
      <button class="tb-hamb" onclick="mdrOpen()" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div style="flex:1;"></div>
      <a class="tb-avatar" id="avatarInit" href="/mobile/profile" aria-label="Profil">O</a>
    </div>
    <div class="head">
      <div>
        <div class="who" id="whoName">Owner</div>
