  <script>
    function toggleMenu(){
      const grid=document.querySelector('.services');
      const btn=document.getElementById('menuToggle');
      const open=grid.classList.toggle('expanded');
      btn.classList.toggle('open', open);
      document.getElementById('menuToggleLbl').textContent = open ? 'Sedikitkan' : 'Semua';
    }

    function getToken(){ const ls=localStorage.getItem('token'); if(ls)return ls; const m=document.cookie.match(/(?:^|;\s*)token=([^;]+)/); return m?decodeURIComponent(m[1]):null; }
    async function api(url, opts={}){
      const t=getToken();
      const headers=Object.assign({'Content-Type':'application/json'}, t?{'Authorization':'Bearer '+t}:{}, opts.headers||{});
      try{ const r=await fetch(url,{credentials:'include',headers,...opts});
        if(r.status===401){ location.href='/login'; return null; }
        const txt=await r.text(); let data=null; try{ data=txt?JSON.parse(txt):null; }catch(_){}
        return data;
      }catch(e){ return null; }
    }
    function fmtRp(n){ n=Number(n)||0; return 'Rp '+n.toLocaleString('id-ID'); }
    function fmtRpShort(n){ n=Number(n)||0; if(n>=1000000)return 'Rp '+(n/1000000).toFixed(1).replace('.0','')+'jt'; if(n>=1000)return 'Rp '+Math.round(n/1000)+'rb'; return 'Rp '+n.toLocaleString('id-ID'); }
    function fmtDate(s){ if(!s)return''; const d=new Date(s); if(isNaN(d))return String(s).slice(0,10); return d.toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'}); }

    (function(){
      const h=new Date().getHours();
      const g=h<11?'Selamat pagi':h<15?'Selamat siang':h<19?'Selamat sore':'Selamat malam';
      const nm='<%= (user && user.name) ? user.name : "Owner" %>';
      document.getElementById('whoName').textContent=g+', '+nm;
      document.getElementById('greetTime').textContent='Ringkasan keuangan hari ini';
      const _avatarUrl='<%= (user && user.avatar) ? user.avatar : "" %>';
      const avEl=document.getElementById('avatarInit');
      if(_avatarUrl){ avEl.innerHTML='<img src="'+_avatarUrl+'" alt="Avatar" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;">'; }
      else { avEl.textContent=(nm[0]||'O').toUpperCase(); }
    })();

    // Sparkline putih di kartu hero.
    function drawSpark(pts){
      const svg=document.getElementById('heroSpark'); if(!svg||!pts||pts.length<2){ if(svg)svg.innerHTML=''; return; }
      const W=320,H=56,pad=3,n=pts.length;
      const max=Math.max.apply(null,pts)||1,min=Math.min.apply(null,pts),rng=(max-min)||1;
      const xs=i=>pad+(i*(W-2*pad)/(n-1)), ys=v=>H-pad-((v-min)/rng)*(H-2*pad-6);
      let d='M '+xs(0)+' '+ys(pts[0]);
      for(let i=1;i<n;i++){const x0=xs(i-1),y0=ys(pts[i-1]),x1=xs(i),y1=ys(pts[i]),cx=(x0+x1)/2;d+=' C '+cx+' '+y0+' '+cx+' '+y1+' '+x1+' '+y1;}
      const area=d+' L '+xs(n-1)+' '+H+' L '+xs(0)+' '+H+' Z';
      svg.innerHTML='<defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ffffff" stop-opacity=".4"/><stop offset="100%" stop-color="#ffffff" stop-opacity="0"/></linearGradient></defs>'
        +'<path d="'+area+'" fill="url(#sg)"/>'
        +'<path d="'+d+'" fill="none" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>'
        +'<circle cx="'+xs(n-1)+'" cy="'+ys(pts[n-1])+'" r="3.5" fill="#fff"/>';
    }
    // Cash flow: dua garis income (hijau) vs expense (merah) di kartu putih.
    function drawCashflow(inc, exp){
      const svg=document.getElementById('cfChart'); const n=inc.length;
      if(!svg) return;
      if(n<2){
        // Satu titik (mis. "Bulan ini"): tampilkan titik pemasukan + garis dasar
        // supaya kartu tidak kosong.
        const yIn=inc[0]>=exp[0]?28:60, yEx=inc[0]>=exp[0]?60:28;
        svg.innerHTML='<line x1="0" y1="88" x2="320" y2="88" stroke="#e2eefb" stroke-width="1"/>'
          +'<circle cx="160" cy="'+yEx+'" r="4" fill="#f0a63c"/>'
          +'<circle cx="160" cy="'+yIn+'" r="5" fill="#38bdf8" stroke="#fff" stroke-width="2"/>';
        return;
      }
      const W=320,H=96,pad=5;
      const all=inc.concat(exp), max=Math.max.apply(null,all)||1, min=Math.min(0,Math.min.apply(null,all)), rng=(max-min)||1;
      const xs=i=>pad+(i*(W-2*pad)/(n-1)), ys=v=>H-pad-((v-min)/rng)*(H-2*pad-8);
      function P(arr){let d='M '+xs(0)+' '+ys(arr[0]);for(let i=1;i<n;i++){const x0=xs(i-1),y0=ys(arr[i-1]),x1=xs(i),y1=ys(arr[i]),cx=(x0+x1)/2;d+=' C '+cx+' '+y0+' '+cx+' '+y1+' '+x1+' '+y1;}return d;}
      const dIn=P(inc),dEx=P(exp),areaIn=dIn+' L '+xs(n-1)+' '+H+' L '+xs(0)+' '+H+' Z';
      svg.innerHTML='<defs><linearGradient id="cg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#38bdf8" stop-opacity=".22"/><stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/></linearGradient></defs>'
        +'<path d="'+areaIn+'" fill="url(#cg)"/>'
        +'<path d="'+dEx+'" fill="none" stroke="#f0a63c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>'
        +'<path d="'+dIn+'" fill="none" stroke="#38bdf8" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>'
        +'<circle cx="'+xs(n-1)+'" cy="'+ys(inc[n-1])+'" r="4" fill="#38bdf8" stroke="#fff" stroke-width="2"/>';
    }

    // Muat arus kas untuk N bulan terakhir. Angka (pemasukan/pengeluaran/net)
    // mengikuti periode terpilih; grafik tetap menampilkan tren 6 bulan sebagai
    // konteks (agar kurva tetap terbaca meski periode = 1 bulan).
    // ── Insight slider ──
    var _insights=[];      // {key, html}
    var _aiIdx=0, _aiTimer=null;
    function pushInsight(key, html){
      const i=_insights.findIndex(x=>x.key===key);
      if(i>=0) _insights[i].html=html; else _insights.push({key,html});
      renderInsights();
    }
    function renderInsights(){
      const dots=document.getElementById('aiDots');
      if(!_insights.length) return;
      if(_aiIdx>=_insights.length) _aiIdx=0;
      const ai=document.getElementById('aiInsight');
      ai.classList.add('fading');
      setTimeout(()=>{ ai.innerHTML=_insights[_aiIdx].html; ai.classList.remove('fading'); }, 180);
      dots.innerHTML=_insights.map((_,i)=>'<span class="dot'+(i===_aiIdx?' on':'')+'" onclick="goInsight('+i+')"></span>').join('');
      if(_aiTimer) clearTimeout(_aiTimer);
      if(_insights.length>1){ _aiTimer=setTimeout(()=>{ _aiIdx=(_aiIdx+1)%_insights.length; renderInsights(); }, 5000); }
    }
    function goInsight(i){ _aiIdx=i; renderInsights(); }

    // Insight: kategori pengeluaran terbanyak (dari cashflow bulan ini).
    async function loadTopExpense(){
      const cf=await api('/api/finance/cashflow?months=1');
      const cats=(cf&&cf.success&&cf.data&&Array.isArray(cf.data.outflow_by_category))?cf.data.outflow_by_category:[];
      if(cats.length){
        const top=cats.slice().sort((a,b)=>(b.amount||0)-(a.amount||0))[0];
        if(top&&top.amount>0){
          const nm=(top.category||'lainnya');
          pushInsight('topexp','Pengeluaran terbanyak bulan ini: <b>'+nm+'</b> ('+fmtRpShort(top.amount)+'). Pantau agar tetap efisien.');
        }
      }
    }

    async function loadCashflow(months){
      // Angka periode terpilih.
      const ms=await api('/api/finance/monthly-series?months='+months);
      if(ms&&ms.success&&Array.isArray(ms.data)&&ms.data.length){
        const inc=ms.data.map(d=>d.income||0), exp=ms.data.map(d=>d.expense||0);
        const totIn=inc.reduce((a,b)=>a+b,0), totEx=exp.reduce((a,b)=>a+b,0), net=totIn-totEx;
        _vals.cfIn=fmtRpShort(totIn); _vals.cfOut=fmtRpShort(totEx); _vals.cfNet=fmtRpShort(net);
        const netEl=document.getElementById('cfNet'); netEl.style.color=net>=0?'#0ea5e9':'#e2585f';
        applyHide();  // tampilkan nilai (atau sensor bila toggle aktif)
        const lastIn=inc[inc.length-1]||0, prevIn=inc.length>1?(inc[inc.length-2]||0):0;
        let cfMsg;
        if(prevIn>0){
          const diff=Math.round((lastIn-prevIn)/prevIn*100);
          if(diff>=0) cfMsg='Pemasukan bulan ini <b>naik '+diff+'%</b> dibanding bulan lalu. Pertahankan!';
          else cfMsg='Pemasukan bulan ini <b>turun '+Math.abs(diff)+'%</b>. Cek tagihan yang belum tertagih.';
        } else if(net>=0){ cfMsg='Arus kas periode ini <b>positif</b> — pemasukan melampaui pengeluaran.'; }
        else { cfMsg='Pengeluaran melebihi pemasukan periode ini. Perlu perhatian.'; }
        // Cari kategori pengeluaran terbanyak dari cashflow bulan ini.
        pushInsight('cashflow', cfMsg);
        loadTopExpense();
      }
      // Grafik: selalu tren 6 bulan (min. 3) untuk kurva yang terbaca.
      const chartMonths=Math.max(months,6);
      const cs=await api('/api/finance/monthly-series?months='+chartMonths);
      if(cs&&cs.success&&Array.isArray(cs.data)&&cs.data.length){
        drawCashflow(cs.data.map(d=>d.income||0), cs.data.map(d=>d.expense||0));
        document.getElementById('cfLabels').innerHTML=cs.data.map(d=>'<span>'+(d.label||'')+'</span>').join('');
      }
    }
    function onCfPeriod(){ loadCashflow(parseInt(document.getElementById('cfPeriod').value)||1); }

    async function loadHome(){
      // Sparkline hero: tren 6 bulan (independen dari pilihan periode kartu).
      const sp=await api('/api/finance/monthly-series?months=6');
      if(sp&&sp.success&&Array.isArray(sp.data)&&sp.data.length){
        drawSpark(sp.data.map(d=>d.income||0));
      }
      // Kartu Arus Kas: default "Bulan ini" (1 bulan) sesuai pilihan dropdown.
      await loadCashflow(parseInt(document.getElementById('cfPeriod').value)||1);

      const bs=await api('/api/billing/stats');
      if(bs&&bs.success){
        const s=bs.data;
        _vals.rev=fmtRp(s.revenueThisMonth||0);
        document.getElementById('heroSub').innerHTML='<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;"><polyline points="18 15 12 9 6 15"/></svg> '+(s.paidThisMonth||0)+' invoice lunas bulan ini';
        document.getElementById('stUnpaid').textContent=s.unpaid||0;
        if((s.unpaid||0)>0){
          pushInsight('unpaid','<b>'+s.unpaid+' pelanggan</b> menunggak pembayaran ('+fmtRpShort(s.outstandingInvoiceValue||0)+'). Kirim reminder untuk menagih.');
        }
        const paidVal=s.paidInvoiceValue||0, totalVal=s.totalInvoiceValue||0, outVal=s.outstandingInvoiceValue||0;
        _vals.paid=fmtRpShort(paidVal); _vals.unpaid=fmtRpShort(outVal);
        const pct=totalVal>0?Math.round(paidVal/totalVal*100):0;
        document.getElementById('donutPct').textContent=pct+'%';
        const circ=251.3;
        document.getElementById('donutArc').style.strokeDashoffset=circ-(circ*Math.min(100,pct)/100);
        applyHide();
      }
      const cs=await api('/api/customers/stats');
      if(cs&&cs.success){ const c=cs.data||cs; document.getElementById('stCustomers').textContent=(c.active!=null?c.active:(c.total_active!=null?c.total_active:'–')); }

      const pr=await api('/api/payments/list?limit=5');
      const wrap=document.getElementById('recentPayments');
      const rows=(pr&&pr.success)?(Array.isArray(pr.data)?pr.data:(pr.data&&pr.data.rows?pr.data.rows:[])):[];
      if(rows.length){
        wrap.innerHTML=rows.slice(0,5).map(function(p){
          const nm=p.cust_name||p.customer_name||(p.customer&&p.customer.name)||p.name||'Pelanggan';
          const amt=p.amount||p.total||0; const when=p.payment_date||p.created_at||'';
          const init=(nm[0]||'?').toUpperCase();
          return '<div class="tx">'+
            '<div class="tx-ic" style="background:var(--green-soft);color:var(--green);">'+init+'</div>'+
            '<div class="tx-body"><div class="tx-t">'+nm+'</div><div class="tx-s">'+fmtDate(when)+(p.method_label?(' · '+p.method_label):'')+'</div></div>'+
            '<div class="tx-amt" style="color:var(--green);">+'+fmtRpShort(amt)+'</div>'+
          '</div>';
        }).join('');
      } else { wrap.innerHTML='<div class="empty">Belum ada pembayaran terbaru</div>'; }
    }

    let _naItems=[], _naFilter='all';
    function naSetFilter(f,btn){ _naFilter=f; document.querySelectorAll('.na-chip').forEach(x=>x.classList.remove('sel')); btn.classList.add('sel'); renderNeedAttention(); }
    function renderNeedAttention(){
      const wrap=document.getElementById('needAttention');
      let items=_naItems;
      if(_naFilter!=='all') items=items.filter(x=>x.kind===_naFilter);
      if(items.length){
        wrap.innerHTML=items.slice(0,10).map(function(a){
          const icls=a.kind==='tiket'?(a.crit?'na-danger':'na-info'):'na-warning';
          const ic=a.kind==='tiket'
            ?'<rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>'
            :'<circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>';
          return '<div class="na"><div class="na-ic '+icls+'"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">'+ic+'</svg></div>'+
            '<div class="na-body"><div class="na-t">'+esc(a.title)+'</div><div class="na-s">'+esc(a.sub)+'</div></div>'+
            (a.time?('<div class="na-time">'+timeAgo(a.time)+'</div>'):'')+'</div>';
        }).join('');
      } else {
        wrap.innerHTML='<div class="na"><div class="na-ic na-success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg></div><div class="na-body"><div class="na-t">Semua normal</div><div class="na-s">Tidak ada '+(_naFilter==='all'?'gangguan':(_naFilter==='isolir'?'pelanggan terisolir':'tiket terbuka'))+' saat ini</div></div></div>';
      }
    }
    function timeAgo(s){ if(!s)return''; const d=new Date(s); if(isNaN(d))return''; const diff=(Date.now()-d.getTime())/1000; if(diff<60)return 'baru saja'; if(diff<3600)return Math.floor(diff/60)+'m lalu'; if(diff<86400)return Math.floor(diff/3600)+'j lalu'; return Math.floor(diff/86400)+'h lalu'; }
    async function loadNeedAttention(){
      const badge=document.getElementById('naCount');
      const [tj,ij]=await Promise.all([ api('/api/tickets?status=open&limit=20'), api('/api/isolir/isolated') ]);
      const items=[];
      const tickets=(tj&&tj.success)?(tj.data&&tj.data.rows?tj.data.rows:(Array.isArray(tj.data)?tj.data:[])):[];
      tickets.forEach(t=>{ const crit=(t.priority==='critical'||t.priority==='high'); items.push({ kind:'tiket', crit:crit, title:t.title||('Tiket '+(t.ticket_number||'')), sub:'Tiket '+(t.priority||'')+' · '+(t.status||'open'), time:t.created_at }); });
      const iso=(ij&&ij.success)?(Array.isArray(ij.data)?ij.data:(ij.data&&ij.data.rows?ij.data.rows:[])):[];
      iso.forEach(c=>{ items.push({ kind:'isolir', crit:false, title:c.name||'Pelanggan', sub:'Pelanggan terisolir · '+(c.customer_id||''), time:c.isolir_at }); });
      if(iso.length){ pushInsight('isolir','<b>'+iso.length+' pelanggan</b> sedang terisolir. Aktifkan kembali setelah pembayaran diterima.'); }
      _naItems=items;
      const critCount=items.filter(x=>x.crit).length;
      if(items.length){ badge.style.display='inline-block'; badge.textContent=items.length+(critCount?(' · '+critCount+' kritis'):''); document.getElementById('naFilter').style.display='flex'; }
      else { badge.style.display='none'; document.getElementById('naFilter').style.display='none'; }
      renderNeedAttention();
    }
    function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    // Toggle sensor nominal
    let _hidden=false, _vals={rev:'',paid:'',unpaid:'',cfIn:'',cfOut:'',cfNet:''};
    function applyHide(){
      const mask='••••••';
      document.getElementById('heroRevenue').textContent=_hidden?('Rp '+mask):_vals.rev;
      document.getElementById('hlPaid').textContent=_hidden?mask:_vals.paid;
      document.getElementById('hlUnpaid').textContent=_hidden?mask:_vals.unpaid;
      // Arus Kas ikut tersensor bila ada nilainya.
      const ci=document.getElementById('cfIncome'), ce=document.getElementById('cfExpense'), cn=document.getElementById('cfNet');
      if(ci&&_vals.cfIn) ci.textContent=_hidden?mask:_vals.cfIn;
      if(ce&&_vals.cfOut) ce.textContent=_hidden?mask:_vals.cfOut;
      if(cn&&_vals.cfNet) cn.textContent=_hidden?mask:_vals.cfNet;
      document.getElementById('eyeIcon').innerHTML=_hidden
        ?'<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>'
        :'<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/>';
    }
    function toggleHide(){ _hidden=!_hidden; try{localStorage.setItem('flaynet_hide_amount',_hidden?'1':'0');}catch(e){} applyHide(); }
    (function(){ try{ _hidden=localStorage.getItem('flaynet_hide_amount')==='1'; }catch(e){} })();

    // ── Pertumbuhan Pelanggan (grafik batang pelanggan baru per bulan) ──
    var _growMonths=[], _growVals=[], _growLabels=[], _growSelIdx=-1, _growListShown=true;
    const _GMN=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
    const _GMN_FULL=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

    async function loadGrowth(){
      const card=document.getElementById('growCard');
      const g=await api('/api/dashboard/customer-growth?months=6');
      if(!g||!g.success||!g.data){ if(card) card.style.display='none'; return; }
      const sm=g.data.summary||{}, rows=Array.isArray(g.data.monthly_data)?g.data.monthly_data:[];

      const newThis=sm.current_month_new||0;
      document.getElementById('growBadge').textContent = (newThis>=0?'+':'')+newThis+' bulan ini';
      document.getElementById('gsTotal').textContent = sm.total_customers!=null?sm.total_customers:'–';
      const totalNew=rows.reduce((a,r)=>a+(parseInt(r.new_customers)||0),0);
      const avg=rows.length?Math.round(totalNew/rows.length):0;
      document.getElementById('gsAvg').textContent = avg;
      const rate=sm.growth_rate;
      const gsRate=document.getElementById('gsRate');
      gsRate.textContent = (rate!=null?((rate>0?'+':'')+rate+'%'):'–');
      gsRate.style.color = (rate>0?'#0284c7':(rate<0?'#e2585f':'#1f3849'));

      try{ if(typeof pushInsight==='function' && newThis>0){ pushInsight('growth','<b>+'+newThis+' pelanggan baru</b> bulan ini. Total kini <b>'+(sm.total_customers||0)+'</b> pelanggan.'); } }catch(_){}

      _growMonths=rows.map(r=>r.month||'');
      _growVals=rows.map(r=>parseInt(r.new_customers)||0);
      _growLabels=rows.map(r=>{ const p=(r.month||'').split('-'); return p[1]?_GMN[parseInt(p[1])-1]:''; });
      if(!_growVals.length){ if(card) card.style.display='none'; return; }

      _growSelIdx=_growVals.length-1;   // default: bulan terakhir (bulan ini)
      _renderGrowBars();
      // Muat daftar pelanggan bulan terpilih.
      selectGrowMonth(_growSelIdx, true);
    }

    function _renderGrowBars(){
      const svg=document.getElementById('growChart');
      const lblWrap=document.getElementById('growLabels');
      const W=320,H=110,pad=6,gapR=0.34;
      const n=_growVals.length, max=Math.max.apply(null,_growVals)||1;
      const slot=(W-2*pad)/n, bw=slot*(1-gapR);
      let bars='';
      for(let i=0;i<n;i++){
        const h=Math.max(3,(_growVals[i]/max)*(H-24));
        const x=pad+i*slot+(slot-bw)/2, y=H-14-h;
        const sel=i===_growSelIdx;
        const fill=sel?'url(#gbar)':'#dbeafe';
        // Area klik penuh tinggi (transparan) supaya batang pendek tetap mudah di-tap.
        bars+='<rect x="'+(pad+i*slot).toFixed(1)+'" y="0" width="'+slot.toFixed(1)+'" height="'+H+'" fill="transparent" style="cursor:pointer" onclick="selectGrowMonth('+i+')"/>';
        bars+='<rect x="'+x.toFixed(1)+'" y="'+y.toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+h.toFixed(1)+'" rx="4" fill="'+fill+'" style="pointer-events:none"/>';
        bars+='<text x="'+(x+bw/2).toFixed(1)+'" y="'+(y-4).toFixed(1)+'" text-anchor="middle" font-size="10" font-weight="800" fill="'+(sel?'#0284c7':'#8296a8')+'" font-family="inherit" style="pointer-events:none">'+_growVals[i]+'</text>';
      }
      svg.innerHTML='<defs><linearGradient id="gbar" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#38bdf8"/><stop offset="100%" stop-color="#0ea5e9"/></linearGradient></defs>'+bars;
      lblWrap.innerHTML=_growLabels.map((l,i)=>'<span style="'+(i===_growSelIdx?'color:#0284c7;font-weight:800;':'')+'">'+l+'</span>').join('');
    }

    function _monthLabelFull(ym){
      const p=(ym||'').split('-'); if(p.length<2) return '';
      const now=new Date(), cy=now.getFullYear(), cm=now.getMonth()+1;
      const y=parseInt(p[0]), mo=parseInt(p[1]);
      let s=_GMN_FULL[mo-1]+(y!==cy?(' '+y):'');
      if(y===cy&&mo===cm) s='bulan ini';
      else { const lm=cm===1?12:cm-1, ly=cm===1?cy-1:cy; if(y===ly&&mo===lm) s='bulan lalu'; }
      return s;
    }

    async function selectGrowMonth(idx, silent){
      if(idx<0||idx>=_growMonths.length) return;
      _growSelIdx=idx;
      _renderGrowBars();
      const ym=_growMonths[idx];
      const lbl=_monthLabelFull(ym);
      const isRel=(lbl==='bulan ini'||lbl==='bulan lalu');
      document.getElementById('growListTitle').textContent = 'Pelanggan baru '+(isRel?lbl:('bulan '+lbl));
      await loadGrowthList(ym);
    }

    async function loadGrowthList(ym){
      const box=document.getElementById('growList');
      if(!_growListShown){ return; }
      box.innerHTML='<div class="gl-loading">Memuat daftar…</div>';
      const r=await api('/api/dashboard/customer-growth-list?month='+encodeURIComponent(ym)+'&limit=100');
      const list=(r&&r.success&&Array.isArray(r.data))?r.data:[];
      if(!list.length){ box.innerHTML='<div class="gl-empty">Tidak ada pelanggan baru di bulan ini.</div>'; return; }
      box.innerHTML=list.map(function(c){
        const nm=c.name||'Pelanggan';
        const init=(nm[0]||'?').toUpperCase();
        const pkg=c.package_name?('<span class="gl-pkg">'+esc(c.package_name)+(c.package_speed?(' · '+c.package_speed+'M'):'')+'</span>'):'<span class="gl-pkg" style="background:#eef1f6;color:#8296a8;">Tanpa paket</span>';
        const cid=c.customer_id?esc(c.customer_id):'';
        const dt=c.activation_date?_fmtActDate(c.activation_date):'';
        return '<div class="gl-item">'
          +'<div class="gl-av">'+esc(init)+'</div>'
          +'<div class="gl-body"><div class="gl-name">'+esc(nm)+'</div>'
          +'<div class="gl-meta">'+cid+'</div>'+pkg+'</div>'
          +'<div class="gl-date">Aktivasi<br>'+dt+'</div>'
        +'</div>';
      }).join('');
    }

    function _fmtActDate(s){
      const d=new Date(s); if(isNaN(d)) return esc(s);
      return d.getDate()+' '+_GMN[d.getMonth()]+' '+String(d.getFullYear()).slice(2);
    }

    function toggleGrowList(){
      _growListShown=!_growListShown;
      const box=document.getElementById('growList');
      const btn=document.getElementById('growListToggle');
      box.classList.toggle('collapsed', !_growListShown);
      btn.textContent = _growListShown?'Sembunyikan':'Tampilkan';
      if(_growListShown && _growSelIdx>=0) loadGrowthList(_growMonths[_growSelIdx]);
    }

    loadHome();
    loadNeedAttention();
    loadGrowth();
  </script>
</body>
</html>
