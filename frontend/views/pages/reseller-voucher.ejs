        <div class="fg-row">
          <div class="fg"><label>Mulai</label><input id="pmoStart" type="date"></div>
          <div class="fg"><label>Berakhir</label><input id="pmoEnd" type="date"></div>
        </div>
        <div class="switch-row" style="margin-top:4px"><div><div class="sl">Auto-apply</div><div class="sd">Berlaku otomatis tanpa kode</div></div><label class="switch"><input type="checkbox" id="pmoAuto"><span class="track"></span></label></div>
        <div class="switch-row"><div><div class="sl">Aktif</div></div><label class="switch"><input type="checkbox" id="pmoActive" checked><span class="track"></span></label></div>
        <div style="display:flex;gap:9px;margin-top:14px">
          <button class="btn btn-soft" onclick="document.getElementById('promoForm').style.display='none'" style="flex:1">Batal</button>
          <button class="btn btn-teal" onclick="savePromo()" style="flex:1">Simpan</button>
        </div>
      </div>
      <div id="promoList"></div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  const API = '/api/reseller-admin';
  let DEVICES = [];

  function authHeaders(extra){
    const t = localStorage.getItem('token') || '';
    return Object.assign({ 'Authorization':'Bearer '+t, 'X-Requested-With':'XMLHttpRequest' }, extra||{});
  }
  async function apiCall(path, opts={}){
    opts.headers = authHeaders(opts.headers);
    if(opts.body && typeof opts.body!=='string'){ opts.headers['Content-Type']='application/json'; opts.body=JSON.stringify(opts.body); }
    const r = await fetch(API+path, opts);
    return r.json();
  }
  const fmtRp = n => 'Rp '+Number(n||0).toLocaleString('id-ID');
  function fmtDate(d){ if(!d) return '—'; try{ return new Date(d).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}); }catch(_){ return String(d); } }
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
  function toast(m){ const t=document.getElementById('toast'); t.textContent=m; t.classList.add('show'); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('show'),2400); }
  function closeModals(){ document.querySelectorAll('.modal-bg').forEach(m=>m.classList.remove('show')); }

  // ── Styled confirm dialog (Promise-based, ganti confirm/prompt) ──
  // opts: { title, message, okText, tone:'ok'|'warn'|'info', input:{label,placeholder} }
  function rvConfirm(opts){
    return new Promise(resolve=>{
      const ov=document.getElementById('confirmDialog');
      const icn=document.getElementById('cfIcn'), ok=document.getElementById('cfOk'), cancel=document.getElementById('cfCancel');
      const field=document.getElementById('cfField'), input=document.getElementById('cfInput');
      const tone=opts.tone||'info';
      document.getElementById('cfTitle').textContent=opts.title||'Konfirmasi';
      document.getElementById('cfMsg').textContent=opts.message||'';
      icn.className='cf-icn '+tone;
      const icons={ ok:'<path d="M20 6 9 17l-5-5"/>', warn:'<path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>', info:'<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/>' };
      icn.innerHTML='<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">'+(icons[tone]||icons.info)+'</svg>';
      ok.textContent=opts.okText||'OK';
      ok.className='cf-btn cf-ok is-'+tone;
      if(opts.input){ field.style.display='block'; document.getElementById('cfFieldLbl').textContent=opts.input.label||'Catatan'; input.value=opts.input.value||''; input.placeholder=opts.input.placeholder||''; }
      else field.style.display='none';
      ov.classList.add('show');
      if(opts.input) setTimeout(()=>input.focus(),60);
      function cleanup(){ ov.classList.remove('show'); ok.onclick=null; cancel.onclick=null; }
      ok.onclick=()=>{ const val=opts.input?input.value.trim():true; cleanup(); resolve(opts.input?val:true); };
      cancel.onclick=()=>{ cleanup(); resolve(opts.input?null:false); };
      ov.onclick=e=>{ if(e.target===ov){ cleanup(); resolve(opts.input?null:false); } };
    });
  }

  function rvTab(name, opt){
    document.querySelectorAll('.rv-tab').forEach(t=>t.classList.toggle('active', t.dataset.tab===name));
    document.querySelectorAll('.rv-pane').forEach(p=>p.classList.toggle('active', p.id==='pane-'+name));
    if(name==='packages') loadPackages();
    if(name==='puborders') loadPublicOrders();
    if(name==='topups'){
      if(opt){ const sel=document.getElementById('topupStatusFilter'); if(sel) sel.value=opt; }
      loadTopups();
    }
    if(name==='report') loadGlobalReport();
    try{ window.scrollTo({top:0,behavior:'smooth'}); }catch(_){}
  }
  // Aksesibilitas: kartu/clickable bisa ditekan via Enter/Space
  document.addEventListener('keydown',e=>{
    if((e.key==='Enter'||e.key===' ') && e.target.classList && e.target.classList.contains('ov-card')){
      e.preventDefault(); e.target.click();
    }
  });

  // ── Devices for selects ──────────────────────────────────────
  async function loadDevices(){
    try{
      const t = localStorage.getItem('token')||'';
      const r = await fetch('/api/devices?type=router', { headers: authHeaders() });
      const j = await r.json();
      DEVICES = (j.data||j.devices||[]).filter(d=>!d.type||d.type==='router');
      const opts = DEVICES.map(d=>`<option value="${d.id}">${esc(d.name)}</option>`).join('');
      const rd=document.getElementById('rmDevice'); if(rd) rd.innerHTML='<option value="">Default (env)</option>'+opts;
      const pd=document.getElementById('pmDevice'); if(pd) pd.innerHTML='<option value="">Semua router</option>'+opts;
    }catch(e){}
  }

  // ── Hotspot servers (auto dari MikroTik, untuk dropdown server) ──
  async function loadHotspotServers(selected){
    const sel = document.getElementById('rmServer');
    const hint = document.getElementById('rmServerHint');
    const deviceId = document.getElementById('rmDevice').value;
    const want = selected || sel.value || 'all';
    sel.innerHTML = '<option value="all">memuat…</option>'; sel.disabled = true;
    try{
      const r = await fetch('/api/reseller-admin/hotspot-servers'+(deviceId?('?device_id='+deviceId):''), { headers: authHeaders() });
      const j = await r.json();
      const servers = (j.data && j.data.servers) || [];
      let opts = '<option value="all">all (semua server)</option>';
      opts += servers.map(s=>`<option value="${esc(s)}">${esc(s)}</option>`).join('');
      sel.innerHTML = opts;
      // pertahankan pilihan lama bila masih ada; jika tidak, tambahkan agar tak hilang
      if(want && want!=='all' && !servers.includes(want)){
        sel.insertAdjacentHTML('beforeend', `<option value="${esc(want)}">${esc(want)} (tersimpan)</option>`);
      }
      sel.value = want;
      if(hint) hint.textContent = j.success
        ? (servers.length? 'Diambil otomatis dari router.' : 'Router tak punya server hotspot — pakai "all".')
        : 'Router tak terjangkau — pilihan "all" tetap bisa dipakai.';
    }catch(e){
      sel.innerHTML = '<option value="all">all (semua server)</option>';
      if(want && want!=='all'){ sel.insertAdjacentHTML('beforeend', `<option value="${esc(want)}">${esc(want)}</option>`); sel.value=want; }
      if(hint) hint.textContent = 'Gagal mengambil server dari router — pakai "all".';
    }finally{ sel.disabled = false; }
  }

  // ── Resellers ────────────────────────────────────────────────
  let _t;
  function debouncedLoadResellers(){ clearTimeout(_t); _t=setTimeout(loadResellers,300); }
  async function loadResellers(){
    const q = document.getElementById('rSearch').value.trim();
    const tb = document.getElementById('resellerRows');
    try{
      const j = await apiCall('/resellers'+(q?('?q='+encodeURIComponent(q)):''));
      const rows = j.data||[];
      window.__RESELLERS = rows;
      // Update overview: total reseller (hanya saat tanpa filter pencarian)
      if(!q){
        document.getElementById('ovResellers').textContent = rows.length;
        const totalBal = rows.reduce((s,r)=>s+Number(r.balance||0),0);
        document.getElementById('ovBalance').textContent = fmtRp(totalBal);
      }
      if(!rows.length){
        tb.innerHTML = '<tr><td colspan="5"><div class="empty"><svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg><div class="e-ttl">'+(q?'Tidak ada hasil':'Belum ada reseller')+'</div><div>'+(q?'Coba kata kunci lain.':'Klik “Reseller Baru” untuk membuat yang pertama.')+'</div></div></td></tr>';
        return;
      }
      tb.innerHTML = rows.map(r=>{
        const initial = (r.name||'?').trim().charAt(0).toUpperCase();
        return `<tr>
          <td class="cell-main-td"><div class="cell-main">
            <div class="avatar">${esc(initial)}</div>
            <div><div class="r-name">${esc(r.name)}</div><div class="r-sub">${esc(r.code)}${r.phone?(' • '+esc(r.phone)):''}</div></div>
          </div></td>
          <td data-label="Saldo" class="r-bal">${fmtRp(r.balance)}</td>
          <td data-label="Router">${esc(r.device_name||'Default')}</td>
          <td data-label="Status"><span class="badge ${r.is_active?'on':'off'}">${r.is_active?'Aktif':'Nonaktif'}</span></td>
          <td class="cell-actions"><div class="row-actions">
            <button class="ico-btn" title="Voucher hotspot" onclick="openResellerVouchers(${r.id},'${esc(r.name).replace(/'/g,"\\'")}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M2 8.82a15 15 0 0 1 20 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></button>
            <button class="ico-btn" title="Isi saldo" onclick='openTopup(${JSON.stringify(r)})'><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></button>
            <button class="ico-btn" title="Edit" onclick='editReseller(${JSON.stringify(r)})'><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button>
            <button class="ico-btn danger" title="Hapus" onclick="removeReseller(${r.id},'${esc(r.name).replace(/'/g,"\\'")}')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
          </div></td>
        </tr>`;
      }).join('');
    }catch(e){ tb.innerHTML='<tr><td colspan="5" class="empty">Gagal memuat data.</td></tr>'; }
  }

  // Isi dropdown induk (master agen), kecualikan diri sendiri (anti-loop).
  function populateParents(selectedId, excludeId){
    const sel=document.getElementById('rmParent'); if(!sel) return;
    const list=(window.__RESELLERS||[]).filter(r=>r.id!==excludeId);
    sel.innerHTML='<option value="">— (langsung di bawah admin)</option>'+
      list.map(r=>`<option value="${r.id}">${esc(r.name)} (${esc(r.code)})</option>`).join('');
    sel.value=selectedId||'';
  }

  function openResellerModal(){
    document.getElementById('rmTitle').textContent='Reseller Baru';
    document.getElementById('rmId').value='';
    ['rmCode','rmName','rmPhone','rmPassword','rmAddress'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('rmMaxBatch').value=100;
    document.getElementById('rmInitBalance').value=0;
    document.getElementById('rmDevice').value='';
    document.getElementById('rmDiscount').value=0;
    document.getElementById('rmTier').value='';
    document.getElementById('rmCommission').value=0;
    populateParents(null);
    document.getElementById('rmCode').disabled=false;
    document.getElementById('rmInitWrap').style.display='';
    document.getElementById('rmActiveWrap').style.display='none';
    document.getElementById('rmPwLabel').innerHTML='Password <span class="req">*</span>';
    document.getElementById('resellerModal').classList.add('show');
    loadHotspotServers('all');
  }
  function editReseller(r){
    document.getElementById('rmTitle').textContent='Edit Reseller';
    document.getElementById('rmId').value=r.id;
    document.getElementById('rmCode').value=r.code; document.getElementById('rmCode').disabled=true;
    document.getElementById('rmName').value=r.name;
    document.getElementById('rmPhone').value=r.phone||'';
    document.getElementById('rmAddress').value=r.address||'';
    document.getElementById('rmPassword').value='';
    document.getElementById('rmMaxBatch').value=r.max_per_batch||100;
    document.getElementById('rmDevice').value=r.device_id||'';
    document.getElementById('rmDiscount').value=r.price_discount_percent!=null?r.price_discount_percent:0;
    document.getElementById('rmTier').value=r.price_tier||'';
    document.getElementById('rmCommission').value=r.commission_percent!=null?r.commission_percent:0;
    populateParents(r.parent_id||null, r.id);
    document.getElementById('rmInitWrap').style.display='none';
    document.getElementById('rmActiveWrap').style.display='';
    document.getElementById('rmActive').checked=!!r.is_active;
    document.getElementById('rmPwLabel').textContent='Password baru (kosongkan jika tetap)';
    document.getElementById('resellerModal').classList.add('show');
    loadHotspotServers(r.hotspot_server||'all');
  }
  async function saveReseller(){
    const id=document.getElementById('rmId').value;
    const payload={
      name:document.getElementById('rmName').value.trim(),
      phone:document.getElementById('rmPhone').value.trim(),
      address:document.getElementById('rmAddress').value.trim(),
      device_id:document.getElementById('rmDevice').value||null,
      hotspot_server:document.getElementById('rmServer').value.trim()||'all',
      max_per_batch:document.getElementById('rmMaxBatch').value,
      price_discount_percent:document.getElementById('rmDiscount').value,
      price_tier:document.getElementById('rmTier').value||null,
      parent_id:document.getElementById('rmParent').value||null,
      commission_percent:document.getElementById('rmCommission').value
    };
    const pw=document.getElementById('rmPassword').value;
    try{
      let j;
      if(id){
        payload.is_active=document.getElementById('rmActive').checked;
        if(pw) payload.password=pw;
        j = await apiCall('/resellers/'+id,{method:'PUT',body:payload});
      } else {
        payload.code=document.getElementById('rmCode').value.trim();
        payload.password=pw;
        payload.initial_balance=document.getElementById('rmInitBalance').value;
        j = await apiCall('/resellers',{method:'POST',body:payload});
      }
      if(j.success){ toast(j.message||'Tersimpan'); closeModals(); loadResellers(); }
      else toast(j.message||'Gagal menyimpan');
    }catch(e){ toast('Terjadi kesalahan'); }
  }
  async function removeReseller(id,name){
    const ok = await rvConfirm({ title:'Hapus Reseller', message:'Hapus / nonaktifkan reseller "'+name+'"? Akun tidak akan bisa login lagi.', okText:'Hapus', tone:'warn' });
    if(!ok) return;
    const j = await apiCall('/resellers/'+id,{method:'DELETE'});
    if(j.success){ toast(j.message); loadResellers(); } else toast(j.message||'Gagal');
  }

  // ── Voucher hotspot per reseller (admin viewer) ──────────────
  let _rvvId=null, _rvvName='', _rvvFilter='', _rvvData=[];
  const RVV_BADGE={ active:{t:'ONLINE',c:'active'}, used:{t:'TERPAKAI',c:'used'}, expired:{t:'EXPIRED',c:'expired'}, unused:{t:'BELUM',c:'unused'} };
  function rvvBytes(n){ n=Number(n)||0; if(n<1024) return n+' B'; if(n<1048576) return (n/1024).toFixed(1)+' KB'; if(n<1073741824) return (n/1048576).toFixed(1)+' MB'; return (n/1073741824).toFixed(2)+' GB'; }
  function openResellerVouchers(id,name){
    _rvvId=id; _rvvName=name; _rvvFilter='';
    document.getElementById('rvvTitle').textContent='Voucher Hotspot';
    document.getElementById('rvvSub').textContent=name;
    document.querySelectorAll('#rvvChips .rvv-chip').forEach(c=>c.classList.toggle('on',(c.dataset.f||'')===''));
    document.getElementById('rvVouchersModal').classList.add('show');
    reloadResellerVouchers();
  }
  function reloadResellerVouchers(){
    const list=document.getElementById('rvvList');
    list.innerHTML='<div class="empty">Memuat voucher dari router…</div>';
    apiCall('/resellers/'+_rvvId+'/vouchers').then(j=>{
      if(!j.success){ list.innerHTML='<div class="empty"><div class="e-ttl">Gagal memuat</div><div>'+esc(j.message||'Router tak terjangkau')+'</div></div>'; document.getElementById('rvvMeta').innerHTML=''; return; }
      _rvvData=j.data||[];
      const c=j.counts||{total:0,active:0,expired:0,used:0,unused:0};
      if(j.reseller) document.getElementById('rvvSub').textContent=j.reseller.name+' • '+(j.reseller.device_name||'Default');
      document.getElementById('rvvMeta').innerHTML=`
        <div class="rvv-mc"><div class="n">${c.total}</div><div class="t">Total</div></div>
        <div class="rvv-mc c-active"><div class="n">${c.active}</div><div class="t">Online</div></div>
        <div class="rvv-mc c-used"><div class="n">${c.used}</div><div class="t">Terpakai</div></div>
        <div class="rvv-mc c-expired"><div class="n">${c.expired}</div><div class="t">Expired</div></div>
        <div class="rvv-mc c-unused"><div class="n">${c.unused}</div><div class="t">Belum</div></div>`;
      document.getElementById('rvc-all').textContent=c.total;
      document.getElementById('rvc-active').textContent=c.active;
      document.getElementById('rvc-used').textContent=c.used;
      document.getElementById('rvc-expired').textContent=c.expired;
      document.getElementById('rvc-unused').textContent=c.unused;
      renderRvv();
    }).catch(()=>{ list.innerHTML='<div class="empty">Gagal memuat voucher.</div>'; });
  }
  function rvvFilter(f){
    _rvvFilter=f;
    document.querySelectorAll('#rvvChips .rvv-chip').forEach(c=>c.classList.toggle('on',(c.dataset.f||'')===f));
    renderRvv();
  }
  function renderRvv(){
    const list=document.getElementById('rvvList');
    let rows=_rvvData;
    if(_rvvFilter) rows=rows.filter(v=>v.status===_rvvFilter);
    if(!rows.length){ list.innerHTML='<div class="empty">'+(_rvvData.length?'Tidak ada voucher pada filter ini.':'Reseller ini belum punya voucher di router.')+'</div>'; return; }
    list.innerHTML=rows.map(v=>{
      const b=RVV_BADGE[v.status]||RVV_BADGE.unused;
      let sub;
      if(v.status==='unused') sub='Profil '+esc(v.profile||'-')+' • belum dipakai';
      else if(v.status==='expired') sub='Profil '+esc(v.profile||'-')+' • masa aktif habis • '+rvvBytes(v.bytes_total);
      else sub='Profil '+esc(v.profile||'-')+' • '+esc(v.uptime||'0s')+' • '+rvvBytes(v.bytes_total);
      const cut=v.status==='active'?`<button class="rvv-ib cut" title="Putus sesi" onclick="rvvAction('${esc(v.username)}','disconnect')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><path d="M12 2v10"/></svg></button>`:'';
      return `<div class="rvv-row s-${v.status}"><span class="d"></span>
        <div class="mid"><div class="u">${esc(v.username)}</div><div class="s">${sub}</div></div>
        <span class="rvv-bdg ${b.c}">${b.t}</span>
        <div class="acts">${cut}<button class="rvv-ib del" title="Hapus" onclick="rvvAction('${esc(v.username)}','delete')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button></div>
      </div>`;
    }).join('');
  }
  async function rvvAction(username,action){
    if(action==='delete'){ const ok=await rvConfirm({title:'Hapus Voucher',message:'Hapus voucher "'+username+'" dari router?',okText:'Hapus',tone:'warn'}); if(!ok) return; }
    const j=await apiCall('/resellers/'+_rvvId+'/vouchers/action',{method:'POST',body:{username,action}});
    if(j.success){ toast(j.message||'Berhasil'); reloadResellerVouchers(); } else toast(j.message||'Gagal');
  }
  async function bulkDeleteExpired(){
    const ok=await rvConfirm({title:'Hapus Voucher Expired',message:'Hapus SEMUA voucher berstatus expired milik reseller ini dari router? Tindakan tidak bisa dibatalkan.',okText:'Hapus Semua',tone:'warn'});
    if(!ok) return;
    const j=await apiCall('/resellers/'+_rvvId+'/vouchers/bulk',{method:'POST',body:{action:'delete',status:'expired'}});
    if(j.success){ toast(j.message||'Selesai'); reloadResellerVouchers(); } else toast(j.message||'Gagal');
  }

  // ── Promo manager (#10) ──────────────────────────────────────
  function openPromoManager(){ document.getElementById('promoModal').classList.add('show'); document.getElementById('promoForm').style.display='none'; loadPromos(); }
  async function loadPromos(){
    const box=document.getElementById('promoList');
    box.innerHTML='<div class="empty">Memuat…</div>';
    const j=await apiCall('/promos');
    const list=(j&&j.data)||[];
    if(!list.length){ box.innerHTML='<div class="empty">Belum ada promo. Klik "Promo Baru".</div>'; return; }
    box.innerHTML=list.map(p=>{
      const val=p.type==='percent'?(Number(p.value)+'%'):fmtRp(p.value);
      const tags=[]; if(p.auto_apply) tags.push('AUTO'); if(!p.is_active) tags.push('NONAKTIF');
      return `<div style="display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--border);border-radius:13px;padding:12px 14px;margin-bottom:8px">
        <div style="flex:1;min-width:0">
          <div style="font-weight:800;font-size:13.5px">${esc(p.name)} ${p.code?('· <span style=\"font-family:var(--fm);color:var(--blue)\">'+esc(p.code)+'</span>'):''} ${tags.map(t=>'<span style=\"font-size:9px;font-weight:800;background:#eef1f7;color:#64748b;padding:2px 6px;border-radius:5px;margin-left:4px\">'+t+'</span>').join('')}</div>
          <div style="font-size:11.5px;color:var(--text3);margin-top:3px">Bonus ${val} · min ${fmtRp(p.min_topup)} · dipakai ${p.used_count}${p.quota_total>0?('/'+p.quota_total):''}</div>
        </div>
