      ends_at:document.getElementById('pmoEnd').value||null,
      auto_apply:document.getElementById('pmoAuto').checked,
      is_active:document.getElementById('pmoActive').checked
    };
    if(!payload.name){ toast('Nama promo wajib diisi'); return; }
    const j=id?await apiCall('/promos/'+id,{method:'PUT',body:payload}):await apiCall('/promos',{method:'POST',body:payload});
