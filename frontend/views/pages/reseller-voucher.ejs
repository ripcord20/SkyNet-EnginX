  function renderReportCharts(data){
    const ch = data.chart || { labels:[], vouchers:[], modal:[], topup:[] };
    // Income vs sales (combo: bar topup + area modal)
    const incomeEl=document.getElementById('repChartIncome');
    if(incomeEl){
      const labels = ch.labels.map(d=>{ const dt=new Date(d+'T00:00:00'); return dt.toLocaleDateString('id-ID',{day:'2-digit',month:'short'}); });
      const opt={
        chart:{ type:'line', height:280, fontFamily:"'DM Sans',sans-serif", toolbar:{show:false}, animations:{enabled:true,speed:500} },
        series:[
          { name:'Deposit Masuk', type:'column', data:ch.topup },
          { name:'Modal Voucher', type:'area', data:ch.modal }
        ],
        stroke:{ width:[0,3], curve:'smooth' },
        plotOptions:{ bar:{ borderRadius:5, columnWidth:'48%' } },
        fill:{ type:['solid','gradient'], opacity:[1,.18], gradient:{ shadeIntensity:1, opacityFrom:.35, opacityTo:.05 } },
        colors:[REP_COLORS.blue, REP_COLORS.teal],
        dataLabels:{ enabled:false },
        grid:{ borderColor:'rgba(148,163,184,.18)', strokeDashArray:4, padding:{left:6,right:6} },
        xaxis:{ categories:labels, labels:{ style:{ colors:'#94a3b8', fontSize:'10px' }, hideOverlappingLabels:true }, axisBorder:{show:false}, axisTicks:{show:false} },
        yaxis:{ labels:{ style:{ colors:'#94a3b8', fontSize:'10px' }, formatter:v=>v>=1000?(Math.round(v/1000)+'k'):Math.round(v) } },
        legend:{ position:'top', horizontalAlign:'right', fontSize:'12px', labels:{ colors:'#64748b' }, markers:{ radius:3 } },
        tooltip:{ shared:true, y:{ formatter:v=>fmtRp(v) } }
      };
      if(_repChartIncome){ _repChartIncome.updateOptions(opt,true,true); }
      else { _repChartIncome=new ApexCharts(incomeEl,opt); _repChartIncome.render(); }
    }
    // Performance: horizontal bar voucher per reseller (top 8)
    const perfEl=document.getElementById('repChartPerf');
    if(perfEl){
      const top=(data.ranking||[]).slice(0,8);
      if(!top.length){
        perfEl.innerHTML='<div class="empty" style="padding:40px">Belum ada data performa reseller.</div>';
        if(_repChartPerf){ try{_repChartPerf.destroy();}catch(_){} _repChartPerf=null; }
      } else {
        const opt={
          chart:{ type:'bar', height:280, fontFamily:"'DM Sans',sans-serif", toolbar:{show:false}, animations:{enabled:true,speed:500} },
          series:[{ name:'Voucher Terjual', data: top.map(r=>r.vouchers) }],
          plotOptions:{ bar:{ horizontal:true, borderRadius:6, barHeight:'62%', distributed:true } },
          colors:[REP_COLORS.blue, REP_COLORS.teal, REP_COLORS.green, REP_COLORS.amber, REP_COLORS.navy, '#0891b2', '#6366f1', '#64748b'],
          dataLabels:{ enabled:true, style:{ fontSize:'11px', fontWeight:700, colors:['#fff'] }, formatter:v=>v },
          grid:{ borderColor:'rgba(148,163,184,.18)', strokeDashArray:4 },
          xaxis:{ categories: top.map(r=>r.name), labels:{ style:{ colors:'#94a3b8', fontSize:'10px' } }, axisBorder:{show:false}, axisTicks:{show:false} },
          yaxis:{ labels:{ style:{ colors:'#475569', fontSize:'11.5px', fontWeight:600 } } },
          legend:{ show:false },
          tooltip:{ y:{ formatter:(v,o)=>{ const r=top[o.dataPointIndex]; return v+' voucher • omzet '+fmtRp(r.revenue); } } }
        };
        if(_repChartPerf){ _repChartPerf.updateOptions(opt,true,true); }
        else { _repChartPerf=new ApexCharts(perfEl,opt); _repChartPerf.render(); }
      }
    }
  }

  // ── Top-up management ────────────────────────────────────────
  const TUP_STATUS = {
    pending:{t:'Menunggu',cls:'warn'}, waiting_verification:{t:'Perlu Verifikasi',cls:'warn'},
    paid:{t:'Lunas',cls:'on'}, rejected:{t:'Ditolak',cls:'danger'}, expired:{t:'Kedaluwarsa',cls:'off'}
  };
  const eyeBtn = id => `<button class="ico-btn" title="Lihat detail" onclick="openTopupDetail(${id})"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>`;
  async function loadTopups(){
    const status=document.getElementById('topupStatusFilter').value;
    const tb=document.getElementById('topupRows');
    tb.innerHTML='<tr><td colspan="6" class="empty">Memuat…</td></tr>';
    try{
      const j = await apiCall('/topups'+(status?('?status='+status):''));
      const rows=j.data||[];
      if(!rows.length){ tb.innerHTML='<tr><td colspan="6"><div class="empty"><svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><div class="e-ttl">Tidak ada permintaan</div><div>Tidak ada top-up dengan status ini.</div></div></td></tr>'; return; }
      tb.innerHTML = rows.map(t=>{
        const st=TUP_STATUS[t.status]||TUP_STATUS.pending;
        const ml=t.method==='gateway'?('Otomatis'+(t.gateway_provider?(' · '+t.gateway_provider):'')):(t.method==='qris'?'QRIS':'Transfer Manual');
        const d=new Date(t.created_at).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'});
        let actions='';
        if(t.status==='waiting_verification' && t.method!=='gateway'){
          actions=`<div class="row-actions">
            ${t.has_proof?eyeBtn(t.id):''}
            <button class="ico-btn ok" title="Setujui" onclick="verifyTopup(${t.id})"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></button>
            <button class="ico-btn danger" title="Tolak" onclick="rejectTopup(${t.id})"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
          </div>`;
        } else if(t.has_proof){
          actions=`<div class="row-actions">${eyeBtn(t.id)}</div>`;
        } else { actions='<span style="color:var(--text3)">—</span>'; }
        return `<tr>
          <td class="cell-main-td"><div><div class="r-name">${esc(t.reseller?t.reseller.name:'-')}</div><div class="r-sub">${esc(t.reseller?t.reseller.code:'')}${t.note?(' • '+esc(t.note)):''}</div></div></td>
          <td data-label="Nominal" class="r-bal">${fmtRp(t.amount)}</td>
          <td data-label="Metode">${esc(ml)}</td>
          <td data-label="Status"><span class="badge ${st.cls}">${st.t}</span></td>
          <td data-label="Waktu" style="font-size:12.5px;color:var(--text2)">${d}</td>
          <td class="cell-actions">${actions}</td>
        </tr>`;
      }).join('');
      // badge + overview jumlah perlu verifikasi
      if(status==='waiting_verification'){
        setPendingCount(rows.length);
      }
    }catch(e){ tb.innerHTML='<tr><td colspan="6" class="empty">Gagal memuat.</td></tr>'; }
  }
  function setPendingCount(n){
    const b=document.getElementById('topupBadge');
    document.getElementById('ovPending').textContent = n;
    if(n){ b.textContent=n; b.style.display='inline-block'; } else b.style.display='none';
  }
  async function verifyTopup(id){
    const ok = await rvConfirm({ title:'Setujui Top-up', message:'Setujui top-up ini? Saldo reseller akan langsung bertambah.', okText:'Setujui', tone:'ok' });
    if(!ok) return;
    const j = await apiCall('/topups/'+id+'/verify',{method:'POST',body:{}});
    if(j.success){ toast('Disetujui — saldo dikreditkan'); closeModals(); loadTopups(); loadResellers(); refreshPending(); } else toast(j.message||'Gagal');
  }
  async function rejectTopup(id){
    const reason = await rvConfirm({ title:'Tolak Top-up', message:'Top-up akan ditolak. Beri alasan singkat (opsional).', okText:'Tolak', tone:'warn', input:{ label:'Alasan penolakan', placeholder:'mis. Bukti tidak valid', value:'Bukti tidak valid' } });
    if(reason===null) return;
    const j = await apiCall('/topups/'+id+'/reject',{method:'POST',body:{reason}});
    if(j.success){ toast('Top-up ditolak'); closeModals(); loadTopups(); refreshPending(); } else toast(j.message||'Gagal');
  }

  // ── Detail Top-up (modal kaya: nominal + bukti + info + aksi) ──
  const _TDMETHOD = { gateway:'Pembayaran Otomatis', qris:'QRIS (Manual)', manual:'Transfer Manual' };
  async function openTopupDetail(id){
    const modal=document.getElementById('topupDetailModal');
    modal.classList.add('show');
    document.getElementById('tdRef').textContent='Memuat…';
    document.getElementById('tdFrame').innerHTML='<div class="td-empty"><div class="td-empty-txt" style="color:var(--text3)">Memuat…</div></div>';
    document.getElementById('tdOpen').style.display='none';
    document.getElementById('tdActions').style.display='none';
    try{
      const j = await apiCall('/topups/'+id);
      if(!j.success){ toast(j.message||'Gagal memuat detail'); return; }
      const d=j.data;
      const st=TUP_STATUS[d.status]||TUP_STATUS.pending;
      document.getElementById('tdRef').textContent=d.ref||('#'+d.id);
      document.getElementById('tdRefRow').textContent=d.ref||'—';
      document.getElementById('tdAmount').textContent=fmtRp(d.amount);
      document.getElementById('tdStatusWrap').innerHTML='<span class="td-st">'+esc(st.t)+'</span>';
      document.getElementById('tdReseller').textContent=d.reseller?d.reseller.name:'—';
      document.getElementById('tdCode').textContent=d.reseller?d.reseller.code:'—';
      document.getElementById('tdPhone').textContent=(d.reseller&&d.reseller.phone)?d.reseller.phone:'—';
      const ml = d.method==='gateway' ? (_TDMETHOD.gateway+(d.gateway_provider?(' · '+d.gateway_provider):'')) : (_TDMETHOD[d.method]||d.method);
      document.getElementById('tdMethod').textContent=ml;
      document.getElementById('tdCreated').textContent=new Date(d.created_at).toLocaleString('id-ID',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});
      // optional rows
      const noteRow=document.getElementById('tdNoteRow'); if(d.note){ noteRow.style.display='flex'; document.getElementById('tdNote').textContent=d.note; } else noteRow.style.display='none';
      const rejRow=document.getElementById('tdRejectRow'); if(d.reject_reason){ rejRow.style.display='flex'; document.getElementById('tdReject').textContent=d.reject_reason; } else rejRow.style.display='none';
      const vRow=document.getElementById('tdVerifierRow'); if(d.verifier&&d.verifier.name){ vRow.style.display='flex'; document.getElementById('tdVerifier').textContent=d.verifier.name; } else vRow.style.display='none';
      // proof image
      const frame=document.getElementById('tdFrame'), open=document.getElementById('tdOpen');
      if(d.has_proof && d.proof_url){
        const url=d.proof_url;
        // coba render gambar; kalau PDF tampilkan iframe
        frame.classList.remove('empty-frame');
        frame.innerHTML='<img src="'+url+'" alt="Bukti" onerror="this.parentNode.innerHTML=\'<iframe src=&quot;'+url+'&quot;></iframe>\'">';
        open.href=url; open.style.display='inline-flex';
      } else {
        frame.classList.add('empty-frame');
        frame.innerHTML='<div class="td-empty"><div class="ei"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></div><div class="et">Tanpa bukti</div><div class="es">'+(d.method==='gateway'?'Pembayaran otomatis (gateway) tidak memerlukan bukti manual.':'Reseller belum mengunggah bukti transfer.')+'</div></div>';
        open.style.display='none';
      }
      // action buttons (hanya untuk manual/qris yg masih perlu verifikasi)
      const acts=document.getElementById('tdActions');
      if(d.status==='waiting_verification' && d.method!=='gateway'){
        acts.style.display='flex';
        document.getElementById('tdVerifyBtn').onclick=()=>verifyTopup(d.id);
        document.getElementById('tdRejectBtn').onclick=()=>rejectTopup(d.id);
      } else acts.style.display='none';
    }catch(e){ toast('Terjadi kesalahan'); }
  }
  function refreshPending(){
    apiCall('/topups?status=waiting_verification').then(j=>setPendingCount((j.data||[]).length)).catch(()=>{});
  }

  // ── Topup settings (modal) ───────────────────────────────────
  async function openTopupSettings(){
    try{
      const j = await apiCall('/topup-settings');
      const c = j.data||{};
      document.getElementById('setManual').checked = !!c.manual_enabled;
      document.getElementById('setGateway').checked = !!c.gateway_enabled;
      document.getElementById('setMin').value = c.min_topup || 10000;
      document.getElementById('topupSettingsModal').classList.add('show');
    }catch(e){ toast('Gagal memuat pengaturan'); }
  }
  async function saveTopupSettings(){
    const payload={
      manual_enabled: document.getElementById('setManual').checked,
      gateway_enabled: document.getElementById('setGateway').checked,
      min_topup: parseInt(document.getElementById('setMin').value)||10000
    };
    const r = await apiCall('/topup-settings',{method:'PUT',body:payload});
    if(r.success){ toast('Pengaturan disimpan'); closeModals(); } else toast(r.message||'Gagal');
  }

  document.querySelectorAll('.modal-bg').forEach(bg=>bg.addEventListener('click',e=>{ if(e.target===bg) closeModals(); }));
  document.addEventListener('keydown',e=>{ if(e.key==='Escape') closeModals(); });

  (function init(){
    loadDevices();
    loadResellers();
    const now=new Date(), first=new Date(now.getFullYear(),now.getMonth(),1);
    document.getElementById('gRepFrom').value=first.toISOString().slice(0,10);
    document.getElementById('gRepTo').value=now.toISOString().slice(0,10);
    refreshPending();
    // Muat ringkasan voucher terjual (sepanjang waktu) untuk overview.
    apiCall('/report').then(j=>{
      if(j.success){ document.getElementById('ovVouchers').textContent = j.data.per_reseller.reduce((s,r)=>s+r.vouchers,0); }
    }).catch(()=>{});
  })();
</script>
</body>
</html>
