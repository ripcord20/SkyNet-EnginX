  // ── Order Publik (pembelian voucher dari /beli-voucher) ───────
  let _pubOrderTimer=null;
  function debouncePubOrders(){ clearTimeout(_pubOrderTimer); _pubOrderTimer=setTimeout(loadPublicOrders, 350); }

  const PUB_STATUS = {
    pending:  { label:'Menunggu bayar', cls:'warn' },
    paid:     { label:'Sudah bayar',    cls:'on'   },
    delivered:{ label:'Terkirim',       cls:'on'   },
    failed:   { label:'Gagal',          cls:'danger' },
    expired:  { label:'Kadaluarsa',     cls:'off'  }
  };

  async function loadPublicOrders(){
    const tb=document.getElementById('pubOrderRows');
    const status=document.getElementById('pubOrderStatus').value;
    const q=document.getElementById('pubOrderSearch').value.trim();
    try{
      const qs=[]; if(status) qs.push('status='+encodeURIComponent(status)); if(q) qs.push('q='+encodeURIComponent(q));
      const j = await apiCall('/public-orders'+(qs.length?('?'+qs.join('&')):''));
      const rows=j.data||[];
      // badge = jumlah yang butuh aksi (paid manual blm terkirim + pending dgn bukti)
      const needAction=rows.filter(o=>o.payment_method==='manual' && (o.status==='paid' || o.status==='pending') && o.status!=='delivered').length;
      const badge=document.getElementById('pubOrderBadge');
      if(badge){ if(needAction>0){ badge.textContent=needAction; badge.style.display='inline-block'; } else badge.style.display='none'; }
      if(!rows.length){ tb.innerHTML='<tr><td colspan="6"><div class="empty"><svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg><div class="e-ttl">Belum ada order</div><div>Order dari halaman /beli-voucher akan muncul di sini.</div></div></td></tr>'; return; }
      tb.innerHTML = rows.map(o=>{
        const st=PUB_STATUS[o.status]||{label:o.status,cls:'off'};
        const isManual=o.payment_method==='manual';
        const canVerify=isManual && (o.status==='pending' || o.status==='paid');
        const contact = o.buyer_wa ? ('<a href="https://wa.me/'+esc(o.buyer_wa)+'" target="_blank" style="color:var(--rv-teal);text-decoration:none">'+esc(o.buyer_wa)+'</a>') : (o.buyer_email?esc(o.buyer_email):'—');
        let actions='';
        if(o.status==='delivered' && o.voucher_username){
          actions=`<span class="mono" style="font-size:11.5px">${esc(o.voucher_username)} / ${esc(o.voucher_password||'')}</span>`;
        } else if(canVerify){
          actions=`<div class="row-actions">`
            + (o.has_proof?`<button class="ico-btn" title="Lihat bukti" onclick="viewProof(${o.id})"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>`:'')
            + `<button class="btn btn-primary" style="padding:6px 12px;font-size:12.5px" onclick="verifyPubOrder(${o.id})">Verifikasi</button>`
            + `<button class="ico-btn danger" title="Tolak" onclick="rejectPubOrder(${o.id})"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>`
            + `</div>`;
        } else { actions='<span style="color:var(--text3)">—</span>'; }
        const payBadge = isManual ? '<span class="badge off" style="margin-top:3px">Manual</span>' : '<span class="badge on" style="margin-top:3px">'+esc(o.gateway_provider||'Gateway')+'</span>';
        return `
        <tr>
          <td class="cell-main-td"><div><div class="r-name mono">${esc(o.order_code)}</div><div class="r-sub">${fmtDate(o.created_at)}</div></div></td>
          <td data-label="Paket">${esc(o.package_name||'—')}</td>
          <td data-label="Pembeli"><div>${esc(o.buyer_name||'—')}</div><div class="r-sub">${contact}</div></td>
          <td data-label="Bayar" class="r-bal">${fmtRp(o.amount)}<br>${payBadge}</td>
          <td data-label="Status"><span class="badge ${st.cls}">${st.label}</span></td>
          <td class="cell-actions">${actions}</td>
        </tr>`;
      }).join('');
    }catch(e){ tb.innerHTML='<tr><td colspan="6" class="empty">Gagal memuat.</td></tr>'; }
  }

  async function viewProof(id){
    try{
      toast('Memuat bukti…');
      const r = await fetch(API+'/public-orders/'+id+'/proof', { headers: authHeaders() });
      if(!r.ok){ toast('Bukti tidak ditemukan'); return; }
      const blob = await r.blob();
      const url = URL.createObjectURL(blob);
      window.open(url, '_blank');
      setTimeout(()=>URL.revokeObjectURL(url), 60000);
    }catch(e){ toast('Gagal memuat bukti'); }
  }

  async function verifyPubOrder(id){
    const ok = await rvConfirm({ title:'Verifikasi Pembayaran', message:'Konfirmasi pembayaran diterima? Voucher akan dibuat di MikroTik dan dikirim ke pembeli.', okText:'Ya, Verifikasi & Kirim', tone:'ok' });
    if(!ok) return;
    toast('Memproses…');
    const j = await apiCall('/public-orders/'+id+'/verify',{method:'POST'});
    if(j.success){
      const v=j.data||{};
      toast('Voucher dibuat & dikirim'+(v.voucher_username?(': '+v.voucher_username):''));
      loadPublicOrders();
    } else toast(j.message||'Gagal memverifikasi');
  }

  async function rejectPubOrder(id){
    const reason = await rvConfirm({ title:'Tolak Order', message:'Tolak order ini?', okText:'Tolak', tone:'warn', input:{ label:'Alasan (opsional)', placeholder:'mis. bukti transfer tidak valid' } });
    if(reason===null) return;
    const j = await apiCall('/public-orders/'+id+'/reject',{method:'POST',body:{ reason: reason||'' }});
    if(j.success){ toast('Order ditolak'); loadPublicOrders(); } else toast(j.message||'Gagal');
  }

