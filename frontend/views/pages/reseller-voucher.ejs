<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/app.js"></script>
  <style>
    /* ── Reseller Voucher admin — scoped to .rv-scope to avoid clashing app.css ── */
    /* Bridge: app.css mendefinisikan --bg/--bg-card/--text/--primary/dst.
       Di sini kita petakan ke nama token yang dipakai komponen halaman ini,
       sekaligus sediakan fallback supaya aman di tema terang/gelap. */
    .rv-scope{
      --rv-teal:#0fb6a3; --rv-teal-deep:#0a8f80;
      --surface:var(--bg-card,#fff);
      --surface2:var(--bg,#f8fafc);
      --text2:var(--text-secondary,#64748b);
      --text3:var(--text-muted,#94a3b8);
      --border2:var(--border,#e2e8f0);
      --blue:var(--primary,#3b82f6);
      --green:var(--success,#22c55e);
      --green-l:rgba(34,197,94,.13);
      --red:var(--danger,#ef4444);
      --red-l:rgba(239,68,68,.12);
      --teal:var(--rv-teal);
      --f:'DM Sans',sans-serif; --fm:'DM Sans',sans-serif;
      --rv-radius:16px; --rv-radius-sm:11px;
    }
    .rv-scope, .rv-scope *{font-family:'DM Sans',sans-serif;}
    .rv-page{padding:0 0 24px;width:100%;}

    /* Header */
    .rv-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap;}
    .rv-head .ttl h1{font-size:23px;font-weight:700;letter-spacing:-.5px;color:var(--text);line-height:1.1;}
    .rv-head .ttl p{font-size:13px;color:var(--text2);margin-top:4px;}
    .rv-head .actions{display:flex;gap:9px;flex-wrap:wrap;}

    /* Overview stat cards — clickable, gaya halaman /collect */
    .rv-overview{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px;}
    .ov-card{position:relative;background:var(--surface);border:1px solid var(--border);border-radius:18px;
      padding:17px 19px;overflow:hidden;transition:box-shadow .18s,transform .18s,border-color .18s;cursor:pointer;
      -webkit-tap-highlight-color:transparent;}
    .ov-card:hover{box-shadow:0 12px 30px rgba(20,40,90,.1);transform:translateY(-3px);}
    .ov-card:active{transform:translateY(-1px);}
    .ov-card .l{font-size:11.5px;font-weight:600;color:var(--text2);margin-bottom:12px;display:flex;align-items:center;gap:9px;}
    .ov-card .l .ic{width:34px;height:34px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .ov-card .l .ic svg{width:17px;height:17px;}
    .ov-card .v{font-size:26px;font-weight:800;letter-spacing:-.7px;line-height:1;color:#0d1b3e;font-family:var(--fm);}
    .ov-card .sub{font-size:11.5px;color:var(--text3);margin-top:7px;}
    .ov-card .arrow{position:absolute;top:16px;right:16px;color:#cbd5e1;opacity:0;transform:translateX(-4px);transition:opacity .18s,transform .18s;}
    .ov-card:hover .arrow{opacity:1;transform:translateX(0);}
    /* Varian warna — biru sebagai aksen utama (sesuai halaman lain) */
    .ov-card.blue{background:linear-gradient(160deg,#f5f9ff,var(--surface));border-color:#e3edfe;}
    .ov-card.blue:hover{border-color:#bfd7fe;} .ov-card.blue .v{color:var(--blue);} .ov-card.blue .ic{background:var(--blue);color:#fff;}
    .ov-card.teal{background:linear-gradient(160deg,#f1fdfb,var(--surface));border-color:#d7f3ee;}
    .ov-card.teal:hover{border-color:#a9e6dc;} .ov-card.teal .v{color:var(--rv-teal-deep);} .ov-card.teal .ic{background:var(--rv-teal-deep);color:#fff;}
    .ov-card.amber{background:linear-gradient(160deg,#fffaf2,var(--surface));border-color:#f6e7cf;}
    .ov-card.amber:hover{border-color:#eccfa0;} .ov-card.amber .v{color:#b45309;} .ov-card.amber .ic{background:#d98324;color:#fff;}
    .ov-card.green{background:linear-gradient(160deg,#f1fbf5,var(--surface));border-color:#cfeedd;}
    .ov-card.green:hover{border-color:#a7e0c2;} .ov-card.green .v{color:#0a9a5a;} .ov-card.green .ic{background:#0a9a5a;color:#fff;}
    /* highlight (kartu utama, biru solid) */
    .ov-card.hl{background:linear-gradient(135deg,var(--blue),#1e3a8a);border:none;}
    .ov-card.hl .l{color:rgba(255,255,255,.85);} .ov-card.hl .v{color:#fff;} .ov-card.hl .sub{color:rgba(255,255,255,.7);}
    .ov-card.hl .ic{background:rgba(255,255,255,.2);color:#fff;}
    .ov-card.hl:hover{box-shadow:0 14px 34px rgba(30,58,138,.32);}
    .ov-card.hl .arrow{color:rgba(255,255,255,.8);}
    [data-theme="dark"] .ov-card .v{color:var(--text);}
    /* Kartu statistik non-klik (mis. di tab Laporan) */
    .ov-card.static{cursor:default;}
    .ov-card.static:hover{transform:none;box-shadow:none;}
    .ov-card.static:hover .arrow{opacity:0;}

    /* Tabs — segmented, scrollable on mobile */
    .rv-tabs{display:flex;gap:4px;background:var(--surface2,var(--surface));border:1px solid var(--border);
      padding:4px;border-radius:13px;margin-bottom:18px;width:fit-content;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;}
    .rv-tab{padding:9px 18px;border:none;background:transparent;color:var(--text2);font-size:13px;font-weight:600;
      border-radius:9px;cursor:pointer;font-family:var(--f);transition:all .15s;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;}
    .rv-tab:hover{color:var(--text);}
    .rv-tab.active{background:#2563eb;color:#fff;box-shadow:0 2px 8px rgba(37,99,235,.32);}
    .rv-pane{display:none;animation:rvFade .25s ease;} .rv-pane.active{display:block;}
    @keyframes rvFade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}

    /* Toolbar */
    .rv-toolbar{display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap;}
    .rv-search{flex:1;min-width:200px;position:relative;}
    .rv-search input{width:100%;padding:11px 13px 11px 38px;border:1px solid var(--border);
      border-radius:var(--rv-radius-sm);font-size:13.5px;font-family:var(--f);outline:none;background:var(--surface);color:var(--text);transition:border-color .15s;}
    .rv-search input:focus{border-color:var(--blue);}
    .rv-search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text3);}
    .rv-select{padding:11px 13px;border:1px solid var(--border);border-radius:var(--rv-radius-sm);
      font-size:13.5px;font-family:var(--f);background:var(--surface);color:var(--text);outline:none;cursor:pointer;}
    .rv-select:focus{border-color:var(--blue);}

    .btn{padding:11px 17px;border:none;border-radius:var(--rv-radius-sm);font-size:13.5px;font-weight:600;cursor:pointer;
      font-family:var(--f);display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:filter .15s,transform .08s;white-space:nowrap;}
    .btn:active{transform:scale(.98);}
    .btn-primary{background:var(--blue);color:#fff;box-shadow:0 6px 16px color-mix(in srgb,var(--blue) 28%,transparent);}
    .btn-primary:hover{filter:brightness(1.06);}
    .btn-soft{background:var(--surface);border:1px solid var(--border);color:var(--text);}
    .btn-soft:hover{border-color:var(--text3);}
    .btn-teal{background:linear-gradient(135deg,var(--rv-teal),var(--rv-teal-deep));color:#fff;box-shadow:0 6px 16px color-mix(in srgb,var(--rv-teal) 30%,transparent);}
    .btn-block{width:100%;}

    /* Data list — renders as table on desktop, cards on mobile */
    .rv-list{background:var(--surface);border:1px solid var(--border);border-radius:var(--rv-radius);overflow:hidden;}
    table.rv-tbl{width:100%;border-collapse:collapse;}
    .rv-tbl th{text-align:left;font-size:11px;font-weight:600;color:var(--text2);text-transform:uppercase;
      letter-spacing:.04em;padding:13px 18px;border-bottom:1px solid var(--border);background:var(--surface2,transparent);}
    .rv-tbl td{padding:14px 18px;font-size:13.5px;border-bottom:1px solid var(--border2,var(--border));color:var(--text);vertical-align:middle;}
    .rv-tbl tr:last-child td{border-bottom:none;}
    .rv-tbl tbody tr{transition:background .12s;}
    .rv-tbl tbody tr:hover{background:color-mix(in srgb,var(--blue) 4%,transparent);}

    .cell-main{display:flex;align-items:center;gap:11px;}
    .avatar{width:38px;height:38px;border-radius:11px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
      font-weight:700;font-size:14px;background:color-mix(in srgb,var(--rv-teal) 15%,transparent);color:var(--rv-teal-deep);font-family:var(--f);}
    .r-name{font-weight:600;letter-spacing:-.1px;}
    .r-sub{font-size:12px;color:var(--text2);margin-top:1px;}
    .r-code{font-family:var(--fm);font-size:12px;color:var(--text2);}
    .r-bal{font-family:var(--fm);font-weight:700;font-size:14px;}
    .mono{font-family:var(--fm);}

    .badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:100px;font-size:11.5px;font-weight:600;}
    .badge::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor;}
    .badge.on{background:var(--green-l,#e7f7ef);color:var(--green,#0a9a5a);}
    .badge.off{background:var(--surface2,#f1f3f7);color:var(--text2);}
    .badge.warn{background:#fef3e0;color:#c47d12;}
    .badge.danger{background:var(--red-l,#fdeaea);color:var(--red,#e5484d);}

    .row-actions{display:flex;gap:6px;flex-wrap:nowrap;justify-content:flex-end;align-items:center;}
    .ico-btn{width:34px;height:34px;border-radius:9px;border:1px solid var(--border);background:var(--surface);
      display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text2);transition:all .12s;}
    .ico-btn:hover{color:var(--blue);border-color:var(--blue);background:color-mix(in srgb,var(--blue) 6%,transparent);}
    .ico-btn.ok:hover{color:var(--green,#0a9a5a);border-color:var(--green,#0a9a5a);background:var(--green-l,#e7f7ef);}
    .ico-btn.danger:hover{color:var(--red,#e5484d);border-color:var(--red,#e5484d);background:var(--red-l,#fdeaea);}

    .empty{padding:54px 16px;text-align:center;color:var(--text3);font-size:13.5px;}
    .empty svg{color:var(--border);margin-bottom:12px;}
    .empty .e-ttl{font-weight:600;color:var(--text2);margin-bottom:3px;}
    .skel{background:linear-gradient(90deg,var(--border2,#eef1f7) 25%,var(--surface2,#f6f8fb) 50%,var(--border2,#eef1f7) 75%);
      background-size:200% 100%;animation:rvShine 1.3s infinite;border-radius:8px;}
    @keyframes rvShine{to{background-position:-200% 0;}}

    /* Modal */
    .modal-bg{position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:200;display:none;
      align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(3px);}
    .modal-bg.show{display:flex;animation:rvFade .2s ease;}
    .modal{background:var(--surface);border-radius:20px;width:100%;max-width:540px;max-height:92vh;
      display:flex;flex-direction:column;box-shadow:0 30px 70px rgba(0,0,0,.3);overflow:hidden;
      animation:rvModalIn .28s cubic-bezier(.2,.8,.25,1);}
    @keyframes rvModalIn{from{opacity:0;transform:translateY(16px) scale(.98);}to{opacity:1;transform:none;}}
    .modal-hd{padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-shrink:0;border-bottom:1px solid var(--border);}
    .modal-hd .hd-ttl{display:flex;align-items:center;gap:11px;}
    .modal-hd .hd-ic{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
      background:color-mix(in srgb,var(--rv-teal) 14%,transparent);color:var(--rv-teal-deep);}
    .modal-hd h3{font-size:16.5px;font-weight:700;letter-spacing:-.2px;}
    .modal-hd .hd-sub{font-size:12px;color:var(--text2);margin-top:1px;}
    .modal-x{width:34px;height:34px;border-radius:9px;border:1px solid var(--border);background:var(--surface);cursor:pointer;
      display:flex;align-items:center;justify-content:center;color:var(--text2);flex-shrink:0;transition:all .12s;}
    .modal-x:hover{color:var(--text);border-color:var(--text3);}
    .modal-bd{padding:22px 24px;overflow-y:auto;}
    .modal-ft{padding:16px 24px;border-top:1px solid var(--border);display:flex;gap:10px;justify-content:flex-end;flex-shrink:0;background:var(--surface);}

    .fg{margin-bottom:16px;}
    .fg:last-child{margin-bottom:0;}
    .fg label{display:block;font-size:12.5px;font-weight:600;color:var(--text);margin-bottom:7px;}
    .fg label .req{color:var(--red,#e5484d);}
    .fg input,.fg select,.fg textarea{width:100%;padding:11px 13px;border:1px solid var(--border);
      border-radius:var(--rv-radius-sm);font-size:14px;font-family:var(--f);outline:none;background:var(--surface);color:var(--text);transition:border-color .12s,box-shadow .12s;}
    .fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px color-mix(in srgb,var(--blue) 14%,transparent);}
    .fg input:disabled{background:var(--surface2,#f4f6fa);color:var(--text2);cursor:not-allowed;}
    .fg .hint{font-size:11.5px;color:var(--text3);margin-top:6px;line-height:1.4;}
    .fg-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    .fg-money{position:relative;}
    .fg-money input{padding-left:38px;font-family:var(--fm);font-weight:600;}
    .fg-money::before{content:'Rp';position:absolute;left:13px;top:38px;font-size:13px;color:var(--text3);font-weight:600;pointer-events:none;}

    /* Toggle switch */
    .switch-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 15px;
      border:1px solid var(--border);border-radius:var(--rv-radius-sm);background:var(--surface2,transparent);}
    .switch-row .sl{font-size:13.5px;font-weight:600;}
    .switch-row .sd{font-size:11.5px;color:var(--text2);margin-top:2px;}
    .switch{position:relative;width:44px;height:25px;flex-shrink:0;}
    .switch input{opacity:0;width:0;height:0;position:absolute;}
    .switch .track{position:absolute;inset:0;background:var(--border);border-radius:100px;transition:background .2s;cursor:pointer;}
    .switch .track::before{content:'';position:absolute;width:19px;height:19px;left:3px;top:3px;background:#fff;border-radius:50%;transition:transform .2s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
    .switch input:checked + .track{background:var(--rv-teal);}
    .switch input:checked + .track::before{transform:translateX(19px);}
    /* Compact toggle for in-table use */
    .switch.sm{width:38px;height:21px;}
    .switch.sm .track::before{width:15px;height:15px;left:3px;top:3px;}
    .switch.sm input:checked + .track::before{transform:translateX(17px);}
    .pub-cell{display:flex;align-items:center;gap:9px;}
    .pub-price{font-size:11px;color:var(--rv-teal);font-weight:700;white-space:nowrap;}
    .pub-price.off{color:var(--text3,#9aa3b2);font-weight:500;}

    /* Transactions / proof list in modal */
    .tx-mini{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 0;border-bottom:1px solid var(--border2,var(--border));}
    .tx-mini:last-child{border-bottom:none;}
    .tx-mini .ti{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .tx-mini .ti.topup{background:var(--green-l,#e7f7ef);color:var(--green,#0a9a5a);}
    .tx-mini .ti.purchase{background:color-mix(in srgb,var(--blue) 12%,transparent);color:var(--blue);}
    .tx-mini .ti.refund{background:#fef3e0;color:#c47d12;}
    .tx-mini .ti.adjust{background:var(--surface2,#f1f3f7);color:var(--text2);}
    .tx-mini .d{font-size:13px;font-weight:600;}
    .tx-mini .s{font-size:11.5px;color:var(--text2);margin-top:2px;}
    .tx-mini .a{font-family:var(--fm);font-weight:700;font-size:13.5px;}
    .tx-mini .a.plus{color:var(--green,#0a9a5a);} .tx-mini .a.minus{color:var(--text);}

    .toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(20px);background:#15151a;
      color:#fff;padding:13px 20px;border-radius:13px;font-size:13.5px;font-weight:500;z-index:300;opacity:0;
      transition:all .25s;pointer-events:none;box-shadow:0 12px 32px rgba(0,0,0,.28);max-width:88%;text-align:center;}
    .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

    /* ── Mobile ── */
    @media (max-width:1100px){
      .rv-overview{grid-template-columns:repeat(2,1fr);}
      #repStats{grid-template-columns:repeat(3,1fr);}
    }
    @media (max-width:880px){
      .rv-overview{grid-template-columns:repeat(2,1fr);}
      #repStats{grid-template-columns:1fr !important;}
    }
    @media (max-width:560px){
      .rv-overview{grid-template-columns:1fr;}
    }
    @media (max-width:640px){
      .rv-page{padding:0 0 24px;}
      .rv-head{flex-direction:column;align-items:stretch;gap:14px;}
      .rv-head .actions{width:100%;}
      .rv-head .actions .btn{flex:1;}
      .ov-card{padding:15px 16px;}
      .ov-card .v{font-size:22px;}
      .rv-tabs{width:100%;}
      .rv-tab{flex:1;justify-content:center;padding:9px 10px;}
      .rv-toolbar{flex-direction:column;align-items:stretch;}
      .rv-toolbar .btn,.rv-toolbar .rv-select{width:100%;}
      .rv-search{min-width:0;max-width:none !important;}

      /* Table → cards */
      .rv-tbl thead{display:none;}
      .rv-tbl,.rv-tbl tbody,.rv-tbl tr,.rv-tbl td{display:block;width:100%;}
      .rv-tbl tr{border:1px solid var(--border);border-radius:var(--rv-radius);margin-bottom:11px;padding:6px 4px;background:var(--surface);}
      .rv-tbl tbody tr:hover{background:var(--surface);}
      .rv-tbl td{border:none !important;padding:8px 15px;display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:right;}
      .rv-tbl td::before{content:attr(data-label);font-size:11.5px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.03em;text-align:left;flex-shrink:0;}
      .rv-tbl td.cell-main-td{justify-content:flex-start;text-align:left;padding-top:13px;}
      .rv-tbl td.cell-main-td::before{display:none;}
      .rv-tbl td.cell-actions{justify-content:flex-end;padding-bottom:13px;}
      .rv-tbl td.cell-actions::before{display:none;}
      .row-actions{justify-content:flex-end;}
      .rv-list{background:transparent;border:none;border-radius:0;overflow:visible;}

      .modal-bg{padding:0;align-items:flex-end;}
      .modal{max-width:none;max-height:94vh;border-radius:22px 22px 0 0;animation:rvSheetIn .3s cubic-bezier(.2,.8,.25,1);}
      @keyframes rvSheetIn{from{transform:translateY(100%);}to{transform:none;}}
      .fg-row{grid-template-columns:1fr;gap:0;}
      .fg-row .fg{margin-bottom:16px;}
      .fg-money::before{top:39px;}
      .modal-ft{flex-direction:column-reverse;}
      .modal-ft .btn{width:100%;}
    }

    /* ── Report charts (admin) ── */
    .rep-charts{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:18px;}
    @media(max-width:980px){ .rep-charts{grid-template-columns:1fr;} }
    .rep-chart-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--rv-radius);padding:17px 16px 8px;}
    .rep-chart-card .rcc-hd{display:flex;align-items:center;justify-content:space-between;padding:0 4px 6px;}
    .rep-chart-card .rcc-t{font-size:14px;font-weight:800;letter-spacing:-.2px;color:var(--text);}
    .rep-chart-card .rcc-s{font-size:11.5px;color:var(--text3);margin-top:1px;}
    .sec-title-rep{font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--text2);margin:4px 2px 11px;}
    .rank-badge{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:9px;
      font-family:var(--fm);font-weight:800;font-size:12px;background:var(--surface2,#eef2f9);color:var(--text2);}
    .rank-badge.r1{background:#fef3c7;color:#b45309;} .rank-badge.r2{background:#e5e9f0;color:#475569;} .rank-badge.r3{background:#fde9d9;color:#b45309;}

    /* ── Reseller hotspot vouchers (admin modal) ── */
    .rvv-meta{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:14px;}
    @media(max-width:560px){ .rvv-meta{grid-template-columns:repeat(3,1fr);} }
    .rvv-mc{background:var(--surface2,#f6f9ff);border:1px solid var(--border);border-radius:12px;padding:10px 8px;text-align:center;}
    .rvv-mc .n{font-size:18px;font-weight:800;font-family:var(--fm);letter-spacing:-.4px;}
    .rvv-mc .t{font-size:10px;color:var(--text3);font-weight:600;margin-top:2px;}
    .rvv-mc.c-active .n{color:#0a9a5a;} .rvv-mc.c-used .n{color:#b9810b;}
    .rvv-mc.c-expired .n{color:#dc2626;} .rvv-mc.c-unused .n{color:#64748b;}
    .rvv-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;}
    .rvv-chips{display:flex;gap:6px;flex-wrap:wrap;}
    .rvv-chip{border:1.5px solid var(--border);background:var(--surface);color:var(--text2);font-size:12px;font-weight:700;
      padding:6px 11px;border-radius:100px;cursor:pointer;font-family:var(--f);transition:all .15s;display:inline-flex;gap:5px;align-items:center;}
    .rvv-chip.on{background:#0d1b3e;color:#fff;border-color:#0d1b3e;}
    .rvv-chip span{font-family:var(--fm);font-size:10.5px;opacity:.8;}
    .rvv-row{display:flex;align-items:center;gap:11px;background:var(--surface);border:1px solid var(--border);border-radius:13px;padding:11px 13px;margin-bottom:8px;}
    .rvv-row .d{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
    .rvv-row.s-active .d{background:#0a9a5a;box-shadow:0 0 0 3px rgba(10,154,90,.18);}
    .rvv-row.s-used .d{background:#b9810b;} .rvv-row.s-expired .d{background:#dc2626;} .rvv-row.s-unused .d{background:#c2cad8;}
    .rvv-row .mid{flex:1;min-width:0;}
    .rvv-row .u{font-size:13.5px;font-weight:800;font-family:var(--fm);letter-spacing:.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .rvv-row .s{font-size:11px;color:var(--text3);margin-top:2px;}
    .rvv-bdg{font-size:9.5px;font-weight:800;padding:3px 8px;border-radius:7px;flex-shrink:0;letter-spacing:.03em;}
    .rvv-bdg.active{background:#e7f7ef;color:#0a9a5a;} .rvv-bdg.used{background:#fef6e0;color:#b9810b;}
    .rvv-bdg.expired{background:#fdeaea;color:#dc2626;} .rvv-bdg.unused{background:#f3f5fa;color:#64748b;}
    .rvv-row .acts{display:flex;gap:5px;flex-shrink:0;}
    .rvv-ib{width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--surface);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text3);transition:all .12s;}
    .rvv-ib:active{transform:scale(.9);}
    .rvv-ib.cut:hover{color:#b9810b;border-color:#b9810b;} .rvv-ib.del:hover{color:#dc2626;border-color:#dc2626;}

    /* ── Styled confirm dialog (ganti confirm/prompt bawaan browser) ── */
    .cf-overlay{position:fixed;inset:0;z-index:240;background:rgba(15,23,42,.55);backdrop-filter:blur(3px);
      display:none;align-items:center;justify-content:center;padding:20px;}
    .cf-overlay.show{display:flex;animation:rvFade .16s ease;}
    .cf-box{background:var(--surface);border-radius:20px;width:min(420px,94vw);padding:26px 24px 22px;
      text-align:center;box-shadow:0 26px 70px rgba(13,27,62,.4);animation:rvModalIn .22s cubic-bezier(.2,.8,.25,1);}
    .cf-icn{width:56px;height:56px;border-radius:17px;margin:0 auto 15px;display:flex;align-items:center;justify-content:center;}
    .cf-icn.ok{background:var(--green-l,#e7f7ef);color:var(--green,#0a9a5a);}
    .cf-icn.warn{background:#fef2f2;color:var(--red,#dc2626);}
    .cf-icn.info{background:color-mix(in srgb,var(--blue) 12%,transparent);color:var(--blue);}
    .cf-ttl{font-size:18px;font-weight:800;letter-spacing:-.3px;color:var(--text);margin-bottom:7px;}
    .cf-msg{font-size:13.5px;color:var(--text2);line-height:1.55;}
    .cf-field{text-align:left;margin-top:15px;}
    .cf-field label{display:block;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--text3);margin-bottom:6px;}
    .cf-field textarea{width:100%;box-sizing:border-box;padding:11px 13px;border:1.5px solid var(--border);border-radius:11px;
      font-size:13.5px;font-family:inherit;resize:vertical;outline:none;background:var(--surface);color:var(--text);}
    .cf-field textarea:focus{border-color:var(--blue);}
    .cf-btns{display:flex;gap:10px;margin-top:22px;}
    .cf-btn{flex:1;padding:12px;border-radius:12px;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;border:none;transition:filter .15s;}
    .cf-cancel{background:var(--surface2,#f1f5f9);color:var(--text2);} .cf-cancel:hover{filter:brightness(.97);}
    .cf-ok.is-ok{background:var(--green,#0a9a5a);color:#fff;} .cf-ok.is-warn{background:var(--red,#dc2626);color:#fff;} .cf-ok.is-info{background:var(--blue);color:#fff;}
    .cf-ok:hover{filter:brightness(.95);}

    /* ── Topup detail modal (mewah: kartu nominal + foto bukti + info) ── */
    .td-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:0;}
    @media(max-width:720px){ .td-grid{grid-template-columns:1fr;} }
    .td-imgcol{padding:20px;border-right:1px solid var(--border);display:flex;flex-direction:column;}
    @media(max-width:720px){ .td-imgcol{border-right:none;border-bottom:1px solid var(--border);} }
    .td-lbl{font-size:10.5px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--text3);margin-bottom:10px;}
    .td-frame{flex:1;min-height:230px;max-height:52vh;border-radius:14px;border:1px solid var(--border);background:var(--surface2,#f4f8ff);
      overflow:auto;display:flex;align-items:center;justify-content:center;}
    .td-frame img{display:block;max-width:100%;height:auto;}
    .td-frame iframe{width:100%;height:52vh;border:none;}
    .td-frame.empty-frame{border-style:dashed;}
    .td-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:32px 20px;gap:5px;}
    .td-empty .ei{width:60px;height:60px;border-radius:17px;background:var(--surface2,#eef2f9);color:var(--text3);display:flex;align-items:center;justify-content:center;margin-bottom:8px;}
    .td-empty .et{font-size:14px;font-weight:800;color:var(--text2);} .td-empty .es{font-size:12px;color:var(--text3);max-width:220px;line-height:1.5;}
    .td-open{margin-top:12px;display:inline-flex;align-items:center;justify-content:center;gap:6px;font-size:12px;font-weight:700;color:var(--blue);
      text-decoration:none;padding:10px;border-radius:11px;background:color-mix(in srgb,var(--blue) 8%,transparent);border:1px solid color-mix(in srgb,var(--blue) 25%,transparent);transition:filter .15s;}
    .td-open:hover{filter:brightness(.97);}
    .td-infocol{padding:20px;display:flex;flex-direction:column;}
    .td-amt{background:linear-gradient(135deg,var(--blue),#1e3a8a);border-radius:15px;padding:16px 18px;margin-bottom:16px;}
    .td-amt .k{font-size:11px;font-weight:600;color:rgba(255,255,255,.72);letter-spacing:.03em;}
    .td-amt .v{font-size:27px;font-weight:800;letter-spacing:-1px;line-height:1.1;margin-top:3px;color:#fff;font-family:var(--fm);}
    .td-st{display:inline-flex;align-items:center;gap:5px;margin-top:9px;padding:4px 11px;border-radius:8px;font-size:11.5px;font-weight:700;background:rgba(255,255,255,.2);color:#fff;}
    .td-rows{display:flex;flex-direction:column;}
    .td-row{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px dashed var(--border);}
    .td-row:last-child{border-bottom:none;}
    .td-row .rk{font-size:12px;color:var(--text3);font-weight:600;flex-shrink:0;}
    .td-row .rv{font-size:12.5px;color:var(--text);font-weight:700;text-align:right;word-break:break-word;}
    .td-acts{display:flex;gap:10px;margin-top:18px;}
    .td-acts .btn{flex:1;justify-content:center;}
  </style>
  <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.min.js"></script>
</head>
<body>
<div class="app-layout rv-scope">
<%- include('../partials/sidebar') %>

<div class="main-content">
  <%- include('../partials/topbar') %>

  <main class="page-content">
  <div class="rv-page">
    <div class="rv-head">
      <div class="ttl">
        <h1>Reseller Voucher</h1>
        <p>Kelola akun reseller, isi saldo deposit, dan atur paket voucher hotspot</p>
      </div>
      <div class="actions">
        <button class="btn btn-soft" onclick="openPromoManager()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
          Promo
        </button>
        <button class="btn btn-soft" onclick="openTopupSettings()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
          Pengaturan
        </button>
        <a class="btn btn-soft" href="/reseller/login" target="_blank">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/></svg>
          Dashboard Reseller
        </a>
      </div>
    </div>

    <!-- Overview stats — clickable -->
    <div class="rv-overview" id="overview">
      <div class="ov-card hl" onclick="rvTab('resellers')" role="button" tabindex="0">
        <span class="arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 18l6-6-6-6"/></svg></span>
        <div class="l"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>Total Reseller</div>
        <div class="v" id="ovResellers">—</div>
        <div class="sub">akun penjual voucher</div>
      </div>
      <div class="ov-card blue" onclick="rvTab('topups')" role="button" tabindex="0">
        <span class="arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 18l6-6-6-6"/></svg></span>
        <div class="l"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>Saldo Beredar</div>
        <div class="v" id="ovBalance">—</div>
        <div class="sub">total deposit reseller</div>
      </div>
      <div class="ov-card amber" onclick="rvTab('topups', 'waiting_verification')" role="button" tabindex="0">
        <span class="arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 18l6-6-6-6"/></svg></span>
        <div class="l"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg></span>Perlu Verifikasi</div>
        <div class="v" id="ovPending">—</div>
        <div class="sub">top-up menunggu konfirmasi</div>
      </div>
      <div class="ov-card teal" onclick="rvTab('report')" role="button" tabindex="0">
        <span class="arrow"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 18l6-6-6-6"/></svg></span>
        <div class="l"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h20v10H2z"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg></span>Voucher Terjual</div>
        <div class="v" id="ovVouchers">—</div>
        <div class="sub">lihat laporan penjualan</div>
      </div>
    </div>

    <div class="rv-tabs">
      <button class="rv-tab active" data-tab="resellers" onclick="rvTab('resellers')">Reseller</button>
      <button class="rv-tab" data-tab="topups" onclick="rvTab('topups')">Top-up <span id="topupBadge" style="display:none;background:#ef4444;color:#fff;border-radius:100px;padding:1px 7px;font-size:10px;line-height:1.5">0</span></button>
      <button class="rv-tab" data-tab="packages" onclick="rvTab('packages')">Paket Voucher</button>
      <button class="rv-tab" data-tab="puborders" onclick="rvTab('puborders')">Order Publik <span id="pubOrderBadge" style="display:none;background:#ef4444;color:#fff;border-radius:100px;padding:1px 7px;font-size:10px;line-height:1.5">0</span></button>
      <button class="rv-tab" data-tab="report" onclick="rvTab('report')">Laporan</button>
    </div>

    <!-- PANE: Resellers -->
    <div class="rv-pane active" id="pane-resellers">
      <div class="rv-toolbar">
        <div class="rv-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" id="rSearch" placeholder="Cari nama, kode, atau telepon…" oninput="debouncedLoadResellers()">
        </div>
        <button class="btn btn-primary" onclick="openResellerModal()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
          Reseller Baru
        </button>
      </div>
      <div class="rv-list">
        <table class="rv-tbl">
          <thead><tr><th>Reseller</th><th>Saldo</th><th>Router</th><th>Status</th><th style="width:1%;text-align:right">Aksi</th></tr></thead>
          <tbody id="resellerRows"><tr><td colspan="5" class="empty">Memuat…</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- PANE: Top-ups -->
    <div class="rv-pane" id="pane-topups">
      <div class="rv-toolbar">
        <select id="topupStatusFilter" class="rv-select" onchange="loadTopups()">
          <option value="waiting_verification">Perlu Verifikasi</option>
          <option value="">Semua status</option>
          <option value="pending">Menunggu pembayaran</option>
          <option value="paid">Lunas</option>
          <option value="rejected">Ditolak</option>
          <option value="expired">Kedaluwarsa</option>
        </select>
        <div style="flex:1"></div>
        <button class="btn btn-soft" onclick="loadTopups()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
          Muat ulang
        </button>
      </div>
      <div class="rv-list">
        <table class="rv-tbl">
          <thead><tr><th>Reseller</th><th>Nominal</th><th>Metode</th><th>Status</th><th>Waktu</th><th style="width:1%;text-align:right">Aksi</th></tr></thead>
          <tbody id="topupRows"><tr><td colspan="6" class="empty">Memuat…</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- PANE: Packages -->
    <div class="rv-pane" id="pane-packages">
      <div class="rv-toolbar">
        <div style="flex:1"></div>
        <button class="btn btn-primary" onclick="openPackageModal()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
          Paket Baru
        </button>
      </div>
      <div class="rv-list">
        <table class="rv-tbl">
          <thead><tr><th>Paket</th><th>Profile MikroTik</th><th>Modal</th><th>Harga Jual</th><th>Status</th><th>Publik</th><th style="width:1%;text-align:right">Aksi</th></tr></thead>
          <tbody id="packageRows"><tr><td colspan="7" class="empty">Memuat…</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- PANE: Order Publik (pembelian voucher dari /beli-voucher) -->
    <div class="rv-pane" id="pane-puborders">
      <div class="rv-toolbar">
        <div class="rv-search" style="flex:1;min-width:0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="text" id="pubOrderSearch" placeholder="Cari kode / nama / WA…" oninput="debouncePubOrders()">
        </div>
        <select id="pubOrderStatus" class="rv-select" onchange="loadPublicOrders()">
          <option value="">Semua status</option>
          <option value="pending">Menunggu bayar</option>
          <option value="paid">Sudah bayar</option>
          <option value="delivered">Terkirim</option>
          <option value="failed">Gagal/ditolak</option>
          <option value="expired">Kadaluarsa</option>
        </select>
        <button class="btn btn-soft" onclick="loadPublicOrders()" title="Muat ulang">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </button>
      </div>
      <div class="rv-list">
        <table class="rv-tbl">
          <thead><tr><th>Order</th><th>Paket</th><th>Pembeli</th><th>Bayar</th><th>Status</th><th style="width:1%;text-align:right">Aksi</th></tr></thead>
          <tbody id="pubOrderRows"><tr><td colspan="6" class="empty">Memuat…</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- PANE: Report -->
    <div class="rv-pane" id="pane-report">
      <div class="rv-toolbar">
        <div class="rv-search" style="flex:0 0 auto;min-width:0">
          <input type="date" id="gRepFrom" class="rv-select" style="padding-left:13px">
        </div>
        <div class="rv-search" style="flex:0 0 auto;min-width:0">
          <input type="date" id="gRepTo" class="rv-select" style="padding-left:13px">
        </div>
        <button class="btn btn-teal" onclick="loadGlobalReport()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          Tampilkan
        </button>
      </div>
      <div class="rv-overview" id="repStats" style="margin-bottom:16px"></div>

      <!-- Charts -->
      <div class="rep-charts">
        <div class="rep-chart-card">
          <div class="rcc-hd">
            <div><div class="rcc-t">Pemasukan & Penjualan</div><div class="rcc-s">deposit masuk vs modal voucher terpakai per hari</div></div>
          </div>
          <div id="repChartIncome" style="min-height:280px"></div>
        </div>
        <div class="rep-chart-card">
          <div class="rcc-hd"><div><div class="rcc-t">Performa Reseller</div><div class="rcc-s">voucher terjual per reseller (top 8)</div></div></div>
          <div id="repChartPerf" style="min-height:280px"></div>
        </div>
      </div>

      <div class="sec-title-rep">PERINGKAT RESELLER</div>
      <div class="rv-list">
        <table class="rv-tbl">
          <thead><tr><th style="width:46px">#</th><th>Reseller</th><th style="text-align:right">Voucher</th><th style="text-align:right">Omzet</th><th style="text-align:right">Keuntungan</th></tr></thead>
          <tbody id="repRows"><tr><td colspan="5" class="empty">Pilih periode lalu tekan Tampilkan.</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>
