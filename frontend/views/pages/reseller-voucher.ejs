  // Toggle tampil/sembunyi paket di halaman publik /beli-voucher (1 klik, tanpa modal).
  async function togglePublic(id, checked, el){
    if(el) el.disabled=true;
    const j = await apiCall('/packages/'+id,{method:'PUT',body:{ is_public: checked }});
    if(el) el.disabled=false;
    if(j.success){
      toast(checked?'Paket ditampilkan di halaman publik':'Paket disembunyikan dari halaman publik');
      loadPackages();
    }else{
