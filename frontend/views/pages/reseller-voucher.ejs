  async function savePromo(){
    const id=document.getElementById('pmoId').value;
    const payload={
      name:document.getElementById('pmoName').value.trim(),
      code:document.getElementById('pmoCode').value.trim(),
      type:document.getElementById('pmoType').value,
      value:document.getElementById('pmoValue').value,
      min_topup:document.getElementById('pmoMin').value,
