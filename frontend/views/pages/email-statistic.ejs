<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2/dist/apexcharts.min.js"></script>
  <style>
    :root{
      --a-bg:#f6f8fc; --a-card:#ffffff; --a-border:#eaeef6; --a-line:#f1f4fa;
      --a-text:#16203a; --a-muted:#7c879c; --a-soft:#aab2c4;
      --a-blue:#2563eb; --a-blue2:#3b82f6; --a-blue-soft:#eef3ff;
      --a-teal:#0fb6a3; --a-teal2:#14b8a6; --a-teal-soft:#e6faf6;
      --a-green:#10b981; --a-red:#ef4444; --a-amber:#f59e0b;
    }
    *{box-sizing:border-box;}
    body{background:var(--a-bg);font-family:'DM Sans',sans-serif;color:var(--a-text);}
    .page-content{padding:22px 26px 44px;}

    .a-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px;flex-wrap:wrap;}
    .a-h1{font-size:23px;font-weight:800;letter-spacing:-.02em;}
    .a-head-r{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    .a-chip{display:inline-flex;align-items:center;gap:9px;background:#fff;border:1px solid var(--a-border);border-radius:30px;padding:5px 7px 5px 12px;font-size:13px;font-weight:600;}
    .a-chip .av{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--a-blue),var(--a-teal));color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;}
    .a-btn{font-family:inherit;font-size:12.5px;font-weight:600;border-radius:10px;padding:9px 15px;cursor:pointer;
      display:inline-flex;align-items:center;gap:7px;border:1px solid var(--a-border);background:#fff;color:var(--a-text);transition:all .15s;}
    .a-btn:hover{border-color:var(--a-soft);}
    .a-btn.solid{background:var(--a-blue);color:#fff;border:none;}
    .a-btn.solid:hover{background:#1d4ed8;}
    .a-btn:disabled{opacity:.5;cursor:default;}

    .a-sec{display:flex;align-items:center;justify-content:space-between;margin:0 0 13px;}
    .a-sec-t{font-size:15px;font-weight:800;letter-spacing:-.01em;}
    .a-sec-link{font-size:12.5px;font-weight:700;color:var(--a-blue);cursor:pointer;}
    .a-sec-link:hover{text-decoration:underline;}

    /* delivery cards */
    .a-deliv{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px;}
    @media(max-width:1080px){.a-deliv{grid-template-columns:repeat(2,1fr);}}
    @media(max-width:560px){.a-deliv{grid-template-columns:1fr;}}
    .a-dc{background:var(--a-card);border:1px solid var(--a-border);border-radius:16px;padding:16px 17px 8px;position:relative;overflow:hidden;}
    .a-dc.hl{background:linear-gradient(150deg,var(--a-blue) 0%,#4f6ef0 55%,var(--a-teal) 165%);border:none;color:#fff;}
    .a-dc-top{display:flex;align-items:center;justify-content:space-between;}
    .a-dc-lbl{font-size:12.5px;font-weight:700;color:var(--a-muted);}
    .a-dc.hl .a-dc-lbl{color:rgba(255,255,255,.9);}
    .a-dc-i{color:var(--a-soft);}
    .a-dc.hl .a-dc-i{color:rgba(255,255,255,.7);}
    .a-dc-val{display:flex;align-items:baseline;gap:9px;margin-top:11px;}
    .a-dc-num{font-size:29px;font-weight:800;letter-spacing:-.02em;line-height:1;}
    .a-dc-delta{font-size:11.5px;font-weight:700;display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:20px;}
    .a-dc-delta.up{color:var(--a-green);background:#e7f9f1;}
    .a-dc-delta.down{color:var(--a-red);background:#fdecec;}
    .a-dc.hl .a-dc-delta{background:rgba(255,255,255,.22);color:#fff;}
    .a-dc-sub{font-size:11.5px;font-weight:600;color:var(--a-soft);margin-top:7px;}
    .a-dc.hl .a-dc-sub{color:rgba(255,255,255,.82);}
    .a-dc-spark{height:42px;margin:6px -2px 0;}

    /* chart panels */
    .a-row{display:grid;grid-template-columns:1.5fr 1fr;gap:16px;margin-bottom:24px;}
    @media(max-width:900px){.a-row{grid-template-columns:1fr;}}
    .a-card{background:var(--a-card);border:1px solid var(--a-border);border-radius:18px;padding:18px 20px;}
    .a-card-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;}
    .a-card-t{font-size:14.5px;font-weight:800;display:flex;align-items:center;gap:8px;}
    .a-card-t .q{width:16px;height:16px;color:var(--a-soft);}
    .a-legend{display:flex;gap:15px;align-items:center;font-size:12px;font-weight:600;color:var(--a-muted);}
    .a-legend span{display:inline-flex;align-items:center;gap:6px;}
    .a-legend i{width:9px;height:9px;border-radius:50%;}

    .a-donut-wrap{position:relative;display:flex;align-items:center;justify-content:center;margin-top:4px;}
    .a-donut-c{position:absolute;text-align:center;pointer-events:none;}
    .a-donut-c .big{font-size:27px;font-weight:800;letter-spacing:-.02em;}
    .a-donut-c .cap{font-size:11px;font-weight:600;color:var(--a-muted);margin-top:1px;}
    .a-dlegend{display:flex;flex-wrap:wrap;gap:12px 18px;justify-content:center;margin-top:10px;font-size:12px;font-weight:600;color:var(--a-muted);}
    .a-dlegend span{display:inline-flex;align-items:center;gap:7px;}
    .a-dlegend i{width:9px;height:9px;border-radius:50%;}

    /* table */
    .a-tcard{background:var(--a-card);border:1px solid var(--a-border);border-radius:18px;padding:18px 20px;}
    .a-tabs{display:inline-flex;background:#f3f6fc;border-radius:10px;padding:3px;gap:2px;}
    .a-tabs button{border:none;background:none;font-family:inherit;font-size:12.5px;font-weight:700;color:var(--a-muted);padding:7px 16px;border-radius:8px;cursor:pointer;}
    .a-tabs button.on{background:#fff;color:var(--a-blue);box-shadow:0 1px 3px rgba(22,32,58,.08);}
    .a-tools{display:flex;gap:9px;align-items:center;flex-wrap:wrap;}
    .a-search{display:flex;align-items:center;gap:7px;border:1px solid var(--a-border);border-radius:10px;padding:8px 12px;background:#fff;min-width:180px;}
    .a-search input{border:none;outline:none;font-family:inherit;font-size:13px;width:100%;color:var(--a-text);background:transparent;}
    .a-tbl{width:100%;border-collapse:collapse;margin-top:14px;font-size:13px;}
    .a-tbl thead th{text-align:left;padding:11px 12px;font-size:11px;font-weight:700;color:var(--a-soft);text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--a-line);}
    .a-tbl tbody td{padding:13px 12px;border-bottom:1px solid var(--a-line);vertical-align:middle;}
    .a-tbl tbody tr:last-child td{border-bottom:none;}
    .a-tbl tbody tr:hover{background:#fafcff;}
    .a-tname{display:flex;align-items:center;gap:11px;font-weight:700;}
    .a-ti{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .a-rate{font-weight:700;}
    .a-bar{height:6px;border-radius:20px;background:#eef2f9;overflow:hidden;width:80px;margin-top:5px;}
    .a-bar i{display:block;height:100%;border-radius:20px;background:linear-gradient(90deg,var(--a-blue),var(--a-teal));}
    .a-pill{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;display:inline-block;}
    .p-ok{background:#e7f9f1;color:#0a8f5f;} .p-mid{background:var(--a-blue-soft);color:var(--a-blue);} .p-low{background:#f1f4fa;color:var(--a-muted);}

    .a-empty{text-align:center;color:var(--a-soft);padding:34px;font-size:13px;}
    .a-skel{color:var(--a-soft);text-align:center;padding:26px;font-size:13px;}
    .a-toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);opacity:0;background:var(--a-text);color:#fff;padding:13px 22px;border-radius:13px;font-size:13px;font-weight:600;z-index:10002;transition:all .3s;box-shadow:0 16px 36px rgba(22,32,58,.26);pointer-events:none;max-width:90vw;}
    .a-toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
    .a-toast.err{background:#b91c1c;}
  </style>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { active: active }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { user: user }) %>
    <main class="page-content">

      <!-- Header -->
      <div class="a-head">
        <div class="a-h1">Email Analytics</div>
        <div class="a-head-r">
          <button class="a-btn" id="btnRetry" onclick="retryNow()">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M4 9a8 8 0 0114-3M20 15a8 8 0 01-14 3"/></svg>
            Proses Retry
          </button>
          <button class="a-btn" onclick="sendDigest()">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h4l2 6 4-12 2 6h6"/></svg>
            Kirim Digest
          </button>
          <button class="a-btn solid" onclick="loadStats()">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M4 9a8 8 0 0114-3M20 15a8 8 0 01-14 3"/></svg>
            Muat Ulang
          </button>
        </div>
      </div>

      <!-- Delivery -->
      <div class="a-sec"><div class="a-sec-t">Pengiriman</div><div class="a-sec-link" onclick="sendDigest()">Kirim Digest</div></div>
      <div class="a-deliv" id="deliv">
        <div class="a-dc"><div class="a-skel">Memuat…</div></div>
        <div class="a-dc"><div class="a-skel">&nbsp;</div></div>
        <div class="a-dc"><div class="a-skel">&nbsp;</div></div>
        <div class="a-dc"><div class="a-skel">&nbsp;</div></div>
      </div>

      <!-- Charts -->
      <div class="a-row">
        <div class="a-card">
          <div class="a-card-h">
            <div class="a-card-t">Email Data Tren
              <svg class="q" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 16v.01M12 13a2 2 0 10-2-2"/></svg>
            </div>
            <div class="a-legend">
              <span><i style="background:#2563eb;"></i>Terkirim</span>
              <span><i style="background:#0fb6a3;"></i>Gagal</span>
            </div>
          </div>
          <div id="trendChart" style="min-height:265px;"></div>
        </div>

        <div class="a-card">
          <div class="a-card-h">
            <div class="a-card-t">Komposisi Status</div>
          </div>
          <div class="a-donut-wrap">
            <div id="statusDonut" style="width:100%;"></div>
            <div class="a-donut-c" id="statusCenter"><div class="big">—</div><div class="cap">total email</div></div>
          </div>
          <div class="a-dlegend" id="statusLegend">
            <span><i style="background:#2563eb;"></i>Terkirim</span>
            <span><i style="background:#0fb6a3;"></i>Gagal</span>
            <span><i style="background:#f59e0b;"></i>Retry</span>
          </div>
        </div>
      </div>

      <!-- Table -->
      <div class="a-tcard">
        <div class="a-card-h" style="margin-bottom:14px;">
          <div class="a-card-t">Performa per Jenis Email</div>
          <div class="a-tools">
            <div class="a-search">
              <svg width="15" height="15" fill="none" stroke="#aab2c4" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="M21 21l-4-4"/></svg>
              <input id="tsearch" placeholder="Cari jenis…" oninput="filterTypes()">
            </div>
            <button class="a-btn" onclick="window.location='/email-log'">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              Riwayat
            </button>
          </div>
        </div>
        <table class="a-tbl">
          <thead><tr>
            <th>Jenis Email</th><th>Jumlah</th><th>Porsi</th><th>Distribusi</th><th>Status</th>
          </tr></thead>
          <tbody id="typeRows"><tr><td colspan="5"><div class="a-skel">Memuat…</div></td></tr></tbody>
        </table>
      </div>

    </main>
  </div>
</div>

<div class="a-toast" id="toast"></div>

<script src="/js/app.js"></script>
<script>
  let trendC=null, statusC=null, sparks=[]; let DATA=null;
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
  function api(url,opt){ if(window.App&&App.api) return App.api(url,opt);
    return fetch('/api'+url,Object.assign({headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},credentials:'include'},opt||{})).then(r=>r.json()); }
  function toast(msg,isErr){ const t=document.getElementById('toast'); t.textContent=msg; t.className='a-toast show'+(isErr?' err':''); setTimeout(()=>t.className='a-toast'+(isErr?' err':''),3200); }

  const ARR_UP='<svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9M17 7v8"/></svg>';
  const ARR_DN='<svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7l10 10M17 17H9M17 17V9"/></svg>';

  // build daily arrays from trend (7 days)
  function trendArrays(trend){
    const map={}; (trend||[]).forEach(r=>map[r.d]=r); const sent=[],failed=[],labels=[];
    for(let i=6;i>=0;i--){ const dt=new Date(Date.now()-i*86400000); const k=dt.toISOString().slice(0,10); const r=map[k]||{};
      sent.push(+(r.sent||0)); failed.push(+(r.failed||0)); labels.push(dt.toLocaleDateString('id-ID',{weekday:'short'})); }
    return {sent,failed,labels};
  }

  function delivCard(opt){
    const cls=opt.hl?'a-dc hl':'a-dc';
    const delta=opt.delta!=null?'<span class="a-dc-delta '+opt.deltaCls+'">'+(opt.deltaCls==='up'?ARR_UP:(opt.deltaCls==='down'?ARR_DN:''))+opt.delta+'</span>':'';
    return '<div class="'+cls+'">'
      +'<div class="a-dc-top"><div class="a-dc-lbl">'+esc(opt.label)+'</div>'
        +'<svg class="a-dc-i" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 16v.01M12 13a2 2 0 10-2-2"/></svg></div>'
      +'<div class="a-dc-val"><div class="a-dc-num">'+esc(opt.value)+'</div>'+delta+'</div>'
      +'<div class="a-dc-sub">'+esc(opt.sub)+'</div>'
      +'<div class="a-dc-spark" id="'+opt.sparkId+'"></div>'
      +'</div>';
  }

  function renderDeliv(d){
    const t=trendArrays(d.trend);
    const okRate=d.today>0?Math.round(d.todaySent/d.today*100):100;
    const wrap=document.getElementById('deliv');
    wrap.innerHTML=
      delivCard({label:'Tingkat Sukses',value:d.successRate+'%',delta:(d.successRate>=95?'Baik':null),deltaCls:'up',sub:d.sent+' terkirim total',hl:true,sparkId:'sp0'})
      +delivCard({label:'Terkirim Hari Ini',value:d.todaySent,delta:okRate+'%',deltaCls:okRate>=90?'up':'down',sub:'dari '+d.today+' email',sparkId:'sp1'})
      +delivCard({label:'Gagal Hari Ini',value:d.todayFailed,delta:d.todayFailed>0?'perlu cek':null,deltaCls:'down',sub:d.failed+' gagal total',sparkId:'sp2'})
      +delivCard({label:'Antrian Retry',value:d.retrying,delta:d.retrying>0?'antri':null,deltaCls:'down',sub:'menunggu dicoba ulang',sparkId:'sp3'});
    // spark bars
    sparks.forEach(c=>{try{c.destroy();}catch(e){}}); sparks=[];
    const bars=[
      {id:'sp0',data:t.sent,color:'#ffffff',opacity:.85},
      {id:'sp1',data:t.sent,color:'#2563eb'},
      {id:'sp2',data:t.failed,color:'#0fb6a3'},
      {id:'sp3',data:t.failed.map((v,i)=>v+ (t.sent[i]?0:0)),color:'#f59e0b'}
    ];
    bars.forEach(b=>{
      const el=document.getElementById(b.id); if(!el) return;
      const c=new ApexCharts(el,{
        chart:{type:'bar',height:42,sparkline:{enabled:true}},
        series:[{data:b.data}], colors:[b.color],
        plotOptions:{bar:{borderRadius:2,columnWidth:'58%'}},
        fill:{opacity:b.opacity||1}, tooltip:{enabled:false},
        states:{hover:{filter:{type:'none'}}}
      });
      c.render(); sparks.push(c);
    });
  }

  function renderTrend(d){
    const t=trendArrays(d.trend);
    const opts={
      chart:{type:'area',height:265,toolbar:{show:false},fontFamily:'DM Sans,sans-serif'},
      series:[{name:'Terkirim',data:t.sent},{name:'Gagal',data:t.failed}],
      colors:['#2563eb','#0fb6a3'],
      stroke:{curve:'smooth',width:3},
      fill:{type:'gradient',gradient:{shadeIntensity:1,opacityFrom:.30,opacityTo:.02,stops:[0,95]}},
      dataLabels:{enabled:false},
      xaxis:{categories:t.labels,labels:{style:{colors:'#aab2c4',fontSize:'11px',fontWeight:600}},axisBorder:{show:false},axisTicks:{show:false}},
      yaxis:{labels:{style:{colors:'#aab2c4',fontSize:'11px'}}},
      grid:{borderColor:'#f1f4fa',strokeDashArray:5,padding:{left:6,right:6}},
      legend:{show:false},
      markers:{size:0,hover:{size:6}},
      tooltip:{theme:'light',y:{formatter:v=>v+' email'}}
    };
    if(trendC) trendC.destroy();
    trendC=new ApexCharts(document.getElementById('trendChart'),opts); trendC.render();
  }

  function renderStatus(d){
    const tot=d.total||0;
    document.querySelector('#statusCenter .big').textContent=(tot>=1000?(tot/1000).toFixed(1).replace('.0','')+'K':tot);
    const series=[+d.sent||0,+d.failed||0,+d.retrying||0]; const has=series.some(x=>x>0);
    const opts={
      chart:{type:'donut',height:250,fontFamily:'DM Sans,sans-serif'},
      series:has?series:[1,0,0],
      labels:['Terkirim','Gagal','Retry'], colors:['#2563eb','#0fb6a3','#f59e0b'],
      stroke:{width:3,colors:['#fff']}, dataLabels:{enabled:has,formatter:(v)=>Math.round(v)+'%',style:{fontSize:'11px',fontWeight:'700'},dropShadow:{enabled:false}},
      legend:{show:false},
      plotOptions:{pie:{donut:{size:'72%'}}},
      tooltip:{enabled:has,y:{formatter:v=>v+' email'}}
    };
    if(statusC) statusC.destroy();
    statusC=new ApexCharts(document.getElementById('statusDonut'),opts); statusC.render();
  }

  const TLBL={ finance_report:'Laporan Keuangan', daily_digest:'Digest Harian', invoice_overdue:'Invoice Overdue',
    invoice_unpaid:'Tagihan Invoice', invoice_paid:'Kwitansi Lunas', email_broadcast:'Broadcast Email',
    voucher_delivery:'Kirim Voucher', backup:'Backup MikroTik',
    customer_welcome:'Selamat Datang', test:'Email Uji', other:'Lainnya', payment:'Pembayaran', isolir:'Isolir', broadcast:'Broadcast' };
  const TICON={
    finance_report:{bg:'#eef3ff',c:'#2563eb',d:'M9 19v-6m4 6V5m4 14v-9M3 21h18'},
    daily_digest:{bg:'#e6faf6',c:'#0fb6a3',d:'M3 12h4l2 6 4-12 2 6h6'},
    invoice_overdue:{bg:'#fdecec',c:'#dc2626',d:'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'},
    invoice_unpaid:{bg:'#eef3ff',c:'#2563eb',d:'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'},
    invoice_paid:{bg:'#e6faf6',c:'#0a8f80',d:'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'},
    email_broadcast:{bg:'#eef3ff',c:'#2563eb',d:'M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z'},
    voucher_delivery:{bg:'#e6faf6',c:'#0fb6a3',d:'M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z'},
    backup:{bg:'#f1f4fa',c:'#64748b',d:'M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7M4 7c0-2 1-3 3-3h10c2 0 3 1 3 3M4 7h16M9 12h6'},
    customer_welcome:{bg:'#e6faf6',c:'#0a8f80',d:'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'},
    test:{bg:'#f1f4fa',c:'#64748b',d:'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2'},
    other:{bg:'#eef3ff',c:'#3b82f6',d:'M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z'}
  };
  function tIcon(type){ const t=TICON[type]||TICON.other;
    return '<div class="a-ti" style="background:'+t.bg+';color:'+t.c+';"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="'+t.d+'"/></svg></div>'; }

  function renderTypes(byType,total){
    const tb=document.getElementById('typeRows');
    if(!byType||!byType.length){ tb.innerHTML='<tr><td colspan="5"><div class="a-empty">Belum ada data email.</div></td></tr>'; return; }
    const tot=total||byType.reduce((s,t)=>s+(+t.cnt),0)||1;
    const q=(document.getElementById('tsearch').value||'').toLowerCase();
    const rows=byType.filter(t=>{ const name=(TLBL[t.type]||t.type||'').toLowerCase(); return !q||name.includes(q); });
    if(!rows.length){ tb.innerHTML='<tr><td colspan="5"><div class="a-empty">Tidak ada yang cocok.</div></td></tr>'; return; }
    tb.innerHTML=rows.map(t=>{
      const name=TLBL[t.type]||t.type||'(lainnya)'; const pct=Math.round((+t.cnt/tot)*100);
      let pill; if(pct>=40) pill='<span class="a-pill p-ok">Dominan</span>'; else if(pct>=15) pill='<span class="a-pill p-mid">Reguler</span>'; else pill='<span class="a-pill p-low">Sesekali</span>';
      return '<tr>'
        +'<td><div class="a-tname">'+tIcon(t.type)+esc(name)+'</div></td>'
        +'<td class="a-rate">'+(+t.cnt)+'</td>'
        +'<td class="a-rate" style="color:#2563eb;">'+pct+'%</td>'
        +'<td><div class="a-bar"><i style="width:'+pct+'%;"></i></div></td>'
        +'<td>'+pill+'</td>'
        +'</tr>';
    }).join('');
  }
  function filterTypes(){ if(DATA) renderTypes(DATA.byType,DATA.total); }

  async function loadStats(){
    try{
      const r=await api('/email-log/stats');
      if(!r||!r.success){ document.getElementById('deliv').innerHTML='<div class="a-dc" style="grid-column:1/-1;"><div class="a-empty">Gagal memuat statistik.</div></div>'; return; }
      DATA=r.data;
      renderDeliv(DATA); renderTrend(DATA); renderStatus(DATA); renderTypes(DATA.byType,DATA.total);
    }catch(e){ document.getElementById('deliv').innerHTML='<div class="a-dc" style="grid-column:1/-1;"><div class="a-empty">Kesalahan jaringan.</div></div>'; }
  }

  async function retryNow(){ const btn=document.getElementById('btnRetry'); btn.disabled=true;
    try{ const r=await api('/email-log/retry-now',{method:'POST',body:'{}'});
      if(r&&r.success){ toast(r.message||'Antrian retry diproses'); loadStats(); } else toast((r&&r.message)||'Gagal memproses retry',true);
    }catch(e){ toast('Kesalahan jaringan',true); } btn.disabled=false; }
  async function sendDigest(){
    try{ const r=await api('/email/digest/test',{method:'POST',body:'{}'});
      if(r&&r.success){ toast(r.message||'Digest terkirim'); loadStats(); } else toast((r&&r.message)||'Gagal mengirim digest',true);
    }catch(e){ toast('Kesalahan jaringan',true); } }

  loadStats();
</script>
</body>
</html>
