<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    :root{--d-bg:#eef2f9;--d-card:#fff;--d-border:#e0e7f3;--d-text:#0d1b3e;--d-muted:#6b7fa8;--d-blue1:#1a6ef5;}
    .mb-page{font-family:'DM Sans',sans-serif;}

    /* Stat strip (clickable, blue-active) */
    .mb-grid{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border-radius:16px;border:1px solid #e8eaed;overflow:hidden;margin-bottom:20px;}
    .mb-card{padding:20px 22px 18px;border-right:1px solid #e8eaed;display:flex;flex-direction:column;cursor:pointer;position:relative;overflow:hidden;transition:background .15s;}
    .mb-card::before,.mb-card::after{display:none!important;content:none!important;}
    .mb-card:last-child{border-right:none;}
    .mb-card:hover{background:#fafbff;}
    .mb-card.xc-active{background:#2563eb;border-color:#2563eb;}
    .mb-card.xc-active:hover{background:#1d4ed8;}
    .mb-card.xc-active .mb-lbl{color:rgba(255,255,255,.70);}
    .mb-card.xc-active .mb-val{color:#fff;}
    .mb-card.xc-active .mb-sub{color:rgba(255,255,255,.60);}
    .mb-card.xc-active .mb-pill{background:rgba(255,255,255,.20)!important;color:rgba(255,255,255,.92)!important;}
    .mb-lbl{font-size:12px;font-weight:500;color:#64748b;margin-bottom:9px;letter-spacing:.1px;transition:color .15s;}
    .mb-val{font-size:28px;font-weight:800;color:#0f172a;letter-spacing:-1.1px;line-height:1;transition:color .15s;}
    @media(max-width:1400px){.mb-val{font-size:24px;}}
    .mb-meta{display:flex;align-items:center;gap:5px;margin-top:6px;flex-wrap:wrap;}
    .mb-pill{display:inline-flex;align-items:center;padding:1px 7px;border-radius:100px;font-size:10.5px;font-weight:700;white-space:nowrap;transition:all .15s;}
    .mb-pill.blue{background:#dbeafe;color:#1d4ed8;}
    .mb-pill.green{background:#dcfce7;color:#16a34a;}
    .mb-pill.amber{background:#fef3c7;color:#b45309;}
    .mb-pill.red{background:#fee2e2;color:#dc2626;}
    .mb-pill.gray{background:#f1f5f9;color:#64748b;}
    .mb-sub{font-size:11px;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:color .15s;}
    @media(max-width:700px){
      .mb-grid{grid-template-columns:repeat(2,1fr);}
      .mb-card{border-right:none;border-bottom:1px solid #e8eaed;padding:16px 16px 14px;}
      .mb-card:nth-child(odd){border-right:1px solid #e8eaed;}
      .mb-card:nth-last-child(-n+2){border-bottom:none;}
      .mb-val{font-size:22px;}
    }
    @media(max-width:400px){
      .mb-grid{grid-template-columns:1fr;}
      .mb-card{border-right:none!important;border-bottom:1px solid #e8eaed;}
      .mb-card:last-child{border-bottom:none;}
    }
    /* Panel highlight pulse when a stat card is clicked */
    @keyframes panelPulse{0%{box-shadow:0 0 0 0 rgba(37,99,235,.35);}100%{box-shadow:0 0 0 6px rgba(37,99,235,0);}}
    .panel-flash{animation:panelPulse .9s ease-out;border-color:#2563eb!important;}

    /* ── Modal konfirmasi (modern, clean) ── */
    .mb-modal-bg{position:fixed;inset:0;background:rgba(13,27,62,.48);backdrop-filter:blur(4px);z-index:2000;display:none;align-items:center;justify-content:center;padding:18px;}
    .mb-modal-bg.open{display:flex;animation:mbFade .18s ease;}
    @keyframes mbFade{from{opacity:0}to{opacity:1}}
    .mb-modal{background:#fff;border-radius:20px;width:100%;max-width:400px;padding:26px 24px 20px;text-align:center;box-shadow:0 24px 60px rgba(13,27,62,.28);animation:mbPop .22s cubic-bezier(.34,1.56,.64,1);}
    @keyframes mbPop{from{opacity:0;transform:translateY(16px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
    .mb-modal-ic{width:56px;height:56px;border-radius:16px;margin:0 auto 16px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#eff6ff,#dbeafe);color:#1d4ed8;}
    .mb-modal-ic.warn{background:linear-gradient(135deg,#fff7ed,#ffedd5);color:#c2410c;}
    .mb-modal-ic.danger{background:linear-gradient(135deg,#fef2f2,#fee2e2);color:#dc2626;}
    .mb-modal-title{font-size:17px;font-weight:800;color:#0d1b3e;letter-spacing:-.3px;margin-bottom:7px;}
    .mb-modal-msg{font-size:13px;line-height:1.6;color:#6b7fa8;margin-bottom:22px;}
    .mb-modal-actions{display:flex;gap:10px;}
    .mb-modal-btn{flex:1;padding:11px 14px;border-radius:11px;font-size:13px;font-weight:700;border:none;cursor:pointer;font-family:'DM Sans',sans-serif;transition:transform .1s,opacity .15s,background .15s;}
    .mb-modal-btn:hover{transform:translateY(-1px);}
    .mb-modal-btn:active{transform:translateY(0);}
    .mb-modal-btn.ghost{background:#f1f5f9;color:#475569;}
    .mb-modal-btn.ghost:hover{background:#e2e8f0;}
    .mb-modal-btn.primary{background:linear-gradient(135deg,#1a6ef5,#0047cc);color:#fff;}
    .mb-modal-btn.primary:hover{opacity:.92;}
    .mb-modal-btn.primary.danger{background:linear-gradient(135deg,#ef4444,#dc2626);}
    @media(max-width:420px){
      .mb-modal{padding:22px 18px 18px;max-width:none;}
      .mb-modal-actions{flex-direction:column-reverse;}
    }

    @keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
    .a1{animation:fadeUp .35s ease both}.a2{animation:fadeUp .35s .07s ease both}.a5{animation:fadeUp .35s .28s ease both}
    @keyframes spin{to{transform:rotate(360deg)}}
    .spin{animation:spin 1s linear infinite;}

    /* Layout */
    .mb-layout{display:grid;grid-template-columns:360px 1fr;gap:16px;align-items:start;}
    @media(max-width:1020px){.mb-layout{grid-template-columns:1fr;}}
    @media(max-width:560px){
      .mb-hdr-row{flex-direction:column;align-items:stretch!important;}
      .mb-hdr-row .mb-btn{width:100%!important;}
    }

    .panel{background:#fff;border:1px solid var(--d-border);border-radius:20px;overflow:hidden;}
    .panel-hdr{padding:15px 18px;border-bottom:1px solid var(--d-border);display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#f8faff,#f0f4ff);}
    .panel-body{padding:18px;}
    .panel-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}

    .pf-label{font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--d-muted);display:block;margin-bottom:5px;}
    .pf-input,.pf-select{width:100%;padding:9px 11px;border-radius:9px;border:1.5px solid var(--d-border);font-size:13px;box-sizing:border-box;font-family:'DM Sans',sans-serif;outline:none;background:#fff;color:var(--d-text);transition:all .15s;}
    .pf-input:focus,.pf-select:focus{border-color:var(--d-blue1);box-shadow:0 0 0 3px rgba(26,110,245,.08);}
    .pf-field{margin-bottom:12px;}

    /* Toggle switch */
    .tgl{position:relative;display:inline-block;width:38px;height:21px;flex-shrink:0;}
    .tgl input{opacity:0;width:0;height:0;}
    .tgl-slider{position:absolute;cursor:pointer;inset:0;background:#cbd5e1;border-radius:21px;transition:.2s;}
    .tgl-slider:before{content:"";position:absolute;height:15px;width:15px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.2s;}
    .tgl input:checked + .tgl-slider{background:#1a6ef5;}
    .tgl input:checked + .tgl-slider:before{transform:translateX(17px);}
    .tgl-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #f5f8ff;}
    .tgl-row:last-child{border-bottom:none;}
    .tgl-title{font-size:12.5px;font-weight:700;color:var(--d-text);}
    .tgl-desc{font-size:11px;color:var(--d-muted);margin-top:1px;}

    .mb-btn{padding:10px 14px;border-radius:10px;font-size:13px;font-weight:700;border:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;font-family:'DM Sans',sans-serif;transition:opacity .15s,transform .1s;}
    .mb-btn:hover{opacity:.9;transform:translateY(-1px);}
    .mb-btn:disabled{opacity:.6;cursor:not-allowed;transform:none;}
    .mb-btn-blue{background:linear-gradient(135deg,#1a6ef5,#0047cc);color:#fff;width:100%;}
    .mb-btn-green{background:linear-gradient(135deg,#00c896,#00a07a);color:#fff;width:100%;}
    .mb-btn-ghost{background:#f4f8ff;border:1.5px solid var(--d-border);color:var(--d-blue1);width:100%;}

    /* Device list */
    .dev-row{display:flex;align-items:center;gap:11px;padding:11px 18px;border-bottom:1px solid #f5f8ff;}
    .dev-row:last-child{border-bottom:none;}
    .dev-ic{width:34px;height:34px;border-radius:9px;background:#eff6ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .dev-name{font-size:12.5px;font-weight:700;color:var(--d-text);}
    .dev-ip{font-size:11px;color:var(--d-muted);font-family:'DM Mono',monospace;}

    /* File table */
    .mb-table{width:100%;border-collapse:collapse;}
    .mb-table th{padding:9px 14px;text-align:left;font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--d-muted);border-bottom:1px solid #f0f4ff;background:#fafbff;}
    .mb-table td{padding:10px 14px;font-size:12.5px;border-bottom:1px solid #f5f8ff;color:var(--d-text);vertical-align:middle;}
    .mb-table tr:hover td{background:#fafbff;}
    .ext-badge{display:inline-flex;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:700;font-family:'DM Mono',monospace;}
    .ext-rsc{background:#eff6ff;color:#1d4ed8;}
    .ext-backup{background:#f0fdf4;color:#16a34a;}

    .act-btn{width:27px;height:27px;border-radius:7px;border:1.5px solid var(--d-border);background:#fff;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:all .12s;margin-left:3px;}
    .act-btn:hover{border-color:var(--d-blue1);background:#eff6ff;}
    .act-btn.danger:hover{border-color:#dc2626;background:#fef2f2;}

    .tbl-empty{padding:36px 16px;text-align:center;color:var(--d-muted);font-size:12.5px;}

    /* Result box */
    .run-result{border-radius:12px;border:1.5px solid;padding:12px 14px;margin-top:12px;font-size:12px;display:none;}
    .run-result.ok{background:#f0fdf4;border-color:#bbf7d0;color:#15803d;}
    .run-result.warn{background:#fffbeb;border-color:#fde68a;color:#b45309;}
    .run-result.err{background:#fef2f2;border-color:#fecaca;color:#dc2626;}

    /* Mobile file cards */
    .mb-cards{display:none;}
    @media(max-width:760px){
      .mb-table-wrap{display:none;}
      .mb-cards{display:block;}
      .mbc-item{padding:12px 16px;border-bottom:1px solid #f0f4ff;display:flex;align-items:center;justify-content:space-between;gap:10px;}
      .panel-body{padding:14px;}
    }
  </style>
</head>
<body>
<div class="app-layout mb-page">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content">

      <!-- Header -->
      <div class="mb-hdr-row a1" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px;">
        <div>
          <h1 style="font-size:21px;font-weight:800;color:#0d1b3e;margin:0 0 3px;">Backup Konfigurasi MikroTik</h1>
          <p style="font-size:12.5px;color:var(--d-muted);margin:0;">Backup otomatis terjadwal via SSH (.rsc + .backup) dan kirim hasilnya ke email</p>
        </div>
        <button class="mb-btn mb-btn-green" style="width:auto;" onclick="runBackup(null)" id="btnRunAll">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" id="runAllIcon"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Backup Semua Sekarang
        </button>
      </div>

      <!-- Stats -->
      <div class="mb-grid a2">
        <div class="mb-card xc-active" data-target="routerPanel" onclick="mbCardClick(this)">
          <div class="mb-lbl">Router Aktif</div>
          <span class="mb-val" id="stRouters">0</span>
          <div class="mb-meta"><span class="mb-pill blue">target</span><span class="mb-sub">Akan dibackup otomatis</span></div>
        </div>
        <div class="mb-card" data-target="filePanel" onclick="mbCardClick(this)">
          <div class="mb-lbl">File Backup</div>
          <span class="mb-val" id="stFiles">0</span>
          <div class="mb-meta"><span class="mb-pill green" id="stSize">0 MB</span><span class="mb-sub">Tersimpan di server</span></div>
        </div>
        <div class="mb-card" data-target="filePanel" onclick="mbCardClick(this)">
          <div class="mb-lbl">Backup Terakhir</div>
          <span class="mb-val" id="stLastAt" style="font-size:17px;margin-top:4px;">-</span>
          <div class="mb-meta"><span class="mb-pill gray" id="stLastStatus">-</span><span class="mb-sub" id="stLastSummary">belum pernah</span></div>
        </div>
        <div class="mb-card" data-target="settingsPanel" onclick="mbCardClick(this)">
          <div class="mb-lbl">Jadwal Otomatis</div>
          <span class="mb-val" id="stSchedule" style="font-size:17px;margin-top:4px;">-</span>
          <div class="mb-meta"><span class="mb-pill" id="stEnabledPill">-</span><span class="mb-sub" id="stEmailSub">-</span></div>
        </div>
      </div>

      <!-- Main layout -->
      <div class="mb-layout a5">

        <!-- ════════ Kolom kiri: Pengaturan ════════ -->
        <div style="display:flex;flex-direction:column;gap:16px;">
          <div class="panel" id="settingsPanel">
            <div class="panel-hdr">
              <div class="panel-icon" style="background:linear-gradient(135deg,#1e3a8a,#1d4ed8);">
                <svg width="14" height="14" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
              </div>
              <div>
                <div style="font-size:13.5px;font-weight:700;color:var(--d-text);">Pengaturan Auto-Backup</div>
                <div style="font-size:11px;color:var(--d-muted);">Jadwal, email penerima, dan retensi</div>
              </div>
            </div>
            <div class="panel-body">

              <div class="tgl-row" style="padding-top:0;">
                <div>
                  <div class="tgl-title">Auto-Backup Terjadwal</div>
                  <div class="tgl-desc">Backup otomatis sesuai jadwal di bawah</div>
                </div>
                <label class="tgl"><input type="checkbox" id="setEnabled"><span class="tgl-slider"></span></label>
              </div>

              <div class="pf-field" style="margin-top:12px;">
                <label class="pf-label">Frekuensi</label>
                <select class="pf-select" id="setFrequency" onchange="onFreqChange()">
                  <option value="daily">Harian</option>
                  <option value="weekly">Mingguan</option>
                  <option value="monthly">Bulanan</option>
                </select>
              </div>

              <div class="pf-field" id="dowField" style="display:none;">
                <label class="pf-label">Hari</label>
                <select class="pf-select" id="setDayOfWeek">
                  <option value="1">Senin</option><option value="2">Selasa</option><option value="3">Rabu</option>
                  <option value="4">Kamis</option><option value="5">Jumat</option><option value="6">Sabtu</option>
                  <option value="0">Minggu</option>
                </select>
              </div>

              <div class="pf-field" id="domField" style="display:none;">
                <label class="pf-label">Tanggal (1-28)</label>
                <input type="number" class="pf-input" id="setDayOfMonth" min="1" max="28" value="1">
              </div>

              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                <div class="pf-field">
                  <label class="pf-label">Jam (0-23)</label>
                  <input type="number" class="pf-input" id="setHour" min="0" max="23" value="2">
                </div>
                <div class="pf-field">
                  <label class="pf-label">Menit (0-59)</label>
                  <input type="number" class="pf-input" id="setMinute" min="0" max="59" value="0">
                </div>
              </div>

              <div class="tgl-row">
                <div>
                  <div class="tgl-title">Kirim Hasil ke Email</div>
                  <div class="tgl-desc">Lampiran file backup + ringkasan per router</div>
                </div>
                <label class="tgl"><input type="checkbox" id="setSendEmail" checked><span class="tgl-slider"></span></label>
              </div>

              <div class="pf-field" style="margin-top:10px;">
                <label class="pf-label">Email Penerima</label>
                <input type="text" class="pf-input" id="setRecipients" placeholder="admin@isp.com, noc@isp.com">
                <div style="font-size:10.5px;color:var(--d-muted);margin-top:3px;">Pisahkan dengan koma untuk lebih dari satu</div>
              </div>

              <div class="tgl-row">
                <div>
                  <div class="tgl-title">Sertakan Binary Backup (.backup)</div>
                  <div class="tgl-desc">Full backup restorable, diambil via SFTP</div>
                </div>
                <label class="tgl"><input type="checkbox" id="setIncludeBinary" checked><span class="tgl-slider"></span></label>
              </div>

              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px;">
                <div class="pf-field" style="margin-bottom:0;">
                  <label class="pf-label">Retensi (file/router)</label>
                  <input type="number" class="pf-input" id="setRetention" min="1" max="365" value="14">
                </div>
                <div class="pf-field" style="margin-bottom:0;">
                  <label class="pf-label">Port SSH</label>
                  <input type="number" class="pf-input" id="setSshPort" min="1" max="65535" value="22">
                </div>
              </div>
              <div style="font-size:10.5px;color:var(--d-muted);margin-top:4px;">SSH memakai username dan password API dari data device router</div>

              <div style="display:flex;flex-direction:column;gap:7px;margin-top:14px;">
                <button class="mb-btn mb-btn-blue" onclick="saveSettings()" id="btnSave">Simpan Pengaturan</button>
                <button class="mb-btn mb-btn-ghost" onclick="testEmail()" id="btnTestEmail">Test Email Penerima</button>
              </div>
            </div>
          </div>

          <!-- Router list -->
          <div class="panel" id="routerPanel">
            <div class="panel-hdr">
              <div class="panel-icon" style="background:linear-gradient(135deg,#0e7490,#0891b2);">
                <svg width="14" height="14" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8"/></svg>
              </div>
              <div>
                <div style="font-size:13.5px;font-weight:700;color:var(--d-text);">Router Target</div>
                <div style="font-size:11px;color:var(--d-muted);" id="devSub">-</div>
              </div>
            </div>
            <div id="devList"><div class="tbl-empty">Memuat...</div></div>
          </div>
        </div>

        <!-- ════════ Kolom kanan: File backup ════════ -->
        <div class="panel" id="filePanel">
          <div class="panel-hdr" style="background:#fff;">
            <div>
              <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--d-muted);">File Backup Tersimpan</div>
              <div style="font-size:11.5px;color:var(--d-muted);margin-top:1px;" id="fileSub">-</div>
            </div>
            <button class="act-btn" style="margin-left:auto;" title="Refresh" onclick="loadFiles();loadInfo();">
              <svg width="13" height="13" fill="none" stroke="#1a6ef5" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            </button>
          </div>

          <div class="run-result" id="runResult"></div>

          <div class="mb-table-wrap" style="overflow-x:auto;">
            <table class="mb-table">
              <thead><tr><th>File</th><th>Tipe</th><th>Ukuran</th><th>Dibuat</th><th style="text-align:right;">Aksi</th></tr></thead>
              <tbody id="fileTable"><tr><td colspan="5"><div class="tbl-empty">Memuat...</div></td></tr></tbody>
            </table>
          </div>
          <div class="mb-cards" id="fileCards"></div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- ════════ Modal Konfirmasi Backup ════════ -->
