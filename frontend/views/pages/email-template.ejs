<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    :root{
      --et-bg:#eef2f9;--et-card:#fff;--et-border:#e0e7f3;
      --et-text:#0d1b3e;--et-muted:#6b7fa8;--et-blue:#1f8bff;--et-blue-deep:#1565e0;
    }
    body{background:var(--et-bg);font-family:'DM Sans',sans-serif;}
    .et-page{padding:0;max-width:none;margin:0;}
    .et-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:12px;}
    .et-title{font-size:22px;font-weight:800;color:var(--et-text);letter-spacing:-.01em;}
    .et-sub{font-size:13px;color:var(--et-muted);margin-top:3px;}
    .et-actions{display:flex;gap:10px;flex-wrap:wrap;}
    .et-btn{padding:9px 16px;border-radius:10px;font-size:13px;font-weight:700;border:none;cursor:pointer;
      display:inline-flex;align-items:center;gap:7px;font-family:inherit;transition:all .15s;}
    .et-btn-primary{background:linear-gradient(135deg,#1f8bff,#1565e0);color:#fff;box-shadow:0 4px 10px -2px rgba(31,122,255,.4);}
    .et-btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 14px -2px rgba(31,122,255,.5);}
    .et-btn-primary:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none;}
    .et-btn-ghost{background:#fff;color:var(--et-text);border:1.5px solid var(--et-border);}
    .et-btn-ghost:hover{border-color:var(--et-blue);color:var(--et-blue);}
    .et-btn-danger{background:#fff;color:#dc2626;border:1.5px solid #fecaca;}
    .et-btn-danger:hover{background:#fef2f2;border-color:#dc2626;}

    /* Layout: list | editor | preview */
    .et-grid{display:grid;grid-template-columns:248px 1fr 1fr;gap:18px;align-items:start;}
    @media (max-width:1280px){.et-grid{grid-template-columns:228px 1fr;}.et-preview-col{grid-column:1 / -1;}}
    @media (max-width:860px){.et-grid{grid-template-columns:1fr;}}

    .et-card{background:var(--et-card);border:1px solid var(--et-border);border-radius:16px;overflow:hidden;}
    .et-card-h{padding:13px 16px;border-bottom:1px solid var(--et-border);font-size:12px;font-weight:800;
      letter-spacing:.04em;text-transform:uppercase;color:var(--et-muted);display:flex;align-items:center;gap:8px;}

    /* Template list */
    .et-list{display:flex;flex-direction:column;padding:8px;}
    .et-item{display:flex;align-items:flex-start;gap:11px;padding:11px 12px;border-radius:12px;cursor:pointer;
      border:1.5px solid transparent;transition:all .14s;text-align:left;background:none;font-family:inherit;width:100%;}
    .et-item:hover{background:#f4f8ff;}
    .et-item.active{background:#eef5ff;border-color:var(--et-blue);}
    .et-item-ic{width:38px;height:38px;border-radius:11px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
      background:#eaf2ff;color:var(--et-blue-deep);}
    .et-item.active .et-item-ic{background:linear-gradient(135deg,#1f8bff,#1565e0);color:#fff;}
    .et-item-b{flex:1;min-width:0;}
    .et-item-t{font-size:13px;font-weight:700;color:var(--et-text);line-height:1.25;display:block;}
    .et-item-d{font-size:11px;color:var(--et-muted);margin-top:3px;line-height:1.35;display:block;}
    .et-pill{display:inline-block;font-size:9.5px;font-weight:800;padding:2px 7px;border-radius:6px;margin-top:5px;letter-spacing:.03em;}
    .et-pill.on{background:#e7f7ef;color:#0a9a5a;}
    .et-pill.off{background:#f1f3f7;color:#8a95ad;}

    /* Editor */
    .et-editor{padding:16px;}
    .et-field{margin-bottom:15px;}
    .et-field:last-child{margin-bottom:0;}
    .et-label{display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700;
      color:#33415c;margin-bottom:7px;}
    .et-inp,.et-ta{width:100%;border:1.5px solid var(--et-border);border-radius:11px;padding:10px 13px;
      font-family:inherit;font-size:13.5px;color:var(--et-text);background:#f9fbfe;outline:none;transition:all .15s;resize:vertical;}
    .et-inp:focus,.et-ta:focus{border-color:var(--et-blue);background:#fff;box-shadow:0 0 0 3.5px rgba(31,139,255,.1);}
    .et-ta{min-height:78px;line-height:1.55;}
    .et-color-row{display:flex;align-items:center;gap:10px;}
    .et-color-row input[type=color]{width:46px;height:40px;border:1.5px solid var(--et-border);border-radius:10px;
      padding:2px;background:#fff;cursor:pointer;}
    .et-hint{font-size:11px;color:var(--et-muted);margin-top:6px;line-height:1.5;}

    /* Variable chips */
    .et-vars{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px;}
    .et-chip{font-size:11px;font-weight:700;font-family:'DM Mono',monospace;background:#eef5ff;color:var(--et-blue-deep);
      border:1px solid #d5e6ff;padding:3px 9px;border-radius:7px;cursor:pointer;transition:all .13s;}
    .et-chip:hover{background:var(--et-blue);color:#fff;border-color:var(--et-blue);}

    /* Toggle */
    .et-switch{position:relative;display:inline-flex;align-items:center;gap:9px;cursor:pointer;}
    .et-switch input{display:none;}
    .et-track{width:42px;height:24px;border-radius:13px;background:#cfd8e8;transition:all .18s;position:relative;flex-shrink:0;}
    .et-track::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;
      transition:all .18s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
    .et-switch input:checked + .et-track{background:linear-gradient(135deg,#1f8bff,#1565e0);}
    .et-switch input:checked + .et-track::after{left:20px;}
    .et-switch-l{font-size:12.5px;font-weight:700;color:#33415c;}

    /* Preview */
    .et-preview-col .et-card{position:sticky;top:14px;}
    .et-subject{padding:12px 16px;border-bottom:1px solid var(--et-border);background:#f9fbfe;}
    .et-subject .l{font-size:10.5px;font-weight:800;letter-spacing:.05em;color:var(--et-muted);text-transform:uppercase;}
    .et-subject .v{font-size:14px;font-weight:700;color:var(--et-text);margin-top:3px;word-break:break-word;}
    .et-frame-wrap{position:relative;background:#eef3fb;}
    .et-frame{width:100%;height:560px;border:none;display:block;background:#eef3fb;}
    .et-frame-loading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
      background:rgba(238,243,251,.7);font-size:12.5px;color:var(--et-muted);font-weight:600;}
    .et-spin{width:26px;height:26px;border:3px solid #d3deef;border-top-color:var(--et-blue);border-radius:50%;
      animation:etspin .8s linear infinite;margin-right:9px;}
    @keyframes etspin{to{transform:rotate(360deg)}}

    /* Mobile tabs */
    .et-mtabs{display:none;gap:6px;margin-bottom:14px;}
    .et-mtab{flex:1;padding:9px;border-radius:10px;border:1.5px solid var(--et-border);background:#fff;
      font-size:12.5px;font-weight:700;color:var(--et-muted);font-family:inherit;cursor:pointer;}
    .et-mtab.active{background:#eef5ff;border-color:var(--et-blue);color:var(--et-blue-deep);}
    @media (max-width:860px){
      .et-mtabs{display:flex;}
      .et-grid.m-edit .et-preview-col{display:none;}
      .et-grid.m-prev .et-editor-col,.et-grid.m-prev .et-list-col{display:none;}
      .et-page{padding:12px 12px 90px;}
    }
    /* ── Modal hasil (sukses/gagal) — animasi smooth ease-in ── */
    .rm-overlay{position:fixed;inset:0;z-index:10001;background:rgba(13,27,62,.5);
      display:flex;align-items:center;justify-content:center;padding:20px;
      opacity:0;animation:rmFade .25s ease forwards;}
    @keyframes rmFade{to{opacity:1;}}
    .rm-card{background:#fff;border-radius:22px;max-width:380px;width:100%;padding:34px 28px 26px;text-align:center;
      box-shadow:0 24px 60px rgba(13,27,62,.28);transform:translateY(16px) scale(.94);opacity:0;
      animation:rmPop .42s cubic-bezier(.21,1.02,.4,1) .06s forwards;}
    @keyframes rmPop{to{transform:translateY(0) scale(1);opacity:1;}}
    .rm-icon{width:78px;height:78px;margin:0 auto 18px;border-radius:50%;display:flex;align-items:center;justify-content:center;}
    .rm-icon.ok{background:radial-gradient(circle at 50% 40%,#eafaf0,#d8f5e3);}
    .rm-icon.err{background:radial-gradient(circle at 50% 40%,#fdeeee,#fad9d9);}
    .rm-icon svg{width:46px;height:46px;}
    /* lingkaran pulse di belakang ikon */
    .rm-icon::after{content:'';position:absolute;width:78px;height:78px;border-radius:50%;
      animation:rmPulse 1.1s ease-out .25s;}
    .rm-icon.ok::after{background:rgba(22,163,74,.18);}
    .rm-icon.err::after{background:rgba(220,38,38,.16);}
    @keyframes rmPulse{0%{transform:scale(.6);opacity:.7;}100%{transform:scale(1.7);opacity:0;}}
    /* gambar centang/silang dengan stroke-dashoffset */
    .rm-draw{stroke-dasharray:48;stroke-dashoffset:48;animation:rmDraw .5s cubic-bezier(.65,0,.45,1) .32s forwards;}
    @keyframes rmDraw{to{stroke-dashoffset:0;}}
    .rm-title{font-size:19px;font-weight:800;color:#0d1b3e;letter-spacing:-.2px;
      opacity:0;animation:rmUp .4s ease .28s forwards;}
    .rm-msg{font-size:13px;color:#64748b;line-height:1.55;margin-top:7px;
      opacity:0;animation:rmUp .4s ease .36s forwards;}
    .rm-ok{width:100%;justify-content:center;margin-top:22px;height:48px;
      opacity:0;animation:rmUp .4s ease .44s forwards;}
    @keyframes rmUp{from{transform:translateY(8px);opacity:0;}to{transform:translateY(0);opacity:1;}}

    /* spinner kecil untuk tombol saat proses */
    .et-spin-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.45);border-top-color:#fff;
      border-radius:50%;animation:etspin .7s linear infinite;display:inline-block;}
    #btnSaveDot{animation:dotPulse 1.4s ease-in-out infinite;}
    @keyframes dotPulse{0%,100%{box-shadow:0 0 0 3px rgba(251,191,36,.35);}50%{box-shadow:0 0 0 5px rgba(251,191,36,.12);}}
    /* tombol baris pada modal konfirmasi */
    .rm-actions{display:flex;gap:10px;margin-top:22px;opacity:0;animation:rmUp .4s ease .42s forwards;}
    .rm-actions .et-btn{flex:1;justify-content:center;height:46px;}
  </style>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar', { active: active }) %>
  <div class="main-content">
    <%- include('../partials/topbar', { user: user }) %>
    <main class="page-content">
    <div class="et-page">
      <!-- Header -->
      <div class="et-hdr">
        <div>
          <div class="et-title">Email Template</div>
          <div class="et-sub">Atur isi email yang dikirim sistem — subject, judul, dan pesan, dengan preview langsung</div>
        </div>
        <div class="et-actions">
          <button class="et-btn et-btn-ghost" onclick="openTest()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Kirim Uji
          </button>
          <button class="et-btn et-btn-danger" id="btnReset" onclick="resetCurrent()">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M5 19a9 9 0 0014.5-3.5M19 5A9 9 0 004.5 8.5"/></svg>
            Reset Default
          </button>
          <button class="et-btn et-btn-primary" id="btnSave" onclick="saveCurrent()">
            <span id="btnSaveDot" style="display:none;width:8px;height:8px;border-radius:50%;background:#fbbf24;box-shadow:0 0 0 3px rgba(251,191,36,.35);"></span>
            <svg id="btnSaveIcon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span id="btnSaveLabel">Simpan</span>
          </button>
        </div>
      </div>

      <!-- Mobile tab switch -->
      <div class="et-mtabs">
        <button type="button" class="et-mtab active" data-mtab="edit" onclick="mtab('edit')">Edit</button>
        <button type="button" class="et-mtab" data-mtab="prev" onclick="mtab('prev')">Preview</button>
      </div>

      <div class="et-grid m-edit" id="etGrid">
        <!-- LIST -->
        <div class="et-list-col">
          <div class="et-card">
            <div class="et-card-h">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
              Jenis Email
            </div>
            <div class="et-list" id="etList"></div>
          </div>
        </div>

        <!-- EDITOR -->
        <div class="et-editor-col">
          <div class="et-card">
            <div class="et-card-h" id="etEditorTitle">Editor</div>
            <div class="et-editor">
              <div id="etNote" style="display:none;margin-bottom:14px;padding:11px 13px;background:#fff8e6;border:1px solid #ffe2a8;border-radius:10px;font-size:11.5px;line-height:1.5;color:#92660a;">
                <strong style="display:block;margin-bottom:2px;">Catatan</strong>
                <span id="etNoteText"></span>
              </div>
              <div class="et-field">
                <label class="et-switch">
                  <input type="checkbox" id="fEnabled" onchange="onEdit()">
                  <span class="et-track"></span>
                  <span class="et-switch-l">Aktifkan pengiriman email ini</span>
                </label>
                <div class="et-hint" id="enabledHint">Bila dimatikan, sistem tidak akan mengirim email jenis ini.</div>
              </div>

              <div class="et-field">
                <div class="et-label">Subject (Judul Email)</div>
                <input class="et-inp" id="fSubject" oninput="onEdit()" placeholder="Subject email">
              </div>

              <div class="et-field">
                <div class="et-label">Heading (Judul di Dalam Email)</div>
                <input class="et-inp" id="fHeading" oninput="onEdit()" placeholder="Judul utama di badan email">
              </div>

              <div class="et-field">
                <div class="et-label">Intro (Paragraf Pembuka)</div>
                <textarea class="et-ta" id="fIntro" oninput="onEdit()" placeholder="Paragraf pembuka email"></textarea>
              </div>

              <div class="et-field" id="outroField">
                <div class="et-label">Outro (Paragraf Penutup)</div>
                <textarea class="et-ta" id="fOutro" oninput="onEdit()" placeholder="Paragraf penutup email"></textarea>
              </div>

              <div class="et-field" id="btnLabelField">
                <div class="et-label">Label Tombol (opsional)</div>
                <input class="et-inp" id="fButton" oninput="onEdit()" placeholder="mis. Bayar Sekarang — kosongkan untuk menyembunyikan tombol">
              </div>

              <div class="et-field" id="accentField">
                <div class="et-label">Warna Aksen</div>
                <div class="et-color-row">
                  <input type="color" id="fAccentPick" oninput="syncAccent(this.value)">
                  <input class="et-inp" id="fAccent" style="flex:1" oninput="syncAccentText(this.value)" placeholder="#1f8bff">
                </div>
              </div>

              <div class="et-field">
                <div class="et-label">Variabel Tersedia <span style="font-weight:500;color:var(--et-muted)">— klik untuk menyisipkan</span></div>
                <div class="et-vars" id="etVars"></div>
                <div class="et-hint">Variabel akan otomatis diganti dengan data asli saat email dikirim.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- PREVIEW -->
        <div class="et-preview-col">
          <div class="et-card">
            <div class="et-card-h">
              <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              Preview Langsung
            </div>
            <div class="et-subject">
              <div class="l">Subject</div>
              <div class="v" id="pvSubject">—</div>
            </div>
            <div class="et-frame-wrap">
              <iframe class="et-frame" id="pvFrame" title="Email preview"></iframe>
              <div class="et-frame-loading" id="pvLoading" style="display:none;"><div class="et-spin"></div>Memuat preview…</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </main>
  </div>
</div>

<!-- Test send modal -->
<div id="testModal" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(13,27,62,.5);align-items:center;justify-content:center;padding:20px;">
  <div style="background:#fff;border-radius:18px;max-width:420px;width:100%;padding:22px;">
    <div style="font-size:17px;font-weight:800;color:#0d1b3e;">Kirim Email Uji</div>
    <div style="font-size:12.5px;color:#6b7fa8;margin-top:4px;margin-bottom:16px;">Kirim contoh template ini ke alamat email untuk mengecek tampilan asli.</div>
    <input class="et-inp" id="testEmail" type="email" placeholder="email@tujuan.com" style="width:100%;">
    <div style="display:flex;gap:10px;margin-top:16px;">
      <button class="et-btn et-btn-ghost" style="flex:1;justify-content:center;" onclick="closeTest()">Batal</button>
      <button class="et-btn et-btn-primary" style="flex:1;justify-content:center;" id="btnSendTest" onclick="sendTest()">Kirim</button>
    </div>
  </div>
</div>

<!-- Modal hasil (sukses/gagal) dengan animasi smooth -->
<div id="resultModal" class="rm-overlay" style="display:none;">
  <div class="rm-card" id="rmCard">
    <div class="rm-icon" id="rmIcon">
      <!-- ikon disuntik via JS (centang sukses / silang gagal) -->
    </div>
    <div class="rm-title" id="rmTitle">Berhasil</div>
    <div class="rm-msg" id="rmMsg"></div>
    <button class="et-btn et-btn-primary rm-ok" onclick="closeResult()">Selesai</button>
  </div>
</div>

<!-- Modal konfirmasi (mis. Reset Default) dengan animasi sama -->
<div id="confirmModal" class="rm-overlay" style="display:none;">
  <div class="rm-card" id="cfCard">
    <div class="rm-icon err" id="cfIcon" style="position:relative;background:radial-gradient(circle at 50% 40%,#fff5e6,#ffe9c7);">
      <svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg"><path class="rm-draw" d="M26 14v16M26 38h.02" stroke="#e08a00" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div class="rm-title" id="cfTitle">Konfirmasi</div>
    <div class="rm-msg" id="cfMsg"></div>
    <div class="rm-actions">
      <button class="et-btn et-btn-ghost" onclick="closeConfirm(false)">Batal</button>
      <button class="et-btn et-btn-danger" id="cfYes" onclick="closeConfirm(true)">Ya, Lanjutkan</button>
    </div>
  </div>
</div>

<!-- App helper (menyediakan App.api & App.showToast) — wajib untuk Simpan & Kirim Uji -->
<script src="/js/app.js"></script>
<script>
  const TEMPLATES = <%- JSON.stringify(templates || []) %>;
  const COMPANY = <%- JSON.stringify(companyName || 'ISP') %>;

  // Wrapper aman: pakai App bila tersedia, fallback ke fetch/alert bila tidak.
  function toast(msg, type){
    if (window.App && typeof App.showToast === 'function') return App.showToast(msg, type||'info');
    // fallback ringan
    try{ console.log('[toast]', type||'info', msg); }catch(_){}
  }
  async function apiCall(url, options){
    if (window.App && typeof App.api === 'function') return App.api(url, options);
    // fallback: panggil /api langsung dengan token dari localStorage
    const headers={ 'Content-Type':'application/json','Accept':'application/json','X-Requested-With':'XMLHttpRequest' };
    try{ const t=localStorage.getItem('token'); if(t && t!=='null') headers['Authorization']='Bearer '+t; }catch(_){}
    const res=await fetch('/api'+url, Object.assign({headers, credentials:'include'}, options||{}));
    try{ return await res.json(); }catch(_){ return { success:false, message:'HTTP '+res.status }; }
  }
  let CUR = TEMPLATES.length ? TEMPLATES[0].type : null;
  let DIRTY = {};            // type -> draft object (unsaved edits)
  let previewTimer = null;

  const ICONS = {
    invoice:'<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>',
    clock:'<circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2"/>',
    check:'<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>',
    user:'<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>',
    ticket:'<path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5h14a2 2 0 012 2v3a2 2 0 000 4v3a2 2 0 01-2 2H5a2 2 0 01-2-2v-3a2 2 0 000-4V7a2 2 0 012-2z"/>',
    bolt:'<path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>'
  };
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
  function tpl(type){return TEMPLATES.find(t=>t.type===type);}
  function draftOf(type){
    if(DIRTY[type]) return DIRTY[type];
    const t=tpl(type); return {...t.current};
  }

  function renderList(){
    const box=document.getElementById('etList');
    box.innerHTML=TEMPLATES.map(t=>{
      const d=draftOf(t.type);
      const on=(d.enabled!=='0'&&d.enabled!==0&&d.enabled!==false);
      return '<button class="et-item'+(t.type===CUR?' active':'')+'" onclick="selectTpl(\''+t.type+'\')">'
        +'<span class="et-item-ic"><svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">'+(ICONS[t.icon]||ICONS.invoice)+'</svg></span>'
        +'<span class="et-item-b"><span class="et-item-t">'+esc(t.label)+'</span>'
        +'<span class="et-item-d">'+esc(t.desc)+'</span>'
        +'<span class="et-pill '+(on?'on':'off')+'">'+(on?'AKTIF':'NONAKTIF')+'</span></span>'
        +'</button>';
    }).join('');
  }

  function loadEditor(){
    const t=tpl(CUR), d=draftOf(CUR);
    document.getElementById('etEditorTitle').textContent=t.label;
    document.getElementById('fEnabled').checked=(d.enabled!=='0'&&d.enabled!==0&&d.enabled!==false);
    document.getElementById('fSubject').value=d.subject||'';
    document.getElementById('fHeading').value=d.heading||'';
    document.getElementById('fIntro').value=d.intro||'';
    document.getElementById('fOutro').value=d.outro||'';
    document.getElementById('fButton').value=d.button_label||'';
    document.getElementById('fAccent').value=d.accent||'#1f8bff';
    document.getElementById('fAccentPick').value=/^#[0-9a-fA-F]{6}$/.test(d.accent||'')?d.accent:'#1f8bff';
    // Variable chips
    document.getElementById('etVars').innerHTML=(t.vars||[]).map(v=>
      '<span class="et-chip" onclick="insertVar(\'{'+v+'}\')">{'+esc(v)+'}</span>').join('');

    // Sembunyikan field yang tak berefek untuk template ini (mis. invoice).
    const hidden=t.hiddenFields||[];
    const fieldMap={ outro:'outroField', accent:'accentField', button_label:'btnLabelField' };
    Object.keys(fieldMap).forEach(f=>{
      const el=document.getElementById(fieldMap[f]);
      if(el) el.style.display = hidden.indexOf(f)>=0 ? 'none' : '';
    });

    // Tampilkan catatan bila ada.
    const noteBox=document.getElementById('etNote');
    if(t.note){ document.getElementById('etNoteText').textContent=t.note; noteBox.style.display=''; }
    else { noteBox.style.display='none'; }

    refreshPreview();
  }

  function selectTpl(type){ captureDraft(); CUR=type; renderList(); loadEditor(); }

  let lastFocused='fIntro';
  ['fSubject','fHeading','fIntro','fOutro','fButton'].forEach(id=>{
    document.getElementById(id).addEventListener('focus',()=>lastFocused=id);
  });
  function insertVar(token){
    const el=document.getElementById(lastFocused)||document.getElementById('fIntro');
    const s=el.selectionStart||el.value.length, e=el.selectionEnd||el.value.length;
    el.value=el.value.slice(0,s)+token+el.value.slice(e);
    el.focus(); el.selectionStart=el.selectionEnd=s+token.length;
    onEdit();
  }

  function syncAccent(v){ document.getElementById('fAccent').value=v; onEdit(); }
  function syncAccentText(v){ if(/^#[0-9a-fA-F]{6}$/.test(v)) document.getElementById('fAccentPick').value=v; onEdit(); }

  function captureDraft(){
    DIRTY[CUR]={
      enabled:document.getElementById('fEnabled').checked?'1':'0',
      subject:document.getElementById('fSubject').value,
      heading:document.getElementById('fHeading').value,
      intro:document.getElementById('fIntro').value,
      outro:document.getElementById('fOutro').value,
      button_label:document.getElementById('fButton').value,
      accent:document.getElementById('fAccent').value
    };
  }

  function onEdit(){
    captureDraft();
    // update list pill live
    const item=document.querySelector('.et-item.active .et-pill');
    if(item){ const on=document.getElementById('fEnabled').checked;
      item.className='et-pill '+(on?'on':'off'); item.textContent=on?'AKTIF':'NONAKTIF'; }
    updateDirtyIndicator();
    clearTimeout(previewTimer);
    previewTimer=setTimeout(refreshPreview,350);
  }

  // Penanda "ada perubahan belum disimpan": titik kuning + label tombol.
  function hasUnsaved(){ return Object.keys(DIRTY).length>0; }
  function updateDirtyIndicator(){
    const dot=document.getElementById('btnSaveDot');
    const lbl=document.getElementById('btnSaveLabel');
    if(hasUnsaved()){ if(dot) dot.style.display=''; if(lbl) lbl.textContent='Simpan*'; }
    else { if(dot) dot.style.display='none'; if(lbl) lbl.textContent='Simpan'; }
  }

  // ── Bangun preview SEPENUHNYA di browser (tanpa request server) ──
  function applyVars(text, vars){
    return String(text==null?'':text).replace(/\{(\w+)\}/g,(m,k)=> (k in vars ? (vars[k]==null?'':String(vars[k])) : m));
  }
  function wrapEmailHtml(o){
    const accent=/^#[0-9a-fA-F]{3,8}$/.test(o.accent||'')?o.accent:'#1f8bff';
    const btn=(o.buttonLabel)?'<tr><td style="padding:6px 26px 4px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center"><a href="#" style="display:inline-block;background:'+accent+';color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:13px 30px;border-radius:12px;">'+esc(o.buttonLabel)+'</a></td></tr></table></td></tr>':'';
    return '<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>'
      +'<body style="margin:0;padding:0;background:#eef3fb;">'
      +'<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eef3fb;padding:24px 12px;"><tr><td align="center">'
      +'<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:540px;background:#fff;border-radius:16px;overflow:hidden;border:1px solid #e8eef9;font-family:Arial,Helvetica,sans-serif;">'
      +'<tr><td style="background:'+accent+';padding:22px 26px;"><div style="color:#fff;font-size:18px;font-weight:800;">'+esc(o.companyName)+'</div>'
      +'<div style="color:rgba(255,255,255,.92);font-size:13.5px;margin-top:3px;font-weight:600;">'+esc(o.heading)+'</div></td></tr>'
      +'<tr><td style="padding:22px 26px 6px;color:#1f2937;font-size:14px;line-height:1.65;">'+(o.introHtml||'')+'</td></tr>'
      +(o.bodyExtraHtml?'<tr><td style="padding:6px 26px;">'+o.bodyExtraHtml+'</td></tr>':'')
      +btn
      +(o.outroHtml?'<tr><td style="padding:10px 26px 4px;color:#475569;font-size:13px;line-height:1.65;">'+o.outroHtml+'</td></tr>':'')
      +'<tr><td style="padding:18px 26px 24px;"><div style="border-top:1px solid #eef2f9;padding-top:14px;color:#94a3b8;font-size:11.5px;line-height:1.7;">'+esc(o.footerNote||'')+'</div></td></tr>'
      +'</table><div style="font-size:11px;color:#aab3c6;margin-top:12px;font-family:Arial,Helvetica,sans-serif;">'+esc(o.companyName)+'</div>'
      +'</td></tr></table></body></html>';
  }
  function buildDetailBlock(type, v){
    const rowsTbl=(pairs)=>'<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e8eef9;border-radius:10px;overflow:hidden;font-size:13px;">'
      +pairs.map((p,i)=>'<tr'+(i%2?' style="background:#f8faff;"':'')+'><td style="padding:9px 14px;color:#6b7fa8;">'+esc(p[0])+'</td><td align="right" style="padding:9px 14px;font-weight:700;color:#1f2937;">'+esc(p[1])+'</td></tr>').join('')
      +'</table>';
    if(type==='invoice_unpaid'||type==='invoice_overdue') return rowsTbl([['No. Invoice',v.invoice],['Paket',v.paket],['Periode',v.periode],['Jumlah',v.jumlah],['Jatuh Tempo',v.jatuh_tempo]]);
    if(type==='invoice_paid') return rowsTbl([['No. Invoice',v.invoice],['Metode',v.metode],['Tanggal Bayar',v.tanggal_bayar],['Jumlah',v.jumlah]]);
    if(type==='customer_welcome') return rowsTbl([['ID Pelanggan',v.id_pelanggan],['Paket',v.paket],['Telepon',v.telepon],['Email',v.email]]);
    if(type==='voucher_delivery') return '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f0f6ff;border:1px dashed #9cc2ff;border-radius:12px;"><tr><td style="padding:14px;text-align:center;"><div style="font-size:11px;color:#6b7fa8;letter-spacing:.05em;">USERNAME</div><div style="font-size:18px;font-weight:800;color:#1565e0;font-family:monospace;margin:2px 0 8px;">'+esc(v.username)+'</div><div style="font-size:11px;color:#6b7fa8;letter-spacing:.05em;">PASSWORD</div><div style="font-size:18px;font-weight:800;color:#1565e0;font-family:monospace;margin-top:2px;">'+esc(v.password)+'</div></td></tr></table>';
    return '';
  }

  // Tulis HTML ke iframe via srcdoc (email statis, tanpa script).
  function writeFrame(html){
    const f=document.getElementById('pvFrame');
    try{ f.removeAttribute('src'); f.srcdoc=html; }
    catch(e){
      try{ const doc=f.contentDocument||f.contentWindow.document; doc.open(); doc.write(html); doc.close(); }catch(_){}
    }
  }

  function refreshPreview(){
    const t=tpl(CUR), d=draftOf(CUR);
    const v=Object.assign({}, t.sample||{}, { perusahaan: COMPANY||(t.sample&&t.sample.perusahaan)||'ISP' });
    const subject=applyVars(d.subject, v);
    document.getElementById('pvSubject').textContent=subject||'—';
    const introHtml=esc(applyVars(d.intro, v)).replace(/\n/g,'<br>');
    const outroHtml=esc(applyVars(d.outro, v)).replace(/\n/g,'<br>');
    const html=wrapEmailHtml({
      accent:d.accent, companyName:v.perusahaan, heading:applyVars(d.heading, v),
      introHtml, bodyExtraHtml:buildDetailBlock(CUR, v), outroHtml,
      buttonLabel:d.button_label,
      footerNote:'Email ini dikirim otomatis oleh sistem '+v.perusahaan+'. Mohon tidak membalas email ini.'
    });
    writeFrame(html);
  }

  async function saveCurrent(){
    captureDraft();
    if(!hasUnsaved()){ toast('Tidak ada perubahan untuk disimpan','info'); return; }
    const btn=document.getElementById('btnSave'); btn.disabled=true;
    const icon=document.getElementById('btnSaveIcon'), lbl=document.getElementById('btnSaveLabel'), dot=document.getElementById('btnSaveDot');
    const _icoHtml=icon?icon.outerHTML:'';
    if(icon) icon.outerHTML='<span class="et-spin-sm" id="btnSaveIcon"></span>';
    if(dot) dot.style.display='none';
    if(lbl) lbl.textContent='Menyimpan…';
    const payload={};
    // Simpan SEMUA draft yang ada (semua tab yang pernah diedit)
    Object.keys(DIRTY).forEach(type=>{
      const d=DIRTY[type];
      ['enabled','subject','heading','intro','outro','button_label','accent'].forEach(f=>{
        payload['emailtpl_'+type+'_'+f]=d[f]==null?'':String(d[f]);
      });
    });
    let okFlag=false, errMsg='';
    try{
      const r=await apiCall('/app-settings',{method:'POST',body:JSON.stringify(payload)});
      if(r&&r.success){
        Object.keys(DIRTY).forEach(type=>{ const t=tpl(type); if(t) t.current={...t.current,...DIRTY[type]}; });
        DIRTY={}; renderList(); okFlag=true;
      }else{ errMsg=(r&&r.message)||'Perubahan tidak dapat disimpan. Coba lagi.'; }
    }catch(e){ errMsg='Terjadi kesalahan jaringan saat menyimpan.'; }
    // pulihkan tampilan tombol
    const sp=document.getElementById('btnSaveIcon'); if(sp) sp.outerHTML=_icoHtml;
    btn.disabled=false; updateDirtyIndicator();
    if(okFlag) showResult(true,'Tersimpan!','Perubahan template email berhasil disimpan dan langsung berlaku.');
    else showResult(false,'Gagal Menyimpan',errMsg);
  }

  function resetCurrent(){
    const t=tpl(CUR);
    showConfirm(
      'Reset ke Default?',
      'Template "'+t.label+'" akan dikembalikan ke pengaturan bawaan. Klik Simpan untuk menerapkan.',
      'Ya, Reset',
      function(){
        DIRTY[CUR]={...t.defaults};
        loadEditor(); renderList(); updateDirtyIndicator();
        toast('Direset ke default — klik Simpan untuk menerapkan','info');
      }
    );
  }

  // Test send
  function openTest(){ document.getElementById('testModal').style.display='flex'; }
  function closeTest(){ document.getElementById('testModal').style.display='none'; }

  // ── Modal hasil sukses/gagal dengan animasi ──
  const ICON_OK='<svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg"><path class="rm-draw" d="M14 27l8 8 16-18" stroke="#16a34a" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  const ICON_ERR='<svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg"><path class="rm-draw" d="M18 18l16 16M34 18L18 34" stroke="#dc2626" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  function showResult(ok, title, msg){
    const overlay=document.getElementById('resultModal');
    const icon=document.getElementById('rmIcon');
    const card=document.getElementById('rmCard');
    // reset animasi (paksa reflow agar animasi berjalan lagi)
    overlay.style.display='flex';
    icon.className='rm-icon '+(ok?'ok':'err');
    icon.style.position='relative';
    icon.innerHTML=ok?ICON_OK:ICON_ERR;
    document.getElementById('rmTitle').textContent=title||(ok?'Berhasil':'Gagal');
    document.getElementById('rmMsg').textContent=msg||'';
    // retrigger animasi card
    card.style.animation='none'; void card.offsetWidth; card.style.animation='';
    overlay.style.animation='none'; void overlay.offsetWidth; overlay.style.animation='';
  }
  function closeResult(){ document.getElementById('resultModal').style.display='none'; }
  // tutup bila klik area gelap
  document.getElementById('resultModal').addEventListener('click',function(e){ if(e.target===this) closeResult(); });

  // ── Modal konfirmasi beranimasi (pengganti confirm() bawaan) ──
  let _confirmCb=null;
  function showConfirm(title, msg, yesLabel, onYes){
    _confirmCb=onYes||null;
    const overlay=document.getElementById('confirmModal');
    const card=document.getElementById('cfCard');
    document.getElementById('cfTitle').textContent=title||'Konfirmasi';
    document.getElementById('cfMsg').textContent=msg||'';
    document.getElementById('cfYes').textContent=yesLabel||'Ya, Lanjutkan';
    overlay.style.display='flex';
    card.style.animation='none'; void card.offsetWidth; card.style.animation='';
    overlay.style.animation='none'; void overlay.offsetWidth; overlay.style.animation='';
  }
  function closeConfirm(ok){
    document.getElementById('confirmModal').style.display='none';
    const cb=_confirmCb; _confirmCb=null;
    if(ok && typeof cb==='function') cb();
  }
  document.getElementById('confirmModal').addEventListener('click',function(e){ if(e.target===this) closeConfirm(false); });

  async function sendTest(){
    const to=document.getElementById('testEmail').value.trim();
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(to)){ toast('Email tujuan tidak valid','error'); return; }
    const btn=document.getElementById('btnSendTest'); btn.disabled=true; btn.textContent='Mengirim…';
    try{
      const r=await apiCall('/email-template/send-test',{method:'POST',body:JSON.stringify({type:CUR,to})});
      if(r&&r.success){
        closeTest();
        showResult(true,'Email Terkirim!', (r.message||('Email uji berhasil dikirim ke '+to))+'. Cek kotak masuk (atau folder spam).');
      }else{
        showResult(false,'Gagal Mengirim', (r&&r.message)||'Email uji gagal dikirim. Periksa konfigurasi SMTP di Settings.');
      }
    }catch(e){ showResult(false,'Gagal Mengirim','Terjadi kesalahan jaringan saat menghubungi server.'); }
    btn.disabled=false; btn.textContent='Kirim';
  }

  function mtab(which){
    document.querySelectorAll('.et-mtab').forEach(b=>b.classList.toggle('active',b.dataset.mtab===which));
    const g=document.getElementById('etGrid');
    g.classList.toggle('m-edit',which==='edit');
    g.classList.toggle('m-prev',which==='prev');
  }

  // Peringatan bila ada perubahan belum disimpan saat menutup/refresh tab.
  window.addEventListener('beforeunload', function(e){
    if(hasUnsaved()){ e.preventDefault(); e.returnValue=''; return ''; }
  });
  // Intercept klik link sidebar agar konfirmasi dulu bila ada perubahan.
  document.addEventListener('click', function(e){
    const a=e.target.closest && e.target.closest('a[href]');
    if(!a) return;
    const href=a.getAttribute('href')||'';
    if(!href || href.startsWith('#') || a.target==='_blank') return;
    if(!hasUnsaved()) return;
    e.preventDefault();
    showConfirm('Perubahan Belum Disimpan',
      'Anda punya perubahan yang belum disimpan. Tinggalkan halaman tanpa menyimpan?',
      'Tinggalkan',
      function(){ DIRTY={}; window.location.href=href; });
  }, true);

  // Init
  if(CUR){ renderList(); loadEditor(); updateDirtyIndicator(); }
  else { document.querySelector('.et-page').innerHTML='<div style="padding:40px;text-align:center;color:#6b7fa8;">Tidak ada template email.</div>'; }
</script>
</body>
</html>
